+import Mathlib.Tactic
+
+set_option autoImplicit false
+
+namespace GRWTSK.Analysis.FiniteSum.BinaryMeanVariance
+
+/-- Exact signed weighted merge, with no division or positivity assumptions. -/
+theorem cleared_merge (l r x y : ℝ) :
+    (l + r) * (l * x ^ 2 + r * y ^ 2) =
+      (l * x + r * y) ^ 2 + l * r * (x - y) ^ 2 := by
+  ring
+
+/-- A merged mean must retain the between-child variance. -/
+theorem weighted_merge (l r x y : ℝ) (h : l + r ≠ 0) :
+    l * x ^ 2 + r * y ^ 2 =
+      (l + r) * ((l * x + r * y) / (l + r)) ^ 2 +
+        (l * r / (l + r)) * (x - y) ^ 2 := by
+  field_simp [h]
+  <;> ring
+
+/-- Equal-length binary refinement is one exact Haar detail. -/
+theorem binary_split (h x y : ℝ) :
+    h / 2 * x ^ 2 + h / 2 * y ^ 2 =
+      h * ((x + y) / 2) ^ 2 + h / 4 * (x - y) ^ 2 := by
+  ring
+
+/-- Refinement increases the mean-square component by a nonnegative detail. -/
+theorem mean_square_mono (h x y : ℝ) (hh : 0 ≤ h) :
+    h * ((x + y) / 2) ^ 2 ≤ h / 2 * x ^ 2 + h / 2 * y ^ 2 := by
+  rw [binary_split]
+  exact le_add_of_nonneg_right (mul_nonneg (div_nonneg hh (by norm_num)) (sq_nonneg _))
+
+/-- The exponential second difference becomes a positive quartic after squaring. -/
+theorem exponential_difference_quartic (a r : ℝ) :
+    (a - 2 * (a * r) + a * r ^ 2) ^ 2 = a ^ 2 * (1 - r) ^ 4 := by
+  ring
+
+/-- Independent cell refinement contributes the exact quadratic mesh factor. -/
+theorem mesh_variance_scale (h L q : ℝ) (hq : q ≠ 0) :
+    q * (L ^ 2 * (h / q) ^ 3 / 12) =
+      (L ^ 2 * h ^ 3 / 12) / q ^ 2 := by
+  field_simp [hq]
+  <;> ring
+
+/-- A hostile arithmetic control: replacing a pair by its mean loses energy. -/
+theorem mean_does_not_erase_variance :
+    ((1 : ℝ) ^ 2 + (-1) ^ 2) / 2 ≠ ((1 + (-1)) / 2) ^ 2 := by
+  norm_num
+
+end GRWTSK.Analysis.FiniteSum.BinaryMeanVariance
