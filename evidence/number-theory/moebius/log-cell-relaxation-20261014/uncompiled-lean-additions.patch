+UNCOMPILED CANDIDATE. These finite identities do not establish integration,
+a source-wide bound, or repository admission. See DERIVATION.md.
+-/
+import Mathlib.Tactic
+
+set_option autoImplicit false
+
+namespace GRWTSK.LinearAlgebra.QuadraticForm.TwoMomentCentering
+
+/-- The complete signed two-moment quadratic, before any relaxation. -/
+def energy (h S C A M : ℝ) : ℝ :=
+  4 * (h * A ^ 2 - 2 * S * A * M + C * M ^ 2)
+
+/-- The mean reading; its source value is not an optimization variable. -/
+def mean (h S A M : ℝ) : ℝ := 2 * (A - S * M / h)
+
+/-- The centered energy, with the covariance subtraction retained. -/
+def variance (h S C M : ℝ) : ℝ := 4 * M ^ 2 * (C - S ^ 2 / h)
+
+/-- A denominator-free identity valid even at zero formal mass. -/
+theorem cleared_centering (h S C A M : ℝ) :
+    h * energy h S C A M =
+      4 * (h * A - S * M) ^ 2 + 4 * M ^ 2 * (h * C - S ^ 2) := by
+  unfold energy
+  ring
+
+/-- Exact mean-plus-variance accounting at nonzero mass. -/
+theorem centering (h S C A M : ℝ) (hh : h ≠ 0) :
+    energy h S C A M = h * mean h S A M ^ 2 + variance h S C M := by
+  unfold energy mean variance
+  field_simp [hh]
+  <;> ring
+
+/-- Nonnegative covariance is a separate hypothesis, not inferred from symmetry. -/
+theorem variance_nonneg (h S C M : ℝ) (hh : 0 < h)
+    (hc : S ^ 2 ≤ h * C) : 0 ≤ variance h S C M := by
+  have hs : S ^ 2 / h ≤ C := (div_le_iff₀ hh).2 (by nlinarith [hc])
+  unfold variance
+  exact mul_nonneg (mul_nonneg (by norm_num) (sq_nonneg M)) (sub_nonneg.mpr hs)
+
+/-- Substituting the relaxed coordinate attains only the centered minimum. -/
+theorem relaxed_value (h S C M : ℝ) (hh : h ≠ 0) :
+    energy h S C (S * M / h) M = variance h S C M := by
+  unfold energy variance
+  field_simp [hh]
+  <;> ring
+
+/-- Relaxation supplies a lower bound, never an upper bound for a native source. -/
+theorem relaxed_lower_bound (h S C A M : ℝ) (hh : 0 < h) :
+    variance h S C M ≤ energy h S C A M := by
+  rw [centering h S C A M (ne_of_gt hh)]
+  exact le_add_of_nonneg_left (mul_nonneg (le_of_lt hh) (sq_nonneg _))
+
+/-- All lost native information is exactly the retained mean square. -/
+theorem relaxation_debt (h S C A M : ℝ) (hh : h ≠ 0) :
+    energy h S C A M - variance h S C M = h * mean h S A M ^ 2 := by
+  rw [centering h S C A M hh]
+  ring
+
+end GRWTSK.LinearAlgebra.QuadraticForm.TwoMomentCentering
