+/-
+Human mathematical direction: grwtsk contributors.
+Mathematical derivation and candidate formalization: OpenAI ChatGPT. MIT.
+
+UNCOMPILED CANDIDATE. This adapter imports the original source identity and
+establishes only the finite coefficient algebra. Its named moment expressions
+are identified with integrals in DERIVATION.md, NOT by an admitted theorem here.
+The all-height variance estimate, summation, Haar completeness, and conditional
+RH transport in the dossier remain written analysis.
+-/
+import GRWTSK.NumberTheory.Moebius.CriticalIntervalBlocks
+import GRWTSK.LinearAlgebra.QuadraticForm.TwoMomentCentering
+
+set_option autoImplicit false
+noncomputable section
+
+namespace GRWTSK.NumberTheory.Moebius.LogCellMeanVariance
+
+open GRWTSK.RiemannHypothesis.CCC
+open GRWTSK.NumberTheory.Moebius.CriticalIntervalBlocks
+open GRWTSK.LinearAlgebra.QuadraticForm.TwoMomentCentering
+
+/-- Width of the actual arithmetic arrival cell, not an arbitrary sample mesh. -/
+def width (n : ℕ) : ℝ := Real.log ((n + 1 : ℕ) : ℝ) - Real.log (n : ℝ)
+
+/-- The actual positive-index arrival cell has strictly positive width. -/
+theorem width_pos {n : ℕ} (hn : 1 ≤ n) : 0 < width n := by
+  have hp : (0 : ℝ) < n := by
+    exact_mod_cast (lt_of_lt_of_le Nat.zero_lt_one hn)
+  have hs : (n : ℝ) < ((n + 1 : ℕ) : ℝ) := by
+    exact_mod_cast Nat.lt_succ_self n
+  exact sub_pos.mpr (Real.log_lt_log hp hs)
+
+/-- Written analytic identification: integral of exp(-u/2) over the cell. -/
+def firstMoment (n : ℕ) : ℝ :=
+  2 * (Real.exp (-Real.log (n : ℝ) / 2) -
+       Real.exp (-Real.log ((n + 1 : ℕ) : ℝ) / 2))
+
+/-- Written analytic identification: integral of exp(-u) over the cell. -/
+def secondMoment (n : ℕ) : ℝ :=
+  Real.exp (-Real.log (n : ℝ)) - Real.exp (-Real.log ((n + 1 : ℕ) : ℝ))
+
+def meanReading (n : ℕ) : ℝ :=
+  mean (width n) (firstMoment n) (pickupWeightedPrefix n) (pickupMertensPrefix n)
+
+def centeredReading (n : ℕ) : ℝ :=
+  variance (width n) (firstMoment n) (secondMoment n) (pickupMertensPrefix n)
+
+/-- Coefficient expression; this declaration is not an integral-definition alias. -/
+def cellQuadratic (n : ℕ) : ℝ :=
+  energy (width n) (firstMoment n) (secondMoment n)
+    (pickupWeightedPrefix n) (pickupMertensPrefix n)
+
+/-- The original proved two-prefix source law is reused, not assumed anew. -/
+theorem actual_source_on_cell {n : ℕ} (hn : 1 ≤ n) {u : ℝ}
+    (hlo : Real.log (n : ℝ) < u)
+    (hhi : u < Real.log ((n + 1 : ℕ) : ℝ)) :
+    wholePickup u =
+      2 * (pickupWeightedPrefix n - Real.exp (-u / 2) * pickupMertensPrefix n) :=
+  wholePickup_eq_prefix_flux_on_log_cell hn hlo hhi
+
+/-- Exact algebra for the source's actual signed prefixes. -/
+theorem cell_centering (n : ℕ) (hn : 1 ≤ n) :
+    cellQuadratic n = width n * meanReading n ^ 2 + centeredReading n := by
+  exact centering (width n) (firstMoment n) (secondMoment n)
+    (pickupWeightedPrefix n) (pickupMertensPrefix n) (ne_of_gt (width_pos hn))
+
+/-- The relaxed residual does not replace the native cell mean. -/
+theorem retained_mean_debt (n : ℕ) (hn : 1 ≤ n) :
+    cellQuadratic n - centeredReading n = width n * meanReading n ^ 2 := by
+  rw [cell_centering n hn]
+  ring
+
+/-- Source integrals, positivity and infinite bounds must be supplied separately. -/
+theorem cleared_cell_centering (n : ℕ) :
+    width n * cellQuadratic n =
+      4 * (width n * pickupWeightedPrefix n -
+        firstMoment n * pickupMertensPrefix n) ^ 2 +
+      4 * pickupMertensPrefix n ^ 2 *
+        (width n * secondMoment n - firstMoment n ^ 2) := by
+  exact cleared_centering (width n) (firstMoment n) (secondMoment n)
+    (pickupWeightedPrefix n) (pickupMertensPrefix n)
+
+end GRWTSK.NumberTheory.Moebius.LogCellMeanVariance
