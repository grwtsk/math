  "written_results": [
    {
      "id": "PD8",
      "statement": "For every bounded source supported on 1..U and integers 2<=U<=n: |pJ_(n,U)|<=36|A_U|n^(-4/3)+22U^(2/3)n^(-3/2).",
      "scope": "Complete Jacobi coefficient of the finite source, not an individual scalar moment. Boundary and arrival terms retained."
    },
    {
      "id": "PD9-12",
      "statement": "For actual U(n)=floor(cuberoot((2^(j+1)-1)^2)), 2^j<=n<2^(j+1), ML gives |p_n|<=50400/[n(1+log n)^2]+33n^(-19/18) and ||p||_w<=50400sqrt(7/3)+33sqrt(63).",
      "scope": "All n>=2; cutoff U<=n and logarithmic comparisons hold at every shell, not only eventually."
    },
    {
      "id": "PD2,PD3",
      "statement": "Under ML, ||s||_w<78200 and ||d-v||_w<78200, with s_n=sum_(k<=U(n))mu(k)K_(n,k), v_n=sum_(U(n)<k<=n^2)mu(k)K_(n,k).",
      "scope": "The entire moving short-source branch has finite weighted square norm <6115240000. This is not a bound on v, d or t."
    },
    {
      "id": "PD15",
      "statement": "Both tails (s_n)_(n>N) and (d_n-v_n)_(n>N) have norm at most 50400sqrt(7/3)(1+log N)^(-3/2)+33sqrt(63)N^(-1/18)+sqrt(4725)N^(-1/6)+sqrt(420000)N^(-1/3)+sqrt(10500)N^(-5/6).",
      "scope": "The direct long-source comparison charges the Jacobi/Bessel error once, not twice; all constants are cutoff independent."
    },
    {
      "id": "PD16-18",
      "statement": "eta_U=a_U*1-epsilon vanishes through U. Before (U+1)^3, mu-a_U=-a_U*eta_U+a_U*eta_U^2. The same Bessel functional gives v_n=R_n-L_n.",
      "scope": "Exact finite regrouping of the classical cubic identity; preserve R_n^2+L_n^2-2R_nL_n. Individual defect branches need not have coefficients bounded by one."
    },
    {
      "id": "PD19-20",
      "statement": "Under ML, sup_N sum_(n=2..N)w_n v_n^2<infinity is equivalent to sup_N Q_N<infinity. A witness B gives H_(1/3)(T)<1+(sqrt(B)+78200)^2 for every real T>=0.",
      "scope": "No B is supplied. Original source, completed transform and core return remain unchanged."
    }
