+import GRWTSK.LinearAlgebra.QuadraticCertificates
+import GRWTSK.Algebra.Polynomial.Quartic.ReflectionOrbit
+
+set_option autoImplicit false
+set_option relaxedAutoImplicit false
+
+namespace GRWTSK.Polynomial.QuadraticLift
+
+open Matrix
+
+/-- Degree-at-most-two monomials. Quadratic forms in this vector have degree
+at most four in x,y. A squared norm of a complex quartic instead needs the
+15 monomials of degree at most four; it is not represented by this six-vector. -/
+def monomials (x y : ℝ) : Fin 6 → ℝ := ![1, x, y, x ^ 2, x * y, y ^ 2]
+
+def evaluate (M : Matrix (Fin 6) (Fin 6) ℝ) (x y : ℝ) : ℝ :=
+  GRWTSK.LinearAlgebra.QuadraticCertificates.quadratic M (monomials x y)
+
+/-- Veronese consistency constraints are identities, not assumptions that
+arbitrary lifted vectors satisfy. -/
+theorem square_consistency (x y : ℝ) :
+    monomials x y 0 * monomials x y 3 - (monomials x y 1) ^ 2 = 0 := by
+  simp [monomials]
+
+theorem mixed_consistency (x y : ℝ) :
+    monomials x y 0 * monomials x y 4 - monomials x y 1 * monomials x y 2 = 0 := by
+  simp [monomials]
+
+theorem other_square_consistency (x y : ℝ) :
+    monomials x y 0 * monomials x y 5 - (monomials x y 2) ^ 2 = 0 := by
+  simp [monomials]
+
+/-- The exact quartic gap is negative sixteen times the xy monomial squared. -/
+def gapMatrix : Matrix (Fin 6) (Fin 6) ℝ :=
+  fun i j => if i = 4 ∧ j = 4 then -16 else 0
+
+theorem gap_evaluation (x y : ℝ) :
+    evaluate gapMatrix x y = GRWTSK.Polynomial.Quartic.orbitGap x y := by
+  simp [evaluate, GRWTSK.LinearAlgebra.QuadraticCertificates.quadratic,
+    Matrix.mulVec, dotProduct, gapMatrix, monomials, Fin.sum_univ_succ,
+    GRWTSK.Polynomial.Quartic.orbitGap, GRWTSK.Polynomial.Quartic.orbitP,
+    GRWTSK.Polynomial.Quartic.orbitR] <;> ring
+
+/-- Reuse the repository's exact checker and its actual admissibility boundary.
+No coefficient solver, Positivstellensatz completeness, or source existence is
+claimed. Source-zero admissibility must be proved outside this consumer. -/
+theorem certified_nonnegative {ε γ ν : Type*} [Fintype ε] [Fintype γ] [Fintype ν]
+    (P : GRWTSK.LinearAlgebra.QuadraticCertificates.Problem ℝ (Fin 6) ε γ)
+    (S : GRWTSK.LinearAlgebra.QuadraticCertificates.Certificate ℝ (Fin 6) ε γ ν)
+    (hS : GRWTSK.LinearAlgebra.QuadraticCertificates.Valid P S)
+    (x y : ℝ) (hx : P.Admissible (monomials x y)) :
+    0 ≤ evaluate P.target x y :=
+  GRWTSK.LinearAlgebra.QuadraticCertificates.sound P S hS (monomials x y) hx
+
+theorem gap_nonnegative_of_certificate {ε γ ν : Type*}
+    [Fintype ε] [Fintype γ] [Fintype ν]
+    (P : GRWTSK.LinearAlgebra.QuadraticCertificates.Problem ℝ (Fin 6) ε γ)
+    (S : GRWTSK.LinearAlgebra.QuadraticCertificates.Certificate ℝ (Fin 6) ε γ ν)
+    (hS : GRWTSK.LinearAlgebra.QuadraticCertificates.Valid P S)
+    (htarget : P.target = gapMatrix)
+    (x y : ℝ) (hx : P.Admissible (monomials x y)) :
+    0 ≤ GRWTSK.Polynomial.Quartic.orbitGap x y := by
+  have h := certified_nonnegative P S hS x y hx
+  rw [htarget, gap_evaluation] at h
+  exact h
+
+end GRWTSK.Polynomial.QuadraticLift
