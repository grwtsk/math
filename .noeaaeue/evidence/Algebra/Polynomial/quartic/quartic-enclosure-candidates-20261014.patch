+import GRWTSK.Algebra.Polynomial.Quartic.EvenInvariants
+
+set_option autoImplicit false
+set_option relaxedAutoImplicit false
+
+namespace GRWTSK.Polynomial.Quartic
+
+/-- Coefficients for roots b ± ia and -b ± ia, counted with repetition. -/
+def orbitP (a b : ℝ) : ℝ := 2 * (a ^ 2 - b ^ 2)
+def orbitR (a b : ℝ) : ℝ := (a ^ 2 + b ^ 2) ^ 2
+def orbitGap (a b : ℝ) : ℝ := orbitP a b ^ 2 - 4 * orbitR a b
+
+theorem orbit_factor (a b x : ℝ) :
+    evenValue (orbitP a b) (orbitR a b) x =
+      ((x - b) ^ 2 + a ^ 2) * ((x + b) ^ 2 + a ^ 2) := by
+  dsimp [evenValue, orbitP, orbitR]
+  ring
+
+theorem orbit_gap_identity (a b : ℝ) :
+    orbitGap a b = -16 * (a * b) ^ 2 := by
+  dsimp [orbitGap, orbitP, orbitR]
+  ring
+
+theorem orbit_discriminant_identity (a b : ℝ) :
+    evenDiscriminantExpr (orbitP a b) (orbitR a b) =
+      4096 * a ^ 4 * b ^ 4 * (a ^ 2 + b ^ 2) ^ 2 := by
+  dsimp [evenDiscriminantExpr, orbitP, orbitR]
+  ring
+
+theorem orbit_invariantI_identity (a b : ℝ) :
+    evenInvariantI (orbitP a b) (orbitR a b) =
+      16 * (a ^ 4 + a ^ 2 * b ^ 2 + b ^ 4) := by
+  dsimp [evenInvariantI, orbitP, orbitR]
+  ring
+
+/-- Cleared-denominator real-modular-locus identity. With a*b nonzero,
+this shows j >= 1728; that inequality holds off-axis as well. -/
+theorem orbit_modular_locus_identity (a b : ℝ) :
+    256 * (a ^ 4 + a ^ 2 * b ^ 2 + b ^ 4) ^ 3 -
+        1728 * a ^ 4 * b ^ 4 * (a ^ 2 + b ^ 2) ^ 2 =
+      64 * (a ^ 2 - b ^ 2) ^ 2 * (a ^ 2 + 2 * b ^ 2) ^ 2 *
+        (2 * a ^ 2 + b ^ 2) ^ 2 := by
+  ring
+
+theorem orbit_axis_square (b x : ℝ) :
+    evenValue (orbitP 0 b) (orbitR 0 b) x = (x ^ 2 - b ^ 2) ^ 2 := by
+  dsimp [evenValue, orbitP, orbitR]
+  ring
+
+theorem orbit_gap_nonpos (a b : ℝ) : orbitGap a b ≤ 0 := by
+  rw [orbit_gap_identity]
+  nlinarith [sq_nonneg (a * b)]
+
+theorem orbit_gap_nonneg_iff (a b : ℝ) :
+    0 ≤ orbitGap a b ↔ a = 0 ∨ b = 0 := by
+  rw [orbit_gap_identity]
+  constructor
+  · intro h
+    have hz : (a * b) ^ 2 = 0 := by nlinarith [sq_nonneg (a * b)]
+    exact mul_eq_zero.mp (sq_eq_zero_iff.mp hz)
+  · rintro (rfl | rfl) <;> simp
+
+/-- The second inequality alone does not handle zero height. -/
+theorem orbit_enclosure_iff (a b : ℝ) :
+    (orbitP a b ≤ 0 ∧ 0 ≤ orbitGap a b) ↔ a = 0 := by
+  constructor
+  · rintro ⟨hp, hg⟩
+    rcases (orbit_gap_nonneg_iff a b).mp hg with ha | hb
+    · exact ha
+    · subst b
+      dsimp [orbitP] at hp
+      have hz : a ^ 2 = 0 := by nlinarith [sq_nonneg a]
+      exact sq_eq_zero_iff.mp hz
+  · intro ha
+    subst a
+    constructor
+    · dsimp [orbitP]
+      nlinarith [sq_nonneg b]
+    · exact (orbit_gap_nonneg_iff 0 b).mpr (Or.inl rfl)
+
+theorem axis_of_gap_nonneg_of_height_ne_zero (a b : ℝ)
+    (hb : b ≠ 0) (hg : 0 ≤ orbitGap a b) : a = 0 :=
+  ((orbit_gap_nonneg_iff a b).mp hg).resolve_right hb
+
+/-- A local scalar error budget gives an exact algebraic collar. -/
+theorem collar_from_gap_budget (a b ε : ℝ) (h : -ε ≤ orbitGap a b) :
+    16 * a ^ 2 * b ^ 2 ≤ ε := by
+  rw [orbit_gap_identity] at h
+  nlinarith
+
+/-- Every positive error budget is needed; a finite prefix is insufficient. -/
+theorem gap_nonneg_of_all_budgets (a b : ℝ)
+    (h : ∀ ε : ℝ, 0 < ε → -ε ≤ orbitGap a b) : 0 ≤ orbitGap a b := by
+  by_contra hn
+  have hneg : orbitGap a b < 0 := lt_of_not_ge hn
+  have ht := h (-orbitGap a b / 2) (by linarith)
+  linarith
+
+/-- Positive discriminant does not imply real-rootedness. -/
+theorem off_axis_positive_discriminant_guard :
+    0 < evenDiscriminantExpr (orbitP 1 1) (orbitR 1 1) ∧
+      orbitGap 1 1 < 0 := by
+  norm_num [evenDiscriminantExpr, orbitP, orbitR, orbitGap]
+
+/-- Discriminant collision at zero height does not force zero horizontal offset. -/
+theorem zero_height_collision_guard :
+    orbitGap 1 0 = 0 ∧ 0 < orbitP 1 0 := by
+  norm_num [orbitGap, orbitP, orbitR]
+
+end GRWTSK.Polynomial.Quartic
