+import GRWTSK.Algebra.Polynomial.Quartic.EvenInvariants
+
+set_option autoImplicit false
+set_option relaxedAutoImplicit false
+
+namespace GRWTSK.Polynomial.Quartic
+
+section Ring
+variable {R : Type*} [CommRing R]
+
+def reciprocalValue (A B z : R) : R :=
+  z ^ 4 - A * z ^ 3 + B * z ^ 2 - A * z + 1
+
+/-- Homogeneous version of reduction by U=z+z⁻¹, without a division premise. -/
+theorem reciprocal_trace_identity (A B z : R) :
+    reciprocalValue A B z =
+      (z ^ 2 + 1) ^ 2 - A * z * (z ^ 2 + 1) + (B - 2) * z ^ 2 := by
+  dsimp [reciprocalValue]
+  ring
+
+theorem reciprocal_factor (u v z : R) :
+    reciprocalValue (u + v) (u * v + 2) z =
+      (z ^ 2 - u * z + 1) * (z ^ 2 - v * z + 1) := by
+  dsimp [reciprocalValue]
+  ring
+
+/-- Homogenized Cayley pullback of x⁴+px²+r under x=i(1+z)/(1-z).
+The rational map itself has an exceptional point z=1. -/
+theorem cayley_pullback_identity (p r z : R) :
+    (1 + z) ^ 4 - p * (1 + z) ^ 2 * (1 - z) ^ 2 + r * (1 - z) ^ 4 =
+      (1 - p + r) * (z ^ 4 + 1) + (4 - 4 * r) * (z ^ 3 + z) +
+        (6 + 2 * p + 6 * r) * z ^ 2 := by
+  ring
+
+/-- Discriminant of the reciprocal trace quadratic, with denominators cleared. -/
+theorem cayley_gap_identity (p r : R) :
+    (4 - 4 * r) ^ 2 - 4 * (6 + 2 * p + 6 * r) * (1 - p + r) +
+        8 * (1 - p + r) ^ 2 = 16 * (p ^ 2 - 4 * r) := by
+  ring
+
+end Ring
+
+/-- Positive leading coefficient on the entire nontrivial critical strip,
+including zero height. This makes normalization of the Cayley quartic safe. -/
+theorem cayley_leading_positive (a b : ℝ) (ha : a ^ 2 < 1) :
+    0 < 1 - 2 * (a ^ 2 - b ^ 2) + (a ^ 2 + b ^ 2) ^ 2 := by
+  have h1 : 0 < (1 - a ^ 2) ^ 2 := sq_pos_of_pos (by linarith)
+  have h2 : 0 ≤ 2 * b ^ 2 * (1 + a ^ 2) := by positivity
+  have h3 : 0 ≤ b ^ 4 := by positivity
+  nlinarith
+
+/-- Cartesian numerator/denominator identity for |(w-i)/(w+i)|². -/
+theorem cayley_norm_difference (x y : ℝ) :
+    (x ^ 2 + (y - 1) ^ 2) - (x ^ 2 + (y + 1) ^ 2) = -4 * y := by
+  ring
+
+/-- Division-free unit-circle condition. The denominator must separately be
+nonzero when this identity is used for a rational Cayley map. -/
+theorem cayley_equal_norms_iff (x y : ℝ) :
+    x ^ 2 + (y - 1) ^ 2 = x ^ 2 + (y + 1) ^ 2 ↔ y = 0 := by
+  constructor
+  · intro h
+    nlinarith
+  · intro h
+    subst y
+    ring
+
+end GRWTSK.Polynomial.Quartic
