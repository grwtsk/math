+import GRWTSK.NumberTheory.Zeta.Riemann.CriticalLineDefect
+import GRWTSK.NumberTheory.Zeta.Riemann.ZeroSymmetry
+import GRWTSK.LinearAlgebra.QuadraticForm.QuarticHermite
+import GRWTSK.Algebra.Polynomial.QuadraticLift
+import GRWTSK.Analysis.Complex.SquaredResidualExclusion
+
+set_option autoImplicit false
+set_option relaxedAutoImplicit false
+
+namespace GRWTSK.NumberTheory.Zeta.Riemann
+
+open GRWTSK.RiemannHypothesis
+open GRWTSK.Polynomial.Quartic
+
+/-- The horizontal displacement in the centered critical strip. -/
+def axisOffset (s : ℂ) : ℝ := s.re - 1 / 2
+
+theorem defect_offset_identity (s : ℂ) : rhDefect s = 4 * axisOffset s ^ 2 := by
+  rw [rh_defect_eq_square]
+  dsimp [axisOffset]
+  ring
+
+theorem gap_defect_identity (s : ℂ) :
+    orbitGap (axisOffset s) s.im = -4 * rhDefect s * s.im ^ 2 := by
+  rw [orbit_gap_identity, defect_offset_identity]
+  ring
+
+theorem discriminant_defect_identity (s : ℂ) :
+    evenDiscriminantExpr (orbitP (axisOffset s) s.im)
+      (orbitR (axisOffset s) s.im) =
+      256 * rhDefect s ^ 2 * s.im ^ 4 * (axisOffset s ^ 2 + s.im ^ 2) ^ 2 := by
+  rw [orbit_discriminant_identity, defect_offset_identity]
+  ring
+
+/-- Height-free characterization; the first inequality retains the zero-height case. -/
+theorem quartic_enclosure_iff (s : ℂ) :
+    (orbitP (axisOffset s) s.im ≤ 0 ∧ 0 ≤ orbitGap (axisOffset s) s.im) ↔
+      s.re = 1 / 2 := by
+  rw [orbit_enclosure_iff]
+  dsimp [axisOffset]
+  constructor <;> intro h <;> linarith
+
+/-- Equivalent reformulation only. Neither inequality is asserted at zeta zeros. -/
+theorem riemannHypothesis_iff_quartic_enclosure :
+    _root_.RiemannHypothesis ↔
+      ∀ s : ℂ, NontrivialZetaZero s →
+        orbitP (axisOffset s) s.im ≤ 0 ∧ 0 ≤ orbitGap (axisOffset s) s.im := by
+  constructor
+  · intro h s hs
+    exact (quartic_enclosure_iff s).mpr (h s hs.1 hs.2.1 hs.2.2)
+  · intro h s hz ht hp
+    exact (quartic_enclosure_iff s).mp (h s ⟨hz, ht, hp⟩)
+
+/-- Equivalent reformulation only; source-derived positivity remains open. -/
+theorem riemannHypothesis_iff_orbitHermite_nonnegative :
+    _root_.RiemannHypothesis ↔
+      ∀ s : ℂ, NontrivialZetaZero s →
+        GRWTSK.QuadraticForm.QuarticHermite.Nonnegative
+          (orbitP (axisOffset s) s.im) (orbitR (axisOffset s) s.im) := by
+  constructor
+  · intro h s hs
+    apply (GRWTSK.QuadraticForm.QuarticHermite.nonnegative_orbit_iff _ _).mpr
+    dsimp [axisOffset]
+    have heq := h s hs.1 hs.2.1 hs.2.2
+    linarith
+  · intro h s hz ht hp
+    have ha := (GRWTSK.QuadraticForm.QuarticHermite.nonnegative_orbit_iff _ _).mp
+      (h s ⟨hz, ht, hp⟩)
+    dsimp [axisOffset] at ha
+    linarith
+
+/-- Local source-bound use of the pre-existing exact matrix checker.
+Both certificate existence and source admissibility remain visible hypotheses. -/
+theorem local_critical_line_of_lifted_certificate {ε γ ν : Type*}
+    [Fintype ε] [Fintype γ] [Fintype ν]
+    (P : GRWTSK.LinearAlgebra.QuadraticCertificates.Problem ℝ (Fin 6) ε γ)
+    (C : GRWTSK.LinearAlgebra.QuadraticCertificates.Certificate ℝ (Fin 6) ε γ ν)
+    (hC : GRWTSK.LinearAlgebra.QuadraticCertificates.Valid P C)
+    (htarget : P.target = GRWTSK.Polynomial.QuadraticLift.gapMatrix)
+    (S : Set ℂ)
+    (hsource : ∀ z ∈ S, NontrivialZetaZero z →
+      P.Admissible (GRWTSK.Polynomial.QuadraticLift.monomials (axisOffset z) z.im))
+    (s : ℂ) (hmem : s ∈ S) (hz : NontrivialZetaZero s) (hheight : s.im ≠ 0) :
+    s.re = 1 / 2 := by
+  have hg := GRWTSK.Polynomial.QuadraticLift.gap_nonnegative_of_certificate
+    P C hC htarget (axisOffset s) s.im (hsource s hmem hz)
+  have ha := axis_of_gap_nonneg_of_height_ne_zero (axisOffset s) s.im hheight hg
+  dsimp [axisOffset] at ha
+  linarith
+
+/-- A sound local enclosure consumer: existence and uniqueness are hypotheses.
+An external root-count certificate must prove uniqueness, not assume it. -/
+theorem local_critical_line_of_unique_zero (S : Set ℂ) (s : ℂ)
+    (hsS : s ∈ S) (hs : NontrivialZetaZero s)
+    (hstable : ∀ z ∈ S, criticalReflection z ∈ S)
+    (hunique : ∀ z ∈ S, NontrivialZetaZero z → z = s) : s.re = 1 / 2 := by
+  have hfix := hunique (criticalReflection s) (hstable s hsS) hs.critical_reflection
+  have hr := congrArg _root_.Complex.re hfix
+  simp [criticalReflection] at hr
+  linarith
+
+/-- Generic local certificates specialize without changing the zero predicate. -/
+theorem no_nontrivial_zero_of_residual_certificate (S : Set ℂ)
+    (c : GRWTSK.Complex.SquaredResidualExclusion.Certificate riemannZeta S)
+    (s : ℂ) (hs : s ∈ S) : ¬ NontrivialZetaZero s := by
+  intro hz
+  exact c.nonzero s hs hz.1
+
+/-- A cover must really cover every off-line nontrivial zero. Finite coverage
+is not silently promoted to an unbounded critical-strip claim. -/
+theorem riemannHypothesis_of_exclusion_cover {ι : Type*} (S : ι → Set ℂ)
+    (cert : ∀ i, GRWTSK.Complex.SquaredResidualExclusion.Certificate riemannZeta (S i))
+    (cover : ∀ s : ℂ, NontrivialZetaZero s → s.re ≠ 1 / 2 → ∃ i, s ∈ S i) :
+    _root_.RiemannHypothesis := by
+  intro s hz ht hp
+  by_contra hoff
+  have hs : NontrivialZetaZero s := ⟨hz, ht, hp⟩
+  obtain ⟨i, hi⟩ := cover s hs hoff
+  exact (cert i).nonzero s hi hz
+
+end GRWTSK.NumberTheory.Zeta.Riemann
