+import GRWTSK.Algebra.Polynomial.Quartic.ReflectionOrbit
+
+set_option autoImplicit false
+set_option relaxedAutoImplicit false
+
+namespace GRWTSK.QuadraticForm.QuarticHermite
+
+open GRWTSK.Polynomial.Quartic
+
+/-- Expanded Hankel form for Newton sums m0=4, m1=m3=m5=0,
+m2=-2p, m4=2p²-4r and m6=-2p³+6pr.
+This module uses the explicit form, not a substituted positive Gram matrix. -/
+def value (p r u0 u1 u2 u3 : ℝ) : ℝ :=
+  4 * u0 ^ 2 - 4 * p * u0 * u2 - 2 * p * u1 ^ 2 +
+    (2 * p ^ 2 - 4 * r) * u2 ^ 2 +
+    2 * (2 * p ^ 2 - 4 * r) * u1 * u3 +
+    (-2 * p ^ 3 + 6 * p * r) * u3 ^ 2
+
+def Nonnegative (p r : ℝ) : Prop :=
+  ∀ u0 u1 u2 u3 : ℝ, 0 ≤ value p r u0 u1 u2 u3
+
+theorem second_moment_test (p r : ℝ) :
+    value p r 0 1 0 0 = -2 * p := by
+  dsimp [value]
+  ring
+
+theorem discriminant_gap_test (p r : ℝ) :
+    value p r (p / 2) 0 1 0 = p ^ 2 - 4 * r := by
+  dsimp [value]
+  ring
+
+theorem even_principal_minor (p r : ℝ) :
+    4 * (2 * p ^ 2 - 4 * r) - (-2 * p) ^ 2 = 4 * (p ^ 2 - 4 * r) := by
+  ring
+
+theorem axis_sum_of_squares (b u0 u1 u2 u3 : ℝ) :
+    value (orbitP 0 b) (orbitR 0 b) u0 u1 u2 u3 =
+      4 * (u0 + b ^ 2 * u2) ^ 2 +
+        4 * b ^ 2 * (u1 + b ^ 2 * u3) ^ 2 := by
+  dsimp [value, orbitP, orbitR]
+  ring
+
+/-- Exact orbit characterization, not an assertion of zeta-derived positivity. -/
+theorem nonnegative_orbit_iff (a b : ℝ) :
+    Nonnegative (orbitP a b) (orbitR a b) ↔ a = 0 := by
+  constructor
+  · intro h
+    have hp := h 0 1 0 0
+    rw [second_moment_test] at hp
+    have hg := h (orbitP a b / 2) 0 1 0
+    rw [discriminant_gap_test] at hg
+    apply (orbit_enclosure_iff a b).mp
+    exact ⟨by linarith, hg⟩
+  · intro ha
+    subst a
+    intro u0 u1 u2 u3
+    rw [axis_sum_of_squares]
+    positivity
+
+/-- A matrix lower-bound error must be multiplied by the test-vector norm.
+Here η bounds the full quadratic form against the Euclidean norm squared. -/
+theorem normalized_error_collar (a b η : ℝ)
+    (h : ∀ u0 u1 u2 u3 : ℝ,
+      -η * (u0 ^ 2 + u1 ^ 2 + u2 ^ 2 + u3 ^ 2) ≤
+        value (orbitP a b) (orbitR a b) u0 u1 u2 u3) :
+    16 * a ^ 2 * b ^ 2 ≤ η * (1 + orbitP a b ^ 2 / 4) := by
+  have ht := h (orbitP a b / 2) 0 1 0
+  rw [discriminant_gap_test] at ht
+  have hid := orbit_gap_identity a b
+  dsimp [orbitGap] at hid
+  nlinarith
+
+end GRWTSK.QuadraticForm.QuarticHermite
