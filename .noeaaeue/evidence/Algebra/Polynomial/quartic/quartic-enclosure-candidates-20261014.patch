+import Mathlib.Tactic
+
+set_option autoImplicit false
+set_option relaxedAutoImplicit false
+
+namespace GRWTSK.Complex.SquaredResidualExclusion
+
+/-- Generic certificate. Polynomial/Taylor producers must prove these fields;
+this consumer neither fabricates an analytic remainder nor checks sample points. -/
+structure Certificate {α : Type*} (F : α → ℂ) (S : Set α) where
+  realApprox : α → ℝ
+  imagApprox : α → ℝ
+  errorSq : α → ℝ
+  residual_le : ∀ x ∈ S,
+    ((F x).re - realApprox x) ^ 2 + ((F x).im - imagApprox x) ^ 2 ≤ errorSq x
+  strict_gap : ∀ x ∈ S,
+    errorSq x < realApprox x ^ 2 + imagApprox x ^ 2
+
+/-- Exact zero exclusion without a bound on F'/F. -/
+theorem Certificate.nonzero {α : Type*} {F : α → ℂ} {S : Set α}
+    (c : Certificate F S) (x : α) (hx : x ∈ S) : F x ≠ 0 := by
+  intro hz
+  have hb := c.residual_le x hx
+  have hg := c.strict_gap x hx
+  simp only [hz, _root_.Complex.zero_re, _root_.Complex.zero_im, zero_sub, neg_sq] at hb
+  linarith
+
+/-- Closed, non-strict separation is insufficient. -/
+theorem nonstrict_gap_guard :
+    ((0 : ℝ) - 1) ^ 2 ≤ 1 ^ 2 ∧ ¬ ((0 : ℂ) ≠ 0) := by
+  norm_num
+
+end GRWTSK.Complex.SquaredResidualExclusion
