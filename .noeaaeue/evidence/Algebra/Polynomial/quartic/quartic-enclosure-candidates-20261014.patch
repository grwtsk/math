+namespace GRWTSK.Polynomial.Quartic
+
+variable {R : Type*} [CommRing R]
+
+/-- Unweighted coefficients aX⁴+bX³Z+cX²Z²+dXZ³+eZ⁴. -/
+def binaryI (a b c d e : R) : R := 12 * a * e - 3 * b * d + c ^ 2
+
+def binaryJ (a b c d e : R) : R :=
+  72 * a * c * e + 9 * b * c * d - 27 * a * d ^ 2 -
+    27 * b ^ 2 * e - 2 * c ^ 3
+
+/-- Polynomial discriminant normalization. Fisher's genus-one-model
+normalization is 16 times this expression. -/
+def binaryDiscriminantExpr (a b c d e : R) : R :=
+  256 * a ^ 3 * e ^ 3 - 192 * a ^ 2 * b * d * e ^ 2 -
+  128 * a ^ 2 * c ^ 2 * e ^ 2 + 144 * a ^ 2 * c * d ^ 2 * e -
+  27 * a ^ 2 * d ^ 4 + 144 * a * b ^ 2 * c * e ^ 2 -
+  6 * a * b ^ 2 * d ^ 2 * e - 80 * a * b * c ^ 2 * d * e +
+  18 * a * b * c * d ^ 3 + 16 * a * c ^ 4 * e -
+  4 * a * c ^ 3 * d ^ 2 - 27 * b ^ 4 * e ^ 2 +
+  18 * b ^ 3 * c * d * e - 4 * b ^ 3 * d ^ 3 -
+  4 * b ^ 2 * c ^ 3 * e + b ^ 2 * c ^ 2 * d ^ 2
+
+theorem binary_invariant_identity (a b c d e : R) :
+    4 * binaryI a b c d e ^ 3 - binaryJ a b c d e ^ 2 =
+      27 * binaryDiscriminantExpr a b c d e := by
+  dsimp [binaryI, binaryJ, binaryDiscriminantExpr]
+  ring
+
+theorem even_binary_specialization (p r : R) :
+    binaryI 1 0 p 0 r = evenInvariantI p r ∧
+    binaryJ 1 0 p 0 r = evenInvariantJ p r ∧
+    binaryDiscriminantExpr 1 0 p 0 r = evenDiscriminantExpr p r := by
+  dsimp [binaryI, binaryJ, binaryDiscriminantExpr,
+    evenInvariantI, evenInvariantJ, evenDiscriminantExpr]
+  constructor
+  · ring
+  constructor <;> ring
+
+/-- Algebraic compatibility with y²=x³-27Ix-27J. This does not construct
+its Jacobian, cohomology, modular parametrization, or a zeta correspondence. -/
+theorem jacobian_discriminant_scale (I J : R) :
+    -16 * (4 * (-27 * I) ^ 3 + 27 * (-27 * J) ^ 2) =
+      16 * 27 ^ 3 * (4 * I ^ 3 - J ^ 2) := by
+  ring
+
+end GRWTSK.Polynomial.Quartic
