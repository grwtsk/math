+import Mathlib.Tactic
+
+set_option autoImplicit false
+set_option relaxedAutoImplicit false
+
+namespace GRWTSK.Polynomial.Quartic
+
+section Ring
+variable {R : Type*} [CommRing R]
+
+/-- Evaluation of the monic even quartic. -/
+def evenValue (p r x : R) : R := x ^ 4 + p * x ^ 2 + r
+
+/-- Evaluation of its formal derivative, written without division. -/
+def evenDerivativeValue (p x : R) : R := 4 * x ^ 3 + 2 * p * x
+
+/-- Closed polynomial-discriminant expression, not a definition of the
+Mathlib discriminant API. Its resultant-API identification remains a separate
+integration obligation. The Bezout identity below is independently usable. -/
+def evenDiscriminantExpr (p r : R) : R := 16 * r * (p ^ 2 - 4 * r) ^ 2
+
+def evenInvariantI (p r : R) : R := p ^ 2 + 12 * r
+
+def evenInvariantJ (p r : R) : R := 72 * p * r - 2 * p ^ 3
+
+theorem even_invariant_identity (p r : R) :
+    4 * evenInvariantI p r ^ 3 - evenInvariantJ p r ^ 2 =
+      27 * evenDiscriminantExpr p r := by
+  dsimp [evenInvariantI, evenInvariantJ, evenDiscriminantExpr]
+  ring
+
+/-- One conventional cubic resolvent factors completely for an even quartic. -/
+theorem even_resolvent_factor (p r y : R) :
+    y ^ 3 - p * y ^ 2 - 4 * r * y + 4 * p * r =
+      (y - p) * (y ^ 2 - 4 * r) := by
+  ring
+
+/-- A denominator-free Bezout certificate for the quartic and its derivative. -/
+theorem even_bezout (p r x : R) :
+    (16 * (p ^ 2 - 4 * r) * (p ^ 2 + 2 * p * x ^ 2 - 4 * r)) *
+        evenValue p r x +
+    (-8 * x * (p ^ 2 - 4 * r) * (p ^ 2 + p * x ^ 2 - 2 * r)) *
+        evenDerivativeValue p x = evenDiscriminantExpr p r := by
+  dsimp [evenValue, evenDerivativeValue, evenDiscriminantExpr]
+  ring
+
+theorem common_root_forces_discriminant_expr_zero (p r x : R)
+    (h : evenValue p r x = 0) (hd : evenDerivativeValue p x = 0) :
+    evenDiscriminantExpr p r = 0 := by
+  have hc := even_bezout p r x
+  simpa [h, hd] using hc.symm
+
+theorem no_common_root_of_discriminant_expr_ne_zero (p r x : R)
+    (hdisc : evenDiscriminantExpr p r ≠ 0) :
+    ¬ (evenValue p r x = 0 ∧ evenDerivativeValue p x = 0) := by
+  rintro ⟨h, hd⟩
+  exact hdisc (common_root_forces_discriminant_expr_zero p r x h hd)
+
+end Ring
+end GRWTSK.Polynomial.Quartic
