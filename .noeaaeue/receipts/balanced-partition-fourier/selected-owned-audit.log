BALANCED_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSmallEnergySets","name":"GRWTSK.ZModSmallEnergySets.sum_mem_smallEnergyPoints","partial":false,"type":"∀ {p : ℕ} [inst : NeZero p] {ι : Type u_1} (I : Finset ι),\n  I.Nonempty →\n    ∀ (B : Finset (ZMod p)) (δ : ℝ) (x : ι → ZMod p),\n      (∀ i ∈ I, x i ∈ GRWTSK.ZModSmallEnergySets.smallEnergyPoints B δ) →\n        ∑ i ∈ I, x i ∈ GRWTSK.ZModSmallEnergySets.smallEnergyPoints B (↑I.card ^ 2 * δ)","unsafe":false}
BALANCED_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSmallEnergySets","name":"GRWTSK.ZModSmallEnergySets.character_sum_parseval","partial":false,"type":"∀ {p : ℕ} [inst : NeZero p] (B : Finset (ZMod p)), ∑ x, ‖∑ χ ∈ B, ZMod.stdAddChar (χ * x)‖ ^ 2 = ↑p * ↑B.card","unsafe":false}
BALANCED_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSmallEnergySets","name":"GRWTSK.ZModSmallEnergySets.smallEnergyPoints_card_lower_of_pairEnergy","partial":false,"type":"∀ {p : ℕ} [inst : NeZero p] (S B : Finset (ZMod p)),\n  S.Nonempty →\n    B.Nonempty →\n      ∀ (r : ℝ),\n        0 < r →\n          (∀ χ ∈ B, GRWTSK.ZModCharacterEnergy.pairEnergy S χ ≤ r) →\n            9 / 10 * ↑S.card ≤ ↑(GRWTSK.ZModSmallEnergySets.smallEnergyPoints B (10 * r)).card","unsafe":false}
BALANCED_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSmallEnergySets","name":"GRWTSK.ZModSmallEnergySets.filter_card_mul_le_sum","partial":false,"type":"∀ {ι : Type u_1} (I : Finset ι) (f : ι → ℝ), (∀ i ∈ I, 0 ≤ f i) → ∀ (a : ℝ), ↑{i ∈ I | a ≤ f i}.card * a ≤ ∑ i ∈ I, f i","unsafe":false}
