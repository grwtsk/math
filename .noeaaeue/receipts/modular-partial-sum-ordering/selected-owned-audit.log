ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.PrimeCyclicRearrangement","name":"GRWTSK.PrimeCyclicRearrangement.mem_goodPermutationEvent_iff._simp_1_2","partial":false,"type":"∀ {α : Type u_1} [inst : DecidableEq α] {s t : Finset α} {a : α}, (a ∈ s \\ t) = (a ∈ s ∧ a ∉ t)","unsafe":false}
