ORDERING_DECL::{"axioms":["propext"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.PartialSumCertificate","name":"GRWTSK.PartialSumOrdering.OrderingCertificate.mk.injEq","partial":false,"type":"∀ {p : ℕ} (originalOrder finalOrder : List (ZMod p)) (swaps : GRWTSK.PartialSumOrdering.SwapTrace originalOrder.length)\n  (repairRadius sourceRevision epoch : ℕ) (originalOrder_1 finalOrder_1 : List (ZMod p))\n  (swaps_1 : GRWTSK.PartialSumOrdering.SwapTrace originalOrder_1.length) (repairRadius_1 sourceRevision_1 epoch_1 : ℕ),\n  ({ originalOrder := originalOrder, finalOrder := finalOrder, swaps := swaps, repairRadius := repairRadius,\n        sourceRevision := sourceRevision, epoch := epoch } =\n      { originalOrder := originalOrder_1, finalOrder := finalOrder_1, swaps := swaps_1, repairRadius := repairRadius_1,\n        sourceRevision := sourceRevision_1, epoch := epoch_1 }) =\n    (originalOrder = originalOrder_1 ∧\n      finalOrder = finalOrder_1 ∧\n        swaps ≍ swaps_1 ∧ repairRadius = repairRadius_1 ∧ sourceRevision = sourceRevision_1 ∧ epoch = epoch_1)","unsafe":false}
