ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSubsetSum","name":"GRWTSK.ZModSubsetSum.subsetSumFiber.eq_1","partial":false,"type":"∀ {p : ℕ} [inst : NeZero p] (S : Finset (ZMod p)) (m : ℕ) (z : ZMod p),\n  GRWTSK.ZModSubsetSum.subsetSumFiber S m z = {R ∈ Finset.powersetCard m S | ∑ x ∈ R, x = z}","unsafe":false}
