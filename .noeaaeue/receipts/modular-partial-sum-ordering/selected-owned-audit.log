ORDERING_DECL::{"axioms":["propext","Quot.sound"],"kind":"theorem","module":"GRWTSK.DynamicalSystems.TransitionSystems.ModularCheckpoint","name":"GRWTSK.ModularCheckpoint.executes_budget_exact._proof_1_1","partial":false,"type":"∀ {Source : Type u_1} {Obligation : Type u_2} {Effect : Type u_3} {Grant : Type u_4} {Surface : Type u_5}\n  {state final : GRWTSK.ProofHorizon.CorkscrewChamberCap.ControllerState Source Obligation Effect Grant Surface}\n  {proposal : GRWTSK.ProofHorizon.CorkscrewChamberCap.ControllerProposal Source Obligation Effect Grant Surface}\n  {rest : List (GRWTSK.ProofHorizon.CorkscrewChamberCap.ControllerProposal Source Obligation Effect Grant Surface)},\n  (List.map GRWTSK.ProofHorizon.CorkscrewChamberCap.ControllerProposal.cost rest).sum + final.remaining =\n        state.remaining - proposal.cost ∧\n      final.consumed =\n        state.consumed + proposal.cost +\n          (List.map GRWTSK.ProofHorizon.CorkscrewChamberCap.ControllerProposal.cost rest).sum →\n    proposal.cost ≤ state.remaining →\n      ¬proposal.cost + (List.map GRWTSK.ProofHorizon.CorkscrewChamberCap.ControllerProposal.cost rest).sum +\n              final.remaining =\n            state.remaining →\n        False","unsafe":false}
