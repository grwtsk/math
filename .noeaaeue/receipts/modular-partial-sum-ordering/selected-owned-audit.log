ORDERING_DECL::{"axioms":[],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.PartialSumCertificate","name":"GRWTSK.PartialSumOrdering.OrderingCertificate.mk.sizeOf_spec","partial":false,"type":"∀ {p : ℕ} (originalOrder finalOrder : List (ZMod p)) (swaps : GRWTSK.PartialSumOrdering.SwapTrace originalOrder.length)\n  (repairRadius sourceRevision epoch : ℕ),\n  sizeOf\n      { originalOrder := originalOrder, finalOrder := finalOrder, swaps := swaps, repairRadius := repairRadius,\n        sourceRevision := sourceRevision, epoch := epoch } =\n    1 + sizeOf originalOrder + sizeOf finalOrder + sizeOf swaps + sizeOf repairRadius + sizeOf sourceRevision +\n      sizeOf epoch","unsafe":false}
