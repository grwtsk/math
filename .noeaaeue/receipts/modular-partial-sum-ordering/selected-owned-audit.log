ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSubsetSum","name":"GRWTSK.ZModSubsetSum.subsetSumFiber_mem","partial":false,"type":"∀ {p : ℕ} [inst : NeZero p] (S : Finset (ZMod p)) (m : ℕ) (z : ZMod p) (R : Finset (ZMod p)),\n  R ∈ GRWTSK.ZModSubsetSum.subsetSumFiber S m z ↔ R ⊆ S ∧ R.card = m ∧ ∑ x ∈ R, x = z","unsafe":false}
