ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.ZeroSumIntervalRepair","name":"GRWTSK.PartialSumOrdering.goodRepairGeometry_valid_permutation","partial":false,"type":"∀ {G : Type u_1} [inst : AddCommGroup G] {n : ℕ} (σ : Fin n → G) (D : ℕ),\n  (∀ (i : Fin n), σ i ≠ 0) →\n    GRWTSK.PartialSumOrdering.GoodRepairGeometry σ D →\n      ∃ trace,\n        GRWTSK.PartialSumOrdering.SupportsDisjoint trace ∧\n          GRWTSK.PartialSumOrdering.TraceBounded D trace ∧\n            (List.ofFn (σ ∘ ⇑(GRWTSK.PartialSumOrdering.replayPermutation trace))).Perm (List.ofFn σ) ∧\n              GRWTSK.PartialSumOrdering.ValidPartialSumOrder\n                (List.ofFn (σ ∘ ⇑(GRWTSK.PartialSumOrdering.replayPermutation trace)))","unsafe":false}
