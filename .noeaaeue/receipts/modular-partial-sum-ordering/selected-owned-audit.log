ORDERING_DECL::{"axioms":["propext","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.ZeroSumIntervalRepair","name":"GRWTSK.PartialSumOrdering.supportsDisjoint_append_swap","partial":false,"type":"∀ {n : ℕ} (trace : GRWTSK.PartialSumOrdering.SwapTrace n),\n  GRWTSK.PartialSumOrdering.SupportsDisjoint trace →\n    ∀ (s : GRWTSK.PartialSumOrdering.PositionSwap n),\n      s.left ≠ s.right →\n        s.left ∉ GRWTSK.PartialSumOrdering.traceSupport trace →\n          s.right ∉ GRWTSK.PartialSumOrdering.traceSupport trace →\n            GRWTSK.PartialSumOrdering.SupportsDisjoint (trace ++ [s])","unsafe":false}
