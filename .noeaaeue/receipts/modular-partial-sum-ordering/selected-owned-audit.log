ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.ZeroSumIntervalRepair","name":"GRWTSK.PartialSumOrdering.repairWindow_available._proof_1_1","partial":false,"type":"∀ {n : ℕ} (b : Fin n) (D : ℕ) (blocked original used : Finset (Fin n)),\n  (blocked ∩ GRWTSK.PartialSumOrdering.repairWindow b D).card < 2 * D →\n    (original ∩ GRWTSK.PartialSumOrdering.repairWindow b D).card ≤ D →\n      (used ∩ GRWTSK.PartialSumOrdering.repairWindow b D).card ≤ D →\n        (blocked ∩ GRWTSK.PartialSumOrdering.repairWindow b D ∪ original ∩ GRWTSK.PartialSumOrdering.repairWindow b D ∪\n                used ∩ GRWTSK.PartialSumOrdering.repairWindow b D).card ≤\n            (blocked ∩ GRWTSK.PartialSumOrdering.repairWindow b D).card +\n                (original ∩ GRWTSK.PartialSumOrdering.repairWindow b D).card +\n              (used ∩ GRWTSK.PartialSumOrdering.repairWindow b D).card →\n          (GRWTSK.PartialSumOrdering.repairWindow b D).card = 5 * D →\n            ¬(blocked ∩ GRWTSK.PartialSumOrdering.repairWindow b D ∪\n                        original ∩ GRWTSK.PartialSumOrdering.repairWindow b D ∪\n                      used ∩ GRWTSK.PartialSumOrdering.repairWindow b D).card <\n                  (GRWTSK.PartialSumOrdering.repairWindow b D).card →\n              False","unsafe":false}
