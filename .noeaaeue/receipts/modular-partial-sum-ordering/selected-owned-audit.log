ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSubsetSum","name":"GRWTSK.ZModSubsetSum.fourier_mass_bound","partial":false,"type":"∀ {p : ℕ} [inst : NeZero p] (f : ZMod p → ℂ) (z : ZMod p), ‖f z‖ ≤ ‖(↑p)⁻¹‖ * ∑ χ, ‖ZMod.dft f χ‖","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"definition","module":"GRWTSK.Analysis.Fourier.ZModSubsetSum","name":"GRWTSK.ZModSubsetSum.subsetSumProbability","partial":false,"type":"{p : ℕ} → [NeZero p] → Finset (ZMod p) → ℕ → ZMod p → ℚ","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSubsetSum","name":"GRWTSK.ZModSubsetSum.fourier_nontrivial_mass_bound","partial":false,"type":"∀ {p : ℕ} [inst : NeZero p] (f : ZMod p → ℂ),\n  ∑ z, f z = 1 → ∀ (z : ZMod p), ‖f z‖ ≤ (↑p)⁻¹ * (1 + ∑ χ ∈ Finset.univ.erase 0, ‖ZMod.dft f χ‖)","unsafe":false}
