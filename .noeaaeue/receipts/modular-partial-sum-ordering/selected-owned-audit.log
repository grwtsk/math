ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.PrimeCyclicRearrangement","name":"GRWTSK.PrimeCyclicRearrangement.zero_packet_search_rejected","partial":false,"type":"GRWTSK.PrimeCyclicRearrangement.exhaustiveSearch [0, 0] = none","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.PrimeCyclicRearrangement","name":"GRWTSK.PrimeCyclicRearrangement.goodPermutationEvent.eq_1","partial":false,"type":"∀ {G : Type u_1} [inst : AddCommGroup G] {n : ℕ} (σ : Fin n → G) (D : ℕ),\n  GRWTSK.PrimeCyclicRearrangement.goodPermutationEvent σ D =\n    GRWTSK.ZModSubsetSum.permutationSpace n \\\n      (GRWTSK.PrimeCyclicRearrangement.tailFailure σ D ∪ GRWTSK.PrimeCyclicRearrangement.densityFailure σ D ∪\n        GRWTSK.PrimeCyclicRearrangement.compatibilityFailure σ D)","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.PrimeCyclicRearrangement","name":"GRWTSK.PrimeCyclicRearrangement.exhaustiveSearch_success_iff._simp_1_2","partial":false,"type":"∀ {α : Type u_1} {xs : List α} {p : α → Bool}, ((List.find? p xs).isSome = true) = ∃ x ∈ xs, p x = true","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.PrimeCyclicRearrangement","name":"GRWTSK.PrimeCyclicRearrangement.exhaustiveSearch.eq_1","partial":false,"type":"∀ {G : Type u_1} [inst : AddCommGroup G] [inst_1 : DecidableEq G] (xs : List G),\n  GRWTSK.PrimeCyclicRearrangement.exhaustiveSearch xs =\n    List.find? (fun ys => decide (GRWTSK.PartialSumOrdering.ValidPartialSumOrder ys)) xs.permutations","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.PrimeCyclicRearrangement","name":"GRWTSK.PrimeCyclicRearrangement.exhaustiveSearch_none_iff","partial":false,"type":"∀ {G : Type u_1} [inst : AddCommGroup G] [inst_1 : DecidableEq G] (xs : List G),\n  GRWTSK.PrimeCyclicRearrangement.exhaustiveSearch xs = none ↔\n    ¬∃ ys, ys.Perm xs ∧ GRWTSK.PartialSumOrdering.ValidPartialSumOrder ys","unsafe":false}
