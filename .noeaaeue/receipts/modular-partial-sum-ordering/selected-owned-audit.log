ORDERING_DECL::{"axioms":[],"kind":"theorem","module":"GRWTSK.DynamicalSystems.TransitionSystems.ModularCheckpoint","name":"GRWTSK.ModularCheckpoint.Address.mk.sizeOf_spec","partial":false,"type":"∀ {Revision : Type u} {p : ℕ} [inst : SizeOf Revision] (sourceRevision : Revision)\n  (epoch absoluteLift cumulativeCost : ℕ) (modularPhase : ZMod p),\n  sizeOf\n      { sourceRevision := sourceRevision, epoch := epoch, absoluteLift := absoluteLift,\n        cumulativeCost := cumulativeCost, modularPhase := modularPhase } =\n    1 + sizeOf sourceRevision + sizeOf epoch + sizeOf absoluteLift + sizeOf cumulativeCost + sizeOf modularPhase","unsafe":false}
