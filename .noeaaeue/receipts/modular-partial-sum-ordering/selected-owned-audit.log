ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.ZeroSumIntervalRepair","name":"GRWTSK.PartialSumOrdering.Blocked.eq_1","partial":false,"type":"∀ {G : Type u_1} [inst : AddCommGroup G] {n : ℕ} (σ : Fin n → G) (b : Fin n) (π : Equiv.Perm (Fin n)) (y : Fin n),\n  GRWTSK.PartialSumOrdering.Blocked σ b π y =\n    ∃ a t,\n      1 ≤ ↑a ∧\n        a < t ∧\n          GRWTSK.PartialSumOrdering.positionIntervalSum (σ ∘ ⇑π ∘ ⇑(Equiv.swap b y)) a t = 0 ∧\n            (b < a ∧ a ≤ y ∨ b ≤ t ∧ t < y)","unsafe":false}
