ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.PrimeCyclicRearrangement","name":"GRWTSK.PrimeCyclicRearrangement.exhaustiveSearch_none_iff._simp_1_3","partial":false,"type":"∀ {α : Type u_1} {s t : List α}, (s ∈ t.permutations) = s.Perm t","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.PrimeCyclicRearrangement","name":"GRWTSK.PrimeCyclicRearrangement.exhaustiveSearch_success_iff","partial":false,"type":"∀ {G : Type u_1} [inst : AddCommGroup G] [inst_1 : DecidableEq G] (xs : List G),\n  (GRWTSK.PrimeCyclicRearrangement.exhaustiveSearch xs).isSome = true ↔\n    ∃ ys, ys.Perm xs ∧ GRWTSK.PartialSumOrdering.ValidPartialSumOrder ys","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.PrimeCyclicRearrangement","name":"GRWTSK.PrimeCyclicRearrangement.densityFailure.eq_1","partial":false,"type":"∀ {G : Type u_1} [inst : AddCommGroup G] {n : ℕ} (σ : Fin n → G) (D : ℕ),\n  GRWTSK.PrimeCyclicRearrangement.densityFailure σ D =\n    {π ∈ GRWTSK.ZModSubsetSum.permutationSpace n |\n      ¬∀ (z : Fin n), (GRWTSK.PartialSumOrdering.badNeighborhood (σ ∘ ⇑π) z D).card ≤ D}","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.PrimeCyclicRearrangement","name":"GRWTSK.PrimeCyclicRearrangement.not_mem_failure_union_iff_good","partial":false,"type":"∀ {G : Type u_1} [inst : AddCommGroup G] {n : ℕ} (σ : Fin n → G) (D : ℕ),\n  0 < D →\n    ∀ (ρ : Equiv.Perm (Fin n)),\n      ρ ∉\n          GRWTSK.PrimeCyclicRearrangement.tailFailure σ D ∪ GRWTSK.PrimeCyclicRearrangement.densityFailure σ D ∪\n            GRWTSK.PrimeCyclicRearrangement.compatibilityFailure σ D ↔\n        GRWTSK.PartialSumOrdering.GoodRepairGeometry (σ ∘ ⇑ρ) D","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.PrimeCyclicRearrangement","name":"GRWTSK.PrimeCyclicRearrangement.conditional_good_geometry_probability","partial":false,"type":"∀ {G : Type u_1} [inst : AddCommGroup G] {n : ℕ} (σ : Fin n → G) (D : ℕ),\n  GRWTSK.ZModSubsetSum.probability (GRWTSK.ZModSubsetSum.permutationSpace n)\n        (GRWTSK.PrimeCyclicRearrangement.tailFailure σ D) ≤\n      1 / 100 →\n    GRWTSK.ZModSubsetSum.probability (GRWTSK.ZModSubsetSum.permutationSpace n)\n          (GRWTSK.PrimeCyclicRearrangement.densityFailure σ D) ≤\n        3 / 100 →\n      GRWTSK.ZModSubsetSum.probability (GRWTSK.ZModSubsetSum.permutationSpace n)\n            (GRWTSK.PrimeCyclicRearrangement.compatibilityFailure σ D) ≤\n          1 / 25 →\n        23 / 25 ≤\n          GRWTSK.ZModSubsetSum.probability (GRWTSK.ZModSubsetSum.permutationSpace n)\n            (GRWTSK.PrimeCyclicRearrangement.goodPermutationEvent σ D)","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.PrimeCyclicRearrangement","name":"GRWTSK.PrimeCyclicRearrangement.conditional_rearrangement_from_failure_bounds","partial":false,"type":"∀ {G : Type u_1} [inst : AddCommGroup G] {n : ℕ} (σ : Fin n → G) (D : ℕ),\n  0 < D →\n    (∀ (i : Fin n), σ i ≠ 0) →\n      GRWTSK.ZModSubsetSum.probability (GRWTSK.ZModSubsetSum.permutationSpace n)\n            (GRWTSK.PrimeCyclicRearrangement.tailFailure σ D) ≤\n          1 / 100 →\n        GRWTSK.ZModSubsetSum.probability (GRWTSK.ZModSubsetSum.permutationSpace n)\n              (GRWTSK.PrimeCyclicRearrangement.densityFailure σ D) ≤\n            3 / 100 →\n          GRWTSK.ZModSubsetSum.probability (GRWTSK.ZModSubsetSum.permutationSpace n)\n                (GRWTSK.PrimeCyclicRearrangement.compatibilityFailure σ D) ≤\n              1 / 25 →\n            ∃ xs, xs.Perm (List.ofFn σ) ∧ GRWTSK.PartialSumOrdering.ValidPartialSumOrder xs","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.PrimeCyclicRearrangement","name":"GRWTSK.PrimeCyclicRearrangement.exhaustiveSearch_complete","partial":false,"type":"∀ {G : Type u_1} [inst : AddCommGroup G] [inst_1 : DecidableEq G] {xs : List G},\n  (∃ ys, ys.Perm xs ∧ GRWTSK.PartialSumOrdering.ValidPartialSumOrder ys) →\n    ∃ ys,\n      GRWTSK.PrimeCyclicRearrangement.exhaustiveSearch xs = some ys ∧\n        ys.Perm xs ∧ GRWTSK.PartialSumOrdering.ValidPartialSumOrder ys","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.PrimeCyclicRearrangement","name":"GRWTSK.PrimeCyclicRearrangement.exhaustiveSearch_sound","partial":false,"type":"∀ {G : Type u_1} [inst : AddCommGroup G] [inst_1 : DecidableEq G] {xs ys : List G},\n  GRWTSK.PrimeCyclicRearrangement.exhaustiveSearch xs = some ys →\n    ys.Perm xs ∧ GRWTSK.PartialSumOrdering.ValidPartialSumOrder ys","unsafe":false}
