ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSubsetSum","name":"GRWTSK.ZModSubsetSum.probability_union_le","partial":false,"type":"∀ {Ω : Type u_1} [inst : DecidableEq Ω] (space A B : Finset Ω),\n  GRWTSK.ZModSubsetSum.probability space (A ∪ B) ≤\n    GRWTSK.ZModSubsetSum.probability space A + GRWTSK.ZModSubsetSum.probability space B","unsafe":false}
ORDERING_DECL::{"axioms":["propext"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSubsetSum","name":"GRWTSK.ZModSubsetSum.three_failure_good_mass._simp_1_6","partial":false,"type":"∀ {M₀ : Type u_1} [inst : Mul M₀] [inst_1 : Zero M₀] [NoZeroDivisors M₀] {a b : M₀}, a ≠ 0 → b ≠ 0 → (a * b = 0) = False","unsafe":false}
