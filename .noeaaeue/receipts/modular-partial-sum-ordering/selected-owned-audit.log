ORDERING_DECL::{"axioms":["propext","Quot.sound"],"kind":"theorem","module":"GRWTSK.DynamicalSystems.TransitionSystems.ModularCheckpoint","name":"GRWTSK.ModularCheckpoint.TrackedSession.restart.eq_1","partial":false,"type":"∀ {Artifact : Type u} {Revision : Type v} {Claim : Type w} {Effect : Type x} {Grant : Type y} {Surface : Type z}\n  {I : Type u_1}\n  {policy :\n    GRWTSK.ProofHorizon.CorkscrewChamberCap.ControllerPolicy\n      (GRWTSK.ProofHorizon.CorkscrewChamberCap.SourceSnapshot Artifact Revision) Claim Effect Grant Surface}\n  (tracked : GRWTSK.ModularCheckpoint.TrackedSession policy I) (freshAllowance : ℕ),\n  tracked.restart freshAllowance =\n    {\n      session :=\n        tracked.session.history.startSession { budget := freshAllowance, liftOrigin := tracked.session.active.lift },\n      epoch := tracked.epoch + 1,\n      searchHistory :=\n        tracked.searchHistory ++\n          [GRWTSK.ModularCheckpoint.SearchEvent.replenishment tracked.session.history.snapshot (tracked.epoch + 1)\n              freshAllowance] }","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Quot.sound"],"kind":"theorem","module":"GRWTSK.DynamicalSystems.TransitionSystems.ModularCheckpoint","name":"GRWTSK.ModularCheckpoint.terminal_cost_conserved","partial":false,"type":"∀ {I : Type u} (origin : ℕ) (cost : I → ℕ) {before after : List I},\n  before.Perm after →\n    GRWTSK.ModularCheckpoint.physicalTime origin cost before before.length =\n      GRWTSK.ModularCheckpoint.physicalTime origin cost after after.length","unsafe":false}
