ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.ZeroSumIntervalRepair","name":"GRWTSK.PartialSumOrdering.GoodRepairGeometry.tailSafety","partial":false,"type":"∀ {G : Type u_1} [inst : AddCommGroup G] {n : ℕ} {σ : Fin n → G} {D : ℕ},\n  GRWTSK.PartialSumOrdering.GoodRepairGeometry σ D →\n    ∀ b ∈ GRWTSK.PartialSumOrdering.BadRightEndpoints σ, ↑b + 1 + 30 * D < n","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.ZeroSumIntervalRepair","name":"GRWTSK.PartialSumOrdering.usedRepairPositions_window_card","partial":false,"type":"∀ {G : Type u_1} [inst : AddCommGroup G] {n : ℕ} (σ : Fin n → G) (D : ℕ),\n  GRWTSK.PartialSumOrdering.GoodRepairGeometry σ D →\n    ∀ (trace : GRWTSK.PartialSumOrdering.SwapTrace n),\n      GRWTSK.PartialSumOrdering.SupportsDisjoint trace →\n        GRWTSK.PartialSumOrdering.TraceBounded D trace →\n          (∀ s ∈ trace, s.left ∈ GRWTSK.PartialSumOrdering.BadRightEndpoints σ) →\n            ∀ (b : Fin n),\n              (GRWTSK.PartialSumOrdering.usedRepairPositions trace ∩ GRWTSK.PartialSumOrdering.repairWindow b D).card ≤\n                D","unsafe":false}
