ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.PartialSumCertificate","name":"GRWTSK.PartialSumOrdering.diagnoseCertificate.eq_1","partial":false,"type":"∀ {p : ℕ} (cert : GRWTSK.PartialSumOrdering.OrderingCertificate p),\n  GRWTSK.PartialSumOrdering.diagnoseCertificate cert =\n    if ¬Nat.Prime p then some GRWTSK.PartialSumOrdering.CertificateRejection.nonprimeModulus\n    else\n      if GRWTSK.PartialSumOrdering.replayList cert.originalOrder cert.swaps ≠ cert.finalOrder then\n        some GRWTSK.PartialSumOrdering.CertificateRejection.replayMismatch\n      else\n        if ¬cert.finalOrder.Perm cert.originalOrder then\n          some GRWTSK.PartialSumOrdering.CertificateRejection.multisetMismatch\n        else\n          if ¬GRWTSK.PartialSumOrdering.TraceBounded cert.repairRadius cert.swaps then\n            some GRWTSK.PartialSumOrdering.CertificateRejection.invalidSwap\n          else\n            if ¬GRWTSK.PartialSumOrdering.SupportsDisjoint cert.swaps then\n              some GRWTSK.PartialSumOrdering.CertificateRejection.overlappingSupports\n            else\n              if ¬GRWTSK.PartialSumOrdering.DistinctNonzeroLabels cert.originalOrder then\n                some GRWTSK.PartialSumOrdering.CertificateRejection.labelsNotDistinctNonzero\n              else\n                if ¬GRWTSK.PartialSumOrdering.ValidPartialSumOrder cert.finalOrder then\n                  some GRWTSK.PartialSumOrdering.CertificateRejection.repeatedPostSum\n                else none","unsafe":false}
