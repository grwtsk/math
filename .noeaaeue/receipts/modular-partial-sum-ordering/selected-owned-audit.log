ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.PartialSumCertificate","name":"GRWTSK.PartialSumOrdering.certificateChecks.eq_1","partial":false,"type":"∀ {p : ℕ} (cert : GRWTSK.PartialSumOrdering.OrderingCertificate p),\n  GRWTSK.PartialSumOrdering.certificateChecks cert =\n    (Nat.Prime p ∧\n      GRWTSK.PartialSumOrdering.replayList cert.originalOrder cert.swaps = cert.finalOrder ∧\n        cert.finalOrder.Perm cert.originalOrder ∧\n          GRWTSK.PartialSumOrdering.TraceBounded cert.repairRadius cert.swaps ∧\n            GRWTSK.PartialSumOrdering.SupportsDisjoint cert.swaps ∧\n              GRWTSK.PartialSumOrdering.DistinctNonzeroLabels cert.originalOrder ∧\n                GRWTSK.PartialSumOrdering.ValidPartialSumOrder cert.finalOrder)","unsafe":false}
