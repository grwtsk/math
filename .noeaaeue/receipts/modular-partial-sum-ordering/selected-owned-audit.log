ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"definition","module":"GRWTSK.Combinatorics.Sequences.ZeroSumIntervalRepair","name":"GRWTSK.PartialSumOrdering.GoodRepairGeometry.recOn","partial":false,"type":"{G : Type u_1} →\n  [inst : AddCommGroup G] →\n    {n : ℕ} →\n      {σ : Fin n → G} →\n        {D : ℕ} →\n          {motive : GRWTSK.PartialSumOrdering.GoodRepairGeometry σ D → Sort u} →\n            (t : GRWTSK.PartialSumOrdering.GoodRepairGeometry σ D) →\n              ((positive : 0 < D) →\n                  (tailSafety : ∀ b ∈ GRWTSK.PartialSumOrdering.BadRightEndpoints σ, ↑b + 1 + 30 * D < n) →\n                    (localDensity : ∀ (z : Fin n), (GRWTSK.PartialSumOrdering.badNeighborhood σ z D).card ≤ D) →\n                      (repairCompatibility :\n                          ∀ b ∈ GRWTSK.PartialSumOrdering.BadRightEndpoints σ,\n                            ∀ (π : Equiv.Perm (Fin n)),\n                              GRWTSK.PartialSumOrdering.AdmissiblePermutation D π →\n                                (∀ i < b, π i = i) →\n                                  (GRWTSK.PartialSumOrdering.blockedCandidates σ b π D).card < 2 * D) →\n                        motive ⋯) →\n                motive t","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.ZeroSumIntervalRepair","name":"GRWTSK.PartialSumOrdering.mem_badRightEndpoints._simp_1","partial":false,"type":"∀ {G : Type u_1} [inst : AddCommGroup G] {n : ℕ} (σ : Fin n → G) (b : Fin n),\n  (b ∈ GRWTSK.PartialSumOrdering.BadRightEndpoints σ) =\n    ∃ a, 1 ≤ ↑a ∧ a < b ∧ GRWTSK.PartialSumOrdering.positionIntervalSum σ a b = 0","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.ZeroSumIntervalRepair","name":"GRWTSK.PartialSumOrdering.originalBad_window_card","partial":false,"type":"∀ {G : Type u_1} [inst : AddCommGroup G] {n : ℕ} (σ : Fin n → G) (D : ℕ),\n  GRWTSK.PartialSumOrdering.GoodRepairGeometry σ D →\n    ∀ (b : Fin n), (GRWTSK.PartialSumOrdering.BadRightEndpoints σ ∩ GRWTSK.PartialSumOrdering.repairWindow b D).card ≤ D","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.ZeroSumIntervalRepair","name":"GRWTSK.PartialSumOrdering.bounded_repair_trace_aux","partial":false,"type":"∀ {G : Type u_1} [inst : AddCommGroup G] {n : ℕ} (σ : Fin n → G) (D : ℕ),\n  GRWTSK.PartialSumOrdering.GoodRepairGeometry σ D →\n    ∀ (R : Finset (Fin n)) (trace : GRWTSK.PartialSumOrdering.SwapTrace n),\n      GRWTSK.PartialSumOrdering.SupportsDisjoint trace →\n        GRWTSK.PartialSumOrdering.TraceBounded D trace →\n          (∀ s ∈ trace,\n              s.left ∈ GRWTSK.PartialSumOrdering.BadRightEndpoints σ ∧\n                s.right ∉ GRWTSK.PartialSumOrdering.BadRightEndpoints σ) →\n            (∀ r ∈ R, ∀ s ∈ trace, r < s.left) →\n              GRWTSK.PartialSumOrdering.BadRightEndpoints (σ ∘ ⇑(GRWTSK.PartialSumOrdering.replayPermutation trace)) ⊆\n                  R →\n                R ⊆ GRWTSK.PartialSumOrdering.BadRightEndpoints σ →\n                  ∃ finalTrace,\n                    GRWTSK.PartialSumOrdering.SupportsDisjoint finalTrace ∧\n                      GRWTSK.PartialSumOrdering.TraceBounded D finalTrace ∧\n                        GRWTSK.PartialSumOrdering.BadRightEndpoints\n                            (σ ∘ ⇑(GRWTSK.PartialSumOrdering.replayPermutation finalTrace)) =\n                          ∅","unsafe":false}
