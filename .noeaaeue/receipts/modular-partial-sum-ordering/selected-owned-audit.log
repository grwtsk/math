ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"definition","module":"GRWTSK.DynamicalSystems.TransitionSystems.ModularCheckpoint","name":"GRWTSK.ModularCheckpoint.PacketAdmission.mk._flat_ctor","partial":false,"type":"∀ {Source : Type u} {Obligation : Type v} {Effect : Type w} {Grant : Type x} {Surface : Type y}\n  [inst : DecidableEq Obligation] {I : Type u_1} {World : Type u_2} {p : ℕ}\n  {policy : GRWTSK.ProofHorizon.CorkscrewChamberCap.ControllerPolicy Source Obligation Effect Grant Surface}\n  {state final : GRWTSK.ProofHorizon.CorkscrewChamberCap.ControllerState Source Obligation Effect Grant Surface}\n  {epoch : ℕ} {binding : GRWTSK.ModularCheckpoint.PacketBinding Source I} {dependency : I → I → Prop}\n  {effect : I → World → World}\n  {proposal : I → GRWTSK.ProofHorizon.CorkscrewChamberCap.ControllerProposal Source Obligation Effect Grant Surface}\n  {label : I → ZMod p},\n  GRWTSK.ModularCheckpoint.BindingCurrent binding state.source epoch →\n    GRWTSK.ModularCheckpoint.ExchangeablePacket dependency effect binding.originalOrder binding.finalOrder →\n      GRWTSK.PartialSumOrdering.DistinctNonzeroLabels (List.map label binding.finalOrder) →\n        GRWTSK.PartialSumOrdering.ValidPartialSumOrder (List.map label binding.finalOrder) →\n          (List.map (fun i => (proposal i).cost) binding.finalOrder).sum ≤ state.remaining →\n            GRWTSK.ModularCheckpoint.Executes policy state (List.map proposal binding.finalOrder) final →\n              GRWTSK.ModularCheckpoint.PacketAdmission policy state final epoch binding dependency effect proposal label","unsafe":false}
