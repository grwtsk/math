ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSubsetSum","name":"GRWTSK.ZModSubsetSum.exposedPrefix_mono._simp_1_1","partial":false,"type":"∀ {α : Type u_1} {p : α → Prop} [inst : DecidablePred p] {s : Finset α} {a : α}, (a ∈ Finset.filter p s) = (a ∈ s ∧ p a)","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSubsetSum","name":"GRWTSK.ZModSubsetSum.exists_of_probability_pos","partial":false,"type":"∀ {Ω : Type u_1} [inst : DecidableEq Ω] (space event : Finset Ω),\n  0 < GRWTSK.ZModSubsetSum.probability space event → ∃ x ∈ space, x ∈ event","unsafe":false}
ORDERING_DECL::{"axioms":["propext"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSubsetSum","name":"GRWTSK.ZModSubsetSum.subsetSumFiber_mem._simp_1_3","partial":false,"type":"∀ {a b c : Prop}, ((a ∧ b) ∧ c) = (a ∧ b ∧ c)","unsafe":false}
