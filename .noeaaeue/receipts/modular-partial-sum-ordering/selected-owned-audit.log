ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSubsetSum","name":"GRWTSK.ZModSubsetSum.probability.congr_simp","partial":false,"type":"∀ {Ω : Type u_1} {inst : DecidableEq Ω} [inst_1 : DecidableEq Ω] (space space_1 : Finset Ω),\n  space = space_1 →\n    ∀ (event event_1 : Finset Ω),\n      event = event_1 → GRWTSK.ZModSubsetSum.probability space event = GRWTSK.ZModSubsetSum.probability space_1 event_1","unsafe":false}
