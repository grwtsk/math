ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.PrimeCyclicRearrangement","name":"GRWTSK.PrimeCyclicRearrangement.mem_goodPermutationEvent_iff","partial":false,"type":"∀ {G : Type u_1} [inst : AddCommGroup G] {n : ℕ} (σ : Fin n → G) (D : ℕ),\n  0 < D →\n    ∀ (ρ : Equiv.Perm (Fin n)),\n      ρ ∈ GRWTSK.PrimeCyclicRearrangement.goodPermutationEvent σ D ↔\n        GRWTSK.PartialSumOrdering.GoodRepairGeometry (σ ∘ ⇑ρ) D","unsafe":false}
