ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.PartialSumCertificate","name":"GRWTSK.PartialSumOrdering.checkCertificate_sound","partial":false,"type":"∀ {p : ℕ} (cert : GRWTSK.PartialSumOrdering.OrderingCertificate p),\n  GRWTSK.PartialSumOrdering.checkCertificate cert = true →\n    GRWTSK.PartialSumOrdering.ValidPartialSumOrder cert.finalOrder ∧\n      cert.finalOrder.Perm cert.originalOrder ∧\n        GRWTSK.PartialSumOrdering.replayList cert.originalOrder cert.swaps = cert.finalOrder ∧\n          GRWTSK.PartialSumOrdering.TraceBounded cert.repairRadius cert.swaps ∧\n            GRWTSK.PartialSumOrdering.SupportsDisjoint cert.swaps ∧\n              ∀ (i : Fin cert.originalOrder.length),\n                (↑((GRWTSK.PartialSumOrdering.replayPermutation cert.swaps) i)).dist ↑i ≤ 5 * cert.repairRadius","unsafe":false}
