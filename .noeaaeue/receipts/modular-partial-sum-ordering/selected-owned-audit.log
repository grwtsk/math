ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSubsetSum","name":"GRWTSK.ZModSubsetSum.three_failure_good_mass","partial":false,"type":"∀ {Ω : Type u_1} [inst : DecidableEq Ω] (space B₁ B₂ B₃ : Finset Ω),\n  space.Nonempty →\n    GRWTSK.ZModSubsetSum.probability space B₁ ≤ 1 / 100 →\n      GRWTSK.ZModSubsetSum.probability space B₂ ≤ 3 / 100 →\n        GRWTSK.ZModSubsetSum.probability space B₃ ≤ 1 / 25 →\n          23 / 25 ≤ GRWTSK.ZModSubsetSum.probability space (space \\ (B₁ ∪ B₂ ∪ B₃))","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSubsetSum","name":"GRWTSK.ZModSubsetSum.exposedPrefix.eq_1","partial":false,"type":"∀ {n : ℕ} (σ : Equiv.Perm (Fin n)) (k : ℕ), GRWTSK.ZModSubsetSum.exposedPrefix σ k = Finset.image ⇑σ {i | ↑i < k}","unsafe":false}
