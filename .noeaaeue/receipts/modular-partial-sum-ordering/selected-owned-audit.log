ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSubsetSumCompletion","name":"GRWTSK.ZModSubsetSum.subsetSumFiber_card_mul_remaining_le","partial":false,"type":"∀ {p : ℕ} [inst : NeZero p] (S : Finset (ZMod p)) (m : ℕ) (z : ZMod p),\n  1 ≤ m →\n    m ≤ S.card → (GRWTSK.ZModSubsetSum.subsetSumFiber S m z).card * (S.card - m + 1) ≤ (Finset.powersetCard m S).card","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSubsetSumCompletion","name":"GRWTSK.ZModSubsetSum.subsetSumFiber_complement_image","partial":false,"type":"∀ {p : ℕ} [inst : NeZero p] (S : Finset (ZMod p)) (m : ℕ) (z : ZMod p),\n  m ≤ S.card →\n    Finset.image (fun R => S \\ R) (GRWTSK.ZModSubsetSum.subsetSumFiber S m z) =\n      GRWTSK.ZModSubsetSum.subsetSumFiber S (S.card - m) (∑ x ∈ S, x - z)","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSubsetSumCompletion","name":"GRWTSK.ZModSubsetSum.subsetSumFiber_complement_mem","partial":false,"type":"∀ {p : ℕ} [inst : NeZero p] (S R : Finset (ZMod p)) (m : ℕ) (z : ZMod p),\n  R ∈ GRWTSK.ZModSubsetSum.subsetSumFiber S m z →\n    S \\ R ∈ GRWTSK.ZModSubsetSum.subsetSumFiber S (S.card - m) (∑ x ∈ S, x - z)","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSubsetSumCompletion","name":"GRWTSK.ZModSubsetSum.subsetSumFiber_complement_card","partial":false,"type":"∀ {p : ℕ} [inst : NeZero p] (S : Finset (ZMod p)) (m : ℕ) (z : ZMod p),\n  m ≤ S.card →\n    (GRWTSK.ZModSubsetSum.subsetSumFiber S m z).card =\n      (GRWTSK.ZModSubsetSum.subsetSumFiber S (S.card - m) (∑ x ∈ S, x - z)).card","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSubsetSumCompletion","name":"GRWTSK.ZModSubsetSum.subsetSumProbability_le_one_div_remaining","partial":false,"type":"∀ {p : ℕ} [inst : NeZero p] (S : Finset (ZMod p)) (m : ℕ) (z : ZMod p),\n  1 ≤ m → m ≤ S.card → GRWTSK.ZModSubsetSum.subsetSumProbability S m z ≤ 1 / ↑(S.card - m + 1)","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSubsetSumCompletion","name":"GRWTSK.ZModSubsetSum.subsetSumProbability_complement","partial":false,"type":"∀ {p : ℕ} [inst : NeZero p] (S : Finset (ZMod p)) (m : ℕ) (z : ZMod p),\n  m ≤ S.card →\n    GRWTSK.ZModSubsetSum.subsetSumProbability S m z =\n      GRWTSK.ZModSubsetSum.subsetSumProbability S (S.card - m) (∑ x ∈ S, x - z)","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSubsetSumCompletion","name":"GRWTSK.ZModSubsetSum.constrained_deletion_count","partial":false,"type":"∀ {A : Type u_1} [inst : AddCommGroup A] [inst_1 : DecidableEq A] (S : Finset A) (m : ℕ) (z : A),\n  {R ∈ Finset.powersetCard m S | ∑ x ∈ R, x = z}.card * m ≤ (Finset.powersetCard (m - 1) S).card","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSubsetSumCompletion","name":"GRWTSK.ZModSubsetSum.deletion_exposure_injective","partial":false,"type":"∀ {A : Type u_1} [inst : AddCommGroup A] [inst_1 : DecidableEq A] (z : A) (R T : Finset A),\n  ∀ x ∈ R, ∀ y ∈ T, ∑ r ∈ R, r = z → ∑ t ∈ T, t = z → R.erase x = T.erase y → R = T ∧ x = y","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSubsetSumCompletion","name":"GRWTSK.ZModSubsetSum.subsetSumFiber_card_mul_remaining_le._proof_1_1","partial":false,"type":"∀ {p : ℕ} [NeZero p] (S : Finset (ZMod p)) (m : ℕ) (z : ZMod p), 1 ≤ m → ¬m - 1 + 1 = m → False","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSubsetSumCompletion","name":"GRWTSK.ZModSubsetSum.subsetSumFiber_card_mul_remaining_le._proof_1_2","partial":false,"type":"∀ {p : ℕ} [NeZero p] (S : Finset (ZMod p)) (m : ℕ) (z : ZMod p),\n  m ≤ S.card → m - 1 + 1 = m → ¬S.card - (m - 1) = S.card - m + 1 → False","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Analysis.Fourier.ZModSubsetSumCompletion","name":"GRWTSK.ZModSubsetSum.complement_sum","partial":false,"type":"∀ {A : Type u_1} [inst : AddCommGroup A] [inst_1 : DecidableEq A] (S R : Finset A),\n  R ⊆ S → ∑ x ∈ S \\ R, x = ∑ x ∈ S, x - ∑ x ∈ R, x","unsafe":false}
