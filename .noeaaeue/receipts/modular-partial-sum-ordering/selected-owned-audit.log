ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.ZeroSumIntervalRepair","name":"GRWTSK.PartialSumOrdering.repairWindow_available","partial":false,"type":"∀ {n : ℕ} (b : Fin n) (D : ℕ),\n  0 < D →\n    ↑b + 5 * D < n →\n      ∀ (blocked original used : Finset (Fin n)),\n        (blocked ∩ GRWTSK.PartialSumOrdering.repairWindow b D).card < 2 * D →\n          (original ∩ GRWTSK.PartialSumOrdering.repairWindow b D).card ≤ D →\n            (used ∩ GRWTSK.PartialSumOrdering.repairWindow b D).card ≤ D →\n              ∃ y ∈ GRWTSK.PartialSumOrdering.repairWindow b D, y ∉ blocked ∧ y ∉ original ∧ y ∉ used","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.ZeroSumIntervalRepair","name":"GRWTSK.PartialSumOrdering.trace_fixes_before","partial":false,"type":"∀ {n : ℕ} (trace : GRWTSK.PartialSumOrdering.SwapTrace n) (D : ℕ),\n  GRWTSK.PartialSumOrdering.TraceBounded D trace →\n    ∀ (b : Fin n), (∀ s ∈ trace, b < s.left) → ∀ i ≤ b, (GRWTSK.PartialSumOrdering.replayPermutation trace) i = i","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.ZeroSumIntervalRepair","name":"GRWTSK.PartialSumOrdering.unblocked_swap_bad_subset._proof_1_3","partial":false,"type":"∀ {n : ℕ} (b y : Fin n) ⦃t : Fin n⦄ (a : Fin n), ¬(b < a ∧ a ≤ y ∨ b ≤ t ∧ t < y) → a ≤ b ∧ b ≤ t → ¬y ≤ t → False","unsafe":false}
