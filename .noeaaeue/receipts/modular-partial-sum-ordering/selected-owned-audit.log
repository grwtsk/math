ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.PrimeCyclicRearrangement","name":"GRWTSK.PrimeCyclicRearrangement.tailFailure.eq_1","partial":false,"type":"∀ {G : Type u_1} [inst : AddCommGroup G] {n : ℕ} (σ : Fin n → G) (D : ℕ),\n  GRWTSK.PrimeCyclicRearrangement.tailFailure σ D =\n    {π ∈ GRWTSK.ZModSubsetSum.permutationSpace n |\n      ¬∀ b ∈ GRWTSK.PartialSumOrdering.BadRightEndpoints (σ ∘ ⇑π), ↑b + 1 + 30 * D < n}","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"definition","module":"GRWTSK.Combinatorics.Sequences.PrimeCyclicRearrangement","name":"GRWTSK.PrimeCyclicRearrangement.goodPermutationEvent","partial":false,"type":"{G : Type u_1} → [AddCommGroup G] → {n : ℕ} → (Fin n → G) → ℕ → Finset (Equiv.Perm (Fin n))","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.Combinatorics.Sequences.PrimeCyclicRearrangement","name":"GRWTSK.PrimeCyclicRearrangement.compatibilityFailure.eq_1","partial":false,"type":"∀ {G : Type u_1} [inst : AddCommGroup G] {n : ℕ} (σ : Fin n → G) (D : ℕ),\n  GRWTSK.PrimeCyclicRearrangement.compatibilityFailure σ D =\n    {ρ ∈ GRWTSK.ZModSubsetSum.permutationSpace n |\n      ¬∀ b ∈ GRWTSK.PartialSumOrdering.BadRightEndpoints (σ ∘ ⇑ρ),\n          ∀ (π : Equiv.Perm (Fin n)),\n            GRWTSK.PartialSumOrdering.AdmissiblePermutation D π →\n              (∀ i < b, π i = i) → (GRWTSK.PartialSumOrdering.blockedCandidates (σ ∘ ⇑ρ) b π D).card < 2 * D}","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"definition","module":"GRWTSK.Combinatorics.Sequences.PrimeCyclicRearrangement","name":"GRWTSK.PrimeCyclicRearrangement.PhamSauermannSourceRange","partial":false,"type":"Prop","unsafe":false}
