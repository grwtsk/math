ORDERING_DECL::{"axioms":["propext"],"kind":"theorem","module":"GRWTSK.DynamicalSystems.TransitionSystems.ModularCheckpoint","name":"GRWTSK.ModularCheckpoint.SearchAttempt.mk.injEq","partial":false,"type":"∀ {I : Type u} {Revision : Type v} (sourceRevision : Revision) (epoch : ℕ) (seed : Option ℕ) (candidate : List I)\n  (generationCost repairCost : ℕ) (accepted : Bool) (sourceRevision_1 : Revision) (epoch_1 : ℕ) (seed_1 : Option ℕ)\n  (candidate_1 : List I) (generationCost_1 repairCost_1 : ℕ) (accepted_1 : Bool),\n  ({ sourceRevision := sourceRevision, epoch := epoch, seed := seed, candidate := candidate,\n        generationCost := generationCost, repairCost := repairCost, accepted := accepted } =\n      { sourceRevision := sourceRevision_1, epoch := epoch_1, seed := seed_1, candidate := candidate_1,\n        generationCost := generationCost_1, repairCost := repairCost_1, accepted := accepted_1 }) =\n    (sourceRevision = sourceRevision_1 ∧\n      epoch = epoch_1 ∧\n        seed = seed_1 ∧\n          candidate = candidate_1 ∧\n            generationCost = generationCost_1 ∧ repairCost = repairCost_1 ∧ accepted = accepted_1)","unsafe":false}
ORDERING_DECL::{"axioms":["propext","Classical.choice","Quot.sound"],"kind":"theorem","module":"GRWTSK.DynamicalSystems.TransitionSystems.ModularCheckpoint","name":"GRWTSK.ModularCheckpoint.packet_epoch_no_starvation","partial":false,"type":"∀ {I : Type u} (cost : I → ℕ),\n  (∀ (i : I), 0 < cost i) →\n    ∀ (order : List I) {size r : ℕ},\n      r < size →\n        ∀ (lower : ℕ),\n          ∃ j,\n            lower ≤ j ∧\n              j % size = r ∧\n                ∃! n,\n                  GRWTSK.RiemannHypothesis.BranchSequenceRealization.batchClock\n                        (GRWTSK.ModularCheckpoint.packetIncrement cost order) n ≤\n                      j ∧\n                    j <\n                      GRWTSK.RiemannHypothesis.BranchSequenceRealization.batchClock\n                        (GRWTSK.ModularCheckpoint.packetIncrement cost order) (n + 1)","unsafe":false}
ORDERING_DECL::{"axioms":[],"kind":"theorem","module":"GRWTSK.DynamicalSystems.TransitionSystems.ModularCheckpoint","name":"GRWTSK.ModularCheckpoint.PacketBinding.mk.inj","partial":false,"type":"∀ {Source : Type u} {I : Type v} {source : Source} {epoch : ℕ} {originalOrder finalOrder : List I} {source_1 : Source}\n  {epoch_1 : ℕ} {originalOrder_1 finalOrder_1 : List I},\n  { source := source, epoch := epoch, originalOrder := originalOrder, finalOrder := finalOrder } =\n      { source := source_1, epoch := epoch_1, originalOrder := originalOrder_1, finalOrder := finalOrder_1 } →\n    source = source_1 ∧ epoch = epoch_1 ∧ originalOrder = originalOrder_1 ∧ finalOrder = finalOrder_1","unsafe":false}
