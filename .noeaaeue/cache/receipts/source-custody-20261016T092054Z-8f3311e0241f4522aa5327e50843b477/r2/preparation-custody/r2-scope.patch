+def bounded_directory_names(fd, limit):
+    """Collect at most limit names; never allocate an unbounded listdir result.
+
+    The next excess DirEntry is observed but not appended. The caller reserves
+    all returned names in its global entry count before descending recursively,
+    so suspended ancestor collections consume that same finite budget.
+    """
+    require(type(limit) is int and 0 <= limit <= MAX_ENTRIES, "invalid directory entry budget")
+    names = []
+    with os.scandir(fd) as entries:
+        for entry in entries:
+            require(len(names) < limit, "expansion exceeds entry bound")
+            names.append(entry.name)
+    return sorted(names)
+
