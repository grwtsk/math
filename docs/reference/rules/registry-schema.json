{
  "schema": "grwtsk-rule-registry-schema-v2",
  "schema_version": 2,
  "unknown_field_policy": "reject",
  "required_rule_fields": [
    "rule_id",
    "rule_version",
    "layer",
    "input_types",
    "applicability",
    "premises",
    "side_conditions",
    "conclusion",
    "semantic_definition",
    "checker_artifacts",
    "execution_mode",
    "soundness_evidence",
    "dependencies",
    "positive_controls",
    "negative_controls",
    "failure_interpretation",
    "compatibility",
    "documentation_binding",
    "enforcement_status"
  ],
  "allowed_layers": ["L0", "L1", "L2", "L3", "L4", "L5", "L6"],
  "allowed_enforcement_statuses": [
    "formally-modeled-adapter-gap",
    "operationally-enforced-not-formally-verified",
    "specified-unimplemented",
    "blocked-current-snapshot"
  ],
  "outcomes": ["ACCEPT", "REJECT", "UNKNOWN"],
  "operational_states": ["NOT_RUN", "BUSY", "TIMEOUT", "ERROR", "INTERRUPTED", "COMPLETED"]
}
