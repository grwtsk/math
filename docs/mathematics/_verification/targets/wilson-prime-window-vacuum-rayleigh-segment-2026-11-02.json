    "ordered_endpoints": "For residue vacua with lambda=S.value(r)<mu=S.value(s), every E in [lambda,mu] is realized.",
    "state": "Psi_E=sqrt((mu-E)/(mu-lambda))*Omega_r+sqrt((E-lambda)/(mu-lambda))*Omega_s.",
