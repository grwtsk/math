    "rayleigh_energy": "<Psi_E,H_graded Psi_E>=E.",
    "residual_variance": "||(H_graded-E)Psi_E||^2=(E-lambda)(mu-E).",
    "quarter_bound": "The residual variance is at most (mu-lambda)^2/4.",
    "endpoint_characterization": "The residual is zero exactly at E=lambda or E=mu.",
    "interior_boundary": "Strict interior values are Rayleigh values but not eigenvalues on this two-vacuum state."
