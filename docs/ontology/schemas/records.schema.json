{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GRWTSK mathematical ontology record profile, version 2",
  "oneOf": [
    {
      "$ref": "#/$defs/manifest"
    },
    {
      "$ref": "#/$defs/source"
    },
    {
      "$ref": "#/$defs/corpus"
    },
    {
      "$ref": "#/$defs/subject"
    },
    {
      "$ref": "#/$defs/context"
    },
    {
      "$ref": "#/$defs/entity"
    },
    {
      "$ref": "#/$defs/relation"
    },
    {
      "$ref": "#/$defs/inference"
    },
    {
      "$ref": "#/$defs/view"
    },
    {
      "$ref": "#/$defs/migration"
    },
    {
      "$ref": "#/$defs/file-mapping-shard"
    },
    {
      "$ref": "#/$defs/issue-mapping-shard"
    }
  ],
  "$defs": {
    "binding": {
      "type": "object",
      "required": [
        "source",
        "locator"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "blob": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        }
      }
    },
    "manifest": {
      "type": "object",
      "required": [
        "schema",
        "id",
        "title",
        "attribution",
        "baseline",
        "specification",
        "sections",
        "policies"
      ],
      "properties": {
        "schema": {
          "const": "math-ontology/manifest/2"
        },
        "id": {
          "type": "string",
          "pattern": "^release:[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "attribution": {
          "type": "string",
          "minLength": 1
        },
        "baseline": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "specification": {
          "type": "string",
          "minLength": 1
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "policies": {
          "type": "object"
        }
      }
    },
    "source": {
      "type": "object",
      "required": [
        "schema",
        "id",
        "title",
        "kind"
      ],
      "properties": {
        "schema": {
          "const": "math-ontology/source/2"
        },
        "id": {
          "type": "string",
          "pattern": "^source:[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "digest": {
          "type": [
            "object",
            "string"
          ]
        },
        "url": {
          "type": "string",
          "minLength": 1
        }
      },
      "anyOf": [
        {
          "required": [
            "revision"
          ]
        },
        {
          "required": [
            "digest"
          ]
        }
      ]
    },
    "corpus": {
      "type": "object",
      "required": [
        "schema",
        "id",
        "source"
      ],
      "properties": {
        "schema": {
          "const": "math-ontology/corpus/2"
        },
        "id": {
          "type": "string",
          "pattern": "^corpus:[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "inventory": {
          "type": "object"
        }
      }
    },
    "subject": {
      "type": "object",
      "required": [
        "schema",
        "id",
        "title",
        "kind",
        "frontier"
      ],
      "properties": {
        "schema": {
          "const": "math-ontology/subject/2"
        },
        "id": {
          "type": "string",
          "pattern": "^subject:[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "classification_subject",
            "learning_subject"
          ]
        },
        "classification": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "pattern": "^[0-9]{2}-XX$"
        },
        "inventory": {
          "type": "object",
          "required": [
            "groups",
            "direct_details"
          ],
          "properties": {
            "groups": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 0,
                "uniqueItems": true
              }
            },
            "direct_details": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 0,
              "uniqueItems": true
            }
          }
        },
        "frontier": {
          "type": "object",
          "required": [
            "status",
            "seeds",
            "sources",
            "first_pass"
          ],
          "properties": {
            "status": {
              "type": "string",
              "minLength": 1
            },
            "seeds": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            },
            "sources": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "url",
                  "locator",
                  "role"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "minLength": 1
                  },
                  "locator": {
                    "type": "string",
                    "minLength": 1
                  },
                  "role": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "minItems": 1
            },
            "first_pass": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "classification_subject"
              }
            }
          },
          "then": {
            "required": [
              "classification",
              "code",
              "inventory"
            ]
          }
        }
      ]
    },
    "context": {
      "type": "object",
      "required": [
        "schema",
        "id",
        "title",
        "foundation",
        "assumptions",
        "sources"
      ],
      "properties": {
        "schema": {
          "const": "math-ontology/context/2"
        },
        "id": {
          "type": "string",
          "pattern": "^context:[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "foundation": {
          "type": "string",
          "minLength": 1
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          },
          "minItems": 1
        }
      }
    },
    "entity": {
      "type": "object",
      "required": [
        "schema",
        "id",
        "title",
        "kind",
        "context",
        "subjects",
        "statement",
        "sources",
        "evidence"
      ],
      "properties": {
        "schema": {
          "const": "math-ontology/entity/2"
        },
        "id": {
          "type": "string",
          "pattern": "^(entity|concept|definition|object|operator|obligation|interface|claim|obstruction|objective|proof|theorem|conjecture|method|problem|example|counterexample|goal|structure|construction|map|formalization|algorithm|property):[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "subjects": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          },
          "minItems": 1
        },
        "evidence": {
          "type": "object",
          "required": [
            "mathematical",
            "source_correspondence",
            "elaboration",
            "fresh_kernel",
            "transitive_axioms",
            "independent_review"
          ],
          "properties": {
            "mathematical": {
              "type": "string",
              "minLength": 1
            },
            "source_correspondence": {
              "type": "string",
              "minLength": 1
            },
            "elaboration": {
              "type": "string",
              "minLength": 1
            },
            "fresh_kernel": {
              "type": "string",
              "minLength": 1
            },
            "transitive_axioms": {
              "type": "string",
              "minLength": 1
            },
            "independent_review": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "relation": {
      "type": "object",
      "required": [
        "schema",
        "id",
        "type",
        "from",
        "to",
        "context",
        "status",
        "justification",
        "sources",
        "costs"
      ],
      "properties": {
        "schema": {
          "const": "math-ontology/relation/2"
        },
        "id": {
          "type": "string",
          "pattern": "^relation:[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "documented",
            "established",
            "proposed",
            "analogical",
            "historical",
            "rejected"
          ]
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          },
          "minItems": 1
        },
        "costs": {
          "type": "object",
          "required": [
            "reading",
            "formalization",
            "translation",
            "verification"
          ],
          "properties": {
            "reading": {
              "type": "number",
              "minimum": 0
            },
            "formalization": {
              "type": "number",
              "minimum": 0
            },
            "translation": {
              "type": "number",
              "minimum": 0
            },
            "verification": {
              "type": "number",
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "inference": {
      "type": "object",
      "required": [
        "schema",
        "id",
        "kind",
        "title",
        "context",
        "premises_all",
        "conclusion",
        "status",
        "cost",
        "justification",
        "sources",
        "substitution",
        "side_conditions",
        "instantiation"
      ],
      "properties": {
        "schema": {
          "const": "math-ontology/inference/2"
        },
        "id": {
          "type": "string",
          "pattern": "^(rule|inference):[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "kind": {
          "const": "inference_rule"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "string",
          "minLength": 1
        },
        "premises_all": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "conclusion": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "conditional",
            "established",
            "proposed",
            "historical",
            "rejected"
          ]
        },
        "cost": {
          "type": "number",
          "minimum": 0
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          },
          "minItems": 1
        },
        "substitution": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "side_conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "instantiation": {
          "enum": [
            "ground",
            "schematic"
          ]
        },
        "binders": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "type": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 0
        }
      }
    },
    "view": {
      "type": "object",
      "required": [
        "schema",
        "id",
        "title",
        "scope",
        "entities",
        "relations",
        "inferences"
      ],
      "properties": {
        "schema": {
          "const": "math-ontology/view/2"
        },
        "id": {
          "type": "string",
          "pattern": "^view:[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "entities": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "relations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "inferences": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "migration": {
      "type": "object",
      "required": [
        "schema",
        "id"
      ],
      "properties": {
        "schema": {
          "const": "math-ontology/migration/2"
        },
        "id": {
          "type": "string",
          "pattern": "^migration:[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "legacy_id",
              "legacy_locator"
            ],
            "properties": {
              "legacy_id": {
                "type": "string",
                "minLength": 1
              },
              "target": {
                "type": "string",
                "minLength": 1
              },
              "legacy_locator": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "file-mapping-shard": {
      "type": "object",
      "required": [
        "schema",
        "id",
        "corpus",
        "revision",
        "record_count",
        "groups"
      ],
      "properties": {
        "schema": {
          "const": "math-ontology/file-mapping-shard/2"
        },
        "id": {
          "type": "string",
          "pattern": "^mapping-shard:[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "corpus": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "directory",
              "role",
              "disposition",
              "files"
            ],
            "properties": {
              "directory": {
                "type": "string"
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "disposition": {
                "type": "string",
                "minLength": 1
              },
              "subject": {
                "type": "string",
                "minLength": 1
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "minItems": 1,
                "uniqueItems": true
              }
            }
          },
          "minItems": 1
        }
      }
    },
    "issue-mapping-shard": {
      "type": "object",
      "required": [
        "schema",
        "id",
        "corpus",
        "record_count",
        "issues"
      ],
      "properties": {
        "schema": {
          "const": "math-ontology/issue-mapping-shard/2"
        },
        "id": {
          "type": "string",
          "pattern": "^mapping-shard:[A-Za-z0-9][A-Za-z0-9_.-]*$"
        },
        "corpus": {
          "type": "string",
          "minLength": 1
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "number",
              "state",
              "updated_at",
              "content_sha256",
              "role",
              "disposition"
            ],
            "properties": {
              "number": {
                "type": "integer",
                "minimum": 1
              },
              "state": {
                "type": "string",
                "minLength": 1
              },
              "updated_at": {
                "type": "string",
                "minLength": 1
              },
              "content_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "role": {
                "type": "string",
                "minLength": 1
              },
              "disposition": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "minItems": 1
        }
      }
    }
  }
}
