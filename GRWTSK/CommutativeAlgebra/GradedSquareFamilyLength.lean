import GRWTSK.CommutativeAlgebra.LocalizedGradedLength

/-!
# Local lengths after squaring homogeneous equations

The exact graded quotient sequence controls the cost of replacing each
homogeneous equation by its square. The generators may have different
degrees, but the initial length bound must hold at every weight. Lengths
remain in `ℕ∞`, with their infinite cases retained. The five-family return
below matches the actual equations in the submitted deformation argument;
its original local length-at-most-one supplier remains explicit.
-/

open scoped BigOperators

namespace GRWTSK.CommutativeAlgebra.GradedSquareFamilyLength

open GradedQuotientExact LocalizedGradedLength

variable {O A : Type*} [CommRing O] [CommRing A] [Algebra O A]
variable (𝒜 : ℤ → Submodule O A) [GradedAlgebra 𝒜]

/-- The actual ideal generated by a finite indexed family. Repeated values
are allowed and do not change the generated ideal. -/
def familyIdeal {I : Type*} (s : Finset I) (t : I → A) : Ideal A :=
  Ideal.span (t '' (s : Set I))

@[simp] theorem familyIdeal_empty {I : Type*} (t : I → A) :
    familyIdeal (∅ : Finset I) t = ⊥ := by
  simp [familyIdeal]

theorem familyIdeal_insert {I : Type*} [DecidableEq I]
    (i : I) (s : Finset I) (t : I → A) :
    familyIdeal (insert i s) t = Ideal.span {t i} ⊔ familyIdeal s t := by
  simp only [familyIdeal, Finset.coe_insert, Set.image_insert_eq, Ideal.span_insert]

/-- Different generator degrees still give a homogeneous generated ideal. -/
theorem familyIdeal_isHomogeneous {I : Type*} (s : Finset I)
    (t : I → A) (d : I → ℤ) (ht : ∀ i ∈ s, t i ∈ 𝒜 (d i)) :
    (familyIdeal s t).IsHomogeneous 𝒜 := by
  apply Ideal.homogeneous_span
  rintro _ ⟨i, hi, rfl⟩
  exact ⟨d i, ht i hi⟩

/-- Squaring a finite family costs at most two per indexed equation. The
uniformity over all weights supplies every shifted term in the induction. -/
theorem localLength_square_family_le {I : Type*}
    (P : Ideal (𝒜 0)) [P.IsPrime] (s : Finset I)
    (t : I → A) (d : I → ℤ) (ht : ∀ i ∈ s, t i ∈ 𝒜 (d i))
    (J : Ideal A) (hJ : J.IsHomogeneous 𝒜) (c : ℕ∞)
    (hbound : ∀ w : ℤ,
      localLength P (quotientPiece 𝒜 (J ⊔ familyIdeal s t) w) ≤ c) :
    ∀ w : ℤ,
      localLength P (quotientPiece 𝒜 (J ⊔ familyIdeal s (fun i => t i ^ 2)) w) ≤
        2 ^ s.card * c := by
  classical
  induction s using Finset.induction_on generalizing J c with
  | empty =>
    rw [familyIdeal_empty] at hbound ⊢
    simpa only [Finset.card_empty, pow_zero, one_mul] using hbound
  | @insert i s hi ih =>
    have hti : t i ∈ 𝒜 (d i) := ht i (Finset.mem_insert_self i s)
    have hts : ∀ j ∈ s, t j ∈ 𝒜 (d j) :=
      fun j hj => ht j (Finset.mem_insert_of_mem hj)
    have htail : (familyIdeal s t).IsHomogeneous 𝒜 :=
      familyIdeal_isHomogeneous 𝒜 s t d hts
    have hsquare : (Ideal.span ({t i ^ 2} : Set A)).IsHomogeneous 𝒜 := by
      apply Ideal.homogeneous_span
      intro a ha
      rw [Set.mem_singleton_iff.mp ha]
      exact ⟨d i + d i, by simpa [pow_two] using SetLike.GradedMul.mul_mem hti hti⟩
    have hstep (w : ℤ) :
        localLength P (quotientPiece 𝒜
          ((J ⊔ Ideal.span {t i ^ 2}) ⊔ familyIdeal s t) w) ≤ 2 * c := by
      have hswap : (J ⊔ Ideal.span {t i ^ 2}) ⊔ familyIdeal s t =
          (J ⊔ familyIdeal s t) ⊔ Ideal.span {t i ^ 2} := by ac_rfl
      rw [hswap]
      apply (localLength_quotientPiece_square_le 𝒜 P (J ⊔ familyIdeal s t)
        (hJ.sup htail) (d i) (t i) hti w).trans
      have hfull : (J ⊔ familyIdeal s t) ⊔ Ideal.span {t i} =
          J ⊔ familyIdeal (insert i s) t := by
        rw [familyIdeal_insert]
        ac_rfl
      rw [hfull, two_mul]
      exact add_le_add (hbound _) (hbound _)
    have hrest := ih hts (J ⊔ Ideal.span {t i ^ 2}) (hJ.sup hsquare) (2 * c) hstep
    intro w
    have hjoin : J ⊔ familyIdeal (insert i s) (fun j => t j ^ 2) =
        (J ⊔ Ideal.span {t i ^ 2}) ⊔ familyIdeal s (fun j => t j ^ 2) := by
      rw [familyIdeal_insert]
      ac_rfl
    rw [hjoin, Finset.card_insert_of_notMem hi, pow_succ (2 : ℕ∞), mul_assoc]
    exact hrest w

/-- Finite-type version of the same estimate, with the full indexed count. -/
theorem localLength_square_fintype_le {I : Type*} [Fintype I]
    (P : Ideal (𝒜 0)) [P.IsPrime] (t : I → A) (d : I → ℤ)
    (ht : ∀ i, t i ∈ 𝒜 (d i)) (J : Ideal A) (hJ : J.IsHomogeneous 𝒜)
    (c : ℕ∞)
    (hbound : ∀ w : ℤ,
      localLength P (quotientPiece 𝒜 (J ⊔ Ideal.span (Set.range t)) w) ≤ c) :
    ∀ w : ℤ,
      localLength P (quotientPiece 𝒜
        (J ⊔ Ideal.span (Set.range fun i => t i ^ 2)) w) ≤ 2 ^ Fintype.card I * c := by
  have hgen (f : I → A) : familyIdeal Finset.univ f = Ideal.span (Set.range f) := by
    simp [familyIdeal]
  have h := localLength_square_family_le 𝒜 P Finset.univ t d
    (fun i _ => ht i) J hJ c (by rw [hgen]; exact hbound)
  rw [hgen] at h
  simpa only [Finset.card_univ] using h

/-- The exact field-point finite-family return includes the source's
common-degree case and also allows a distinct degree for each equation. -/
theorem pointLength_square_fintype_le {K I : Type*} [Field K] [Algebra O K]
    [Fintype I] (σ : 𝒜 0 →ₐ[O] K) (t : I → A) (d : I → ℤ)
    (ht : ∀ i, t i ∈ 𝒜 (d i)) (J : Ideal A) (hJ : J.IsHomogeneous 𝒜)
    (c : ℕ∞)
    (hbound : ∀ w : ℤ,
      pointLength σ (quotientPiece 𝒜 (J ⊔ Ideal.span (Set.range t)) w) ≤ c) :
    ∀ w : ℤ,
      pointLength σ (quotientPiece 𝒜
        (J ⊔ Ideal.span (Set.range fun i => t i ^ 2)) w) ≤ 2 ^ Fintype.card I * c := by
  have : (RingHom.ker σ).IsPrime := RingHom.ker_isPrime σ
  exact localLength_square_fintype_le 𝒜 (RingHom.ker σ) t d ht J hJ c hbound

/-- Two families are a single disjoint indexed family. Their degrees may be
different, and their cardinalities account for the complete squaring cost. -/
theorem localLength_square_two_families_le {I H : Type*} [Fintype I] [Fintype H]
    (P : Ideal (𝒜 0)) [P.IsPrime] (f : I → A) (g : H → A)
    (d : I → ℤ) (d' : H → ℤ)
    (hf : ∀ i, f i ∈ 𝒜 (d i)) (hg : ∀ j, g j ∈ 𝒜 (d' j))
    (J : Ideal A) (hJ : J.IsHomogeneous 𝒜) (c : ℕ∞)
    (hbound : ∀ w : ℤ, localLength P
      (quotientPiece 𝒜 (J ⊔ Ideal.span (Set.range f ∪ Set.range g)) w) ≤ c) :
    ∀ w : ℤ, localLength P
      (quotientPiece 𝒜 (J ⊔ Ideal.span
        (Set.range (fun i => f i ^ 2) ∪ Set.range (fun j => g j ^ 2))) w) ≤
          2 ^ (Fintype.card I + Fintype.card H) * c := by
  have hdeg : ∀ i : I ⊕ H, Sum.elim f g i ∈ 𝒜 (Sum.elim d d' i) := by
    intro i
    cases i with
    | inl i => exact hf i
    | inr j => exact hg j
  have hsq : (fun i : I ⊕ H => Sum.elim f g i ^ 2) =
      Sum.elim (fun i => f i ^ 2) (fun j => g j ^ 2) := by
    funext i
    cases i <;> rfl
  have h := localLength_square_fintype_le 𝒜 P (Sum.elim f g) (Sum.elim d d')
    hdeg J hJ c (by rw [Set.Sum.elim_range]; exact hbound)
  rw [hsq, Set.Sum.elim_range] at h
  simpa only [Fintype.card_sum] using h

/-- Expanded five-family equation return used by the graded deformation
argument. The genuine original weight-piece bound is retained as a premise;
the degree-zero base-point equation and later geometric hypotheses are not
needed for this finite squaring step. -/
theorem pointLength_five_family_squares_le
    {K : Type*} [Field K] [Algebra O K] (σ : 𝒜 0 →ₐ[O] K)
    (r s r' s' m : ℕ)
    (F : Fin (r + 1) → A) (G : Fin s → A) (E : Fin r' → A)
    (E' : Fin s' → A) (Z : Fin m → A)
    (hF : ∀ i, F i ∈ 𝒜 (-1)) (hG : ∀ i, G i ∈ 𝒜 (-2))
    (hE : ∀ i, E i ∈ 𝒜 1) (hE' : ∀ i, E' i ∈ 𝒜 2)
    (hZ : ∀ i, Z i ∈ 𝒜 0)
    (hbound : ∀ w : ℤ, pointLength σ
      (quotientPiece 𝒜 (Ideal.span
        (Set.range F ∪ Set.range G ∪ Set.range E ∪ Set.range E' ∪ Set.range Z)) w) ≤ 1) :
    ∀ w : ℤ, pointLength σ
      (quotientPiece 𝒜 (Ideal.span
        (Set.range (fun i => F i ^ 2) ∪ Set.range G ∪
          Set.range (fun i => E i ^ 2) ∪ Set.range E' ∪ Set.range Z)) w) ≤
            2 ^ (r + 1 + r') := by
  have : (RingHom.ker σ).IsPrime := RingHom.ker_isPrime σ
  let J : Ideal A := Ideal.span (Set.range G ∪ Set.range E' ∪ Set.range Z)
  have hJ : J.IsHomogeneous 𝒜 := by
    apply Ideal.homogeneous_span
    rintro a ((⟨i, rfl⟩ | ⟨i, rfl⟩) | ⟨i, rfl⟩)
    · exact ⟨-2, hG i⟩
    · exact ⟨2, hE' i⟩
    · exact ⟨0, hZ i⟩
  have hideal : J ⊔ Ideal.span (Set.range F ∪ Set.range E) =
      Ideal.span (Set.range F ∪ Set.range G ∪ Set.range E ∪ Set.range E' ∪ Set.range Z) := by
    simp only [J, Ideal.span_union]
    ac_rfl
  have hsquared : J ⊔ Ideal.span
      (Set.range (fun i => F i ^ 2) ∪ Set.range (fun i => E i ^ 2)) =
      Ideal.span (Set.range (fun i => F i ^ 2) ∪ Set.range G ∪
        Set.range (fun i => E i ^ 2) ∪ Set.range E' ∪ Set.range Z) := by
    simp only [J, Ideal.span_union]
    ac_rfl
  have h := localLength_square_two_families_le 𝒜 (RingHom.ker σ) F E
    (fun _ => -1) (fun _ => 1) hF hE J hJ 1 (by
      intro w
      rw [hideal]
      exact hbound w)
  rw [hsquared] at h
  simpa only [pointLength, Fintype.card_fin, mul_one] using h

end GRWTSK.CommutativeAlgebra.GradedSquareFamilyLength
