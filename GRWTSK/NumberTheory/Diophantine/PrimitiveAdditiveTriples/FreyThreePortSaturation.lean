Uses Mathlib's integer ideals, matrices, finite vectors, exact pairs and linear maps
(Apache-2.0). OpenAI Codex formalization assistance.

This module proves the finite split-exact and maximal-minor saturation
certificate for the formal Frey three-port frame. It does not construct an
elliptic curve, identify rational torsion points, prove conductor formulas, or
prove abc. -/
import GRWTSK.NumberTheory.Diophantine.PrimitiveAdditiveTriples.FreyThreePortFrame

set_option autoImplicit false

namespace GRWTSK.NumberTheory.Diophantine.PrimitiveAdditiveTriples

/-- The canonical `3 × 2` matrix of the formal value map in the ordered source
basis `(1,x)` and ordered target ports `(0,a,-b)`. -/
def freyThreePortMatrix (a b : ℤ) : Matrix (Fin 3) (Fin 2) ℤ :=
  ![![1, 0], ![1, a], ![1, -b]]

/-- Determinant of two selected rows of a `3 × 2` matrix. -/
def freyTwoByTwoRowMinor
    (M : Matrix (Fin 3) (Fin 2) ℤ) (i j : Fin 3) : ℤ :=
  M i 0 * M j 1 - M i 1 * M j 0

/-- The three maximal minors, ordered by row pairs `(0,1)`, `(0,2)`, `(1,2)`. -/
def freyThreePortMaximalMinors (a b : ℤ) : Fin 3 → ℤ :=
  ![freyTwoByTwoRowMinor (freyThreePortMatrix a b) 0 1,
    freyTwoByTwoRowMinor (freyThreePortMatrix a b) 0 2,
    freyTwoByTwoRowMinor (freyThreePortMatrix a b) 1 2]

@[simp] theorem freyThreePortMaximalMinors_eq (a b : ℤ) :
    freyThreePortMaximalMinors a b = ![a, -b, -(a + b)] := by
  ext i
  fin_cases i <;>
    simp [freyThreePortMaximalMinors, freyTwoByTwoRowMinor,
      freyThreePortMatrix] <;> ring

/-- The ideal generated by the maximal minors of the formal three-port matrix. -/
def freyThreePortMaximalMinorIdeal (a b : ℤ) : Ideal ℤ :=
  Ideal.span (Set.range (freyThreePortMaximalMinors a b))

/-- A Bézout identity for `a` and `b` forces the maximal-minor ideal to be the
unit ideal. This is the explicit finite saturation certificate. -/
theorem freyThreePortMaximalMinorIdeal_eq_top_of_bezout
    {a b r s : ℤ} (hbezout : r * a + s * b = 1) :
    freyThreePortMaximalMinorIdeal a b = ⊤ := by
  let I := freyThreePortMaximalMinorIdeal a b
  have ha : a ∈ I := by
    apply Ideal.subset_span
    refine ⟨(0 : Fin 3), ?_⟩
    rw [freyThreePortMaximalMinors_eq]
    rfl
  have hnb : -b ∈ I := by
    apply Ideal.subset_span
    refine ⟨(1 : Fin 3), ?_⟩
    rw [freyThreePortMaximalMinors_eq]
    rfl
  rw [Ideal.eq_top_iff_one]
  have hra : r * a ∈ I := I.mul_mem_left r ha
  have hsb : s * b ∈ I := by
    have h := I.mul_mem_left (-s) hnb
    convert h using 1 <;> ring
  rw [← hbezout]
  exact I.add_mem hra hsb

/-- The single compatibility obstruction for a three-port value vector. Its
kernel is exactly the image of evaluation when a Bézout identity is supplied. -/
def freyThreePortObstruction (a b : ℤ) (y : FreyThreePortValues) : ℤ :=
  b * (y 1 - y 0) - a * (y 0 - y 2)

@[simp] theorem freyThreePortObstruction_add (a b : ℤ)
    (x y : FreyThreePortValues) :
    freyThreePortObstruction a b (x + y) =
      freyThreePortObstruction a b x + freyThreePortObstruction a b y := by
  simp [freyThreePortObstruction]
  ring

@[simp] theorem freyThreePortObstruction_smul (a b q : ℤ)
    (y : FreyThreePortValues) :
    freyThreePortObstruction a b (q • y) =
      q * freyThreePortObstruction a b y := by
  simp [freyThreePortObstruction]
  ring

/-- The compatibility obstruction as an exact integral linear map. -/
def freyThreePortObstructionLinear (a b : ℤ) :
    FreyThreePortValues →ₗ[ℤ] ℤ where
  toFun := freyThreePortObstruction a b
  map_add' := freyThreePortObstruction_add a b
  map_smul' := by
    intro q y
    exact freyThreePortObstruction_smul a b q y

/-- Compatibility is exactly vanishing of the obstruction coordinate. -/
theorem freyThreePortCompatible_iff_obstruction_eq_zero
    (a b : ℤ) (y : FreyThreePortValues) :
    FreyThreePortCompatible a b y ↔ freyThreePortObstruction a b y = 0 := by
  unfold FreyThreePortCompatible freyThreePortObstruction
  constructor
  · exact sub_eq_zero.mpr
  · exact sub_eq_zero.mp

/-- Evaluation lands in the obstruction kernel. -/
@[simp] theorem freyThreePortObstruction_eval
    (a b : ℤ) (v : FreySectionCoordinates) :
    freyThreePortObstruction a b (freyThreePortEval a b v) = 0 := by
  simp [freyThreePortObstruction, freyThreePortEval]
  ring

/-- On compatible values, the Bézout recovery map is also a right inverse.
Thus the three-port image is not merely injective: it is exactly one integral
linear equation inside `ℤ³`. -/
theorem freyThreePortEval_recover_of_compatible
    {a b r s : ℤ} (hbezout : r * a + s * b = 1)
    {y : FreyThreePortValues} (hy : FreyThreePortCompatible a b y) :
    freyThreePortEval a b (freyThreePortRecover r s y) = y := by
  change b * (y 1 - y 0) = a * (y 0 - y 2) at hy
  ext i
  fin_cases i
  · rfl
  · change
      y 0 + a * (r * (y 1 - y 0) + s * (y 0 - y 2)) = y 1
    linear_combination (y 1 - y 0) * hbezout - s * hy
  · change
      y 0 - b * (r * (y 1 - y 0) + s * (y 0 - y 2)) = y 2
    linear_combination -(y 0 - y 2) * hbezout - r * hy

/-- A split vector for the obstruction coordinate. -/
def freyThreePortObstructionSplit (r s z : ℤ) : FreyThreePortValues :=
  ![0, s * z, r * z]

@[simp] theorem freyThreePortObstructionSplit_add (r s x y : ℤ) :
    freyThreePortObstructionSplit r s (x + y) =
      freyThreePortObstructionSplit r s x +
        freyThreePortObstructionSplit r s y := by
  ext i
  fin_cases i <;> simp [freyThreePortObstructionSplit] <;> ring

@[simp] theorem freyThreePortObstructionSplit_smul (r s q z : ℤ) :
    freyThreePortObstructionSplit r s (q * z) =
      q • freyThreePortObstructionSplit r s z := by
  ext i
  fin_cases i <;> simp [freyThreePortObstructionSplit] <;> ring

/-- The obstruction split as an exact integral linear map. -/
def freyThreePortObstructionSplitLinear (r s : ℤ) :
    ℤ →ₗ[ℤ] FreyThreePortValues where
  toFun := freyThreePortObstructionSplit r s
  map_add' := freyThreePortObstructionSplit_add r s
  map_smul' := by
    intro q z
    simpa only [smul_eq_mul] using freyThreePortObstructionSplit_smul r s q z

/-- The selected split is a right inverse for the obstruction map. -/
theorem freyThreePortObstruction_split_of_bezout
    {a b r s : ℤ} (hbezout : r * a + s * b = 1) (z : ℤ) :
    freyThreePortObstruction a b (freyThreePortObstructionSplit r s z) = z := by
  change b * (s * z - 0) - a * (0 - r * z) = z
  calc
    b * (s * z - 0) - a * (0 - r * z) = (r * a + s * b) * z := by ring
    _ = z := by rw [hbezout]; simp

/-- The obstruction map is surjective whenever the same Bézout identity holds. -/
theorem freyThreePortObstruction_surjective_of_bezout
    {a b r s : ℤ} (hbezout : r * a + s * b = 1) :
    Function.Surjective (freyThreePortObstruction a b) := by
  intro z
  exact ⟨freyThreePortObstructionSplit r s z,
    freyThreePortObstruction_split_of_bezout hbezout z⟩

/-- The middle pair `ℤ² → ℤ³ → ℤ` is exact. -/
theorem freyThreePort_exact_of_bezout
    {a b r s : ℤ} (hbezout : r * a + s * b = 1) :
    Function.Exact (freyThreePortEvalLinear a b)
      (freyThreePortObstructionLinear a b) := by
  intro y
  constructor
  · intro hy
    change freyThreePortObstruction a b y = 0 at hy
    have hyCompatible : FreyThreePortCompatible a b y :=
      (freyThreePortCompatible_iff_obstruction_eq_zero a b y).mpr hy
    refine ⟨freyThreePortRecover r s y, ?_⟩
    exact freyThreePortEval_recover_of_compatible hbezout hyCompatible
  · rintro ⟨v, rfl⟩
    exact freyThreePortObstruction_eval a b v

/-- The selected obstruction split composes to the identity. -/
theorem freyThreePortObstruction_comp_split_of_bezout
    {a b r s : ℤ} (hbezout : r * a + s * b = 1) :
    (freyThreePortObstructionLinear a b).comp
        (freyThreePortObstructionSplitLinear r s) = LinearMap.id := by
  ext z
  exact freyThreePortObstruction_split_of_bezout hbezout z

/-- The obstruction map attached to a typed primitive additive triple. -/
def PrimitiveAdditiveTriple.threePortObstruction
    (t : PrimitiveAdditiveTriple) : FreyThreePortValues →ₗ[ℤ] ℤ :=
  freyThreePortObstructionLinear (t.a : ℤ) (t.b : ℤ)

/-- The canonical split of the obstruction attached to the same typed triple. -/
def PrimitiveAdditiveTriple.threePortObstructionSplit
    (t : PrimitiveAdditiveTriple) : ℤ →ₗ[ℤ] FreyThreePortValues :=
  freyThreePortObstructionSplitLinear t.bezoutA t.bezoutB

/-- The typed primitive-triple sequence is exact in the middle. -/
theorem PrimitiveAdditiveTriple.threePort_exact
    (t : PrimitiveAdditiveTriple) :
    Function.Exact t.threePortEval t.threePortObstruction := by
  exact freyThreePort_exact_of_bezout t.bezout_identity

/-- The typed obstruction map is split-surjective. -/
theorem PrimitiveAdditiveTriple.threePortObstruction_surjective
    (t : PrimitiveAdditiveTriple) :
    Function.Surjective t.threePortObstruction := by
  exact freyThreePortObstruction_surjective_of_bezout t.bezout_identity

/-- The typed obstruction split composes to the identity. -/
theorem PrimitiveAdditiveTriple.threePortObstruction_comp_split
    (t : PrimitiveAdditiveTriple) :
    t.threePortObstruction.comp t.threePortObstructionSplit = LinearMap.id := by
  exact freyThreePortObstruction_comp_split_of_bezout t.bezout_identity

/-- Primitivity makes the maximal-minor ideal of the typed three-port frame the
unit ideal. -/
theorem PrimitiveAdditiveTriple.threePortMaximalMinorIdeal_eq_top
    (t : PrimitiveAdditiveTriple) :
    freyThreePortMaximalMinorIdeal (t.a : ℤ) (t.b : ℤ) = ⊤ := by
  exact freyThreePortMaximalMinorIdeal_eq_top_of_bezout t.bezout_identity

/-- The rectangular three-port map is not surjective. The missing coordinate is
measured by the nonzero obstruction quotient. -/
theorem PrimitiveAdditiveTriple.threePortEval_not_surjective
    (t : PrimitiveAdditiveTriple) :
    ¬ Function.Surjective t.threePortEval := by
  intro hsurj
  let y : FreyThreePortValues := ![0, 1, 0]
  obtain ⟨v, hv⟩ := hsurj y
  have hCompatible :=
    freyThreePortEval_compatible (t.a : ℤ) (t.b : ℤ) v
  change freyThreePortEval (t.a : ℤ) (t.b : ℤ) v = y at hv
  rw [hv] at hCompatible
  have hbzero : (t.b : ℤ) = 0 := by
    simpa [FreyThreePortCompatible, y] using hCompatible
  have hbne : (t.b : ℤ) ≠ 0 := by
    exact_mod_cast (Nat.ne_of_gt t.b_pos)
  exact hbne hbzero

end GRWTSK.NumberTheory.Diophantine.PrimitiveAdditiveTriples
