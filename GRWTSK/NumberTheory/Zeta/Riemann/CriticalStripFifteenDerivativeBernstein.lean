/-- All four edges are included. This is finite polynomial geometry only. -/
theorem component_bounds {s : ℂ} (hx : 0 ≤ s.re) (hx1 : s.re ≤ 1)
    (hy : (14 : ℝ) ≤ s.im) (hy1 : s.im ≤ 15) :
    -(15/2 : ℝ) ≤ (model s).re ∧ (model s).re ≤ 17/2 ∧
      (7 : ℝ) ≤ (model s).im ∧ (model s).im ≤ 41/2 := by
  have hv : 0 ≤ s.im-14 := by linarith
  have hv1 : s.im-14 ≤ 1 := by linarith
  have h0 := tensorValue_nonneg reLower hx hx1 hv hv1
  have h1 := tensorValue_nonneg reUpper hx hx1 hv hv1
  have h2 := tensorValue_nonneg imLower hx hx1 hv hv1
  have h3 := tensorValue_nonneg imUpper hx hx1 hv hv1
  rw [reLower_identity] at h0
  rw [reUpper_identity] at h1
  rw [imLower_identity] at h2
  rw [imUpper_identity] at h3
  have he : (⟨s.re,14+(s.im-14)⟩ : ℂ) = s := by
    apply Complex.ext <;> simp
  rw [he] at h0 h1 h2 h3
  exact ⟨by linarith, by linarith, by linarith, by linarith⟩

/-- The center is an actual complex number; no positive-form relabeling occurs. -/
theorem model_disk {s : ℂ} (hs : Region s) :
    ‖model s-(1+13*I)‖ ≤ (23/2 : ℝ) := by
  have h := component_bounds hs.1.le hs.2.1 hs.2.2.1 hs.2.2.2
  have hr : |(model s).re-1| ≤ (17/2 : ℝ) := abs_le.mpr ⟨by linarith [h.1], by linarith [h.2.1]⟩
  have hi : |(model s).im-13| ≤ (15/2 : ℝ) := abs_le.mpr ⟨by linarith [h.2.2.1], by linarith [h.2.2.2]⟩
  have hr2 := mul_le_mul hr hr (abs_nonneg _) (by norm_num : (0 : ℝ) ≤ 17/2)
  have hi2 := mul_le_mul hi hi (abs_nonneg _) (by norm_num : (0 : ℝ) ≤ 15/2)
  apply (sq_le_sq₀ (norm_nonneg _) (by norm_num : (0 : ℝ) ≤ 23/2)).mp
  rw [Complex.sq_norm, Complex.normSq_apply]
  norm_num only [Complex.sub_re, Complex.sub_im, Complex.add_re, Complex.add_im,
    Complex.mul_re, Complex.mul_im, Complex.I_re, Complex.I_im,
    Complex.one_re, Complex.one_im, Complex.ofNat_re, Complex.ofNat_im] 
  nlinarith [sq_abs ((model s).re-1), sq_abs ((model s).im-13)]

