import GRWTSK.NumberTheory.Zeta.Riemann.CheckedPoleJet

set_option autoImplicit false

/-!
# Canonical checked packets for the unchanged normalized-source jet

The witness lists are generated by the existing exact integer recurrence from the
same source-computed initial state. No stored initial state, result, error radius,
PASS flag, or alternate arithmetic is supplied. This is a mathematical refinement,
not a runtime, memory, parser, or compiler claim.
SOURCE_ONLY / NOT_RUN / NOT_KERNEL_AUDITED.
-/
namespace GRWTSK.RiemannHypothesis.CanonicalCheckedPoleJet

open GRWTSK.Algebra.BigOperators.IndexedStateFold
open GRWTSK.Analysis.ErrorBounds
open RationalComplexEnclosure

/-- The exact successor rows for one fixed source input. -/
def powerRows (c : Coordinates) (p : RationalPoleValue.Parameters) (k : ℕ) :
    List IntegerDyadicSquare.State :=
  let d := RationalPoleValue.resolution p k
  IntegerSquareWitness.rowsFor d.bits d.squarings
    (CheckedIntegerPower.start c (k : ℚ) d)

/-- The generated rows give the SAME complete old inverse-power ball. -/
theorem powerRows_checked {c : Coordinates} {p : RationalPoleValue.Parameters} {k : ℕ}
    (h : RationalPowerValue.check c (k : ℚ) (RationalPoleValue.resolution p k) = true) :
    CheckedIntegerPower.evaluate c (k : ℚ) (RationalPoleValue.resolution p k)
      (powerRows c p k) = some (RationalPoleValue.powers c p k) := by
  let d := RationalPoleValue.resolution p k
  let x := CheckedIntegerPower.start c (k : ℚ) d
  have hw0 := IntegerSquareWitness.walk_rowsFor d.bits d.squarings x
  have hw : IntegerSquareWitness.walk d.bits d.squarings x (powerRows c p k) =
      some (run (fun _ z => IntegerDyadicSquare.step d.bits z) 0 d.squarings x) := by
    simpa only [powerRows,d,x] using hw0
  apply (CheckedIntegerPower.evaluate_eq_some_iff _ _ _ _ _).mpr
  refine ⟨h,run (fun _ z => IntegerDyadicSquare.step d.bits z) 0 d.squarings x,hw,?_⟩
  calc
    CheckedIntegerPower.finish c (k : ℚ) d
        (run (fun _ z => IntegerDyadicSquare.step d.bits z) 0 d.squarings x) =
        IntegerExpStateFold.powerValue c (k : ℚ) d :=
      CheckedIntegerPower.finish_eq_reference hw
    _ = RationalExpStateFold.powerValue c (k : ℚ) d :=
      IntegerExpStateFold.powerValue_eq c (k : ℚ) d
    _ = RationalPowerValue.valueBall c (k : ℚ) d :=
      RationalExpStateFold.powerValue_eq c (k : ℚ) d
    _ = RationalPoleValue.powers c p k := by
      rfl

/-- Consecutive source bases, with no independently editable labels. -/
def packetFrom (c : Coordinates) (p : RationalPoleValue.Parameters) :
    ℕ → ℕ → CheckedPoleJet.Packet
  | _, 0 => []
  | j, n+1 => powerRows c p (j+1) :: packetFrom c p (j+1) n

def packet (c : Coordinates) (p : RationalPoleValue.Parameters) : CheckedPoleJet.Packet :=
  packetFrom c p 0 p.cutoff

@[simp] theorem packetFrom_length (c : Coordinates) (p : RationalPoleValue.Parameters)
    (j n : ℕ) : (packetFrom c p j n).length = n := by
  induction n generalizing j with
  | zero => rfl
  | succ n ih => simp [packetFrom,ih]

@[simp] theorem packet_length (c : Coordinates) (p : RationalPoleValue.Parameters) :
    (packet c p).length = p.cutoff := by
  simp [packet]

/-- The generated packet follows the exact old ordered state recurrence. -/
theorem scan_packetFrom {c : Coordinates} {p : RationalPoleValue.Parameters}
    (j n : ℕ) (a : CheckedPoleJet.Accum)
    (hg : ∀ i, j ≤ i → i < j+n →
      RationalPowerValue.check c ((i+1 : ℕ) : ℚ)
        (RationalPoleValue.resolution p (i+1)) = true) :
    CheckedPoleJet.scan c p j n a (packetFrom c p j n) =
      some (run (CheckedPoleJet.referenceStep c p) j n a) := by
  induction n generalizing j a with
  | zero => rfl
  | succ n ih =>
      have hc := hg j le_rfl (by omega)
      have hg' : ∀ i, j+1 ≤ i → i < (j+1)+n →
          RationalPowerValue.check c ((i+1 : ℕ) : ℚ)
            (RationalPoleValue.resolution p (i+1)) = true := by
        intro i hlo hhi
        exact hg i (by omega) (by omega)
      have ht := ih (j+1)
        (CheckedPoleJet.advance p (j+1) (RationalPoleValue.powers c p (j+1)) a) hg'
      simpa only [packetFrom,CheckedPoleJet.scan,powerRows_checked hc,
        run,CheckedPoleJet.referenceStep] using ht

/-- Canonical witnesses reproduce the old complete finite value and derivative. -/
theorem finite_packet {c : Coordinates} {p : RationalPoleValue.Parameters}
    (h : RationalPoleValue.check c p = true) :
    CheckedPoleJet.finite c p (packet c p) = some (RationalPoleValue.finiteJet c p) := by
  have hv := (RationalPoleValue.check_iff_valid _ _).mp h
  have hs := scan_packetFrom (c:=c) (p:=p) 0 p.cutoff CheckedPoleJet.initial (by
    intro i _ hi
    exact hv.2.2 (i+1) (Finset.mem_Icc.mpr ⟨by omega,by omega⟩))
  unfold CheckedPoleJet.finite packet
  rw [h,if_true,hs,Option.map_some,CheckedPoleJet.run_reference,
    CheckedPoleJet.finish_reference c p hv.2.1]

/-- The old strict patch gate is reproduced, including false-versus-true semantics. -/
theorem checkPatch_packet {c : Coordinates} {R S : ℚ}
    {p : RationalPoleValue.Parameters}
    (h : RationalJetPolePatch.check c R S p = true) :
    CheckedPoleJet.checkPatch c R S p (packet c p) =
      some (RationalJetStateFold.reference c R S p) := by
  have hj := ((RationalJetPolePatch.check_iff _ _ _ _).mp h).1
  have hc := ((RationalPoleJet.check_iff _ _ _).mp hj).1
  have hf := finite_packet hc
  simp only [CheckedPoleJet.checkPatch,CheckedPoleJet.evaluate,hf,Option.map_some,
    CheckedPoleJet.fromFinite_reference,RationalJetStateFold.reference,h,if_true]

/-- Exact successful-result equivalence for the canonical packet. -/
theorem checkPatch_packet_iff {c : Coordinates} {R S : ℚ}
    {p : RationalPoleValue.Parameters} :
    (∃ q, CheckedPoleJet.checkPatch c R S p (packet c p) = some q) ↔
      RationalJetPolePatch.check c R S p = true := by
  constructor
  · rintro ⟨q,hq⟩
    exact (CheckedPoleJet.checkPatch_refines hq).2
  · intro h
    exact ⟨RationalJetStateFold.reference c R S p,checkPatch_packet h⟩

end GRWTSK.RiemannHypothesis.CanonicalCheckedPoleJet
