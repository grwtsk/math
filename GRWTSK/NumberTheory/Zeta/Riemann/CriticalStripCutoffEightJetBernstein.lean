/-- Identity on ALL real u,v; basis positivity is used only on the unit square. -/
lemma tensor_identity (u v : ℝ) :
    tensorValue coefficients u v = 70368744177664 *
      (projection (⟨(1+u)/2,13+v⟩ : ℂ)-4) := by
  norm_num [tensorValue,coefficients,boxBasis,projection,polynomial,coefficient,center,
    Fin.sum_univ_succ,Complex.mul_re,Complex.mul_im,Complex.sub_re,Complex.sub_im,
    Complex.conj_re,Complex.conj_im,Complex.ofReal_re,Complex.ofReal_im,
    Complex.ofNat_re,Complex.ofNat_im,Complex.one_re,Complex.one_im]
  ring

lemma polynomial_projection_lower {s : ℂ} (hx : (1/2 : ℝ) ≤ s.re) (hx1 : s.re ≤ 1)
    (ht : (13 : ℝ) ≤ s.im) (ht1 : s.im ≤ 14) : (4 : ℝ) ≤ projection s := by
  have hu : 0 ≤ 2*s.re-1 := by linarith
  have hu1 : 2*s.re-1 ≤ 1 := by linarith
  have hv : 0 ≤ s.im-13 := by linarith
  have hv1 : s.im-13 ≤ 1 := by linarith
  have h := tensorValue_nonneg coefficients hu hu1 hv hv1
  rw [tensor_identity] at h
  have he : (⟨(1+(2*s.re-1))/2,13+(s.im-13)⟩ : ℂ)=s := by
    apply Complex.ext <;> simp only [Complex.mk_re,Complex.mk_im] <;> ring
  rw [he] at h
  linarith

end
