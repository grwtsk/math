import GRWTSK.NumberTheory.Zeta.Riemann.CenteredMobiusLogFinitePacket
import GRWTSK.NumberTheory.Moebius.TruncatedMobiusLogReconstruction
import Mathlib.Tactic
set_option autoImplicit false
noncomputable section
open scoped BigOperators
namespace GRWTSK.RiemannHypothesis

/-- Augmented one-variable arithmetic data: an anchor plus genuine divisor
coefficients. -/
structure AugmentedMobiusLogData where
  anchor : ℝ
  genuine : ℕ → ℝ

/-- Actual affine centered atom generated by augmented arithmetic data. -/
def augmentedMobiusLogAtom (x : AugmentedMobiusLogData) (n : ℕ) : ℝ :=
  x.anchor + mobiusLogDivisorRow x.genuine n

/-- Four-channel two-variable map, kept expanded rather than collapsed. -/
def augmentedMobiusLogPairMap
    (x y : AugmentedMobiusLogData) (n m : ℕ) : ℝ :=
  x.anchor * y.anchor +
  x.anchor * mobiusLogDivisorRow y.genuine m +
  mobiusLogDivisorRow x.genuine n * y.anchor +
  mobiusLogDivisorRow x.genuine n * mobiusLogDivisorRow y.genuine m

theorem augmentedMobiusLogPairMap_eq_atom_mul
    (x y : AugmentedMobiusLogData) (n m : ℕ) :
    augmentedMobiusLogPairMap x y n m =
      augmentedMobiusLogAtom x n * augmentedMobiusLogAtom y m := by
  unfold augmentedMobiusLogPairMap augmentedMobiusLogAtom
  ring

/-- The actual historical centered Möbius packet: anchor -1 and genuine μ. -/
def actualCenteredMobiusLogData : AugmentedMobiusLogData where
  anchor := -1
  genuine := mobiusReal

/-- Exact commutation of the authenticated historical one-variable packet with
the augmented affine divisor-log map. -/
theorem actual_augmentedMobiusLogAtom_eq_centeredIndexSum (n : ℕ) :
    augmentedMobiusLogAtom actualCenteredMobiusLogData n =
      centeredMobiusLogDivisorIndexSum n := by
  rw [centeredMobiusLogDivisorIndexSum_eq_centeredVonMangoldt]
  unfold augmentedMobiusLogAtom actualCenteredMobiusLogData
    centeredVonMangoldtAtom mobiusReal
  have h := congrArg (fun f : ArithmeticFunction ℝ => f n)
    ArithmeticFunction.moebius_mul_log_eq_vonMangoldt
  simp only [ArithmeticFunction.mul_apply, ArithmeticFunction.log_apply,
    ArithmeticFunction.intCoe_apply] at h
  rw [Nat.sum_divisorsAntidiagonal
    (fun d a => ((ArithmeticFunction.moebius d : ℤ) : ℝ) * Real.log a)] at h
  unfold mobiusLogDivisorRow
  rw [← h]
  ring

/-- Exact four-channel commutation for the actual historical packet. -/
theorem actual_augmentedMobiusLogPairMap_eq_centeredPairBlock
    (n h : ℕ) :
    augmentedMobiusLogPairMap
        actualCenteredMobiusLogData actualCenteredMobiusLogData n (n + h) =
      centeredMobiusLogDivisorPairBlock n h := by
  rw [augmentedMobiusLogPairMap_eq_atom_mul,
    actual_augmentedMobiusLogAtom_eq_centeredIndexSum,
    actual_augmentedMobiusLogAtom_eq_centeredIndexSum]
  unfold centeredMobiusLogDivisorPairBlock centeredMobiusLogDivisorIndexSum
  rw [Finset.sum_mul]
  apply Finset.sum_congr rfl
  intro u _
  rw [Finset.mul_sum]

/-- Difference data for the admissible augmented arithmetic family. -/
def augmentedMobiusLogDifference
    (x y : AugmentedMobiusLogData) : AugmentedMobiusLogData where
  anchor := x.anchor - y.anchor
  genuine := fun d => x.genuine d - y.genuine d

/-- Output coordinate 1 separates the anchor because the genuine divisor-log
row at 1 vanishes. -/
theorem augmentedMobiusLogAtom_one (x : AugmentedMobiusLogData) :
    augmentedMobiusLogAtom x 1 = x.anchor := by
  unfold augmentedMobiusLogAtom mobiusLogDivisorRow
  simp

/-- Once anchors agree, equality of one-variable outputs through 2N recovers
all genuine coefficients through N by the checked triangular reconstruction. -/
theorem augmentedMobiusLogAtom_twoN_reconstruct
    {N : ℕ} (x y : AugmentedMobiusLogData)
    (hout : ∀ n, 1 ≤ n → n ≤ 2 * N →
      augmentedMobiusLogAtom x n = augmentedMobiusLogAtom y n) :
    x.anchor = y.anchor ∧
      ∀ d, 1 ≤ d → d ≤ N → x.genuine d = y.genuine d := by
  have hanchor := hout 1 (by omega) (by
    by_cases hN : N = 0
    · subst N
      simp at hout
    · omega)
  rw [augmentedMobiusLogAtom_one, augmentedMobiusLogAtom_one] at hanchor
  refine ⟨hanchor, ?_⟩
  apply truncatedMobiusLogConvolution_twoN_reconstruct
  intro n hn hn2N
  have h := hout n hn hn2N
  unfold augmentedMobiusLogAtom at h
  rw [hanchor] at h
  have hx := truncated_eq_mobiusLogDivisorRow hn hn2N x.genuine
  have hy := truncated_eq_mobiusLogDivisorRow hn hn2N y.genuine
  linarith

end GRWTSK.RiemannHypothesis
