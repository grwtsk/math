def pivots (i : Head) : ℤ := pivotAt (index i)

/-- The stored finite signed interval; an actual source comparison is a separate premise. -/
def bounds (i j : Head) : Bounds :=
  let r := min (index i) (index j)
  let c := max (index i) (index j)
  (dyadic 108 (digit (lowerAt r) 116 c), dyadic 108 (digit (upperAt r) 116 c))

theorem bounds_symm (i j : Head) : bounds i j = bounds j i := by
  simp only [bounds, min_comm, max_comm]

/-- Complete finite row predicate for the stored interval and weighted Gram data. -/
abbrev RowCheck (i : Head) : Prop :=
  (∑ j, intervalRadii bounds i j) ≤ (25 / 512 : ℚ) ∧
  checkRow target factor pivots i = true ∧
  checkMinorantRow (intervalPaid bounds (25 / 512)) (targetValue 32 target) (1 / 1024) i = true

end GRWTSK.NumberTheory.WeilQuadraticForm.RadiusTwoRankFourPaidPacket
