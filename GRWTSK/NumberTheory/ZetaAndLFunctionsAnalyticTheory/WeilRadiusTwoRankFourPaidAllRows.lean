theorem checkedPaidLDL : check target factor pivots = true :=
  decide_eq_true (fun i => (checkedPaidRows i).2.1)

theorem checkedPaidMinorant : checkMinorant (intervalPaid bounds (25 / 512))
    (targetValue 32 target) (1 / 1024) = true :=
  decide_eq_true (fun i => (checkedPaidRows i).2.2)

theorem paidIntervalSign {A : Matrix Head Head ℝ}
    (h : ∀ i j, Encloses (bounds i j) (A i j)) (v : Head → ℝ) : 0 ≤ quadratic A v :=
  quadratic_nonneg_of_intervalLDL 32 bounds (25 / 512) (1 / 1024) target factor pivots
    (fun i => (checkedPaidRows i).1) checkedPaidLDL checkedPaidMinorant bounds_symm h v

end GRWTSK.NumberTheory.WeilQuadraticForm.RadiusTwoRankFourPaidPacket
