    ConductorThreeRadiusFourResidualHead.residualBudget,
    ConductorThreeRadiusFourMiddleReturn.cleanMiddleBudget,
    ConductorThreeRadiusFourPaidPacket.pairPacketPrice,
    ConductorThreeRadiusFourPaidPacket.singlePacketPrice]

theorem exact_entire_mixed_price :
    entireMixedPrice = 2518569 / 10 ^ (54 : ℕ) ∧
      entireMixedPrice < sufficientFiniteMargin ∧
      sufficientFiniteMargin - entireMixedPrice = 481431 / 10 ^ (54 : ℕ) := by
  norm_num [entireMixedPrice, frequencyOperatorUpper, entireLeakUpper,
    sufficientFiniteMargin]

/-- Scalar return only AFTER the OPEN actual finite physical-Gram sign.
The correction bound is supplied by the written entire mixed proof above. -/
theorem finite_effective_scalar_return (mass headValue correction : ℝ)
    (hphysical : 0 ≤ mass)
    (hfinite : (sufficientFiniteMargin : ℝ) * mass ≤ headValue)
    (hmixed : correction ≤ (entireMixedPrice : ℝ) * mass) :
    0 ≤ headValue - correction := by
  have hm : (entireMixedPrice : ℝ) ≤ (sufficientFiniteMargin : ℝ) := by
    norm_num [entireMixedPrice, frequencyOperatorUpper, entireLeakUpper,
      sufficientFiniteMargin]
  have hs := mul_le_mul_of_nonneg_right hm hphysical
  linarith

/-- Actual full dependent-data roundtrip; no source sign is an input. -/
theorem retained_full_roundtrip
    (data : ConductorThreeRadiusFourPaidPacket.RetainedEvidence) :
    ConductorThreeRadiusFourPaidPacket.decodeRetained
      (ConductorThreeRadiusFourPaidPacket.retainedCodec.encode data) = data :=
  ConductorThreeRadiusFourPaidPacket.full_roundtrip data

/-- Complete branch coverage; distinct from the actual far-block heat. -/
theorem entire_unobserved_coverage (J : ℕ) :
    (∑' k : ℕ, WeightedStage.stageCoverageWeight (J + k)) = (1 / 2 : ℝ) ^ J :=
  WeightedStage.stageCoverageWeight_tail J

/-- New source-specific inverse bound retains the ORIGINAL Fourier leakage. -/
def refinedFrequencyUpper : ℚ := 741

def refinedMixedPrice : ℚ := 9 * refinedFrequencyUpper ^ 2 * entireLeakUpper

def refinedFiniteMargin : ℚ := 5 / 10 ^ 54

theorem refined_whole_mixed_price :
    refinedMixedPrice = 4941729 / 10 ^ (60 : ℕ) ∧
      refinedMixedPrice < refinedFiniteMargin := by
  norm_num [refinedMixedPrice, refinedFrequencyUpper, entireLeakUpper,
    refinedFiniteMargin]

theorem refined_far_gap_and_ratio :
    (1 / 9 : ℚ) < originalBudget - refinedFrequencyUpper * entireLeakUpper ∧
      refinedFrequencyUpper * entireLeakUpper / originalBudget < 1 / 10 ^ (56 : ℕ) := by
  rw [exact_original_budget]
  norm_num [refinedFrequencyUpper, entireLeakUpper]

end GRWTSK.NumberTheory.WeilQuadraticForm.ConductorThreeRadiusFourLegendreTail
