def squareUpper (a : (ℕ × ℕ × ℕ) × ℕ) : ℚ :=
  (a.2 : ℚ) ^ 2 / ((a.1.2.2 : ℚ) * 10 ^ 24)
def mixedSquareNumerator (a : (ℕ × ℕ × ℕ) × ℕ) : ℕ :=
  (a.2 ^ 2 + a.1.2.2 * 10 ^ 6 - 1) / (a.1.2.2 * 10 ^ 6)
def sameSideSquareNumerator : ℕ :=
  ((mixedSquareData.filter (fun a => decide (a.1.2.2 ≤ 54))).map
    mixedSquareNumerator).sum
def reflectionSquareNumerator : ℕ :=
  ((mixedSquareData.filter
    (fun a => decide (21 ≤ a.1.2.2 ∧ a.1.2.2 ≤ 1096))).map
      mixedSquareNumerator).sum
def sameSideSquareUpper : ℚ :=
  (sameSideSquareNumerator : ℚ) / 10 ^ 18
def reflectionSquareUpper : ℚ :=
  (reflectionSquareNumerator : ℚ) / 10 ^ 18

def windowPrice (a : (ℕ × ℕ × ℕ) × (ℕ × ℕ × ℕ)) : ℕ :=
  ((newPriceData.filter
    (fun b => decide (a.1.2.2 ≤ b.1.2.2 ∧ 4 * b.1.2.2 ≤ 11 * a.1.2.2))).map
      (fun b => b.2.2.2)).sum
def allWindowPrices : List ℕ := newPriceData.map windowPrice

theorem native_source_complete : nativeSourceAtoms.length = 458 := by decide
theorem native_source_no_duplicates :
    (nativeSourceAtoms.map (fun a => a.2.2)).Nodup := by decide
theorem mixed_source_complete :
    mixedSquareData.map Prod.fst =
      nativeSourceAtoms.filter (fun a => decide (a.2.2 ≤ 1096)) := by decide
theorem new_source_complete :
    newPriceData.map Prod.fst =
      nativeSourceAtoms.filter (fun a => decide (404 ≤ a.2.2)) := by decide
theorem full_mixed_counts :
    (mixedSquareData.filter (fun a => decide (a.1.2.2 ≤ 54))).length = 21 ∧
      (mixedSquareData.filter
        (fun a => decide (21 ≤ a.1.2.2 ∧ a.1.2.2 ≤ 1096))).length = 193 := by decide
theorem full_new_count : newPriceData.length = 365 := by decide

theorem source_sqrt_and_rounding_data :
    newPriceData.all (fun a => decide
      (a.2.2.1 ^ 2 ≤ a.1.2.2 * 10 ^ 24 ∧
       a.1.2.2 * 10 ^ 24 < (a.2.2.1 + 1) ^ 2 ∧
       a.2.1 * 10 ^ 12 ≤ a.2.2.2 * a.2.2.1)) = true := by decide

theorem mixed_squared_grid_rounding :
    mixedSquareData.all (fun a => decide
      (a.2 ^ 2 ≤ mixedSquareNumerator a * (a.1.2.2 * 10 ^ 6) ∧
       mixedSquareNumerator a * (a.1.2.2 * 10 ^ 6) <
         a.2 ^ 2 + a.1.2.2 * 10 ^ 6)) = true := by decide
