def localizationWidth : ℚ := 1 / 2 ^ 1600
theorem width_separates_all_native_logs :
    localizationWidth < (1 : ℚ) / 1096 ∧
      2 * localizationWidth < (1 : ℚ) / 2980 ∧
      localizationWidth < (1 : ℚ) / 100 := by
  have hp : (10000 : ℕ) < 2 ^ 1600 := by decide
  have hq : (10000 : ℚ) < (2 : ℚ) ^ 1600 := by exact_mod_cast hp
  have hd : localizationWidth < (1 : ℚ) / 10000 :=
    one_div_lt_one_div_of_lt (by norm_num) hq
  refine ⟨hd.trans (by norm_num), ?_, hd.trans (by norm_num)⟩
  have ht := mul_lt_mul_of_pos_left hd (by norm_num : (0 : ℚ) < 2)
  exact ht.trans (by norm_num)

