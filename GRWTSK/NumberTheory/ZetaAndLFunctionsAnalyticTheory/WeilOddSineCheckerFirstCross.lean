private def rows : Finset (Fin 32768) := Finset.Icc 284 479

private def rowSlice (b : Fin 14) : Finset (Fin 32768) :=
  Finset.Icc ⟨284 + 14 * b.val, by omega⟩ ⟨284 + 14 * b.val + 13, by omega⟩

private theorem rowSlices_cover : Finset.univ.biUnion rowSlice = rows := by
  ext i
  simp only [Finset.mem_biUnion, Finset.mem_univ, true_and, rows, rowSlice, Finset.mem_Icc, Fin.le_def]
  change (∃ b : Fin 14, 284 + 14 * b.val ≤ i.val ∧ i.val ≤ 284 + 14 * b.val + 13) ↔
    284 ≤ i.val ∧ i.val ≤ 479
  constructor
  · rintro ⟨b, hb, hc⟩
    omega
  · rintro ⟨hl, hu⟩
    let b : Fin 14 := ⟨(i.val - 284) / 14, by omega⟩
    refine ⟨b, ?_, ?_⟩ <;> dsimp [b] <;> omega

private theorem rowSlices_disjoint : Set.PairwiseDisjoint
    (↑(Finset.univ : Finset (Fin 14))) rowSlice := by
  intro a _ b _ hab
  apply Finset.disjoint_left.mpr
  intro i ha hb
  have hne : a.val ≠ b.val := fun h => hab (Fin.ext h)
  simp only [rowSlice, Finset.mem_Icc, Fin.le_def] at ha hb
  omega

