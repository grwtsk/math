private theorem crossSincs_eq :
    ∀ offset : Fin 389, crossSincs (188 + offset.val) = sincEntry (188 + offset.val) := by
  decide +kernel

private theorem sinc_agrees (j : ℕ) (hl : 188 ≤ j) (hu : j ≤ 576) :
    crossSincs j = sincEntry j := by
  simpa only [Nat.add_sub_of_le hl] using crossSincs_eq ⟨j - 188, by omega⟩

set_option maxRecDepth 32768 in
set_option maxHeartbeats 50000000 in
private theorem slice_checked (b : Fin 14) :
    triangleBlock crossPrices crossSincs (rowSlice b) columns = sliceTotal b := by
  fin_cases b <;> decide +kernel

private theorem cross_cached :
    triangleBlock crossPrices crossSincs rows columns = 701039135599897704764551425563095860425326800384984 := by
  calc
    _ = ∑ b : Fin 14, triangleBlock crossPrices crossSincs (rowSlice b) columns := by
      rw [← rowSlices_cover]
      simp only [triangleBlock]
      rw [Finset.sum_biUnion rowSlices_disjoint]
    _ = ∑ b : Fin 14, sliceTotal b := Finset.sum_congr rfl fun b _ => slice_checked b
    _ = _ := by decide +kernel

/-- The exact lower cross term between the first two certified retained runs. -/
theorem firstTwoRetainedRunsCross :
    triangleBlock (price literalRawDeficit) sincEntry
      (retainedRunCells (284, 479)) (retainedRunCells (0, 96)) = 701039135599897704764551425563095860425326800384984 := by
  have hrows : retainedRunCells (284, 479) = rows :=
    retainedRunCells_eq_Icc (by decide) (by decide)
  have hcolumns : retainedRunCells (0, 96) = columns :=
    retainedRunCells_eq_Icc (by decide) (by decide)
  rw [hrows, hcolumns]
  refine Eq.trans ?_ cross_cached
  symm
  apply triangleBlock_congr
  · intro i hi
    rcases Finset.mem_union.mp hi with hi | hi
    · have ⟨hl, hu⟩ := Finset.mem_Icc.mp hi
      change 284 ≤ i.val at hl
      change i.val ≤ 479 at hu
      have h := rowPrices_eq ⟨i.val - 284, by omega⟩
      have he : (⟨284 + (i.val - 284), by omega⟩ : Fin 32768) = i :=
        Fin.ext (Nat.add_sub_of_le hl)
      rwa [he] at h
    · have hu := (Finset.mem_Icc.mp hi).2
      change i.val ≤ 96 at hu
      rw [crossPrices, dite_eq_left (show i.val < 97 by omega)]
      exact firstRetainedRunPrice_eq ⟨i.val, by omega⟩
  · intro i hi j hj _
    have ⟨hl, hu⟩ := Finset.mem_Icc.mp hi
    have hv := (Finset.mem_Icc.mp hj).2
    change 284 ≤ i.val at hl
    change i.val ≤ 479 at hu
    change j.val ≤ 96 at hv
    refine ⟨sinc_agrees _ ?_ ?_, sinc_agrees _ (by omega) (by omega)⟩ <;>
      simp only [Nat.dist] <;> omega

