private theorem firstRunPrices_eq :
    ∀ i : Fin 97, firstRunPrices (i.castLE (by decide)) =
      price literalRawDeficit (i.castLE (by decide)) := by
  decide +kernel

/-- The checked price table restricted to the first retained run. -/
def firstRetainedRunPrice (i : Fin 97) : ℕ := firstRunPrices (i.castLE (by decide))

theorem firstRetainedRunPrice_eq (i : Fin 97) :
    firstRetainedRunPrice i = price literalRawDeficit (i.castLE (by decide)) :=
  firstRunPrices_eq i

set_option maxRecDepth 32768 in
set_option maxHeartbeats 3000000 in
private theorem firstRunSincs_eq :
    ∀ j : Fin 194, firstRunSincs j.val = sincEntry j.val := by
  decide +kernel

private def firstRun : Finset (Fin 32768) := Finset.Icc 0 96

private theorem firstRun_index_le {i : Fin 32768} (hi : i ∈ firstRun) :
    i.val ≤ 96 := (Finset.mem_Icc.mp hi).2

set_option maxRecDepth 32768 in
set_option maxHeartbeats 20000000 in
private theorem firstRun_cached :
    triangleBlock firstRunPrices firstRunSincs firstRun firstRun = 17405127940461858326897087293074263913445848239025 := by
  decide +kernel

/-- The exact contribution of the first retained run paired with itself in
`total_eq_retainedRunBlocks`. -/
theorem firstRetainedRunDiagonal :
    triangleBlock (price literalRawDeficit) sincEntry
      (retainedRunCells (0, 96)) (retainedRunCells (0, 96)) = 17405127940461858326897087293074263913445848239025 := by
  have hcells : retainedRunCells (0, 96) = firstRun :=
    retainedRunCells_eq_Icc (by decide) (by decide)
  rw [hcells]
  refine Eq.trans ?_ firstRun_cached
  symm
  apply triangleBlock_congr
  · intro i hi
    have hi' : i ∈ firstRun := by simpa only [Finset.union_self] using hi
    exact firstRunPrices_eq ⟨i.val, Nat.lt_succ_of_le (firstRun_index_le hi')⟩
  · intro i hi j hj _
    obtain ⟨hdiff, hsum⟩ := table_indices_lt (firstRun_index_le hi) (firstRun_index_le hj)
    exact ⟨firstRunSincs_eq ⟨_, hdiff⟩, firstRunSincs_eq ⟨_, hsum⟩⟩

