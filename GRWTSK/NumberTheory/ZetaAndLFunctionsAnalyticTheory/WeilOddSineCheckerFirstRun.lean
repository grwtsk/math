/-- An in-range pair of endpoints gives the ordinary finite closed interval. -/
theorem retainedRunCells_eq_Icc {lo hi : ℕ} (hlo : lo < 32768) (hhi : hi < 32768) :
    retainedRunCells (lo, hi) =
      Finset.Icc (⟨lo, hlo⟩ : Fin 32768) (⟨hi, hhi⟩ : Fin 32768) := by
  ext i
  simp [retainedRunCells, Fin.le_def]

