def index : Head → Nat | .inl i => i.val | .inr _ => 64
def digit (word j : Nat) : Int := Int.ofNat ((word / 2^(64*j)) % 2^64) - Int.ofNat (2^63)
def lower (i j : Head) : Int := digit (lowerAt (index i)) (index j)
def upper (i j : Head) : Int := digit (upperAt (index i)) (index j)
def bounds (i j : Head) : Bounds := (dyadic 44 (lower i j),dyadic 44 (upper i j))
