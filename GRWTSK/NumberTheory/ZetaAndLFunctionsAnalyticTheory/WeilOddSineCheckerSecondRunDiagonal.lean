import GRWTSK.NumberTheory.ZetaAndLFunctionsAnalyticTheory.WeilOddSineCheckerSecondRunData

/-!
# Exact diagonal subtotal of the second retained run

This block pairs the global cells 284 through 479 with themselves. It uses
difference lookups on [0, 195] and sum lookups on [569, 959]. The cached
signed sinc values were computed from `scripts/verify_odd_three_sine_hs.py`
at blob `b35434bed50c8a6ba218d01575e1964cae9a93e6`. Each lookup is checked
against its literal formula. The packed prices agree on this run with the
checked prices used by the first cross block. Packing allows direct reduction
of individual lookups without traversing long array literals.
-/

set_option autoImplicit false

open scoped BigOperators

namespace GRWTSK.NumberTheory.WeilQuadraticForm.OddThreeSineHilbertSchmidt.CheckerTriangle

-- A table entry is a base-2^41 digit, with index zero in the lowest bits.
-- The sinc digits store the signed value plus 10^12.
private def digit (packed j : ℕ) : ℕ :=
  (packed >>> (41 * j)) % 2199023255552

private def diagonalPrice (i : Fin 32768) : ℕ :=
  digit  (i.val - 284)

private def diagonalSincs (j : ℕ) : ℤ :=
  if j < 196 then
    (digit  j : ℤ) - 1000000000000
  else
    (digit  (j - 569) : ℤ) - 1000000000000

set_option maxRecDepth 32768 in
set_option maxHeartbeats 6000000 in
private theorem packedPrices_eq :
    ∀ offset : Fin 196,
      diagonalPrice ⟨284 + offset.val, by omega⟩ =
        secondRetainedRunPrice ⟨284 + offset.val, by omega⟩ := by
  decide +kernel

private theorem diagonalPrice_eq {i : Fin 32768} (hi : i ∈ secondRetainedRunCells) :
    diagonalPrice i = price literalRawDeficit i := by
  have ⟨hl, hu⟩ := Finset.mem_Icc.mp hi
  change 284 ≤ i.val at hl
  change i.val ≤ 479 at hu
  have h := packedPrices_eq ⟨i.val - 284, by omega⟩
  have he : (⟨284 + (i.val - 284), by omega⟩ : Fin 32768) = i :=
    Fin.ext (Nat.add_sub_of_le hl)
  rw [he] at h
  exact h.trans (secondRetainedRunPrice_eq hi)

private def sliceTotal (b : Fin 14) : ℕ :=
  #[3201208970600783123241517142039123368004403985206, 45174269110224839971122463540076365569108709922083,
    182336388298448787458713742534106162374135143495372, 443681693198597456698928456380418071729106423676184,
    816698950132474937430987239378136091610903603176098, 1249631094556307687064954367493291207337493123723849,
    1665472566746159969166305230053684320670554137377043, 1982259193188141384156328743698546255338980530977727,
    2133110713875994190381738259274995121656837179372228, 2080758901337802484888307427118097342487359676524868,
    1823949561880405246966658779172830149114673724636078, 1395872774672153326368422153315862806752059046335140,
    856678946601162989647374907747890360823531692125959, 282805945709552808305361548559566900828432147346902][b.val]!

set_option maxRecDepth 32768 in
set_option maxHeartbeats 6000000 in
private theorem differenceSincs_eq :
    ∀ j : Fin 196, diagonalSincs j.val = sincEntry j.val := by
  decide +kernel

set_option maxRecDepth 32768 in
set_option maxHeartbeats 6000000 in
private theorem sumSincs_eq :
    ∀ j : Fin 391, diagonalSincs (569 + j.val) = sincEntry (569 + j.val) := by
  decide +kernel

set_option maxRecDepth 32768 in
set_option maxHeartbeats 50000000 in
private theorem slice_checked (b : Fin 14) :
    triangleBlock diagonalPrice diagonalSincs (secondRetainedRunSlice b)
      secondRetainedRunCells = sliceTotal b := by
  fin_cases b <;> decide +kernel

private theorem diagonal_cached :
    triangleBlock diagonalPrice diagonalSincs secondRetainedRunCells
      secondRetainedRunCells = 14961632208278026891628444835409540279661179542674737 := by
  calc
    _ = ∑ b : Fin 14, triangleBlock diagonalPrice diagonalSincs
        (secondRetainedRunSlice b) secondRetainedRunCells :=
      triangleBlock_secondRetainedRun_eq_sum_slices _ _ _
    _ = ∑ b : Fin 14, sliceTotal b := Finset.sum_congr rfl fun b _ => slice_checked b
    _ = _ := by decide +kernel

/-- The exact contribution of the second retained interval paired with itself. -/
theorem secondRetainedRunDiagonal :
    triangleBlock (price literalRawDeficit) sincEntry secondRetainedRunCells
      secondRetainedRunCells = 14961632208278026891628444835409540279661179542674737 := by
  refine Eq.trans ?_ diagonal_cached
  symm
  apply triangleBlock_congr
  · intro i hi
    rw [Finset.union_self] at hi
    exact diagonalPrice_eq hi
  · intro i hi j hj _
    have ⟨hil, hiu⟩ := Finset.mem_Icc.mp hi
    have ⟨hjl, hju⟩ := Finset.mem_Icc.mp hj
    change 284 ≤ i.val at hil
    change i.val ≤ 479 at hiu
    change 284 ≤ j.val at hjl
    change j.val ≤ 479 at hju
    have hd : Nat.dist i.val j.val < 196 := by
      simp only [Nat.dist]
      omega
    let k := i.val + j.val + 1
    have hk : 569 ≤ k := by dsimp [k]; omega
    have hu : k ≤ 959 := by dsimp [k]; omega
    refine ⟨differenceSincs_eq ⟨_, hd⟩, ?_⟩
    change diagonalSincs k = sincEntry k
    simpa only [Nat.add_sub_of_le hk] using sumSincs_eq ⟨k - 569, by omega⟩

end GRWTSK.NumberTheory.WeilQuadraticForm.OddThreeSineHilbertSchmidt.CheckerTriangle
