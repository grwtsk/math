  ∀ j : Head,
    (RadiusTwoRankFourPaidPacket.bounds i j).1 ≤ (calculatedBounds i j).1 ∧
      (calculatedBounds i j).2 ≤ (RadiusTwoRankFourPaidPacket.bounds i j).2

