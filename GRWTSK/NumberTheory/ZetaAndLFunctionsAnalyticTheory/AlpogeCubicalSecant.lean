import Mathlib.RingTheory.Ideal.Basic
import Mathlib.Tactic.LinearCombination
import Mathlib.Tactic.Ring

/-! Algebra of the chord in the formal chart of y² = x³ − cx.
The cleared identities hold in arbitrary residue characteristic. -/

namespace GRWTSK.NumberTheory.AlpogeCubicalSecant

variable {R : Type*} [CommRing R]

/-- The divided difference of inverse x-coordinates has a unit denominator. -/
theorem inverse_x_difference (c x y u v : R)
    (hu : u = x^2*(1-c*u^2)) (hv : v = y^2*(1-c*v^2)) :
    (v-u)*(1+c*u*v)=(y^2-x^2)*(1-c*u^2)*(1-c*v^2) := by
  calc
    _ = v*(1-c*u^2)-u*(1-c*v^2) := by ring
    _ = _ := by linear_combination (1-c*u^2)*hv - (1-c*v^2)*hu

/-- Slope and intercept of the chord, already extended across the diagonal. -/
theorem chord_endpoints (x y u v k : R) (hk : v-u=(y^2-x^2)*k) :
    let a := u+y*(x+y)*k
    let b := -x*y*(x+y)*k
    a*x+b=x*u ∧ a*y+b=y*v := by
  dsimp
  constructor
  · ring
  · linear_combination -y*hk

/-- Intersecting the actual curve with the chord gives a cubic in the parameter. -/
def intersection (c a b z : R) : R :=
  (1-c*a^2)*z^3-2*c*a*b*z^2-(a+c*b^2)*z-b

theorem intersection_error (c a b z w : R) (hw : w=z^3-c*z*w^2) :
    (w-(a*z+b))*(1+c*z*(w+a*z+b))=intersection c a b z := by
  unfold intersection
  linear_combination hw

/-- Polynomial interpolation clearing the two colliding point differences.
This identity also keeps the factor where the sum of the three points vanishes. -/
theorem three_point_remainder (c a b x y z : R) :
    (y-x)*intersection c a b z-(y-z)*intersection c a b x-
      (z-x)*intersection c a b y =
    (y-x)*(z-x)*(z-y)*((1-c*a^2)*(z+x+y)-2*c*a*b) := by
  unfold intersection
  ring

/-- Regular remainder in any domain at distinct universal parameters. -/
theorem divided_chord (c a b x y z w f d : R) [IsDomain R]
    (hxy : y-x ≠ 0) (hzx : z-x ≠ 0) (hzy : z-y ≠ 0)
    (hx : intersection c a b x = 0) (hy : intersection c a b y = 0)
    (hw : w=z^3-c*z*w^2) (hd : w-(a*z+b)=(z-x)*(z-y)*d)
    (hf : (1-c*a^2)*f=(1-c*a^2)*(x+y)-2*c*a*b) :
    d*(1+c*z*(w+a*z+b))=(1-c*a^2)*(z+f) := by
  have hi := three_point_remainder c a b x y z
  rw [hx,hy,mul_zero,sub_zero,mul_zero,sub_zero,← intersection_error c a b z w hw,hd] at hi
  apply mul_left_cancel₀ (mul_ne_zero (mul_ne_zero hxy hzx) hzy)
  linear_combination hi - (y-x)*(z-x)*(z-y)*hf

/-- Every exponent at least two is generated by the degree-eight and
degree-twelve coefficient tests of the integral cubical series. -/
theorem power_difference_mem (J : Ideal R) (c e : R)
    (h2 : c^2-e^2 ∈ J) (h3 : c^3-e^3 ∈ J) (n : ℕ) :
    c^(n+2)-e^(n+2) ∈ J := by
  induction n using Nat.strong_induction_on with
  | h n ih =>
    obtain _ | n := n
    · exact h2
    obtain _ | n := n
    · exact h3
    have hn := ih n (by omega)
    have he : c^(n+2+2)-e^(n+2+2) =
        c^2*(c^(n+2)-e^(n+2))+e^(n+2)*(c^2-e^2) := by ring
    exact he ▸ J.add_mem (J.mul_mem_left _ hn) (J.mul_mem_left _ h2)

/-- Bezout extraction of the cubic twist difference from the actual two
degree-twelve multipliers, valid in arbitrary characteristic. -/
theorem extract_cubic (J : Ideal R) (a : R)
    (h : (-2:R)*a ∈ J) (k : (-57:R)*a ∈ J) : a ∈ J := by
  have he : (28:R)*(-2*a)-(-57*a)=a := by ring
  rw [← he]
  exact J.sub_mem (J.mul_mem_left _ h) k

end GRWTSK.NumberTheory.AlpogeCubicalSecant
