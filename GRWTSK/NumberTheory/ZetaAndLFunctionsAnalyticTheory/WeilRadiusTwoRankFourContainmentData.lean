open GRWTSK.NumberTheory.WeilQuadraticForm.RadiusTwoRankFourPaidPacket

def sourceLower (i j : Fin 65) : Int := digit (sourceLowerAt i.val) 160 j.val
def sourceUpper (i j : Fin 65) : Int := digit (sourceUpperAt i.val) 160 j.val

def packetLower (i j : Fin 65) : Int :=
  digit (lowerAt (min i.val j.val)) 116 (max i.val j.val)
def packetUpper (i j : Fin 65) : Int :=
  digit (upperAt (min i.val j.val)) 116 (max i.val j.val)

/-- Exact integer containment after lifting the packet108 grid to grid144. -/
abbrev RowCheck (i : Fin 65) : Prop := ∀ j : Fin 65,
  packetLower i j * (2^36 : Int) ≤ sourceLower i j ∧
    sourceUpper i j ≤ packetUpper i j * (2^36 : Int) ∧
      sourceLower i j ≤ sourceUpper i j

/-- The physical head coordinates and scalar pole in the 65-coordinate grid. -/
def gridIndex : GRWTSK.NumberTheory.WeilQuadraticForm.RadiusTwoCandidateEntries.Head → Fin 65
  | .inl i => ⟨i.val, by have := i.isLt; omega⟩
  | .inr _ => 64

theorem gridIndex_val (i : GRWTSK.NumberTheory.WeilQuadraticForm.RadiusTwoCandidateEntries.Head) :
    (gridIndex i).val =
      GRWTSK.NumberTheory.WeilQuadraticForm.RadiusTwoRankFourPaidPacket.index i := by
  rcases i with i | ⟨⟩ <;> rfl

/-- The stored literal interval; equality to the typed observed recipe is OPEN. -/
def bounds (i j : GRWTSK.NumberTheory.WeilQuadraticForm.RadiusTwoCandidateEntries.Head) :
    GRWTSK.Algebra.LinearAlgebra.RationalRealBounds.Bounds :=
  (GRWTSK.Algebra.LinearAlgebra.FiniteSignDyadicLDL.dyadic 144
      (sourceLower (gridIndex i) (gridIndex j)),
   GRWTSK.Algebra.LinearAlgebra.FiniteSignDyadicLDL.dyadic 144
      (sourceUpper (gridIndex i) (gridIndex j)))

end GRWTSK.NumberTheory.WeilQuadraticForm.RadiusTwoRankFourContainment
