import Mathlib.Algebra.BigOperators.Associated
import Mathlib.NumberTheory.Cyclotomic.PrimitiveRoots
import Mathlib.FieldTheory.IntermediateField.Adjoin.Basic
import Mathlib.RingTheory.OrderOfVanishing.Basic
import Mathlib.RingTheory.Polynomial.Cyclotomic.Eval
import Mathlib.Tactic.FieldSimp

/-!
# The exact tame conductor contribution to the split Selmer bound

For a primitive root of prime-power order, compute the normalized module
length of the quotient by its difference from one. The accompanying note
identifies the order of the actual character on auxiliary inertia.
-/

namespace GRWTSK.NumberTheory.AlpogeTameConductorLength

open Polynomial
open scoped BigOperators

variable {O : Type*} [CommRing O] [IsDomain O]

/-- The principal ideals generated by the cyclotomic value and by the indicated
power agree before passing to any field norm or valuation. -/
theorem associated_cyclotomic_at_one {n : ℕ} [NeZero n] {ζ : O}
    (hζ : IsPrimitiveRoot ζ n) :
    Associated ((1 - ζ) ^ n.totient) (eval 1 (cyclotomic n O)) := by
  classical
  rw [cyclotomic_eq_prod_X_sub_primitiveRoots hζ, eval_prod]
  simp only [eval_sub, eval_X, eval_C]
  have h (z : O) (hz : z ∈ primitiveRoots n O) : Associated (1 - ζ) (1 - z) := by
    have hz' := isPrimitiveRoot_of_mem_primitiveRoots hz
    apply associated_of_dvd_dvd
    · obtain ⟨k, _, hk⟩ := hζ.eq_pow_of_pow_eq_one hz'.pow_eq_one
      exact hk ▸ one_sub_dvd_one_sub_pow ζ k
    · obtain ⟨k, _, hk⟩ := hz'.eq_pow_of_pow_eq_one hζ.pow_eq_one
      exact hk ▸ one_sub_dvd_one_sub_pow z k
  simpa only [Finset.prod_const, hζ.card_primitiveRoots] using
    Associated.prod (primitiveRoots n O) (fun _ => 1 - ζ) (fun z => 1 - z) h

/-- An identity for the actual lengths of the two principal-ideal quotients.
It remains meaningful with extended lengths in an arbitrary domain. -/
theorem totient_mul_length {p k : ℕ} [hp : Fact p.Prime] {ζ : O}
    (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) :
    ((p ^ (k + 1)).totient : ℕ∞) * Module.length O (O ⧸ Ideal.span {ζ - 1}) =
      Module.length O (O ⧸ Ideal.span {(p : O)}) := by
  let : NeZero (p ^ (k + 1)) := ⟨pow_ne_zero _ hp.out.ne_zero⟩
  have h := Ring.ord_eq_of_associated (associated_cyclotomic_at_one hζ)
  rw [eval_one_cyclotomic_prime_pow] at h
  have hζ1 := hζ.ne_one (one_lt_pow₀ hp.out.one_lt (by omega))
  have hreg : 1 - ζ ∈ nonZeroDivisors O := mem_nonZeroDivisors_iff_ne_zero.mpr (sub_ne_zero.mpr hζ1.symm)
  rw [Ring.ord_pow hreg, nsmul_eq_mul, ← neg_sub ζ 1, Ring.ord_neg] at h
  exact h

/-- The quotient length with the normalization of the source coefficient
ring. All positive residue-characteristic powers, including 2, are covered. -/
theorem normalized_length {p k : ℕ} [hp : Fact p.Prime] [CharZero O]
    [IsNoetherianRing O] [Ring.KrullDimLE 1 O] (hpO : ¬ IsUnit (p : O)) {ζ : O}
    (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) :
    ((Module.length O (O ⧸ Ideal.span {ζ - 1})).toNat : ℚ) /
      ((Module.length O (O ⧸ Ideal.span {(p : O)})).toNat : ℚ) =
        1 / ((p ^ (k + 1)).totient : ℚ) := by
  have : Nontrivial (O ⧸ Ideal.span {(p : O)}) :=
    Ideal.Quotient.nontrivial_iff.mpr (fun h => hpO (Ideal.span_singleton_eq_top.mp h))
  have hn : Ring.ord O (p : O) ≠ ⊤ :=
    Ring.ord_ne_top (mem_nonZeroDivisors_iff_ne_zero.mpr (Nat.cast_ne_zero.mpr hp.out.ne_zero))
  have hd := ENat.toNat_pos (Module.length_pos (R := O) (M := O ⧸ Ideal.span {(p : O)})).ne' hn
  have hprod := congrArg ENat.toNat (totient_mul_length hζ)
  simp only [ENat.toNat_mul, ENat.toNat_natCast] at hprod
  rw [div_eq_div_iff (by exact_mod_cast hd.ne') (by exact_mod_cast (Nat.totient_pos.mpr
    (pow_pos hp.out.pos (k + 1))).ne'), one_mul, mul_comm]
  exact_mod_cast hprod

/-- A nontrivial finite cyclic inertia image of p-power order has a generator
whose order is a *positive* prime power. -/
theorem generator_order {G A : Type*} [Group G] [Group A] {p : ℕ} (hp : p.Prime)
    (I : Subgroup G) (φ : G →* A) (γ : G) (htor : ∃ m : ℕ, φ γ ^ (p ^ m) = 1)
    (hcyc : ∀ σ ∈ I, φ σ ∈ Subgroup.zpowers (φ γ))
    (hram : ∃ σ ∈ I, φ σ ≠ 1) : ∃ k : ℕ, orderOf (φ γ) = p ^ (k + 1) := by
  obtain ⟨m, hm⟩ := htor
  obtain ⟨j, _, hj⟩ := (Nat.dvd_prime_pow hp).mp (orderOf_dvd_of_pow_eq_one hm)
  cases j with
  | zero =>
    obtain ⟨σ, hσ, hne⟩ := hram
    have hγ : φ γ = 1 := orderOf_eq_one_iff.mp (by simpa using hj)
    obtain ⟨n, hn⟩ := Subgroup.mem_zpowers_iff.mp (hcyc σ hσ)
    exact (hne (by simpa [hγ] using hn.symm)).elim
  | succ k => exact ⟨k, hj⟩

/-- The normalized conductor infimum is attained at the tame generator. Its
value depends on the order of that inertia image alone. -/
theorem tame_infimum {p k : ℕ} [hp : Fact p.Prime] [CharZero O]
    [IsNoetherianRing O] [Ring.KrullDimLE 1 O] (hpO : ¬ IsUnit (p : O))
    (S : Set O) {ζ : O} (hζ : IsPrimitiveRoot ζ (p ^ (k + 1))) (hmem : ζ ∈ S)
    (hcyc : ∀ z ∈ S, ∃ m : ℕ, ζ ^ m = z) :
    sInf {v : ℝ | ∃ z ∈ S, z ≠ 1 ∧
      v = ((Ring.ord O (z - 1)).toNat : ℝ) / ((Ring.ord O (p : O)).toNat : ℝ)} =
      1 / ((p ^ (k + 1)).totient : ℝ) := by
  let L (z : O) : ℝ := ((Ring.ord O (z - 1)).toNat : ℝ) / ((Ring.ord O (p : O)).toNat : ℝ)
  change sInf {v : ℝ | ∃ z ∈ S, z ≠ 1 ∧ v = L z} = _
  have e : L ζ = 1 / ((p ^ (k + 1)).totient : ℝ) := by
    dsimp [L, Ring.ord]
    simpa only [Rat.cast_div, Rat.cast_one, Rat.cast_natCast] using
      congrArg (fun x : ℚ => (x : ℝ)) (normalized_length hpO hζ)
  rw [← e]
  have hζ1 := hζ.ne_one (one_lt_pow₀ hp.out.one_lt (by omega))
  have hval : L ζ ∈ {v : ℝ | ∃ z ∈ S, z ≠ 1 ∧ v = L z} := ⟨ζ, hmem, hζ1, rfl⟩
  apply le_antisymm (csInf_le ⟨0, ?_⟩ hval) (le_csInf ⟨_, hval⟩ ?_)
  · rintro _ ⟨z, _, _, rfl⟩
    exact div_nonneg (Nat.cast_nonneg _) (Nat.cast_nonneg _)
  · rintro _ ⟨z, hz, hz1, rfl⟩
    obtain ⟨m, hm⟩ := hcyc z hz
    have hd : ζ - 1 ∣ z - 1 := hm ▸ sub_one_dvd_pow_sub_one ζ m
    have hn := Ring.ord_ne_top (mem_nonZeroDivisors_iff_ne_zero.mpr (sub_ne_zero.mpr hz1))
    apply div_le_div_of_nonneg_right _ (Nat.cast_nonneg _)
    exact_mod_cast ENat.toNat_le_toNat (Ring.ord_le_ord_of_dvd hd) hn

/-- In an abelian character of tame inertia, the Frobenius conjugation relation
forces the generator order to divide the residue-field size minus one. -/
theorem order_dvd_residue_sub_one {G A : Type*} [Group G] [CommGroup A]
    (φ : G →* A) (F γ : G) {q : ℕ} (hq : 0 < q)
    (hF : (F * γ * F⁻¹) * (γ ^ q)⁻¹ ∈ φ.ker) : orderOf (φ γ) ∣ q - 1 := by
  obtain ⟨m, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hq.ne'
  apply orderOf_dvd_of_pow_eq_one
  have h := MonoidHom.mem_ker.mp hF
  simp only [map_mul, map_inv, map_pow] at h
  have hc : φ F * φ γ * (φ F)⁻¹ = φ γ := by simp [mul_assoc]
  rw [hc, mul_inv_eq_one] at h
  simpa [pow_succ] using h.symm

/-- A common rationality field must simultaneously carry the joined orders of
all local inertia images. The totient of their least common multiple divides
the degree, including when the same rational prime occurs more than once. -/
theorem simultaneous_order_degree {K ι : Type*} [Field K] [CharZero K] [FiniteDimensional ℚ K]
    (S : Finset ι) (d : ι → ℕ) (hd : ∀ i ∈ S, d i ≠ 0)
    (hroot : ∀ i ∈ S, ∃ x : K, IsPrimitiveRoot x (d i)) :
    (S.lcm d).totient ∣ Module.finrank ℚ K := by
  classical
  have hcombine (T : Finset ι) (hT : ∀ i ∈ T, d i ≠ 0)
      (hr : ∀ i ∈ T, ∃ x : K, IsPrimitiveRoot x (d i)) :
      ∃ z : K, IsPrimitiveRoot z (T.lcm d) := by
    induction T using Finset.induction_on with
    | empty => exact ⟨1, by simp⟩
    | @insert a T ha ih =>
      obtain ⟨x, hx⟩ := hr a (by simp)
      obtain ⟨y, hy⟩ := ih (fun i hi => hT i (Finset.mem_insert_of_mem hi))
        (fun i hi => hr i (Finset.mem_insert_of_mem hi))
      rw [Finset.lcm_insert]
      exact ⟨_, hx.pow_mul_pow_lcm hy (hT a (by simp))
        (Finset.lcm_ne_zero_iff.mpr fun i hi => hT i (Finset.mem_insert_of_mem hi))⟩
  obtain ⟨z, hz⟩ := hcombine S hd hroot
  let : NeZero (S.lcm d) := ⟨Finset.lcm_ne_zero_iff.mpr hd⟩
  let L := IntermediateField.adjoin ℚ ({z} : Set K)
  have : IsCyclotomicExtension {S.lcm d} ℚ L := hz.intermediateField_adjoin_isCyclotomicExtension ℚ
  have hdeg := IsCyclotomicExtension.finrank L (cyclotomic.irreducible_rat (NeZero.pos (S.lcm d)))
  rw [← hdeg]
  exact Module.finrank_dvd_finrank_right ℚ L K

end GRWTSK.NumberTheory.AlpogeTameConductorLength
