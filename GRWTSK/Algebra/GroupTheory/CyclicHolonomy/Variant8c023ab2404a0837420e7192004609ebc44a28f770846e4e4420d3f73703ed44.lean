namespace Surface.Core.CyclicHolonomy

open Surface.Core.CyclicFiberHop

noncomputable section

/-! ## Authoritative data -/

/-- The number of directed steps in one complete circuit of the cover. -/
@[expose]
def cycleLength (h : ℕ+) : ℕ :=
  2 * (h : ℕ)

/-! ## Exact theorems -/

@[surface_novel, surface_published]
theorem cycleLength_pos (h : ℕ+) : 0 < cycleLength h := by
  exact Nat.mul_pos (by norm_num) h.2

/-- The circuit length is exactly the cardinality of the finite phase cover. -/
@[surface_novel, surface_published]
theorem card_coverPhase (h : ℕ+) :
    Fintype.card (CoverPhase h) = cycleLength h := by
  exact ZMod.card (2 * (h : ℕ))

/-! ## Derived maps or views -/

/-- Advance `n` edges from `p`, retaining the winding count in `n`. -/
@[expose]
def advance (h : ℕ+) (p : CoverPhase h) (n : ℕ) : CoverPhase h :=
  p + (n : CoverPhase h)

/-- Iterating the successor permutation is the same as exact finite-phase advance. -/
@[surface_novel, surface_published]
theorem successor_iterate_eq_advance (h : ℕ+) (p : CoverPhase h) (n : ℕ) :
    ((successor h)^[n]) p = advance h p n := by
  induction n generalizing p with
  | zero => simp [advance]
  | succ n ih =>
      rw [Function.iterate_succ_apply, ih]
      simp only [successor_apply, advance, Nat.cast_add, Nat.cast_one]
      abel

@[surface_novel, surface_published, simp]
theorem advance_zero (h : ℕ+) (p : CoverPhase h) :
    advance h p 0 = p := by
  simp [advance]

@[surface_novel, surface_published, simp]
theorem advance_one (h : ℕ+) (p : CoverPhase h) :
    advance h p 1 = successor h p := by
  simp [advance]

@[surface_novel, surface_published]
theorem advance_succ (h : ℕ+) (p : CoverPhase h) (n : ℕ) :
    advance h p (n + 1) = successor h (advance h p n) := by
  simp only [advance, successor_apply, Nat.cast_add, Nat.cast_one]
  abel

@[surface_novel, surface_published]
theorem advance_successor (h : ℕ+) (p : CoverPhase h) (n : ℕ) :
    advance h (successor h p) n = advance h p (n + 1) := by
  rw [advance_succ]
  simp only [advance, successor_apply]
  abel

@[surface_novel, surface_published]
theorem advance_add (h : ℕ+) (p : CoverPhase h) (m n : ℕ) :
    advance h p (m + n) = advance h (advance h p m) n := by
  simp only [advance, Nat.cast_add]
  abel

/-- A full lap returns to the same exact finite phase. -/
@[surface_novel, surface_published, simp]
theorem advance_cycle (h : ℕ+) (p : CoverPhase h) :
    advance h p (cycleLength h) = p := by
  simp [advance, cycleLength]

/--
The phase remembers only the residual edge, even though `forwardProduct`
continues to remember how many full circuits were traversed.
-/
@[surface_novel, surface_published]
theorem advance_mod_cycle (h : ℕ+) (p : CoverPhase h) (n : ℕ) :
    advance h p (n % cycleLength h) = advance h p n := by
  simp only [advance, cycleLength]
  rw [ZMod.natCast_mod]

/-- Advancing by the half-period reaches the exact antipodal phase. -/
@[surface_novel, surface_published, simp]
theorem advance_half (h : ℕ+) (p : CoverPhase h) :
    advance h p (h : ℕ) = antipode h p :=
  rfl

namespace StepSystem

variable {h : ℕ+}

/--
Transport concatenates: first traverse `m` edges from `p`, then traverse `n`
edges from the reached phase.  Keeping the count in `Nat` makes repeated full
circuits, rather than only the residue modulo `cycleLength h`, observable in
the fiber map.
-/
@[surface_novel, surface_published]
theorem forwardProduct_add (system : StepSystem h)
    (p : CoverPhase h) (m n : ℕ) :
    system.forwardProduct p (m + n) =
      (system.forwardProduct p m).trans
        (system.forwardProduct (advance h p m) n) := by
  induction m generalizing p with
  | zero => simp
  | succ m ih =>
      have hcount : m + 1 + n = (m + n) + 1 := by omega
      rw [hcount, system.forwardProduct_succ, system.forwardProduct_succ,
        ih, advance_successor]
      rfl

@[surface_novel, surface_published, simp]
theorem forwardProduct_one (system : StepSystem h) (p : CoverPhase h) :
    system.forwardProduct p 1 = system.step p := by
  change
    (system.step p).trans (LinearEquiv.refl ℝ Fiber3) = system.step p
  rfl

/-- Transport through one complete circuit, based at `p`. -/
@[expose]
def monodromy (system : StepSystem h) (p : CoverPhase h) :
    Fiber3 ≃ₗ[ℝ] Fiber3 :=
  system.forwardProduct p (cycleLength h)

/--
One complete winding followed by `n` more edges applies monodromy before the
residual transport.  This is why replacing the step count by its residue would
discard fiber information.
-/
@[surface_novel, surface_published]
theorem forwardProduct_cycle_add (system : StepSystem h)
    (p : CoverPhase h) (n : ℕ) :
    system.forwardProduct p (cycleLength h + n) =
      (monodromy system p).trans (system.forwardProduct p n) := by
  rw [forwardProduct_add, advance_cycle]
  rfl

/-- The cyclic holonomy subgroup generated by the based monodromy. -/
@[expose]
def holonomyGroupAt (system : StepSystem h) (p : CoverPhase h) :
    Subgroup (Fiber3 ≃ₗ[ℝ] Fiber3) :=
  Subgroup.zpowers (monodromy system p)

/--
Membership records the exact scope of this one-loop model: every holonomy
element is an integral power of one monodromy generator.  No noncyclic
generation claim is made.
-/
@[surface_novel, surface_published]
theorem mem_holonomyGroupAt_iff (system : StepSystem h)
    (p : CoverPhase h) (g : Fiber3 ≃ₗ[ℝ] Fiber3) :
    g ∈ holonomyGroupAt system p ↔
      ∃ k : ℤ, monodromy system p ^ k = g := by
  exact Subgroup.mem_zpowers_iff

/-! ## Reduction to a specified structure group -/

/-- Every local transport step lies in the selected linear subgroup. -/
@[expose]
def StepsInSubgroup (system : StepSystem h)
    (G : Subgroup (Fiber3 ≃ₗ[ℝ] Fiber3)) : Prop :=
  ∀ p, system.step p ∈ G

/-- A structure-group reduction contains every finite forward transport. -/
@[surface_novel, surface_published]
theorem forwardProduct_mem_subgroup (system : StepSystem h)
    (G : Subgroup (Fiber3 ≃ₗ[ℝ] Fiber3))
    (hG : StepsInSubgroup system G) (p : CoverPhase h) (n : ℕ) :
    system.forwardProduct p n ∈ G := by
  induction n generalizing p with
  | zero =>
      exact G.one_mem
  | succ n ih =>
      rw [system.forwardProduct_succ, ← LinearEquiv.mul_eq_trans]
      exact G.mul_mem (ih (p := successor h p)) (hG p)

/-- In particular, one complete circuit has monodromy in the chosen subgroup. -/
@[surface_novel, surface_published]
theorem monodromy_mem_subgroup (system : StepSystem h)
    (G : Subgroup (Fiber3 ≃ₗ[ℝ] Fiber3))
    (hG : StepsInSubgroup system G) (p : CoverPhase h) :
    monodromy system p ∈ G :=
  forwardProduct_mem_subgroup system G hG p (cycleLength h)

/-- Transport intertwines the monodromies based at its two endpoints. -/
@[surface_novel, surface_published]
theorem transport_intertwines_monodromy (system : StepSystem h)
    (p : CoverPhase h) (n : ℕ) :
    (system.forwardProduct p n).trans
        (monodromy system (advance h p n)) =
      (monodromy system p).trans (system.forwardProduct p n) := by
  unfold monodromy
  calc
    (system.forwardProduct p n).trans
        (system.forwardProduct (advance h p n) (cycleLength h)) =
        system.forwardProduct p (n + cycleLength h) :=
      (forwardProduct_add system p n (cycleLength h)).symm
    _ = system.forwardProduct p (cycleLength h + n) := by
      rw [Nat.add_comm]
    _ = (system.forwardProduct p (cycleLength h)).trans
        (system.forwardProduct (advance h p (cycleLength h)) n) :=
      forwardProduct_add system p (cycleLength h) n
    _ = (system.forwardProduct p (cycleLength h)).trans
        (system.forwardProduct p n) := by
      rw [advance_cycle]

/--
Changing base phase conjugates monodromy by the transport between basepoints.
Thus its conjugacy class, rather than its literal matrix, is basepoint
independent.
-/
@[surface_novel, surface_published]
theorem monodromy_advance_eq_conjugate (system : StepSystem h)
    (p : CoverPhase h) (n : ℕ) :
    monodromy system (advance h p n) =
      (system.forwardProduct p n).symm.trans
        ((monodromy system p).trans (system.forwardProduct p n)) := by
  apply LinearEquiv.ext
  intro x
  have hintertwine := LinearEquiv.congr_fun
    (transport_intertwines_monodromy system p n)
    ((system.forwardProduct p n).symm x)
  simpa using hintertwine

/-- The adjacent-basepoint form of monodromy conjugacy. -/
@[surface_novel, surface_published]
theorem monodromy_successor_eq_conjugate (system : StepSystem h)
    (p : CoverPhase h) :
    monodromy system (successor h p) =
      (system.step p).symm.trans
        ((monodromy system p).trans (system.step p)) := by
  simpa using (monodromy_advance_eq_conjugate system p 1)

/--
Membership of the based monodromy in a chosen gauge subgroup propagates across
one edge whenever that edge transport normalizes the subgroup.  The order in
the normalizer expression is forced by the linear-equivalence group law:
`f * g = g.trans f`, so the displayed transport conjugacy is
`step * monodromy * step⁻¹` as a group product.
-/
@[surface_novel, surface_published]
theorem monodromy_successor_mem_of_mem_normalizer (system : StepSystem h)
    (G : Subgroup (Fiber3 ≃ₗ[ℝ] Fiber3)) (p : CoverPhase h)
    (hmonodromy : monodromy system p ∈ G)
    (hstep : system.step p ∈ Subgroup.normalizer G) :
    monodromy system (successor h p) ∈ G := by
  have hconjugate :
      system.step p * monodromy system p * (system.step p)⁻¹ ∈ G :=
    (Subgroup.mem_normalizer_iff.mp hstep (monodromy system p)).mp hmonodromy
  have hinv : (system.step p)⁻¹ = (system.step p).symm := rfl
  rw [hinv] at hconjugate
  rw [monodromy_successor_eq_conjugate]
  simpa only [← LinearEquiv.mul_eq_trans] using hconjugate

/--
For a normal gauge subgroup, monodromy membership is automatically stable
under an adjacent change of base phase; no separate normalizer witness is
needed for the local transport.
-/
@[surface_novel, surface_published]
theorem monodromy_successor_mem_of_normal (system : StepSystem h)
    (G : Subgroup (Fiber3 ≃ₗ[ℝ] Fiber3)) [G.Normal] (p : CoverPhase h)
    (hmonodromy : monodromy system p ∈ G) :
    monodromy system (successor h p) ∈ G := by
  apply monodromy_successor_mem_of_mem_normalizer system G p hmonodromy
  rw [Subgroup.normalizer_eq_top G]
  exact Subgroup.mem_top _

/-- A fiber closes after one circuit exactly when monodromy fixes it. -/
@[expose]
def ClosesAfterCircuit (system : StepSystem h)
    (p : CoverPhase h) (x : Fiber3) : Prop :=
  system.forwardProduct p (cycleLength h) x = x

@[surface_novel, surface_published]
theorem closesAfterCircuit_iff_monodromy_fixed (system : StepSystem h)
    (p : CoverPhase h) (x : Fiber3) :
    ClosesAfterCircuit system p x ↔ monodromy system p x = x :=
  Iff.rfl

/-! ## Globally compatible sections -/

/-- A section whose value on every successor fiber is its local parallel transport. -/
@[expose]
def IsParallelSection (system : StepSystem h) (value : Section3 h) : Prop :=
  ∀ p, system.step p (value p) = value (successor h p)

/-- A parallel section is obtained at every phase by transporting its initial value. -/
@[surface_novel, surface_published]
theorem forwardProduct_apply_of_isParallelSection (system : StepSystem h)
    {value : Section3 h} (hvalue : IsParallelSection system value)
    (p : CoverPhase h) (n : ℕ) :
    system.forwardProduct p n (value p) = value (advance h p n) := by
  induction n generalizing p with
  | zero => simp
  | succ n ih =>
      rw [system.forwardProduct_succ, LinearEquiv.trans_apply, hvalue p,
        ih, advance_successor]

/-- Consequently, every value of a global parallel section is fixed by one-lap monodromy. -/
@[surface_novel, surface_published]
theorem isParallelSection_closesAfterCircuit (system : StepSystem h)
    {value : Section3 h} (hvalue : IsParallelSection system value)
    (p : CoverPhase h) :
    ClosesAfterCircuit system p (value p) := by
  rw [ClosesAfterCircuit,
    forwardProduct_apply_of_isParallelSection system hvalue, advance_cycle]

/-- Transport through the first half of a circuit. -/
@[expose]
def halfTransport (system : StepSystem h) (p : CoverPhase h) :
    Fiber3 ≃ₗ[ℝ] Fiber3 :=
  system.forwardProduct p (h : ℕ)

/--
Half-period compatibility makes the two half-circuit products equal, so the
full monodromy is the square (self-composition) of the first-half transport.
This square need not be the identity.

Because `Fiber3` is real, this algebraic square alone does not say that every
*real* eigenvalue of monodromy is the square of a real eigenvalue of the half
transport: a real operator may have nonreal conjugate eigenvalues whose squares
are real and negative.  The exact square-image statement belongs to the
complexified spectrum and requires an additional complexification/spectral-
mapping layer; it is deliberately not asserted here.
-/
@[surface_novel, surface_published]
theorem monodromy_eq_halfTransport_trans_self (system : StepSystem h)
    (p : CoverPhase h) :
    monodromy system p =
      (halfTransport system p).trans (halfTransport system p) := by
  unfold monodromy halfTransport cycleLength
  have hdouble : 2 * (h : ℕ) = (h : ℕ) + (h : ℕ) := by omega
  rw [hdouble, forwardProduct_add, advance_half,
    system.forwardProduct_half_compatible]

/-! ## Exact decomposition into complete laps and a residual arc -/

/--
The Euclidean-division data for an arbitrary natural step count.  The
residual arc is strictly shorter than one complete circuit.
-/
structure PathDecomposition (h : ℕ+) where
  laps : ℕ
  residual : ℕ
  residual_lt_cycle : residual < cycleLength h

/-- Split a step count into its number of complete laps and residual arc. -/
@[expose]
def decomposeSteps (h : ℕ+) (n : ℕ) : PathDecomposition h where
  laps := n / cycleLength h
  residual := n % cycleLength h
  residual_lt_cycle := Nat.mod_lt n (cycleLength_pos h)

/-- Euclidean division reconstructs the original natural step count exactly. -/
@[surface_novel, surface_published]
theorem decomposeSteps_recompose (h : ℕ+) (n : ℕ) :
    (decomposeSteps h n).laps * cycleLength h +
        (decomposeSteps h n).residual = n := by
  simpa [decomposeSteps, Nat.mul_comm] using
    (Nat.div_add_mod n (cycleLength h))

/--
`q` complete circuits act first as the `q`th power of based monodromy; the
remaining `n` edges then act from the same base phase.  The explicit `.trans`
orientation matters: for linear equivalences, `f.trans g` applies `f` and
then `g`, whereas the group multiplication convention satisfies
`f * g = g.trans f`.
-/
@[surface_novel, surface_published]
theorem forwardProduct_laps_add (system : StepSystem h)
    (p : CoverPhase h) (q n : ℕ) :
    system.forwardProduct p (q * cycleLength h + n) =
      (monodromy system p ^ q).trans (system.forwardProduct p n) := by
  induction q with
  | zero =>
      simp only [zero_mul, zero_add, pow_zero]
      change system.forwardProduct p n =
        (LinearEquiv.refl ℝ Fiber3).trans (system.forwardProduct p n)
      exact (LinearEquiv.refl_trans _).symm
  | succ q ih =>
      have hcount :
          (q + 1) * cycleLength h + n =
            cycleLength h + (q * cycleLength h + n) := by
        rw [Nat.add_mul, one_mul]
        omega
      rw [hcount, forwardProduct_cycle_add, ih, pow_succ,
        LinearEquiv.mul_eq_trans]
      exact LinearEquiv.trans_assoc _ _ _ |>.symm

/--
Every unbounded natural-step transport is exactly a power of one-lap
monodromy followed by a uniquely bounded residual transport.  Thus reducing
the phase modulo the circuit length loses no information once the lap count
is retained in the monodromy exponent.
-/
@[surface_novel, surface_published]
theorem forwardProduct_decomposition (system : StepSystem h)
    (p : CoverPhase h) (n : ℕ) :
    system.forwardProduct p n =
      (monodromy system p ^ (decomposeSteps h n).laps).trans
        (system.forwardProduct p (decomposeSteps h n).residual) := by
  conv_lhs =>
    rw [← decomposeSteps_recompose h n]
  exact forwardProduct_laps_add system p
    (decomposeSteps h n).laps (decomposeSteps h n).residual

/-! ## A bounded view of one displayed lap -/

/--
Indices for a displayed lap.  The upper `+ 1` is essential: it includes the
completed circuit at index `cycleLength h`, not merely its preceding edges.
-/
abbrev OneLapIndex (h : ℕ+) :=
  Fin (cycleLength h + 1)

/-- The initial endpoint of the bounded one-lap view. -/
@[expose]
def oneLapStart (h : ℕ+) : OneLapIndex h :=
  ⟨0, Nat.succ_pos _⟩

/-- The completed-circuit endpoint of the bounded one-lap view. -/
@[expose]
def oneLapEnd (h : ℕ+) : OneLapIndex h :=
  ⟨cycleLength h, Nat.lt_succ_self _⟩

/-- Phase displayed at a bounded one-lap index. -/
@[expose]
def oneLapPhase (p : CoverPhase h) (i : OneLapIndex h) : CoverPhase h :=
  advance h p i

/-- Fiber transport displayed at a bounded one-lap index. -/
@[expose]
def oneLapProduct (system : StepSystem h)
    (p : CoverPhase h) (i : OneLapIndex h) : Fiber3 ≃ₗ[ℝ] Fiber3 :=
  system.forwardProduct p i

@[surface_novel, surface_published, simp]
theorem oneLapPhase_start (p : CoverPhase h) :
    oneLapPhase p (oneLapStart h) = p := by
  simp [oneLapPhase, oneLapStart]

@[surface_novel, surface_published, simp]
theorem oneLapPhase_end (p : CoverPhase h) :
    oneLapPhase p (oneLapEnd h) = p := by
  simp [oneLapPhase, oneLapEnd]

@[surface_novel, surface_published, simp]
theorem oneLapProduct_start (system : StepSystem h) (p : CoverPhase h) :
    oneLapProduct system p (oneLapStart h) = LinearEquiv.refl ℝ Fiber3 := by
  rfl

@[surface_novel, surface_published, simp]
theorem oneLapProduct_end (system : StepSystem h) (p : CoverPhase h) :
    oneLapProduct system p (oneLapEnd h) = monodromy system p := by
  rfl

/-! ## Payload-preserving transport views

These views attach an arbitrary payload to a fiber path without assigning the
payload any holonomy meaning.  The closed-path condition remains exactly the
one used by `monodromy`; an arbitrary external stream is not promoted to
monodromy by carrying a tag.
-/

/-- Carry a payload unchanged through a finite forward product. -/
@[expose]
def forwardProductWithPayload {Payload : Type*} (system : StepSystem h)
    (p : CoverPhase h) (n : ℕ) : Fiber3 × Payload ≃ Fiber3 × Payload :=
  LinearEquiv.withPayload (Payload := Payload) (system.forwardProduct p n)

@[surface_novel, surface_published]
theorem forwardProduct_preserves_payload {Payload : Type*}
    (system : StepSystem h) (p : CoverPhase h) (n : ℕ)
    (value : Fiber3 × Payload) :
    (forwardProductWithPayload system p n value).2 = value.2 :=
  rfl

/-- Carry a payload unchanged through the based one-circuit monodromy. -/
@[expose]
def monodromyWithPayload {Payload : Type*} (system : StepSystem h)
    (p : CoverPhase h) : Fiber3 × Payload ≃ Fiber3 × Payload :=
  LinearEquiv.withPayload (Payload := Payload) (monodromy system p)

@[surface_novel, surface_published]
theorem monodromy_preserves_payload {Payload : Type*}
    (system : StepSystem h) (p : CoverPhase h)
    (value : Fiber3 × Payload) :
    (monodromyWithPayload system p value).2 = value.2 :=
  rfl

/-! ## Authority boundary / non-claims

The payload lift adds no closed-path evidence.  Only `monodromy` at the stated
one-circuit endpoint has the holonomy interpretation proved in this module.
-/

end StepSystem

end

