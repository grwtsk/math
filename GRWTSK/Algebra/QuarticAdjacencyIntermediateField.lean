import GRWTSK.Algebra.QuarticGaloisKernel

/-!
# Quartic resolvent adjacency intermediate field

SOURCE_DRAFT / NOT_RUN / NOT_KERNEL_AUDITED.

The subfield generated over K by the three actual adjacency values is
a mathematically defined intermediate field. Its pointwise stabilizer
is precisely the set of K-algebra automorphisms fixing those values.
This uses the universal property of Algebra.adjoin, not an unproved
Galois correspondence or a claim that the automorphism group is S₄.
-/

namespace GRWTSK.Algebra.QuarticAdjacencyIntermediateField

open Polynomial
open GRWTSK.Algebra.QuarticMatchingAction
open GRWTSK.Algebra.QuarticMatchingAdjacency
open GRWTSK.Algebra.QuarticGaloisKernel
open GRWTSK.Algebra.PolygonalQuarticSplitting

noncomputable section
variable {K L : Type*} [Field K] [Field L] [Algebra K L]

/-- The actual three adjacency values associated with an enumerated
quartic, without asserting that the chosen enumeration is canonical. -/
def adjacencyValueSet (e : QuarticRootEnumeration (L := L) p) : Set L :=
  Set.range (complementaryAdjacency e.r)

/-- The K-subfield generated by the three adjacency values. -/
def adjacencyField (p : K[X]) (e : QuarticRootEnumeration (L := L) p) :
    IntermediateField K L :=
  IntermediateField.adjoin K (adjacencyValueSet e)

/-- A base-field automorphism fixes the generated intermediate field
pointwise if and only if it fixes its three explicit generators. -/
theorem fixes_adjacencyField_iff
    (p : K[X]) (e : QuarticRootEnumeration (L := L) p)
    (φ : L ≃ₐ[K] L) :
    (∀ x : adjacencyField p e, φ x.1 = x.1) ↔
      ∀ m : PerfectMatching,
        φ (complementaryAdjacency e.r m) =
          complementaryAdjacency e.r m := by
  constructor
  · intro h m
    exact h ⟨complementaryAdjacency e.r m,
      IntermediateField.subset_adjoin ⟨m, rfl⟩⟩
  · intro h
    have hg : ∀ x ∈ adjacencyValueSet e, φ x = x := by
      rintro x ⟨m, rfl⟩
      exact h m
    intro x
    have hfix : ∀ y ∈ IntermediateField.adjoin K (adjacencyValueSet e),
        φ y = y := by
      apply IntermediateField.adjoin_induction
      · exact hg
      · intro y
        simp
      · intro x y hx hy
        simp [hx, hy]
      · intro x y hx hy
        simp [hx, hy]
      · intro x hx
        simp [hx]
      · intro x hx
        simp [hx]
    exact hfix x.1 x.2

/-- The stabilizer of the generated field is the preimage of the
explicit V4 kernel, assuming four distinct quartic roots. -/
theorem fixes_adjacencyField_iff_double_transposition
    (p : K[X]) (e : QuarticRootEnumeration (L := L) p)
    (hne : p ≠ 0) (he : Function.Injective e.r)
    (φ : L ≃ₐ[K] L) :
    (∀ x : adjacencyField p e, φ x.1 = x.1) ↔
      GRWTSK.Algebra.QuarticGaloisMatching.actualRootPerm p e hne he φ = 1 ∨
      GRWTSK.Algebra.QuarticGaloisMatching.actualRootPerm p e hne he φ =
        double01_23 ∨
      GRWTSK.Algebra.QuarticGaloisMatching.actualRootPerm p e hne he φ =
        double02_13 ∨
      GRWTSK.Algebra.QuarticGaloisMatching.actualRootPerm p e hne he φ =
        double03_12 := by
  rw [fixes_adjacencyField_iff p e φ]
  exact automorphism_fixes_all_adjacencies_iff_double_transposition p e hne he φ

end
end GRWTSK.Algebra.QuarticAdjacencyIntermediateField
