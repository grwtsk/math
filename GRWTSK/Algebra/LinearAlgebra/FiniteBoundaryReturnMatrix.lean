import GRWTSK.Algebra.LinearAlgebra.FiniteBoundaryReturn
import Mathlib.LinearAlgebra.Matrix.ToLin

set_option autoImplicit false

/-!
# Coordinate realization of a typed finite boundary return

The input and output boundary index types may be different.  Descent and
return are separately specified rectangular real matrices, transported to
actual linear maps using Mathlib's canonical finite coordinate constructor.
The coordinate identity is an equality of the *whole operator*, not an
agreement of a finite set of eigenvalue approximations.

This does not construct a geometric boundary gluing or a zeta realization.
-/

namespace GRWTSK.Algebra.LinearAlgebra.FiniteBoundaryReturn

open GRWTSK.Algebra.LinearAlgebra.FramedFiberPort

universe u v

variable {I : Type u} {J : Type v}
variable [Fintype I] [DecidableEq I] [Fintype J] [DecidableEq J]

namespace System

/-- Realize the existing endpoint-typed `System` from exactly four chosen
matrices; no endpoint operator or return map is generated by descent. -/
def ofMatrices (D : Matrix J I ℝ) (R : Matrix I J ℝ)
    (A : Matrix I I ℝ) (B : Matrix J J ℝ) :
    System (I → ℝ) (J → ℝ) where
  descent := D.mulVecLin
  boundaryReturn := R.mulVecLin
  inputOperator := A.mulVecLin
  outputOperator := B.mulVecLin

/-- The existing linear return operator is exactly the rectangular matrix
product, with boundaryReturn on the left of descent. -/
theorem ofMatrices_return_operator
    (D : Matrix J I ℝ) (R : Matrix I J ℝ)
    (A : Matrix I I ℝ) (B : Matrix J J ℝ) :
    (ofMatrices D R A B).returnOperator = (R * D).mulVecLin := by
  change (R.mulVecLin).comp D.mulVecLin = (R * D).mulVecLin
  exact (Matrix.mulVecLin_mul R D).symm

/-- Recover every entry of the chosen finite return from its actual typed
operator. The finite input basis and both endpoint types are explicit. -/
theorem ofMatrices_return_toMatrix
    (D : Matrix J I ℝ) (R : Matrix I J ℝ)
    (A : Matrix I I ℝ) (B : Matrix J J ℝ) :
    LinearMap.toMatrix' (ofMatrices D R A B).returnOperator = R * D := by
  rw [ofMatrices_return_operator]
  change LinearMap.toMatrix' (Matrix.toLin' (R * D)) = R * D
  exact LinearMap.toMatrix'_toLin' (R * D)

/-- Pointwise source-to-coordinate equality; no information is discarded
by matching just traces, eigenvalues, or two moments. -/
theorem ofMatrices_return_entry
    (D : Matrix J I ℝ) (R : Matrix I J ℝ)
    (A : Matrix I I ℝ) (B : Matrix J J ℝ)
    (i j : I) :
    (ofMatrices D R A B).returnOperator (Pi.single j 1) i =
      (R * D) i j := by
  have h := congrArg (fun M : Matrix I I ℝ => M i j)
    (ofMatrices_return_toMatrix D R A B)
  simpa only [LinearMap.toMatrix'_apply] using h

/-- Whole-vector correspondence for the chosen real boundary coordinates. -/
theorem ofMatrices_return_apply
    (D : Matrix J I ℝ) (R : Matrix I J ℝ)
    (A : Matrix I I ℝ) (B : Matrix J J ℝ) (x : I → ℝ) :
    (ofMatrices D R A B).returnOperator x = (R * D) *ᵥ x := by
  rw [ofMatrices_return_operator]
  exact Matrix.mulVecLin_apply (R * D) x

/-- The matrix identities are the *actual* obligations for descent and
return to intertwine their endpoint operators. -/
theorem ofMatrices_return_intertwines
    (D : Matrix J I ℝ) (R : Matrix I J ℝ)
    (A : Matrix I I ℝ) (B : Matrix J J ℝ)
    (hD : D * A = B * D) (hR : R * B = A * R) :
    Intertwines (ofMatrices D R A B).returnOperator
      (ofMatrices D R A B).inputOperator
      (ofMatrices D R A B).inputOperator := by
  have hd : Intertwines D.mulVecLin A.mulVecLin B.mulVecLin := by
    unfold Intertwines
    rw [← Matrix.mulVecLin_mul, ← Matrix.mulVecLin_mul, hD]
  have hr : Intertwines R.mulVecLin B.mulVecLin A.mulVecLin := by
    unfold Intertwines
    rw [← Matrix.mulVecLin_mul, ← Matrix.mulVecLin_mul, hR]
  exact (ofMatrices D R A B).return_intertwines hd hr

end System

end GRWTSK.Algebra.LinearAlgebra.FiniteBoundaryReturn
