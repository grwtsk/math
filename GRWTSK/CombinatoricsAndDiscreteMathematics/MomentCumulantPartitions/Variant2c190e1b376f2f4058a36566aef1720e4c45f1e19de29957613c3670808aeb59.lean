import FormalResearch.PositiveAtlas.FiniteFourthCumulant
import Mathlib.Order.Partition.Finpartition

/-!
# Finite moment-cumulant partition combinatorics

The finite log-affine calculations through order four show that higher cumulants
must be organized by set partitions rather than by raw centered moments.

This module supplies the combinatorial layer independently of any analytic
model.  For a positive order n, partitions are Mathlib finpartitions of Fin n.
A block functional kappa assigns a value to every nonempty block.  The weight
of a partition is the product of the block values, and the associated moment is
the sum of those products over all partitions.

The distinguished one-block partition is isolated explicitly.  This gives the
recursive moment-cumulant equation

  kappa([n]) = moment_n - sum_{proper partitions pi} prod_{B in pi} kappa(B).

This is the algebraic recursion required after the corrected fourth-cumulant
theorem.  No analytic all-orders derivative theorem is asserted here.
-/


namespace GRWTSK.CombinatoricsAndDiscreteMathematics.DirectionPartition.Variant9cd7dbc6514f48a10ca4fae0c859d4bd77cb1324d836751b815b7f401e2c6d51

namespace FormalResearch.PositiveAtlas

universe u

/-- Set partitions of n labelled directions. -/
abbrev DirectionPartition (n : ℕ) :=
  Finpartition (Finset.univ : Finset (Fin n))

namespace MomentCumulant

variable {R : Type u} [CommRing R]

/-- The distinguished one-block partition of Fin n, for positive n. -/
def oneBlockPartition (n : ℕ) (hn : 0 < n) : DirectionPartition n := by
  letI : Nonempty (Fin n) := Fin.pos_iff_nonempty.mp hn
  exact Finpartition.indiscrete Finset.univ_nonempty.ne_empty

@[simp]
theorem oneBlockPartition_parts
    (n : ℕ) (hn : 0 < n) :
    (oneBlockPartition n hn).parts =
      {(Finset.univ : Finset (Fin n))} := by
  let : Nonempty (Fin n) := Fin.pos_iff_nonempty.mp hn
  rfl

/-- Product of block cumulant values along one partition. -/
def partitionWeight
    {n : ℕ}
    (κ : Finset (Fin n) → R)
    (P : DirectionPartition n) : R :=
  ∏ B ∈ P.parts, κ B

/-- Sum of partition weights over all set partitions.  This is the abstract
moment generated by the block functional κ. -/
def partitionMoment
    (n : ℕ)
    (κ : Finset (Fin n) → R) : R :=
  ∑ P : DirectionPartition n, partitionWeight κ P

/-- All partitions except the distinguished one-block partition. -/
def properPartitions
    (n : ℕ) (hn : 0 < n) :
    Finset (DirectionPartition n) :=
  Finset.univ.erase (oneBlockPartition n hn)

/-- Contribution of all proper partitions. -/
def properPartitionContribution
    (n : ℕ) (hn : 0 < n)
    (κ : Finset (Fin n) → R) : R :=
  ∑ P ∈ properPartitions n hn, partitionWeight κ P

@[simp]
theorem partitionWeight_oneBlock
    (n : ℕ) (hn : 0 < n)
    (κ : Finset (Fin n) → R) :
    partitionWeight κ (oneBlockPartition n hn) =
      κ (Finset.univ : Finset (Fin n)) := by
  simp [partitionWeight, oneBlockPartition_parts]

/-- The partition moment splits into its one-block term and all proper
partition contributions. -/
theorem partitionMoment_eq_oneBlock_add_proper
    (n : ℕ) (hn : 0 < n)
    (κ : Finset (Fin n) → R) :
    partitionMoment n κ =
      κ (Finset.univ : Finset (Fin n)) +
        properPartitionContribution n hn κ := by
  classical
  unfold partitionMoment properPartitionContribution properPartitions
  have hmem :
      oneBlockPartition n hn ∈
        (Finset.univ : Finset (DirectionPartition n)) :=
    Finset.mem_univ _
  calc
    (∑ P : DirectionPartition n, partitionWeight κ P)
        =
      (∑ P ∈
          (Finset.univ : Finset (DirectionPartition n)).erase
            (oneBlockPartition n hn),
          partitionWeight κ P) +
        partitionWeight κ (oneBlockPartition n hn) := by
          symm
          exact Finset.sum_erase_add _ _ hmem
    _ =
      κ (Finset.univ : Finset (Fin n)) +
        (∑ P ∈
          (Finset.univ : Finset (DirectionPartition n)).erase
            (oneBlockPartition n hn),
          partitionWeight κ P) := by
          rw [partitionWeight_oneBlock]
          ac_rfl

/-- A proper partition cannot contain the full block. -/
theorem univ_not_mem_of_mem_properPartitions
    (n : ℕ) (hn : 0 < n)
    {P : DirectionPartition n}
    (hP : P ∈ properPartitions n hn) :
    (Finset.univ : Finset (Fin n)) ∉ P.parts := by
  intro hfull
  have hEq : P = oneBlockPartition n hn := by
    apply le_antisymm
    · intro B hB
      refine ⟨(Finset.univ : Finset (Fin n)), ?_, P.le hB⟩
      simp [oneBlockPartition_parts]
    · intro B hB
      have hBu : B = (Finset.univ : Finset (Fin n)) := by
        simpa [oneBlockPartition_parts] using hB
      subst B
      exact ⟨(Finset.univ : Finset (Fin n)), hfull, le_rfl⟩
  exact (Finset.mem_erase.mp hP).1 hEq

/-- Partition weights agree on a proper partition when the block functionals
agree away from the full block. -/
theorem partitionWeight_congr_of_proper
    (n : ℕ) (hn : 0 < n)
    {κ₁ κ₂ : Finset (Fin n) → R}
    {P : DirectionPartition n}
    (hP : P ∈ properPartitions n hn)
    (hκ :
      ∀ B : Finset (Fin n),
        B ≠ (Finset.univ : Finset (Fin n)) →
          κ₁ B = κ₂ B) :
    partitionWeight κ₁ P = partitionWeight κ₂ P := by
  unfold partitionWeight
  apply Finset.prod_congr rfl
  intro B hB
  apply hκ B
  intro hBu
  subst B
  exact (univ_not_mem_of_mem_properPartitions n hn hP) hB

/-- Proper-partition contributions depend only on proper-block values. -/
theorem properPartitionContribution_congr
    (n : ℕ) (hn : 0 < n)
    {κ₁ κ₂ : Finset (Fin n) → R}
    (hκ :
      ∀ B : Finset (Fin n),
        B ≠ (Finset.univ : Finset (Fin n)) →
          κ₁ B = κ₂ B) :
    properPartitionContribution n hn κ₁ =
      properPartitionContribution n hn κ₂ := by
  unfold properPartitionContribution
  apply Finset.sum_congr rfl
  intro P hP
  exact partitionWeight_congr_of_proper n hn hP hκ

/-- Replace only the full-block value of a block functional. -/
def withOneBlockValue
    (n : ℕ)
    (value : R)
    (κ : Finset (Fin n) → R) :
    Finset (Fin n) → R :=
  fun B =>
    if B = (Finset.univ : Finset (Fin n)) then value else κ B

omit [CommRing R] in
@[simp]
theorem withOneBlockValue_univ
    (n : ℕ) (value : R)
    (κ : Finset (Fin n) → R) :
    withOneBlockValue n value κ
        (Finset.univ : Finset (Fin n)) =
      value := by
  simp [withOneBlockValue]

omit [CommRing R] in
theorem withOneBlockValue_of_ne_univ
    (n : ℕ) (value : R)
    (κ : Finset (Fin n) → R)
    {B : Finset (Fin n)}
    (hB : B ≠ (Finset.univ : Finset (Fin n))) :
    withOneBlockValue n value κ B = κ B := by
  simp [withOneBlockValue, hB]

/-- Replacing the one-block value leaves every proper-partition contribution
unchanged. -/
theorem properPartitionContribution_withOneBlockValue
    (n : ℕ) (hn : 0 < n)
    (value : R)
    (κ : Finset (Fin n) → R) :
    properPartitionContribution n hn
        (withOneBlockValue n value κ) =
      properPartitionContribution n hn κ := by
  apply properPartitionContribution_congr n hn
  intro B hB
  exact withOneBlockValue_of_ne_univ n value κ hB

/-- The one-block cumulant isolated from a prescribed moment and all proper
partition contributions. -/
def isolatedOneBlockCumulant
    (n : ℕ) (hn : 0 < n)
    (moment : R)
    (κ : Finset (Fin n) → R) : R :=
  moment - properPartitionContribution n hn κ

/-- Exact recursive isolation of the one-block cumulant. -/
theorem partitionMoment_eq_iff_oneBlock_eq_isolated
    (n : ℕ) (hn : 0 < n)
    (moment : R)
    (κ : Finset (Fin n) → R) :
    partitionMoment n κ = moment ↔
      κ (Finset.univ : Finset (Fin n)) =
        isolatedOneBlockCumulant n hn moment κ := by
  rw [partitionMoment_eq_oneBlock_add_proper n hn,
    isolatedOneBlockCumulant]
  constructor
  · intro h
    exact (eq_sub_iff_add_eq).2 h
  · intro h
    exact (eq_sub_iff_add_eq).1 h

/-- Predicate expressing the finite moment-cumulant relation at one order. -/
def SatisfiesMomentCumulantRelation
    (n : ℕ)
    (moment : R)
    (κ : Finset (Fin n) → R) : Prop :=
  partitionMoment n κ = moment

/-- A moment-cumulant relation is equivalent to the recursive one-block
isolation formula. -/
theorem satisfies_iff_recursive_isolation
    (n : ℕ) (hn : 0 < n)
    (moment : R)
    (κ : Finset (Fin n) → R) :
    SatisfiesMomentCumulantRelation n moment κ ↔
      κ (Finset.univ : Finset (Fin n)) =
        isolatedOneBlockCumulant n hn moment κ :=
  partitionMoment_eq_iff_oneBlock_eq_isolated n hn moment κ

/-- Replace the one-block value by the recursively isolated cumulant. -/
def recursiveCumulantUpdate
    (n : ℕ) (hn : 0 < n)
    (moment : R)
    (κ : Finset (Fin n) → R) :
    Finset (Fin n) → R :=
  withOneBlockValue n
    (isolatedOneBlockCumulant n hn moment κ) κ

@[simp]
theorem recursiveCumulantUpdate_univ
    (n : ℕ) (hn : 0 < n)
    (moment : R)
    (κ : Finset (Fin n) → R) :
    recursiveCumulantUpdate n hn moment κ
        (Finset.univ : Finset (Fin n)) =
      isolatedOneBlockCumulant n hn moment κ := by
  simp [recursiveCumulantUpdate]

/-- Recursive one-block replacement leaves all proper-partition contributions
unchanged. -/
theorem properPartitionContribution_recursiveCumulantUpdate
    (n : ℕ) (hn : 0 < n)
    (moment : R)
    (κ : Finset (Fin n) → R) :
    properPartitionContribution n hn
        (recursiveCumulantUpdate n hn moment κ) =
      properPartitionContribution n hn κ := by
  exact properPartitionContribution_withOneBlockValue
    n hn (isolatedOneBlockCumulant n hn moment κ) κ

/-- The recursive update satisfies the moment-cumulant relation exactly. -/
theorem recursiveCumulantUpdate_satisfies
    (n : ℕ) (hn : 0 < n)
    (moment : R)
    (κ : Finset (Fin n) → R) :
    SatisfiesMomentCumulantRelation n moment
      (recursiveCumulantUpdate n hn moment κ) := by
  rw [satisfies_iff_recursive_isolation n hn]
  rw [recursiveCumulantUpdate_univ]
  unfold isolatedOneBlockCumulant
  rw [properPartitionContribution_recursiveCumulantUpdate]

/-- Updating only the one-block value to the isolated cumulant forces the
moment-cumulant relation exactly. -/
theorem satisfies_of_oneBlock_and_properContribution
    (n : ℕ) (hn : 0 < n)
    (moment : R)
    (κ : Finset (Fin n) → R)
    (hone :
      κ (Finset.univ : Finset (Fin n)) =
        isolatedOneBlockCumulant n hn moment κ) :
    SatisfiesMomentCumulantRelation n moment κ := by
  exact (satisfies_iff_recursive_isolation n hn moment κ).2 hone

/-- The recursion is unique at the one-block coordinate once all proper-block
values are fixed. -/
theorem oneBlock_unique
    (n : ℕ) (hn : 0 < n)
    (moment : R)
    {κ₁ κ₂ : Finset (Fin n) → R}
    (hproper :
      properPartitionContribution n hn κ₁ =
        properPartitionContribution n hn κ₂)
    (h₁ : SatisfiesMomentCumulantRelation n moment κ₁)
    (h₂ : SatisfiesMomentCumulantRelation n moment κ₂) :
    κ₁ (Finset.univ : Finset (Fin n)) =
      κ₂ (Finset.univ : Finset (Fin n)) := by
  rw [(satisfies_iff_recursive_isolation n hn moment κ₁).1 h₁,
    (satisfies_iff_recursive_isolation n hn moment κ₂).1 h₂]
  simp [isolatedOneBlockCumulant, hproper]

/-- At every positive order, the one-block value plus proper-partition
contribution recovers the generated moment. -/
theorem generatedMoment_reconstruction
    (n : ℕ) (hn : 0 < n)
    (κ : Finset (Fin n) → R) :
    κ (Finset.univ : Finset (Fin n)) +
      properPartitionContribution n hn κ =
        partitionMoment n κ := by
  exact (partitionMoment_eq_oneBlock_add_proper n hn κ).symm

end MomentCumulant

end FormalResearch.PositiveAtlas
