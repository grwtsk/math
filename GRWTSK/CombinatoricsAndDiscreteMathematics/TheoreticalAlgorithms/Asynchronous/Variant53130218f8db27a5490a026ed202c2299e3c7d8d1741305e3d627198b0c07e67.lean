import Boolean.Cube.BooleanNetwork


namespace GRWTSK.CombinatoricsAndDiscreteMathematics.TheoreticalAlgorithms.BooleanNetworkAsynchronousNetwork.Variant5ad9777132f27372146b2e7fa396fc6c07f4e23fd55c7427d4f604241dd1c005

namespace Boolean.Cube

/-- Coordinate-wise asynchronous Boolean-network update rules. -/
structure BooleanNetwork.AsynchronousNetwork (n : Nat) where
  update : Fin n → Hypercube.Point n → Bool

/-- Update exactly one coordinate and leave all other coordinates unchanged. -/
def BooleanNetwork.AsynchronousNetwork.updateAt {n : Nat}
    (N : BooleanNetwork.AsynchronousNetwork n)
    (i : Fin n)
    (x : Hypercube.Point n) :
    Hypercube.Point n :=
  fun j =>
    if j = i then
      N.update i x
    else
      x j

/-- One admissible asynchronous transition. -/
def BooleanNetwork.AsynchronousNetwork.Step {n : Nat}
    (N : BooleanNetwork.AsynchronousNetwork n)
    (x y : Hypercube.Point n) :
    Prop :=
  ∃ i : Fin n, y = N.updateAt i x

@[simp] theorem BooleanNetwork.AsynchronousNetwork.updateAt_same {n : Nat}
    (N : BooleanNetwork.AsynchronousNetwork n)
    (i : Fin n)
    (x : Hypercube.Point n) :
    N.updateAt i x i = N.update i x := by
  simp [BooleanNetwork.AsynchronousNetwork.updateAt]

theorem BooleanNetwork.AsynchronousNetwork.updateAt_other {n : Nat}
    (N : BooleanNetwork.AsynchronousNetwork n)
    {i j : Fin n}
    (x : Hypercube.Point n)
    (h : j ≠ i) :
    N.updateAt i x j = x j := by
  simp [BooleanNetwork.AsynchronousNetwork.updateAt, h]

/-- Apply a finite schedule of coordinate updates. -/
def BooleanNetwork.AsynchronousNetwork.run {n : Nat}
    (N : BooleanNetwork.AsynchronousNetwork n) :
    List (Fin n) → Hypercube.Point n → Hypercube.Point n
  | [], x => x
  | i :: schedule, x =>
      BooleanNetwork.AsynchronousNetwork.run N schedule (N.updateAt i x)

/-- State trajectory generated by a finite asynchronous schedule. -/
def BooleanNetwork.AsynchronousNetwork.trajectory {n : Nat}
    (N : BooleanNetwork.AsynchronousNetwork n) :
    Hypercube.Point n → List (Fin n) → List (Hypercube.Point n)
  | x, [] => [x]
  | x, i :: schedule =>
      x ::
        BooleanNetwork.AsynchronousNetwork.trajectory N
          (N.updateAt i x)
          schedule

/-- A finite asynchronous schedule carries `x` to `y`. -/
def BooleanNetwork.AsynchronousNetwork.FollowsSchedule {n : Nat}
    (N : BooleanNetwork.AsynchronousNetwork n)
    (schedule : List (Fin n))
    (x y : Hypercube.Point n) :
    Prop :=
  BooleanNetwork.AsynchronousNetwork.run N schedule x = y

/-- State `x` reaches state `y` through some finite asynchronous schedule. -/
def BooleanNetwork.AsynchronousNetwork.Reachable {n : Nat}
    (N : BooleanNetwork.AsynchronousNetwork n)
    (x y : Hypercube.Point n) :
    Prop :=
  ∃ schedule : List (Fin n),
    BooleanNetwork.AsynchronousNetwork.run N schedule x = y

/-- A coordinate is stable at `x` when updating it leaves its value unchanged. -/
def BooleanNetwork.AsynchronousNetwork.StableCoordinate {n : Nat}
    (N : BooleanNetwork.AsynchronousNetwork n)
    (x : Hypercube.Point n)
    (i : Fin n) :
    Prop :=
  N.update i x = x i

/-- A state is stable when every coordinate update leaves it unchanged. -/
def BooleanNetwork.AsynchronousNetwork.StableState {n : Nat}
    (N : BooleanNetwork.AsynchronousNetwork n)
    (x : Hypercube.Point n) :
    Prop :=
  ∀ i : Fin n,
    BooleanNetwork.AsynchronousNetwork.StableCoordinate N x i

/-- A state fixed by every one-coordinate asynchronous update. -/
def BooleanNetwork.AsynchronousNetwork.FixedPoint {n : Nat}
    (N : BooleanNetwork.AsynchronousNetwork n)
    (x : Hypercube.Point n) :
    Prop :=
  ∀ i : Fin n, N.updateAt i x = x

@[simp] theorem BooleanNetwork.AsynchronousNetwork.run_nil {n : Nat}
    (N : BooleanNetwork.AsynchronousNetwork n)
    (x : Hypercube.Point n) :
    N.run [] x = x := rfl

@[simp] theorem BooleanNetwork.AsynchronousNetwork.run_cons {n : Nat}
    (N : BooleanNetwork.AsynchronousNetwork n)
    (i : Fin n)
    (schedule : List (Fin n))
    (x : Hypercube.Point n) :
    N.run (i :: schedule) x =
      N.run schedule (N.updateAt i x) := rfl

@[simp] theorem BooleanNetwork.AsynchronousNetwork.trajectory_nil {n : Nat}
    (N : BooleanNetwork.AsynchronousNetwork n)
    (x : Hypercube.Point n) :
    N.trajectory x [] = [x] := rfl

@[simp] theorem BooleanNetwork.AsynchronousNetwork.trajectory_cons {n : Nat}
    (N : BooleanNetwork.AsynchronousNetwork n)
    (x : Hypercube.Point n)
    (i : Fin n)
    (schedule : List (Fin n)) :
    N.trajectory x (i :: schedule) =
      x :: N.trajectory (N.updateAt i x) schedule := rfl

theorem BooleanNetwork.AsynchronousNetwork.run_append {n : Nat}
    (N : BooleanNetwork.AsynchronousNetwork n)
    (left right : List (Fin n))
    (x : Hypercube.Point n) :
    N.run (left ++ right) x = N.run right (N.run left x) := by
  induction left generalizing x with
  | nil => rfl
  | cons i left ih =>
      simp [ih]

theorem BooleanNetwork.AsynchronousNetwork.reachable_refl {n : Nat}
    (N : BooleanNetwork.AsynchronousNetwork n)
    (x : Hypercube.Point n) :
    N.Reachable x x := by
  exact ⟨[], rfl⟩

theorem BooleanNetwork.AsynchronousNetwork.reachable_step {n : Nat}
    (N : BooleanNetwork.AsynchronousNetwork n)
    (x : Hypercube.Point n)
    (i : Fin n) :
    N.Reachable x (N.updateAt i x) := by
  exact ⟨[i], rfl⟩

theorem BooleanNetwork.AsynchronousNetwork.reachable_trans {n : Nat}
    (N : BooleanNetwork.AsynchronousNetwork n)
    {x y z : Hypercube.Point n}
    (hxy : N.Reachable x y)
    (hyz : N.Reachable y z) :
    N.Reachable x z := by
  rcases hxy with ⟨left, hleft⟩
  rcases hyz with ⟨right, hright⟩
  refine ⟨left ++ right, ?_⟩
  rw [BooleanNetwork.AsynchronousNetwork.run_append, hleft]
  exact hright

theorem BooleanNetwork.AsynchronousNetwork.updateAt_eq_self_of_stable {n : Nat}
    (N : BooleanNetwork.AsynchronousNetwork n)
    (x : Hypercube.Point n)
    (h : N.StableState x)
    (i : Fin n) :
    N.updateAt i x = x := by
  funext j
  by_cases hji : j = i
  · subst j
    simpa [BooleanNetwork.AsynchronousNetwork.updateAt,
      BooleanNetwork.AsynchronousNetwork.StableCoordinate] using h i
  · simp [BooleanNetwork.AsynchronousNetwork.updateAt, hji]

theorem BooleanNetwork.AsynchronousNetwork.fixedPoint_of_stable {n : Nat}
    (N : BooleanNetwork.AsynchronousNetwork n)
    (x : Hypercube.Point n)
    (h : N.StableState x) :
    N.FixedPoint x := by
  intro i
  exact N.updateAt_eq_self_of_stable x h i

theorem BooleanNetwork.AsynchronousNetwork.stable_of_fixedPoint {n : Nat}
    (N : BooleanNetwork.AsynchronousNetwork n)
    (x : Hypercube.Point n)
    (h : N.FixedPoint x) :
    N.StableState x := by
  intro i
  have hi := congrFun (h i) i
  simpa [BooleanNetwork.AsynchronousNetwork.updateAt,
    BooleanNetwork.AsynchronousNetwork.StableCoordinate] using hi

theorem BooleanNetwork.AsynchronousNetwork.run_of_fixedPoint {n : Nat}
    (N : BooleanNetwork.AsynchronousNetwork n)
    (x : Hypercube.Point n)
    (h : N.FixedPoint x)
    (schedule : List (Fin n)) :
    N.run schedule x = x := by
  induction schedule generalizing x with
  | nil => rfl
  | cons i schedule ih =>
      rw [BooleanNetwork.AsynchronousNetwork.run_cons, h i]
      exact ih x h

end Boolean.Cube
