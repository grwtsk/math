import GRWTSK.DifferentialEquationsAndDynamicalSystems.HeatRicciHomology.RationalSpectralHeatCollision
import Mathlib.Tactic

set_option autoImplicit false
noncomputable section

/-!
# Finite rational weighted graph Dirichlet energy

A nonnegative rational weight for each ordered vertex pair gives a
finite sum of squared differences. This is a finite graph Dirichlet
form. The affine reference heat relaxation scales every edge
difference by 1-t, so the energy scales by (1-t)^2.

No claim of a genuine graph heat semigroup generated by the weighted
Laplacian is made: the affine relaxation is not generally exp(-tL).
No continuum Hodge theory, Tao heat flow, Navier–Stokes regularity,
M23, Rank32, RS interpolation, or actual zeta-zero spectral operator
is imported.
-/

namespace GRWTSK.DifferentialEquationsAndDynamicalSystems.FiniteWeightedGraphEnergy

open GRWTSK.DifferentialEquationsAndDynamicalSystems.RationalSpectralHeatCollision

variable {V : Type*} [Fintype V] [DecidableEq V]

/-- Directed-edge weighted rational Dirichlet energy, without
symmetry or zero-diagonal assumptions. -/
def weightedDirichlet (w : V → V → ℚ) (u : V → ℚ) : ℚ :=
  ∑ i : V, ∑ j : V, w i j * (u i - u j) ^ 2

/-- Every nonnegative edge weight yields a nonnegative finite
Dirichlet form. -/
theorem weightedDirichlet_nonnegative
    (w : V → V → ℚ) (hw : ∀ i j, 0 ≤ w i j)
    (u : V → ℚ) :
    0 ≤ weightedDirichlet w u := by
  unfold weightedDirichlet
  apply Finset.sum_nonneg
  intro i hi
  apply Finset.sum_nonneg
  intro j hj
  exact mul_nonneg (hw i j) (sq_nonneg _)

/-- Each edge difference scales by the same rational heat factor. -/
theorem weightedDirichlet_heat_eq
    (w : V → V → ℚ) (u : V → ℚ) (c t : ℚ) :
    weightedDirichlet w (heatField c t u) =
      (1 - t) ^ 2 * weightedDirichlet w u := by
  unfold weightedDirichlet
  simp only [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i hi
  apply Finset.sum_congr rfl
  intro j hj
  simp only [heatField, heatStep_difference]
  ring

/-- Nonnegative weights and a subterminal step give monotone
finite Dirichlet energy. -/
theorem weightedDirichlet_heat_le
    (w : V → V → ℚ) (hw : ∀ i j, 0 ≤ w i j)
    (u : V → ℚ) (c t : ℚ)
    (ht0 : 0 ≤ t) (ht1 : t ≤ 1) :
    weightedDirichlet w (heatField c t u) ≤
      weightedDirichlet w u := by
  rw [weightedDirichlet_heat_eq]
  have hE := weightedDirichlet_nonnegative w hw u
  have hfactor : 0 ≤ 1 - t := sub_nonneg.mpr ht1
  have hfactorLe : 1 - t ≤ (1 : ℚ) := by linarith
  have hsq : (1 - t) ^ 2 ≤ (1 : ℚ) := by nlinarith
  nlinarith

/-! ## Genuine symmetric weighted graph Laplacian

For symmetric weights the rational graph-Laplacian pairing equals
half the directed-edge Dirichlet energy. This is a finite identity,
not a claim about continuum Hodge theory or PDE regularity.
-/

/-- The actual weighted graph Laplacian, rather than the common
reference affine relaxation. -/
def weightedGraphLaplacian (w : V → V → ℚ) (u : V → ℚ) : V → ℚ :=
  fun i => ∑ j : V, w i j * (u i - u j)

/-- Quadratic pairing of the graph Laplacian with its input field. -/
def graphLaplacianPairing (w : V → V → ℚ) (u : V → ℚ) : ℚ :=
  ∑ i : V, u i * weightedGraphLaplacian w u i

/-- Exact pairing identity, with a factor of two because the
Dirichlet sum counts both edge orientations. -/
theorem graphLaplacianPairing_twice_eq_dirichlet
    (w : V → V → ℚ) (u : V → ℚ)
    (hsym : ∀ i j, w i j = w j i) :
    2 * graphLaplacianPairing w u = weightedDirichlet w u := by
  classical
  unfold graphLaplacianPairing weightedGraphLaplacian weightedDirichlet
  simp only [Finset.mul_sum]
  have hswap :
      (∑ i : V, ∑ j : V, u i * (w i j * (u i - u j))) =
      (∑ i : V, ∑ j : V, u j * (w i j * (u j - u i))) := by
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro j hj
    apply Finset.sum_congr rfl
    intro i hi
    rw [hsym j i]
  calc
    2 * (∑ i : V, ∑ j : V, u i * (w i j * (u i - u j))) =
        (∑ i : V, ∑ j : V, u i * (w i j * (u i - u j))) +
        (∑ i : V, ∑ j : V, u j * (w i j * (u j - u i))) := by
          rw [← hswap]
          ring
    _ = ∑ i : V, ∑ j : V, w i j * (u i - u j) ^ 2 := by
      rw [← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro i hi
      rw [← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro j hj
      ring

/-- Nonnegative symmetric weights give a positive semidefinite
graph-Laplacian pairing. -/
theorem graphLaplacianPairing_nonnegative
    (w : V → V → ℚ) (u : V → ℚ)
    (hsym : ∀ i j, w i j = w j i)
    (hw : ∀ i j, 0 ≤ w i j) :
    0 ≤ graphLaplacianPairing w u := by
  have hpair := graphLaplacianPairing_twice_eq_dirichlet w u hsym
  have henergy := weightedDirichlet_nonnegative w hw u
  linarith

/-! ## Genuine explicit-Euler graph heat and a CFL-style bound

The actual weighted graph Laplacian now drives a discrete heat step.
For nonnegative weights and a step size with τ*degree(i) ≤ 1,
each new coordinate is a convex combination of old coordinates.
This is a finite maximum-principle/CFL condition, not a proof of
Dirichlet energy decay or a continuum Navier–Stokes estimate.
-/

/-- Total outgoing rational edge weight at a vertex. -/
def weightedDegree (w : V → V → ℚ) (i : V) : ℚ :=
  ∑ j : V, w i j

/-- A genuine explicit-Euler step generated by the weighted
graph Laplacian. -/
def graphEulerHeat (w : V → V → ℚ) (τ : ℚ)
    (u : V → ℚ) : V → ℚ :=
  fun i => u i - τ * weightedGraphLaplacian w u i

/-- The exact pointwise Euler update as a weighted combination. -/
theorem graphEulerHeat_coordinate
    (w : V → V → ℚ) (τ : ℚ) (u : V → ℚ) (i : V) :
    graphEulerHeat w τ u i =
      (1 - τ * weightedDegree w i) * u i +
        ∑ j : V, (τ * w i j) * u j := by
  unfold graphEulerHeat weightedGraphLaplacian weightedDegree
  rw [Finset.mul_sum, Finset.sum_mul]
  ring

/-- The Euler coefficients sum to one exactly, independently
of symmetry or positivity. -/
theorem graphEulerHeat_coefficients_sum_one
    (w : V → V → ℚ) (τ : ℚ) (i : V) :
    (1 - τ * weightedDegree w i) +
      ∑ j : V, τ * w i j = 1 := by
  unfold weightedDegree
  rw [Finset.mul_sum]
  ring

/-- The explicit CFL condition gives nonnegative coefficients
for the actual Euler update. -/
theorem graphEulerHeat_coefficients_nonnegative
    (w : V → V → ℚ) (τ : ℚ)
    (hw : ∀ i j, 0 ≤ w i j)
    (hτ : 0 ≤ τ)
    (hCFL : ∀ i, τ * weightedDegree w i ≤ 1)
    (i : V) :
    0 ≤ 1 - τ * weightedDegree w i ∧
      ∀ j, 0 ≤ τ * w i j := by
  constructor
  · exact sub_nonneg.mpr (hCFL i)
  · intro j
    exact mul_nonneg hτ (hw i j)

/-! ## Genuine finite graph heat maximum principle

The CFL condition turns each Euler coordinate into a nonnegative
convex combination. The maximum principle is valid for directed
nonnegative weights; symmetry is needed separately for the Hodge
pairing and spectral energy identities.
-/

/-- Every Euler output coordinate is bounded above by any common
upper bound for the input field. -/
theorem graphEulerHeat_le_of_forall_le
    (w : V → V → ℚ) (τ B : ℚ) (u : V → ℚ)
    (hw : ∀ i j, 0 ≤ w i j)
    (hτ : 0 ≤ τ)
    (hCFL : ∀ i, τ * weightedDegree w i ≤ 1)
    (hu : ∀ i, u i ≤ B)
    (i : V) :
    graphEulerHeat w τ u i ≤ B := by
  rw [graphEulerHeat_coordinate]
  have hc := graphEulerHeat_coefficients_nonnegative w τ hw hτ hCFL i
  have hself := mul_le_mul_of_nonneg_left (hu i) hc.1
  have hsum :
      (∑ j : V, (τ * w i j) * u j) ≤
        ∑ j : V, (τ * w i j) * B := by
    apply Finset.sum_le_sum
    intro j hj
    exact mul_le_mul_of_nonneg_left (hu j) (hc.2 j)
  have hone := graphEulerHeat_coefficients_sum_one w τ i
  rw [← Finset.sum_mul] at hsum
  nlinarith

/-- Every Euler output coordinate is bounded below by any common
lower bound for the input field. -/
theorem graphEulerHeat_ge_of_forall_ge
    (w : V → V → ℚ) (τ B : ℚ) (u : V → ℚ)
    (hw : ∀ i j, 0 ≤ w i j)
    (hτ : 0 ≤ τ)
    (hCFL : ∀ i, τ * weightedDegree w i ≤ 1)
    (hu : ∀ i, B ≤ u i)
    (i : V) :
    B ≤ graphEulerHeat w τ u i := by
  rw [graphEulerHeat_coordinate]
  have hc := graphEulerHeat_coefficients_nonnegative w τ hw hτ hCFL i
  have hself := mul_le_mul_of_nonneg_left (hu i) hc.1
  have hsum :
      (∑ j : V, (τ * w i j) * B) ≤
        ∑ j : V, (τ * w i j) * u j := by
    apply Finset.sum_le_sum
    intro j hj
    exact mul_le_mul_of_nonneg_left (hu j) (hc.2 j)
  have hone := graphEulerHeat_coefficients_sum_one w τ i
  rw [← Finset.sum_mul] at hsum
  nlinarith

/-! ## Exact Euler mass conservation for symmetric weights

Symmetric weights make the total graph-Laplacian flux zero.
Consequently the genuine Euler graph heat step conserves the
rational sum of vertex values for every step size. This is
a finite conservation identity, not an energy-dissipation claim.
-/

/-- Total weighted graph-Laplacian flux vanishes under symmetry. -/
theorem weightedGraphLaplacian_sum_zero
    (w : V → V → ℚ) (u : V → ℚ)
    (hsym : ∀ i j, w i j = w j i) :
    (∑ i : V, weightedGraphLaplacian w u i) = 0 := by
  classical
  unfold weightedGraphLaplacian
  have hswap :
      (∑ i : V, ∑ j : V, w i j * (u i - u j)) =
      (∑ i : V, ∑ j : V, w i j * (u j - u i)) := by
    rw [Finset.sum_comm]
    apply Finset.sum_congr rfl
    intro j hj
    apply Finset.sum_congr rfl
    intro i hi
    rw [hsym j i]
  have hneg :
      (∑ i : V, ∑ j : V, w i j * (u j - u i)) =
      -(∑ i : V, ∑ j : V, w i j * (u i - u j)) := by
    rw [← Finset.sum_neg_distrib]
    apply Finset.sum_congr rfl
    intro i hi
    rw [← Finset.sum_neg_distrib]
    apply Finset.sum_congr rfl
    intro j hj
    ring
  linarith

/-- The actual graph Euler heat step preserves total rational mass
for symmetric weights, without a CFL restriction. -/
theorem graphEulerHeat_sum_eq
    (w : V → V → ℚ) (u : V → ℚ) (τ : ℚ)
    (hsym : ∀ i j, w i j = w j i) :
    (∑ i : V, graphEulerHeat w τ u i) =
      ∑ i : V, u i := by
  unfold graphEulerHeat
  simp only [Finset.sum_sub_distrib, ← Finset.mul_sum]
  rw [weightedGraphLaplacian_sum_zero w u hsym]
  ring

/-! ## Exact Euler energy change and conditional dissipation

The finite Euler step changes the quadratic graph energy by a
first-order dissipative term plus a second-order correction.
A source-faithful operator inequality on the correction is
required before asserting energy decay. This isolates that
missing estimate without inventing a spectral norm bound.
-/

/-- Symmetric bilinear pairing of a rational field with the
weighted graph Laplacian applied to another field. -/
def graphMixedPairing (w : V → V → ℚ)
    (u v : V → ℚ) : ℚ :=
  ∑ i : V, u i * weightedGraphLaplacian w v i

/-- Exact polarization of the Laplacian quadratic pairing. -/
theorem graphLaplacianPairing_sub_expand
    (w : V → V → ℚ) (u v : V → ℚ) (τ : ℚ) :
    graphLaplacianPairing w (fun i => u i - τ * v i) =
      graphLaplacianPairing w u -
        τ * graphMixedPairing w u v -
        τ * graphMixedPairing w v u +
        τ ^ 2 * graphLaplacianPairing w v := by
  classical
  unfold graphLaplacianPairing graphMixedPairing weightedGraphLaplacian
  simp only [Finset.mul_sum]
  rw [← Finset.sum_sub_distrib]
  apply Finset.sum_congr rfl
  intro i hi
  rw [← Finset.sum_sub_distrib]
  ring

/-- An explicit second-order correction budget suffices for
dissipation of the actual graph Euler step. The correction bound
is an unresolved arithmetic/spectral supplier. -/
theorem graphEulerHeat_pairing_le_of_correction_budget
    (w : V → V → ℚ) (u : V → ℚ) (τ : ℚ)
    (hτ : 0 ≤ τ)
    (hmixed :
      graphMixedPairing w u (weightedGraphLaplacian w u) =
        graphMixedPairing w (weightedGraphLaplacian w u) u)
    (hbudget :
      τ * graphLaplacianPairing w (weightedGraphLaplacian w u) ≤
        2 * graphMixedPairing w u (weightedGraphLaplacian w u)) :
    graphLaplacianPairing w (graphEulerHeat w τ u) ≤
      graphLaplacianPairing w u := by
  have hexpand := graphLaplacianPairing_sub_expand
    w u (weightedGraphLaplacian w u) τ
  change graphLaplacianPairing w
    (fun i => u i - τ * weightedGraphLaplacian w u i) =
    _ at hexpand
  rw [← graphEulerHeat] at hexpand
  rw [hmixed] at hexpand
  nlinarith

/-! ## Explicit correction budget from graph degree

The spectral-radius estimate is isolated as an exact finite
hypothesis, rather than inferred from the CFL maximum principle.
A bound on the graph Laplacian quadratic form at its own image
provides a sufficient step-size criterion for Euler dissipation.
-/

/-- The largest degree is bounded by an explicitly supplied
rational constant. -/
def DegreeBound (w : V → V → ℚ) (D : ℚ) : Prop :=
  ∀ i, weightedDegree w i ≤ D

/-- A spectral quadratic-form upper bound on the Laplacian image.
This remains an independent finite operator estimate. -/
def LaplacianImageBound (w : V → V → ℚ) (D : ℚ) : Prop :=
  ∀ u : V → ℚ,
    graphLaplacianPairing w (weightedGraphLaplacian w u) ≤
      2 * D * graphMixedPairing w u (weightedGraphLaplacian w u)

/-- The image-form estimate and τD ≤ 1 discharge the exact
second-order correction budget. -/
theorem graphEulerHeat_correction_budget_of_image_bound
    (w : V → V → ℚ) (u : V → ℚ)
    (τ D : ℚ) (hτ : 0 ≤ τ) (hD : 0 ≤ D)
    (hstep : τ * D ≤ 1)
    (himage : LaplacianImageBound w D)
    (hmixednonneg :
      0 ≤ graphMixedPairing w u (weightedGraphLaplacian w u)) :
    τ * graphLaplacianPairing w (weightedGraphLaplacian w u) ≤
      2 * graphMixedPairing w u (weightedGraphLaplacian w u) := by
  have h := himage u
  have hscaled := mul_le_mul_of_nonneg_left h hτ
  nlinarith

/-- A verified image-form bound, symmetric mixed pairing and
the explicit step restriction imply genuine Euler dissipation. -/
theorem graphEulerHeat_pairing_le_of_image_bound
    (w : V → V → ℚ) (u : V → ℚ)
    (τ D : ℚ) (hτ : 0 ≤ τ) (hD : 0 ≤ D)
    (hstep : τ * D ≤ 1)
    (himage : LaplacianImageBound w D)
    (hmixednonneg :
      0 ≤ graphMixedPairing w u (weightedGraphLaplacian w u))
    (hmixed :
      graphMixedPairing w u (weightedGraphLaplacian w u) =
        graphMixedPairing w (weightedGraphLaplacian w u) u) :
    graphLaplacianPairing w (graphEulerHeat w τ u) ≤
      graphLaplacianPairing w u := by
  apply graphEulerHeat_pairing_le_of_correction_budget w u τ hτ hmixed
  exact graphEulerHeat_correction_budget_of_image_bound
    w u τ D hτ hD hstep himage hmixednonneg

end GRWTSK.DifferentialEquationsAndDynamicalSystems.FiniteWeightedGraphEnergy
