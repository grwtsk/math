import Mathlib.Tactic

set_option autoImplicit false

/-!
# Exact finite residual telescopes

This module supplies the algebraic part of a source-to-target error budget.  A chain
`x 0, x 1, ...` has canonical signed residuals `x n - x (n + 1)`; their recursive
sum is definitionally tied to the chain and telescopes to `x 0 - x n`.

It also defines an elementary epsilon formulation of convergence to zero for real
sequences and proves the closure properties needed to combine a finite family of
named residual channels.  No analytic residual is asserted to vanish merely by
being placed in this interface.
-/

namespace GRWTSK.Analysis.ErrorBounds

section Telescope

variable {A : Type*} [AddCommGroup A]

/-- The canonical signed residual total generated by the first `n` edges of `x`. -/
def residualTotal (x : ℕ → A) : ℕ → A
  | 0 => 0
  | n + 1 => residualTotal x n + (x n - x (n + 1))

@[simp] theorem residualTotal_zero (x : ℕ → A) : residualTotal x 0 = 0 := rfl

@[simp] theorem residualTotal_succ (x : ℕ → A) (n : ℕ) :
    residualTotal x (n + 1) = residualTotal x n + (x n - x (n + 1)) := rfl

/-- The residual total is exactly the endpoint difference; no residual is supplied ad hoc. -/
theorem residualTotal_eq_endpointDifference (x : ℕ → A) :
    ∀ n : ℕ, residualTotal x n = x 0 - x n
  | 0 => by simp
  | n + 1 => by
      rw [residualTotal_succ, residualTotal_eq_endpointDifference x n]
      abel

/-- Endpoint-first orientation of the exact signed telescope. -/
theorem exact_residual_telescope (x : ℕ → A) (n : ℕ) :
    x 0 - x n = residualTotal x n := by
  symm
  exact residualTotal_eq_endpointDifference x n

end Telescope

/-- Elementary epsilon convergence of a real sequence to zero. -/
def VanishesAtInfinity (u : ℕ → ℝ) : Prop :=
  ∀ ε : ℝ, 0 < ε → ∃ N : ℕ, ∀ n : ℕ, N ≤ n → |u n| ≤ ε

namespace VanishesAtInfinity

/-- The zero residual vanishes. -/
theorem zero : VanishesAtInfinity (fun _ : ℕ => (0 : ℝ)) := by
  intro ε hε
  exact ⟨0, fun _ _ => by simpa using hε.le⟩

/-- Sign does not affect vanishing. -/
theorem neg {u : ℕ → ℝ} (hu : VanishesAtInfinity u) :
    VanishesAtInfinity (fun n => -u n) := by
  intro ε hε
  obtain ⟨N, hN⟩ := hu ε hε
  refine ⟨N, ?_⟩
  intro n hn
  simpa only [abs_neg] using hN n hn

/-- A sum of two vanishing residuals vanishes. -/
theorem add {u v : ℕ → ℝ}
    (hu : VanishesAtInfinity u) (hv : VanishesAtInfinity v) :
    VanishesAtInfinity (fun n => u n + v n) := by
  intro ε hε
  have hhalf : 0 < ε / 2 := by linarith
  obtain ⟨Nu, hNu⟩ := hu (ε / 2) hhalf
  obtain ⟨Nv, hNv⟩ := hv (ε / 2) hhalf
  refine ⟨max Nu Nv, ?_⟩
  intro n hn
  have hnu : Nu ≤ n := le_trans (le_max_left Nu Nv) hn
  have hnv : Nv ≤ n := le_trans (le_max_right Nu Nv) hn
  calc
    |u n + v n| ≤ |u n| + |v n| := abs_add_le _ _
    _ ≤ ε / 2 + ε / 2 := add_le_add (hNu n hnu) (hNv n hnv)
    _ = ε := by ring

/-- A difference of two vanishing residuals vanishes. -/
theorem sub {u v : ℕ → ℝ}
    (hu : VanishesAtInfinity u) (hv : VanishesAtInfinity v) :
    VanishesAtInfinity (fun n => u n - v n) := by
  simpa only [sub_eq_add_neg] using add hu (neg hv)

/-- A residual dominated by a nonnegative vanishing majorant also vanishes. -/
theorem of_nonnegative_bound {u e : ℕ → ℝ}
    (he : VanishesAtInfinity e)
    (he_nonnegative : ∀ n, 0 ≤ e n)
    (hbound : ∀ n, |u n| ≤ e n) :
    VanishesAtInfinity u := by
  intro ε hε
  obtain ⟨N, hN⟩ := he ε hε
  refine ⟨N, ?_⟩
  intro n hn
  exact (hbound n).trans (by simpa [abs_of_nonneg (he_nonnegative n)] using hN n hn)

end VanishesAtInfinity

end GRWTSK.Analysis.ErrorBounds
