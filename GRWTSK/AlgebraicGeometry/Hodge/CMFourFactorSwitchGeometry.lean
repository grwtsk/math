import GRWTSK.AlgebraicGeometry.Hodge.CMFourFactorSwitchCombinatorics
import GRWTSK.AlgebraicGeometry.Hodge.CMEmbeddingTransport
import GRWTSK.AlgebraicGeometry.Hodge.CMFourFactorAlgebraicity
import GRWTSK.AlgebraicGeometry.Hodge.CMWeightOneRiemannRealization

/-!
# Geometric supplier boundary for finite four-factor switch chains

The finite sign-switch relation is local.  Turning one elementary switch into
an algebraic transition tensor, and composing consecutive transition tensors,
are geometric statements from the external CM-Hodge manuscript.

This file isolates those two geometric suppliers and proves the formal
composition theorem: once they are supplied, every finite local switch chain
has a global algebraic transition witness.

No constructor for either supplier is proved here.
-/

set_option autoImplicit false

namespace GRWTSK.AlgebraicGeometry.Hodge.CMFourFactorSwitchGeometry

open CMFourBalance
open CMFourFactorSwitchCombinatorics
open GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent

noncomputable section

variable {I G : Type*} [Fintype I] [DecidableEq I]
  [Fintype G] [DecidableEq G]

/-- Opaque geometric transition between two sign matrices.

The carrier is intentionally abstract because the current local library has no
cohomology/cycle API at the scope required by the manuscript. -/
structure AlgebraicTransitionWitness
    (x y : I → G → ℤ) where
  carrier : Type*
  transition : carrier
  algebraic : Prop
  algebraic_proof : algebraic
  nonzero : Prop
  nonzero_proof : nonzero

/-- Algebraic two-factor witness for one unchanged row.

Geometrically this is the degree-one identity/diagonal correspondence on the
same weight-one CM factor.  The current repository has no cycle-class API at
this scope, so the carrier remains abstract while algebraicity and nonvanishing
are recorded explicitly. -/
structure TwoFactorIdentityWitness
    (row : G → ℤ) where
  carrier : Type*
  tensor : carrier
  algebraic : Prop
  algebraic_proof : algebraic
  nonzero : Prop
  nonzero_proof : nonzero

/-- Exact geometric supplier for one unchanged row.

In the manuscript this is the algebraic line
U(v)_1 tensor U(v)_c, equivalently the degree-one identity/diagonal
correspondence on B(v). -/
structure TwoFactorIdentitySupplier where
  realize :
    ∀ (row : G → ℤ),
      TwoFactorIdentityWitness row

/-- Assembly of all unchanged-row two-factor witnesses into the identity
transition on the whole row list.

This abstracts only the geometric pullback-to-slots and product operation; it
does not supply any four-factor switched class. -/
structure IdentityTensorAssemblySupplier where
  assemble :
    ∀ (x : I → G → ℤ),
      (∀ r : I, TwoFactorIdentityWitness (x r)) →
      AlgebraicTransitionWitness x x

/-- Identity transition supplier.

In the manuscript this is generated by the unchanged two-factor tensors
U(v)_1 tensor U(v)_c. -/
structure IdentityTransitionSupplier where
  realize :
    ∀ (x : I → G → ℤ),
      AlgebraicTransitionWitness x x

/-- The routine unchanged-row geometry canonically supplies the identity
transition interface once the per-row diagonal classes and their finite tensor
assembly are available. -/
def identityTransitionSupplierOfTwoFactor
    (P : TwoFactorIdentitySupplier)
    (A : IdentityTensorAssemblySupplier) :
    IdentityTransitionSupplier where
  realize := fun x => A.assemble x (fun r => P.realize (x r))

/-- Algebraic witness for the genuinely switched four-factor core.

Only the old/new factors belonging to the two changed rows are represented
here.  Unchanged rows are deliberately excluded. -/
structure FourFactorSwitchCoreWitness
    (conj : G → G)
    (x : I → G → ℤ)
    (g : G) (i j : I) where
  carrier : Type*
  tensor : carrier
  algebraic : Prop
  algebraic_proof : algebraic
  nonzero : Prop
  nonzero_proof : nonzero

/-- Canonical four-row profile attached to one atomic switch.

This packages the two selected old rows and the corresponding two new rows,
together with the local four-label balance theorem and its all-conjugate
(2,2) certificate.  It contains no tensor or algebraicity data. -/
structure AtomicSwitchFourFactorProfile
    (conj : G → G)
    (hconj : Function.Involutive conj)
    (x target : I → G → ℤ)
    (hxsign : ∀ r h, IsSign (x r h))
    (hxodd : IsOddMatrix conj x)
    (g : G) (hg : g ≠ conj g)
    (i : PosNegMismatch (fun r => x r g) (fun r => target r g))
    (j : NegPosMismatch (fun r => x r g) (fun r => target r g)) where
  v₁ : OddSignRow G conj
  v₂ : OddSignRow G conj
  v₃ : OddSignRow G conj
  v₄ : OddSignRow G conj
  balance : FourBalance v₁ v₂ v₃ v₄
  type22 :
    CMFourFactorAlgebraicity.AllConjugatesType22
      G conj v₁ v₂ v₃ v₄

/-- The canonical atomic-switch profile is completely local: the four rows are
the two selected rows before and after the switch, balance is the local
combinatorial theorem, and the (2,2) certificate follows from balance. -/
def canonicalAtomicSwitchFourFactorProfile
    (conj : G → G)
    (hconj : Function.Involutive conj)
    (x target : I → G → ℤ)
    (hxsign : ∀ r h, IsSign (x r h))
    (hxodd : IsOddMatrix conj x)
    (g : G) (hg : g ≠ conj g)
    (i : PosNegMismatch (fun r => x r g) (fun r => target r g))
    (j : NegPosMismatch (fun r => x r g) (fun r => target r g)) :
    AtomicSwitchFourFactorProfile
      conj hconj x target hxsign hxodd g hg i j := by
  let x' := switchConjugatePair conj x g i.1 j.1
  have hx'sign : ∀ r h, IsSign (x' r h) :=
    switchConjugatePair_isSign conj x hxsign g i.1 j.1
  have hx'odd : IsOddMatrix conj x' :=
    switchConjugatePair_odd conj hconj x hxodd g hg i.1 j.1
  let v₁ := oddSignRowOfMatrix conj x hxsign hxodd i.1
  let v₂ := oddSignRowOfMatrix conj x hxsign hxodd j.1
  let v₃ := oddSignRowOfMatrix conj x' hx'sign hx'odd i.1
  let v₄ := oddSignRowOfMatrix conj x' hx'sign hx'odd j.1
  have hbal : FourBalance v₁ v₂ v₃ v₄ := by
    simpa [v₁, v₂, v₃, v₄, x'] using
      atomicSwitch_fourBalance
        conj hconj x target hxsign hxodd g hg i j
  exact {
    v₁ := v₁
    v₂ := v₂
    v₃ := v₃
    v₄ := v₄
    balance := hbal
    type22 :=
      CMFourFactorAlgebraicity.allConjugatesType22_of_fourBalance
        v₁ v₂ v₃ v₄ hbal
  }

/-- Complex span of the scalar-Galois orbit of one algebraic-number tensor.

This is the smallest subspace in which scalar-conjugate stability is automatic.
The geometric content is therefore reduced to proving that this orbit span lies
inside the actual Hodge subspace. -/
def scalarConjugateOrbitSpan
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (tensor :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ] V) :
    Submodule ℂ (ℂ ⊗[ℚ] V) :=
  Submodule.span ℂ
    (Set.range fun σ :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ≃ₐ[ℚ]
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers =>
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.coefficientInclusion
        (GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.scalarConjugate
          σ tensor))

/-- Every scalar conjugate belongs to its orbit span by construction. -/
theorem scalarConjugate_mem_orbitSpan
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (tensor :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ] V)
    (σ :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ≃ₐ[ℚ]
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers) :
    GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.coefficientInclusion
      (GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.scalarConjugate
        σ tensor) ∈ scalarConjugateOrbitSpan tensor := by
  apply Submodule.subset_span
  exact Set.mem_range_self σ

/-- Fourfold switched assembly before coefficient inclusion into C.

Keeping the assembly over AlgebraicNumbers puts coefficient conjugation and
factor transport in the same category. -/
structure FourfoldAlgebraicAssemblyData
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (factors :
      CMEmbeddingTransport.FourEmbeddingLineVectors
        (k := ℚ)
        (E :=
          GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers))
    (tensor :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ] V) where
  assemble :
    (Fin 4 →
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ]
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers) →
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ] V
  original_eq :
    tensor = assemble factors.vector

/-- Rational fourfold vector target carrying the four second tensor
components of canonical embedding-line factors. -/
abbrev CanonicalFourfoldVectorTarget :=
  (((GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
      ⊗[ℚ]
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers)
      ⊗[ℚ]
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers)
      ⊗[ℚ]
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers)

/-- Pure tensor of the four vector entries. -/
def canonicalFourfoldVectorPure
    (x₁ x₂ x₃ x₄ :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers) :
    CanonicalFourfoldVectorTarget :=
  ((x₁ ⊗ₜ[ℚ] x₂) ⊗ₜ[ℚ] x₃) ⊗ₜ[ℚ] x₄

/-- Canonical pure switched assembly: multiply the four algebraic coefficient
entries and retain the four vector entries in a rational fourfold tensor. -/
def canonicalPureAlgebraicAssembly
    (a₁ x₁ a₂ x₂ a₃ x₃ a₄ x₄ :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers) :
    GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
      ⊗[ℚ] CanonicalFourfoldVectorTarget :=
  (a₁ * a₂ * a₃ * a₄) ⊗ₜ[ℚ]
    canonicalFourfoldVectorPure x₁ x₂ x₃ x₄

/-- On pure canonical factors, scalar conjugation commutes with the fourfold
assembly by multiplicativity of the coefficient-field automorphism. -/
theorem scalarConjugate_canonicalPureAlgebraicAssembly
    (σ :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ≃ₐ[ℚ]
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers)
    (a₁ x₁ a₂ x₂ a₃ x₃ a₄ x₄ :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers) :
    GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.scalarConjugate σ
        (canonicalPureAlgebraicAssembly
          a₁ x₁ a₂ x₂ a₃ x₃ a₄ x₄) =
      canonicalPureAlgebraicAssembly
        (σ a₁) x₁ (σ a₂) x₂ (σ a₃) x₃ (σ a₄) x₄ := by
  simp [canonicalPureAlgebraicAssembly,
    GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.scalarConjugate_tmul,
    map_mul]

/-- Fourfold assembly presented as four nested Q-linear maps.

The only supplied formula is its value on four pure canonical factor tensors.
This is enough to derive scalar-conjugation equivariance on arbitrary factors
by four nested tensor inductions. -/
structure FourfoldMultilinearAlgebraicAssembly where
  assemble :
    (GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ]
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers) →ₗ[ℚ]
    (GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ]
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers) →ₗ[ℚ]
    (GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ]
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers) →ₗ[ℚ]
    (GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ]
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers) →ₗ[ℚ]
    (GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ] CanonicalFourfoldVectorTarget)
  pure_formula :
    ∀ a₁ x₁ a₂ x₂ a₃ x₃ a₄ x₄,
      assemble
          (a₁ ⊗ₜ[ℚ] x₁)
          (a₂ ⊗ₜ[ℚ] x₂)
          (a₃ ⊗ₜ[ℚ] x₃)
          (a₄ ⊗ₜ[ℚ] x₄) =
        canonicalPureAlgebraicAssembly
          a₁ x₁ a₂ x₂ a₃ x₃ a₄ x₄

/-- Full Galois equivariance follows formally from Q-multilinearity and the
pure-factor equivariance theorem. -/
theorem FourfoldMultilinearAlgebraicAssembly.equivariant
    (M : FourfoldMultilinearAlgebraicAssembly)
    (σ :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ≃ₐ[ℚ]
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers)
    (t₁ t₂ t₃ t₄ :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ]
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers) :
    GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.scalarConjugate σ
        (M.assemble t₁ t₂ t₃ t₄) =
      M.assemble
        (GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.scalarConjugate
          σ t₁)
        (GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.scalarConjugate
          σ t₂)
        (GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.scalarConjugate
          σ t₃)
        (GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.scalarConjugate
          σ t₄) := by
  induction t₁ with
  | tmul a₁ x₁ =>
      induction t₂ with
      | tmul a₂ x₂ =>
          induction t₃ with
          | tmul a₃ x₃ =>
              induction t₄ with
              | tmul a₄ x₄ =>
                  simp only [
                    GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.scalarConjugate_tmul,
                    M.pure_formula
                  ]
                  exact scalarConjugate_canonicalPureAlgebraicAssembly
                    σ a₁ x₁ a₂ x₂ a₃ x₃ a₄ x₄
              | add x y hx hy =>
                  simp [map_add, hx, hy]
          | add x y hx hy =>
              simp [map_add, hx, hy]
      | add x y hx hy =>
          simp [map_add, hx, hy]
  | add x y hx hy =>
      simp [map_add, hx, hy]

/-- Two fourfold Q-multilinear assemblies satisfying the same canonical
pure-factor formula agree on arbitrary factor tensors.

Thus identification of a geometric switched assembly with the canonical model
is reduced to showing only multilinearity and the pure-factor formula. -/
theorem FourfoldMultilinearAlgebraicAssembly.assemble_eq
    (M N : FourfoldMultilinearAlgebraicAssembly)
    (t₁ t₂ t₃ t₄ :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ]
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers) :
    M.assemble t₁ t₂ t₃ t₄ = N.assemble t₁ t₂ t₃ t₄ := by
  induction t₁ with
  | tmul a₁ x₁ =>
      induction t₂ with
      | tmul a₂ x₂ =>
          induction t₃ with
          | tmul a₃ x₃ =>
              induction t₄ with
              | tmul a₄ x₄ =>
                  rw [M.pure_formula, N.pure_formula]
              | add x y hx hy =>
                  simp [map_add, hx, hy]
          | add x y hx hy =>
              simp [map_add, hx, hy]
      | add x y hx hy =>
          simp [map_add, hx, hy]
  | add x y hx hy =>
      simp [map_add, hx, hy]

/-- Extensional equality of the underlying fourfold assembly functions. -/
theorem FourfoldMultilinearAlgebraicAssembly.assemble_fun_eq
    (M N : FourfoldMultilinearAlgebraicAssembly) :
    M.assemble = N.assemble := by
  apply LinearMap.ext
  intro t₁
  apply LinearMap.ext
  intro t₂
  apply LinearMap.ext
  intro t₃
  apply LinearMap.ext
  intro t₄
  exact M.assemble_eq N t₁ t₂ t₃ t₄

/-- A fourfold multilinear assembly with the canonical pure-factor formula
supplies the algebraic assembly/equivariance interfaces locally. -/
def FourfoldMultilinearAlgebraicAssembly.toAlgebraicAssemblyData
    (M : FourfoldMultilinearAlgebraicAssembly)
    (factors :
      CMEmbeddingTransport.FourEmbeddingLineVectors
        (k := ℚ)
        (E :=
          GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers)) :
    FourfoldAlgebraicAssemblyData factors
      (M.assemble
        (factors.vector 0)
        (factors.vector 1)
        (factors.vector 2)
        (factors.vector 3)) where
  assemble := fun v => M.assemble (v 0) (v 1) (v 2) (v 3)
  original_eq := rfl

/-- Exact remaining Galois-equivariance statement for algebraic fourfold
assembly.

Factor transport itself is already local. This interface asks only that
assembling after factorwise scalar transport equals scalar conjugation of the
assembled tensor. -/
structure FourfoldAlgebraicAssemblyEquivariance
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {factors :
      CMEmbeddingTransport.FourEmbeddingLineVectors
        (k := ℚ)
        (E :=
          GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers)}
    {tensor :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ] V}
    (D : FourfoldAlgebraicAssemblyData factors tensor) where
  equivariant :
    ∀ σ :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ≃ₐ[ℚ]
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers,
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.scalarConjugate
          σ tensor =
        D.assemble ((factors.scalarTransport σ).vector)


/-- The same multilinear assembly supplies the previously isolated Galois
equivariance interface without any further mathematical premise. -/
def FourfoldMultilinearAlgebraicAssembly.toAssemblyEquivariance
    (M : FourfoldMultilinearAlgebraicAssembly)
    (factors :
      CMEmbeddingTransport.FourEmbeddingLineVectors
        (k := ℚ)
        (E :=
          GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers)) :
    FourfoldAlgebraicAssemblyEquivariance
      (M.toAlgebraicAssemblyData factors) where
  equivariant := fun σ => by
    simpa [FourfoldMultilinearAlgebraicAssembly.toAlgebraicAssemblyData] using
      M.equivariant σ
        (factors.vector 0)
        (factors.vector 1)
        (factors.vector 2)
        (factors.vector 3)

/-- Abstract fourfold monomial assembly from four canonical embedding-line
factors into the actual complexified cohomological tensor space.

The only non-formal compatibility is that scalar conjugation of the actual
algebraic-number tensor agrees with assembly of the four simultaneously
transported factors. -/
structure FourfoldMonomialAssemblyData
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (factors :
      CMEmbeddingTransport.FourEmbeddingLineVectors
        (k := ℚ)
        (E :=
          GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers))
    (tensor :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ] V) where
  assemble :
    (Fin 4 →
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ]
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers) →
      ℂ ⊗[ℚ] V
  original_eq :
    GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.coefficientInclusion
      tensor =
      assemble factors.vector
  scalar_conjugate_eq :
    ∀ σ :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ≃ₐ[ℚ]
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers,
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.coefficientInclusion
        (GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.scalarConjugate
          σ tensor) =
        assemble ((factors.scalarTransport σ).vector)

/-- Algebraic-level assembly and equivariance produce the previous
complexified monomial-assembly package after coefficient inclusion. -/
def FourfoldAlgebraicAssemblyData.toMonomialAssemblyData
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {factors :
      CMEmbeddingTransport.FourEmbeddingLineVectors
        (k := ℚ)
        (E :=
          GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers)}
    {tensor :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ] V}
    (D : FourfoldAlgebraicAssemblyData factors tensor)
    (N : FourfoldAlgebraicAssemblyEquivariance D) :
    FourfoldMonomialAssemblyData factors tensor where
  assemble := fun v =>
    GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.coefficientInclusion
      (D.assemble v)
  original_eq := by
    rw [D.original_eq]
  scalar_conjugate_eq := fun σ => by
    rw [N.equivariant σ]

/-- A presented canonical fourfold multilinear assembly directly produces
the complexified monomial-assembly package.  The intermediate algebraic
assembly and equivariance records are constructed locally. -/
def FourfoldMultilinearAlgebraicAssembly.toMonomialAssemblyData
    (M : FourfoldMultilinearAlgebraicAssembly)
    (factors :
      CMEmbeddingTransport.FourEmbeddingLineVectors
        (k := ℚ)
        (E :=
          GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers)) :
    FourfoldMonomialAssemblyData factors
      (M.assemble
        (factors.vector 0)
        (factors.vector 1)
        (factors.vector 2)
        (factors.vector 3)) :=
  (M.toAlgebraicAssemblyData factors).toMonomialAssemblyData
    (M.toAssemblyEquivariance factors)

/-- The transported monomial line generated by assembly of the four
simultaneously transported canonical factors. -/
def FourfoldMonomialAssemblyData.transportedLine
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {factors :
      CMEmbeddingTransport.FourEmbeddingLineVectors
        (k := ℚ)
        (E :=
          GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers)}
    {tensor :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ] V}
    (D : FourfoldMonomialAssemblyData factors tensor)
    (σ :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ≃ₐ[ℚ]
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers) :
    Submodule ℂ (ℂ ⊗[ℚ] V) :=
  Submodule.span ℂ {D.assemble ((factors.scalarTransport σ).vector)}

/-- Once scalar conjugation commutes with fourfold assembly, the conjugated
actual tensor belongs to the transported monomial line by construction. -/
theorem FourfoldMonomialAssemblyData.scalarConjugate_mem_transportedLine
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {factors :
      CMEmbeddingTransport.FourEmbeddingLineVectors
        (k := ℚ)
        (E :=
          GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers)}
    {tensor :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ] V}
    (D : FourfoldMonomialAssemblyData factors tensor)
    (σ :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ≃ₐ[ℚ]
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers) :
    GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.coefficientInclusion
      (GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.scalarConjugate
        σ tensor) ∈ D.transportedLine σ := by
  rw [D.scalar_conjugate_eq σ]
  exact Submodule.subset_span (Set.mem_singleton _)

/-- For a presented canonical fourfold multilinear assembly, every scalar
conjugate of the assembled tensor belongs to the corresponding transported
monomial line with no additional naturality premise. -/
theorem FourfoldMultilinearAlgebraicAssembly.scalarConjugate_mem_transportedLine
    (M : FourfoldMultilinearAlgebraicAssembly)
    (factors :
      CMEmbeddingTransport.FourEmbeddingLineVectors
        (k := ℚ)
        (E :=
          GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers))
    (σ :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ≃ₐ[ℚ]
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers) :
    GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.coefficientInclusion
      (GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.scalarConjugate
        σ
        (M.assemble
          (factors.vector 0)
          (factors.vector 1)
          (factors.vector 2)
          (factors.vector 3))) ∈
      (M.toMonomialAssemblyData factors).transportedLine σ := by
  exact (M.toMonomialAssemblyData factors).scalarConjugate_mem_transportedLine σ


section ActualWeightOneFactorTyping

open scoped TensorProduct

/-- One canonical embedding-line vector, interpreted in an actual weight-one
CM realization.

The actual Hodge type is no longer supplied: it follows locally from the
realization's canonical tensor-to-H1 comparison and the canonical eigenspace
membership. -/
structure CanonicalEmbeddingFactorActualTyping
    (E : Type*) [Field E] [NumberField E] [IsCMField E] [IsGalois ℚ E]
    (v : CMNumberFieldIndex.OddSignRow E) where
  X : CMArchimedeanPositivity.SignControlledXi E v
  realization :
    CMWeightOneRiemannRealization.WeightOneCMRealization E v X
  character : E ≃ₐ[ℚ] E
  vector : E ⊗[ℚ] E
  vector_mem :
    vector ∈ CMRegularBaseChange.embeddingEigenspace
      (k := ℚ) character.toAlgHom

/-- The canonical factor has the actual Hodge type dictated by its CM sign. -/
theorem CanonicalEmbeddingFactorActualTyping.actual_type
    {E : Type*} [Field E] [NumberField E] [IsCMField E] [IsGalois ℚ E]
    {v : CMNumberFieldIndex.OddSignRow E}
    (D : CanonicalEmbeddingFactorActualTyping E v) :
    D.realization.IsOfType
      (D.realization.canonicalTensorActualH1Comparison.toActual D.vector)
      (CMEmbeddingLines.typeOfSign (v.value D.character)) := by
  exact
    D.realization.canonicalTensorActualH1Comparison.isOfType_typeOfSign
      D.character D.vector_mem

/-- Four independently realized canonical factors attached to a balanced
four-row CM profile.

The carriers of the four actual H1 realizations may differ; this record keeps
that dependence explicit instead of forcing an artificial common carrier. -/
structure FourCanonicalFactorsActualTyping
    (E : Type*) [Field E] [NumberField E] [IsCMField E] [IsGalois ℚ E]
    (v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E) where
  first : CanonicalEmbeddingFactorActualTyping E v₁
  second : CanonicalEmbeddingFactorActualTyping E v₂
  third : CanonicalEmbeddingFactorActualTyping E v₃
  fourth : CanonicalEmbeddingFactorActualTyping E v₄

/-- Every member of a four-factor actual-typing package carries the genuine
weight-one Hodge type prescribed by its row sign. -/
theorem FourCanonicalFactorsActualTyping.all_actual_types
    {E : Type*} [Field E] [NumberField E] [IsCMField E] [IsGalois ℚ E]
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E}
    (D : FourCanonicalFactorsActualTyping E v₁ v₂ v₃ v₄) :
    D.first.realization.IsOfType
        (D.first.realization.canonicalTensorActualH1Comparison.toActual
          D.first.vector)
        (CMEmbeddingLines.typeOfSign (v₁.value D.first.character)) ∧
    D.second.realization.IsOfType
        (D.second.realization.canonicalTensorActualH1Comparison.toActual
          D.second.vector)
        (CMEmbeddingLines.typeOfSign (v₂.value D.second.character)) ∧
    D.third.realization.IsOfType
        (D.third.realization.canonicalTensorActualH1Comparison.toActual
          D.third.vector)
        (CMEmbeddingLines.typeOfSign (v₃.value D.third.character)) ∧
    D.fourth.realization.IsOfType
        (D.fourth.realization.canonicalTensorActualH1Comparison.toActual
          D.fourth.vector)
        (CMEmbeddingLines.typeOfSign (v₄.value D.fourth.character)) :=
  ⟨D.first.actual_type,
    D.second.actual_type,
    D.third.actual_type,
    D.fourth.actual_type⟩

end ActualWeightOneFactorTyping

/-- Explicit common complex tensor target for four independently realized
weight-one factors. -/
abbrev FourfoldActualTensor
    {E : Type*} [Field E] [NumberField E] [IsCMField E] [IsGalois ℚ E]
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E}
    (D : FourCanonicalFactorsActualTyping E v₁ v₂ v₃ v₄) :=
  ((D.first.realization.H1C ⊗[ℂ] D.second.realization.H1C)
      ⊗[ℂ] D.third.realization.H1C)
    ⊗[ℂ] D.fourth.realization.H1C

/-- Pure fourfold tensor in the explicit common target. -/
def fourfoldActualPureTensor
    {E : Type*} [Field E] [NumberField E] [IsCMField E] [IsGalois ℚ E]
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E}
    (D : FourCanonicalFactorsActualTyping E v₁ v₂ v₃ v₄)
    (a : D.first.realization.H1C)
    (b : D.second.realization.H1C)
    (c : D.third.realization.H1C)
    (d : D.fourth.realization.H1C) :
    FourfoldActualTensor D :=
  ((a ⊗ₜ[ℂ] b) ⊗ₜ[ℂ] c) ⊗ₜ[ℂ] d

/-- Alignment of four actual factors with the balanced switch pattern:
the first two characters are evaluated at g and the last two at the conjugate
character. -/
structure FourCanonicalFactorsSwitchAlignment
    {E : Type*} [Field E] [NumberField E] [IsCMField E] [IsGalois ℚ E]
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E}
    (D : FourCanonicalFactorsActualTyping E v₁ v₂ v₃ v₄) where
  g : E ≃ₐ[ℚ] E
  balance : CMNumberFieldIndex.FourBalance E v₁ v₂ v₃ v₄
  first_character : D.first.character = g
  second_character : D.second.character = g
  third_character :
    D.third.character = (CMNumberFieldIndex.centralInvolution E).conj g
  fourth_character :
    D.fourth.character = (CMNumberFieldIndex.centralInvolution E).conj g

/-- The existing local FourBalance count gives the p-index sum for the actual
four factor labels after switch-character alignment. -/
theorem FourCanonicalFactorsSwitchAlignment.p_two
    {E : Type*} [Field E] [NumberField E] [IsCMField E] [IsGalois ℚ E]
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E}
    {D : FourCanonicalFactorsActualTyping E v₁ v₂ v₃ v₄}
    (A : FourCanonicalFactorsSwitchAlignment D) :
    CMEmbeddingLines.pIndex
          (CMEmbeddingLines.typeOfSign (v₁.value D.first.character)) +
      CMEmbeddingLines.pIndex
          (CMEmbeddingLines.typeOfSign (v₂.value D.second.character)) +
      CMEmbeddingLines.pIndex
          (CMEmbeddingLines.typeOfSign (v₃.value D.third.character)) +
      CMEmbeddingLines.pIndex
          (CMEmbeddingLines.typeOfSign (v₄.value D.fourth.character)) = 2 := by
  have h :=
    CMFourBalance.fourBalance_holomorphicCount
      v₁.toOddSignRow v₂.toOddSignRow v₃.toOddSignRow v₄.toOddSignRow
      A.balance A.g
  simpa [A.first_character, A.second_character,
    A.third_character, A.fourth_character,
    CMEmbeddingLines.pIndex_typeOfSign] using h

/-- The same aligned labels have q-index sum two. -/
theorem FourCanonicalFactorsSwitchAlignment.q_two
    {E : Type*} [Field E] [NumberField E] [IsCMField E] [IsGalois ℚ E]
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E}
    {D : FourCanonicalFactorsActualTyping E v₁ v₂ v₃ v₄}
    (A : FourCanonicalFactorsSwitchAlignment D) :
    CMEmbeddingLines.qIndex
          (CMEmbeddingLines.typeOfSign (v₁.value D.first.character)) +
      CMEmbeddingLines.qIndex
          (CMEmbeddingLines.typeOfSign (v₂.value D.second.character)) +
      CMEmbeddingLines.qIndex
          (CMEmbeddingLines.typeOfSign (v₃.value D.third.character)) +
      CMEmbeddingLines.qIndex
          (CMEmbeddingLines.typeOfSign (v₄.value D.fourth.character)) = 2 := by
  rw [
    CMEmbeddingLines.qIndex_typeOfSign_of_isSign
      _ (v₁.isSign D.first.character),
    CMEmbeddingLines.qIndex_typeOfSign_of_isSign
      _ (v₂.isSign D.second.character),
    CMEmbeddingLines.qIndex_typeOfSign_of_isSign
      _ (v₃.isSign D.third.character),
    CMEmbeddingLines.qIndex_typeOfSign_of_isSign
      _ (v₄.isSign D.fourth.character)
  ]
  have hp := A.p_two
  linarith

/-- Standard Hodge tensor-product rule for four independently realized
weight-one factors.

This is the exact structural theorem needed after the four individual factors
have acquired genuine Hodge types. -/
structure FourfoldActualHodgeTensorRule
    {E : Type*} [Field E] [NumberField E] [IsCMField E] [IsGalois ℚ E]
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E}
    (D : FourCanonicalFactorsActualTyping E v₁ v₂ v₃ v₄) where
  H22 : Submodule ℂ (FourfoldActualTensor D)
  pureTensor_mem_H22 :
    ∀ (a : D.first.realization.H1C)
      (b : D.second.realization.H1C)
      (c : D.third.realization.H1C)
      (d : D.fourth.realization.H1C)
      (τ₁ τ₂ τ₃ τ₄ : CMEmbeddingLines.WeightOneHodgeType),
      D.first.realization.IsOfType a τ₁ →
      D.second.realization.IsOfType b τ₂ →
      D.third.realization.IsOfType c τ₃ →
      D.fourth.realization.IsOfType d τ₄ →
      CMEmbeddingLines.pIndex τ₁ + CMEmbeddingLines.pIndex τ₂ +
          CMEmbeddingLines.pIndex τ₃ + CMEmbeddingLines.pIndex τ₄ = 2 →
      CMEmbeddingLines.qIndex τ₁ + CMEmbeddingLines.qIndex τ₂ +
          CMEmbeddingLines.qIndex τ₃ + CMEmbeddingLines.qIndex τ₄ = 2 →
      fourfoldActualPureTensor D a b c d ∈ H22

/-- Once the four characters are aligned with the balanced switch pattern,
the standard actual Hodge tensor rule places the canonical pure tensor in
H^(2,2) with no further type-count assumptions. -/
theorem FourfoldActualHodgeTensorRule.canonicalPureTensor_mem_H22
    {E : Type*} [Field E] [NumberField E] [IsCMField E] [IsGalois ℚ E]
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E}
    {D : FourCanonicalFactorsActualTyping E v₁ v₂ v₃ v₄}
    (R : FourfoldActualHodgeTensorRule D)
    (A : FourCanonicalFactorsSwitchAlignment D) :
    fourfoldActualPureTensor D
      (D.first.realization.canonicalTensorActualH1Comparison.toActual
        D.first.vector)
      (D.second.realization.canonicalTensorActualH1Comparison.toActual
        D.second.vector)
      (D.third.realization.canonicalTensorActualH1Comparison.toActual
        D.third.vector)
      (D.fourth.realization.canonicalTensorActualH1Comparison.toActual
        D.fourth.vector) ∈ R.H22 := by
  apply R.pureTensor_mem_H22
    _ _ _ _
    (CMEmbeddingLines.typeOfSign (v₁.value D.first.character))
    (CMEmbeddingLines.typeOfSign (v₂.value D.second.character))
    (CMEmbeddingLines.typeOfSign (v₃.value D.third.character))
    (CMEmbeddingLines.typeOfSign (v₄.value D.fourth.character))
  · exact D.first.actual_type
  · exact D.second.actual_type
  · exact D.third.actual_type
  · exact D.fourth.actual_type
  · exact A.p_two
  · exact A.q_two

/-- Comparison from the explicit actual fourfold H1 tensor target to the
descent-side complexified tensor space.

This is the precise coefficient/change-of-realization bridge.  It does not
assert algebraicity. -/
structure ActualFourfoldToMonomialComparison
    {E : Type*} [Field E] [NumberField E] [IsCMField E] [IsGalois ℚ E]
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E}
    {D : FourCanonicalFactorsActualTyping E v₁ v₂ v₃ v₄}
    (R : FourfoldActualHodgeTensorRule D)
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)) where
  compare : FourfoldActualTensor D →ₗ[ℂ] (ℂ ⊗[ℚ] V)
  H22_le :
    R.H22.map compare ≤ hodgeSubspace

/-- The comparison carries every actual H^(2,2) class into the descent-side
Hodge subspace. -/
theorem ActualFourfoldToMonomialComparison.mem_hodge_of_mem_H22
    {E : Type*} [Field E] [NumberField E] [IsCMField E] [IsGalois ℚ E]
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E}
    {D : FourCanonicalFactorsActualTyping E v₁ v₂ v₃ v₄}
    {R : FourfoldActualHodgeTensorRule D}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)}
    (C : ActualFourfoldToMonomialComparison R hodgeSubspace)
    {z : FourfoldActualTensor D}
    (hz : z ∈ R.H22) :
    C.compare z ∈ hodgeSubspace := by
  apply C.H22_le
  exact Submodule.mem_map.mpr ⟨z, hz, rfl⟩

/-- Identification of one assembled monomial generator with the image of the
explicit actual fourfold pure tensor. -/
structure ActualFourfoldMonomialGeneratorIdentification
    {E : Type*} [Field E] [NumberField E] [IsCMField E] [IsGalois ℚ E]
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E}
    {D : FourCanonicalFactorsActualTyping E v₁ v₂ v₃ v₄}
    {R : FourfoldActualHodgeTensorRule D}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)}
    (C : ActualFourfoldToMonomialComparison R hodgeSubspace)
    (assembledGenerator : ℂ ⊗[ℚ] V) where
  alignment : FourCanonicalFactorsSwitchAlignment D
  assembled_eq :
    assembledGenerator =
      C.compare
        (fourfoldActualPureTensor D
          (D.first.realization.canonicalTensorActualH1Comparison.toActual
            D.first.vector)
          (D.second.realization.canonicalTensorActualH1Comparison.toActual
            D.second.vector)
          (D.third.realization.canonicalTensorActualH1Comparison.toActual
            D.third.vector)
          (D.fourth.realization.canonicalTensorActualH1Comparison.toActual
            D.fourth.vector))

/-- Actual H^(2,2) membership plus the comparison/identification bridge gives
descent-side Hodge membership of the assembled monomial generator locally. -/
theorem ActualFourfoldMonomialGeneratorIdentification.assembled_mem_hodge
    {E : Type*} [Field E] [NumberField E] [IsCMField E] [IsGalois ℚ E]
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E}
    {D : FourCanonicalFactorsActualTyping E v₁ v₂ v₃ v₄}
    {R : FourfoldActualHodgeTensorRule D}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)}
    {C : ActualFourfoldToMonomialComparison R hodgeSubspace}
    {assembledGenerator : ℂ ⊗[ℚ] V}
    (I : ActualFourfoldMonomialGeneratorIdentification C assembledGenerator) :
    assembledGenerator ∈ hodgeSubspace := by
  rw [I.assembled_eq]
  exact C.mem_hodge_of_mem_H22
    (R.canonicalPureTensor_mem_H22 I.alignment)

/-- Finite Galois carrier for one algebraic-number tensor, obtained from
the already-local arbitrary-Galois descent infrastructure. -/
structure FiniteGaloisTensorCarrier
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (t : AlgebraicNumbers ⊗[ℚ] V) where
  L : FiniteGaloisIntermediateField ℚ AlgebraicNumbers
  tensor : L ⊗[ℚ] V
  inclusion_eq :
    coefficientInclusion tensor = t

/-- Every algebraic-number tensor has a finite Galois carrier. -/
noncomputable def finiteGaloisTensorCarrier
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (t : AlgebraicNumbers ⊗[ℚ] V) :
    FiniteGaloisTensorCarrier t := by
  letI : IsAlgClosure ℚ AlgebraicNumbers :=
    algebraicClosure.isAlgClosure ℚ ℂ
  obtain ⟨L, u, hu⟩ :=
    tensor_defined_over_finiteGalois t
  exact ⟨L, u, hu⟩

/-- Absolute scalar conjugation restricts through the finite Galois carrier
chosen for a tensor. -/
theorem FiniteGaloisTensorCarrier.scalarConjugate_restrict
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {t : AlgebraicNumbers ⊗[ℚ] V}
    (C : FiniteGaloisTensorCarrier t)
    (σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers) :
    coefficientInclusion
        (GRWTSK.LinearAlgebra.TensorProduct.RationalScalarDescent.scalarConjugate
          (σ.restrictNormal C.L) C.tensor) =
      GRWTSK.LinearAlgebra.TensorProduct.RationalScalarDescent.scalarConjugate
        σ t := by
  rw [← C.inclusion_eq]
  exact
    GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.scalarConjugate_restrict
      C.L σ C.tensor

/-- Finite Galois intermediate field of AlgebraicNumbers carrying a
CM-field structure.  This is the correct field object for a uniform CM
realization of one switched tensor. -/
structure CMGaloisIntermediateField where
  carrier : FiniteGaloisIntermediateField ℚ AlgebraicNumbers
  [isCMField : IsCMField carrier]

instance (E : CMGaloisIntermediateField) :
    FiniteDimensional ℚ E.carrier :=
  inferInstance

instance (E : CMGaloisIntermediateField) :
    IsGalois ℚ E.carrier :=
  inferInstance

instance (E : CMGaloisIntermediateField) :
    IsCMField E.carrier :=
  E.isCMField

/-- Include both tensor factors from one finite Galois CM intermediate
field into AlgebraicNumbers. -/
def CMGaloisIntermediateField.factorTensorInclusion
    (E : CMGaloisIntermediateField) :
    (E.carrier ⊗[ℚ] E.carrier) →ₗ[ℚ]
      (AlgebraicNumbers ⊗[ℚ] AlgebraicNumbers) :=
  TensorProduct.map
    E.carrier.val.toLinearMap
    E.carrier.val.toLinearMap

@[simp]
theorem CMGaloisIntermediateField.factorTensorInclusion_tmul
    (E : CMGaloisIntermediateField)
    (a x : E.carrier) :
    E.factorTensorInclusion (a ⊗ₜ[ℚ] x) =
      (a.1 : AlgebraicNumbers) ⊗ₜ[ℚ] (x.1 : AlgebraicNumbers) := by
  simp [CMGaloisIntermediateField.factorTensorInclusion]

/-- Inclusion of a finite Galois CM factor tensor commutes with absolute
scalar conjugation. -/
theorem CMGaloisIntermediateField.factorTensorInclusion_scalarConjugate
    (E : CMGaloisIntermediateField)
    (σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers)
    (t : E.carrier ⊗[ℚ] E.carrier) :
    E.factorTensorInclusion
        (GRWTSK.LinearAlgebra.TensorProduct.RationalScalarDescent.scalarConjugate
          (σ.restrictNormal E.carrier) t) =
      GRWTSK.LinearAlgebra.TensorProduct.RationalScalarDescent.scalarConjugate
        σ (E.factorTensorInclusion t) := by
  induction t with
  | tmul a x =>
      simp [
        CMGaloisIntermediateField.factorTensorInclusion,
        GRWTSK.LinearAlgebra.TensorProduct.RationalScalarDescent.scalarConjugate_tmul,
        AlgEquiv.restrictNormal_commutes
      ]
  | add x y hx hy =>
      simp [hx, hy]

/-- Four canonical embedding-line factors supported on one finite Galois CM
intermediate field. -/
structure CMFourFactorSupport
    (factors :
      CMEmbeddingTransport.FourEmbeddingLineVectors
        (k := ℚ) (E := AlgebraicNumbers)) where
  E : CMGaloisIntermediateField
  localVector : Fin 4 → E.carrier ⊗[ℚ] E.carrier
  localCharacter : Fin 4 → E.carrier ≃ₐ[ℚ] E.carrier
  globalCharacter : Fin 4 → AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers
  globalCharacter_toAlgHom :
    ∀ r, (globalCharacter r).toAlgHom = factors.character r
  local_mem :
    ∀ r,
      localVector r ∈
        CMRegularBaseChange.embeddingEigenspace
          (k := ℚ) (localCharacter r).toAlgHom
  vector_inclusion :
    ∀ r, E.factorTensorInclusion (localVector r) = factors.vector r
  character_restriction :
    ∀ r, (globalCharacter r).restrictNormal E.carrier = localCharacter r

/-- Scalar transport of a locally supported factor remains inside the same
finite Galois CM carrier. -/
def CMFourFactorSupport.scalarTransportLocal
    {factors :
      CMEmbeddingTransport.FourEmbeddingLineVectors
        (k := ℚ) (E := AlgebraicNumbers)}
    (S : CMFourFactorSupport factors)
    (σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers) :
    Fin 4 → S.E.carrier ⊗[ℚ] S.E.carrier :=
  fun r =>
    GRWTSK.LinearAlgebra.TensorProduct.RationalScalarDescent.scalarConjugate
      (σ.restrictNormal S.E.carrier) (S.localVector r)

/-- Global scalar transport of each supported factor is the inclusion of
the corresponding local scalar transport in the same CM carrier. -/
theorem CMFourFactorSupport.scalarTransportLocal_inclusion
    {factors :
      CMEmbeddingTransport.FourEmbeddingLineVectors
        (k := ℚ) (E := AlgebraicNumbers)}
    (S : CMFourFactorSupport factors)
    (σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers)
    (r : Fin 4) :
    S.E.factorTensorInclusion (S.scalarTransportLocal σ r) =
      (factors.scalarTransport σ).vector r := by
  rw [CMFourFactorSupport.scalarTransportLocal,
    S.E.factorTensorInclusion_scalarConjugate,
    S.vector_inclusion]
  rfl

/-- Global four-factor embedding-line data together with its chosen common
finite Galois CM support.

This is the preferred construction boundary: instead of first choosing
arbitrary global factors over AlgebraicNumbers and later proving that they
descend to a CM field, the global factors and their common CM support are
carried together. -/
structure SupportedCMFourEmbeddingLineVectors where
  global :
    CMEmbeddingTransport.FourEmbeddingLineVectors
      (k := ℚ) (E := AlgebraicNumbers)
  support : CMFourFactorSupport global

/-- Scalar transport preserves the same chosen common finite Galois CM
support.  Only the local vectors change by the restricted scalar
automorphism. -/
def SupportedCMFourEmbeddingLineVectors.scalarTransport
    (D : SupportedCMFourEmbeddingLineVectors)
    (σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers) :
    SupportedCMFourEmbeddingLineVectors where
  global := D.global.scalarTransport σ
  support := {
    E := D.support.E
    localVector := D.support.scalarTransportLocal σ
    localCharacter := fun r =>
      (σ.restrictNormal D.support.E.carrier) *
        D.support.localCharacter r
    globalCharacter := fun r => σ * D.support.globalCharacter r
    globalCharacter_toAlgHom := fun r => by
      rw [CMEmbeddingTransport.FourEmbeddingLineVectors.scalarTransport_character]
      rw [← D.support.globalCharacter_toAlgHom r]
      ext x
      rfl
    local_mem := fun r => by
      rw [← CMEmbeddingTransport.transportedCharacter_eq_mul
        (σ.restrictNormal D.support.E.carrier)
        (D.support.localCharacter r)]
      exact
        CMEmbeddingTransport.scalarConjugate_mem_embeddingEigenspace
          (σ.restrictNormal D.support.E.carrier)
          (D.support.localCharacter r).toAlgHom
          (D.support.local_mem r)
    vector_inclusion := fun r =>
      D.support.scalarTransportLocal_inclusion σ r
    character_restriction := fun r => by
      ext x
      apply Subtype.ext
      rw [AlgEquiv.restrictNormal_commutes]
      rw [AlgEquiv.restrictNormal_commutes]
      rw [D.support.character_restriction r]
      rfl
  }

/-- The transported global vectors remain represented by local vectors in the
same common finite Galois CM carrier. -/
theorem SupportedCMFourEmbeddingLineVectors.scalarTransport_support_field
    (D : SupportedCMFourEmbeddingLineVectors)
    (σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers) :
    (D.scalarTransport σ).support.E = D.support.E :=
  rfl

/-- Four canonical embedding-line factors kept entirely over one finite
Galois CM field.

This is the correct finite-level object for the switch construction.  No claim
is made that the individual finite-level eigenvectors embed as eigenvectors for
the regular action of all AlgebraicNumbers. -/
structure CMFiniteFourEmbeddingLineVectors
    (E : CMGaloisIntermediateField) where
  character : Fin 4 → E.carrier ≃ₐ[ℚ] E.carrier
  vector : Fin 4 → E.carrier ⊗[ℚ] E.carrier
  mem :
    ∀ r,
      vector r ∈
        CMRegularBaseChange.embeddingEigenspace
          (k := ℚ) (character r).toAlgHom

/-- Scalar transport of finite-level CM factors by restriction of an absolute
automorphism remains finite-level over the same field. -/
def CMFiniteFourEmbeddingLineVectors.scalarTransport
    {E : CMGaloisIntermediateField}
    (D : CMFiniteFourEmbeddingLineVectors E)
    (σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers) :
    CMFiniteFourEmbeddingLineVectors E where
  character := fun r => (σ.restrictNormal E.carrier) * D.character r
  vector := fun r =>
    GRWTSK.LinearAlgebra.TensorProduct.RationalScalarDescent.scalarConjugate
      (σ.restrictNormal E.carrier) (D.vector r)
  mem := fun r => by
    rw [← CMEmbeddingTransport.transportedCharacter_eq_mul
      (σ.restrictNormal E.carrier) (D.character r)]
    exact
      CMEmbeddingTransport.scalarConjugate_mem_embeddingEigenspace
        (σ.restrictNormal E.carrier)
        (D.character r).toAlgHom
        (D.mem r)

/-- Actual weight-one realization data for four finite-level embedding-line
factors over one fixed finite Galois CM field. -/
structure CMFiniteFourFactorActualTyping
    (E : CMGaloisIntermediateField)
    (factors : CMFiniteFourEmbeddingLineVectors E)
    (v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E.carrier) where
  first :
    CanonicalEmbeddingFactorActualTyping E.carrier v₁
  second :
    CanonicalEmbeddingFactorActualTyping E.carrier v₂
  third :
    CanonicalEmbeddingFactorActualTyping E.carrier v₃
  fourth :
    CanonicalEmbeddingFactorActualTyping E.carrier v₄
  first_character : first.character = factors.character 0
  second_character : second.character = factors.character 1
  third_character : third.character = factors.character 2
  fourth_character : fourth.character = factors.character 3
  first_vector : first.vector = factors.vector 0
  second_vector : second.vector = factors.vector 1
  third_vector : third.vector = factors.vector 2
  fourth_vector : fourth.vector = factors.vector 3

/-- Switch alignment for finite-level factors on one fixed CM field. -/
structure CMFiniteFourFactorSwitchAlignment
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E.carrier}
    (D : CMFiniteFourFactorActualTyping E factors v₁ v₂ v₃ v₄) where
  g : E.carrier ≃ₐ[ℚ] E.carrier
  balance : CMNumberFieldIndex.FourBalance E.carrier v₁ v₂ v₃ v₄
  first_at_g : factors.character 0 = g
  second_at_g : factors.character 1 = g
  third_at_conj :
    factors.character 2 =
      (CMNumberFieldIndex.centralInvolution E.carrier).conj g
  fourth_at_conj :
    factors.character 3 =
      (CMNumberFieldIndex.centralInvolution E.carrier).conj g

/-- Convert the finite-level actual-typing package to the existing four-factor
actual H1 package. -/
def CMFiniteFourFactorActualTyping.toActualTyping
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E.carrier}
    (D : CMFiniteFourFactorActualTyping E factors v₁ v₂ v₃ v₄) :
    FourCanonicalFactorsActualTyping E.carrier v₁ v₂ v₃ v₄ where
  first := D.first
  second := D.second
  third := D.third
  fourth := D.fourth

/-- Finite switch alignment converts to the existing actual-H1 alignment. -/
def CMFiniteFourFactorSwitchAlignment.toActualAlignment
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E.carrier}
    {D : CMFiniteFourFactorActualTyping E factors v₁ v₂ v₃ v₄}
    (A : CMFiniteFourFactorSwitchAlignment D) :
    FourCanonicalFactorsSwitchAlignment D.toActualTyping where
  g := A.g
  balance := A.balance
  first_character := by
    rw [D.first_character, A.first_at_g]
  second_character := by
    rw [D.second_character, A.second_at_g]
  third_character := by
    rw [D.third_character, A.third_at_conj]
  fourth_character := by
    rw [D.fourth_character, A.fourth_at_conj]

/-- The canonical pure tensor of four finite-level realized factors lies in
actual H^(2,2) once the finite switch pattern is aligned. -/
theorem CMFiniteFourFactorSwitchAlignment.canonicalPureTensor_mem_H22
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E.carrier}
    {D : CMFiniteFourFactorActualTyping E factors v₁ v₂ v₃ v₄}
    (A : CMFiniteFourFactorSwitchAlignment D)
    (R : FourfoldActualHodgeTensorRule D.toActualTyping) :
    fourfoldActualPureTensor D.toActualTyping
      (D.first.realization.canonicalTensorActualH1Comparison.toActual
        D.first.vector)
      (D.second.realization.canonicalTensorActualH1Comparison.toActual
        D.second.vector)
      (D.third.realization.canonicalTensorActualH1Comparison.toActual
        D.third.vector)
      (D.fourth.realization.canonicalTensorActualH1Comparison.toActual
        D.fourth.vector) ∈ R.H22 :=
  R.canonicalPureTensor_mem_H22 A.toActualAlignment

/-!
### Fixed-field comparison obstruction

The finite assembly below stores `assemble` merely as a function from
four finite embedding-line tensor inputs to a coefficient tensor. Its
`scalar_transport_eq` concerns only one chosen tuple and its conjugates.
Neither condition establishes additivity or rational multilinearity in
the four input slots. More importantly, the actual fourfold tensor consists
of complex H1 realizations, whereas the assembly takes finite field-level
tensor vectors: the file contains no cohomological comparison commuting with
these different carriers.

Consequently `CMFiniteFourfoldAssembly` cannot by itself supply a canonical
complex-linear map `FourfoldActualTensor →ₗ[ℂ] (ℂ ⊗[ℚ] V)`.
A genuine constructor must receive (or establish) compatible rational
multilinear assembly maps, four actual-H1 comparison maps, and a commuting
pure-tensor equation. None is inferred from scalar transport alone.

In particular, a pointwise image-membership witness is a conditional
criterion, not an independent geometric construction; proving its two
fields directly from the desired generator membership would be circular.
-/

/-- The concrete rational target for the finite canonical fourfold formula.
Unlike an arbitrary target V, its four vector slots are explicit. -/
abbrev CMFiniteCanonicalVectorTarget (E : CMGaloisIntermediateField) :=
  (((E.carrier ⊗[ℚ] E.carrier) ⊗[ℚ] E.carrier) ⊗[ℚ] E.carrier)

/-- Canonical finite-CM pure-factor formula, prior to extension of
coefficients into algebraic numbers. The coefficient entries multiply in
E while the four vector entries remain a rational tensor. -/
def canonicalFinitePureAssembly
    (E : CMGaloisIntermediateField)
    (a₁ x₁ a₂ x₂ a₃ x₃ a₄ x₄ : E.carrier) :
    E.carrier ⊗[ℚ] CMFiniteCanonicalVectorTarget E :=
  (a₁ * a₂ * a₃ * a₄) ⊗ₜ[ℚ]
    (((x₁ ⊗ₜ[ℚ] x₂) ⊗ₜ[ℚ] x₃) ⊗ₜ[ℚ] x₄)

/-- The proposed pure-factor rule is additive in its first coefficient
entry. This is a local consistency check for extending the rule through
the first rational tensor-product universal property. -/
theorem canonicalFinitePureAssembly_add_first
    (E : CMGaloisIntermediateField)
    (a b x₁ a₂ x₂ a₃ x₃ a₄ x₄ : E.carrier) :
    canonicalFinitePureAssembly E (a + b) x₁ a₂ x₂ a₃ x₃ a₄ x₄ =
      canonicalFinitePureAssembly E a x₁ a₂ x₂ a₃ x₃ a₄ x₄ +
      canonicalFinitePureAssembly E b x₁ a₂ x₂ a₃ x₃ a₄ x₄ := by
  simp [canonicalFinitePureAssembly, add_mul, TensorProduct.add_tmul]

/-- The same pure-factor rule is additive in the first vector entry. -/
theorem canonicalFinitePureAssembly_add_first_vector
    (E : CMGaloisIntermediateField)
    (a₁ x y a₂ x₂ a₃ x₃ a₄ x₄ : E.carrier) :
    canonicalFinitePureAssembly E a₁ (x + y) a₂ x₂ a₃ x₃ a₄ x₄ =
      canonicalFinitePureAssembly E a₁ x a₂ x₂ a₃ x₃ a₄ x₄ +
      canonicalFinitePureAssembly E a₁ y a₂ x₂ a₃ x₃ a₄ x₄ := by
  simp [canonicalFinitePureAssembly, TensorProduct.add_tmul,
    TensorProduct.tmul_add]

/-- Additivity in finite pure-factor coefficient slot 2. -/
theorem canonicalFinitePureAssembly_add_coefficient_2
    (E : CMGaloisIntermediateField)
    (u v a1 x1 a3 x3 a4 x4 x2 : E.carrier) :
    canonicalFinitePureAssembly E a1 x1 (u + v) x2 a3 x3 a4 x4 =
      canonicalFinitePureAssembly E a1 x1 u x2 a3 x3 a4 x4 +
      canonicalFinitePureAssembly E a1 x1 v x2 a3 x3 a4 x4 := by
  simp [canonicalFinitePureAssembly, add_mul, mul_add,
    TensorProduct.add_tmul]

/-- Additivity in finite pure-factor coefficient slot 3. -/
theorem canonicalFinitePureAssembly_add_coefficient_3
    (E : CMGaloisIntermediateField)
    (u v a1 x1 a2 x2 a4 x4 x3 : E.carrier) :
    canonicalFinitePureAssembly E a1 x1 a2 x2 (u + v) x3 a4 x4 =
      canonicalFinitePureAssembly E a1 x1 a2 x2 u x3 a4 x4 +
      canonicalFinitePureAssembly E a1 x1 a2 x2 v x3 a4 x4 := by
  simp [canonicalFinitePureAssembly, add_mul, mul_add,
    TensorProduct.add_tmul]

/-- Additivity in finite pure-factor coefficient slot 4. -/
theorem canonicalFinitePureAssembly_add_coefficient_4
    (E : CMGaloisIntermediateField)
    (u v a1 x1 a2 x2 a3 x3 x4 : E.carrier) :
    canonicalFinitePureAssembly E a1 x1 a2 x2 a3 x3 (u + v) x4 =
      canonicalFinitePureAssembly E a1 x1 a2 x2 a3 x3 u x4 +
      canonicalFinitePureAssembly E a1 x1 a2 x2 a3 x3 v x4 := by
  simp [canonicalFinitePureAssembly, add_mul, mul_add,
    TensorProduct.add_tmul]

/-- Finite-level fourfold assembly over a fixed finite Galois CM field.

The output keeps one coefficient factor in E and moves the four vector entries
into an arbitrary rational target V.  Only after this finite-level assembly is
formed should coefficients be extended to AlgebraicNumbers. -/
structure CMFiniteFourfoldAssembly
    {E : CMGaloisIntermediateField}
    (factors : CMFiniteFourEmbeddingLineVectors E)
    {V : Type*} [AddCommGroup V] [Module ℚ V] where
  assemble :
    (Fin 4 → E.carrier ⊗[ℚ] E.carrier) →
      E.carrier ⊗[ℚ] V
  tensor :
    E.carrier ⊗[ℚ] V
  original_eq :
    tensor = assemble factors.vector
  scalar_transport_eq :
    ∀ σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers,
      GRWTSK.LinearAlgebra.TensorProduct.RationalScalarDescent.scalarConjugate
          (σ.restrictNormal E.carrier) tensor =
        assemble ((factors.scalarTransport σ).vector)

/-- Explicit rational multilinearity of the finite four-slot assembly.
This strengthens the function-valued interface without pretending that
a geometric assembly with these properties has been constructed. -/
structure CMFiniteAssemblyMultilinearity
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (D : CMFiniteFourfoldAssembly factors) where
  add_slot :
    ∀ (i : Fin 4) (x y : E.carrier ⊗[ℚ] E.carrier)
      (f : Fin 4 → E.carrier ⊗[ℚ] E.carrier),
      D.assemble (Function.update f i (x + y)) =
        D.assemble (Function.update f i x) +
          D.assemble (Function.update f i y)
  smul_slot :
    ∀ (i : Fin 4) (a : ℚ) (x : E.carrier ⊗[ℚ] E.carrier)
      (f : Fin 4 → E.carrier ⊗[ℚ] E.carrier),
      D.assemble (Function.update f i (a • x)) =
        a • D.assemble (Function.update f i x)

/-- Additivity and rational homogeneity are exposed independently for each
slot; these equations are the precise new supplier obligations. -/
theorem CMFiniteAssemblyMultilinearity.add_at
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {D : CMFiniteFourfoldAssembly factors}
    (M : CMFiniteAssemblyMultilinearity D)
    (i : Fin 4) (f : Fin 4 → E.carrier ⊗[ℚ] E.carrier)
    (x y : E.carrier ⊗[ℚ] E.carrier) :
    D.assemble (Function.update f i (x + y)) =
      D.assemble (Function.update f i x) +
        D.assemble (Function.update f i y) :=
  M.add_slot i x y f

/-- Rational homogeneity forces an assembly to vanish whenever an input
slot vanishes. Unlike a constant-zero example, this applies to every
proposed assembly satisfying the multilinearity certificate. -/
theorem CMFiniteAssemblyMultilinearity.zero_at
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {D : CMFiniteFourfoldAssembly factors}
    (M : CMFiniteAssemblyMultilinearity D)
    (i : Fin 4)
    (f : Fin 4 → E.carrier ⊗[ℚ] E.carrier) :
    D.assemble (Function.update f i 0) = 0 := by
  have h := M.smul_slot i (0 : ℚ) (0 : E.carrier ⊗[ℚ] E.carrier) f
  simpa using h

/-- Rational homogeneity, specialized to arbitrary input replacement. -/
theorem CMFiniteAssemblyMultilinearity.smul_at
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {D : CMFiniteFourfoldAssembly factors}
    (M : CMFiniteAssemblyMultilinearity D)
    (i : Fin 4) (f : Fin 4 → E.carrier ⊗[ℚ] E.carrier)
    (q : ℚ) (x : E.carrier ⊗[ℚ] E.carrier) :
    D.assemble (Function.update f i (q • x)) =
      q • D.assemble (Function.update f i x) :=
  M.smul_slot i q x f

/-- Four nested rational linear maps give a concrete representation of
the finite-CM fourfold operation. Unlike an arbitrary function, the
multilinearity of each slot is encoded directly by the map types.

The remaining equivariance equation is explicitly retained: rational
multilinearity alone does not imply compatibility with scalar Galois
conjugation. -/
structure CMFiniteNestedLinearAssembly
    {E : CMGaloisIntermediateField}
    (factors : CMFiniteFourEmbeddingLineVectors E)
    {V : Type*} [AddCommGroup V] [Module ℚ V] where
  map :
    (E.carrier ⊗[ℚ] E.carrier) →ₗ[ℚ]
      (E.carrier ⊗[ℚ] E.carrier) →ₗ[ℚ]
      (E.carrier ⊗[ℚ] E.carrier) →ₗ[ℚ]
      (E.carrier ⊗[ℚ] E.carrier) →ₗ[ℚ]
      (E.carrier ⊗[ℚ] V)
  conjugate_at_factors :
    ∀ σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers,
      GRWTSK.LinearAlgebra.TensorProduct.RationalScalarDescent.scalarConjugate
          (σ.restrictNormal E.carrier)
          (map (factors.vector 0) (factors.vector 1)
            (factors.vector 2) (factors.vector 3)) =
        map ((factors.scalarTransport σ).vector 0)
          ((factors.scalarTransport σ).vector 1)
          ((factors.scalarTransport σ).vector 2)
          ((factors.scalarTransport σ).vector 3)

/-- Turn a nested-linear finite assembly into the existing fixed-field
assembly, with its tensor and Galois-transport equation derived from the
presentation. No geometric realization is manufactured here. -/
def CMFiniteNestedLinearAssembly.toFiniteAssembly
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (M : CMFiniteNestedLinearAssembly factors) :
    CMFiniteFourfoldAssembly factors where
  assemble := fun f => M.map (f 0) (f 1) (f 2) (f 3)
  tensor := M.map (factors.vector 0) (factors.vector 1)
    (factors.vector 2) (factors.vector 3)
  original_eq := rfl
  scalar_transport_eq := M.conjugate_at_factors

/-- The first-slot additivity is an unconditional consequence of the
nested-linear construction, not a separately hypothesized equation. -/
theorem CMFiniteNestedLinearAssembly.add_first
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (M : CMFiniteNestedLinearAssembly factors)
    (x y : E.carrier ⊗[ℚ] E.carrier)
    (b c d : E.carrier ⊗[ℚ] E.carrier) :
    M.map (x + y) b c d =
      M.map x b c d + M.map y b c d := by
  simp only [map_add, LinearMap.add_apply]

/-- Additivity in each of the remaining three slots follows from the
nested-linear representation; no new geometric premise is introduced. -/
theorem CMFiniteNestedLinearAssembly.add_second
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (M : CMFiniteNestedLinearAssembly factors)
    (a x y c d : E.carrier ⊗[ℚ] E.carrier) :
    M.map a (x + y) c d = M.map a x c d + M.map a y c d := by
  simp only [map_add, LinearMap.add_apply]

theorem CMFiniteNestedLinearAssembly.add_third
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (M : CMFiniteNestedLinearAssembly factors)
    (a b x y d : E.carrier ⊗[ℚ] E.carrier) :
    M.map a b (x + y) d = M.map a b x d + M.map a b y d := by
  simp only [map_add, LinearMap.add_apply]

theorem CMFiniteNestedLinearAssembly.add_fourth
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (M : CMFiniteNestedLinearAssembly factors)
    (a b c x y : E.carrier ⊗[ℚ] E.carrier) :
    M.map a b c (x + y) = M.map a b c x + M.map a b c y := by
  exact (M.map a b c).map_add x y

/-- Rational scalar homogeneity of all four slots is also inherited from
the linear-map types, independently of the unresolved Galois equation. -/
theorem CMFiniteNestedLinearAssembly.smul_first
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (M : CMFiniteNestedLinearAssembly factors)
    (q : ℚ) (a b c d : E.carrier ⊗[ℚ] E.carrier) :
    M.map (q • a) b c d = q • M.map a b c d := by
  simp only [map_smul, LinearMap.smul_apply]

theorem CMFiniteNestedLinearAssembly.smul_second
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (M : CMFiniteNestedLinearAssembly factors)
    (q : ℚ) (a b c d : E.carrier ⊗[ℚ] E.carrier) :
    M.map a (q • b) c d = q • M.map a b c d := by
  simp only [map_smul, LinearMap.smul_apply]

theorem CMFiniteNestedLinearAssembly.smul_third
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (M : CMFiniteNestedLinearAssembly factors)
    (q : ℚ) (a b c d : E.carrier ⊗[ℚ] E.carrier) :
    M.map a b (q • c) d = q • M.map a b c d := by
  simp only [map_smul, LinearMap.smul_apply]

theorem CMFiniteNestedLinearAssembly.smul_fourth
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (M : CMFiniteNestedLinearAssembly factors)
    (q : ℚ) (a b c d : E.carrier ⊗[ℚ] E.carrier) :
    M.map a b c (q • d) = q • M.map a b c d := by
  exact (M.map a b c).map_smul q d


/-- The finite assembly obtained from nested linear maps is additive in its
first argument. This bridges the nested-linear construction to the
function-valued finite assembly consumed by scalar descent. -/
theorem CMFiniteNestedLinearAssembly.toFiniteAssembly_add_first
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (M : CMFiniteNestedLinearAssembly factors)
    (x y b c d : E.carrier ⊗[ℚ] E.carrier) :
    M.toFiniteAssembly.assemble
        (fun i => if i = 0 then x + y else
          if i = 1 then b else if i = 2 then c else d) =
      M.toFiniteAssembly.assemble
        (fun i => if i = 0 then x else
          if i = 1 then b else if i = 2 then c else d) +
      M.toFiniteAssembly.assemble
        (fun i => if i = 0 then y else
          if i = 1 then b else if i = 2 then c else d) := by
  simpa [CMFiniteNestedLinearAssembly.toFiniteAssembly] using
    M.add_first x y b c d

/-- The same bridge preserves rational homogeneity in the first argument. -/
theorem CMFiniteNestedLinearAssembly.toFiniteAssembly_smul_first
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (M : CMFiniteNestedLinearAssembly factors)
    (q : ℚ) (a b c d : E.carrier ⊗[ℚ] E.carrier) :
    M.toFiniteAssembly.assemble
        (fun i => if i = 0 then q • a else
          if i = 1 then b else if i = 2 then c else d) =
      q • M.toFiniteAssembly.assemble
        (fun i => if i = 0 then a else
          if i = 1 then b else if i = 2 then c else d) := by
  simpa [CMFiniteNestedLinearAssembly.toFiniteAssembly] using
    M.smul_first q a b c d

/-- A nested rational-linear fourfold assembly automatically satisfies the
complete slotwise multilinearity certificate for its finite presentation.
The proof is finite case analysis on the four slots; scalar Galois
compatibility remains the independent hypothesis of the nested assembly. -/
def CMFiniteNestedLinearAssembly.toMultilinearity
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (M : CMFiniteNestedLinearAssembly factors) :
    CMFiniteAssemblyMultilinearity M.toFiniteAssembly where
  add_slot := by
    intro i x y f
    fin_cases i <;>
      simp [CMFiniteNestedLinearAssembly.toFiniteAssembly,
        Function.update, map_add, LinearMap.add_apply]
  smul_slot := by
    intro i q x f
    fin_cases i <;>
      simp [CMFiniteNestedLinearAssembly.toFiniteAssembly,
        Function.update, map_smul, LinearMap.smul_apply]

/-- In particular, the finite assembly from nested-linear data vanishes
whenever any one of its four slots is replaced by zero. -/
theorem CMFiniteNestedLinearAssembly.toFiniteAssembly_zero_at
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (M : CMFiniteNestedLinearAssembly factors)
    (i : Fin 4)
    (f : Fin 4 → E.carrier ⊗[ℚ] E.carrier) :
    M.toFiniteAssembly.assemble (Function.update f i 0) = 0 :=
  M.toMultilinearity.zero_at i f

/-- A rational fourfold nested-linear finite-CM assembly is determined
by its values on four pure coefficient/vector tensors. This eliminates
a separate equality-of-assemblies obligation once a common pure-factor
formula is verified. No geometric pure-factor formula is asserted here. -/
theorem CMFiniteNestedLinearAssembly.map_eq_of_pure_eq
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (M N : CMFiniteNestedLinearAssembly factors)
    (hpure : ∀ a₁ x₁ a₂ x₂ a₃ x₃ a₄ x₄ : E.carrier,
      M.map (a₁ ⊗ₜ[ℚ] x₁) (a₂ ⊗ₜ[ℚ] x₂)
        (a₃ ⊗ₜ[ℚ] x₃) (a₄ ⊗ₜ[ℚ] x₄) =
      N.map (a₁ ⊗ₜ[ℚ] x₁) (a₂ ⊗ₜ[ℚ] x₂)
        (a₃ ⊗ₜ[ℚ] x₃) (a₄ ⊗ₜ[ℚ] x₄))
    (t₁ t₂ t₃ t₄ : E.carrier ⊗[ℚ] E.carrier) :
    M.map t₁ t₂ t₃ t₄ = N.map t₁ t₂ t₃ t₄ := by
  induction t₁ with
  | tmul a₁ x₁ =>
      induction t₂ with
      | tmul a₂ x₂ =>
          induction t₃ with
          | tmul a₃ x₃ =>
              induction t₄ with
              | tmul a₄ x₄ =>
                  exact hpure a₁ x₁ a₂ x₂ a₃ x₃ a₄ x₄
              | add x y hx hy =>
                  simp [map_add, hx, hy]
          | add x y hx hy =>
              simp [map_add, hx, hy]
      | add x y hx hy =>
          simp [map_add, hx, hy]
  | add x y hx hy =>
      simp [map_add, hx, hy]

/-- The finite assembly functions coincide when their nested-linear
presentations satisfy the same pure-factor formula. -/
theorem CMFiniteNestedLinearAssembly.assemble_eq_of_pure_eq
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (M N : CMFiniteNestedLinearAssembly factors)
    (hpure : ∀ a₁ x₁ a₂ x₂ a₃ x₃ a₄ x₄ : E.carrier,
      M.map (a₁ ⊗ₜ[ℚ] x₁) (a₂ ⊗ₜ[ℚ] x₂)
        (a₃ ⊗ₜ[ℚ] x₃) (a₄ ⊗ₜ[ℚ] x₄) =
      N.map (a₁ ⊗ₜ[ℚ] x₁) (a₂ ⊗ₜ[ℚ] x₂)
        (a₃ ⊗ₜ[ℚ] x₃) (a₄ ⊗ₜ[ℚ] x₄))
    (f : Fin 4 → E.carrier ⊗[ℚ] E.carrier) :
    M.toFiniteAssembly.assemble f = N.toFiniteAssembly.assemble f := by
  exact M.map_eq_of_pure_eq N hpure (f 0) (f 1) (f 2) (f 3)

/-- Extend only the assembled finite-CM coefficient tensor to AlgebraicNumbers. -/
def CMFiniteFourfoldAssembly.globalTensor
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (D : CMFiniteFourfoldAssembly factors) :
    AlgebraicNumbers ⊗[ℚ] V :=
  coefficientInclusion D.tensor

/-- Agreement of nested-linear presentations on all fourfold pure
finite tensors gives equality of their fixed-field assembled generators.
This is the precise finite-level equality needed before scalar extension. -/
theorem CMFiniteNestedLinearAssembly.tensor_eq_of_pure_eq
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (M N : CMFiniteNestedLinearAssembly factors)
    (hpure : ∀ a₁ x₁ a₂ x₂ a₃ x₃ a₄ x₄ : E.carrier,
      M.map (a₁ ⊗ₜ[ℚ] x₁) (a₂ ⊗ₜ[ℚ] x₂)
        (a₃ ⊗ₜ[ℚ] x₃) (a₄ ⊗ₜ[ℚ] x₄) =
      N.map (a₁ ⊗ₜ[ℚ] x₁) (a₂ ⊗ₜ[ℚ] x₂)
        (a₃ ⊗ₜ[ℚ] x₃) (a₄ ⊗ₜ[ℚ] x₄)) :
    M.toFiniteAssembly.tensor = N.toFiniteAssembly.tensor := by
  exact M.map_eq_of_pure_eq N hpure
    (factors.vector 0) (factors.vector 1)
    (factors.vector 2) (factors.vector 3)

/-- Pure-factor agreement also survives coefficient inclusion into
algebraic numbers. No actual-H1 comparison is used in this result. -/
theorem CMFiniteNestedLinearAssembly.globalTensor_eq_of_pure_eq
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (M N : CMFiniteNestedLinearAssembly factors)
    (hpure : ∀ a₁ x₁ a₂ x₂ a₃ x₃ a₄ x₄ : E.carrier,
      M.map (a₁ ⊗ₜ[ℚ] x₁) (a₂ ⊗ₜ[ℚ] x₂)
        (a₃ ⊗ₜ[ℚ] x₃) (a₄ ⊗ₜ[ℚ] x₄) =
      N.map (a₁ ⊗ₜ[ℚ] x₁) (a₂ ⊗ₜ[ℚ] x₂)
        (a₃ ⊗ₜ[ℚ] x₃) (a₄ ⊗ₜ[ℚ] x₄)) :
    M.toFiniteAssembly.globalTensor = N.toFiniteAssembly.globalTensor := by
  exact congrArg coefficientInclusion (M.tensor_eq_of_pure_eq N hpure)

/-- Absolute scalar conjugation of the global assembled tensor is computed by
restriction to the fixed finite Galois CM field. -/
theorem CMFiniteFourfoldAssembly.globalTensor_scalarConjugate
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (D : CMFiniteFourfoldAssembly factors)
    (σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers) :
    GRWTSK.LinearAlgebra.TensorProduct.RationalScalarDescent.scalarConjugate
        σ D.globalTensor =
      coefficientInclusion
        (D.assemble ((factors.scalarTransport σ).vector)) := by
  rw [CMFiniteFourfoldAssembly.globalTensor]
  rw [←
    GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.scalarConjugate_restrict
      E.carrier σ D.tensor]
  rw [D.scalar_transport_eq σ]

/-- One actual-Hodge comparison witness for a transported finite-CM
assembled generator, with the finite Galois CM field fixed.

The four actual weight-one realizations may vary with the transported factor
configuration, but no new coefficient field is chosen. -/
structure CMFiniteTransportedGeneratorWitness
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (D : CMFiniteFourfoldAssembly factors)
    (hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V))
    (σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers) where
  v₁ : CMNumberFieldIndex.OddSignRow E.carrier
  v₂ : CMNumberFieldIndex.OddSignRow E.carrier
  v₃ : CMNumberFieldIndex.OddSignRow E.carrier
  v₄ : CMNumberFieldIndex.OddSignRow E.carrier
  actualTyping :
    CMFiniteFourFactorActualTyping E
      (factors.scalarTransport σ) v₁ v₂ v₃ v₄
  alignment :
    CMFiniteFourFactorSwitchAlignment actualTyping
  hodgeRule :
    FourfoldActualHodgeTensorRule actualTyping.toActualTyping
  compare :
    FourfoldActualTensor actualTyping.toActualTyping →ₗ[ℂ]
      (ℂ ⊗[ℚ] V)
  H22_le :
    hodgeRule.H22.map compare ≤ hodgeSubspace
  generator_eq :
    coefficientInclusion
        (D.assemble ((factors.scalarTransport σ).vector)) =
      compare
        (fourfoldActualPureTensor actualTyping.toActualTyping
          (actualTyping.first.realization.canonicalTensorActualH1Comparison.toActual
            actualTyping.first.vector)
          (actualTyping.second.realization.canonicalTensorActualH1Comparison.toActual
            actualTyping.second.vector)
          (actualTyping.third.realization.canonicalTensorActualH1Comparison.toActual
            actualTyping.third.vector)
          (actualTyping.fourth.realization.canonicalTensorActualH1Comparison.toActual
            actualTyping.fourth.vector))

/-- One finite-CM transported comparison witness proves Hodge membership of
its coefficient-included assembled generator. -/
theorem CMFiniteTransportedGeneratorWitness.generator_mem_hodge
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {D : CMFiniteFourfoldAssembly factors}
    {hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)}
    {σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers}
    (W : CMFiniteTransportedGeneratorWitness D hodgeSubspace σ) :
    coefficientInclusion
        (D.assemble ((factors.scalarTransport σ).vector)) ∈
      hodgeSubspace := by
  rw [W.generator_eq]
  apply W.H22_le
  apply Submodule.mem_map.mpr
  refine ⟨_, W.alignment.canonicalPureTensor_mem_H22 W.hodgeRule, rfl⟩

/-- Hodge membership for every transported finite-CM assembled generator.

This is the correct pre-descent Hodge interface for the finite-level switch
construction. -/
structure CMFiniteTransportedGeneratorHodgeData
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (D : CMFiniteFourfoldAssembly factors)
    (hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)) where
  generator_mem :
    ∀ σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers,
      coefficientInclusion
        (D.assemble ((factors.scalarTransport σ).vector)) ∈
          hodgeSubspace

/-- A fixed-field transported comparison witness for every absolute
automorphism supplies the exact finite-CM Hodge package consumed by descent. -/
def CMFiniteTransportedGeneratorHodgeData.ofWitnesses
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {D : CMFiniteFourfoldAssembly factors}
    {hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)}
    (W :
      ∀ σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers,
        CMFiniteTransportedGeneratorWitness D hodgeSubspace σ) :
    CMFiniteTransportedGeneratorHodgeData D hodgeSubspace where
  generator_mem := fun σ => (W σ).generator_mem_hodge


/-- Finite-level transported-generator Hodge membership implies Hodge
membership of every absolute scalar conjugate of the global assembled tensor. -/
theorem CMFiniteTransportedGeneratorHodgeData.all_scalar_conjugates_mem
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {D : CMFiniteFourfoldAssembly factors}
    {hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)}
    (H : CMFiniteTransportedGeneratorHodgeData D hodgeSubspace)
    (σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers) :
    coefficientInclusion
        (GRWTSK.LinearAlgebra.TensorProduct.RationalScalarDescent.scalarConjugate
          σ D.globalTensor) ∈ hodgeSubspace := by
  rw [D.globalTensor_scalarConjugate σ]
  exact H.generator_mem σ

/-- The finite-CM transported-generator package directly supplies orbit-span
containment for the assembled global tensor. -/
theorem CMFiniteTransportedGeneratorHodgeData.orbitSpan_le_hodge
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {D : CMFiniteFourfoldAssembly factors}
    {hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)}
    (H : CMFiniteTransportedGeneratorHodgeData D hodgeSubspace) :
    scalarConjugateOrbitSpan D.globalTensor ≤ hodgeSubspace := by
  rw [scalarConjugateOrbitSpan]
  apply Submodule.span_le.mpr
  intro z hz
  obtain ⟨σ, rfl⟩ := hz
  exact H.all_scalar_conjugates_mem σ

/-- A switched tensor supported on one finite Galois CM intermediate field. -/
structure CMFiniteGaloisTensorCarrier
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (t : AlgebraicNumbers ⊗[ℚ] V) where
  E : CMGaloisIntermediateField
  tensor : E.carrier ⊗[ℚ] V
  inclusion_eq :
    coefficientInclusion tensor = t

/-- Absolute scalar conjugation restricts uniformly through a CM-supported
finite Galois carrier. -/
theorem CMFiniteGaloisTensorCarrier.scalarConjugate_restrict
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {t : AlgebraicNumbers ⊗[ℚ] V}
    (C : CMFiniteGaloisTensorCarrier t)
    (σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers) :
    coefficientInclusion
        (GRWTSK.LinearAlgebra.TensorProduct.RationalScalarDescent.scalarConjugate
          (σ.restrictNormal C.E.carrier) C.tensor) =
      GRWTSK.LinearAlgebra.TensorProduct.RationalScalarDescent.scalarConjugate
        σ t := by
  rw [← C.inclusion_eq]
  exact
    GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.scalarConjugate_restrict
      C.E.carrier σ C.tensor

/-- One realized Hodge witness for a descent-side monomial generator.

The finite Galois CM field is part of the witness.  This is essential because
different scalar conjugates of an algebraic-number tensor need not be handled
inside one fixed finite CM field. -/
structure RealizedMonomialGeneratorHodgeWitness
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V))
    (assembledGenerator : ℂ ⊗[ℚ] V) where
  E : Type*
  [E_field : Field E]
  [E_numberField : NumberField E]
  [E_isCMField : IsCMField E]
  [E_isGalois : IsGalois ℚ E]
  v₁ : CMNumberFieldIndex.OddSignRow E
  v₂ : CMNumberFieldIndex.OddSignRow E
  v₃ : CMNumberFieldIndex.OddSignRow E
  v₄ : CMNumberFieldIndex.OddSignRow E
  factors : FourCanonicalFactorsActualTyping E v₁ v₂ v₃ v₄
  hodgeRule : FourfoldActualHodgeTensorRule factors
  comparison :
    ActualFourfoldToMonomialComparison hodgeRule hodgeSubspace
  identification :
    ActualFourfoldMonomialGeneratorIdentification
      comparison assembledGenerator

/-- A realized generator witness yields descent-side Hodge membership locally. -/
theorem RealizedMonomialGeneratorHodgeWitness.assembled_mem_hodge
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)}
    {assembledGenerator : ℂ ⊗[ℚ] V}
    (W : RealizedMonomialGeneratorHodgeWitness
      hodgeSubspace assembledGenerator) :
    assembledGenerator ∈ hodgeSubspace :=
  W.identification.assembled_mem_hodge

/-- Generic fourfold Hodge tensor-product compatibility.

The isOfType predicate records actual weight-one Hodge membership of a
factor. The only structural assertion is the standard tensor-product rule:
assembling four factors whose p- and q-indices both total two lands in the
declared H^(2,2) subspace. -/
structure FourfoldHodgeAssemblyRule
    {A W : Type*}
    [AddCommGroup W] [Module ℂ W]
    (assemble : (Fin 4 → A) → W) where
  h22 : Submodule ℂ W
  isOfType : A → CMEmbeddingLines.WeightOneHodgeType → Prop
  assemble_mem_h22 :
    ∀ (v : Fin 4 → A)
      (typeAt : Fin 4 → CMEmbeddingLines.WeightOneHodgeType),
      (∀ r, isOfType (v r) (typeAt r)) →
      (∑ r, CMEmbeddingLines.pIndex (typeAt r)) = 2 →
      (∑ r, CMEmbeddingLines.qIndex (typeAt r)) = 2 →
      assemble v ∈ h22

/-- Actual weight-one Hodge typing for every scalar-conjugated four-factor
tuple.

This interface is precisely where formal sign-derived type labels must be
identified with actual H^(1,0)/H^(0,1) membership. -/
structure TransportedFourFactorHodgeTyping
    {A W : Type*}
    [AddCommGroup W] [Module ℂ W]
    {assemble : (Fin 4 → A) → W}
    (R : FourfoldHodgeAssemblyRule assemble)
    (transported :
      (GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ≃ₐ[ℚ]
       GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers) →
      Fin 4 → A) where
  typeAt :
    (GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
      ≃ₐ[ℚ]
     GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers) →
    Fin 4 → CMEmbeddingLines.WeightOneHodgeType
  factor_type :
    ∀ σ r, R.isOfType (transported σ r) (typeAt σ r)
  p_two :
    ∀ σ, (∑ r, CMEmbeddingLines.pIndex (typeAt σ r)) = 2
  q_two :
    ∀ σ, (∑ r, CMEmbeddingLines.qIndex (typeAt σ r)) = 2

/-- Actual factor typing plus the generic Hodge tensor-product rule implies
H^(2,2) membership of every assembled transported generator. -/
theorem TransportedFourFactorHodgeTyping.assembled_mem_h22
    {A W : Type*}
    [AddCommGroup W] [Module ℂ W]
    {assemble : (Fin 4 → A) → W}
    {R : FourfoldHodgeAssemblyRule assemble}
    {transported :
      (GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ≃ₐ[ℚ]
       GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers) →
      Fin 4 → A}
    (T : TransportedFourFactorHodgeTyping R transported)
    (σ :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ≃ₐ[ℚ]
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers) :
    assemble (transported σ) ∈ R.h22 :=
  R.assemble_mem_h22
    (transported σ) (T.typeAt σ)
    (T.factor_type σ) (T.p_two σ) (T.q_two σ)

/-- Family of finite-CM realizations for every scalar-conjugated assembled
generator.

The finite CM field is allowed to vary with the scalar automorphism. -/
structure TransportedGeneratorRealizationFamily
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {factors :
      CMEmbeddingTransport.FourEmbeddingLineVectors
        (k := ℚ)
        (E :=
          GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers)}
    {tensor :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ] V}
    (D : FourfoldMonomialAssemblyData factors tensor)
    (hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)) where
  realize :
    ∀ σ :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ≃ₐ[ℚ]
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers,
      RealizedMonomialGeneratorHodgeWitness
        hodgeSubspace
        (D.assemble ((factors.scalarTransport σ).vector))

/-- Exact Hodge-realization input for one transported monomial generator.

Because the transported monomial line is defined as the span of this one
assembled generator, generator membership is enough to recover the whole-line
inclusion locally. -/
structure TransportedMonomialGeneratorHodgeData
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {factors :
      CMEmbeddingTransport.FourEmbeddingLineVectors
        (k := ℚ)
        (E :=
          GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers)}
    {tensor :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ] V}
    (D : FourfoldMonomialAssemblyData factors tensor)
    (hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)) where
  generator_mem :
    ∀ σ,
      D.assemble ((factors.scalarTransport σ).vector) ∈ hodgeSubspace

/-- A realization family supplies the exact transported-generator Hodge package
consumed by the orbit-span/descent pipeline. -/
def TransportedGeneratorRealizationFamily.toTransportedGeneratorHodgeData
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {factors :
      CMEmbeddingTransport.FourEmbeddingLineVectors
        (k := ℚ)
        (E :=
          GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers)}
    {tensor :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ] V}
    {D : FourfoldMonomialAssemblyData factors tensor}
    {hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)}
    (F : TransportedGeneratorRealizationFamily D hodgeSubspace) :
    TransportedMonomialGeneratorHodgeData D hodgeSubspace where
  generator_mem := fun σ => (F.realize σ).assembled_mem_hodge


/-- Membership of each transported monomial generator implies inclusion of the
whole transported monomial line in the actual Hodge subspace. -/
theorem TransportedMonomialGeneratorHodgeData.transportedLine_le
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {factors :
      CMEmbeddingTransport.FourEmbeddingLineVectors
        (k := ℚ)
        (E :=
          GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers)}
    {tensor :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ] V}
    {D : FourfoldMonomialAssemblyData factors tensor}
    {hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)}
    (H : TransportedMonomialGeneratorHodgeData D hodgeSubspace)
    (σ :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ≃ₐ[ℚ]
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers) :
    D.transportedLine σ ≤ hodgeSubspace := by
  rw [FourfoldMonomialAssemblyData.transportedLine]
  apply Submodule.span_le.mpr
  intro z hz
  have hz' :
      z = D.assemble ((factors.scalarTransport σ).vector) := by
    simpa only [Set.mem_singleton_iff] using hz
  subst z
  exact H.generator_mem σ

/-- Fourfold assembly plus actual factor typing canonically supplies the
transported-generator H^(2,2) package. -/
def FourfoldMonomialAssemblyData.toTransportedGeneratorHodgeData
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {factors :
      CMEmbeddingTransport.FourEmbeddingLineVectors
        (k := ℚ)
        (E :=
          GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers)}
    {tensor :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ] V}
    (D : FourfoldMonomialAssemblyData factors tensor)
    (R : FourfoldHodgeAssemblyRule D.assemble)
    (T : TransportedFourFactorHodgeTyping R
      (fun σ => (factors.scalarTransport σ).vector)) :
    TransportedMonomialGeneratorHodgeData D R.h22 where
  generator_mem := fun σ => T.assembled_mem_h22 σ

/-- A presented fourfold multilinear assembly together with finite-CM
realizations of every transported generator directly yields the complete
scalar-conjugate monomial-line package. -/
def FourfoldMultilinearAlgebraicAssembly.toScalarConjugateMonomialLineData
    (M : FourfoldMultilinearAlgebraicAssembly)
    (factors :
      CMEmbeddingTransport.FourEmbeddingLineVectors
        (k := ℚ)
        (E :=
          GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers))
    (hodgeSubspace :
      Submodule ℂ
        (ℂ ⊗[ℚ] CanonicalFourfoldVectorTarget))
    (F :
      TransportedGeneratorRealizationFamily
        (M.toMonomialAssemblyData factors) hodgeSubspace) :
    ScalarConjugateMonomialLineData
      (M.assemble
        (factors.vector 0)
        (factors.vector 1)
        (factors.vector 2)
        (factors.vector 3))
      hodgeSubspace :=
  (M.toMonomialAssemblyData factors).toScalarConjugateMonomialLineDataOfGenerator
    hodgeSubspace F.toTransportedGeneratorHodgeData

/-- Generator-level Hodge membership is therefore enough to build the complete
scalar-conjugate monomial-line package. -/
def FourfoldMonomialAssemblyData.toScalarConjugateMonomialLineDataOfGenerator
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {factors :
      CMEmbeddingTransport.FourEmbeddingLineVectors
        (k := ℚ)
        (E :=
          GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers)}
    {tensor :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ] V}
    (D : FourfoldMonomialAssemblyData factors tensor)
    (hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V))
    (H : TransportedMonomialGeneratorHodgeData D hodgeSubspace) :
    ScalarConjugateMonomialLineData tensor hodgeSubspace where
  monomialLine := D.transportedLine
  conjugate_mem_line := D.scalarConjugate_mem_transportedLine
  line_le_hodge := H.transportedLine_le

/-- Fourfold assembly data canonically supplies the monomial-line membership
half of ScalarConjugateMonomialLineData.  Only inclusion of the transported
line in the actual Hodge subspace remains geometric. -/
def FourfoldMonomialAssemblyData.toScalarConjugateMonomialLineData
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {factors :
      CMEmbeddingTransport.FourEmbeddingLineVectors
        (k := ℚ)
        (E :=
          GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers)}
    {tensor :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ] V}
    (D : FourfoldMonomialAssemblyData factors tensor)
    (hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V))
    (hline : ∀ σ, D.transportedLine σ ≤ hodgeSubspace) :
    ScalarConjugateMonomialLineData tensor hodgeSubspace where
  monomialLine := D.transportedLine
  conjugate_mem_line := D.scalarConjugate_mem_transportedLine
  line_le_hodge := hline

/-- Linewise transport data for the scalar-Galois orbit of one switched tensor.

For each coefficient-field automorphism, monomialLine sigma is the transported
four-factor monomial line containing the corresponding scalar conjugate. If
every such line lies in the actual Hodge subspace, orbit-span containment
follows formally. -/
structure ScalarConjugateMonomialLineData
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (tensor :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ] V)
    (hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)) where
  monomialLine :
    (GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
      ≃ₐ[ℚ]
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers) →
      Submodule ℂ (ℂ ⊗[ℚ] V)
  conjugate_mem_line :
    ∀ σ,
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.coefficientInclusion
        (GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.scalarConjugate
          σ tensor) ∈ monomialLine σ
  line_le_hodge :
    ∀ σ, monomialLine σ ≤ hodgeSubspace

/-- Linewise monomial transport and linewise Hodge inclusion imply the single
orbit-span containment statement. -/
theorem ScalarConjugateMonomialLineData.orbitSpan_le_hodge
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {tensor :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ⊗[ℚ] V}
    {hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)}
    (D : ScalarConjugateMonomialLineData tensor hodgeSubspace) :
    scalarConjugateOrbitSpan tensor ≤ hodgeSubspace := by
  rw [scalarConjugateOrbitSpan]
  apply Submodule.span_le.mpr
  intro z hz
  obtain ⟨σ, rfl⟩ := hz
  exact D.line_le_hodge σ (D.conjugate_mem_line σ)

/-- Atomic-switch version of the linewise transport package.

This is the natural interface for combining the existing factorwise embedding
transport results with the actual geometric Hodge realization. -/
structure AtomicSwitchMonomialTransportData
    {conj : G → G}
    {hconj : Function.Involutive conj}
    {x target : I → G → ℤ}
    {hxsign : ∀ r h, IsSign (x r h)}
    {hxodd : IsOddMatrix conj x}
    {g : G} {hg : g ≠ conj g}
    {i : PosNegMismatch (fun r => x r g) (fun r => target r g)}
    {j : NegPosMismatch (fun r => x r g) (fun r => target r g)}
    (P : AtomicSwitchFourFactorProfile
      conj hconj x target hxsign hxodd g hg i j) where
  V : Type*
  [V_addCommGroup : AddCommGroup V]
  [V_moduleQ : Module ℚ V]
  hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)
  tensor :
    GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
      ⊗[ℚ] V
  transport :
    ScalarConjugateMonomialLineData tensor hodgeSubspace

/-- Sharpened geometric input: the actual Hodge subspace only needs to contain
the scalar-conjugate orbit span. -/
structure AtomicSwitchOrbitHodgeData
    {conj : G → G}
    {hconj : Function.Involutive conj}
    {x target : I → G → ℤ}
    {hxsign : ∀ r h, IsSign (x r h)}
    {hxodd : IsOddMatrix conj x}
    {g : G} {hg : g ≠ conj g}
    {i : PosNegMismatch (fun r => x r g) (fun r => target r g)}
    {j : NegPosMismatch (fun r => x r g) (fun r => target r g)}
    (P : AtomicSwitchFourFactorProfile
      conj hconj x target hxsign hxodd g hg i j) where
  V : Type*
  [V_addCommGroup : AddCommGroup V]
  [V_moduleQ : Module ℚ V]
  hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)
  tensor :
    GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
      ⊗[ℚ] V
  orbitSpan_le_hodge :
    scalarConjugateOrbitSpan tensor ≤ hodgeSubspace

/-- Raw tensor-level input still needed after the canonical atomic
four-row profile and its all-conjugate (2,2) certificate are known locally.

Only the actual tensor, Hodge subspace, and scalar-conjugate stability remain
as input here. -/
structure AtomicSwitchTensorData
    {conj : G → G}
    {hconj : Function.Involutive conj}
    {x target : I → G → ℤ}
    {hxsign : ∀ r h, IsSign (x r h)}
    {hxodd : IsOddMatrix conj x}
    {g : G} {hg : g ≠ conj g}
    {i : PosNegMismatch (fun r => x r g) (fun r => target r g)}
    {j : NegPosMismatch (fun r => x r g) (fun r => target r g)}
    (P : AtomicSwitchFourFactorProfile
      conj hconj x target hxsign hxodd g hg i j) where
  V : Type*
  [V_addCommGroup : AddCommGroup V]
  [V_moduleQ : Module ℚ V]
  hodgeSubspace :
    Submodule ℂ (ℂ ⊗[ℚ] V)
  tensor :
    GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
      ⊗[ℚ] V
  all_scalar_conjugates_mem :
    ∀ σ :
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers
        ≃ₐ[ℚ]
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.AlgebraicNumbers,
      GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.coefficientInclusion
        (GRWTSK.LinearAlgebra.TensorProduct.GaloisScalarDescent.scalarConjugate
          σ tensor) ∈ hodgeSubspace

/-- Linewise monomial transport yields the orbit-span Hodge package locally. -/
def AtomicSwitchMonomialTransportData.toOrbitHodgeData
    {conj : G → G}
    {hconj : Function.Involutive conj}
    {x target : I → G → ℤ}
    {hxsign : ∀ r h, IsSign (x r h)}
    {hxodd : IsOddMatrix conj x}
    {g : G} {hg : g ≠ conj g}
    {i : PosNegMismatch (fun r => x r g) (fun r => target r g)}
    {j : NegPosMismatch (fun r => x r g) (fun r => target r g)}
    {P : AtomicSwitchFourFactorProfile
      conj hconj x target hxsign hxodd g hg i j}
    (D : AtomicSwitchMonomialTransportData P) :
    AtomicSwitchOrbitHodgeData P where
  V := D.V
  hodgeSubspace := D.hodgeSubspace
  tensor := D.tensor
  orbitSpan_le_hodge := D.transport.orbitSpan_le_hodge

/-- Orbit-span containment automatically supplies the raw scalar-conjugate
stability data needed for descent. -/
def AtomicSwitchOrbitHodgeData.toTensorData
    {conj : G → G}
    {hconj : Function.Involutive conj}
    {x target : I → G → ℤ}
    {hxsign : ∀ r h, IsSign (x r h)}
    {hxodd : IsOddMatrix conj x}
    {g : G} {hg : g ≠ conj g}
    {i : PosNegMismatch (fun r => x r g) (fun r => target r g)}
    {j : NegPosMismatch (fun r => x r g) (fun r => target r g)}
    {P : AtomicSwitchFourFactorProfile
      conj hconj x target hxsign hxodd g hg i j}
    (D : AtomicSwitchOrbitHodgeData P) :
    AtomicSwitchTensorData P where
  V := D.V
  hodgeSubspace := D.hodgeSubspace
  tensor := D.tensor
  all_scalar_conjugates_mem := fun σ =>
    D.orbitSpan_le_hodge (scalarConjugate_mem_orbitSpan D.tensor σ)

/-- The canonical (2,2) profile plus raw tensor stability data produces the
exact descent datum consumed by the local trace-descent theorem. -/
def AtomicSwitchTensorData.toDescentData
    {conj : G → G}
    {hconj : Function.Involutive conj}
    {x target : I → G → ℤ}
    {hxsign : ∀ r h, IsSign (x r h)}
    {hxodd : IsOddMatrix conj x}
    {g : G} {hg : g ≠ conj g}
    {i : PosNegMismatch (fun r => x r g) (fun r => target r g)}
    {j : NegPosMismatch (fun r => x r g) (fun r => target r g)}
    {P : AtomicSwitchFourFactorProfile
      conj hconj x target hxsign hxodd g hg i j}
    (D : AtomicSwitchTensorData P) :
    CMFourFactorAlgebraicity.FourFactorTensorDescentData
      G conj P.v₁ P.v₂ P.v₃ P.v₄ D.V where
  type22 := P.type22
  P := D.hodgeSubspace
  tensor := D.tensor
  all_scalar_conjugates_mem := D.all_scalar_conjugates_mem

/-- Exact remaining tensor-level supplier for an invariant-aware atomic switch.

For each switch step it supplies only the actual tensor, complex Hodge
subspace, and scalar-conjugate stability.  The four-row profile, (2,2)
certificate, and rational descent are all constructed locally. -/
structure InvariantAtomicTensorDataSupplier
    (conj : G → G)
    (hconj : Function.Involutive conj)
    (target : I → G → ℤ) where
  realize :
    ∀ (x : I → G → ℤ)
      (hxsign : ∀ r h, IsSign (x r h))
      (hxodd : IsOddMatrix conj x)
      (g : G)
      (hg : g ≠ conj g)
      (i : PosNegMismatch (fun r => x r g) (fun r => target r g))
      (j : NegPosMismatch (fun r => x r g) (fun r => target r g)),
      AtomicSwitchTensorData
        (canonicalAtomicSwitchFourFactorProfile
          conj hconj x target hxsign hxodd g hg i j)

/-- Existential package for the rational four-factor Hodge witness attached
to one switched core.

The package hides the auxiliary rational vector space while retaining the
actual four sign rows and rational witness consumed by the existing
FourFactorAlgebraicitySupplier. -/
structure SwitchCoreRationalWitnessPackage
    (conj : G → G) where
  v₁ v₂ v₃ v₄ : OddSignRow G conj
  V : Type*
  [V_addCommGroup : AddCommGroup V]
  [V_moduleQ : Module ℚ V]
  witness :
    CMFourFactorAlgebraicity.RationalFourFactorHodgeWitness
      G conj v₁ v₂ v₃ v₄ V

/-- Raw atomic tensor data is enough to produce the rational four-factor
witness package locally: the canonical profile supplies type (2,2), and the
existing trace-descent theorem supplies rational descent. -/
def AtomicSwitchTensorData.toRationalPackage
    {conj : G → G}
    {hconj : Function.Involutive conj}
    {x target : I → G → ℤ}
    {hxsign : ∀ r h, IsSign (x r h)}
    {hxodd : IsOddMatrix conj x}
    {g : G} {hg : g ≠ conj g}
    {i : PosNegMismatch (fun r => x r g) (fun r => target r g)}
    {j : NegPosMismatch (fun r => x r g) (fun r => target r g)}
    {P : AtomicSwitchFourFactorProfile
      conj hconj x target hxsign hxodd g hg i j}
    (D : AtomicSwitchTensorData P) :
    SwitchCoreRationalWitnessPackage conj := by
  letI : AddCommGroup D.V := D.V_addCommGroup
  letI : Module ℚ D.V := D.V_moduleQ
  exact {
    v₁ := P.v₁
    v₂ := P.v₂
    v₃ := P.v₃
    v₄ := P.v₄
    V := D.V
    witness := D.toDescentData.toRationalWitness
  }

/-- Pure identification adapter from one atomic switched configuration to the
rational four-factor Hodge witness already used by the repository's
algebraicity interface.

This adapter carries no algebraicity theorem. -/
structure SwitchCoreRationalWitnessAdapter
    (conj : G → G)
    (target : I → G → ℤ) where
  identify :
    ∀ (x : I → G → ℤ)
      (g : G)
      (i : PosNegMismatch (fun r => x r g) (fun r => target r g))
      (j : NegPosMismatch (fun r => x r g) (fun r => target r g)),
      SwitchCoreRationalWitnessPackage conj

/-- Geometric packaging of the algebraic-cycle witness produced by the
existing four-factor algebraicity supplier as the opaque switched-core witness
consumed by the transition layer.

This is an interface conversion only; the cycle algebraicity is supplied
upstream by FourFactorAlgebraicitySupplier. -/
structure AlgebraicCycleToSwitchCoreAdapter
    (conj : G → G)
    (target : I → G → ℤ) where
  package :
    ∀ (x : I → G → ℤ)
      (g : G)
      (i : PosNegMismatch (fun r => x r g) (fun r => target r g))
      (j : NegPosMismatch (fun r => x r g) (fun r => target r g))
      (R : SwitchCoreRationalWitnessPackage conj),
      CMFourFactorAlgebraicity.AlgebraicCycleWitness
          G conj R.v₁ R.v₂ R.v₃ R.v₄ R.V R.witness →
        FourFactorSwitchCoreWitness conj x g i.1 j.1

/-- Independent four-factor algebraicity supplier.

This is the precise switch-specific theorem boundary: one elementary switch
on two rows supplies a nonzero algebraic four-factor core. -/
structure FourFactorSwitchCoreSupplier
    (conj : G → G)
    (target : I → G → ℤ) where
  realize :
    ∀ (x : I → G → ℤ)
      (g : G)
      (i : PosNegMismatch (fun r => x r g) (fun r => target r g))
      (j : NegPosMismatch (fun r => x r g) (fun r => target r g)),
      FourFactorSwitchCoreWitness conj x g i.1 j.1

/-- The existing repository-wide four-factor algebraicity supplier can be
used as the sole algebraicity theorem for atomic switched cores.

The remaining inputs are identification/packaging adapters only. -/
def fourFactorSwitchCoreSupplierOfAlgebraicity
    (conj : G → G)
    (target : I → G → ℤ)
    (R : SwitchCoreRationalWitnessAdapter conj target)
    (P : AlgebraicCycleToSwitchCoreAdapter conj target)
    (S : CMFourFactorAlgebraicity.FourFactorAlgebraicitySupplier) :
    FourFactorSwitchCoreSupplier conj target where
  realize := fun x g i j =>
    let W := R.identify x g i j
    P.package x g i j W (S.realize W.witness)

/-- Routine assembly of one four-factor switched core with all unchanged-row
two-factor identity witnesses.

The row-equality proof supplied to each unchanged factor is the local
combinatorial theorem that rows outside i,j are literally unchanged. -/
structure AtomicTransitionAssemblySupplier
    (conj : G → G) where
  assemble :
    ∀ (x : I → G → ℤ)
      (g : G) (i j : I),
      FourFactorSwitchCoreWitness conj x g i j →
      (∀ r : I, r ≠ i → r ≠ j → TwoFactorIdentityWitness (x r)) →
      AlgebraicTransitionWitness x (switchConjugatePair conj x g i j)

/-- Invariant-aware atomic switch supplier.

Unlike the older opaque atomic supplier, this interface carries the exact
source invariants needed to construct the canonical four-row profile:
sign-valuedness, oddness, and fixed-point-freeness at the selected conjugate
coordinate. -/
structure InvariantAtomicSwitchTransitionSupplier
    (conj : G → G)
    (target : I → G → ℤ) where
  realize :
    ∀ (x : I → G → ℤ)
      (hxsign : ∀ r h, IsSign (x r h))
      (hxodd : IsOddMatrix conj x)
      (g : G)
      (hg : g ≠ conj g)
      (i : PosNegMismatch (fun r => x r g) (fun r => target r g))
      (j : NegPosMismatch (fun r => x r g) (fun r => target r g)),
      AlgebraicTransitionWitness x
        (switchConjugatePair conj x g i.1 j.1)

/-- One elementary conjugate-paired switch gives an algebraic transition.

This is the exact local geometric content that must be supplied by the
four-factor switch theorem together with the unchanged-row two-factor classes. -/
structure AtomicSwitchTransitionSupplier
    (conj : G → G)
    (target : I → G → ℤ) where
  realize :
    ∀ (x : I → G → ℤ)
      (g : G)
      (i : PosNegMismatch (fun r => x r g) (fun r => target r g))
      (j : NegPosMismatch (fun r => x r g) (fun r => target r g)),
      AlgebraicTransitionWitness x
        (switchConjugatePair conj x g i.1 j.1)

/-- The invariant-aware atomic transition can be built from exactly the raw
tensor-stability supplier plus the repository-wide four-factor algebraicity
supplier and the routine geometric identity/assembly adapters.

This is the end-to-end local composition for one atomic switch. -/
def invariantAtomicSwitchTransitionSupplierOfTensorData
    (conj : G → G)
    (hconj : Function.Involutive conj)
    (target : I → G → ℤ)
    (T : InvariantAtomicTensorDataSupplier conj hconj target)
    (S : CMFourFactorAlgebraicity.FourFactorAlgebraicitySupplier)
    (P : AlgebraicCycleToSwitchCoreAdapter conj target)
    (Id : TwoFactorIdentitySupplier)
    (A : AtomicTransitionAssemblySupplier conj) :
    InvariantAtomicSwitchTransitionSupplier conj target where
  realize := fun x hxsign hxodd g hg i j =>
    let D := T.realize x hxsign hxodd g hg i j
    let W := D.toRationalPackage
    let core :=
      P.package x g i j W (S.realize W.witness)
    A.assemble x g i.1 j.1 core
      (fun r _ _ => Id.realize (x r))

/-- A four-factor core theorem plus unchanged-row identity classes and routine
slotwise assembly instantiate the generic atomic-switch transition supplier. -/
def atomicSwitchTransitionSupplierOfCore
    (conj : G → G)
    (target : I → G → ℤ)
    (C : FourFactorSwitchCoreSupplier conj target)
    (P : TwoFactorIdentitySupplier)
    (A : AtomicTransitionAssemblySupplier conj) :
    AtomicSwitchTransitionSupplier conj target where
  realize := fun x g i j =>
    A.assemble x g i.1 j.1
      (C.realize x g i j)
      (fun r _ _ => P.realize (x r))

section NonzeroScalarRecovery

variable {K T : Type*} [Field K] [AddCommGroup T] [Module K T]

/-- A subspace membership statement can be recovered from any nonzero scalar
multiple. This is the elementary final step in the manuscript's transition
composition formula. -/
theorem mem_of_nonzero_smul_mem
    (Z : Submodule K T)
    (a : K) (ha : a ≠ 0)
    (t : T)
    (hat : a • t ∈ Z) :
    t ∈ Z := by
  have h := Z.smul_mem a⁻¹ hat
  simpa [smul_smul, ha] using h

/-- Likewise a nonzero scalar multiple of a nonzero endpoint cannot vanish. -/
theorem smul_ne_zero
    (a : K) (ha : a ≠ 0)
    (t : T) (ht : t ≠ 0) :
    a • t ≠ 0 :=
  _root_.smul_ne_zero ha ht

/-- Abstract form of the manuscript's transition-composition identity:
a geometrically produced algebraic class is a nonzero scalar multiple of the
desired endpoint tensor. -/
structure NonzeroScalarCompositionData
    (Z : Submodule K T)
    (endpoint : T) where
  scalar : K
  scalar_ne_zero : scalar ≠ 0
  produced : T
  produced_mem : produced ∈ Z
  formula : produced = scalar • endpoint

/-- Once the geometric formula and scalar nonvanishing are supplied, endpoint
algebraicity is purely local linear algebra. -/
theorem NonzeroScalarCompositionData.endpoint_mem
    {Z : Submodule K T}
    {endpoint : T}
    (D : NonzeroScalarCompositionData Z endpoint) :
    endpoint ∈ Z := by
  apply mem_of_nonzero_smul_mem Z D.scalar D.scalar_ne_zero endpoint
  rwa [← D.formula]

end NonzeroScalarRecovery

section CanonicalTransportedMiddleLine

open scoped TensorProduct
open CMRegularBaseChange
open CMEmbeddingTransport

variable {k E : Type*} [Field k] [Field E] [Algebra k E]
  [FiniteDimensional k E] [IsGalois k E]

/-- Canonical tensor-model data for one transported middle embedding line. -/
structure CanonicalTransportedMiddleLineData
    (σ τ : E ≃ₐ[k] E) where
  beta : E ⊗[k] E
  gamma : E ⊗[k] E
  beta_mem :
    beta ∈ embeddingEigenspace (k := k) τ.toAlgHom
  gamma_mem :
    gamma ∈ embeddingEigenspace (k := k) (σ * τ).toAlgHom
  beta_ne_zero : beta ≠ 0
  gamma_ne_zero : gamma ≠ 0

/-- In the canonical tensor model, gamma is automatically a nonzero scalar
multiple of the scalar-conjugated beta.  No Hodge-Riemann input is used. -/
theorem CanonicalTransportedMiddleLineData.exists_scale
    {σ τ : E ≃ₐ[k] E}
    (D : CanonicalTransportedMiddleLineData σ τ) :
    ∃ c : E, c ≠ 0 ∧
      D.gamma = c •
        GRWTSK.LinearAlgebra.TensorProduct.RationalScalarDescent.scalarConjugate
          σ D.beta := by
  exact CMEmbeddingTransport.exists_ne_zero_smul_scalarConjugate_eq
    (k := k) (E := E) σ τ
    D.beta_mem D.gamma_mem D.beta_ne_zero D.gamma_ne_zero

end CanonicalTransportedMiddleLine

section CohomologyToCanonicalComparison

open scoped TensorProduct
open CMRegularBaseChange
open CMEmbeddingTransport

variable {k E H : Type*} [Field k] [Field E] [Algebra k E]
  [FiniteDimensional k E] [IsGalois k E]
  [AddCommGroup H] [Module E H]

/-- Minimal comparison data between an actual cohomological realization and
the canonical Galois tensor model.

This structure does not assert that such a comparison exists; it records only
the exact compatibility needed to transport the already-local one-dimensional
eigenline argument back to cohomology. -/
structure CohomologyCanonicalLineComparison
    (σ τ : E ≃ₐ[k] E) where
  toCanonical : H ≃ₗ[E] (E ⊗[k] E)
  actualConjugate : H → H
  conjugation_compatibility :
    ∀ h,
      toCanonical (actualConjugate h) =
        GRWTSK.LinearAlgebra.TensorProduct.RationalScalarDescent.scalarConjugate
          σ (toCanonical h)
  beta : H
  gamma : H
  beta_ne_zero : beta ≠ 0
  gamma_ne_zero : gamma ≠ 0
  beta_line :
    toCanonical beta ∈ embeddingEigenspace (k := k) τ.toAlgHom
  gamma_line :
    toCanonical gamma ∈ embeddingEigenspace (k := k) (σ * τ).toAlgHom

/-- The comparison equivalence preserves nonzero vectors. -/
theorem CohomologyCanonicalLineComparison.beta_canonical_ne_zero
    {σ τ : E ≃ₐ[k] E}
    (D : CohomologyCanonicalLineComparison σ τ) :
    D.toCanonical D.beta ≠ 0 :=
  D.toCanonical.injective.ne_iff.mpr D.beta_ne_zero

theorem CohomologyCanonicalLineComparison.gamma_canonical_ne_zero
    {σ τ : E ≃ₐ[k] E}
    (D : CohomologyCanonicalLineComparison σ τ) :
    D.toCanonical D.gamma ≠ 0 :=
  D.toCanonical.injective.ne_iff.mpr D.gamma_ne_zero

/-- Once the actual cohomological embedding lines are compared with the
canonical tensor model and scalar conjugation is respected, the manuscript's
middle-line proportionality follows formally: gamma is a nonzero scalar
multiple of the actual conjugate of beta. -/
theorem CohomologyCanonicalLineComparison.exists_scale
    {σ τ : E ≃ₐ[k] E}
    (D : CohomologyCanonicalLineComparison σ τ) :
    ∃ c : E, c ≠ 0 ∧
      D.gamma = c • D.actualConjugate D.beta := by
  let C : CanonicalTransportedMiddleLineData (k := k) σ τ where
    beta := D.toCanonical D.beta
    gamma := D.toCanonical D.gamma
    beta_mem := D.beta_line
    gamma_mem := D.gamma_line
    beta_ne_zero := D.beta_canonical_ne_zero
    gamma_ne_zero := D.gamma_canonical_ne_zero
  obtain ⟨c, hc, hcan⟩ := C.exists_scale
  refine ⟨c, hc, D.toCanonical.injective ?_⟩
  rw [map_smul, D.conjugation_compatibility]
  exact hcan

end CohomologyToCanonicalComparison

section PositiveMiddlePairing

variable {V : Type*} [AddCommGroup V] [Module ℂ V]

/-- Abstract positivity package for the middle-factor pairing in the
transition-composition formula.

This is deliberately weaker than a geometric Hodge--Riemann theorem: it only
records the exact consequences needed to prove one scalar pairing is nonzero. -/
structure PositiveConjugatePairing where
  pairing : V → V → ℂ
  conjugatePartner : V → V
  energy : V → ℝ
  pairing_conjugate :
    ∀ v, pairing v (conjugatePartner v) = (energy v : ℂ)
  pairing_smul_right :
    ∀ v c w, pairing v (c • w) = c * pairing v w
  energy_pos :
    ∀ {v}, v ≠ 0 → 0 < energy v

/-- Positivity makes the pairing with the conjugate partner nonzero. -/
theorem PositiveConjugatePairing.pairing_conjugate_ne_zero
    (P : PositiveConjugatePairing V)
    {v : V} (hv : v ≠ 0) :
    P.pairing v (P.conjugatePartner v) ≠ 0 := by
  rw [P.pairing_conjugate v]
  exact Complex.ofReal_ne_zero.mpr (P.energy_pos hv).ne'

/-- If the second middle factor is a nonzero scalar multiple of the conjugate
partner of the first, then the transition scalar q is nonzero.

This is the exact formal implication used in the manuscript after the
geometric Hodge--Riemann positivity and scalar-conjugation identifications have
been supplied. -/
theorem PositiveConjugatePairing.pairing_scaled_conjugate_ne_zero
    (P : PositiveConjugatePairing V)
    {beta : V} (hbeta : beta ≠ 0)
    {c : ℂ} (hc : c ≠ 0) :
    P.pairing beta (c • P.conjugatePartner beta) ≠ 0 := by
  rw [P.pairing_smul_right]
  exact mul_ne_zero hc (P.pairing_conjugate_ne_zero hbeta)

/-- Exact local package for one manuscript middle-factor scalar q_i.

The geometric supplier still has to identify gamma with the scaled conjugate
partner and the cup/integration pairing with pairing. -/
structure MiddlePairingNonvanishingData where
  pairingData : PositiveConjugatePairing V
  beta : V
  beta_ne_zero : beta ≠ 0
  scale : ℂ
  scale_ne_zero : scale ≠ 0
  gamma : V
  gamma_eq : gamma = scale • pairingData.conjugatePartner beta

/-- The middle pairing q_i is nonzero once the two geometric identifications
have been packaged. -/
theorem MiddlePairingNonvanishingData.pairing_ne_zero
    (D : MiddlePairingNonvanishingData V) :
    D.pairingData.pairing D.beta D.gamma ≠ 0 := by
  rw [D.gamma_eq]
  exact D.pairingData.pairing_scaled_conjugate_ne_zero
    D.beta_ne_zero D.scale_ne_zero

/-- Geometric data already available before invoking Hodge--Riemann positivity.

This record isolates the cup/integration pairing, the selected middle vectors,
and the already-local scalar-proportionality input.  It does not assume
positivity. -/
structure GeometricMiddlePairingData where
  pairing : V → V → ℂ
  conjugatePartner : V → V
  beta : V
  beta_ne_zero : beta ≠ 0
  gamma : V
  scale : ℂ
  scale_ne_zero : scale ≠ 0
  gamma_eq :
    gamma = scale • conjugatePartner beta
  q : ℂ
  q_eq :
    q = pairing beta gamma
  pairing_smul_right :
    ∀ v c w, pairing v (c • w) = c * pairing v w

/-- Exact remaining Hodge--Riemann supplier for one middle factor.

It supplies only a positive real energy whose complexification equals the
ample-class pairing with the conjugate partner.  No algebraicity conclusion is
included. -/
structure AmpleClassHodgeRiemannSupplier
    (D : GeometricMiddlePairingData V) where
  energy : V → ℝ
  pairing_conjugate :
    ∀ v, D.pairing v (D.conjugatePartner v) = (energy v : ℂ)
  energy_pos :
    ∀ {v}, v ≠ 0 → 0 < energy v

/-- An ample-class Hodge--Riemann supplier canonically gives the abstract
positive-pairing package used by the local nonvanishing lemmas. -/
def AmpleClassHodgeRiemannSupplier.toPositiveConjugatePairing
    {D : GeometricMiddlePairingData V}
    (S : AmpleClassHodgeRiemannSupplier D) :
    PositiveConjugatePairing V where
  pairing := D.pairing
  conjugatePartner := D.conjugatePartner
  energy := S.energy
  pairing_conjugate := S.pairing_conjugate
  pairing_smul_right := D.pairing_smul_right
  energy_pos := S.energy_pos

/-- Exact comparison data for the geometric ample-class middle pairing.

The external geometry supplies the identification of the integral/cup-product
pairing with the abstract positive conjugate pairing.  Scalar proportionality
of gamma with the conjugate partner is recorded separately, so the logical
dependencies remain auditable. -/
structure AmpleClassMiddlePairingComparison where
  pairingData : PositiveConjugatePairing V
  beta : V
  beta_ne_zero : beta ≠ 0
  gamma : V
  scale : ℂ
  scale_ne_zero : scale ≠ 0
  gamma_eq :
    gamma = scale • pairingData.conjugatePartner beta
  q : ℂ
  q_eq :
    q = pairingData.pairing beta gamma

/-- The exact Hodge--Riemann supplier constructs the previously-declared
ample-class comparison package. -/
def AmpleClassHodgeRiemannSupplier.toComparison
    {D : GeometricMiddlePairingData V}
    (S : AmpleClassHodgeRiemannSupplier D) :
    AmpleClassMiddlePairingComparison V where
  pairingData := S.toPositiveConjugatePairing
  beta := D.beta
  beta_ne_zero := D.beta_ne_zero
  gamma := D.gamma
  scale := D.scale
  scale_ne_zero := D.scale_ne_zero
  gamma_eq := D.gamma_eq
  q := D.q
  q_eq := D.q_eq

/-- Once the ample-class pairing has been identified with the positive
conjugate pairing, the manuscript scalar q_i is nonzero locally. -/
theorem AmpleClassMiddlePairingComparison.q_ne_zero
    (D : AmpleClassMiddlePairingComparison V) :
    D.q ≠ 0 := by
  rw [D.q_eq, D.gamma_eq]
  exact D.pairingData.pairing_scaled_conjugate_ne_zero
    D.beta_ne_zero D.scale_ne_zero

/-- Therefore the Hodge--Riemann supplier is exactly sufficient to prove
the geometric middle scalar nonzero. -/
theorem AmpleClassHodgeRiemannSupplier.q_ne_zero
    {D : GeometricMiddlePairingData V}
    (S : AmpleClassHodgeRiemannSupplier D) :
    D.q ≠ 0 :=
  S.toComparison.q_ne_zero

/-- A finite product of nonzero middle pairing scalars is nonzero. -/
theorem product_middlePairing_ne_zero
    {J : Type*} [Fintype J]
    (q : J → ℂ)
    (hq : ∀ j, q j ≠ 0) :
    (∏ j, q j) ≠ 0 := by
  exact Finset.prod_ne_zero_iff.mpr (by
    intro j _
    exact hq j)

/-- Signed scalar in the manuscript transition-composition formula. -/
def transitionCompositionScalar
    {J : Type*} [Fintype J]
    (parity : ℤ)
    (q : J → ℂ) : ℂ :=
  ((-1 : ℂ) ^ parity.natAbs) * ∏ j, q j

/-- The signed transition-composition scalar is nonzero as soon as every
middle pairing scalar is nonzero. -/
theorem transitionCompositionScalar_ne_zero
    {J : Type*} [Fintype J]
    (parity : ℤ)
    (q : J → ℂ)
    (hq : ∀ j, q j ≠ 0) :
    transitionCompositionScalar parity q ≠ 0 := by
  unfold transitionCompositionScalar
  exact mul_ne_zero (pow_ne_zero _ (by norm_num))
    (product_middlePairing_ne_zero q hq)

end PositiveMiddlePairing

/-- Geometric composition of consecutive algebraic transitions.

This abstracts the manuscript's pullback/cup-product/pushforward construction,
including its nonvanishing pairing factor. -/
structure TransitionCompositionSupplier where
  compose :
    ∀ {x y z : I → G → ℤ},
      AlgebraicTransitionWitness x y →
      AlgebraicTransitionWitness y z →
      AlgebraicTransitionWitness x z

/-- Invariant-aware geometric supplier package. -/
structure InvariantSwitchGeometrySupplier
    (conj : G → G)
    (target : I → G → ℤ) where
  identity : IdentityTransitionSupplier
  atomic : InvariantAtomicSwitchTransitionSupplier conj target
  composition : TransitionCompositionSupplier

/-- The exact two geometric suppliers required after finite combinatorial
connectivity. -/
structure SwitchGeometrySupplier
    (conj : G → G)
    (target : I → G → ℤ) where
  identity : IdentityTransitionSupplier
  atomic : AtomicSwitchTransitionSupplier conj target
  composition : TransitionCompositionSupplier

/-- Invariant-aware finite switch-chain assembly.

The sign and oddness invariants are propagated locally through every atomic
switch.  Fixed-point-freeness of the selected conjugate coordinate is derived
from oddness plus the selected mismatch row, so no extra global assumption is
introduced. -/
def transitionOfReachWithInvariants
    (conj : G → G)
    (hconj : Function.Involutive conj)
    (target : I → G → ℤ)
    (S : InvariantSwitchGeometrySupplier conj target)
    {x z : I → G → ℤ}
    (hxsign : ∀ r h, IsSign (x r h))
    (hxodd : IsOddMatrix conj x)
    (h : PairedMatrixReach conj target x z) :
    AlgebraicTransitionWitness x z := by
  induction h generalizing x with
  | refl x =>
      exact S.identity.realize x
  | @step x z g i j hrest ih =>
      have hg : g ≠ conj g :=
        conj_ne_self_of_row conj x hxsign hxodd i.1 g
      let x' := switchConjugatePair conj x g i.1 j.1
      have hx'sign : ∀ r h, IsSign (x' r h) := by
        simpa [x'] using
          switchConjugatePair_isSign conj x hxsign g i.1 j.1
      have hx'odd : IsOddMatrix conj x' := by
        simpa [x'] using
          switchConjugatePair_odd conj hconj x hxodd g hg i.1 j.1
      exact S.composition.compose
        (S.atomic.realize x hxsign hxodd g hg i j)
        (ih hx'sign hx'odd)

/-- Equal column sums now feed the invariant-aware geometric path directly,
with no ad hoc reconstruction of sign/oddness hypotheses at the atomic layer. -/
def transitionOfEqualColumnSumsWithInvariants
    (conj : G → G)
    (hconj : Function.Involutive conj)
    (x y : I → G → ℤ)
    (S : InvariantSwitchGeometrySupplier conj y)
    (hxsign : ∀ r g, IsSign (x r g))
    (hysign : ∀ r g, IsSign (y r g))
    (hxodd : IsOddMatrix conj x)
    (hyodd : IsOddMatrix conj y)
    (hsum : ∀ g, ∑ r, x r g = ∑ r, y r g) :
    AlgebraicTransitionWitness x y :=
  transitionOfReachWithInvariants conj hconj y S hxsign hxodd
    (pairedMatrixReach_of_equal_column_sums
      conj hconj x y hxsign hysign hxodd hyodd hsum)

/-- A finite combinatorial switch chain can be assembled into one global
algebraic transition witness once the geometric identity, atomic-switch, and
composition suppliers are admitted. -/
def transitionOfReach
    (conj : G → G)
    (target : I → G → ℤ)
    (S : SwitchGeometrySupplier conj target)
    {x z : I → G → ℤ}
    (h : PairedMatrixReach conj target x z) :
    AlgebraicTransitionWitness x z := by
  induction h with
  | refl x =>
      exact S.identity.realize x
  | @step x z g i j hrest ih =>
      exact S.composition.compose
        (S.atomic.realize x g i j)
        ih

/-- The complete conditional switch-reduction endpoint.

Equal column sums plus odd sign data give the finite switch chain locally.
Only the geometric switch suppliers remain external. -/
def transitionOfEqualColumnSums
    (conj : G → G)
    (hconj : Function.Involutive conj)
    (x y : I → G → ℤ)
    (S : SwitchGeometrySupplier conj y)
    (hxsign : ∀ r g, IsSign (x r g))
    (hysign : ∀ r g, IsSign (y r g))
    (hxodd : IsOddMatrix conj x)
    (hyodd : IsOddMatrix conj y)
    (hsum : ∀ g, ∑ r, x r g = ∑ r, y r g) :
    AlgebraicTransitionWitness x y :=
  transitionOfReach conj y S
    (pairedMatrixReach_of_equal_column_sums
      conj hconj x y hxsign hysign hxodd hyodd hsum)

end

end GRWTSK.AlgebraicGeometry.Hodge.CMFourFactorSwitchGeometry

namespace GRWTSK.AlgebraicGeometry.Hodge.CMFourFactorSwitchGeometry

/-- The remaining fixed-field geometric comparison, separated from factor
realization and switch combinatorics.

This object contains exactly the map from the genuine fourfold H1 tensor to
the descent coefficient model together with preservation of the declared
H^(2,2) subspace.  It deliberately does not identify any distinguished
generator. -/
structure CMFiniteActualToDescentComparison
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E.carrier}
    (actualTyping :
      CMFiniteFourFactorActualTyping E factors v₁ v₂ v₃ v₄)
    (hodgeRule :
      FourfoldActualHodgeTensorRule actualTyping.toActualTyping)
    (hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)) where
  compare :
    FourfoldActualTensor actualTyping.toActualTyping →ₗ[ℂ]
      (ℂ ⊗[ℚ] V)
  H22_le :
    hodgeRule.H22.map compare ≤ hodgeSubspace

/-- The remaining distinguished-generator equation once an actual-to-descent
comparison has been fixed.

Keeping this equality separate prevents Hodge preservation from being
conflated with the geometric identification of the canonical pure tensor. -/
structure CMFiniteActualGeneratorIdentification
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (D : CMFiniteFourfoldAssembly factors)
    (σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers)
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E.carrier}
    (actualTyping :
      CMFiniteFourFactorActualTyping E
        (factors.scalarTransport σ) v₁ v₂ v₃ v₄)
    {hodgeRule :
      FourfoldActualHodgeTensorRule actualTyping.toActualTyping}
    {hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)}
    (comparison :
      CMFiniteActualToDescentComparison
        actualTyping hodgeRule hodgeSubspace) where
  generator_eq :
    coefficientInclusion
        (D.assemble ((factors.scalarTransport σ).vector)) =
      comparison.compare
        (fourfoldActualPureTensor actualTyping.toActualTyping
          (actualTyping.first.realization.canonicalTensorActualH1Comparison.toActual
            actualTyping.first.vector)
          (actualTyping.second.realization.canonicalTensorActualH1Comparison.toActual
            actualTyping.second.vector)
          (actualTyping.third.realization.canonicalTensorActualH1Comparison.toActual
            actualTyping.third.vector)
          (actualTyping.fourth.realization.canonicalTensorActualH1Comparison.toActual
            actualTyping.fourth.vector))

/-- Factor realizations and switch alignment plus the two isolated geometric
obligations reconstruct the complete transported-generator witness.

Consequently the pre-descent frontier has exactly two geometric suppliers:
the H^(2,2)-preserving comparison and the canonical-generator equation. -/
def CMFiniteTransportedGeneratorWitness.ofComparison
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {D : CMFiniteFourfoldAssembly factors}
    {hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)}
    {σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers}
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E.carrier}
    (actualTyping :
      CMFiniteFourFactorActualTyping E
        (factors.scalarTransport σ) v₁ v₂ v₃ v₄)
    (alignment : CMFiniteFourFactorSwitchAlignment actualTyping)
    (hodgeRule : FourfoldActualHodgeTensorRule actualTyping.toActualTyping)
    (comparison :
      CMFiniteActualToDescentComparison
        actualTyping hodgeRule hodgeSubspace)
    (identification :
      CMFiniteActualGeneratorIdentification
        D σ actualTyping comparison) :
    CMFiniteTransportedGeneratorWitness D hodgeSubspace σ where
  v₁ := v₁
  v₂ := v₂
  v₃ := v₃
  v₄ := v₄
  actualTyping := actualTyping
  alignment := alignment
  hodgeRule := hodgeRule
  compare := comparison.compare
  H22_le := comparison.H22_le
  generator_eq := identification.generator_eq


/-- A generating family for the actual (2,2) component.  This is an explicit
geometric hypothesis: the existing tensor rule proves membership of certain
pure tensors, but does not itself prove that they span H22. -/
structure CMFiniteH22SpanningFamily
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E.carrier}
    (actualTyping : CMFiniteFourFactorActualTyping E factors v₁ v₂ v₃ v₄)
    (hodgeRule : FourfoldActualHodgeTensorRule actualTyping.toActualTyping) where
  generators : Set (FourfoldActualTensor actualTyping.toActualTyping)
  span_eq : Submodule.span ℂ generators = hodgeRule.H22

/-- To verify preservation of the entire actual (2,2) space it is enough to
check its declared spanning family.  No algebraic-cycle statement is used. -/
def CMFiniteActualToDescentComparison.ofSpanningFamily
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E.carrier}
    {actualTyping : CMFiniteFourFactorActualTyping E factors v₁ v₂ v₃ v₄}
    {hodgeRule : FourfoldActualHodgeTensorRule actualTyping.toActualTyping}
    {hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)}
    (family : CMFiniteH22SpanningFamily actualTyping hodgeRule)
    (compare : FourfoldActualTensor actualTyping.toActualTyping →ₗ[ℂ]
      (ℂ ⊗[ℚ] V))
    (generator_mem :
      ∀ x ∈ family.generators, compare x ∈ hodgeSubspace) :
    CMFiniteActualToDescentComparison actualTyping hodgeRule hodgeSubspace where
  compare := compare
  H22_le := by
    rw [← family.span_eq]
    rw [Submodule.map_span]
    exact Submodule.span_le.mpr (by
      rintro y ⟨x, hx, rfl⟩
      exact generator_mem x hx)


/-- A concrete, Hodge-typed pure-tensor generating set.  The four factor
types and the two/two weight count are part of membership, rather than
inferred from a single chosen switched tensor. -/
def CMFiniteBalancedPureTensorSet
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E.carrier}
    (D : CMFiniteFourFactorActualTyping E factors v₁ v₂ v₃ v₄) :
    Set (FourfoldActualTensor D.toActualTyping) :=
  { z | ∃ (a : D.first.realization.H1C)
      (b : D.second.realization.H1C)
      (c : D.third.realization.H1C)
      (d : D.fourth.realization.H1C)
      (τ₁ τ₂ τ₃ τ₄ : CMEmbeddingLines.WeightOneHodgeType),
      D.first.realization.IsOfType a τ₁ ∧
      D.second.realization.IsOfType b τ₂ ∧
      D.third.realization.IsOfType c τ₃ ∧
      D.fourth.realization.IsOfType d τ₄ ∧
      CMEmbeddingLines.pIndex τ₁ + CMEmbeddingLines.pIndex τ₂ +
        CMEmbeddingLines.pIndex τ₃ + CMEmbeddingLines.pIndex τ₄ = 2 ∧
      CMEmbeddingLines.qIndex τ₁ + CMEmbeddingLines.qIndex τ₂ +
        CMEmbeddingLines.qIndex τ₃ + CMEmbeddingLines.qIndex τ₄ = 2 ∧
      z = fourfoldActualPureTensor D.toActualTyping a b c d }

/-- Every explicitly balanced typed pure tensor lies in actual H^(2,2).
This is the direction provided by the existing tensor-product Hodge rule. -/
theorem CMFiniteBalancedPureTensorSet.subset_H22
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E.carrier}
    {D : CMFiniteFourFactorActualTyping E factors v₁ v₂ v₃ v₄}
    (R : FourfoldActualHodgeTensorRule D.toActualTyping) :
    CMFiniteBalancedPureTensorSet D ⊆ R.H22 := by
  rintro z ⟨a, b, c, d, τ₁, τ₂, τ₃, τ₄,
    ha, hb, hc, hd, hp, hq, rfl⟩
  exact R.pureTensor_mem_H22 a b c d τ₁ τ₂ τ₃ τ₄
    ha hb hc hd hp hq

/-- The switched canonical actual pure tensor is one of the explicitly
balanced generators. This supplies generator membership independently of
the still-missing reverse spanning inclusion. -/
theorem CMFiniteFourFactorSwitchAlignment.canonicalPureTensor_mem_balanced
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E.carrier}
    {D : CMFiniteFourFactorActualTyping E factors v₁ v₂ v₃ v₄}
    (A : CMFiniteFourFactorSwitchAlignment D) :
    fourfoldActualPureTensor D.toActualTyping
      (D.first.realization.canonicalTensorActualH1Comparison.toActual
        D.first.vector)
      (D.second.realization.canonicalTensorActualH1Comparison.toActual
        D.second.vector)
      (D.third.realization.canonicalTensorActualH1Comparison.toActual
        D.third.vector)
      (D.fourth.realization.canonicalTensorActualH1Comparison.toActual
        D.fourth.vector) ∈ CMFiniteBalancedPureTensorSet D := by
  refine ⟨_, _, _, _,
    CMEmbeddingLines.typeOfSign (v₁.value D.first.character),
    CMEmbeddingLines.typeOfSign (v₂.value D.second.character),
    CMEmbeddingLines.typeOfSign (v₃.value D.third.character),
    CMEmbeddingLines.typeOfSign (v₄.value D.fourth.character),
    D.first.actual_type, D.second.actual_type,
    D.third.actual_type, D.fourth.actual_type,
    A.p_two, A.q_two, rfl⟩

/-- The missing reverse inclusion is made explicit.  Hodge-type membership
alone does not prove that balanced pure tensors span all of H^(2,2). -/
structure CMFiniteBalancedPureTensorSpanning
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E.carrier}
    (D : CMFiniteFourFactorActualTyping E factors v₁ v₂ v₃ v₄)
    (R : FourfoldActualHodgeTensorRule D.toActualTyping) where
  H22_le_span :
    R.H22 ≤ Submodule.span ℂ (CMFiniteBalancedPureTensorSet D)

/-- Combining the automatic inclusion with the explicit spanning supplier
gives the generating family needed by the comparison construction. -/
def CMFiniteBalancedPureTensorSpanning.toSpanningFamily
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E.carrier}
    {D : CMFiniteFourFactorActualTyping E factors v₁ v₂ v₃ v₄}
    {R : FourfoldActualHodgeTensorRule D.toActualTyping}
    (S : CMFiniteBalancedPureTensorSpanning D R) :
    CMFiniteH22SpanningFamily D R where
  generators := CMFiniteBalancedPureTensorSet D
  span_eq := le_antisymm
    (Submodule.span_le.mpr (R.subset_H22))
    S.H22_le_span

/-- Explicit balanced-pure-tensor image test for a proposed actual-to-descent
comparison.  It is strictly weaker as an input than a global H22-preservation
assertion; global preservation is derived after a spanning certificate. -/
structure CMFiniteBalancedTensorImageTest
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E.carrier}
    (D : CMFiniteFourFactorActualTyping E factors v₁ v₂ v₃ v₄)
    (hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)) where
  compare : FourfoldActualTensor D.toActualTyping →ₗ[ℂ]
    (ℂ ⊗[ℚ] V)
  balanced_mem :
    ∀ z ∈ CMFiniteBalancedPureTensorSet D,
      compare z ∈ hodgeSubspace

/-- Spanning and a pointwise image test together yield the actual-to-descent
comparison.  The argument uses only the span induction principle, so it
does not presuppose a tensor comparison theorem from external geometry. -/
def CMFiniteBalancedTensorImageTest.toComparison
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E.carrier}
    {D : CMFiniteFourFactorActualTyping E factors v₁ v₂ v₃ v₄}
    {R : FourfoldActualHodgeTensorRule D.toActualTyping}
    {hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)}
    (T : CMFiniteBalancedTensorImageTest D hodgeSubspace)
    (S : CMFiniteBalancedPureTensorSpanning D R) :
    CMFiniteActualToDescentComparison D R hodgeSubspace where
  compare := T.compare
  H22_le := by
    intro z hz
    obtain ⟨x, hx, rfl⟩ := Submodule.mem_map.mp hz
    apply Submodule.span_induction (S.H22_le_span hx)
    · intro y hy
      exact T.balanced_mem y hy
    · exact hodgeSubspace.zero_mem
    · intro y w hy hw
      exact hodgeSubspace.add_mem hy hw
    · intro a y hy
      exact hodgeSubspace.smul_mem a hy

/-- Pointwise Hodge image compatibility may be checked directly on four
actual weight-one inputs with a balanced list of types.  This avoids
requiring callers to manipulate the existentially defined generating set. -/
def CMFiniteBalancedTensorImageTest.ofPureTensorRule
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E.carrier}
    (D : CMFiniteFourFactorActualTyping E factors v₁ v₂ v₃ v₄)
    (hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V))
    (compare : FourfoldActualTensor D.toActualTyping →ₗ[ℂ]
      (ℂ ⊗[ℚ] V))
    (pure_mem :
      ∀ (a : D.first.realization.H1C)
        (b : D.second.realization.H1C)
        (c : D.third.realization.H1C)
        (d : D.fourth.realization.H1C)
        (τ₁ τ₂ τ₃ τ₄ : CMEmbeddingLines.WeightOneHodgeType),
        D.first.realization.IsOfType a τ₁ →
        D.second.realization.IsOfType b τ₂ →
        D.third.realization.IsOfType c τ₃ →
        D.fourth.realization.IsOfType d τ₄ →
        CMEmbeddingLines.pIndex τ₁ + CMEmbeddingLines.pIndex τ₂ +
          CMEmbeddingLines.pIndex τ₃ + CMEmbeddingLines.pIndex τ₄ = 2 →
        CMEmbeddingLines.qIndex τ₁ + CMEmbeddingLines.qIndex τ₂ +
          CMEmbeddingLines.qIndex τ₃ + CMEmbeddingLines.qIndex τ₄ = 2 →
        compare (fourfoldActualPureTensor D.toActualTyping a b c d) ∈
          hodgeSubspace) :
    CMFiniteBalancedTensorImageTest D hodgeSubspace where
  compare := compare
  balanced_mem := by
    rintro z ⟨a, b, c, d, τ₁, τ₂, τ₃, τ₄,
      ha, hb, hc, hd, hp, hq, rfl⟩
    exact pure_mem a b c d τ₁ τ₂ τ₃ τ₄ ha hb hc hd hp hq

/-- Pure-tensor image compatibility together with the separate balanced
spanning certificate suffices for the comparison required by descent. -/
def CMFiniteActualToDescentComparison.ofPureTensorRule
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {v₁ v₂ v₃ v₄ : CMNumberFieldIndex.OddSignRow E.carrier}
    (D : CMFiniteFourFactorActualTyping E factors v₁ v₂ v₃ v₄)
    (R : FourfoldActualHodgeTensorRule D.toActualTyping)
    (hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V))
    (S : CMFiniteBalancedPureTensorSpanning D R)
    (compare : FourfoldActualTensor D.toActualTyping →ₗ[ℂ]
      (ℂ ⊗[ℚ] V))
    (pure_mem :
      ∀ (a : D.first.realization.H1C)
        (b : D.second.realization.H1C)
        (c : D.third.realization.H1C)
        (d : D.fourth.realization.H1C)
        (τ₁ τ₂ τ₃ τ₄ : CMEmbeddingLines.WeightOneHodgeType),
        D.first.realization.IsOfType a τ₁ →
        D.second.realization.IsOfType b τ₂ →
        D.third.realization.IsOfType c τ₃ →
        D.fourth.realization.IsOfType d τ₄ →
        CMEmbeddingLines.pIndex τ₁ + CMEmbeddingLines.pIndex τ₂ +
          CMEmbeddingLines.pIndex τ₃ + CMEmbeddingLines.pIndex τ₄ = 2 →
        CMEmbeddingLines.qIndex τ₁ + CMEmbeddingLines.qIndex τ₂ +
          CMEmbeddingLines.qIndex τ₃ + CMEmbeddingLines.qIndex τ₄ = 2 →
        compare (fourfoldActualPureTensor D.toActualTyping a b c d) ∈
          hodgeSubspace) :
    CMFiniteActualToDescentComparison D R hodgeSubspace :=
  (CMFiniteBalancedTensorImageTest.ofPureTensorRule
    D hodgeSubspace compare pure_mem).toComparison S

/-- Direct fixed-field criterion for the distinguished generator. Unlike
the global comparison constructor, this requires neither H22 spanning nor
preservation on arbitrary H22 vectors. Only the canonical pure tensor image
is needed for the orbit-span descent endpoint. -/
structure CMFiniteCanonicalImageWitness
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (D : CMFiniteFourfoldAssembly factors)
    (hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V))
    (σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers) where
  v₁ : CMNumberFieldIndex.OddSignRow E.carrier
  v₂ : CMNumberFieldIndex.OddSignRow E.carrier
  v₃ : CMNumberFieldIndex.OddSignRow E.carrier
  v₄ : CMNumberFieldIndex.OddSignRow E.carrier
  actualTyping :
    CMFiniteFourFactorActualTyping E
      (factors.scalarTransport σ) v₁ v₂ v₃ v₄
  alignment : CMFiniteFourFactorSwitchAlignment actualTyping
  imageTest : CMFiniteBalancedTensorImageTest actualTyping hodgeSubspace
  generator_eq :
    coefficientInclusion
        (D.assemble ((factors.scalarTransport σ).vector)) =
      imageTest.compare
        (fourfoldActualPureTensor actualTyping.toActualTyping
          (actualTyping.first.realization.canonicalTensorActualH1Comparison.toActual
            actualTyping.first.vector)
          (actualTyping.second.realization.canonicalTensorActualH1Comparison.toActual
            actualTyping.second.vector)
          (actualTyping.third.realization.canonicalTensorActualH1Comparison.toActual
            actualTyping.third.vector)
          (actualTyping.fourth.realization.canonicalTensorActualH1Comparison.toActual
            actualTyping.fourth.vector))

/-- A balanced image test and the actual canonical generator equation suffice
for descent-side Hodge membership, with no spanning premise. -/
theorem CMFiniteCanonicalImageWitness.generator_mem_hodge
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {D : CMFiniteFourfoldAssembly factors}
    {hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)}
    {σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers}
    (W : CMFiniteCanonicalImageWitness D hodgeSubspace σ) :
    coefficientInclusion
        (D.assemble ((factors.scalarTransport σ).vector)) ∈
      hodgeSubspace := by
  rw [W.generator_eq]
  exact W.imageTest.balanced_mem _
    W.alignment.canonicalPureTensor_mem_balanced

/-- A uniform family of direct canonical image witnesses supplies the same
finite transported-generator Hodge package as the stronger H22-comparison
witness, without requiring any balanced spanning theorem. -/
def CMFiniteTransportedGeneratorHodgeData.ofCanonicalImageWitnesses
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {D : CMFiniteFourfoldAssembly factors}
    {hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)}
    (W : ∀ σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers,
      CMFiniteCanonicalImageWitness D hodgeSubspace σ) :
    CMFiniteTransportedGeneratorHodgeData D hodgeSubspace where
  generator_mem := fun σ => (W σ).generator_mem_hodge

/-- Minimal comparison witness for the one transported canonical tensor:
only its image and the assembly identification are required. This is
strictly a dependency interface, not a construction of the geometric map. -/
structure CMFiniteCanonicalPointWitness
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    (D : CMFiniteFourfoldAssembly factors)
    (hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V))
    (σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers) where
  v₁ : CMNumberFieldIndex.OddSignRow E.carrier
  v₂ : CMNumberFieldIndex.OddSignRow E.carrier
  v₃ : CMNumberFieldIndex.OddSignRow E.carrier
  v₄ : CMNumberFieldIndex.OddSignRow E.carrier
  actualTyping :
    CMFiniteFourFactorActualTyping E
      (factors.scalarTransport σ) v₁ v₂ v₃ v₄
  alignment : CMFiniteFourFactorSwitchAlignment actualTyping
  compare : FourfoldActualTensor actualTyping.toActualTyping →ₗ[ℂ]
    (ℂ ⊗[ℚ] V)
  canonical_image_mem :
    compare
      (fourfoldActualPureTensor actualTyping.toActualTyping
        (actualTyping.first.realization.canonicalTensorActualH1Comparison.toActual
          actualTyping.first.vector)
        (actualTyping.second.realization.canonicalTensorActualH1Comparison.toActual
          actualTyping.second.vector)
        (actualTyping.third.realization.canonicalTensorActualH1Comparison.toActual
          actualTyping.third.vector)
        (actualTyping.fourth.realization.canonicalTensorActualH1Comparison.toActual
          actualTyping.fourth.vector)) ∈ hodgeSubspace
  generator_eq :
    coefficientInclusion
        (D.assemble ((factors.scalarTransport σ).vector)) =
      compare
        (fourfoldActualPureTensor actualTyping.toActualTyping
          (actualTyping.first.realization.canonicalTensorActualH1Comparison.toActual
            actualTyping.first.vector)
          (actualTyping.second.realization.canonicalTensorActualH1Comparison.toActual
            actualTyping.second.vector)
          (actualTyping.third.realization.canonicalTensorActualH1Comparison.toActual
            actualTyping.third.vector)
          (actualTyping.fourth.realization.canonicalTensorActualH1Comparison.toActual
            actualTyping.fourth.vector))

/-- Minimal pointwise geometric input gives transported generator membership. -/
theorem CMFiniteCanonicalPointWitness.generator_mem_hodge
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {D : CMFiniteFourfoldAssembly factors}
    {hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)}
    {σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers}
    (W : CMFiniteCanonicalPointWitness D hodgeSubspace σ) :
    coefficientInclusion
        (D.assemble ((factors.scalarTransport σ).vector)) ∈
      hodgeSubspace := by
  rw [W.generator_eq]
  exact W.canonical_image_mem

/-- Pointwise geometric data for every scalar conjugate suffices for
the established orbit-span descent interface. -/
def CMFiniteTransportedGeneratorHodgeData.ofCanonicalPointWitnesses
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {D : CMFiniteFourfoldAssembly factors}
    {hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)}
    (W : ∀ σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers,
      CMFiniteCanonicalPointWitness D hodgeSubspace σ) :
    CMFiniteTransportedGeneratorHodgeData D hodgeSubspace where
  generator_mem := fun σ => (W σ).generator_mem_hodge

/-- The balanced-image witness implies the pointwise witness without any
spanning theorem. This is a forgetful conversion: it does not manufacture
the actual comparison map or establish a new geometric Hodge fact. -/
def CMFiniteCanonicalImageWitness.toPointWitness
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {D : CMFiniteFourfoldAssembly factors}
    {hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)}
    {σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers}
    (W : CMFiniteCanonicalImageWitness D hodgeSubspace σ) :
    CMFiniteCanonicalPointWitness D hodgeSubspace σ where
  v₁ := W.v₁
  v₂ := W.v₂
  v₃ := W.v₃
  v₄ := W.v₄
  actualTyping := W.actualTyping
  alignment := W.alignment
  compare := W.imageTest.compare
  canonical_image_mem :=
    W.imageTest.balanced_mem _
      W.alignment.canonicalPureTensor_mem_balanced
  generator_eq := W.generator_eq

/-- The new pointwise route is logically no stronger than the prior
balanced-image route: any previous family of witnesses converts directly. -/
def CMFiniteTransportedGeneratorHodgeData.ofCanonicalImageWitnessesViaPoint
    {E : CMGaloisIntermediateField}
    {factors : CMFiniteFourEmbeddingLineVectors E}
    {V : Type*} [AddCommGroup V] [Module ℚ V]
    {D : CMFiniteFourfoldAssembly factors}
    {hodgeSubspace : Submodule ℂ (ℂ ⊗[ℚ] V)}
    (W : ∀ σ : AlgebraicNumbers ≃ₐ[ℚ] AlgebraicNumbers,
      CMFiniteCanonicalImageWitness D hodgeSubspace σ) :
    CMFiniteTransportedGeneratorHodgeData D hodgeSubspace :=
  CMFiniteTransportedGeneratorHodgeData.ofCanonicalPointWitnesses
    (fun σ => (W σ).toPointWitness)

end GRWTSK.AlgebraicGeometry.Hodge.CMFourFactorSwitchGeometry
