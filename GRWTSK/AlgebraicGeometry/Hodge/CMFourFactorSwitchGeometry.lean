import GRWTSK.AlgebraicGeometry.Hodge.CMFourFactorSwitchCombinatorics
import GRWTSK.AlgebraicGeometry.Hodge.CMEmbeddingTransport
import GRWTSK.AlgebraicGeometry.Hodge.CMFourFactorAlgebraicity

/-!
# Geometric supplier boundary for finite four-factor switch chains

The finite sign-switch relation is local.  Turning one elementary switch into
an algebraic transition tensor, and composing consecutive transition tensors,
are geometric statements from the external CM-Hodge manuscript.

This file isolates those two geometric suppliers and proves the formal
composition theorem: once they are supplied, every finite local switch chain
has a global algebraic transition witness.

No constructor for either supplier is proved here.
-/

set_option autoImplicit false

namespace GRWTSK.AlgebraicGeometry.Hodge.CMFourFactorSwitchGeometry

open CMFourBalance
open CMFourFactorSwitchCombinatorics

noncomputable section

variable {I G : Type*} [Fintype I] [DecidableEq I]
  [Fintype G] [DecidableEq G]

/-- Opaque geometric transition between two sign matrices.

The carrier is intentionally abstract because the current local library has no
cohomology/cycle API at the scope required by the manuscript. -/
structure AlgebraicTransitionWitness
    (x y : I → G → ℤ) where
  carrier : Type*
  transition : carrier
  algebraic : Prop
  algebraic_proof : algebraic
  nonzero : Prop
  nonzero_proof : nonzero

/-- Algebraic two-factor witness for one unchanged row.

Geometrically this is the degree-one identity/diagonal correspondence on the
same weight-one CM factor.  The current repository has no cycle-class API at
this scope, so the carrier remains abstract while algebraicity and nonvanishing
are recorded explicitly. -/
structure TwoFactorIdentityWitness
    (row : G → ℤ) where
  carrier : Type*
  tensor : carrier
  algebraic : Prop
  algebraic_proof : algebraic
  nonzero : Prop
  nonzero_proof : nonzero

/-- Exact geometric supplier for one unchanged row.

In the manuscript this is the algebraic line
U(v)_1 tensor U(v)_c, equivalently the degree-one identity/diagonal
correspondence on B(v). -/
structure TwoFactorIdentitySupplier where
  realize :
    ∀ (row : G → ℤ),
      TwoFactorIdentityWitness row

/-- Assembly of all unchanged-row two-factor witnesses into the identity
transition on the whole row list.

This abstracts only the geometric pullback-to-slots and product operation; it
does not supply any four-factor switched class. -/
structure IdentityTensorAssemblySupplier where
  assemble :
    ∀ (x : I → G → ℤ),
      (∀ r : I, TwoFactorIdentityWitness (x r)) →
      AlgebraicTransitionWitness x x

/-- Identity transition supplier.

In the manuscript this is generated by the unchanged two-factor tensors
U(v)_1 tensor U(v)_c. -/
structure IdentityTransitionSupplier where
  realize :
    ∀ (x : I → G → ℤ),
      AlgebraicTransitionWitness x x

/-- The routine unchanged-row geometry canonically supplies the identity
transition interface once the per-row diagonal classes and their finite tensor
assembly are available. -/
def identityTransitionSupplierOfTwoFactor
    (P : TwoFactorIdentitySupplier)
    (A : IdentityTensorAssemblySupplier) :
    IdentityTransitionSupplier where
  realize := fun x => A.assemble x (fun r => P.realize (x r))

/-- Algebraic witness for the genuinely switched four-factor core.

Only the old/new factors belonging to the two changed rows are represented
here.  Unchanged rows are deliberately excluded. -/
structure FourFactorSwitchCoreWitness
    (conj : G → G)
    (x : I → G → ℤ)
    (g : G) (i j : I) where
  carrier : Type*
  tensor : carrier
  algebraic : Prop
  algebraic_proof : algebraic
  nonzero : Prop
  nonzero_proof : nonzero

/-- Existential package for the rational four-factor Hodge witness attached
to one switched core.

The package hides the auxiliary rational vector space while retaining the
actual four sign rows and rational witness consumed by the existing
FourFactorAlgebraicitySupplier. -/
structure SwitchCoreRationalWitnessPackage
    (conj : G → G) where
  v₁ v₂ v₃ v₄ : OddSignRow G conj
  V : Type*
  [V_addCommGroup : AddCommGroup V]
  [V_moduleQ : Module ℚ V]
  witness :
    CMFourFactorAlgebraicity.RationalFourFactorHodgeWitness
      G conj v₁ v₂ v₃ v₄ V

/-- Pure identification adapter from one atomic switched configuration to the
rational four-factor Hodge witness already used by the repository's
algebraicity interface.

This adapter carries no algebraicity theorem. -/
structure SwitchCoreRationalWitnessAdapter
    (conj : G → G)
    (target : I → G → ℤ) where
  identify :
    ∀ (x : I → G → ℤ)
      (g : G)
      (i : PosNegMismatch (fun r => x r g) (fun r => target r g))
      (j : NegPosMismatch (fun r => x r g) (fun r => target r g)),
      SwitchCoreRationalWitnessPackage conj

/-- Geometric packaging of the algebraic-cycle witness produced by the
existing four-factor algebraicity supplier as the opaque switched-core witness
consumed by the transition layer.

This is an interface conversion only; the cycle algebraicity is supplied
upstream by FourFactorAlgebraicitySupplier. -/
structure AlgebraicCycleToSwitchCoreAdapter
    (conj : G → G)
    (target : I → G → ℤ) where
  package :
    ∀ (x : I → G → ℤ)
      (g : G)
      (i : PosNegMismatch (fun r => x r g) (fun r => target r g))
      (j : NegPosMismatch (fun r => x r g) (fun r => target r g))
      (R : SwitchCoreRationalWitnessPackage conj),
      CMFourFactorAlgebraicity.AlgebraicCycleWitness
          G conj R.v₁ R.v₂ R.v₃ R.v₄ R.V R.witness →
        FourFactorSwitchCoreWitness conj x g i.1 j.1

/-- Independent four-factor algebraicity supplier.

This is the precise switch-specific theorem boundary: one elementary switch
on two rows supplies a nonzero algebraic four-factor core. -/
structure FourFactorSwitchCoreSupplier
    (conj : G → G)
    (target : I → G → ℤ) where
  realize :
    ∀ (x : I → G → ℤ)
      (g : G)
      (i : PosNegMismatch (fun r => x r g) (fun r => target r g))
      (j : NegPosMismatch (fun r => x r g) (fun r => target r g)),
      FourFactorSwitchCoreWitness conj x g i.1 j.1

/-- The existing repository-wide four-factor algebraicity supplier can be
used as the sole algebraicity theorem for atomic switched cores.

The remaining inputs are identification/packaging adapters only. -/
def fourFactorSwitchCoreSupplierOfAlgebraicity
    (conj : G → G)
    (target : I → G → ℤ)
    (R : SwitchCoreRationalWitnessAdapter conj target)
    (P : AlgebraicCycleToSwitchCoreAdapter conj target)
    (S : CMFourFactorAlgebraicity.FourFactorAlgebraicitySupplier) :
    FourFactorSwitchCoreSupplier conj target where
  realize := fun x g i j =>
    let W := R.identify x g i j
    P.package x g i j W (S.realize W.witness)

/-- Routine assembly of one four-factor switched core with all unchanged-row
two-factor identity witnesses.

The row-equality proof supplied to each unchanged factor is the local
combinatorial theorem that rows outside i,j are literally unchanged. -/
structure AtomicTransitionAssemblySupplier
    (conj : G → G) where
  assemble :
    ∀ (x : I → G → ℤ)
      (g : G) (i j : I),
      FourFactorSwitchCoreWitness conj x g i j →
      (∀ r : I, r ≠ i → r ≠ j → TwoFactorIdentityWitness (x r)) →
      AlgebraicTransitionWitness x (switchConjugatePair conj x g i j)

/-- One elementary conjugate-paired switch gives an algebraic transition.

This is the exact local geometric content that must be supplied by the
four-factor switch theorem together with the unchanged-row two-factor classes. -/
structure AtomicSwitchTransitionSupplier
    (conj : G → G)
    (target : I → G → ℤ) where
  realize :
    ∀ (x : I → G → ℤ)
      (g : G)
      (i : PosNegMismatch (fun r => x r g) (fun r => target r g))
      (j : NegPosMismatch (fun r => x r g) (fun r => target r g)),
      AlgebraicTransitionWitness x
        (switchConjugatePair conj x g i.1 j.1)

/-- A four-factor core theorem plus unchanged-row identity classes and routine
slotwise assembly instantiate the generic atomic-switch transition supplier. -/
def atomicSwitchTransitionSupplierOfCore
    (conj : G → G)
    (target : I → G → ℤ)
    (C : FourFactorSwitchCoreSupplier conj target)
    (P : TwoFactorIdentitySupplier)
    (A : AtomicTransitionAssemblySupplier conj) :
    AtomicSwitchTransitionSupplier conj target where
  realize := fun x g i j =>
    A.assemble x g i.1 j.1
      (C.realize x g i j)
      (fun r _ _ => P.realize (x r))

section NonzeroScalarRecovery

variable {K T : Type*} [Field K] [AddCommGroup T] [Module K T]

/-- A subspace membership statement can be recovered from any nonzero scalar
multiple. This is the elementary final step in the manuscript's transition
composition formula. -/
theorem mem_of_nonzero_smul_mem
    (Z : Submodule K T)
    (a : K) (ha : a ≠ 0)
    (t : T)
    (hat : a • t ∈ Z) :
    t ∈ Z := by
  have h := Z.smul_mem a⁻¹ hat
  simpa [smul_smul, ha] using h

/-- Likewise a nonzero scalar multiple of a nonzero endpoint cannot vanish. -/
theorem smul_ne_zero
    (a : K) (ha : a ≠ 0)
    (t : T) (ht : t ≠ 0) :
    a • t ≠ 0 :=
  _root_.smul_ne_zero ha ht

/-- Abstract form of the manuscript's transition-composition identity:
a geometrically produced algebraic class is a nonzero scalar multiple of the
desired endpoint tensor. -/
structure NonzeroScalarCompositionData
    (Z : Submodule K T)
    (endpoint : T) where
  scalar : K
  scalar_ne_zero : scalar ≠ 0
  produced : T
  produced_mem : produced ∈ Z
  formula : produced = scalar • endpoint

/-- Once the geometric formula and scalar nonvanishing are supplied, endpoint
algebraicity is purely local linear algebra. -/
theorem NonzeroScalarCompositionData.endpoint_mem
    {Z : Submodule K T}
    {endpoint : T}
    (D : NonzeroScalarCompositionData Z endpoint) :
    endpoint ∈ Z := by
  apply mem_of_nonzero_smul_mem Z D.scalar D.scalar_ne_zero endpoint
  rwa [← D.formula]

end NonzeroScalarRecovery

section CanonicalTransportedMiddleLine

open scoped TensorProduct
open CMRegularBaseChange
open CMEmbeddingTransport

variable {k E : Type*} [Field k] [Field E] [Algebra k E]
  [FiniteDimensional k E] [IsGalois k E]

/-- Canonical tensor-model data for one transported middle embedding line. -/
structure CanonicalTransportedMiddleLineData
    (σ τ : E ≃ₐ[k] E) where
  beta : E ⊗[k] E
  gamma : E ⊗[k] E
  beta_mem :
    beta ∈ embeddingEigenspace (k := k) τ.toAlgHom
  gamma_mem :
    gamma ∈ embeddingEigenspace (k := k) (σ * τ).toAlgHom
  beta_ne_zero : beta ≠ 0
  gamma_ne_zero : gamma ≠ 0

/-- In the canonical tensor model, gamma is automatically a nonzero scalar
multiple of the scalar-conjugated beta.  No Hodge-Riemann input is used. -/
theorem CanonicalTransportedMiddleLineData.exists_scale
    {σ τ : E ≃ₐ[k] E}
    (D : CanonicalTransportedMiddleLineData σ τ) :
    ∃ c : E, c ≠ 0 ∧
      D.gamma = c •
        GRWTSK.LinearAlgebra.TensorProduct.RationalScalarDescent.scalarConjugate
          σ D.beta := by
  exact CMEmbeddingTransport.exists_ne_zero_smul_scalarConjugate_eq
    (k := k) (E := E) σ τ
    D.beta_mem D.gamma_mem D.beta_ne_zero D.gamma_ne_zero

end CanonicalTransportedMiddleLine

section CohomologyToCanonicalComparison

open scoped TensorProduct
open CMRegularBaseChange
open CMEmbeddingTransport

variable {k E H : Type*} [Field k] [Field E] [Algebra k E]
  [FiniteDimensional k E] [IsGalois k E]
  [AddCommGroup H] [Module E H]

/-- Minimal comparison data between an actual cohomological realization and
the canonical Galois tensor model.

This structure does not assert that such a comparison exists; it records only
the exact compatibility needed to transport the already-local one-dimensional
eigenline argument back to cohomology. -/
structure CohomologyCanonicalLineComparison
    (σ τ : E ≃ₐ[k] E) where
  toCanonical : H ≃ₗ[E] (E ⊗[k] E)
  actualConjugate : H → H
  conjugation_compatibility :
    ∀ h,
      toCanonical (actualConjugate h) =
        GRWTSK.LinearAlgebra.TensorProduct.RationalScalarDescent.scalarConjugate
          σ (toCanonical h)
  beta : H
  gamma : H
  beta_ne_zero : beta ≠ 0
  gamma_ne_zero : gamma ≠ 0
  beta_line :
    toCanonical beta ∈ embeddingEigenspace (k := k) τ.toAlgHom
  gamma_line :
    toCanonical gamma ∈ embeddingEigenspace (k := k) (σ * τ).toAlgHom

/-- The comparison equivalence preserves nonzero vectors. -/
theorem CohomologyCanonicalLineComparison.beta_canonical_ne_zero
    {σ τ : E ≃ₐ[k] E}
    (D : CohomologyCanonicalLineComparison σ τ) :
    D.toCanonical D.beta ≠ 0 :=
  D.toCanonical.injective.ne_iff.mpr D.beta_ne_zero

theorem CohomologyCanonicalLineComparison.gamma_canonical_ne_zero
    {σ τ : E ≃ₐ[k] E}
    (D : CohomologyCanonicalLineComparison σ τ) :
    D.toCanonical D.gamma ≠ 0 :=
  D.toCanonical.injective.ne_iff.mpr D.gamma_ne_zero

/-- Once the actual cohomological embedding lines are compared with the
canonical tensor model and scalar conjugation is respected, the manuscript's
middle-line proportionality follows formally: gamma is a nonzero scalar
multiple of the actual conjugate of beta. -/
theorem CohomologyCanonicalLineComparison.exists_scale
    {σ τ : E ≃ₐ[k] E}
    (D : CohomologyCanonicalLineComparison σ τ) :
    ∃ c : E, c ≠ 0 ∧
      D.gamma = c • D.actualConjugate D.beta := by
  let C : CanonicalTransportedMiddleLineData (k := k) σ τ where
    beta := D.toCanonical D.beta
    gamma := D.toCanonical D.gamma
    beta_mem := D.beta_line
    gamma_mem := D.gamma_line
    beta_ne_zero := D.beta_canonical_ne_zero
    gamma_ne_zero := D.gamma_canonical_ne_zero
  obtain ⟨c, hc, hcan⟩ := C.exists_scale
  refine ⟨c, hc, D.toCanonical.injective ?_⟩
  rw [map_smul, D.conjugation_compatibility]
  exact hcan

end CohomologyToCanonicalComparison

section PositiveMiddlePairing

variable {V : Type*} [AddCommGroup V] [Module ℂ V]

/-- Abstract positivity package for the middle-factor pairing in the
transition-composition formula.

This is deliberately weaker than a geometric Hodge--Riemann theorem: it only
records the exact consequences needed to prove one scalar pairing is nonzero. -/
structure PositiveConjugatePairing where
  pairing : V → V → ℂ
  conjugatePartner : V → V
  energy : V → ℝ
  pairing_conjugate :
    ∀ v, pairing v (conjugatePartner v) = (energy v : ℂ)
  pairing_smul_right :
    ∀ v c w, pairing v (c • w) = c * pairing v w
  energy_pos :
    ∀ {v}, v ≠ 0 → 0 < energy v

/-- Positivity makes the pairing with the conjugate partner nonzero. -/
theorem PositiveConjugatePairing.pairing_conjugate_ne_zero
    (P : PositiveConjugatePairing V)
    {v : V} (hv : v ≠ 0) :
    P.pairing v (P.conjugatePartner v) ≠ 0 := by
  rw [P.pairing_conjugate v]
  exact Complex.ofReal_ne_zero.mpr (P.energy_pos hv).ne'

/-- If the second middle factor is a nonzero scalar multiple of the conjugate
partner of the first, then the transition scalar q is nonzero.

This is the exact formal implication used in the manuscript after the
geometric Hodge--Riemann positivity and scalar-conjugation identifications have
been supplied. -/
theorem PositiveConjugatePairing.pairing_scaled_conjugate_ne_zero
    (P : PositiveConjugatePairing V)
    {beta : V} (hbeta : beta ≠ 0)
    {c : ℂ} (hc : c ≠ 0) :
    P.pairing beta (c • P.conjugatePartner beta) ≠ 0 := by
  rw [P.pairing_smul_right]
  exact mul_ne_zero hc (P.pairing_conjugate_ne_zero hbeta)

/-- Exact local package for one manuscript middle-factor scalar q_i.

The geometric supplier still has to identify gamma with the scaled conjugate
partner and the cup/integration pairing with pairing. -/
structure MiddlePairingNonvanishingData where
  pairingData : PositiveConjugatePairing V
  beta : V
  beta_ne_zero : beta ≠ 0
  scale : ℂ
  scale_ne_zero : scale ≠ 0
  gamma : V
  gamma_eq : gamma = scale • pairingData.conjugatePartner beta

/-- The middle pairing q_i is nonzero once the two geometric identifications
have been packaged. -/
theorem MiddlePairingNonvanishingData.pairing_ne_zero
    (D : MiddlePairingNonvanishingData V) :
    D.pairingData.pairing D.beta D.gamma ≠ 0 := by
  rw [D.gamma_eq]
  exact D.pairingData.pairing_scaled_conjugate_ne_zero
    D.beta_ne_zero D.scale_ne_zero

/-- Geometric data already available before invoking Hodge--Riemann positivity.

This record isolates the cup/integration pairing, the selected middle vectors,
and the already-local scalar-proportionality input.  It does not assume
positivity. -/
structure GeometricMiddlePairingData where
  pairing : V → V → ℂ
  conjugatePartner : V → V
  beta : V
  beta_ne_zero : beta ≠ 0
  gamma : V
  scale : ℂ
  scale_ne_zero : scale ≠ 0
  gamma_eq :
    gamma = scale • conjugatePartner beta
  q : ℂ
  q_eq :
    q = pairing beta gamma
  pairing_smul_right :
    ∀ v c w, pairing v (c • w) = c * pairing v w

/-- Exact remaining Hodge--Riemann supplier for one middle factor.

It supplies only a positive real energy whose complexification equals the
ample-class pairing with the conjugate partner.  No algebraicity conclusion is
included. -/
structure AmpleClassHodgeRiemannSupplier
    (D : GeometricMiddlePairingData V) where
  energy : V → ℝ
  pairing_conjugate :
    ∀ v, D.pairing v (D.conjugatePartner v) = (energy v : ℂ)
  energy_pos :
    ∀ {v}, v ≠ 0 → 0 < energy v

/-- An ample-class Hodge--Riemann supplier canonically gives the abstract
positive-pairing package used by the local nonvanishing lemmas. -/
def AmpleClassHodgeRiemannSupplier.toPositiveConjugatePairing
    {D : GeometricMiddlePairingData V}
    (S : AmpleClassHodgeRiemannSupplier D) :
    PositiveConjugatePairing V where
  pairing := D.pairing
  conjugatePartner := D.conjugatePartner
  energy := S.energy
  pairing_conjugate := S.pairing_conjugate
  pairing_smul_right := D.pairing_smul_right
  energy_pos := S.energy_pos

/-- Exact comparison data for the geometric ample-class middle pairing.

The external geometry supplies the identification of the integral/cup-product
pairing with the abstract positive conjugate pairing.  Scalar proportionality
of gamma with the conjugate partner is recorded separately, so the logical
dependencies remain auditable. -/
structure AmpleClassMiddlePairingComparison where
  pairingData : PositiveConjugatePairing V
  beta : V
  beta_ne_zero : beta ≠ 0
  gamma : V
  scale : ℂ
  scale_ne_zero : scale ≠ 0
  gamma_eq :
    gamma = scale • pairingData.conjugatePartner beta
  q : ℂ
  q_eq :
    q = pairingData.pairing beta gamma

/-- The exact Hodge--Riemann supplier constructs the previously-declared
ample-class comparison package. -/
def AmpleClassHodgeRiemannSupplier.toComparison
    {D : GeometricMiddlePairingData V}
    (S : AmpleClassHodgeRiemannSupplier D) :
    AmpleClassMiddlePairingComparison V where
  pairingData := S.toPositiveConjugatePairing
  beta := D.beta
  beta_ne_zero := D.beta_ne_zero
  gamma := D.gamma
  scale := D.scale
  scale_ne_zero := D.scale_ne_zero
  gamma_eq := D.gamma_eq
  q := D.q
  q_eq := D.q_eq

/-- Once the ample-class pairing has been identified with the positive
conjugate pairing, the manuscript scalar q_i is nonzero locally. -/
theorem AmpleClassMiddlePairingComparison.q_ne_zero
    (D : AmpleClassMiddlePairingComparison V) :
    D.q ≠ 0 := by
  rw [D.q_eq, D.gamma_eq]
  exact D.pairingData.pairing_scaled_conjugate_ne_zero
    D.beta_ne_zero D.scale_ne_zero

/-- Therefore the Hodge--Riemann supplier is exactly sufficient to prove
the geometric middle scalar nonzero. -/
theorem AmpleClassHodgeRiemannSupplier.q_ne_zero
    {D : GeometricMiddlePairingData V}
    (S : AmpleClassHodgeRiemannSupplier D) :
    D.q ≠ 0 :=
  S.toComparison.q_ne_zero

/-- A finite product of nonzero middle pairing scalars is nonzero. -/
theorem product_middlePairing_ne_zero
    {J : Type*} [Fintype J]
    (q : J → ℂ)
    (hq : ∀ j, q j ≠ 0) :
    (∏ j, q j) ≠ 0 := by
  exact Finset.prod_ne_zero_iff.mpr (by
    intro j _
    exact hq j)

/-- Signed scalar in the manuscript transition-composition formula. -/
def transitionCompositionScalar
    {J : Type*} [Fintype J]
    (parity : ℤ)
    (q : J → ℂ) : ℂ :=
  ((-1 : ℂ) ^ parity.natAbs) * ∏ j, q j

/-- The signed transition-composition scalar is nonzero as soon as every
middle pairing scalar is nonzero. -/
theorem transitionCompositionScalar_ne_zero
    {J : Type*} [Fintype J]
    (parity : ℤ)
    (q : J → ℂ)
    (hq : ∀ j, q j ≠ 0) :
    transitionCompositionScalar parity q ≠ 0 := by
  unfold transitionCompositionScalar
  exact mul_ne_zero (pow_ne_zero _ (by norm_num))
    (product_middlePairing_ne_zero q hq)

end PositiveMiddlePairing

/-- Geometric composition of consecutive algebraic transitions.

This abstracts the manuscript's pullback/cup-product/pushforward construction,
including its nonvanishing pairing factor. -/
structure TransitionCompositionSupplier where
  compose :
    ∀ {x y z : I → G → ℤ},
      AlgebraicTransitionWitness x y →
      AlgebraicTransitionWitness y z →
      AlgebraicTransitionWitness x z

/-- The exact two geometric suppliers required after finite combinatorial
connectivity. -/
structure SwitchGeometrySupplier
    (conj : G → G)
    (target : I → G → ℤ) where
  identity : IdentityTransitionSupplier
  atomic : AtomicSwitchTransitionSupplier conj target
  composition : TransitionCompositionSupplier

/-- A finite combinatorial switch chain can be assembled into one global
algebraic transition witness once the geometric identity, atomic-switch, and
composition suppliers are admitted. -/
def transitionOfReach
    (conj : G → G)
    (target : I → G → ℤ)
    (S : SwitchGeometrySupplier conj target)
    {x z : I → G → ℤ}
    (h : PairedMatrixReach conj target x z) :
    AlgebraicTransitionWitness x z := by
  induction h with
  | refl x =>
      exact S.identity.realize x
  | @step x z g i j hrest ih =>
      exact S.composition.compose
        (S.atomic.realize x g i j)
        ih

/-- The complete conditional switch-reduction endpoint.

Equal column sums plus odd sign data give the finite switch chain locally.
Only the geometric switch suppliers remain external. -/
def transitionOfEqualColumnSums
    (conj : G → G)
    (hconj : Function.Involutive conj)
    (x y : I → G → ℤ)
    (S : SwitchGeometrySupplier conj y)
    (hxsign : ∀ r g, IsSign (x r g))
    (hysign : ∀ r g, IsSign (y r g))
    (hxodd : IsOddMatrix conj x)
    (hyodd : IsOddMatrix conj y)
    (hsum : ∀ g, ∑ r, x r g = ∑ r, y r g) :
    AlgebraicTransitionWitness x y :=
  transitionOfReach conj y S
    (pairedMatrixReach_of_equal_column_sums
      conj hconj x y hxsign hysign hxodd hyodd hsum)

end

end GRWTSK.AlgebraicGeometry.Hodge.CMFourFactorSwitchGeometry
