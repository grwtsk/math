import GRWTSK.ComputerScience.AlgorithmsInComputerScience.CivilSystemsResilience

/-!
# Civil-system accumulation and protected clinical capacity

Attribution: grwtsk contributors.

A single event is not a system-wide violation. Repeated unresolved work can
accumulate through direct arrivals and feedback-driven rework; corrections
reduce the stock. The arithmetic is conditional on externally established
units and on the conservation equation. It does not establish legal liability,
religious wrongdoing, a medical outcome, or a real-world tipping point.

This module *reuses* the existing `GRWTSK.CivilSystems.Queue` conservation,
boundedness, and unboundedness theorems instead of postulating a new queue law.
A review flag is a question, not a finding of harm or wrongdoing.
-/

namespace GRWTSK.CivilSystems.Accumulation

/-- A case or process observation whose meaning remains evidence-relative.
`accepted` and `duplicate` are external review results, not authenticated by
this mathematical structure. Units are administrative effort, not damages. -/
structure Signal (Obligation : Type*) where
  obligation : Obligation
  finding : GRWTSK.CivilSystems.Finding
  accepted : Bool
  duplicate : Bool
  documentedReworkUnits : Nat
  investigationUnits : Nat

/-- Only independently accepted, nonduplicated contradictions contribute to
an inventory of *documented rework*, never to an inventory of legal guilt. -/
def Signal.documentedUnits {O : Type*} (s : Signal O) : Nat :=
  if s.accepted && !s.duplicate && s.finding == .contradicted then
    s.documentedReworkUnits else 0

/-- Unknown observations may still generate review work without being counted
as established defects. -/
def Signal.reviewUnits {O : Type*} (s : Signal O) : Nat :=
  if s.accepted && !s.duplicate && s.finding == .unknown then
    s.investigationUnits else 0

theorem unknown_is_not_documented_defect {O : Type*} (s : Signal O)
    (h : s.finding = .unknown) : s.documentedUnits = 0 := by
  simp [Signal.documentedUnits, h]

theorem unknown_can_generate_review {O : Type*} (s : Signal O)
    (h : s.finding = .unknown)
    (ha : s.accepted = true) (hd : s.duplicate = false) :
    s.reviewUnits = s.investigationUnits := by
  simp [Signal.reviewUnits, h, ha, hd]

theorem duplicate_generates_no_documented_units {O : Type*} (s : Signal O)
    (h : s.duplicate = true) : s.documentedUnits = 0 := by
  simp [Signal.documentedUnits, h]

/-- A source-bound but not source-authenticating period ledger. `direct` is
new administratively unresolved work; `feedback` is rework generated by the
existing process; `repaired` is actually completed correction in the same units.
No obligation, clinical outcome, or misconduct is inferred by this equation. -/
structure Trajectory where
  burden : Nat → Nat
  direct : Nat → Nat
  feedback : Nat → Nat
  repaired : Nat → Nat
  conservation : ∀ t, burden (t + 1) + repaired t =
    burden t + direct t + feedback t

/-- The source's existing queue is exactly the aggregate of direct arrivals
and feedback-driven rework. This is a transport identity, not a new axiom. -/
def Trajectory.toQueue (s : Trajectory) : GRWTSK.CivilSystems.Queue where
  backlog := s.burden
  arriving := fun t => s.direct t + s.feedback t
  completed := s.repaired
  conservation := by
    intro t
    simpa only [add_assoc] using s.conservation t

/-- When repairs cover both direct failures and their rework, accumulated
burden is bounded by its initial level. -/
theorem no_accumulation_if_repair_covers_inflow (s : Trajectory)
    (h : ∀ t, s.direct t + s.feedback t ≤ s.repaired t) (t : Nat) :
    s.burden t ≤ s.burden 0 := by
  exact s.toQueue.bounded h t

/-- One excess unit *every period* forces the stock to pass any specified
finite level. It is not a forecast of when a real institution will fail. -/
theorem eventually_crosses_any_threshold (s : Trajectory)
    (h : ∀ t, s.repaired t + 1 ≤ s.direct t + s.feedback t)
    (threshold : Nat) :
    ∃ t, threshold ≤ s.burden t := by
  exact s.toQueue.unbounded h threshold

/-- A perfectly balanced workload can remain steady despite ongoing work:
positive arrivals alone do not imply an avalanche. -/
def steadyWork : Trajectory where
  burden := fun _ => 0
  direct := fun _ => 1
  feedback := fun _ => 0
  repaired := fun _ => 1
  conservation := by intro t; decide

theorem steady_work_never_accumulates (t : Nat) :
    steadyWork.burden t = 0 := rfl

/-- Unresolved feedback can drive accumulation even if direct intake is zero.
This example is synthetic, not an empirical claim about any institution. -/
def pureFeedback : Trajectory where
  burden := fun t => t
  direct := fun _ => 0
  feedback := fun _ => 1
  repaired := fun _ => 0
  conservation := by intro t; omega

theorem feedback_can_reach_threshold (threshold : Nat) :
    ∃ t, threshold ≤ pureFeedback.burden t := by
  apply eventually_crosses_any_threshold pureFeedback
  · intro t
    decide

/-- Administrative work can take time away from clinical care. This is a
*capacity* identity, not a theorem that a given patient outcome improves. -/
def careTimeAvailable (timeBudget administrativeDiversion : Nat) : Nat :=
  timeBudget - administrativeDiversion

/-- Shifting avoidable administrative work off clinicians weakly increases the
time available for clinical care, holding the clinician's time budget fixed. -/
theorem less_diversion_protects_clinical_time
    (timeBudget before after : Nat) (h : after ≤ before) :
    careTimeAvailable timeBudget before ≤
      careTimeAvailable timeBudget after := by
  simp only [careTimeAvailable]
  omega

/-- Accumulation is explicitly a *mechanism* requiring measured inflows and
repairs. The legal, ethical, or theological status of any one phrase remains
outside this purely quantitative model. -/
structure ReviewSeparation where
  patternedLanguageObserved : Bool
  independentlyReviewed : Bool
  coercionEstablished : Bool
  legalInvalidityDecided : Bool

/-- A repeated phrase without an actual reviewed coercion finding cannot
be promoted by this model to an established coercion conclusion. -/
def ReviewSeparation.mayReportCoercion (s : ReviewSeparation) : Bool :=
  s.independentlyReviewed && s.coercionEstablished

theorem repetition_alone_cannot_establish_coercion
    (s : ReviewSeparation) (h : s.independentlyReviewed = false) :
    s.mayReportCoercion = false := by
  simp [ReviewSeparation.mayReportCoercion, h]

end GRWTSK.CivilSystems.Accumulation
