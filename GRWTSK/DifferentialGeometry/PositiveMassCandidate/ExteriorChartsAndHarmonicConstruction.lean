  have hA : 0 ≤ A₀ * M := mul_nonneg hA₀ hM
  have hiter := giaquinta_iteration
    (fun t K => ∀ x ∈ Metric.ball (0 : E3) t, ∀ y ∈ Metric.ball (0 : E3) t, ∀ i j : Fin 3,
      |partialDeriv i (fun z => partialDeriv j w z) x - partialDeriv i (fun z => partialDeriv j w z) y|
        ≤ K * ‖x - y‖ ^ (1 / 2 : ℝ))
    (1 / 2) 1 (A₀ * M) (6 * L) (by norm_num) hA
    (by
      intro t K K' hP hKK' x hx y hy i j
      exact (hP x hx y hy i j).trans
        (mul_le_mul_of_nonneg_right hKK' (Real.rpow_nonneg (norm_nonneg _) _)))
    (by
      intro t s K hts hP x hx y hy i j
      exact hP x (Metric.ball_subset_ball hts hx) y (Metric.ball_subset_ball hts hy) i j)
    (by
      intro t K hK x hx y hy i j
