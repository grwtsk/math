    rw [hP5]
    have hL : 1720320 * Φ ^ 2 ≤ Λ ^ 2 := by rw [hΛ]; nlinarith
    have hm := mul_le_mul eA3 eA4 hA4n (by positivity)
    nlinarith [mul_le_mul_of_nonneg_right hL hW5n]
  
  have hη1 : ∀ (k : Fin 3) (x : E3), |partialDeriv k (fun x : E3 => g (‖x‖ ^ 2)) x| ≤ A1 := by
    intro k x; rw [hd1 k]; exact hB1 k x
  have hη0 : ∀ x : E3, |g (‖x‖ ^ 2)| ≤ 1 := by
    intro x
