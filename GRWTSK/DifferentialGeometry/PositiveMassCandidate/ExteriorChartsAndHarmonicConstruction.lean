  have hΦv3 : 0 ≤ Φ * v ^ 3 := mul_nonneg hΦ0 (by positivity)
  have hA1n : 0 ≤ A1 := by rw [hA1]; exact mul_nonneg (by linarith) hΦv
  have hA2n : 0 ≤ A2 := by rw [hA2]; positivity
  have hA3n : 0 ≤ A3 := by rw [hA3]; positivity
  have hA4n : 0 ≤ A4 := by rw [hA4]; positivity
  have hB1 : ∀ (k : Fin 3) (x : E3), |2 * x k * g1 (‖x‖ ^ 2)| ≤ A1 := by
