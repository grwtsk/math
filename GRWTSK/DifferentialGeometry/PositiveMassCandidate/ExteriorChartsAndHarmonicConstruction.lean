  have eA3 : A3 ≤ 160 * Φ * W ^ 2 := by
    rw [hA3]; nlinarith [mul_le_mul_of_nonneg_left hu2 hΦ0, mul_le_mul_of_nonneg_left hvW hΦ0]
  have eA4 : A4 ≤ 1792 * Φ * W ^ 3 := by
    rw [hA4]; nlinarith [mul_le_mul_of_nonneg_left hu3 hΦ0, mul_le_mul_of_nonneg_left huv hΦ0]
  have hW1 : Λ / δ ^ 2 = Λ * W := by rw [hW]; ring
  have hW2 : Λ / δ ^ 4 = Λ * W ^ 2 := by rw [hW]; ring
  have hP1' : (Λ / δ) ^ 2 = Λ ^ 2 * W := by rw [hW]; ring
  have hP3 : (Λ / δ ^ 3) ^ 2 = Λ ^ 2 * W ^ 3 := by rw [hW]; ring
  have hP5 : (Λ / δ ^ 5) ^ 2 = Λ ^ 2 * W ^ 5 := by rw [hW]; ring
  have hW2n : 0 ≤ W ^ 2 := by positivity
  have hW3n : 0 ≤ W ^ 3 := by positivity
  have hW5n : 0 ≤ W ^ 5 := by positivity
  have c1 : A1 ≤ Λ / δ ^ 2 := by
    rw [hW1, hΛ]; nlinarith
  have c2 : A3 ≤ Λ / δ ^ 4 := by
    rw [hW2, hΛ]; nlinarith [mul_nonneg hΦ0 hW2n]
  have c3 : 2 * 1 * (3 * A1) ≤ (Λ / δ) ^ 2 := by
    rw [hP1']
    have hL : 48 * Φ ≤ Λ ^ 2 := by rw [hΛ]; nlinarith
    nlinarith [mul_le_mul_of_nonneg_right hL hW0.le]
  have c4 : 2 * A1 * (3 * A2) ≤ (Λ / δ ^ 3) ^ 2 := by
    rw [hP3]
    have hL : 4608 * Φ ^ 2 ≤ Λ ^ 2 := by rw [hΛ]; nlinarith
    have hm := mul_le_mul eA1 eA2 hA2n (by positivity)
    nlinarith [mul_le_mul_of_nonneg_right hL hW3n]
