      (Metric.closedBall (0 : E3) 1) := by
    apply continuousOn_finset_sum; intro l _
    apply continuousOn_finset_sum; intro i _
    apply continuousOn_finset_sum; intro j _
    exact ((hf3 l i j).continuousOn.mono hsub).abs
  obtain ⟨L, hL⟩ := (isCompact_closedBall (0 : E3) 1).exists_bound_of_continuousOn hcont
  have hterm : ∀ x ∈ Metric.ball (0 : E3) 1, ∀ l i j : Fin 3,
      |partialDeriv l (fun z => partialDeriv i (fun y => partialDeriv j w y) z) x| ≤ L := by
    intro x hx l i j
    have h1 := hL x (Metric.ball_subset_closedBall hx)
    have hnn : 0 ≤ ∑ l : Fin 3, ∑ i : Fin 3, ∑ j : Fin 3,
        |partialDeriv l (fun z => partialDeriv i (fun y => partialDeriv j w y) z) x| :=
      Finset.sum_nonneg (fun _ _ => Finset.sum_nonneg (fun _ _ =>
        Finset.sum_nonneg (fun _ _ => abs_nonneg _)))
    rw [Real.norm_eq_abs, abs_of_nonneg hnn] at h1
    refine le_trans ?_ h1
    calc |partialDeriv l (fun z => partialDeriv i (fun y => partialDeriv j w y) z) x|
