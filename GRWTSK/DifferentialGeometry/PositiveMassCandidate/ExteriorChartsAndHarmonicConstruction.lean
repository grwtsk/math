    · rw [h2, h3]; simp only [mul_zero, add_zero, abs_zero]; exact hA4n
  
  have huv0 : 0 ≤ ρ * v := mul_nonneg hρ0 hv0.le
  have hu2 : (ρ * v) ^ 2 ≤ 16 * W ^ 2 := by nlinarith
  have hu3 : (ρ * v) ^ 3 ≤ 64 * W ^ 3 := by
