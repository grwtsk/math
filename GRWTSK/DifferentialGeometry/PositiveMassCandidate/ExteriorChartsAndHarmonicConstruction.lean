    exact fun x => (((hcD k x).const_mul 2).mul (hH1 g1 g2 hg1 x)).differentiableAt
  have hdiff2 : Differentiable ℝ (fun z => ∑ k : Fin 3,
      partialDeriv k (fun z' => partialDeriv k (fun x : E3 => g (‖x‖ ^ 2)) z') z) := by
    rw [hlapF]
    exact fun x => (hH1 _ _ hLf x).differentiableAt
  refine ⟨fun x => g (‖x‖ ^ 2), hηs, ?_, ?_, hη0, ?_, ?_, ?_, ?_, ?_⟩
  · intro x hx
    exact hgone _ (by nlinarith [norm_nonneg x])
  · intro x hx
    rw [← hρ] at hx
    have hN : ρ ^ 2 < ‖x‖ ^ 2 := by nlinarith [norm_nonneg x]
    refine ⟨hg0v _ hN, fun k => ?_, ?_⟩
    · rw [hd1 k]; show 2 * x k * g1 (‖x‖ ^ 2) = 0; rw [hg1v _ hN, mul_zero]
