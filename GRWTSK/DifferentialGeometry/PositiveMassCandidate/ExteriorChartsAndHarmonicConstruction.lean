    (fun x hx => hwb x (Metric.ball_subset_ball (by norm_num) hx)) hiter
  have h0 : (0 : E3) ∈ Metric.ball (0 : E3) (1 / 4) := Metric.mem_ball_self (by norm_num)
  have hp1 : (1 / 4 : ℝ) ^ (1 / 2 : ℝ) ≤ 1 :=
