    · rw [h1, h2]; simp only [mul_zero, add_zero, abs_zero]; exact hA2n
  have hB3 : ∀ x : E3, |6 * g1 (‖x‖ ^ 2) + 4 * ‖x‖ ^ 2 * g2 (‖x‖ ^ 2)| ≤ A3 := by
    intro x
    rcases hcase x with ⟨h1, _⟩ | ⟨h1, h2, _⟩
    · rw [hA3]
