    mul_le_mul_of_nonneg_left (hJ3.trans (mul_le_mul_of_nonneg_left f3 hCt0)) h3p
  nlinarith [hle, t1, t2, t3]

theorem weight_peetre_integrable (p q : ℝ) (hp0 : 0 ≤ p) (hpq : 3 < p + q) (x : E3) :
    Integrable (fun y : E3 => (1 + ‖x - y‖) ^ (-p) * (1 + ‖y‖) ^ (-q)) :=
by
  have hfin : ((Module.finrank ℝ E3 : ℕ) : ℝ) < p + q := by
    rw [finrank_euclideanSpace, Fintype.card_fin]
    exact_mod_cast hpq
  have hmaj : Integrable (fun y : E3 => (1 + ‖x‖) ^ p * (1 + ‖y‖) ^ (-(p + q))) :=
    (integrable_one_add_norm (μ := (volume : Measure E3)) hfin).const_mul _
  have hcont : Continuous (fun y : E3 => (1 + ‖x - y‖) ^ (-p) * (1 + ‖y‖) ^ (-q)) := by
    refine Continuous.mul ?_ ?_
    · exact (continuous_const.add (continuous_const.sub continuous_id).norm).rpow_const
        (fun y => Or.inl (by positivity))
    · exact (continuous_const.add continuous_norm).rpow_const
        (fun y => Or.inl (by positivity))
  refine hmaj.mono' hcont.aestronglyMeasurable (Filter.Eventually.of_forall (fun y => ?_))
  have ha : (0 : ℝ) < 1 + ‖x‖ := by positivity
  have hb : (0 : ℝ) < 1 + ‖y‖ := by positivity
  have hc : (0 : ℝ) < 1 + ‖x - y‖ := by positivity
  have hpeetre : 1 + ‖y‖ ≤ (1 + ‖x‖) * (1 + ‖x - y‖) := by
    have h1 : ‖y‖ ≤ ‖x‖ + ‖y - x‖ := norm_le_norm_add_norm_sub' y x
    rw [norm_sub_rev y x] at h1
    have h2 : 0 ≤ ‖x‖ * ‖x - y‖ := mul_nonneg (norm_nonneg _) (norm_nonneg _)
    nlinarith
  have hs2 : (1 + ‖x - y‖) ^ (-p) ≤ (1 + ‖x‖) ^ p * (1 + ‖y‖) ^ (-p) := by
    have h1 : ((1 + ‖x‖) * (1 + ‖x - y‖)) ^ (-p) ≤ (1 + ‖y‖) ^ (-p) :=
      Real.rpow_le_rpow_of_nonpos hb hpeetre (by linarith)
    rw [Real.mul_rpow ha.le hc.le] at h1
    have hap : 0 < (1 + ‖x‖) ^ p := Real.rpow_pos_of_pos ha p
    have h2 : (1 + ‖x‖) ^ p * (1 + ‖x‖) ^ (-p) = 1 := by
      rw [Real.rpow_neg ha.le, mul_inv_cancel₀ hap.ne']
    calc (1 + ‖x - y‖) ^ (-p)
        = (1 + ‖x‖) ^ p * ((1 + ‖x‖) ^ (-p) * (1 + ‖x - y‖) ^ (-p)) := by
          rw [← mul_assoc, h2, one_mul]
      _ ≤ (1 + ‖x‖) ^ p * (1 + ‖y‖) ^ (-p) := mul_le_mul_of_nonneg_left h1 hap.le
  have hF0 : 0 ≤ (1 + ‖x - y‖) ^ (-p) * (1 + ‖y‖) ^ (-q) :=
    mul_nonneg (Real.rpow_nonneg hc.le _) (Real.rpow_nonneg hb.le _)
  rw [Real.norm_of_nonneg hF0]
  calc (1 + ‖x - y‖) ^ (-p) * (1 + ‖y‖) ^ (-q)
      ≤ ((1 + ‖x‖) ^ p * (1 + ‖y‖) ^ (-p)) * (1 + ‖y‖) ^ (-q) :=
        mul_le_mul_of_nonneg_right hs2 (Real.rpow_nonneg hb.le _)
    _ = (1 + ‖x‖) ^ p * (1 + ‖y‖) ^ (-(p + q)) := by
        rw [mul_assoc, ← Real.rpow_add hb, neg_add]

theorem renorm_conv_hasFDerivAt (k f : E3 → ℝ) (p q M A : ℝ) (hp : 0 ≤ p) (hpq : 3 < p + q)
    (hM : 0 ≤ M) (hA : 0 ≤ A) (hk : Differentiable ℝ k)
    (hk1 : ∀ z : E3, ‖fderiv ℝ k z‖ ≤ M * (1 + ‖z‖) ^ (-p))
    (hf : Continuous f) (hf0 : ∀ y : E3, |f y| ≤ A * (1 + ‖y‖) ^ (-q)) (x : E3) :
    HasFDerivAt (fun x' : E3 => ∫ y, (k (x' - y) - k (-y)) * f y)
        (∫ y, f y • fderiv ℝ k (x - y)) x ∧
      ∀ i : Fin 3, partialDeriv i (fun x' : E3 => ∫ y, (k (x' - y) - k (-y)) * f y) x =
        ∫ y, partialDeriv i k (x - y) * f y :=
by
  have hkc : Continuous k := hk.continuous
  
  have hshift : ∀ x' y : E3, ‖x' - x‖ ≤ 1 →
      (1 + ‖x' - y‖) ^ (-p) ≤ 2 ^ p * (1 + ‖x - y‖) ^ (-p) := by
    intro x' y hx'
    have h1 : ‖x - y‖ ≤ ‖x - x'‖ + ‖x' - y‖ := norm_sub_le_norm_sub_add_norm_sub x x' y
    have h2 : ‖x - x'‖ ≤ 1 := by rw [norm_sub_rev]; exact hx'
    have ha : 0 < (1 + ‖x - y‖) / 2 := by positivity
    have hab : (1 + ‖x - y‖) / 2 ≤ 1 + ‖x' - y‖ := by
      have := norm_nonneg (x' - y); linarith
    calc (1 + ‖x' - y‖) ^ (-p) ≤ ((1 + ‖x - y‖) / 2) ^ (-p) :=
          Real.rpow_le_rpow_of_nonpos ha hab (by linarith)
      _ = 2 ^ p * (1 + ‖x - y‖) ^ (-p) := by
          rw [Real.div_rpow (by positivity) (by norm_num),
            Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 2), div_inv_eq_mul, mul_comm]
  
  have hdiff : ∀ y : E3,
      |k (x - y) - k (-y)| ≤ M * (1 + ‖x‖) ^ p * (1 + ‖y‖) ^ (-p) * ‖x‖ := by
    intro y
    have hbd : ∀ w ∈ segment ℝ (-y) (x - y),
        ‖fderiv ℝ k w‖ ≤ M * (1 + ‖x‖) ^ p * (1 + ‖y‖) ^ (-p) := by
      intro w hw
      obtain ⟨a, b, ha, hb, hab, rfl⟩ := hw
      have hw' : a • (-y) + b • (x - y) = b • x - y := by
        calc a • (-y) + b • (x - y) = b • x - (a + b) • y := by
              simp only [smul_neg, smul_sub, add_smul]; abel
          _ = b • x - y := by rw [hab, one_smul]
      rw [hw']
      have hb1 : b ≤ 1 := by linarith
      have hny : ‖y‖ ≤ ‖x‖ + ‖b • x - y‖ := by
        have e : y = b • x - (b • x - y) := by abel
        calc ‖y‖ = ‖b • x - (b • x - y)‖ := by rw [← e]
          _ ≤ ‖b • x‖ + ‖b • x - y‖ := norm_sub_le _ _
          _ ≤ ‖x‖ + ‖b • x - y‖ := by
            rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg hb]
            have := norm_nonneg x
            nlinarith
      have hX : 0 < 1 + ‖x‖ := by positivity
      have hY : 0 < 1 + ‖y‖ := by positivity
      have hYW : (1 + ‖y‖) / (1 + ‖x‖) ≤ 1 + ‖b • x - y‖ := by
        rw [div_le_iff₀ hX]
        have := norm_nonneg x
        have := norm_nonneg (b • x - y)
        nlinarith
      have h1 : (1 + ‖b • x - y‖) ^ (-p) ≤ ((1 + ‖y‖) / (1 + ‖x‖)) ^ (-p) :=
        Real.rpow_le_rpow_of_nonpos (div_pos hY hX) hYW (by linarith)
      have h2 : ((1 + ‖y‖) / (1 + ‖x‖)) ^ (-p) = (1 + ‖x‖) ^ p * (1 + ‖y‖) ^ (-p) := by
        rw [Real.div_rpow hY.le hX.le, Real.rpow_neg hX.le, div_inv_eq_mul, mul_comm]
      calc ‖fderiv ℝ k (b • x - y)‖ ≤ M * (1 + ‖b • x - y‖) ^ (-p) := hk1 _
        _ ≤ M * ((1 + ‖x‖) ^ p * (1 + ‖y‖) ^ (-p)) :=
            mul_le_mul_of_nonneg_left (h1.trans h2.le) hM
        _ = M * (1 + ‖x‖) ^ p * (1 + ‖y‖) ^ (-p) := by ring
    have hmvt := Convex.norm_image_sub_le_of_norm_fderiv_le (fun z _ => hk z) hbd
      (convex_segment _ _) (left_mem_segment ℝ (-y) (x - y)) (right_mem_segment ℝ (-y) (x - y))
    rw [← Real.norm_eq_abs]
    have e : x - y - -y = x := by abel
    rw [e] at hmvt
    exact hmvt
  have I0 := weight_peetre_integrable p q hp hpq 0
  have Ix := weight_peetre_integrable p q hp hpq x
  have hFcont : ∀ x' : E3, Continuous (fun y : E3 => (k (x' - y) - k (-y)) * f y) := fun x' =>
    ((hkc.comp (continuous_const.sub continuous_id)).sub (hkc.comp continuous_neg)).mul hf
  have hF'meas : ∀ x' : E3,
      AEStronglyMeasurable (fun y : E3 => f y • fderiv ℝ k (x' - y)) volume := by
    intro x'
    have hm : Measurable (fun y : E3 => fderiv ℝ k (x' - y)) :=
      (measurable_fderiv ℝ k).comp (continuous_const.sub continuous_id).measurable
    exact hf.aestronglyMeasurable.smul hm.aestronglyMeasurable
  have hbound : ∀ x' ∈ Metric.ball x 1, ∀ y : E3,
      ‖f y • fderiv ℝ k (x' - y)‖ ≤
        M * A * 2 ^ p * ((1 + ‖x - y‖) ^ (-p) * (1 + ‖y‖) ^ (-q)) := by
    intro x' hx' y
    have hx'1 : ‖x' - x‖ ≤ 1 := by
      rw [Metric.mem_ball, dist_eq_norm] at hx'; exact hx'.le
    have H : ‖fderiv ℝ k (x' - y)‖ ≤ M * (2 ^ p * (1 + ‖x - y‖) ^ (-p)) :=
      (hk1 _).trans (mul_le_mul_of_nonneg_left (hshift x' y hx'1) hM)
    have hfy : 0 ≤ A * (1 + ‖y‖) ^ (-q) := mul_nonneg hA (Real.rpow_nonneg (by positivity) _)
    rw [norm_smul, Real.norm_eq_abs]
    calc |f y| * ‖fderiv ℝ k (x' - y)‖
        ≤ (A * (1 + ‖y‖) ^ (-q)) * (M * (2 ^ p * (1 + ‖x - y‖) ^ (-p))) :=
          mul_le_mul (hf0 y) H (norm_nonneg _) hfy
      _ = M * A * 2 ^ p * ((1 + ‖x - y‖) ^ (-p) * (1 + ‖y‖) ^ (-q)) := by ring
  have hderiv : ∀ x' y : E3, HasFDerivAt (fun x' : E3 => (k (x' - y) - k (-y)) * f y)
      (f y • fderiv ℝ k (x' - y)) x' := by
    intro x' y
    have h1 : HasFDerivAt (fun z : E3 => k (z - y)) (fderiv ℝ k (x' - y)) x' := by
      have := (hk (x' - y)).hasFDerivAt.comp x' ((hasFDerivAt_id x').sub_const y)
      simpa using this
    exact (h1.sub_const (k (-y))).mul_const (f y)
  have hFint : Integrable (fun y : E3 => (k (x - y) - k (-y)) * f y) := by
    refine Integrable.mono' (I0.const_mul (M * (1 + ‖x‖) ^ p * ‖x‖ * A))
      (hFcont x).aestronglyMeasurable ?_
    refine Filter.Eventually.of_forall (fun y => ?_)
    rw [Real.norm_eq_abs, abs_mul]
    have h1 := hdiff y
    calc |k (x - y) - k (-y)| * |f y|
        ≤ (M * (1 + ‖x‖) ^ p * (1 + ‖y‖) ^ (-p) * ‖x‖) * (A * (1 + ‖y‖) ^ (-q)) :=
          mul_le_mul h1 (hf0 y) (abs_nonneg _) ((abs_nonneg _).trans h1)
      _ = M * (1 + ‖x‖) ^ p * ‖x‖ * A * ((1 + ‖0 - y‖) ^ (-p) * (1 + ‖y‖) ^ (-q)) := by
          rw [zero_sub, norm_neg]; ring
  have hmain := hasFDerivAt_integral_of_dominated_of_fderiv_le (μ := volume)
    (F := fun x' y => (k (x' - y) - k (-y)) * f y)
    (F' := fun x' y => f y • fderiv ℝ k (x' - y))
    (Metric.ball_mem_nhds x one_pos)
    (Filter.Eventually.of_forall (fun x' => (hFcont x').aestronglyMeasurable))
    hFint (hF'meas x)
    (Filter.Eventually.of_forall (fun y x' hx' => hbound x' hx' y))
    (Ix.const_mul (M * A * 2 ^ p))
    (Filter.Eventually.of_forall (fun y x' _ => hderiv x' y))
  refine ⟨hmain, fun i => ?_⟩
  have hF'int : Integrable (fun y : E3 => f y • fderiv ℝ k (x - y)) :=
    Integrable.mono' (Ix.const_mul (M * A * 2 ^ p)) (hF'meas x)
      (Filter.Eventually.of_forall (fun y => hbound x (Metric.mem_ball_self one_pos) y))
  unfold partialDeriv
  rw [hmain.fderiv, ContinuousLinearMap.integral_apply hF'int]
  congr 1
  funext y
  rw [ContinuousLinearMap.smul_apply, smul_eq_mul, mul_comm]

theorem conv_fderiv_lip_bound (k f : E3 → ℝ) (a A M : ℝ) (ha : 1 < a) (ha2 : a < 2)
    (hA : 0 ≤ A) (hM : 0 ≤ M) (hk : Continuous k)
    (hk0 : ∀ z : E3, |k z| ≤ M * (1 + ‖z‖) ^ (-2 : ℝ))
    (hf : Differentiable ℝ f) (hf0 : ∀ y : E3, |f y| ≤ A * (1 + ‖y‖) ^ (-a))
    (hf1 : ∀ y : E3, ‖fderiv ℝ f y‖ ≤ A * (1 + ‖y‖) ^ (-a - 1))
    (hW : Differentiable ℝ (fun x : E3 => ∫ y, k (x - y) * f y)) (x : E3) :
    ‖fderiv ℝ (fun x : E3 => ∫ y, k (x - y) * f y) x‖ ≤
      8 * A * M * ∫ y, (1 + ‖x - y‖) ^ (-(a + 1)) * (1 + ‖y‖) ^ (-2 : ℝ) :=
by
  
  have hwt_nn : ∀ y : E3, 0 ≤ (1 + ‖x - y‖) ^ (-(a + 1)) * (1 + ‖y‖) ^ (-2 : ℝ) := fun y =>
    mul_nonneg (Real.rpow_nonneg (by positivity) _) (Real.rpow_nonneg (by positivity) _)
  have hI : 0 ≤ ∫ y, (1 + ‖x - y‖) ^ (-(a + 1)) * (1 + ‖y‖) ^ (-2 : ℝ) := integral_nonneg hwt_nn
  have hC : 0 ≤ 8 * A * M * ∫ y, (1 + ‖x - y‖) ^ (-(a + 1)) * (1 + ‖y‖) ^ (-2 : ℝ) := by
    positivity
  
  have hweight : ∀ c w : E3, ‖w - c‖ ≤ 1 / 2 →
      (1 + ‖w‖) ^ (-a - 1) ≤ 8 * (1 + ‖c‖) ^ (-(a + 1)) := by
    intro c w hw
    have hu : 1 ≤ 1 + ‖w‖ := by linarith [norm_nonneg w]
    have hv : 0 < 1 + ‖c‖ := by linarith [norm_nonneg c]
    have hcw : ‖c‖ - ‖w‖ ≤ ‖c - w‖ := norm_sub_norm_le c w
    rw [norm_sub_rev] at hcw
    have hvu : 1 + ‖c‖ ≤ 2 * (1 + ‖w‖) := by linarith
    have e1 : (-a - 1 : ℝ) = -(a + 1) := by ring
    rw [e1]
    have h2 : (2 * (1 + ‖w‖)) ^ (-(a + 1)) ≤ (1 + ‖c‖) ^ (-(a + 1)) :=
      Real.rpow_le_rpow_of_nonpos hv hvu (by linarith)
    have h3 : (2 * (1 + ‖w‖)) ^ (-(a + 1)) = (2 : ℝ) ^ (-(a + 1)) * (1 + ‖w‖) ^ (-(a + 1)) :=
      Real.mul_rpow (by norm_num) (by linarith)
    have h4 : (2 : ℝ) ^ (a + 1) * (2 : ℝ) ^ (-(a + 1)) = 1 := by
      rw [← Real.rpow_add (by norm_num), add_neg_cancel, Real.rpow_zero]
    have h5 : (2 : ℝ) ^ (a + 1) ≤ 8 := by
      have h6 : (2 : ℝ) ^ (a + 1) ≤ (2 : ℝ) ^ (3 : ℝ) :=
        Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
      have h8 : (2 : ℝ) ^ (3 : ℝ) = 8 := by
        rw [show (3 : ℝ) = ((3 : ℕ) : ℝ) by norm_num, Real.rpow_natCast]
        norm_num
      linarith
    have hq : 0 ≤ (1 + ‖c‖) ^ (-(a + 1)) := Real.rpow_nonneg hv.le _
    have h2p : 0 ≤ (2 : ℝ) ^ (a + 1) := Real.rpow_nonneg (by norm_num) _
    calc (1 + ‖w‖) ^ (-(a + 1)) = (2 : ℝ) ^ (a + 1) * (2 * (1 + ‖w‖)) ^ (-(a + 1)) := by
          rw [h3, ← mul_assoc, h4, one_mul]
      _ ≤ (2 : ℝ) ^ (a + 1) * (1 + ‖c‖) ^ (-(a + 1)) := mul_le_mul_of_nonneg_left h2 h2p
      _ ≤ 8 * (1 + ‖c‖) ^ (-(a + 1)) := mul_le_mul_of_nonneg_right h5 hq
  
  have hinc : ∀ c h : E3, ‖h‖ ≤ 1 / 2 →
      |f (c + h) - f c| ≤ 8 * A * (1 + ‖c‖) ^ (-(a + 1)) * ‖h‖ := by
    intro c h hh
    have hbd : ∀ w ∈ Metric.closedBall c (1 / 2),
        ‖fderiv ℝ f w‖ ≤ 8 * A * (1 + ‖c‖) ^ (-(a + 1)) := by
      intro w hw
      rw [Metric.mem_closedBall, dist_eq_norm] at hw
      calc ‖fderiv ℝ f w‖ ≤ A * (1 + ‖w‖) ^ (-a - 1) := hf1 w
        _ ≤ A * (8 * (1 + ‖c‖) ^ (-(a + 1))) := mul_le_mul_of_nonneg_left (hweight c w hw) hA
        _ = 8 * A * (1 + ‖c‖) ^ (-(a + 1)) := by ring
    have hmem1 : c ∈ Metric.closedBall c (1 / 2) := Metric.mem_closedBall_self (by norm_num)
    have hmem2 : c + h ∈ Metric.closedBall c (1 / 2) := by
      rw [Metric.mem_closedBall, dist_eq_norm, add_sub_cancel_left]
      exact hh
    have hmvt := (convex_closedBall c (1 / 2)).norm_image_sub_le_of_norm_fderiv_le
      (fun w _ => hf w) hbd hmem1 hmem2
    rw [add_sub_cancel_left, Real.norm_eq_abs] at hmvt
    exact hmvt
  
  have hrep : ∀ w : E3, ∫ y, k (w - y) * f y = ∫ z, k z * f (w - z) := by
    intro w
    have h := integral_sub_left_eq_self (fun z => k z * f (w - z)) (volume : Measure E3) w
    simp only [sub_sub_cancel] at h
    exact h
  
  have hpeetre : ∀ (p : ℝ) (w : E3), 0 ≤ p → 3 < p + 2 →
      Integrable (fun y : E3 => (1 + ‖w - y‖) ^ (-p) * (1 + ‖y‖) ^ (-(2 : ℝ))) := by
    intro p w hp hp3
    have hr : ((Module.finrank ℝ E3 : ℕ) : ℝ) < p + 2 := by
      rw [finrank_euclideanSpace_fin]; push_cast; linarith
    have hbase : Integrable (fun y : E3 => (1 + ‖y‖) ^ (-(p + 2))) := integrable_one_add_norm hr
    have hsh : Integrable (fun y : E3 => (1 + ‖w - y‖) ^ (-(p + 2))) :=
      hbase.comp_sub_left w
    refine Integrable.mono' (hsh.const_mul ((1 + ‖w‖) ^ (2 : ℝ))) ?_ ?_
    · refine Continuous.aestronglyMeasurable (Continuous.mul ?_ ?_)
      · exact (continuous_const.add (continuous_const.sub continuous_id).norm).rpow_const
          (fun y => Or.inl (ne_of_gt (by positivity)))
      · exact (continuous_const.add continuous_norm).rpow_const
          (fun y => Or.inl (ne_of_gt (by positivity)))
    · refine Filter.Eventually.of_forall (fun y => ?_)
      have hu : 0 < 1 + ‖w - y‖ := by positivity
      have ht : 0 < 1 + ‖y‖ := by positivity
      have hs : 0 < 1 + ‖w‖ := by positivity
      have hus : 1 + ‖w - y‖ ≤ (1 + ‖w‖) * (1 + ‖y‖) := by
        have := norm_sub_le w y
        nlinarith [norm_nonneg w, norm_nonneg y, mul_nonneg (norm_nonneg w) (norm_nonneg y)]
      have key : (1 + ‖y‖) ^ (-(2 : ℝ)) ≤ (1 + ‖w‖) ^ (2 : ℝ) * (1 + ‖w - y‖) ^ (-(2 : ℝ)) := by
        rw [Real.rpow_neg ht.le, Real.rpow_neg hu.le]
        simp only [Real.rpow_two]
        have hsq : (1 + ‖w - y‖) ^ 2 ≤ (1 + ‖y‖) ^ 2 * (1 + ‖w‖) ^ 2 := by
          have := mul_le_mul hus hus hu.le (by positivity)
          nlinarith
        calc ((1 + ‖y‖) ^ 2)⁻¹ ≤ ((1 + ‖w - y‖) ^ 2 / (1 + ‖w‖) ^ 2)⁻¹ :=
              inv_anti₀ (by positivity) (by rw [div_le_iff₀ (by positivity)]; exact hsq)
          _ = (1 + ‖w‖) ^ 2 * ((1 + ‖w - y‖) ^ 2)⁻¹ := by rw [inv_div, div_eq_mul_inv]
      rw [Real.norm_of_nonneg (by positivity)]
      calc (1 + ‖w - y‖) ^ (-p) * (1 + ‖y‖) ^ (-(2 : ℝ))
          ≤ (1 + ‖w - y‖) ^ (-p) * ((1 + ‖w‖) ^ (2 : ℝ) * (1 + ‖w - y‖) ^ (-(2 : ℝ))) :=
            mul_le_mul_of_nonneg_left key (by positivity)
        _ = (1 + ‖w‖) ^ (2 : ℝ) * ((1 + ‖w - y‖) ^ (-p) * (1 + ‖w - y‖) ^ (-(2 : ℝ))) := by ring
        _ = (1 + ‖w‖) ^ (2 : ℝ) * (1 + ‖w - y‖) ^ (-(p + 2)) := by
            rw [← Real.rpow_add hu, show -p + -(2 : ℝ) = -(p + 2) by ring]
  
  have hFint : ∀ w : E3, Integrable (fun z : E3 => k z * f (w - z)) := by
    intro w
    refine Integrable.mono'
      ((hpeetre a w (by linarith) (by linarith)).const_mul (M * A)) ?_ ?_
    · exact (hk.mul (hf.continuous.comp (continuous_const.sub continuous_id))).aestronglyMeasurable
    · refine Filter.Eventually.of_forall (fun z => ?_)
      rw [Real.norm_eq_abs, abs_mul]
      have h1 := hk0 z
      have h2 := hf0 (w - z)
      calc |k z| * |f (w - z)| ≤ (M * (1 + ‖z‖) ^ (-2 : ℝ)) * (A * (1 + ‖w - z‖) ^ (-a)) :=
            mul_le_mul h1 h2 (abs_nonneg _) ((abs_nonneg _).trans h1)
        _ = M * A * ((1 + ‖w - z‖) ^ (-a) * (1 + ‖z‖) ^ (-(2 : ℝ))) := by ring
  
  have hlip : ∀ x' : E3, ‖x' - x‖ ≤ 1 / 2 →
      |(∫ z, k z * f (x' - z)) - ∫ z, k z * f (x - z)| ≤
        (8 * A * M * ∫ y, (1 + ‖x - y‖) ^ (-(a + 1)) * (1 + ‖y‖) ^ (-2 : ℝ)) * ‖x' - x‖ := by
    intro x' hxx
    rw [← integral_sub (hFint x') (hFint x)]
    have hdom : Integrable (fun z : E3 => (8 * A * M * ‖x' - x‖) *
        ((1 + ‖x - z‖) ^ (-(a + 1)) * (1 + ‖z‖) ^ (-2 : ℝ))) :=
      (hpeetre (a + 1) x (by linarith) (by linarith)).const_mul _
    have hpt : ∀ z : E3, ‖k z * f (x' - z) - k z * f (x - z)‖ ≤
        (8 * A * M * ‖x' - x‖) * ((1 + ‖x - z‖) ^ (-(a + 1)) * (1 + ‖z‖) ^ (-2 : ℝ)) := by
      intro z
      rw [Real.norm_eq_abs, ← mul_sub, abs_mul]
      have e : (x - z) + (x' - x) = x' - z := by abel
      have h1 := hk0 z
      have h2 := hinc (x - z) (x' - x) hxx
      rw [e] at h2
      calc |k z| * |f (x' - z) - f (x - z)| ≤ (M * (1 + ‖z‖) ^ (-2 : ℝ)) *
            (8 * A * (1 + ‖x - z‖) ^ (-(a + 1)) * ‖x' - x‖) :=
            mul_le_mul h1 h2 (abs_nonneg _) ((abs_nonneg _).trans h1)
        _ = _ := by ring
    have hn := norm_integral_le_of_norm_le hdom (Filter.Eventually.of_forall hpt)
    rw [integral_const_mul, Real.norm_eq_abs] at hn
    calc _ ≤ _ := hn
      _ = _ := by ring
  
  have hev : ∀ᶠ x' in 𝓝 x,
      ‖(fun x : E3 => ∫ y, k (x - y) * f y) x' - (fun x : E3 => ∫ y, k (x - y) * f y) x‖ ≤
        (8 * A * M * ∫ y, (1 + ‖x - y‖) ^ (-(a + 1)) * (1 + ‖y‖) ^ (-2 : ℝ)) * ‖x' - x‖ := by
    filter_upwards [Metric.closedBall_mem_nhds x (by norm_num : (0 : ℝ) < 1 / 2)] with x' hx'
    rw [Metric.mem_closedBall, dist_eq_norm] at hx'
    show ‖(∫ y, k (x' - y) * f y) - ∫ y, k (x - y) * f y‖ ≤ _
    rw [hrep x', hrep x, Real.norm_eq_abs]
    exact hlip x' hx'
  exact norm_fderiv_le_of_lip' ℝ hC hev

theorem approx_identity_residual (η f : E3 → ℝ) (a A M : ℝ) (ha : 1 < a) (ha2 : a < 2)
    (hA : 0 ≤ A) (hM : 0 ≤ M) (hηc : Continuous η) (hη0 : ∀ z : E3, 0 ≤ η z)
    (hηb : ∀ z : E3, η z ≤ M * (1 + ‖z‖) ^ (-7 : ℝ))
    (hf : Differentiable ℝ f) (hf0 : ∀ y : E3, |f y| ≤ A * (1 + ‖y‖) ^ (-a))
    (hf1 : ∀ y : E3, ‖fderiv ℝ f y‖ ≤ A * (1 + ‖y‖) ^ (-a - 1)) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : E3,
      |(∫ z, η z) * f x - ∫ y, η (x - y) * f y| ≤ C * (1 + ‖x‖) ^ (-a - 1) :=
by
  
  have hinc : ∀ x z : E3,
      |f x - f (x - z)| ≤ A * (1 + ‖z‖) ^ (a + 2) * (1 + ‖x‖) ^ (-a - 1) := by
    intro x z
    have hQ : 0 < 1 + ‖z‖ := by positivity
    have hX : 0 < 1 + ‖x‖ := by positivity
    obtain ⟨K, hK⟩ : ∃ K : ℝ, K = A * (1 + ‖z‖) ^ (a + 1) * (1 + ‖x‖) ^ (-a - 1) := ⟨_, rfl⟩
    have hK0 : 0 ≤ K := by
      rw [hK]
      exact mul_nonneg (mul_nonneg hA (Real.rpow_nonneg hQ.le _)) (Real.rpow_nonneg hX.le _)
    have hbd : ∀ w ∈ Metric.closedBall x ‖z‖, ‖fderiv ℝ f w‖ ≤ K := by
      intro w hw
      rw [Metric.mem_closedBall, dist_eq_norm] at hw
      have hP : 0 < 1 + ‖w‖ := by positivity
      have h1 : ‖x‖ ≤ ‖w‖ + ‖z‖ := by
        have := norm_le_insert' x w
        rw [norm_sub_rev] at this
        linarith
      have hpeet : 1 + ‖x‖ ≤ (1 + ‖w‖) * (1 + ‖z‖) := by
        nlinarith [norm_nonneg w, norm_nonneg z, mul_nonneg (norm_nonneg w) (norm_nonneg z)]
      have h2 : (1 + ‖w‖) ^ (-a - 1) ≤ (1 + ‖z‖) ^ (a + 1) * (1 + ‖x‖) ^ (-a - 1) := by
        have h3 : ((1 + ‖w‖) * (1 + ‖z‖)) ^ (-a - 1) ≤ (1 + ‖x‖) ^ (-a - 1) :=
          Real.rpow_le_rpow_of_nonpos hX hpeet (by linarith)
        rw [Real.mul_rpow hP.le hQ.le] at h3
        have h4 : (1 + ‖z‖) ^ (a + 1) * (1 + ‖z‖) ^ (-a - 1) = 1 := by
          rw [← Real.rpow_add hQ, show a + 1 + (-a - 1) = 0 by ring, Real.rpow_zero]
        have h5 : 0 ≤ (1 + ‖z‖) ^ (a + 1) := Real.rpow_nonneg hQ.le _
        calc (1 + ‖w‖) ^ (-a - 1)
            = (1 + ‖z‖) ^ (a + 1) * ((1 + ‖w‖) ^ (-a - 1) * (1 + ‖z‖) ^ (-a - 1)) := by
              rw [mul_comm ((1 + ‖w‖) ^ (-a - 1)), ← mul_assoc, h4, one_mul]
          _ ≤ _ := mul_le_mul_of_nonneg_left h3 h5
      calc ‖fderiv ℝ f w‖ ≤ A * (1 + ‖w‖) ^ (-a - 1) := hf1 w
        _ ≤ A * ((1 + ‖z‖) ^ (a + 1) * (1 + ‖x‖) ^ (-a - 1)) :=
            mul_le_mul_of_nonneg_left h2 hA
        _ = K := by rw [hK]; ring
    have hmem1 : x - z ∈ Metric.closedBall x ‖z‖ := by
      rw [Metric.mem_closedBall, dist_eq_norm]
      simp
    have hmem2 : x ∈ Metric.closedBall x ‖z‖ := Metric.mem_closedBall_self (norm_nonneg z)
    have hmvt := (convex_closedBall x ‖z‖).norm_image_sub_le_of_norm_fderiv_le
      (fun w _ => (hf w)) hbd hmem1 hmem2
    rw [Real.norm_eq_abs, sub_sub_cancel] at hmvt
    have h6 : K * ‖z‖ ≤ K * (1 + ‖z‖) := mul_le_mul_of_nonneg_left (by linarith) hK0
    have h7 : (1 + ‖z‖) ^ (a + 2) = (1 + ‖z‖) ^ (a + 1) * (1 + ‖z‖) := by
      rw [← Real.rpow_add_one hQ.ne', show a + 1 + 1 = a + 2 by ring]
    calc |f x - f (x - z)| ≤ K * ‖z‖ := hmvt
      _ ≤ K * (1 + ‖z‖) := h6
      _ = _ := by rw [hK, h7]; ring
  
  have hfr : (Module.finrank ℝ E3 : ℝ) = 3 := by simp [E3, finrank_euclideanSpace]
  have hW7 : Integrable (fun z : E3 => (1 + ‖z‖) ^ (-(7 : ℝ))) :=
    integrable_one_add_norm (by rw [hfr]; norm_num)
  have hηi : Integrable η := by
    refine (hW7.const_mul M).mono' hηc.aestronglyMeasurable
      (Filter.Eventually.of_forall fun z => ?_)
    rw [Real.norm_eq_abs, abs_of_nonneg (hη0 z)]
    exact hηb z
  have hWa : Integrable (fun z : E3 => (1 + ‖z‖) ^ (a - 5)) := by
    have h := integrable_one_add_norm (E := E3) (μ := volume) (r := 5 - a)
      (by rw [hfr]; linarith)
    rw [show a - 5 = -(5 - a) by ring]
    exact h
  have hfB : ∀ y : E3, |f y| ≤ A := by
    intro y
    have h1 : (1 + ‖y‖) ^ (-a) ≤ 1 :=
      Real.rpow_le_one_of_one_le_of_nonpos (by linarith [norm_nonneg y]) (by linarith)
    calc |f y| ≤ A * (1 + ‖y‖) ^ (-a) := hf0 y
      _ ≤ A * 1 := mul_le_mul_of_nonneg_left h1 hA
      _ = A := mul_one A
  
  have hident : ∀ x : E3, (∫ z, η z) * f x - ∫ y, η (x - y) * f y =
      ∫ z, η z * (f x - f (x - z)) := by
    intro x
    have htr : ∫ y, η (x - y) * f y = ∫ z, η z * f (x - z) := by
      have h := integral_sub_left_eq_self (fun y => η (x - y) * f y) (volume : Measure E3) x
      simp only [sub_sub_cancel] at h
      exact h.symm
    have I₁ : Integrable (fun z => η z * f x) := hηi.mul_const (f x)
    have I₂ : Integrable (fun z => η z * f (x - z)) := by
      refine (hηi.norm.mul_const A).mono'
        ((hηc.mul (hf.continuous.comp (continuous_const.sub continuous_id))).aestronglyMeasurable)
        (Filter.Eventually.of_forall fun z => ?_)
      rw [norm_mul, Real.norm_eq_abs (f (x - z))]
      exact mul_le_mul_of_nonneg_left (hfB _) (norm_nonneg _)
    rw [htr, ← integral_mul_const, ← integral_sub I₁ I₂]
    congr 1
    funext z
    ring
  
  have hJ0 : 0 ≤ ∫ z : E3, (1 + ‖z‖) ^ (a - 5) :=
    integral_nonneg (fun z => Real.rpow_nonneg (by positivity) _)
  refine ⟨M * A * ∫ z : E3, (1 + ‖z‖) ^ (a - 5), mul_nonneg (mul_nonneg hM hA) hJ0,
    fun x => ?_⟩
  rw [hident x, ← Real.norm_eq_abs]
  have hmaj : ∀ z : E3, ‖η z * (f x - f (x - z))‖ ≤
      M * A * (1 + ‖z‖) ^ (a - 5) * (1 + ‖x‖) ^ (-a - 1) := by
    intro z
    have hQ : 0 < 1 + ‖z‖ := by positivity
    rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (hη0 z)]
    have h1 := mul_le_mul (hηb z) (hinc x z) (abs_nonneg _)
      (mul_nonneg hM (Real.rpow_nonneg hQ.le _))
    have h2 : (1 + ‖z‖) ^ (-7 : ℝ) * (1 + ‖z‖) ^ (a + 2) = (1 + ‖z‖) ^ (a - 5) := by
      rw [← Real.rpow_add hQ]
      congr 1
      ring
    calc η z * |f x - f (x - z)|
        ≤ M * (1 + ‖z‖) ^ (-7 : ℝ) * (A * (1 + ‖z‖) ^ (a + 2) * (1 + ‖x‖) ^ (-a - 1)) := h1
      _ = M * A * ((1 + ‖z‖) ^ (-7 : ℝ) * (1 + ‖z‖) ^ (a + 2)) * (1 + ‖x‖) ^ (-a - 1) := by
          ring
      _ = _ := by rw [h2]
  have hg : Integrable (fun z : E3 => M * A * (1 + ‖z‖) ^ (a - 5) * (1 + ‖x‖) ^ (-a - 1)) :=
    (hWa.const_mul (M * A)).mul_const _
  refine (norm_integral_le_of_norm_le hg (Filter.Eventually.of_forall hmaj)).trans ?_
  rw [integral_mul_const, integral_const_mul]

theorem ray_growth_bound (v : E3 → ℝ) (a B : ℝ) (ha2 : a < 2) (hB : 0 ≤ B)
    (hv : Differentiable ℝ v) (hv0 : v 0 = 0)
    (hdv : ∀ (w : E3) (i : Fin 3), |partialDeriv i v w| ≤ B * (1 + ‖w‖) ^ (1 - a)) (x : E3) :
    |v x| ≤ 3 * B / (2 - a) * (1 + ‖x‖) ^ (2 - a) :=
by
  have h2a : 0 < 2 - a := by linarith
  set r := ‖x‖ with hr
  have hr0 : 0 ≤ r := norm_nonneg x
  set c := 3 * B / (2 - a) with hc
  have hc0 : 0 ≤ c := div_nonneg (by linarith) h2a.le
  
  have hcoord : ∀ w : E3, |fderiv ℝ v w x| ≤ 3 * (r * (B * (1 + ‖w‖) ^ (1 - a))) := by
    intro w
    have hx : x = ∑ i : Fin 3, x i • e i := by
      conv_lhs => rw [← (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr x]
      simp [EuclideanSpace.basisFun_apply]
    have hL : fderiv ℝ v w x = ∑ i : Fin 3, x i * partialDeriv i v w := by
      conv_lhs => rw [hx]
      rw [map_sum]
      simp only [map_smul, smul_eq_mul]
      rfl
    rw [hL, Fin.sum_univ_three]
    have hb : ∀ i : Fin 3, |x i * partialDeriv i v w| ≤ r * (B * (1 + ‖w‖) ^ (1 - a)) := by
      intro i
      rw [abs_mul]
      have h1 : |x i| ≤ r := by
        have := PiLp.norm_apply_le x i
        rwa [Real.norm_eq_abs] at this
      exact mul_le_mul h1 (hdv w i) (abs_nonneg _) hr0
    have t := abs_add_three (x 0 * partialDeriv 0 v w) (x 1 * partialDeriv 1 v w)
      (x 2 * partialDeriv 2 v w)
    linarith [hb 0, hb 1, hb 2]
  
  have hφ : ∀ t : ℝ, HasDerivAt (fun s : ℝ => v (s • x)) (fderiv ℝ v (t • x) x) t := by
    intro t
    have h1 : HasDerivAt (fun s : ℝ => s • x) ((1 : ℝ) • x) t := (hasDerivAt_id t).smul_const x
    have h2 := (hv (t • x)).hasFDerivAt.comp_hasDerivAt t h1
    rw [one_smul] at h2
    exact h2
  
  have hψ : ∀ t : ℝ, 0 ≤ t → HasDerivAt (fun s : ℝ => c * (1 + s * r) ^ (2 - a))
      (c * (r * (2 - a) * (1 + t * r) ^ (2 - a - 1))) t := by
    intro t ht
    have hg : HasDerivAt (fun s : ℝ => 1 + s * r) r t := by
      simpa using ((hasDerivAt_id t).mul_const r).const_add 1
    have hpos : (1 + t * r) ≠ 0 := by
      have := mul_nonneg ht hr0
      exact ne_of_gt (by linarith)
    exact (hg.rpow_const (p := 2 - a) (Or.inl hpos)).const_mul c
  
  have hbound : ∀ t ∈ Set.Ico (0 : ℝ) 1,
      ‖fderiv ℝ v (t • x) x‖ ≤ c * (r * (2 - a) * (1 + t * r) ^ (2 - a - 1)) := by
    intro t ht
    have h1 := hcoord (t • x)
    have hn : ‖t • x‖ = t * r := by rw [norm_smul, Real.norm_eq_abs, abs_of_nonneg ht.1]
    rw [hn] at h1
    rw [Real.norm_eq_abs]
    have he : (2 - a - 1 : ℝ) = 1 - a := by ring
    rw [he]
    have hc2 : c * (2 - a) = 3 * B := by rw [hc]; field_simp
    calc |fderiv ℝ v (t • x) x| ≤ 3 * (r * (B * (1 + t * r) ^ (1 - a))) := h1
      _ = c * (r * (2 - a) * (1 + t * r) ^ (1 - a)) := by
        linear_combination (-(r * (1 + t * r) ^ (1 - a))) * hc2
  
  have key : ‖(fun s : ℝ => v (s • x)) 1‖ ≤ (fun s : ℝ => c * (1 + s * r) ^ (2 - a)) 1 :=
    image_norm_le_of_norm_deriv_right_le_deriv_boundary'
      (fun t _ => (hφ t).continuousAt.continuousWithinAt)
      (fun t _ => (hφ t).hasDerivWithinAt)
      (by simp [hv0, hc0])
      (fun t ht => (hψ t ht.1).continuousAt.continuousWithinAt)
      (fun t ht => (hψ t ht.1).hasDerivWithinAt)
      hbound
      (show (1 : ℝ) ∈ Set.Icc 0 1 from ⟨zero_le_one, le_rfl⟩)
  
  simp only [one_smul, one_mul, Real.norm_eq_abs] at key
  exact key

theorem smoothed_potential_C2 (f : E3 → ℝ) (a A : ℝ) (ha : 1 < a) (ha2 : a < 2) (hA : 0 ≤ A)
    (hf : Differentiable ℝ f)
    (hf0 : ∀ x : E3, |f x| ≤ A * (1 + ‖x‖) ^ (-a))
    (hf1 : ∀ x : E3, ‖fderiv ℝ f x‖ ≤ A * (1 + ‖x‖) ^ (-a - 1)) :
    ∃ (v : E3 → ℝ) (B : ℝ), 0 ≤ B ∧ Differentiable ℝ v ∧
      (∀ i : Fin 3, Differentiable ℝ (partialDeriv i v)) ∧
      ∀ x : E3, |v x| ≤ B * (1 + ‖x‖) ^ (2 - a) ∧
        (∀ i : Fin 3, |partialDeriv i v x| ≤ B * (1 + ‖x‖) ^ (1 - a)) ∧
        (∀ i j : Fin 3, |partialDeriv i (partialDeriv j v) x| ≤ B * (1 + ‖x‖) ^ (-a)) ∧
        |∑ i : Fin 3, partialDeriv i (partialDeriv i v) x + f x| ≤ B * (1 + ‖x‖) ^ (-a - 1) :=
by
  classical
  
  obtain ⟨K, hK⟩ : ∃ K : E3 → ℝ, ∀ z : E3,
      K z = (1 + ‖z‖ ^ 2) ^ (-(1 / 2 : ℝ)) + 1 / 2 * (1 + ‖z‖ ^ 2) ^ (-(3 / 2 : ℝ)) :=
    ⟨_, fun z => rfl⟩
  obtain ⟨η, hη⟩ : ∃ η : E3 → ℝ, ∀ z : E3, η z = 15 / 2 * (1 + ‖z‖ ^ 2) ^ (-(7 / 2 : ℝ)) :=
    ⟨_, fun z => rfl⟩
  obtain ⟨hKd, hKid, hK1, hK2, htr⟩ := spc2_kernel_facts K hK
  obtain ⟨hηc, hη0, hηb, hηi, hcpos⟩ := spc2_density_facts η hη
  have htr' : ∀ z : E3, ∑ i : Fin 3, partialDeriv i (partialDeriv i K) z = -η z := by
    intro z; rw [htr z, hη z]
  obtain ⟨c, hc⟩ : ∃ c : ℝ, c = ∫ z, η z := ⟨_, rfl⟩
  rw [← hc] at hcpos
  have hc0 : c ≠ 0 := ne_of_gt hcpos
  have hcinv : 0 ≤ c⁻¹ := inv_nonneg.mpr hcpos.le
  have hfc : Continuous f := hf.continuous
  have hKic : ∀ i : Fin 3, Continuous (partialDeriv i K) := fun i => (hKid i).continuous
  
  have hpd_le : ∀ (g : E3 → ℝ) (i : Fin 3) (z : E3), |partialDeriv i g z| ≤ ‖fderiv ℝ g z‖ := by
    intro g i z
    calc |partialDeriv i g z| = ‖fderiv ℝ g z (e i)‖ := by rw [Real.norm_eq_abs]; rfl
      _ ≤ ‖fderiv ℝ g z‖ * ‖e i‖ := ContinuousLinearMap.le_opNorm _ _
      _ = ‖fderiv ℝ g z‖ := by simp [EuclideanSpace.norm_single]
  have hpd_add_const : ∀ (g : E3 → ℝ) (b : ℝ) (j : Fin 3) (x : E3),
      partialDeriv j (fun x => g x + b) x = partialDeriv j g x := by
    intro g b j x
    unfold partialDeriv
    rw [fderiv_add_const]
  have hpd_const_mul : ∀ (g : E3 → ℝ) (b : ℝ) (j : Fin 3) (x : E3), DifferentiableAt ℝ g x →
      partialDeriv j (fun x => b * g x) x = b * partialDeriv j g x := by
    intro g b j x hg
    unfold partialDeriv
    rw [fderiv_const_mul hg]
    rfl
  
  have hKi0 : ∀ (i : Fin 3) (z : E3), |partialDeriv i K z| ≤ 10 * (1 + ‖z‖) ^ (-2 : ℝ) :=
    fun i z => (hpd_le K i z).trans (hK1 z)
  have hKij0 : ∀ (i j : Fin 3) (z : E3),
      |partialDeriv j (partialDeriv i K) z| ≤ 60 * (1 + ‖z‖) ^ (-3 : ℝ) :=
    fun i j z => (hpd_le _ j z).trans (hK2 i z)
  
  have hpt : ∀ (k : E3 → ℝ) (p M : ℝ), (∀ z : E3, |k z| ≤ M * (1 + ‖z‖) ^ (-p)) →
      ∀ w y : E3, ‖k (w - y) * f y‖ ≤ M * A * ((1 + ‖w - y‖) ^ (-p) * (1 + ‖y‖) ^ (-a)) := by
    intro k p M hkb w y
    rw [Real.norm_eq_abs, abs_mul]
    have h1 := hkb (w - y)
    calc |k (w - y)| * |f y| ≤ (M * (1 + ‖w - y‖) ^ (-p)) * (A * (1 + ‖y‖) ^ (-a)) :=
          mul_le_mul h1 (hf0 y) (abs_nonneg _) ((abs_nonneg _).trans h1)
      _ = M * A * ((1 + ‖w - y‖) ^ (-p) * (1 + ‖y‖) ^ (-a)) := by ring
  have hint : ∀ (k : E3 → ℝ) (p M : ℝ), 0 ≤ p → 3 < p + a → Measurable k →
      (∀ z : E3, |k z| ≤ M * (1 + ‖z‖) ^ (-p)) → ∀ w : E3,
      Integrable (fun y => k (w - y) * f y) := by
    intro k p M hp hpa hk hkb w
    refine Integrable.mono' ((weight_peetre_integrable p a hp hpa w).const_mul (M * A)) ?_ ?_
    · exact ((hk.comp (measurable_const.sub measurable_id)).mul
        hfc.measurable).aestronglyMeasurable
    · exact Filter.Eventually.of_forall (fun y => hpt k p M hkb w y)
  
  obtain ⟨C₂, hC₂, hconv2⟩ :=
    weight_conv_bound 2 a (by norm_num) (by norm_num) (by linarith) (by linarith) (by linarith)
  obtain ⟨C₃, hC₃, hconv3⟩ :=
    weight_conv_bound (a + 1) 2 (by linarith) (by linarith) (by norm_num) (by norm_num)
      (by linarith)
  obtain ⟨C₇, hC₇, hres⟩ :=
    approx_identity_residual η f a A 100 ha ha2 hA (by norm_num) hηc hη0 hηb hf hf0 hf1
  
  have hs5K := fun x : E3 => renorm_conv_hasFDerivAt K f 2 a 10 A (by norm_num) (by linarith)
    (by norm_num) hA hKd hK1 hfc hf0 x
  obtain ⟨W, hW⟩ : ∃ W : Fin 3 → E3 → ℝ, ∀ (i : Fin 3) (x : E3),
      W i x = ∫ y, partialDeriv i K (x - y) * f y :=
    ⟨fun i x => ∫ y, partialDeriv i K (x - y) * f y, fun i x => rfl⟩
  obtain ⟨v, hv⟩ : ∃ v : E3 → ℝ, ∀ x : E3,
      v x = c⁻¹ * ∫ y, (K (x - y) - K (-y)) * f y :=
    ⟨fun x => c⁻¹ * ∫ y, (K (x - y) - K (-y)) * f y, fun x => rfl⟩
  have hvfun : v = fun x => c⁻¹ * ∫ y, (K (x - y) - K (-y)) * f y := funext hv
  have hvd : Differentiable ℝ v := by
    rw [hvfun]
    intro x
    exact ((hs5K x).1.differentiableAt).const_mul c⁻¹
  have hpv : ∀ i : Fin 3, partialDeriv i v = fun x => c⁻¹ * W i x := by
    intro i
    funext x
    rw [hvfun, hpd_const_mul _ c⁻¹ i x (hs5K x).1.differentiableAt, (hs5K x).2 i, hW]
  have hWb : ∀ (i : Fin 3) (x : E3), |W i x| ≤ 10 * A * C₂ * (1 + ‖x‖) ^ (1 - a) := by
    intro i x
    rw [hW]
    have h1 : ‖∫ y, partialDeriv i K (x - y) * f y‖ ≤
        ∫ y, 10 * A * ((1 + ‖x - y‖) ^ (-(2 : ℝ)) * (1 + ‖y‖) ^ (-a)) :=
      norm_integral_le_of_norm_le
        ((weight_peetre_integrable 2 a (by norm_num) (by linarith) x).const_mul _)
        (Filter.Eventually.of_forall (fun y => hpt _ 2 10 (hKi0 i) x y))
    rw [integral_const_mul, Real.norm_eq_abs] at h1
    have h2 := hconv2 x
    have e1 : (3 - 2 - a : ℝ) = 1 - a := by ring
    rw [e1] at h2
    have h10 : 0 ≤ 10 * A := by linarith
    calc _ ≤ _ := h1
      _ ≤ 10 * A * (C₂ * (1 + ‖x‖) ^ (1 - a)) := mul_le_mul_of_nonneg_left h2 h10
      _ = _ := by ring
  have hB₁ : 0 ≤ c⁻¹ * (10 * A * C₂) := mul_nonneg hcinv (mul_nonneg (by linarith) hC₂)
  have hdv : ∀ (w : E3) (i : Fin 3),
      |partialDeriv i v w| ≤ c⁻¹ * (10 * A * C₂) * (1 + ‖w‖) ^ (1 - a) := by
    intro w i
    rw [hpv i]
    dsimp only
    rw [abs_mul, abs_of_nonneg hcinv]
    calc c⁻¹ * |W i w| ≤ c⁻¹ * (10 * A * C₂ * (1 + ‖w‖) ^ (1 - a)) :=
          mul_le_mul_of_nonneg_left (hWb i w) hcinv
      _ = _ := by ring
  
  have hKim : ∀ i : Fin 3, Measurable (partialDeriv i K) := fun i => (hKic i).measurable
  have hWint : ∀ (i : Fin 3) (w : E3), Integrable (fun y => partialDeriv i K (w - y) * f y) :=
    fun i w => hint _ 2 10 (by norm_num) (by linarith) (hKim i) (hKi0 i) w
  have hWsplit : ∀ (i : Fin 3) (x : E3), W i x =
      (∫ y, (partialDeriv i K (x - y) - partialDeriv i K (-y)) * f y) + W i 0 := by
    intro i x
    rw [hW, hW]
    have h0 : (fun y : E3 => partialDeriv i K (0 - y) * f y) =
        fun y => partialDeriv i K (-y) * f y := by
      funext y; rw [zero_sub]
    have hI0 : Integrable (fun y : E3 => partialDeriv i K (-y) * f y) := by
      rw [← h0]; exact hWint i 0
    have hsub : (fun y : E3 => (partialDeriv i K (x - y) - partialDeriv i K (-y)) * f y) =
        fun y => partialDeriv i K (x - y) * f y - partialDeriv i K (-y) * f y := by
      funext y; ring
    rw [h0, hsub, integral_sub (hWint i x) hI0]
    ring
  have hs5i := fun (i : Fin 3) (x : E3) => renorm_conv_hasFDerivAt (partialDeriv i K) f 3 a 60 A
    (by norm_num) (by linarith) (by norm_num) hA (hKid i) (hK2 i) hfc hf0 x
  have hWfun : ∀ i : Fin 3, W i = fun x =>
      (∫ y, (partialDeriv i K (x - y) - partialDeriv i K (-y)) * f y) + W i 0 :=
    fun i => funext (hWsplit i)
  have hWd : ∀ i : Fin 3, Differentiable ℝ (W i) := by
    intro i x
    rw [hWfun i]
    exact ((hs5i i x).1.differentiableAt).add_const _
  have hWfd : ∀ (i j : Fin 3) (x : E3),
      partialDeriv j (W i) x = ∫ y, partialDeriv j (partialDeriv i K) (x - y) * f y := by
    intro i j x
    rw [hWfun i, hpd_add_const, (hs5i i x).2 j]
  have hpvd : ∀ i : Fin 3, Differentiable ℝ (partialDeriv i v) := by
    intro i
    rw [hpv i]
    exact (hWd i).const_mul c⁻¹
  have hpv2 : ∀ (i j : Fin 3) (x : E3), partialDeriv j (partialDeriv i v) x =
      c⁻¹ * ∫ y, partialDeriv j (partialDeriv i K) (x - y) * f y := by
    intro i j x
    rw [hpv i, hpd_const_mul (W i) c⁻¹ j x (hWd i x), hWfd]
  
  have hhess : ∀ (i j : Fin 3) (x : E3), |partialDeriv i (partialDeriv j v) x| ≤
      c⁻¹ * (8 * A * 10 * C₃) * (1 + ‖x‖) ^ (-a) := by
    intro i j x
    rw [hpv j, hpd_const_mul (W j) c⁻¹ i x (hWd j x), abs_mul, abs_of_nonneg hcinv]
    have hWj : W j = fun x => ∫ y, partialDeriv j K (x - y) * f y := funext (hW j)
    have hWjd : Differentiable ℝ (fun x : E3 => ∫ y, partialDeriv j K (x - y) * f y) := by
      rw [← hWj]; exact hWd j
    have h6 := conv_fderiv_lip_bound (partialDeriv j K) f a A 10 ha ha2 hA (by norm_num)
      (hKic j) (hKi0 j) hf hf0 hf1 hWjd x
    rw [← hWj] at h6
    have h3 := hconv3 x
    have e1 : (3 - (a + 1) - 2 : ℝ) = -a := by ring
    rw [e1] at h3
    have h80 : 0 ≤ 8 * A * 10 := by linarith
    calc c⁻¹ * |partialDeriv i (W j) x| ≤ c⁻¹ * (8 * A * 10 * (C₃ * (1 + ‖x‖) ^ (-a))) := by
          refine mul_le_mul_of_nonneg_left ?_ hcinv
          calc |partialDeriv i (W j) x| ≤ ‖fderiv ℝ (W j) x‖ := hpd_le _ _ _
            _ ≤ _ := h6
            _ ≤ _ := mul_le_mul_of_nonneg_left h3 h80
      _ = _ := by ring
  
  have hlap : ∀ x : E3, ∑ i : Fin 3, partialDeriv i (partialDeriv i v) x =
      -(c⁻¹ * ∫ y, η (x - y) * f y) := by
    intro x
    simp only [hpv2]
    have hI := integral_finset_sum (μ := (volume : Measure E3)) (Finset.univ : Finset (Fin 3))
      (f := fun (i : Fin 3) (y : E3) => partialDeriv i (partialDeriv i K) (x - y) * f y)
      (fun i _ => hint _ 3 60 (by norm_num) (by linarith)
        (measurable_fderiv_apply_const ℝ (partialDeriv i K) (e i)) (hKij0 i i) x)
    have hfun : (fun y : E3 => ∑ i : Fin 3, partialDeriv i (partialDeriv i K) (x - y) * f y) =
        fun y => -(η (x - y) * f y) := by
      funext y
      rw [← Finset.sum_mul, htr']
      ring
    rw [← Finset.mul_sum, ← hI, hfun, integral_neg]
    ring
  have hresid : ∀ x : E3, |∑ i : Fin 3, partialDeriv i (partialDeriv i v) x + f x| ≤
      c⁻¹ * C₇ * (1 + ‖x‖) ^ (-a - 1) := by
    intro x
    rw [hlap x]
    have heq : -(c⁻¹ * ∫ y, η (x - y) * f y) + f x =
        c⁻¹ * ((∫ z, η z) * f x - ∫ y, η (x - y) * f y) := by
      rw [← hc, mul_sub, ← mul_assoc, inv_mul_cancel₀ hc0, one_mul]
      ring
    rw [heq, abs_mul, abs_of_nonneg hcinv, mul_assoc]
    exact mul_le_mul_of_nonneg_left (hres x) hcinv
  
  have hv0 : v 0 = 0 := by
    rw [hv]
    simp
  have hgrowth := ray_growth_bound v a (c⁻¹ * (10 * A * C₂)) ha2 hB₁ hvd hv0 hdv
  
  have hB₀ : 0 ≤ 3 * (c⁻¹ * (10 * A * C₂)) / (2 - a) :=
    div_nonneg (by linarith) (by linarith)
  have hB₂ : 0 ≤ c⁻¹ * (8 * A * 10 * C₃) := mul_nonneg hcinv (mul_nonneg (by linarith) hC₃)
  have hB₃ : 0 ≤ c⁻¹ * C₇ := mul_nonneg hcinv hC₇
  set B : ℝ := 3 * (c⁻¹ * (10 * A * C₂)) / (2 - a) + c⁻¹ * (10 * A * C₂) +
    c⁻¹ * (8 * A * 10 * C₃) + c⁻¹ * C₇ with hBdef
  have hmono : ∀ (X b p : ℝ) (x : E3), b ≤ B → X ≤ b * (1 + ‖x‖) ^ p →
      X ≤ B * (1 + ‖x‖) ^ p := by
    intro X b p x hb hX
    have h1x : (0 : ℝ) ≤ 1 + ‖x‖ := by have := norm_nonneg x; linarith
    exact hX.trans (mul_le_mul_of_nonneg_right hb (Real.rpow_nonneg h1x _))
  refine ⟨v, B, by rw [hBdef]; linarith, hvd, hpvd, fun x => ⟨?_, fun i => ?_, fun i j => ?_, ?_⟩⟩
  · exact hmono _ _ _ x (by rw [hBdef]; linarith) (hgrowth x)
  · exact hmono _ _ _ x (by rw [hBdef]; linarith) (hdv x i)
  · exact hmono _ _ _ x (by rw [hBdef]; linarith) (hhess i j x)
  · exact hmono _ _ _ x (by rw [hBdef]; linarith) (hresid x)

theorem mollify_C2_smooth (v f : E3 → ℝ) (s t B : ℝ) (hB : 0 ≤ B)
    (hv : Differentiable ℝ v) (hv1 : ∀ i : Fin 3, Differentiable ℝ (partialDeriv i v))
    (hf : Differentiable ℝ f)
    (hb : ∀ x : E3, |v x| ≤ B * (1 + ‖x‖) ^ s ∧
      (∀ i : Fin 3, |partialDeriv i v x| ≤ B * (1 + ‖x‖) ^ (s - 1)) ∧
      (∀ i j : Fin 3, |partialDeriv i (partialDeriv j v) x| ≤ B * (1 + ‖x‖) ^ (s - 2)) ∧
      |∑ i : Fin 3, partialDeriv i (partialDeriv i v) x + f x| ≤ B * (1 + ‖x‖) ^ (-t) ∧
      ‖fderiv ℝ f x‖ ≤ B * (1 + ‖x‖) ^ (-t)) :
    ∃ (w : E3 → ℝ) (B' : ℝ), 0 ≤ B' ∧ ContDiff ℝ ∞ w ∧
      ∀ x : E3, |w x| ≤ B' * (1 + ‖x‖) ^ s ∧
        (∀ i : Fin 3, |partialDeriv i w x| ≤ B' * (1 + ‖x‖) ^ (s - 1)) ∧
        (∀ i j : Fin 3, |partialDeriv i (partialDeriv j w) x| ≤ B' * (1 + ‖x‖) ^ (s - 2)) ∧
        |∑ i : Fin 3, partialDeriv i (partialDeriv i w) x + f x| ≤ B' * (1 + ‖x‖) ^ (-t) :=
by
  
  have weight_shift_le : ∀ (x y : E3) (a r : ℝ), ‖y‖ ≤ r →
      (1 + ‖x - y‖) ^ a ≤ (1 + r) ^ |a| * (1 + ‖x‖) ^ a := by
    intro x y a r hy
    have hr : 0 ≤ r := (norm_nonneg y).trans hy
    have hx0 := norm_nonneg x
    have hxy0 := norm_nonneg (x - y)
    have h1 : 1 + ‖x - y‖ ≤ (1 + r) * (1 + ‖x‖) := by
      have := norm_sub_le x y
      nlinarith
    have h2 : 1 + ‖x‖ ≤ (1 + r) * (1 + ‖x - y‖) := by
      have := norm_sub_norm_le x y
      nlinarith
    rcases le_or_gt 0 a with ha | ha
    · rw [abs_of_nonneg ha, ← Real.mul_rpow (by linarith) (by linarith)]
      exact Real.rpow_le_rpow (by linarith) h1 ha
    · rw [abs_of_neg ha]
      have hpos : 0 < (1 + ‖x‖) / (1 + r) := by positivity
      have h3 : (1 + ‖x‖) / (1 + r) ≤ 1 + ‖x - y‖ := by
        rw [div_le_iff₀ (by linarith)]; linarith
      calc (1 + ‖x - y‖) ^ a ≤ ((1 + ‖x‖) / (1 + r)) ^ a :=
            Real.rpow_le_rpow_of_nonpos hpos h3 ha.le
        _ = (1 + r) ^ (-a) * (1 + ‖x‖) ^ a := by
            rw [Real.div_rpow (by linarith) (by linarith), Real.rpow_neg (by linarith)]
            ring
  
  have conv_abs_le_of_ball : ∀ (ρ φ : E3 → ℝ) (x : E3) (M : ℝ),
      Continuous ρ → HasCompactSupport ρ → (∀ y : E3, 0 ≤ ρ y) →
      (∀ y : E3, 1 < ‖y‖ → ρ y = 0) → ∫ y : E3, ρ y = 1 →
      (∀ y : E3, ‖y‖ ≤ 1 → |φ (x - y)| ≤ M) →
      |∫ y : E3, ρ y * φ (x - y)| ≤ M := by
    intro ρ φ x M hρc hρcs hρ0 hρs hρ1 hφ
    have hP : ∀ y, ‖ρ y * φ (x - y)‖ ≤ ρ y * M := by
      intro y
      rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_nonneg (hρ0 y)]
      rcases le_or_gt ‖y‖ 1 with h | h
      · exact mul_le_mul_of_nonneg_left (hφ y h) (hρ0 y)
      · rw [hρs y h]; simp
    have hI : Integrable ρ := hρc.integrable_of_hasCompactSupport hρcs
    calc |∫ y : E3, ρ y * φ (x - y)| = ‖∫ y : E3, ρ y * φ (x - y)‖ := (Real.norm_eq_abs _).symm
      _ ≤ ∫ y, ‖ρ y * φ (x - y)‖ := norm_integral_le_integral_norm _
      _ ≤ ∫ y, ρ y * M := integral_mono_of_nonneg (ae_of_all _ fun y => norm_nonneg _)
          (hI.mul_const M) (ae_of_all _ hP)
      _ = M := by rw [integral_mul_const, hρ1, one_mul]
  
  have conv_integrable_of_ball : ∀ (ρ ψ : E3 → ℝ) (x : E3) (M : ℝ),
      Continuous ρ → HasCompactSupport ρ → (∀ y : E3, 1 < ‖y‖ → ρ y = 0) → Measurable ψ →
      (∀ y : E3, ‖y‖ ≤ 1 → |ψ (x - y)| ≤ M) →
      Integrable (fun y : E3 => ρ y * ψ (x - y)) := by
    intro ρ ψ x M hρc hρcs hρs hψ hb
    refine Integrable.mono' ((hρc.integrable_of_hasCompactSupport hρcs).abs.mul_const M) ?_
      (ae_of_all _ ?_)
    · exact (hρc.measurable.mul (hψ.comp (measurable_const.sub measurable_id))).aestronglyMeasurable
    · intro y
      rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs]
      rcases le_or_gt ‖y‖ 1 with h | h
      · exact mul_le_mul_of_nonneg_left (hb y h) (abs_nonneg _)
      · rw [hρs y h]; simp
  
  have conv_partialDeriv : ∀ (ρ φ : E3 → ℝ),
      Continuous ρ → HasCompactSupport ρ → (∀ y : E3, 1 < ‖y‖ → ρ y = 0) →
      Differentiable ℝ φ →
      (∀ (i : Fin 3) (R : ℝ), ∃ M : ℝ, ∀ z : E3, ‖z‖ ≤ R → |partialDeriv i φ z| ≤ M) →
      Differentiable ℝ (fun x : E3 => ∫ y : E3, ρ y * φ (x - y)) →
      ∀ (i : Fin 3) (x : E3),
      partialDeriv i (fun x : E3 => ∫ y : E3, ρ y * φ (x - y)) x =
        ∫ y : E3, ρ y * partialDeriv i φ (x - y) := by
    intro ρ φ hρc hρcs hρs hφ hloc hdiff i x
    have hu1 : ‖e i‖ = 1 := by simp [EuclideanSpace.norm_single]
    obtain ⟨M, hM⟩ := hloc i (‖x‖ + 2)
    have hline : ∀ s0 : ℝ, HasDerivAt (fun s : ℝ => x + s • e i) (e i) s0 := by
      intro s0
      simpa using ((hasDerivAt_id s0).smul_const (e i)).const_add x
    have ha : HasDerivAt (fun s : ℝ => (fun x : E3 => ∫ y : E3, ρ y * φ (x - y)) (x + s • e i))
        (partialDeriv i (fun x : E3 => ∫ y : E3, ρ y * φ (x - y)) x) 0 :=
      (hdiff x).hasFDerivAt.comp_hasDerivAt_of_eq (0:ℝ) (hline 0) (by simp)
    have hIρ : Integrable ρ := hρc.integrable_of_hasCompactSupport hρcs
    have hb := hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := volume)
      (F := fun (s : ℝ) (y : E3) => ρ y * φ (x + s • e i - y))
      (F' := fun (s : ℝ) (y : E3) => ρ y * partialDeriv i φ (x + s • e i - y))
      (x₀ := 0) (bound := fun y => |ρ y| * M) (Metric.ball_mem_nhds (0:ℝ) one_pos)
      (Filter.Eventually.of_forall fun s =>
        (hρc.mul (hφ.continuous.comp (continuous_const.sub continuous_id))).aestronglyMeasurable)
      ((hρc.mul (hφ.continuous.comp
        (continuous_const.sub continuous_id))).integrable_of_hasCompactSupport (hρcs.mul_right))
      ((hρc.measurable.mul ((measurable_fderiv_apply_const ℝ φ (e i)).comp
        (measurable_const.sub measurable_id))).aestronglyMeasurable)
      (ae_of_all _ (by
        intro y s hs
        show ‖ρ y * partialDeriv i φ (x + s • e i - y)‖ ≤ |ρ y| * M
        rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs]
        rcases le_or_gt ‖y‖ 1 with h | h
        · refine mul_le_mul_of_nonneg_left (hM _ ?_) (abs_nonneg _)
          have hs' : |s| < 1 := by simpa [Real.dist_eq] using hs
          calc ‖x + s • e i - y‖ ≤ ‖x + s • e i‖ + ‖y‖ := norm_sub_le _ _
            _ ≤ ‖x‖ + ‖s • e i‖ + ‖y‖ := by gcongr; exact norm_add_le _ _
            _ = ‖x‖ + |s| + ‖y‖ := by rw [norm_smul, hu1, Real.norm_eq_abs, mul_one]
            _ ≤ ‖x‖ + 2 := by linarith
        · rw [hρs y h]; simp))
      (hIρ.abs.mul_const M)
      (ae_of_all _ (by
        intro y s _
        have hg : HasDerivAt (fun s : ℝ => x + s • e i - y) (e i) s := (hline s).sub_const y
        exact ((hφ (x + s • e i - y)).hasFDerivAt.comp_hasDerivAt s hg).const_mul (ρ y)))
    have h := ha.unique hb.2
    rw [h]
    simp only [zero_smul, add_zero]
  
  have conv_contDiff : ∀ (ρ φ : E3 → ℝ), ContDiff ℝ ∞ ρ → HasCompactSupport ρ → Continuous φ →
      ContDiff ℝ ∞ (fun x : E3 => ∫ y : E3, ρ y * φ (x - y)) := by
    intro ρ φ hρ hρcs hφ
    have h := hρcs.contDiff_convolution_left (L := ContinuousLinearMap.mul ℝ ℝ) (μ := volume)
      (n := ⊤) hρ hφ.locallyIntegrable
    have heq : convolution ρ φ (ContinuousLinearMap.mul ℝ ℝ) volume =
        fun x : E3 => ∫ y : E3, ρ y * φ (x - y) := by
      funext x; exact convolution_mul
    rw [heq] at h; exact h
  
  have conv_sub_self_le : ∀ (ρ f : E3 → ℝ) (x : E3) (M : ℝ),
      Continuous ρ → HasCompactSupport ρ → (∀ y : E3, 0 ≤ ρ y) →
      (∀ y : E3, 1 < ‖y‖ → ρ y = 0) → ∫ y : E3, ρ y = 1 → Differentiable ℝ f →
      (∀ z : E3, ‖z - x‖ ≤ 1 → ‖fderiv ℝ f z‖ ≤ M) →
      |(∫ y : E3, ρ y * f (x - y)) - f x| ≤ M := by
    intro ρ f x M hρc hρcs hρ0 hρs hρ1 hf hM
    have hMV : ∀ y : E3, ‖y‖ ≤ 1 → |f (x - y) - f x| ≤ M := by
      intro y hy
      have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM x (by simp))
      have hxS : x ∈ Metric.closedBall x 1 := Metric.mem_closedBall_self zero_le_one
      have hyS : x - y ∈ Metric.closedBall x 1 := by
        rw [Metric.mem_closedBall, dist_eq_norm]; simpa using hy
      have h := (convex_closedBall x 1).norm_image_sub_le_of_norm_fderiv_le
        (fun z _ => hf z) (fun z hz => hM z (by rwa [Metric.mem_closedBall, dist_eq_norm] at hz))
        hxS hyS
      rw [← Real.norm_eq_abs]
      calc ‖f (x - y) - f x‖ ≤ M * ‖x - y - x‖ := h
        _ = M * ‖y‖ := by simp
        _ ≤ M * 1 := mul_le_mul_of_nonneg_left hy hM0
        _ = M := mul_one M
    have I₁ : Integrable (fun y : E3 => ρ y * f (x - y)) :=
      (hρc.mul (hf.continuous.comp
        (continuous_const.sub continuous_id))).integrable_of_hasCompactSupport hρcs.mul_right
    have I₂ : Integrable (fun y : E3 => ρ y * f x) :=
      (hρc.integrable_of_hasCompactSupport hρcs).mul_const _
    have heq : (∫ y : E3, ρ y * f (x - y)) - f x = ∫ y : E3, ρ y * (f (x - y) - f x) := by
      have h2 : ∫ y : E3, ρ y * f x = f x := by rw [integral_mul_const, hρ1, one_mul]
      have h3 : ∫ y : E3, ρ y * (f (x - y) - f x) =
          (∫ y : E3, ρ y * f (x - y)) - ∫ y : E3, ρ y * f x := by
        rw [← integral_sub I₁ I₂]; congr 1; funext y; ring
      rw [h3, h2]
    rw [heq]
    exact conv_abs_le_of_ball ρ (fun z => f z - f x) x M hρc hρcs hρ0 hρs hρ1 hMV
  
  obtain ⟨ρ, hρsm, hρcs, hρ0, hρ1, hρs⟩ : ∃ ρ : E3 → ℝ, ContDiff ℝ ∞ ρ ∧ HasCompactSupport ρ ∧
      (∀ y, 0 ≤ ρ y) ∧ ∫ y, ρ y = 1 ∧ ∀ y : E3, 1 < ‖y‖ → ρ y = 0 := by
    let φb : ContDiffBump (0 : E3) := ⟨1/2, 1, by norm_num, by norm_num⟩
    refine ⟨φb.normed volume, φb.contDiff_normed, φb.hasCompactSupport_normed,
      fun y => φb.nonneg_normed y, φb.integral_normed, ?_⟩
    intro y hy
    by_contra hne
    have hmem : y ∈ Function.support (φb.normed volume) := hne
    rw [φb.support_normed_eq] at hmem
    have : ‖y‖ < 1 := by simpa using hmem
    linarith
  have hρc : Continuous ρ := hρsm.continuous
  have h11 : (1 + 1 : ℝ) = 2 := by norm_num
  
  have hA : ∀ (g : E3 → ℝ) (a : ℝ), (∀ z, |g z| ≤ B * (1 + ‖z‖) ^ a) →
      ∀ x y : E3, ‖y‖ ≤ 1 → |g (x - y)| ≤ 2 ^ |a| * B * (1 + ‖x‖) ^ a := by
    intro g a hg x y hy
    have h := weight_shift_le x y a 1 hy
    rw [h11] at h
    calc |g (x - y)| ≤ B * (1 + ‖x - y‖) ^ a := hg _
      _ ≤ B * (2 ^ |a| * (1 + ‖x‖) ^ a) := mul_le_mul_of_nonneg_left h hB
      _ = 2 ^ |a| * B * (1 + ‖x‖) ^ a := by ring
  
  have hBl : ∀ (g : E3 → ℝ) (a : ℝ), (∀ z, |g z| ≤ B * (1 + ‖z‖) ^ a) →
      ∀ R : ℝ, ∃ M : ℝ, ∀ z : E3, ‖z‖ ≤ R → |g z| ≤ M := by
    intro g a hg R
    refine ⟨B * (1 + R) ^ |a|, fun z hz => ?_⟩
    have h := weight_shift_le 0 (-z) a R (by rwa [norm_neg])
    simp only [zero_sub, neg_neg, norm_zero, add_zero, Real.one_rpow, mul_one] at h
    exact (hg z).trans (mul_le_mul_of_nonneg_left h hB)
  
  have hw : ContDiff ℝ ∞ (fun x : E3 => ∫ y : E3, ρ y * v (x - y)) :=
    conv_contDiff ρ v hρsm hρcs hv.continuous
  have hd1 : ∀ j : Fin 3, partialDeriv j (fun x : E3 => ∫ y : E3, ρ y * v (x - y)) =
      fun x => ∫ y : E3, ρ y * partialDeriv j v (x - y) := by
    intro j; funext x
    exact conv_partialDeriv ρ v hρc hρcs hρs hv
      (fun i R => hBl _ _ (fun z => (hb z).2.1 i) R) (hw.differentiable (by simp)) j x
  have hd2 : ∀ (i j : Fin 3) (x : E3),
      partialDeriv i (partialDeriv j (fun x : E3 => ∫ y : E3, ρ y * v (x - y))) x =
        ∫ y : E3, ρ y * partialDeriv i (partialDeriv j v) (x - y) := by
    intro i j x
    rw [hd1 j]
    exact conv_partialDeriv ρ (partialDeriv j v) hρc hρcs hρs (hv1 j)
      (fun i' R => hBl _ _ (fun z => (hb z).2.2.1 i' j) R)
      ((conv_contDiff ρ _ hρsm hρcs (hv1 j).continuous).differentiable (by simp)) i x
  
  have hc0 : (0 : ℝ) ≤ 2 ^ |s| := Real.rpow_nonneg (by norm_num) _
  have hc1 : (0 : ℝ) ≤ 2 ^ |s - 1| := Real.rpow_nonneg (by norm_num) _
  have hc2 : (0 : ℝ) ≤ 2 ^ |s - 2| := Real.rpow_nonneg (by norm_num) _
  have hct : (0 : ℝ) ≤ 2 ^ |t| := Real.rpow_nonneg (by norm_num) _
  refine ⟨fun x : E3 => ∫ y : E3, ρ y * v (x - y),
    B * (2 ^ |s| + 2 ^ |s - 1| + 2 ^ |s - 2| + 2 * 2 ^ |t|),
    mul_nonneg hB (by linarith), hw, fun x => ?_⟩
  have hW : ∀ a : ℝ, 0 ≤ (1 + ‖x‖) ^ a := fun a =>
    Real.rpow_nonneg (by have := norm_nonneg x; linarith) a
  have key : ∀ (c a Y : ℝ), c ≤ 2 ^ |s| + 2 ^ |s - 1| + 2 ^ |s - 2| + 2 * 2 ^ |t| →
      Y ≤ c * B * (1 + ‖x‖) ^ a →
      Y ≤ B * (2 ^ |s| + 2 ^ |s - 1| + 2 ^ |s - 2| + 2 * 2 ^ |t|) * (1 + ‖x‖) ^ a := by
    intro c a Y hc hY
    refine hY.trans (mul_le_mul_of_nonneg_right ?_ (hW a))
    rw [mul_comm c B]; exact mul_le_mul_of_nonneg_left hc hB
  refine ⟨?_, fun i => ?_, fun i j => ?_, ?_⟩
  · exact key _ _ _ (by linarith)
      (conv_abs_le_of_ball ρ v x _ hρc hρcs hρ0 hρs hρ1 (hA v s (fun z => (hb z).1) x))
  · rw [hd1 i]
    exact key _ _ _ (by linarith)
      (conv_abs_le_of_ball ρ _ x _ hρc hρcs hρ0 hρs hρ1
        (hA _ (s - 1) (fun z => (hb z).2.1 i) x))
  · rw [hd2 i j x]
    exact key _ _ _ (by linarith)
      (conv_abs_le_of_ball ρ _ x _ hρc hρcs hρ0 hρs hρ1
        (hA _ (s - 2) (fun z => (hb z).2.2.1 i j) x))
  · 
    have hI : ∀ i : Fin 3,
        Integrable (fun y : E3 => ρ y * partialDeriv i (partialDeriv i v) (x - y)) := fun i =>
      conv_integrable_of_ball ρ _ x _ hρc hρcs hρs
        (measurable_fderiv_apply_const ℝ (partialDeriv i v) (e i))
        (hA _ _ (fun z => (hb z).2.2.1 i i) x)
    have hJ : Integrable (fun y : E3 => ρ y * f (x - y)) :=
      (hρc.mul (hf.continuous.comp
        (continuous_const.sub continuous_id))).integrable_of_hasCompactSupport hρcs.mul_right
    have hsum : ∑ i : Fin 3, partialDeriv i (partialDeriv i
          (fun x : E3 => ∫ y : E3, ρ y * v (x - y))) x =
        ∫ y : E3, ∑ i : Fin 3, ρ y * partialDeriv i (partialDeriv i v) (x - y) := by
      rw [integral_finset_sum _ (fun i _ => hI i)]
      exact Finset.sum_congr rfl (fun i _ => hd2 i i x)
    have hL : ∫ y : E3, ρ y * (∑ i : Fin 3, partialDeriv i (partialDeriv i v) (x - y) + f (x - y)) =
        (∫ y : E3, ∑ i : Fin 3, ρ y * partialDeriv i (partialDeriv i v) (x - y)) +
          ∫ y : E3, ρ y * f (x - y) := by
      rw [← integral_add (integrable_finset_sum _ (fun i _ => hI i)) hJ]
      congr 1; funext y; rw [mul_add, Finset.mul_sum]
    have hid : ∑ i : Fin 3, partialDeriv i (partialDeriv i
          (fun x : E3 => ∫ y : E3, ρ y * v (x - y))) x + f x =
        (∫ y : E3, ρ y * (∑ i : Fin 3, partialDeriv i (partialDeriv i v) (x - y) + f (x - y))) -
          ((∫ y : E3, ρ y * f (x - y)) - f x) := by
      rw [hsum, hL]; ring
    have b1 : |∫ y : E3, ρ y * (∑ i : Fin 3, partialDeriv i (partialDeriv i v) (x - y)
        + f (x - y))| ≤ 2 ^ |t| * B * (1 + ‖x‖) ^ (-t) := by
      have h := hA (fun z => ∑ i : Fin 3, partialDeriv i (partialDeriv i v) z + f z) (-t)
        (fun z => (hb z).2.2.2.1) x
      rw [abs_neg] at h
      exact conv_abs_le_of_ball ρ (fun z => ∑ i : Fin 3, partialDeriv i (partialDeriv i v) z + f z)
        x _ hρc hρcs hρ0 hρs hρ1 h
    have b2 : |(∫ y : E3, ρ y * f (x - y)) - f x| ≤ 2 ^ |t| * B * (1 + ‖x‖) ^ (-t) := by
      refine conv_sub_self_le ρ f x _ hρc hρcs hρ0 hρs hρ1 hf (fun z hz => ?_)
      have h := weight_shift_le x (x - z) (-t) 1 (by rwa [norm_sub_rev])
      rw [sub_sub_cancel, abs_neg, h11] at h
      calc ‖fderiv ℝ f z‖ ≤ B * (1 + ‖z‖) ^ (-t) := (hb z).2.2.2.2
        _ ≤ B * (2 ^ |t| * (1 + ‖x‖) ^ (-t)) := mul_le_mul_of_nonneg_left h hB
        _ = 2 ^ |t| * B * (1 + ‖x‖) ^ (-t) := by ring
    rw [hid]
    refine key (2 * 2 ^ |t|) _ _ (by linarith) ?_
    obtain ⟨b1l, b1r⟩ := abs_le.mp b1
    obtain ⟨b2l, b2r⟩ := abs_le.mp b2
    rw [abs_le]
    constructor <;> nlinarith

theorem far_approx_harmonic (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (q q' : ℝ)
    (hq' : 1 / 2 < q') (hq'1 : q' < 1) (hqq : q' ≤ q)
    (hsmooth : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => G x i j) {x : E3 | 1 < ‖x‖})
    (R C : ℝ) (hR : 1 ≤ R) (hC : 0 ≤ C)
    (hb : ∀ x : E3, R < ‖x‖ → (1 / 2 : ℝ) ≤ (G x).det ∧ ∀ i j k : Fin 3,
      |G x i j - (if i = j then (1 : ℝ) else 0)| ≤ C * ‖x‖ ^ (-q) ∧
      ‖fderiv ℝ (fun y => G y i j) x‖ ≤ C * ‖x‖ ^ (-q - 1) ∧
      ‖fderiv ℝ (fun y => partialDeriv k (fun z => G z i j) y) x‖ ≤ C * ‖x‖ ^ (-q - 2)) :
    ∃ (R₁ C₁ : ℝ) (h : E3 → ℝ), R ≤ R₁ ∧ 0 ≤ C₁ ∧ ContDiffOn ℝ ∞ h {x : E3 | R₁ < ‖x‖} ∧
      ∀ x : E3, R₁ < ‖x‖ →
        |h x - x 0| ≤ C₁ * ‖x‖ ^ (1 - q') ∧ |lapLoc G h x| ≤ C₁ * ‖x‖ ^ (-1 - 2 * q') :=
by
  have hq0 : 0 < q := by linarith
  
  have hπ : ContDiff ℝ ∞ (fun z : E3 => z 0) :=
    (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).contDiff
  have hπd : ∀ z : E3, DifferentiableAt ℝ (fun z : E3 => z 0) z := fun z =>
    (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ).differentiableAt
  have hπ1 : ∀ (j : Fin 3) (z : E3),
      partialDeriv j (fun z : E3 => z 0) z = if j = 0 then (1 : ℝ) else 0 := by
    intro j z
    show fderiv ℝ (⇑(EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ)) z (e j) = _
    rw [ContinuousLinearMap.fderiv]
    show (e j) 0 = _
    simp [EuclideanSpace.single_apply, eq_comm]
  have hπ2 : ∀ (i j : Fin 3) (z : E3),
      partialDeriv i (partialDeriv j (fun z : E3 => z 0)) z = 0 := by
    intro i j z
    have hc : partialDeriv j (fun z : E3 => z 0) = fun _ => if j = 0 then (1 : ℝ) else 0 :=
      funext (hπ1 j)
    rw [hc]
    show fderiv ℝ (fun _ : E3 => if j = 0 then (1 : ℝ) else 0) z (e i) = 0
    rw [fderiv_const_apply]
    rfl
  
  obtain ⟨C₀, hC₀, hF₀s, hF₀⟩ := coord_lap_bounds G q hq0 hsmooth R C hR hC hb
  
  have hF0 : ∀ x : E3, R < ‖x‖ →
      |lapLoc G (fun z : E3 => z 0) x| ≤ C₀ * ‖x‖ ^ (-(1 + q')) := by
    intro x hx
    have hx1 : (1 : ℝ) ≤ ‖x‖ := by linarith
    have h2 : ‖x‖ ^ (-q - 1) ≤ ‖x‖ ^ (-(1 + q')) :=
      Real.rpow_le_rpow_of_exponent_le hx1 (by linarith)
    exact (hF₀ x hx).1.trans (mul_le_mul_of_nonneg_left h2 hC₀)
  have hF1 : ∀ x : E3, R < ‖x‖ →
      ‖fderiv ℝ (lapLoc G (fun z : E3 => z 0)) x‖ ≤ C₀ * ‖x‖ ^ (-(1 + q') - 1) := by
    intro x hx
    have hx1 : (1 : ℝ) ≤ ‖x‖ := by linarith
    have h2 : ‖x‖ ^ (-q - 2) ≤ ‖x‖ ^ (-(1 + q') - 1) :=
      Real.rpow_le_rpow_of_exponent_le hx1 (by linarith)
    exact (hF₀ x hx).2.trans (mul_le_mul_of_nonneg_left h2 hC₀)
  obtain ⟨f, A', hA', hfd, hfeq, hfb⟩ :=
    cutoff_source_bounds (lapLoc G (fun z : E3 => z 0)) R (1 + q') C₀ hR (by linarith) hC₀
      hF₀s hF0 hF1
  
  obtain ⟨v, B₀, hB₀, hvd, hv1d, hvb⟩ :=
    smoothed_potential_C2 f (1 + q') A' (by linarith) (by linarith) hA' hfd
      (fun x => (hfb x).1) (fun x => (hfb x).2)
  
  have hBm0 : B₀ ≤ max B₀ A' := le_max_left _ _
  have hBm1 : A' ≤ max B₀ A' := le_max_right _ _
  have hBm : 0 ≤ max B₀ A' := le_trans hB₀ hBm0
  have hmono : ∀ (X B : ℝ) (y : E3) (p : ℝ), B ≤ max B₀ A' → X ≤ B * (1 + ‖y‖) ^ p →
      X ≤ max B₀ A' * (1 + ‖y‖) ^ p := by
    intro X B y p hB hX
    have h1y : (0 : ℝ) ≤ 1 + ‖y‖ := by have := norm_nonneg y; linarith
    exact hX.trans (mul_le_mul_of_nonneg_right hB (Real.rpow_nonneg h1y _))
  have e1 : (2 - (1 + q') - 1 : ℝ) = 1 - (1 + q') := by ring
  have e2 : (2 - (1 + q') - 2 : ℝ) = -(1 + q') := by ring
  have e3 : (-(1 + q' + 1) : ℝ) = -(1 + q') - 1 := by ring
  obtain ⟨w, B', hB', hw, hwb⟩ :=
    mollify_C2_smooth v f (2 - (1 + q')) (1 + q' + 1) (max B₀ A') hBm hvd hv1d hfd (by
      intro x
      obtain ⟨h0, h1, h2, h3⟩ := hvb x
      refine ⟨hmono _ _ x _ hBm0 h0, fun i => ?_, fun i j => ?_, ?_, ?_⟩
      · rw [e1]; exact hmono _ _ x _ hBm0 (h1 i)
      · rw [e2]; exact hmono _ _ x _ hBm0 (h2 i j)
      · rw [e3]; exact hmono _ _ x _ hBm0 h3
      · rw [e3]; exact hmono _ _ x _ hBm1 (hfb x).2)
  
  obtain ⟨K₂, hK₂, hpert⟩ := lapLoc_flat_perturbation G q hq0 R C hR hC hb
  
  have hwd : ∀ z : E3, DifferentiableAt ℝ w z := fun z => hw.differentiable (by simp) z
  set h : E3 → ℝ := fun x => x 0 + w x with hdef
  have hh1 : ∀ (j : Fin 3) (z : E3),
      partialDeriv j h z = (if j = 0 then (1 : ℝ) else 0) + partialDeriv j w z := by
    intro j z
    rw [← hπ1 j z]
    show fderiv ℝ ((fun y : E3 => y 0) + w) z (e j) =
      fderiv ℝ (fun y : E3 => y 0) z (e j) + fderiv ℝ w z (e j)
    rw [fderiv_add (hπd z) (hwd z)]
    rfl
  have hh2 : ∀ (i j : Fin 3) (z : E3),
      partialDeriv i (partialDeriv j h) z = partialDeriv i (partialDeriv j w) z := by
    intro i j z
    have hc : partialDeriv j h = fun y => (if j = 0 then (1 : ℝ) else 0) + partialDeriv j w y :=
      funext (hh1 j)
    rw [hc]
    show fderiv ℝ (fun y => (if j = 0 then (1 : ℝ) else 0) + partialDeriv j w y) z (e i) =
      fderiv ℝ (partialDeriv j w) z (e i)
    rw [fderiv_const_add]
  have hlin : ∀ z : E3, lapLoc G h z = lapLoc G (fun z : E3 => z 0) z + lapLoc G w z := by
    intro z
    unfold lapLoc hessLoc
    simp only [hh1, hh2, hπ1, hπ2]
    simp only [Fin.sum_univ_three]
    ring
  have h112 : (0 : ℝ) ≤ 1 + 12 * K₂ := by linarith
  refine ⟨R + 2, 2 * B' + B' * (1 + 12 * K₂), h, by linarith, ?_, ?_, ?_⟩
  · have := mul_nonneg hB' h112
    linarith
  · exact (hπ.add hw).contDiffOn
  · intro x hx
    have hxR : R < ‖x‖ := by linarith
    have hρ1 : (1 : ℝ) ≤ ‖x‖ := by linarith
    have hρ0 : 0 < ‖x‖ := by linarith
    have hneg : ∀ p : ℝ, p ≤ 0 → (1 + ‖x‖) ^ p ≤ ‖x‖ ^ p := fun p hp =>
      Real.rpow_le_rpow_of_nonpos hρ0 (by linarith) hp
    obtain ⟨hw0, hw1, hw2, hw3⟩ := hwb x
    constructor
    · have hhx : h x - x 0 = w x := by
        show x 0 + w x - x 0 = w x
        ring
      rw [hhx]
      have hp : 0 ≤ 1 - q' := by linarith
      have hP : 0 ≤ ‖x‖ ^ (1 - q') := Real.rpow_nonneg (by linarith) _
      have hA : (1 + ‖x‖) ^ (2 - (1 + q')) ≤ 2 * ‖x‖ ^ (1 - q') := by
        have e : (2 - (1 + q') : ℝ) = 1 - q' := by ring
        rw [e]
        have h2 : (2 : ℝ) ^ (1 - q') ≤ 2 ^ (1 : ℝ) :=
          Real.rpow_le_rpow_of_exponent_le (by norm_num) (by linarith)
        rw [Real.rpow_one] at h2
        calc (1 + ‖x‖) ^ (1 - q') ≤ (2 * ‖x‖) ^ (1 - q') :=
              Real.rpow_le_rpow (by linarith) (by linarith) hp
          _ = 2 ^ (1 - q') * ‖x‖ ^ (1 - q') := Real.mul_rpow (by norm_num) (by linarith)
          _ ≤ 2 * ‖x‖ ^ (1 - q') := mul_le_mul_of_nonneg_right h2 hP
      have hK : 0 ≤ B' * (1 + 12 * K₂) * ‖x‖ ^ (1 - q') := mul_nonneg (mul_nonneg hB' h112) hP
      calc |w x| ≤ B' * (1 + ‖x‖) ^ (2 - (1 + q')) := hw0
        _ ≤ B' * (2 * ‖x‖ ^ (1 - q')) := mul_le_mul_of_nonneg_left hA hB'
        _ ≤ (2 * B' + B' * (1 + 12 * K₂)) * ‖x‖ ^ (1 - q') := by nlinarith
    · have hfx : f x = lapLoc G (fun z : E3 => z 0) x := hfeq x (by linarith)
      have hP0 : 0 ≤ ‖x‖ ^ (-1 - 2 * q') := Real.rpow_nonneg (by linarith) _
      have hsplit : lapLoc G h x = (∑ i : Fin 3, partialDeriv i (partialDeriv i w) x + f x)
          + (lapLoc G w x - ∑ i : Fin 3, partialDeriv i (partialDeriv i w) x) := by
        rw [hlin x, ← hfx]
        ring
      have b1 : |∑ i : Fin 3, partialDeriv i (partialDeriv i w) x + f x|
          ≤ B' * ‖x‖ ^ (-1 - 2 * q') := by
        have h1 : (1 + ‖x‖) ^ (-(1 + q' + 1)) ≤ ‖x‖ ^ (-(1 + q' + 1)) := hneg _ (by linarith)
        have h2 : ‖x‖ ^ (-(1 + q' + 1)) ≤ ‖x‖ ^ (-1 - 2 * q') :=
          Real.rpow_le_rpow_of_exponent_le hρ1 (by linarith)
        exact hw3.trans (mul_le_mul_of_nonneg_left (h1.trans h2) hB')
      have hij : ∀ i j : Fin 3,
          |partialDeriv i (partialDeriv j w) x| ≤ B' * ‖x‖ ^ (-(1 + q')) := by
        intro i j
        have h1 := hw2 i j
        rw [e2] at h1
        exact h1.trans (mul_le_mul_of_nonneg_left (hneg _ (by linarith)) hB')
      have e4 : (2 - (1 + q') - 1 : ℝ) = -q' := by ring
      have hk : ∀ k : Fin 3, |partialDeriv k w x| ≤ B' * ‖x‖ ^ (-q') := by
        intro k
        have h1 := hw1 k
        rw [e4] at h1
        exact h1.trans (mul_le_mul_of_nonneg_left (hneg _ (by linarith)) hB')
      have hS2 : ∑ i : Fin 3, ∑ j : Fin 3, |partialDeriv i (partialDeriv j w) x| ≤
          9 * (B' * ‖x‖ ^ (-(1 + q'))) := by
        simp only [Fin.sum_univ_three]
        linarith [hij 0 0, hij 0 1, hij 0 2, hij 1 0, hij 1 1, hij 1 2, hij 2 0, hij 2 1,
          hij 2 2]
      have hS1 : ∑ k : Fin 3, |partialDeriv k w x| ≤ 3 * (B' * ‖x‖ ^ (-q')) := by
        simp only [Fin.sum_univ_three]
        linarith [hk 0, hk 1, hk 2]
      have hS2n : 0 ≤ ∑ i : Fin 3, ∑ j : Fin 3, |partialDeriv i (partialDeriv j w) x| :=
        Finset.sum_nonneg (fun i _ => Finset.sum_nonneg (fun j _ => abs_nonneg _))
      have hS1n : 0 ≤ ∑ k : Fin 3, |partialDeriv k w x| :=
        Finset.sum_nonneg (fun k _ => abs_nonneg _)
      have hq1 : ‖x‖ ^ (-q) ≤ ‖x‖ ^ (-q') :=
        Real.rpow_le_rpow_of_exponent_le hρ1 (by linarith)
      have hq2 : ‖x‖ ^ (-q - 1) ≤ ‖x‖ ^ (-q' - 1) :=
        Real.rpow_le_rpow_of_exponent_le hρ1 (by linarith)
      have ee1 : ‖x‖ ^ (-q') * ‖x‖ ^ (-(1 + q')) = ‖x‖ ^ (-1 - 2 * q') := by
        rw [← Real.rpow_add hρ0]; congr 1; ring
      have ee2 : ‖x‖ ^ (-q' - 1) * ‖x‖ ^ (-q') = ‖x‖ ^ (-1 - 2 * q') := by
        rw [← Real.rpow_add hρ0]; congr 1; ring
      have hT : ‖x‖ ^ (-q) * (∑ i : Fin 3, ∑ j : Fin 3, |partialDeriv i (partialDeriv j w) x|)
          + ‖x‖ ^ (-q - 1) * (∑ k : Fin 3, |partialDeriv k w x|)
            ≤ 12 * B' * ‖x‖ ^ (-1 - 2 * q') := by
        have t1 := mul_le_mul hq1 hS2 hS2n (Real.rpow_nonneg (by linarith) _)
        have t2 := mul_le_mul hq2 hS1 hS1n (Real.rpow_nonneg (by linarith) _)
        have t3 : ‖x‖ ^ (-q') * (9 * (B' * ‖x‖ ^ (-(1 + q'))))
            + ‖x‖ ^ (-q' - 1) * (3 * (B' * ‖x‖ ^ (-q')))
              = 12 * B' * ‖x‖ ^ (-1 - 2 * q') := by
          linear_combination (9 * B') * ee1 + (3 * B') * ee2
        linarith
      have b2 : |lapLoc G w x - ∑ i : Fin 3, partialDeriv i (partialDeriv i w) x|
          ≤ K₂ * (12 * B' * ‖x‖ ^ (-1 - 2 * q')) :=
        (hpert w x hxR).trans (mul_le_mul_of_nonneg_left hT hK₂)
      rw [hsplit]
      have hBP := mul_nonneg hB' hP0
      calc _ ≤ |∑ i : Fin 3, partialDeriv i (partialDeriv i w) x + f x|
            + |lapLoc G w x - ∑ i : Fin 3, partialDeriv i (partialDeriv i w) x| :=
            abs_add_le _ _
