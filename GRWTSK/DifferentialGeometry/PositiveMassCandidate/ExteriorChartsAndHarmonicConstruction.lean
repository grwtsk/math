    fun f hf j => (hf.fderiv_of_isOpen hB2 (by simp)).clm_apply contDiffOn_const
  have hf2 : ∀ i j : Fin 3, ContDiffOn ℝ ∞
      (fun z => partialDeriv i (fun y => partialDeriv j w y) z) (Metric.ball 0 2) :=
