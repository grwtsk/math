  have hB0 : ∀ a b : Fin 2, |A₀⁻¹ a b| ≤ M := fun a b => le_trans (hβ a b) hMβ
  have hMs : M * s ≤ M := mul_le_of_le_one_right hM0.le hs1
  have hBb : ∀ a b : Fin 2, |B a b| ≤ 2 * M := by
    intro a b
