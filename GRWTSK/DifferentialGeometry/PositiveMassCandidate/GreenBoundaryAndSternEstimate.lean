  have hsδ' : s * (56 * M ^ 4) ≤ 1 := (le_div_iff₀ hM4).mp hsδ
  have htM : 56 * M ^ 4 ≤ t := by
    calc 56 * M ^ 4 = t * (s * (56 * M ^ 4)) := by linear_combination (-(56 * M ^ 4)) * hst
