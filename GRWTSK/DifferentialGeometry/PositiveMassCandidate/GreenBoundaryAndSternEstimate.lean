    sum2 _ _ (fun a => sum2 _ _ (fun b => sum2 _ _ (fun c => sum2 _ _ (fun d => hHSt a b c d))))
  
  have hu0 := hu' 0
  have hu1 := hu' 1
  have hv0 : A₀⁻¹ 0 0 * u 0 + A₀⁻¹ 0 1 * u 1 = z 0 * r := by
    linear_combination A₀⁻¹ 0 0 * hu0 + A₀⁻¹ 0 1 * hu1 + (z 0 * r) * e00 + (z 1 * r) * e01
  have hv1 : A₀⁻¹ 1 0 * u 0 + A₀⁻¹ 1 1 * u 1 = z 1 * r := by
    linear_combination A₀⁻¹ 1 0 * hu0 + A₀⁻¹ 1 1 * hu1 + (z 0 * r) * e10 + (z 1 * r) * e11
  have hsum : u 0 * z 0 + u 1 * z 1 = 1 := by
