  have hM0 : 0 < M := by linarith
  have hMα : 4 * α ≤ M := by rw [hM_def]; linarith
  have hMβ : β ≤ M := by rw [hM_def]; linarith
  have hMκ : κ ≤ M := by rw [hM_def]; linarith
  have hMC : C₀ ≤ M := by rw [hM_def]; linarith
  have hMp : 2 * γ + C₀ ≤ M := by rw [hM_def]; linarith
  have hML : γ + 8 * γ ^ 2 ≤ M := by rw [hM_def]; linarith
  have hMH : ζ + 2 * C₀ * (2 * γ + C₀) ≤ M := by rw [hM_def]; linarith
  have hM4p := pow_pos hM0 4
  have hM6p := pow_pos hM0 6
  have hM4 : 0 < 56 * M ^ 4 := by linarith
  refine ⟨1 / (56 * M ^ 4), 1024 * M ^ 6, div_pos one_pos hM4, by linarith, ?_⟩
  intro z s hs hsδ hz B u p H Γ hB hu hp hH hΓ
  
  obtain ⟨t, ht_def⟩ : ∃ t : ℝ, t = s⁻¹ := ⟨_, rfl⟩
  have hst : s * t = 1 := by rw [ht_def]; exact mul_inv_cancel₀ hs.ne'
