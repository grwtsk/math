  have hAqr : ∀ c a : Fin 2, A₀ c a / q = A₀ c a * r := by
    intro c a
    rw [hr, div_eq_mul_inv]
  have hμr : μ * r ≤ t ^ 2 := by
    have h1 : μ * s ^ 2 * r ≤ q * r := mul_le_mul_of_nonneg_right hqlow hr0.le
    rw [hqr] at h1
    calc μ * r = μ * s ^ 2 * r * t ^ 2 := by
