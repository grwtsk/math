      _ ≤ M := hMα
  obtain ⟨r, hr⟩ : ∃ r : ℝ, r = q⁻¹ := ⟨_, rfl⟩
  have hqr : q * r = 1 := by rw [hr]; exact mul_inv_cancel₀ hq.ne'
  have hr0 : 0 < r := by rw [hr]; exact inv_pos.mpr hq
  have hu' : ∀ c : Fin 2, u c = (A₀ c 0 * z 0 + A₀ c 1 * z 1) * r := by
