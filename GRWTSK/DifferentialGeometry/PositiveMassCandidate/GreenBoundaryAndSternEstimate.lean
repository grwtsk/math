  have hLB : ∀ c a : Fin 2, |A₀ c a * r - 2 * u c * u a| ≤ M * t ^ 2 := by
    intro c a
    have h1 := sub2 _ _ _ _ (hAr c a)
      (prod3 _ _ _ _ _ _ (le_of_eq (abs_two)) (huB c) (huB a))
    have h2 : γ * t ^ 2 + 2 * (2 * γ * t) * (2 * γ * t) ≤ M * t ^ 2 := by
      have e : γ * t ^ 2 + 2 * (2 * γ * t) * (2 * γ * t) = (γ + 8 * γ ^ 2) * t ^ 2 := by ring
      rw [e]
      exact mul_le_mul_of_nonneg_right hML ht2p.le
    linarith
  have hpB0 : ∀ m : Fin 2, |p m| ≤ (2 * γ + C₀) * t := by
