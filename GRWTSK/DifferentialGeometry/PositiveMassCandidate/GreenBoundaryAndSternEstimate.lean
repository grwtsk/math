      _ = t ^ 2 := one_mul _
  
  have huB : ∀ c : Fin 2, |u c| ≤ 2 * γ * t := by
    intro c
    rw [hu' c, abs_mul, abs_of_pos hr0]
    have hwb : |A₀ c 0 * z 0 + A₀ c 1 * z 1| ≤ 2 * α * s := by
