    linarith
  have hMtt : M * t ≤ M * t ^ 2 := mul_le_mul_of_nonneg_left htt hM0.le
  have hHb : ∀ c a : Fin 2, |H c a| ≤ 2 * M * t ^ 2 := by
    intro c a
