    intro c
    simp only [Fin.sum_univ_two]
    linear_combination (A₀ c 0 * r - 2 * u c * u 0) * hv0 +
      (A₀ c 1 * r - 2 * u c * u 1) * hv1 + (-r) * hu' c + (-2 * r * u c) * hsum
  
  rw [hG0] at hGd
  obtain ⟨G, hG⟩ : ∃ G : ℝ, G = ∑ i : Fin 2, ∑ j : Fin 2, B i j * p i * p j := ⟨_, rfl⟩
  rw [← hG] at hGd ⊢
  have hrt : t ^ 2 ≤ M * r := by
    calc t ^ 2 = r * (q * t ^ 2) := by linear_combination (-(t ^ 2)) * hqr
