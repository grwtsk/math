    have k2 := prod2 _ _ _ _ (huM c) hGd
    have k := abs2 _ _ _ _ k1 k2
    have m1 : 16 * M ^ 3 * t ^ 2 ≤ 16 * M ^ 4 * t ^ 2 :=
