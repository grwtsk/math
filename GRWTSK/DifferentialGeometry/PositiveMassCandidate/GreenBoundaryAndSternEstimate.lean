  have hMt2 : 56 * M ^ 4 * t ≤ t * t := mul_le_mul_of_nonneg_right htM ht0.le
  have eMG : M * (r - 12 * M ^ 3 * t) = M * r - 12 * (M ^ 4 * t) := by ring
  have eMt : 56 * M ^ 4 * t = 56 * (M ^ 4 * t) := by ring
