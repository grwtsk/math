    have f1 : M * t * (12 * M ^ 3 * t) = 12 * M ^ 4 * t ^ 2 := by ring
    have f2 : 28 * M ^ 4 * (2 * M * G) = 56 * M ^ 5 * G := by ring
    linarith
  · have h1 : (t ^ 2) ^ 2 ≤ (2 * M * G) ^ 2 := pow_le_pow_left₀ ht2p.le hGt2 2
    have h2 : 256 * M ^ 4 * (t ^ 2) ^ 2 ≤ 256 * M ^ 4 * (2 * M * G) ^ 2 :=
      mul_le_mul_of_nonneg_left h1 (by linarith)
    have f1 : 2 * (2 * (2 * (2 * (16 * M ^ 4 * t ^ 4)))) = 256 * M ^ 4 * (t ^ 2) ^ 2 := by ring
    have f2 : 256 * M ^ 4 * (2 * M * G) ^ 2 = 1024 * M ^ 6 * G ^ 2 := by ring
    linarith
  · intro c
    have m2 : M * t ^ 2 ≤ M * (2 * M * G) := mul_le_mul_of_nonneg_left hGt2 hM0.le
    have m3 : 2 * M ^ 2 * G ≤ 1024 * M ^ 6 * G :=
      mul_le_mul_of_nonneg_right (by linarith) hGpos.le
    have f1 : M * (2 * M * G) = 2 * M ^ 2 * G := by ring
    linarith [huM c]

theorem pcgb_pole_metric_bounds (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (W : Set E2) (hW : IsOpen W)
    (hinv : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y)⁻¹ a b) W)
    (hΓ : ∀ k i j : Fin 2, ContDiffOn ℝ ∞ (christoffel2 h k i j) W)
    (hK : ContinuousOn (gaussCurv2 h) W) (x₀ : E2) (ρ : ℝ)
    (hsub : Metric.closedBall x₀ ρ ⊆ W) :
    ∃ κ C₀ : ℝ, 0 ≤ κ ∧ 0 ≤ C₀ ∧ ∀ x ∈ Metric.closedBall x₀ ρ,
      (∀ a b : Fin 2, |(h x)⁻¹ a b - (h x₀)⁻¹ a b| ≤ κ * ‖x - x₀‖) ∧
      (∀ m c a : Fin 2, |christoffel2 h m c a x| ≤ C₀) ∧ |gaussCurv2 h x| ≤ C₀ :=
by
  have hKc : IsCompact (Metric.closedBall x₀ ρ) := isCompact_closedBall x₀ ρ
  have hKv : Convex ℝ (Metric.closedBall x₀ ρ) := convex_closedBall x₀ ρ
  have hne : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  have h1le : (1 : WithTop ℕ∞) ≤ ∞ := by
    exact_mod_cast (le_top : (1 : ℕ∞) ≤ ⊤)
  
  have hGc : ContinuousOn
      (fun y => fun a b : Fin 2 => fderiv ℝ (fun z => (h z)⁻¹ a b) y)
      (Metric.closedBall x₀ ρ) := by
    refine continuousOn_pi.2 fun a => continuousOn_pi.2 fun b => ?_
    exact ((hinv a b).continuousOn_fderiv_of_isOpen hW h1le).mono hsub
  obtain ⟨κ', hκ'⟩ := hKc.exists_bound_of_continuousOn hGc
  
  have hΓc : ContinuousOn
      (fun y => fun m c a : Fin 2 => christoffel2 h m c a y) (Metric.closedBall x₀ ρ) := by
    refine continuousOn_pi.2 fun m => continuousOn_pi.2 fun c => continuousOn_pi.2 fun a => ?_
    exact (hΓ m c a).continuousOn.mono hsub
  obtain ⟨M, hM⟩ := hKc.exists_bound_of_continuousOn hΓc
  obtain ⟨MK, hMK⟩ := hKc.exists_bound_of_continuousOn (hK.mono hsub)
  refine ⟨max κ' 0, max (max M MK) 0, le_max_right _ _, le_max_right _ _, ?_⟩
  intro x hx
  refine ⟨fun a b => ?_, fun m c a => ?_, ?_⟩
  · have hdiff : ∀ y ∈ Metric.closedBall x₀ ρ,
        DifferentiableAt ℝ (fun z => (h z)⁻¹ a b) y := fun y hy =>
      ((hinv a b).differentiableOn hne).differentiableAt (hW.mem_nhds (hsub hy))
    have hbd : ∀ y ∈ Metric.closedBall x₀ ρ,
        ‖fderiv ℝ (fun z => (h z)⁻¹ a b) y‖ ≤ max κ' 0 := by
      intro y hy
      have h1 := hκ' y hy
      have h2 := norm_le_pi_norm (fun b : Fin 2 => fderiv ℝ (fun z => (h z)⁻¹ a b) y) b
      have h3 := norm_le_pi_norm (fun a b : Fin 2 => fderiv ℝ (fun z => (h z)⁻¹ a b) y) a
      exact le_trans h2 (le_trans h3 (le_trans h1 (le_max_left _ _)))
    have hρ : 0 ≤ ρ := le_trans dist_nonneg (Metric.mem_closedBall.mp hx)
    have hx₀ : x₀ ∈ Metric.closedBall x₀ ρ := Metric.mem_closedBall_self hρ
    have := hKv.norm_image_sub_le_of_norm_fderiv_le hdiff hbd hx₀ hx
    rwa [Real.norm_eq_abs] at this
  · have h1 := hM x hx
    have h2 := norm_le_pi_norm (fun m c a : Fin 2 => christoffel2 h m c a x) m
    have h3 := norm_le_pi_norm (fun c a : Fin 2 => christoffel2 h m c a x) c
    have h4 := norm_le_pi_norm (fun a : Fin 2 => christoffel2 h m c a x) a
    rw [Real.norm_eq_abs] at h4
    exact le_trans h4 (le_trans h3 (le_trans h2 (le_trans h1
      (le_trans (le_max_left _ _) (le_max_left _ _)))))
  · have h1 := hMK x hx
    rw [Real.norm_eq_abs] at h1
    exact le_trans h1 (le_trans (le_max_right _ _) (le_max_left _ _))

theorem pcgb_log_r0_derivs (A₀ : Matrix (Fin 2) (Fin 2) ℝ) (hA : A₀.PosDef) (x₀ : E2) :
    (∀ y : E2, y ≠ x₀ → 0 < ∑ a : Fin 2, ∑ c : Fin 2, A₀ a c * (y - x₀) a * (y - x₀) c) ∧
    ContDiffOn ℝ ∞ (fun y : E2 => Real.log (Real.sqrt
      (∑ a : Fin 2, ∑ c : Fin 2, A₀ a c * (y - x₀) a * (y - x₀) c))) {x₀}ᶜ ∧
    ∀ x : E2, x ≠ x₀ → ∀ a c : Fin 2,
      pd2 c (fun y : E2 => Real.log (Real.sqrt
        (∑ a : Fin 2, ∑ c : Fin 2, A₀ a c * (y - x₀) a * (y - x₀) c))) x =
        (∑ b : Fin 2, A₀ c b * (x - x₀) b) /
          (∑ a : Fin 2, ∑ c : Fin 2, A₀ a c * (x - x₀) a * (x - x₀) c) ∧
      pd2 c (pd2 a (fun y : E2 => Real.log (Real.sqrt
        (∑ a : Fin 2, ∑ c : Fin 2, A₀ a c * (y - x₀) a * (y - x₀) c)))) x =
        A₀ c a / (∑ a : Fin 2, ∑ c : Fin 2, A₀ a c * (x - x₀) a * (x - x₀) c) -
          2 * ((∑ b : Fin 2, A₀ c b * (x - x₀) b) /
            (∑ a : Fin 2, ∑ c : Fin 2, A₀ a c * (x - x₀) a * (x - x₀) c)) *
          ((∑ b : Fin 2, A₀ a b * (x - x₀) b) /
            (∑ a : Fin 2, ∑ c : Fin 2, A₀ a c * (x - x₀) a * (x - x₀) c)) :=
by
  have hsym : ∀ a c : Fin 2, A₀ a c = A₀ c a := fun a c => by
    have := hA.isHermitian.apply c a
    simpa using this
  
  have hpos : ∀ y : E2, y ≠ x₀ →
      0 < ∑ a : Fin 2, ∑ c : Fin 2, A₀ a c * (y - x₀) a * (y - x₀) c := by
    intro y hy
    have hne : (fun i : Fin 2 => (y - x₀) i) ≠ 0 := by
      intro h
      apply hy
      have h0 : y - x₀ = 0 := by
        ext i
        have := congrFun h i
        simpa using this
      exact sub_eq_zero.mp h0
    have h2 := hA.dotProduct_mulVec_pos hne
    have h3 : star (fun i : Fin 2 => (y - x₀) i) ⬝ᵥ A₀.mulVec (fun i : Fin 2 => (y - x₀) i) =
        ∑ a : Fin 2, ∑ c : Fin 2, A₀ a c * (y - x₀) a * (y - x₀) c := by
      simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_two, Pi.star_apply, star_trivial]
      ring
    linarith
  
  have hζ : ∀ (i : Fin 2) (y : E2), HasFDerivAt (fun y : E2 => (y - x₀) i)
      (PiLp.proj 2 (fun _ : Fin 2 => ℝ) i : E2 →L[ℝ] ℝ) y := by
    intro i y
    have h := (PiLp.hasFDerivAt_apply (𝕜 := ℝ) 2 y i).sub_const (x₀ i)
    convert h using 1
  have hζc : ∀ i : Fin 2, ContDiff ℝ ∞ (fun y : E2 => (y - x₀) i) := by
    intro i
    have h1 : ContDiff ℝ ∞ (fun y : E2 => y - x₀) := contDiff_id.sub contDiff_const
    first
      | exact (PiLp.proj 2 (fun _ : Fin 2 => ℝ) i : E2 →L[ℝ] ℝ).contDiff.comp h1
      | exact (contDiff_piLp_apply (𝕜 := ℝ) (p := 2) (i := i)).comp h1
      | fun_prop
  obtain ⟨Q, hQ⟩ : ∃ Q : E2 → ℝ,
      Q = fun y => ∑ a : Fin 2, ∑ c : Fin 2, A₀ a c * (y - x₀) a * (y - x₀) c := ⟨_, rfl⟩
  obtain ⟨N, hN⟩ : ∃ N : Fin 2 → E2 → ℝ,
      N = fun a y => ∑ b : Fin 2, A₀ a b * (y - x₀) b := ⟨_, rfl⟩
  have hposQ : ∀ y : E2, y ≠ x₀ → 0 < Q y := by
    rw [hQ]; exact hpos
  have hQd : ∀ y : E2, HasFDerivAt Q
      (∑ a : Fin 2, ∑ c : Fin 2, ((A₀ a c * (y - x₀) a) •
        (PiLp.proj 2 (fun _ : Fin 2 => ℝ) c : E2 →L[ℝ] ℝ) +
        (y - x₀) c • (A₀ a c • (PiLp.proj 2 (fun _ : Fin 2 => ℝ) a : E2 →L[ℝ] ℝ)))) y := by
    intro y
    rw [hQ]
    have h := HasFDerivAt.sum (u := Finset.univ) (fun a _ => HasFDerivAt.sum
      (u := Finset.univ) (fun c _ => ((hζ a y).const_mul (A₀ a c)).mul (hζ c y)))
    convert h using 1
  have hNd : ∀ (a : Fin 2) (y : E2), HasFDerivAt (N a)
      (∑ b : Fin 2, A₀ a b • (PiLp.proj 2 (fun _ : Fin 2 => ℝ) b : E2 →L[ℝ] ℝ)) y := by
    intro a y
    rw [hN]
    show HasFDerivAt (fun y : E2 => ∑ b : Fin 2, A₀ a b * (y - x₀) b) _ y
    have h := HasFDerivAt.sum (u := Finset.univ) (fun b _ => (hζ b y).const_mul (A₀ a b))
    convert h using 1
  have hQc : ContDiff ℝ ∞ Q := by
    rw [hQ]
    exact ContDiff.sum (fun a _ => ContDiff.sum (fun c _ =>
      (contDiff_const.mul (hζc a)).mul (hζc c)))
  have h10 := hsym 1 0
  have hQpd : ∀ (y : E2) (k : Fin 2), fderiv ℝ Q y (e2 k) = 2 * N k y := by
    intro y k
    rw [(hQd y).fderiv, hN]
    fin_cases k <;>
      simp [e2, EuclideanSpace.single_apply, Fin.sum_univ_two, ContinuousLinearMap.sum_apply,
        h10] <;> ring
  have hNpd : ∀ (y : E2) (a k : Fin 2), fderiv ℝ (N a) y (e2 k) = A₀ a k := by
    intro y a k
    rw [(hNd a y).fderiv]
    fin_cases k <;>
      simp [e2, EuclideanSpace.single_apply, Fin.sum_univ_two, ContinuousLinearMap.sum_apply]
  have hU : IsOpen ({x₀}ᶜ : Set E2) := isOpen_compl_singleton
  have hev : ∀ y : E2, y ≠ x₀ → (fun z => Real.log (Real.sqrt (Q z))) =ᶠ[nhds y]
      (fun z => (1 / 2 : ℝ) * Real.log (Q z)) := by
    intro y hy
    filter_upwards [hU.mem_nhds hy] with z hz
    rw [Real.log_sqrt (hposQ z hz).le]
    ring
  have hsmooth : ContDiffOn ℝ ∞ (fun y => Real.log (Real.sqrt (Q y))) {x₀}ᶜ := by
    have hs : ContDiffOn ℝ ∞ (fun y => Real.log (Q y) / 2) {x₀}ᶜ :=
      (hQc.contDiffOn.log (fun y hy => (hposQ y hy).ne')).div_const 2
    refine hs.congr ?_
    intro y hy
    exact Real.log_sqrt (hposQ y hy).le
  have hd1 : ∀ y : E2, y ≠ x₀ → ∀ k : Fin 2,
      pd2 k (fun y => Real.log (Real.sqrt (Q y))) y = N k y / Q y := by
    intro y hy k
    have hQ0 := (hposQ y hy).ne'
    have h := ((((hQd y).differentiableAt.hasFDerivAt).log hQ0).const_mul
      (1 / 2 : ℝ)).congr_of_eventuallyEq (hev y hy)
    show fderiv ℝ (fun y => Real.log (Real.sqrt (Q y))) y (e2 k) = _
    rw [h.fderiv]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    rw [hQpd y k]
    field_simp
  have hd2 : ∀ x : E2, x ≠ x₀ → ∀ a c : Fin 2,
      pd2 c (pd2 a (fun y => Real.log (Real.sqrt (Q y)))) x =
        A₀ c a / Q x - 2 * (N c x / Q x) * (N a x / Q x) := by
    intro x hx a c
    have hev2 : pd2 a (fun y => Real.log (Real.sqrt (Q y))) =ᶠ[nhds x]
        fun y => N a y / Q y := by
      filter_upwards [hU.mem_nhds hx] with z hz
      exact hd1 z hz a
    show fderiv ℝ (pd2 a (fun y => Real.log (Real.sqrt (Q y)))) x (e2 c) = _
    rw [hev2.fderiv_eq]
    have hQ0 := (hposQ x hx).ne'
    have hQx : HasFDerivAt Q (fderiv ℝ Q x) x := (hQd x).differentiableAt.hasFDerivAt
    have hNx : HasFDerivAt (N a) (fderiv ℝ (N a) x) x :=
      (hNd a x).differentiableAt.hasFDerivAt
    have hinv : HasFDerivAt (fun y => (Q y)⁻¹) ((-(Q x ^ 2)⁻¹) • fderiv ℝ Q x) x :=
      (hasDerivAt_inv hQ0).comp_hasFDerivAt x hQx
    have hprod : HasFDerivAt (fun y => N a y / Q y)
        (N a x • ((-(Q x ^ 2)⁻¹) • fderiv ℝ Q x) + (Q x)⁻¹ • fderiv ℝ (N a) x) x := by
      have := hNx.mul hinv
      simpa only [div_eq_mul_inv] using this
    rw [hprod.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    rw [hQpd x c, hNpd x a c, hsym a c]
    field_simp
    ring
  have key : (∀ y : E2, y ≠ x₀ → 0 < Q y) ∧
      ContDiffOn ℝ ∞ (fun y => Real.log (Real.sqrt (Q y))) {x₀}ᶜ ∧
      ∀ x : E2, x ≠ x₀ → ∀ a c : Fin 2,
        pd2 c (fun y => Real.log (Real.sqrt (Q y))) x = N c x / Q x ∧
        pd2 c (pd2 a (fun y => Real.log (Real.sqrt (Q y)))) x =
          A₀ c a / Q x - 2 * (N c x / Q x) * (N a x / Q x) :=
    ⟨hposQ, hsmooth, fun x hx a c => ⟨hd1 x hx c, hd2 x hx a c⟩⟩
  subst hQ hN
  exact key

theorem pcgb_pole_bounds {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (b : X → ℝ) (Gd : PcgbGreenData P b)
    (hkato : ∀ (W : Set E2), IsOpen W → ∀ (h : E2 → Matrix (Fin 2) (Fin 2) ℝ),
      (∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) → (∀ x ∈ W, (h x).PosDef) →
      ∀ (w : E2 → ℝ), ContDiffOn ℝ ∞ w W → (∀ x ∈ W, lap2 h w x = 0) →
      ∀ (ε : ℝ), 0 < ε → ∀ x ∈ W,
      lap2 h (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y + ε)) x =
        gaussCurv2 h x * sgbGradSq2 h w x / (sgbGradSq2 h w x + ε) +
        ε * (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2, (h x)⁻¹ a c * (h x)⁻¹ b d *
             (pd2 a (pd2 b w) x - ∑ k : Fin 2, christoffel2 h k a b x * pd2 k w x) *
             (pd2 c (pd2 d w) x - ∑ k : Fin 2, christoffel2 h k c d x * pd2 k w x)) /
          (sgbGradSq2 h w x + ε) ^ 2) :
    ∃ r₁ : ℝ, 0 < r₁ ∧ r₁ ≤ Gd.r ∧ ∀ ε : ℝ, 0 < ε → ∃ C : ℝ,
      ∀ x ∈ Metric.ball Gd.x₀ r₁, x ≠ Gd.x₀ →
        ‖fderiv ℝ (fun y => (1 / 2 : ℝ) * Real.log
            (sgbGradSq2 (P.h Gd.j₀) (fun z => Gd.w (P.param Gd.j₀ z)) y + ε) +
            Real.log (pcgbPoleRad P Gd.j₀ Gd.x₀ y)) x‖ ≤ C ∧
        |lap2 (P.h Gd.j₀) (fun y => (1 / 2 : ℝ) * Real.log
            (sgbGradSq2 (P.h Gd.j₀) (fun z => Gd.w (P.param Gd.j₀ z)) y + ε)) x| ≤ C :=
by
  classical
  set h : E2 → Matrix (Fin 2) (Fin 2) ℝ := P.h Gd.j₀ with hhdef
  set w : E2 → ℝ := fun z => Gd.w (P.param Gd.j₀ z) with hwdef
  have hWo : IsOpen (P.W Gd.j₀) := P.W_open Gd.j₀
  have hhs : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) (P.W Gd.j₀) := P.h_smooth Gd.j₀
  have hpd : ∀ x ∈ P.W Gd.j₀, (h x).PosDef := P.h_posDef Gd.j₀
  have hsym : ∀ x ∈ P.W Gd.j₀, ∀ i j : Fin 2, h x i j = h x j i := by
    intro x hx i j
    have h1 := (hpd x hx).isHermitian.apply i j
    rw [star_trivial] at h1
    exact h1.symm
  obtain ⟨hinv, -, hΓs, -, -, -⟩ := gs2_metric_calculus h (P.W Gd.j₀) hWo hhs hsym hpd
  have hKc : ContinuousOn (gaussCurv2 h) (P.W Gd.j₀) := gaussCurv2_continuousOn h _ hWo hhs hpd
  obtain ⟨κ, C₀M, hκ, hC₀M, hMB⟩ :=
    pcgb_pole_metric_bounds h (P.W Gd.j₀) hWo hinv hΓs hKc Gd.x₀ Gd.r Gd.ball_sub
  have hx₀W : Gd.x₀ ∈ P.W Gd.j₀ := Gd.ball_sub (Metric.mem_closedBall_self Gd.r_pos.le)
  have hC₀ : 0 ≤ max C₀M Gd.C := le_max_of_le_right Gd.C_nonneg
  obtain ⟨δ, K, hδ, hK, hAlg⟩ :=
    pcgb_pole_algebra (h Gd.x₀) (hpd Gd.x₀ hx₀W) κ (max C₀M Gd.C) hκ hC₀
  obtain ⟨hqpos, hℓs, hℓd⟩ := pcgb_log_r0_derivs (h Gd.x₀) (hpd Gd.x₀ hx₀W) Gd.x₀
  set ℓ : E2 → ℝ := fun y => Real.log (Real.sqrt
      (∑ a : Fin 2, ∑ c : Fin 2, h Gd.x₀ a c * (y - Gd.x₀) a * (y - Gd.x₀) c)) with hℓdef
  have hu_eq : ∀ y : E2, y ≠ Gd.x₀ → ∀ c : Fin 2, pd2 c ℓ y =
      (∑ b : Fin 2, h Gd.x₀ c b * (y - Gd.x₀) b) /
        (∑ a : Fin 2, ∑ c : Fin 2, h Gd.x₀ a c * (y - Gd.x₀) a * (y - Gd.x₀) c) :=
    fun y hy c => (hℓd y hy c c).1
  
  have hsc1 : ∀ (ε G N u : ℝ), 0 < ε → 0 < G → |N + u * G| ≤ K * G → |u| ≤ K * G →
      |N / (G + ε) + u| ≤ K * (1 + ε) := by
    intro ε G N u hε hG h1 h2
    have hQ : 0 < G + ε := by linarith
    have heq : N / (G + ε) + u = (N + u * G + ε * u) / (G + ε) := by
      rw [div_add' _ _ _ hQ.ne']
      congr 1
      ring
    rw [heq, abs_div, abs_of_pos hQ, div_le_iff₀ hQ]
    have t : |N + u * G + ε * u| ≤ |N + u * G| + ε * |u| := by
      calc |N + u * G + ε * u| ≤ |N + u * G| + |ε * u| := abs_add_le _ _
        _ = |N + u * G| + ε * |u| := by rw [abs_mul, abs_of_pos hε]
    have hKG : 0 ≤ K * G := mul_nonneg hK hG.le
    nlinarith [mul_nonneg (mul_nonneg hK (by linarith : (0:ℝ) ≤ 1 + ε)) hε.le,
      mul_le_mul_of_nonneg_left h2 hε.le]
  have hsc2 : ∀ (ε G Kg HS : ℝ), 0 < ε → 0 < G → |Kg| ≤ max C₀M Gd.C → |HS| ≤ K * G ^ 2 →
      |Kg * G / (G + ε) + ε * HS / (G + ε) ^ 2| ≤ max C₀M Gd.C + ε * K := by
    intro ε G Kg HS hε hG h1 h2
    have hQ : 0 < G + ε := by linarith
    have hr : G / (G + ε) ≤ 1 := (div_le_one hQ).mpr (by linarith)
    have hr0 : 0 ≤ G / (G + ε) := div_nonneg hG.le hQ.le
    have t1 : |Kg * G / (G + ε)| ≤ max C₀M Gd.C := by
      rw [mul_div_assoc, abs_mul, abs_of_nonneg hr0]
      calc |Kg| * (G / (G + ε)) ≤ max C₀M Gd.C * 1 :=
            mul_le_mul h1 hr hr0 (le_trans (abs_nonneg _) h1)
        _ = max C₀M Gd.C := mul_one _
    have hQ2 : 0 < (G + ε) ^ 2 := by positivity
    have t2 : |ε * HS / (G + ε) ^ 2| ≤ ε * K := by
      rw [abs_div, abs_mul, abs_of_pos hε, abs_of_pos hQ2, div_le_iff₀ hQ2]
      have hG2 : G ^ 2 ≤ (G + ε) ^ 2 := by nlinarith
      calc ε * |HS| ≤ ε * (K * G ^ 2) := mul_le_mul_of_nonneg_left h2 hε.le
        _ = (ε * K) * G ^ 2 := by ring
        _ ≤ (ε * K) * (G + ε) ^ 2 := mul_le_mul_of_nonneg_left hG2 (mul_nonneg hε.le hK)
    calc |Kg * G / (G + ε) + ε * HS / (G + ε) ^ 2|
        ≤ |Kg * G / (G + ε)| + |ε * HS / (G + ε) ^ 2| := abs_add_le _ _
      _ ≤ max C₀M Gd.C + ε * K := add_le_add t1 t2
  
  have hnorm2 : ∀ D : E2 →L[ℝ] ℝ, ‖D‖ ≤ |D (e2 0)| + |D (e2 1)| := by
    intro D
    refine ContinuousLinearMap.opNorm_le_bound _ (by positivity) (fun v => ?_)
    have hv : v = v 0 • e2 0 + v 1 • e2 1 := by
      ext i; fin_cases i <;> simp [EuclideanSpace.single_apply]
    have h0 : |v 0| ≤ ‖v‖ := by simpa [Real.norm_eq_abs] using PiLp.norm_apply_le v 0
    have h1 : |v 1| ≤ ‖v‖ := by simpa [Real.norm_eq_abs] using PiLp.norm_apply_le v 1
    have hDv : D v = v 0 * D (e2 0) + v 1 * D (e2 1) := by
      conv_lhs => rw [hv]
      simp [map_add, map_smul, smul_eq_mul]
    rw [Real.norm_eq_abs, hDv]
    calc |v 0 * D (e2 0) + v 1 * D (e2 1)| ≤ |v 0| * |D (e2 0)| + |v 1| * |D (e2 1)| := by
          rw [← abs_mul, ← abs_mul]; exact abs_add_le _ _
      _ ≤ ‖v‖ * |D (e2 0)| + ‖v‖ * |D (e2 1)| := by gcongr
      _ = (|D (e2 0)| + |D (e2 1)|) * ‖v‖ := by ring
  refine ⟨min Gd.r δ, lt_min Gd.r_pos hδ, min_le_left _ _, ?_⟩
  intro ε hε
  refine ⟨max (2 * (K * (1 + ε))) (max C₀M Gd.C + ε * K), ?_⟩
  intro x hx hxne
  
  set O : Set E2 := Metric.ball Gd.x₀ Gd.r ∩ {Gd.x₀}ᶜ with hOdef
  have hOo : IsOpen O := Metric.isOpen_ball.inter isOpen_compl_singleton
  have hOW : O ⊆ P.W Gd.j₀ := fun y hy => Gd.ball_sub (Metric.ball_subset_closedBall hy.1)
  have hOgood : ∀ y ∈ O, y ∈ P.W Gd.j₀ ∩ P.param Gd.j₀ ⁻¹' (Gd.U \ {Gd.p₀}) ∧
      0 ≤ b (P.param Gd.j₀ y) ∧ P.param Gd.j₀ y ≠ Gd.p₀ := by
    intro y hy
    have hyW : y ∈ P.W Gd.j₀ := hOW hy
    have hyS : P.param Gd.j₀ y ∈ S := by
      have h1 : P.param Gd.j₀ y ∈ P.param Gd.j₀ '' P.W Gd.j₀ := Set.mem_image_of_mem _ hyW
      rw [P.image_eq Gd.j₀] at h1
      exact h1.2
    have hb : 0 ≤ b (P.param Gd.j₀ y) := by
      have h1 := Gd.ball_pos y (Metric.ball_subset_closedBall hy.1)
      have h2 := Gd.r_pos
      linarith
    have hne : P.param Gd.j₀ y ≠ Gd.p₀ := by
      intro heq
      have h1 := P.proj_param Gd.j₀ y hyW
      rw [heq, ← Gd.param_x₀, P.proj_param Gd.j₀ Gd.x₀ hx₀W] at h1
      exact hy.2 (Set.mem_singleton_iff.mpr h1.symm)
    exact ⟨⟨hyW, Gd.R_sub ⟨hyS, hb⟩, hne⟩, hb, hne⟩
  have hws : ContDiffOn ℝ ∞ w O := (Gd.smooth Gd.j₀).mono (fun y hy => (hOgood y hy).1)
  have hwharm : ∀ y ∈ O, lap2 h w y = 0 :=
    fun y hy => Gd.harm Gd.j₀ y (hOW hy) (hOgood y hy).2.1 (hOgood y hy).2.2
  have hxball : x ∈ Metric.ball Gd.x₀ Gd.r := Metric.ball_subset_ball (min_le_left _ _) hx
  have hxO : x ∈ O := ⟨hxball, hxne⟩
  have hxcl : x ∈ Metric.closedBall Gd.x₀ Gd.r := Metric.ball_subset_closedBall hxball
  
  have hne : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  have hℓO : ContDiffOn ℝ ∞ ℓ O := hℓs.mono (fun y hy => hy.2)
  set v : E2 → ℝ := fun y => w y - ℓ y with hvdef
  have hvO : ContDiffOn ℝ ∞ v O := hws.sub hℓO
  have hdiff : ∀ (f : E2 → ℝ), ContDiffOn ℝ ∞ f O → ∀ y ∈ O, DifferentiableAt ℝ f y :=
    fun f hf y hy => (hf.contDiffAt (hOo.mem_nhds hy)).differentiableAt hne
  have hpdO : ∀ (f : E2 → ℝ), ContDiffOn ℝ ∞ f O → ∀ a : Fin 2, ContDiffOn ℝ ∞ (pd2 a f) O :=
    fun f hf a => (hf.fderiv_of_isOpen hOo le_rfl).clm_apply contDiffOn_const
  have hsplit1 : ∀ y ∈ O, ∀ a : Fin 2, pd2 a w y = pd2 a ℓ y + pd2 a v y := by
    intro y hy a
    have h1 : fderiv ℝ v y = fderiv ℝ w y - fderiv ℝ ℓ y :=
      fderiv_sub (hdiff w hws y hy) (hdiff ℓ hℓO y hy)
    show fderiv ℝ w y (e2 a) = fderiv ℝ ℓ y (e2 a) + fderiv ℝ v y (e2 a)
    rw [h1, ContinuousLinearMap.sub_apply]
    ring
  have hsplit2 : ∀ a c : Fin 2, pd2 c (pd2 a w) x = pd2 c (pd2 a ℓ) x + pd2 c (pd2 a v) x := by
    intro a c
    have hev : pd2 a w =ᶠ[𝓝 x] fun y => pd2 a ℓ y + pd2 a v y :=
      Filter.eventually_of_mem (hOo.mem_nhds hxO) (fun y hy => hsplit1 y hy a)
    have h1 : fderiv ℝ (pd2 a w) x = fderiv ℝ (pd2 a ℓ) x + fderiv ℝ (pd2 a v) x := by
      rw [hev.fderiv_eq]
      exact fderiv_add (hdiff _ (hpdO ℓ hℓO a) x hxO) (hdiff _ (hpdO v hvO a) x hxO)
    show fderiv ℝ (pd2 a w) x (e2 c) = fderiv ℝ (pd2 a ℓ) x (e2 c) + fderiv ℝ (pd2 a v) x (e2 c)
    rw [h1, ContinuousLinearMap.add_apply]
  have he2 : ∀ a : Fin 2, ‖e2 a‖ = 1 := fun a => by simp [EuclideanSpace.norm_single]
  have hv1b : ∀ a : Fin 2, |pd2 a v x| ≤ ‖fderiv ℝ v x‖ := by
    intro a
    have h1 := (fderiv ℝ v x).le_opNorm (e2 a)
    rw [he2, mul_one, Real.norm_eq_abs] at h1
    exact h1
  have hv2b : ∀ a c : Fin 2, |pd2 c (pd2 a v) x| ≤ ‖fderiv ℝ (fderiv ℝ v) x‖ := by
    intro a c
    have hD : DifferentiableAt ℝ (fderiv ℝ v) x :=
      ((hvO.fderiv_of_isOpen hOo le_rfl).contDiffAt (hOo.mem_nhds hxO)).differentiableAt hne
    have heq : pd2 c (pd2 a v) x = fderiv ℝ (fderiv ℝ v) x (e2 c) (e2 a) := by
      have hF := hD.hasFDerivAt.clm_apply (hasFDerivAt_const (e2 a) x)
      show fderiv ℝ (fun y => fderiv ℝ v y (e2 a)) x (e2 c) = _
      rw [hF.fderiv]
      simp
    rw [heq]
    have h1 := (fderiv ℝ (fderiv ℝ v) x).le_opNorm₂ (e2 c) (e2 a)
    rw [he2, he2, mul_one, mul_one, Real.norm_eq_abs] at h1
    exact h1
  
  obtain ⟨-, hp1, hp2⟩ := Gd.pole x hxball hxne
  have hp1' : ‖fderiv ℝ v x‖ ≤ Gd.C := hp1
  have hp2' : ‖fderiv ℝ (fderiv ℝ v) x‖ ≤ Gd.C / Real.sqrt
      (∑ a : Fin 2, ∑ c : Fin 2, h Gd.x₀ a c * (x - Gd.x₀) a * (x - Gd.x₀) c) := hp2
  
  have hs0 : 0 < ‖x - Gd.x₀‖ := norm_pos_iff.mpr (sub_ne_zero.mpr hxne)
  have hsδ : ‖x - Gd.x₀‖ ≤ δ := by
    have h1 : dist x Gd.x₀ < min Gd.r δ := hx
    rw [dist_eq_norm] at h1
    exact le_of_lt (lt_of_lt_of_le h1 (min_le_right _ _))
  have hz : (x - Gd.x₀) 0 ^ 2 + (x - Gd.x₀) 1 ^ 2 = ‖x - Gd.x₀‖ ^ 2 := by
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_two]
    simp [Real.norm_eq_abs, sq_abs]
  have hpb : ∀ a : Fin 2, |pd2 a w x - pd2 a ℓ x| ≤ max C₀M Gd.C := by
    intro a
    rw [hsplit1 x hxO a, add_sub_cancel_left]
    exact le_trans (hv1b a) (le_trans hp1' (le_max_right _ _))
  have hHb : ∀ c a : Fin 2,
      |(pd2 c (pd2 a w) x - ∑ m : Fin 2, christoffel2 h m c a x * pd2 m w x) +
          ∑ m : Fin 2, christoffel2 h m c a x * pd2 m w x -
        (h Gd.x₀ c a / (∑ i : Fin 2, ∑ j : Fin 2, h Gd.x₀ i j * (x - Gd.x₀) i * (x - Gd.x₀) j) -
          2 * pd2 c ℓ x * pd2 a ℓ x)| ≤
      max C₀M Gd.C /
        Real.sqrt (∑ i : Fin 2, ∑ j : Fin 2, h Gd.x₀ i j * (x - Gd.x₀) i * (x - Gd.x₀) j) := by
    intro c a
    have e1 : (pd2 c (pd2 a w) x - ∑ m : Fin 2, christoffel2 h m c a x * pd2 m w x) +
          ∑ m : Fin 2, christoffel2 h m c a x * pd2 m w x -
        (h Gd.x₀ c a / (∑ i : Fin 2, ∑ j : Fin 2, h Gd.x₀ i j * (x - Gd.x₀) i * (x - Gd.x₀) j) -
          2 * pd2 c ℓ x * pd2 a ℓ x) = pd2 c (pd2 a v) x := by
      rw [hsplit2 a c, (hℓd x hxne a c).2, hu_eq x hxne c, hu_eq x hxne a]
      ring
    rw [e1]
    refine le_trans (hv2b a c) (le_trans hp2' ?_)
    exact div_le_div_of_nonneg_right (le_max_right _ _) (Real.sqrt_nonneg _)
  obtain ⟨hGpos, hNb, hHSb, hub⟩ := hAlg (fun i => (x - Gd.x₀) i) ‖x - Gd.x₀‖ hs0 hsδ hz (h x)⁻¹
    (fun c => pd2 c ℓ x) (fun a => pd2 a w x)
    (fun c a => pd2 c (pd2 a w) x - ∑ m : Fin 2, christoffel2 h m c a x * pd2 m w x)
    (fun m c a => christoffel2 h m c a x)
    (fun a b => (hMB x hxcl).1 a b) (fun c => hu_eq x hxne c) hpb hHb
    (fun m c a => le_trans ((hMB x hxcl).2.1 m c a) (le_max_left _ _))
  have hGpos' : 0 < sgbGradSq2 h w x := hGpos
  
  have hGO : ContDiffOn ℝ ∞ (sgbGradSq2 h w) O := by
    have h1 : ContDiffOn ℝ ∞
        (fun y => ∑ a : Fin 2, ∑ c : Fin 2, (h y)⁻¹ a c * pd2 a w y * pd2 c w y) O :=
      ContDiffOn.sum (fun a _ => ContDiffOn.sum (fun c _ =>
        (((hinv a c).mono hOW).mul (hpdO w hws a)).mul (hpdO w hws c)))
    exact h1
  have hGd : DifferentiableAt ℝ (sgbGradSq2 h w) x := hdiff _ hGO x hxO
  have hgrad : ∀ c : Fin 2, fderiv ℝ (sgbGradSq2 h w) x (e2 c) =
      2 * ∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b *
        (pd2 c (pd2 a w) x - ∑ m : Fin 2, christoffel2 h m c a x * pd2 m w x) * pd2 b w x := by
    intro c
    exact bl2_grad_Q O hOo h (fun a b => (hhs a b).mono hOW) (fun y hy => hpd y (hOW hy)) w hws
      x hxO c
  have hGε : 0 < sgbGradSq2 h w x + ε := by linarith
  have hL : HasFDerivAt (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y + ε))
      ((1 / 2 : ℝ) • ((sgbGradSq2 h w x + ε)⁻¹ • fderiv ℝ (sgbGradSq2 h w) x)) x :=
    ((hGd.hasFDerivAt.add_const ε).log hGε.ne').const_mul (1 / 2 : ℝ)
  have hℓx : HasFDerivAt ℓ (fderiv ℝ ℓ x) x := (hdiff ℓ hℓO x hxO).hasFDerivAt
  have hF : HasFDerivAt (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y + ε) +
      Real.log (pcgbPoleRad P Gd.j₀ Gd.x₀ y))
      ((1 / 2 : ℝ) • ((sgbGradSq2 h w x + ε)⁻¹ • fderiv ℝ (sgbGradSq2 h w) x) +
        fderiv ℝ ℓ x) x :=
    hL.add hℓx
  have hcb : ∀ c : Fin 2, |((1 / 2 : ℝ) • ((sgbGradSq2 h w x + ε)⁻¹ •
      fderiv ℝ (sgbGradSq2 h w) x) + fderiv ℝ ℓ x) (e2 c)| ≤ K * (1 + ε) := by
    intro c
    have hcomp : ((1 / 2 : ℝ) • ((sgbGradSq2 h w x + ε)⁻¹ • fderiv ℝ (sgbGradSq2 h w) x) +
        fderiv ℝ ℓ x) (e2 c) =
        (∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b *
          (pd2 c (pd2 a w) x - ∑ m : Fin 2, christoffel2 h m c a x * pd2 m w x) * pd2 b w x) /
          (sgbGradSq2 h w x + ε) + pd2 c ℓ x := by
      rw [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
        ContinuousLinearMap.smul_apply, hgrad c, smul_eq_mul, smul_eq_mul]
      have h1 : pd2 c ℓ x = fderiv ℝ ℓ x (e2 c) := rfl
      rw [h1, div_eq_mul_inv]
      ring
    rw [hcomp]
    exact hsc1 ε (sgbGradSq2 h w x)
      (∑ a : Fin 2, ∑ b : Fin 2, (h x)⁻¹ a b *
        (pd2 c (pd2 a w) x - ∑ m : Fin 2, christoffel2 h m c a x * pd2 m w x) * pd2 b w x)
      (pd2 c ℓ x) hε hGpos' (hNb c) (hub c)
  have hfin1 : ‖fderiv ℝ (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y + ε) +
      Real.log (pcgbPoleRad P Gd.j₀ Gd.x₀ y)) x‖ ≤
      max (2 * (K * (1 + ε))) (max C₀M Gd.C + ε * K) := by
    rw [hF.fderiv]
    refine le_trans (hnorm2 _) ?_
    refine le_trans ?_ (le_max_left _ _)
    have h0 := hcb 0
    have h1 := hcb 1
    linarith
  
  have hlap := hkato O hOo h (fun a b => (hhs a b).mono hOW) (fun y hy => hpd y (hOW hy)) w hws
    hwharm ε hε x hxO
  have hfin2 : |lap2 h (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y + ε)) x| ≤
      max (2 * (K * (1 + ε))) (max C₀M Gd.C + ε * K) := by
    rw [hlap]
    exact le_trans (hsc2 ε _ _ _ hε hGpos' (le_trans (hMB x hxcl).2.2 (le_max_left _ _)) hHSb)
      (le_max_right _ _)
  exact ⟨hfin1, hfin2⟩

theorem pcgb_collar_integrable {X : Type*} [TopologicalSpace X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (hreg : ∀ j, ∀ x ∈ P.W j, b (P.param j x) = 0 →
      fderiv ℝ (fun y => b (P.param j y)) x ≠ 0) :
    ∃ sG : ℝ, 0 < sG ∧ ∀ s : ℝ, 0 < s → s < sG → ∀ j,
      MeasureTheory.IntegrableOn (fun x => ρ j (P.param j x) *
        (s⁻¹ * deriv Real.smoothTransition (b (P.param j x) / s) *
          Real.sqrt (sgbGradSq2 (P.h j) (fun y => b (P.param j y)) x) *
          sgbLevelCurv2 (P.h j) (fun y => b (P.param j y)) x) *
        Real.sqrt (P.h j x).det) (P.W j) :=
by
  have h1inf : (1 : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
  have h2inf : (2 : WithTop ℕ∞) ≤ ∞ := WithTop.coe_le_coe.mpr le_top
  
  have hdens : ∀ (W : Set E2), IsOpen W → ∀ (h : E2 → Matrix (Fin 2) (Fin 2) ℝ),
      (∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) → (∀ x ∈ W, (h x).PosDef) →
      ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f W →
      ContinuousOn (fun x => sgbLevelCurv2 h f x) {x | x ∈ W ∧ fderiv ℝ f x ≠ 0} ∧
      ContinuousOn (fun x => Real.sqrt (sgbGradSq2 h f x)) W ∧
      ContinuousOn (fun x => Real.sqrt (h x).det) W := by
    intro W hW h hh hpos f hf
    have hh1 : ∀ a c, ContDiffOn ℝ 1 (fun x => h x a c) W := fun a c => (hh a c).of_le h1inf
    have hdetEq : (fun x => (h x).det) = fun x => h x 0 0 * h x 1 1 - h x 0 1 * h x 1 0 := by
      funext x; exact Matrix.det_fin_two (h x)
    have hdet1 : ContDiffOn ℝ 1 (fun x => (h x).det) W := by
      rw [hdetEq]; exact ((hh1 0 0).mul (hh1 1 1)).sub ((hh1 0 1).mul (hh1 1 0))
    have hdetpos : ∀ x ∈ W, 0 < (h x).det := fun x hx => (hpos x hx).det_pos
    have hsd1 : ContDiffOn ℝ 1 (fun x => Real.sqrt (h x).det) W :=
      hdet1.sqrt (fun x hx => (hdetpos x hx).ne')
    have hsdpos : ∀ x ∈ W, 0 < Real.sqrt (h x).det := fun x hx => Real.sqrt_pos.mpr (hdetpos x hx)
    have hinv1 : ∀ a c : Fin 2, ContDiffOn ℝ 1 (fun x => (h x)⁻¹ a c) W := by
      intro a c
      have heq : (fun x => (h x)⁻¹ a c) = fun x => ((h x).det)⁻¹ *
          (!![h x 1 1, -h x 0 1; -h x 1 0, h x 0 0] : Matrix (Fin 2) (Fin 2) ℝ) a c := by
        funext x
        rw [Matrix.inv_def, Matrix.adjugate_fin_two, Matrix.smul_apply, smul_eq_mul,
          Ring.inverse_eq_inv']
      rw [heq]
      refine (hdet1.inv (fun x hx => (hdetpos x hx).ne')).mul ?_
      fin_cases a <;> fin_cases c
      · simpa using (hh1 1 1)
      · simpa using (hh1 0 1).neg
      · simpa using (hh1 1 0).neg
      · simpa using (hh1 0 0)
    have hf2 : ContDiffOn ℝ 2 f W := hf.of_le h2inf
    have hdf : ContDiffOn ℝ 1 (fderiv ℝ f) W := hf2.fderiv_of_isOpen hW (by norm_num)
    have hpd1 : ∀ a : Fin 2, ContDiffOn ℝ 1 (fun x => pd2 a f x) W := fun a =>
      hdf.clm_apply contDiffOn_const
    have hG1 : ContDiffOn ℝ 1 (fun x => sgbGradSq2 h f x) W := by
      unfold sgbGradSq2
      exact ContDiffOn.sum (fun a _ => ContDiffOn.sum (fun c _ =>
        ((hinv1 a c).mul (hpd1 a)).mul (hpd1 c)))
    refine ⟨?_, hG1.continuousOn.sqrt, hsd1.continuousOn⟩
    
    set V := {x | x ∈ W ∧ fderiv ℝ f x ≠ 0} with hVdef
    have hVeq : V = W ∩ (fderiv ℝ f) ⁻¹' {0}ᶜ := rfl
    have hVo : IsOpen V := by
      rw [hVeq]
      exact (hf.continuousOn_fderiv_of_isOpen hW h1inf).isOpen_inter_preimage hW
        isOpen_compl_singleton
    have hVW : V ⊆ W := fun x hx => hx.1
    have hGpos : ∀ x ∈ V, 0 < sgbGradSq2 h f x := by
      intro x hx
      set v : Fin 2 → ℝ := fun a => pd2 a f x with hv
      have hv0 : v ≠ 0 := by
        intro hv0
        apply hx.2
        have h0 : fderiv ℝ f x (e2 0) = 0 := congrFun hv0 0
        have h1 : fderiv ℝ f x (e2 1) = 0 := congrFun hv0 1
        ext1 z
        have hz : z = z 0 • e2 0 + z 1 • e2 1 := by
          ext i; fin_cases i <;> simp [EuclideanSpace.single_apply]
        rw [hz, map_add, map_smul, map_smul, h0, h1]
        simp
      have hp := (hpos x (hVW hx)).inv.dotProduct_mulVec_pos hv0
      have heq : star v ⬝ᵥ (h x)⁻¹.mulVec v = sgbGradSq2 h f x := by
        simp only [star_trivial, dotProduct, Matrix.mulVec, sgbGradSq2, Fin.sum_univ_two, hv]
        ring
      rw [← heq]; exact hp
    
    set Y : Fin 2 → E2 → ℝ := fun i y => Real.sqrt (h y).det *
      (∑ a : Fin 2, (h y)⁻¹ i a * pd2 a f y) / Real.sqrt (sgbGradSq2 h f y) with hYdef
    have hY1 : ∀ i, ContDiffOn ℝ 1 (Y i) V := by
      intro i
      have hnum : ContDiffOn ℝ 1 (fun y => Real.sqrt (h y).det *
          (∑ a : Fin 2, (h y)⁻¹ i a * pd2 a f y)) V :=
        (hsd1.mul (ContDiffOn.sum (fun a _ => (hinv1 i a).mul (hpd1 a)))).mono hVW
      have hden : ContDiffOn ℝ 1 (fun y => Real.sqrt (sgbGradSq2 h f y)) V :=
        (hG1.mono hVW).sqrt (fun y hy => (hGpos y hy).ne')
      exact hnum.div hden (fun y hy => (Real.sqrt_pos.mpr (hGpos y hy)).ne')
    have hcurv : (fun x => sgbLevelCurv2 h f x) =
        fun x => -((Real.sqrt (h x).det)⁻¹ * ∑ i : Fin 2, fderiv ℝ (Y i) x (e2 i)) := rfl
    rw [hcurv]
    refine ContinuousOn.neg (ContinuousOn.mul ?_ ?_)
    · exact (hsd1.continuousOn.mono hVW).inv₀ (fun x hx => (hsdpos x (hVW hx)).ne')
    · exact continuousOn_finset_sum _ (fun i _ =>
        ((hY1 i).continuousOn_fderiv_of_isOpen hVo le_rfl).clm_apply continuousOn_const)
  
  have hband : ∃ sb : ℝ, 0 < sb ∧ ∀ j, ∀ x ∈ Kc j, 0 ≤ b (P.param j x) →
      b (P.param j x) < sb → fderiv ℝ (fun y => b (P.param j y)) x ≠ 0 := by
    have hev : ∀ j, ∀ᶠ s in 𝓝[>] (0:ℝ), ∀ x ∈ Kc j, 0 ≤ b (P.param j x) →
        b (P.param j x) < s → fderiv ℝ (fun y => b (P.param j y)) x ≠ 0 := by
      intro j
      have hbc : ContinuousOn (fun y => b (P.param j y)) (Kc j) :=
        (hb j).continuousOn.mono (hK j).2
      have hdc : ContinuousOn (fderiv ℝ (fun y => b (P.param j y))) (Kc j) :=
        ((hb j).continuousOn_fderiv_of_isOpen (P.W_open j) h1inf).mono (hK j).2
      have hA : IsClosed (Kc j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Ici 0) :=
        hbc.preimage_isClosed_of_isClosed (hK j).1.isClosed isClosed_Ici
      have hZ : IsClosed ((Kc j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Ici 0) ∩
          (fderiv ℝ (fun y => b (P.param j y))) ⁻¹' {0}) :=
        (hdc.mono Set.inter_subset_left).preimage_isClosed_of_isClosed hA isClosed_singleton
      have hZc : IsCompact ((Kc j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Ici 0) ∩
          (fderiv ℝ (fun y => b (P.param j y))) ⁻¹' {0}) :=
        (hK j).1.of_isClosed_subset hZ (fun x hx => hx.1.1)
      rcases Set.eq_empty_or_nonempty ((Kc j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Ici 0) ∩
          (fderiv ℝ (fun y => b (P.param j y))) ⁻¹' {0}) with he | hne
      · refine Filter.Eventually.of_forall (fun s x hx h0 _ hd => ?_)
        have hmem : x ∈ ((Kc j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Ici 0) ∩
            (fderiv ℝ (fun y => b (P.param j y))) ⁻¹' {0}) := ⟨⟨hx, h0⟩, hd⟩
        rw [he] at hmem
        exact hmem
      · obtain ⟨z, hz, hmin⟩ := hZc.exists_isMinOn hne (hbc.mono (fun x hx => hx.1.1))
        have hz0 : (0:ℝ) ≤ b (P.param j z) := hz.1.2
        have hzd : fderiv ℝ (fun y => b (P.param j y)) z = 0 := hz.2
        have hm : 0 < b (P.param j z) := by
          rcases hz0.lt_or_eq with h | h
          · exact h
          · exact absurd hzd (hreg j z ((hK j).2 hz.1.1) h.symm)
        filter_upwards [Ioo_mem_nhdsGT hm] with s hs x hx h0 hlt hd
        have := (isMinOn_iff.mp hmin) x ⟨⟨hx, h0⟩, hd⟩
        have hs2 : s < b (P.param j z) := hs.2
        simp only at this
        linarith
    have hall := Filter.eventually_all.mpr hev
    obtain ⟨u, hu, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.mp hall
    have hu' : (0:ℝ) < u := hu
    exact ⟨u / 2, half_pos hu', fun j => hsub ⟨half_pos hu', half_lt_self hu'⟩ j⟩
  obtain ⟨sb, hsb, hband⟩ := hband
  
  have hη : Continuous (deriv Real.smoothTransition) :=
    (Real.smoothTransition.contDiff (n := 1)).continuous_deriv le_rfl
  have hη0 : ∀ t : ℝ, (t < 0 ∨ 1 < t) → deriv Real.smoothTransition t = 0 := by
    intro t ht
    rcases ht with ht | ht
    · have hev : Real.smoothTransition =ᶠ[𝓝 t] fun _ => (0:ℝ) :=
        Filter.eventuallyEq_of_mem (Iio_mem_nhds ht)
          (fun y hy => Real.smoothTransition.zero_of_nonpos (le_of_lt hy))
      rw [hev.deriv_eq]; simp
    · have hev : Real.smoothTransition =ᶠ[𝓝 t] fun _ => (1:ℝ) :=
        Filter.eventuallyEq_of_mem (Ioi_mem_nhds ht)
          (fun y hy => Real.smoothTransition.one_of_one_le (le_of_lt hy))
      rw [hev.deriv_eq]; simp
  
  refine ⟨sb, hsb, fun s hs hssb j => ?_⟩
  obtain ⟨cK, cG, cD⟩ := hdens (P.W j) (P.W_open j) (P.h j) (P.h_smooth j) (P.h_posDef j) _ (hb j)
  have hKW : Kc j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Icc 0 s ⊆ P.W j :=
    fun x hx => (hK j).2 hx.1
  have hKV : Kc j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Icc 0 s ⊆
      {x | x ∈ P.W j ∧ fderiv ℝ (fun y => b (P.param j y)) x ≠ 0} := fun x hx =>
    ⟨hKW hx, hband j x hx.1 hx.2.1 (lt_of_le_of_lt hx.2.2 hssb)⟩
  have hKc : IsCompact (Kc j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Icc 0 s) :=
    (hK j).1.of_isClosed_subset
      (((hb j).continuousOn.mono (hK j).2).preimage_isClosed_of_isClosed (hK j).1.isClosed
        isClosed_Icc) Set.inter_subset_left
  have hcont : ContinuousOn (fun x => ρ j (P.param j x) *
        (s⁻¹ * deriv Real.smoothTransition (b (P.param j x) / s) *
          Real.sqrt (sgbGradSq2 (P.h j) (fun y => b (P.param j y)) x) *
          sgbLevelCurv2 (P.h j) (fun y => b (P.param j y)) x) *
        Real.sqrt (P.h j x).det) (Kc j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Icc 0 s) := by
    refine ContinuousOn.mul (ContinuousOn.mul ((hρs j j).continuousOn.mono hKW) ?_) (cD.mono hKW)
    refine ContinuousOn.mul (ContinuousOn.mul (ContinuousOn.mul continuousOn_const ?_)
      (cG.mono hKW)) (cK.mono hKV)
    exact hη.comp_continuousOn (((hb j).continuousOn.div_const s).mono hKW)
  refine MeasureTheory.IntegrableOn.of_forall_diff_eq_zero (hcont.integrableOn_compact hKc)
    (P.W_open j).measurableSet ?_
  rintro x ⟨hxW, hxK⟩
  by_cases hxc : x ∈ Kc j
  · have hb' : b (P.param j x) < 0 ∨ s < b (P.param j x) := by
      by_contra hcon
      push_neg at hcon
      exact hxK ⟨hxc, hcon.1, hcon.2⟩
    have hd0 : deriv Real.smoothTransition (b (P.param j x) / s) = 0 := by
      apply hη0
      rcases hb' with h | h
      · left; exact div_neg_of_neg_of_pos h hs
      · right; exact (one_lt_div hs).mpr h
    simp [hd0]
  · simp [hρK j x hxW hxc]

theorem pcgb_bulk_curv_integrable {X : Type*} [TopologicalSpace X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (s : ℝ) (j : Fin P.n) :
    MeasureTheory.IntegrableOn (fun x => ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) * gaussCurv2 (P.h j) x) *
        Real.sqrt (P.h j x).det) (P.W j) :=
by
  have hs : IsOpen (P.W j) := P.W_open j
  have hh : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun x => P.h j x a c) (P.W j) := P.h_smooth j
  have hinf : ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f (P.W j) → ∀ c : Fin 2,
      ContDiffOn ℝ ∞ (pd2 c f) (P.W j) := by
    intro f hf c
    have hfd : ContDiffOn ℝ ∞ (fun y => fderiv ℝ f y) (P.W j) :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hs).1 hf).2
    exact hfd.clm_apply contDiffOn_const
  have hdet : ∀ y ∈ P.W j, (P.h j y).det ≠ 0 := fun y hy => (P.h_posDef j y hy).det_pos.ne'
  have hdetS : ContDiffOn ℝ ∞ (fun y => (P.h j y).det) (P.W j) := by
    have heq : (fun y => (P.h j y).det) =
        fun y => P.h j y 0 0 * P.h j y 1 1 - P.h j y 0 1 * P.h j y 1 0 := by
      funext y
      exact Matrix.det_fin_two (P.h j y)
    rw [heq]
    exact ((hh 0 0).mul (hh 1 1)).sub ((hh 0 1).mul (hh 1 0))
  have hadj : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun y => (P.h j y).adjugate a c) (P.W j) := by
    intro a c
    fin_cases a <;> fin_cases c <;> simp [Matrix.adjugate_fin_two] <;>
      first | exact hh _ _ | exact (hh _ _).neg
  have hinv : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun y => (P.h j y)⁻¹ a c) (P.W j) := by
    intro a c
    have heq : (fun y => (P.h j y)⁻¹ a c) =
        fun y => ((P.h j y).det)⁻¹ * (P.h j y).adjugate a c := by
      funext y
      rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
    rw [heq]
    exact (hdetS.inv hdet).mul (hadj a c)
  have hchr : ∀ k a c : Fin 2, ContDiffOn ℝ ∞ (christoffel2 (P.h j) k a c) (P.W j) := by
    intro k a c
    show ContDiffOn ℝ ∞ (fun x => (1 / 2 : ℝ) * ∑ l : Fin 2, (P.h j x)⁻¹ k l *
      (pd2 a (fun z => P.h j z c l) x + pd2 c (fun z => P.h j z a l) x
        - pd2 l (fun z => P.h j z a c) x)) (P.W j)
    exact contDiffOn_const.mul (ContDiffOn.sum fun l _ => (hinv k l).mul
      (((hinf _ (hh c l) a).add (hinf _ (hh a l) c)).sub (hinf _ (hh a c) l)))
  have hchrC : ∀ k a c : Fin 2, ContinuousOn (christoffel2 (P.h j) k a c) (P.W j) :=
    fun k a c => (hchr k a c).continuousOn
  have hdchr : ∀ d k a c : Fin 2, ContinuousOn (pd2 d (christoffel2 (P.h j) k a c)) (P.W j) :=
    fun d k a c => (hinf _ (hchr k a c) d).continuousOn
  have hric : ∀ a c : Fin 2, ContinuousOn (ricci2 (P.h j) a c) (P.W j) := by
    intro a c
    show ContinuousOn (fun x => ∑ i : Fin 2,
        (pd2 i (christoffel2 (P.h j) i a c) x - pd2 a (christoffel2 (P.h j) i i c) x)
      + ∑ i : Fin 2, ∑ p : Fin 2,
          (christoffel2 (P.h j) i i p x * christoffel2 (P.h j) p a c x
            - christoffel2 (P.h j) i a p x * christoffel2 (P.h j) p i c x)) (P.W j)
    exact (continuousOn_finset_sum _ fun i _ => (hdchr i i a c).sub (hdchr a i i c)).add
      (continuousOn_finset_sum _ fun i _ => continuousOn_finset_sum _ fun p _ =>
        ((hchrC i i p).mul (hchrC p a c)).sub ((hchrC i a p).mul (hchrC p i c)))
  have hKc : ContinuousOn (gaussCurv2 (P.h j)) (P.W j) := by
    show ContinuousOn
      (fun x => (1 / 2 : ℝ) * ∑ a : Fin 2, ∑ c : Fin 2, (P.h j x)⁻¹ a c * ricci2 (P.h j) a c x)
      (P.W j)
    exact continuousOn_const.mul (continuousOn_finset_sum _ fun a _ =>
      continuousOn_finset_sum _ fun c _ => (hinv a c).continuousOn.mul (hric a c))
  have hρc : ContinuousOn (fun x => ρ j (P.param j x)) (P.W j) := (hρs j j).continuousOn
  have hηc : ContinuousOn (fun x => Real.smoothTransition (b (P.param j x) / s)) (P.W j) :=
    Real.smoothTransition.continuous.comp_continuousOn ((hb j).continuousOn.div_const s)
  have hdA : ContinuousOn (fun x => Real.sqrt (P.h j x).det) (P.W j) :=
    hdetS.continuousOn.sqrt
  have hA : ContinuousOn (fun x => ρ j (P.param j x) *
      (Real.smoothTransition (b (P.param j x) / s) * gaussCurv2 (P.h j) x) *
      Real.sqrt (P.h j x).det) (P.W j) :=
    (hρc.mul (hηc.mul hKc)).mul hdA
  have hAK : MeasureTheory.IntegrableOn (fun x => ρ j (P.param j x) *
      (Real.smoothTransition (b (P.param j x) / s) * gaussCurv2 (P.h j) x) *
      Real.sqrt (P.h j x).det) (Kc j) :=
    (hA.mono (hK j).2).integrableOn_compact (hK j).1
  refine hAK.of_forall_diff_eq_zero hs.measurableSet ?_
  intro x hx
  rw [hρK j x hx.1 hx.2]
  ring

theorem pcgb_bulk_defect_integrable {X : Type*} [TopologicalSpace X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (b w : X → ℝ)
    (ε : ℝ) (hε : 0 < ε) (s : ℝ) (j : Fin P.n)
    (hA : MeasureTheory.IntegrableOn (fun x => ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) * gaussCurv2 (P.h j) x) *
        Real.sqrt (P.h j x).det) (P.W j)) :
    MeasureTheory.IntegrableOn (fun x => ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) * gaussCurv2 (P.h j) x *
          (ε / (sgbGradSq2 (P.h j) (fun y => w (P.param j y)) x + ε))) *
        Real.sqrt (P.h j x).det) (P.W j) :=
by
  have hWm : MeasurableSet (P.W j) := (P.W_open j).measurableSet
  have hent : ∀ u v : Fin 2, AEMeasurable (fun x => P.h j x u v)
      (MeasureTheory.volume.restrict (P.W j)) :=
    fun u v => ((P.h_smooth j u v).continuousOn.aestronglyMeasurable hWm).aemeasurable
  have hinv_eq : ∀ (A : Matrix (Fin 2) (Fin 2) ℝ) (a c : Fin 2),
      A⁻¹ a c = (A.det)⁻¹ * A.adjugate a c := by
    intro A a c
    rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
  have hdet : AEMeasurable (fun x => ((P.h j x).det)⁻¹)
      (MeasureTheory.volume.restrict (P.W j)) := by
    have hd : (fun x => (P.h j x).det) =
        fun x => P.h j x 0 0 * P.h j x 1 1 - P.h j x 0 1 * P.h j x 1 0 := by
      funext x; exact Matrix.det_fin_two _
    have h1 : AEMeasurable (fun x => (P.h j x).det) (MeasureTheory.volume.restrict (P.W j)) := by
      rw [hd]
      exact ((hent 0 0).mul (hent 1 1)).sub ((hent 0 1).mul (hent 1 0))
    exact h1.inv
  have hadj : ∀ a c : Fin 2, AEMeasurable (fun x => (P.h j x).adjugate a c)
      (MeasureTheory.volume.restrict (P.W j)) := by
    intro a c
    fin_cases a <;> fin_cases c <;> simp [Matrix.adjugate_fin_two] <;>
      first
        | exact hent _ _
        | exact (hent _ _).neg
  have hinvE : ∀ a c : Fin 2, AEMeasurable (fun x => (P.h j x)⁻¹ a c)
      (MeasureTheory.volume.restrict (P.W j)) := by
    intro a c
    simp_rw [hinv_eq]
    exact hdet.mul (hadj a c)
  have hp : ∀ a : Fin 2, Measurable (fun x => pd2 a (fun y => w (P.param j y)) x) :=
    fun a => measurable_fderiv_apply_const ℝ _ _
  have hG : AEMeasurable (fun x => sgbGradSq2 (P.h j) (fun y => w (P.param j y)) x)
      (MeasureTheory.volume.restrict (P.W j)) := by
    simp only [sgbGradSq2, Fin.sum_univ_two]
    exact ((((hinvE 0 0).mul (hp 0).aemeasurable).mul (hp 0).aemeasurable).add
      (((hinvE 0 1).mul (hp 0).aemeasurable).mul (hp 1).aemeasurable)).add
      ((((hinvE 1 0).mul (hp 1).aemeasurable).mul (hp 0).aemeasurable).add
      (((hinvE 1 1).mul (hp 1).aemeasurable).mul (hp 1).aemeasurable))
  have hf : MeasureTheory.AEStronglyMeasurable
      (fun x => ε / (sgbGradSq2 (P.h j) (fun y => w (P.param j y)) x + ε))
      (MeasureTheory.volume.restrict (P.W j)) :=
    ((hG.add_const ε).const_div ε).aestronglyMeasurable
  have hbound : ∀ᵐ x ∂(MeasureTheory.volume.restrict (P.W j)),
      ‖ε / (sgbGradSq2 (P.h j) (fun y => w (P.param j y)) x + ε)‖ ≤ 1 := by
    refine MeasureTheory.ae_restrict_of_forall_mem hWm (fun x hx => ?_)
    have hG0 : 0 ≤ sgbGradSq2 (P.h j) (fun y => w (P.param j y)) x := by
      have hpsd := (P.h_posDef j x hx).inv.posSemidef
      have hq := hpsd.dotProduct_mulVec_nonneg (fun a => pd2 a (fun y => w (P.param j y)) x)
      simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_two, star_trivial] at hq
      simp only [sgbGradSq2, Fin.sum_univ_two]
      ring_nf at hq ⊢
      linarith
    have hpos : 0 < sgbGradSq2 (P.h j) (fun y => w (P.param j y)) x + ε := by linarith
    have hnn : 0 ≤ ε / (sgbGradSq2 (P.h j) (fun y => w (P.param j y)) x + ε) :=
      div_nonneg hε.le hpos.le
    rw [Real.norm_eq_abs, abs_of_nonneg hnn]
    exact (div_le_one hpos).mpr (by linarith)
  have key := MeasureTheory.Integrable.bdd_mul (c := 1) hA hf hbound
  refine MeasureTheory.Integrable.congr key (MeasureTheory.ae_of_all _ (fun x => ?_))
  simp only
  ring

theorem pcgb_bulk_kato_pointwise {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ)
    (hρnn : ∀ j q, 0 ≤ ρ j q)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (Gd : PcgbGreenData P b)
    (hkato : ∀ (W : Set E2), IsOpen W → ∀ (h : E2 → Matrix (Fin 2) (Fin 2) ℝ),
      (∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) → (∀ x ∈ W, (h x).PosDef) →
      ∀ (w : E2 → ℝ), ContDiffOn ℝ ∞ w W → (∀ x ∈ W, lap2 h w x = 0) →
      ∀ (ε : ℝ), 0 < ε → ∀ x ∈ W,
      lap2 h (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y + ε)) x =
        gaussCurv2 h x * sgbGradSq2 h w x / (sgbGradSq2 h w x + ε) +
        ε * (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2, (h x)⁻¹ a c * (h x)⁻¹ b d *
             (pd2 a (pd2 b w) x - ∑ k : Fin 2, christoffel2 h k a b x * pd2 k w x) *
             (pd2 c (pd2 d w) x - ∑ k : Fin 2, christoffel2 h k c d x * pd2 k w x)) /
          (sgbGradSq2 h w x + ε) ^ 2)
    (ε : ℝ) (hε : 0 < ε) (s : ℝ) (hs : 0 < s) (j : Fin P.n)
    (x : E2) (hx : x ∈ P.W j) (hxp : P.param j x ≠ Gd.p₀) :
    ρ j (P.param j x) * (Real.smoothTransition (b (P.param j x) / s) * gaussCurv2 (P.h j) x) *
        Real.sqrt (P.h j x).det ≤
      ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) * gaussCurv2 (P.h j) x *
          (ε / (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x + ε))) *
        Real.sqrt (P.h j x).det +
      ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) *
          lap2 (P.h j) (fun y => (1 / 2 : ℝ) * Real.log
            (sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) y + ε)) x) *
        Real.sqrt (P.h j x).det :=
by
  
  have quad : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.PosDef →
      (∀ ξ : Fin 2 → ℝ, 0 ≤ ∑ a : Fin 2, ∑ b : Fin 2, A⁻¹ a b * ξ a * ξ b) ∧
      (∀ H : Fin 2 → Fin 2 → ℝ, 0 ≤ ∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
          A⁻¹ a c * A⁻¹ b d * H a b * H c d) := by
    intro A hA
    have hB : A⁻¹.PosDef := hA.inv
    have hsym : A⁻¹ 1 0 = A⁻¹ 0 1 := by
      have h := hB.isHermitian.apply 0 1
      simpa using h
    have hp : 0 < A⁻¹ 0 0 := hB.diag_pos
    have hdet : 0 < A⁻¹.det := hB.det_pos
    rw [Matrix.det_fin_two, hsym] at hdet
    have hδ : 0 < A⁻¹ 0 0 * A⁻¹ 1 1 - A⁻¹ 0 1 ^ 2 := by nlinarith
    have key1 : ∀ ξ : Fin 2 → ℝ,
        A⁻¹ 0 0 * (∑ a : Fin 2, ∑ b : Fin 2, A⁻¹ a b * ξ a * ξ b) =
          (A⁻¹ 0 0 * ξ 0 + A⁻¹ 0 1 * ξ 1) ^ 2 +
            (A⁻¹ 0 0 * A⁻¹ 1 1 - A⁻¹ 0 1 ^ 2) * ξ 1 ^ 2 := by
      intro ξ
      simp only [Fin.sum_univ_two, hsym]
      ring
    have key2 : ∀ H : Fin 2 → Fin 2 → ℝ,
        A⁻¹ 0 0 ^ 2 * (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
          A⁻¹ a c * A⁻¹ b d * H a b * H c d) =
          (A⁻¹ 0 0 ^ 2 * H 0 0 + A⁻¹ 0 0 * A⁻¹ 0 1 * H 0 1 + A⁻¹ 0 0 * A⁻¹ 0 1 * H 1 0
              + A⁻¹ 0 1 ^ 2 * H 1 1) ^ 2
            + (A⁻¹ 0 0 * A⁻¹ 1 1 - A⁻¹ 0 1 ^ 2) * (A⁻¹ 0 0 * H 0 1 + A⁻¹ 0 1 * H 1 1) ^ 2
            + (A⁻¹ 0 0 * A⁻¹ 1 1 - A⁻¹ 0 1 ^ 2) * (A⁻¹ 0 0 * H 1 0 + A⁻¹ 0 1 * H 1 1) ^ 2
            + (A⁻¹ 0 0 * A⁻¹ 1 1 - A⁻¹ 0 1 ^ 2) ^ 2 * H 1 1 ^ 2 := by
      intro H
      simp only [Fin.sum_univ_two, hsym]
      ring
    refine ⟨fun ξ => ?_, fun H => ?_⟩
    · have h1 := key1 ξ
      have h2 : 0 ≤ A⁻¹ 0 0 * (∑ a : Fin 2, ∑ b : Fin 2, A⁻¹ a b * ξ a * ξ b) := by
        rw [h1]
        exact add_nonneg (sq_nonneg _) (mul_nonneg hδ.le (sq_nonneg _))
      exact nonneg_of_mul_nonneg_right h2 hp
    · have h1 := key2 H
      have h2 : 0 ≤ A⁻¹ 0 0 ^ 2 * (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
          A⁻¹ a c * A⁻¹ b d * H a b * H c d) := by
        rw [h1]
        exact add_nonneg (add_nonneg (add_nonneg (sq_nonneg _)
          (mul_nonneg hδ.le (sq_nonneg _))) (mul_nonneg hδ.le (sq_nonneg _)))
          (mul_nonneg (sq_nonneg _) (sq_nonneg _))
      exact nonneg_of_mul_nonneg_right h2 (pow_pos hp 2)
  
  have alg : ∀ (r η dA K G HS : ℝ), 0 ≤ r → 0 ≤ η → 0 ≤ dA → 0 ≤ G → 0 ≤ HS →
      r * (η * K) * dA ≤ r * (η * K * (ε / (G + ε))) * dA +
        r * (η * (K * G / (G + ε) + ε * HS / (G + ε) ^ 2)) * dA := by
    intro r η dA K G HS hr hη hdA hG hHS
    have hQ : 0 < G + ε := by linarith
    have e1 : K * (ε / (G + ε)) + K * G / (G + ε) = K := by
      field_simp
      ring
    have e2 : 0 ≤ ε * HS / (G + ε) ^ 2 := by positivity
    have hc : 0 ≤ r * η * dA := by positivity
    have hdiff : r * (η * K * (ε / (G + ε))) * dA +
        r * (η * (K * G / (G + ε) + ε * HS / (G + ε) ^ 2)) * dA - r * (η * K) * dA =
        r * η * dA * (K * (ε / (G + ε)) + K * G / (G + ε) - K) +
          r * η * dA * (ε * HS / (G + ε) ^ 2) := by ring
    rw [e1, sub_self, mul_zero, zero_add] at hdiff
    nlinarith [mul_nonneg hc e2]
  rcases le_or_gt (b (P.param j x)) 0 with hβ | hβ
  · have h0 : Real.smoothTransition (b (P.param j x) / s) = 0 :=
      Real.smoothTransition.zero_of_nonpos (div_nonpos_of_nonpos_of_nonneg hβ hs.le)
    rw [h0]
    simp
  · have hO1 : IsOpen (P.W j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Ioi 0) :=
      (hb j).continuousOn.isOpen_inter_preimage (P.W_open j) isOpen_Ioi
    have hOo : IsOpen ((P.W j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Ioi 0) ∩
        P.param j ⁻¹' {Gd.p₀}ᶜ) :=
      ((P.param_cont j).mono Set.inter_subset_left).isOpen_inter_preimage hO1
        isOpen_compl_singleton
    have hxO : x ∈ (P.W j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Ioi 0) ∩
        P.param j ⁻¹' {Gd.p₀}ᶜ := ⟨⟨hx, hβ⟩, hxp⟩
    have hOW : (P.W j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Ioi 0) ∩
        P.param j ⁻¹' {Gd.p₀}ᶜ ⊆ P.W j := fun y hy => hy.1.1
    have hOd : (P.W j ∩ (fun y => b (P.param j y)) ⁻¹' Set.Ioi 0) ∩
        P.param j ⁻¹' {Gd.p₀}ᶜ ⊆ P.W j ∩ P.param j ⁻¹' (Gd.U \ {Gd.p₀}) := by
      intro y hy
      have hyb : 0 < b (P.param j y) := hy.1.2
      have hyp : P.param j y ≠ Gd.p₀ := hy.2
      refine ⟨hy.1.1, ?_, hyp⟩
      have hS : P.param j y ∈ S := by
        have hmem : P.param j y ∈ P.param j '' P.W j := ⟨y, hy.1.1, rfl⟩
        rw [P.image_eq j] at hmem
        exact hmem.2
      exact Gd.R_sub ⟨hS, le_of_lt hyb⟩
    have hK := hkato _ hOo (P.h j) (fun a b' => (P.h_smooth j a b').mono hOW)
      (fun y hy => P.h_posDef j y (hOW hy)) (fun z => Gd.w (P.param j z))
      ((Gd.smooth j).mono hOd)
      (fun y hy => Gd.harm j y (hOW hy) (le_of_lt (show 0 < b (P.param j y) from hy.1.2))
        (show P.param j y ≠ Gd.p₀ from hy.2)) ε hε x hxO
    rw [hK]
    obtain ⟨hq1, hq2⟩ := quad (P.h j x) (P.h_posDef j x hx)
    have hG : 0 ≤ sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) x := by
      unfold sgbGradSq2
      exact hq1 (fun a => pd2 a (fun z => Gd.w (P.param j z)) x)
    exact alg _ _ _ _ _ _ (hρnn j _) (Real.smoothTransition.nonneg _) (Real.sqrt_nonneg _) hG
      (hq2 (fun a b' => pd2 a (pd2 b' (fun z => Gd.w (P.param j z))) x -
        ∑ k : Fin 2, christoffel2 (P.h j) k a b' x * pd2 k (fun z => Gd.w (P.param j z)) x))

theorem pcgb_bulk_kato_le {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρnn : ∀ j q, 0 ≤ ρ j q)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (Gd : PcgbGreenData P b)
    (hkato : ∀ (W : Set E2), IsOpen W → ∀ (h : E2 → Matrix (Fin 2) (Fin 2) ℝ),
      (∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) W) → (∀ x ∈ W, (h x).PosDef) →
      ∀ (w : E2 → ℝ), ContDiffOn ℝ ∞ w W → (∀ x ∈ W, lap2 h w x = 0) →
      ∀ (ε : ℝ), 0 < ε → ∀ x ∈ W,
      lap2 h (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y + ε)) x =
        gaussCurv2 h x * sgbGradSq2 h w x / (sgbGradSq2 h w x + ε) +
        ε * (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2, (h x)⁻¹ a c * (h x)⁻¹ b d *
             (pd2 a (pd2 b w) x - ∑ k : Fin 2, christoffel2 h k a b x * pd2 k w x) *
             (pd2 c (pd2 d w) x - ∑ k : Fin 2, christoffel2 h k c d x * pd2 k w x)) /
          (sgbGradSq2 h w x + ε) ^ 2)
    (ε : ℝ) (hε : 0 < ε) (s : ℝ) (hs : 0 < s) (j : Fin P.n)
    (hI : MeasureTheory.IntegrableOn (fun x => ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) *
          lap2 (P.h j) (fun y => (1 / 2 : ℝ) * Real.log
            (sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) y + ε)) x) *
        Real.sqrt (P.h j x).det) (P.W j)) :
    (∫ x in P.W j, ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) * gaussCurv2 (P.h j) x) *
        Real.sqrt (P.h j x).det) ≤
      (∫ x in P.W j, ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) * gaussCurv2 (P.h j) x *
          (ε / (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x + ε))) *
        Real.sqrt (P.h j x).det) +
      ∫ x in P.W j, ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) *
          lap2 (P.h j) (fun y => (1 / 2 : ℝ) * Real.log
            (sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) y + ε)) x) *
        Real.sqrt (P.h j x).det :=
by
  have hA1 := pcgb_bulk_curv_integrable S P ρ Kc hρs hK hρK b hb s j
  have hD := pcgb_bulk_defect_integrable S P ρ b Gd.w ε hε s j hA1
  have hDB := MeasureTheory.Integrable.add hD hI
  have hZ : MeasureTheory.volume {x : E2 | x ∈ P.W j ∧ P.param j x = Gd.p₀} = 0 := by
    apply Set.Subsingleton.measure_zero
    intro x hx y hy
    rw [← P.proj_param j x hx.1, ← P.proj_param j y hy.1, hx.2, hy.2]
  have hae : ∀ᵐ x ∂MeasureTheory.volume, x ∈ P.W j →
      ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) * gaussCurv2 (P.h j) x) *
        Real.sqrt (P.h j x).det ≤
      ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) * gaussCurv2 (P.h j) x *
          (ε / (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x + ε))) *
        Real.sqrt (P.h j x).det +
      ρ j (P.param j x) *
        (Real.smoothTransition (b (P.param j x) / s) *
          lap2 (P.h j) (fun y => (1 / 2 : ℝ) * Real.log
            (sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) y + ε)) x) *
        Real.sqrt (P.h j x).det := by
    rw [MeasureTheory.ae_iff]
    refine MeasureTheory.measure_mono_null ?_ hZ
    intro x hx
    simp only [Set.mem_setOf_eq, Classical.not_imp] at hx
    obtain ⟨hxW, hlt⟩ := hx
    refine ⟨hxW, ?_⟩
    by_contra hne
    exact hlt (pcgb_bulk_kato_pointwise S P ρ hρnn b hb Gd hkato ε hε s hs j x hxW hne)
  have hmono := MeasureTheory.setIntegral_mono_on_ae hA1 hDB (P.W_open j).measurableSet hae
  rw [← MeasureTheory.integral_add hD hI]
  exact hmono

theorem pcgb_main_inequality {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρnn : ∀ j q, 0 ≤ ρ j q)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (hρO : ∀ j q, q ∉ P.O j → ρ j q = 0)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (hRc : IsCompact {q | q ∈ S ∧ 0 ≤ b q})
    (hRconn : IsConnected {q | q ∈ S ∧ 0 ≤ b q})
    (hρ1 : ∀ q, q ∈ S → 0 ≤ b q → ∑ j, ρ j q = 1)
    (hreg : ∀ j, ∀ x ∈ P.W j, b (P.param j x) = 0 →
      fderiv ℝ (fun y => b (P.param j y)) x ≠ 0)
    (hbd : ∃ q ∈ S, b q = 0) (Gd : PcgbGreenData P b) :
    ∃ s₁ : ℝ, 0 < s₁ ∧ ∀ ε : ℝ, 0 < ε → ∀ s : ℝ, 0 < s → s < s₁ →
      sgbCollarGB P ρ b s ≤
        2 * Real.pi + pcgbDefect P ρ b Gd.w ε s + pcgbCollarErr P ρ b Gd.w ε s :=
by
  have hkato := fun W hW h hh hpos w hw hharm ε hε x hx =>
    pcgb_kato_identity W hW h hh hpos w hw hharm ε hε x hx
  obtain ⟨r₁, hr₁, hr₁le, hpb⟩ := pcgb_pole_bounds S P b Gd hkato
  obtain ⟨sG, hsG, hcol⟩ := pcgb_collar_integrable S P ρ Kc hρs hK hρK b hb hreg
  refine ⟨min r₁ sG, lt_min hr₁ hsG, fun ε hε s hs hss => ?_⟩
  have hsr : s ≤ r₁ := le_of_lt (lt_of_lt_of_le hss (min_le_left _ _))
  have hsg : s < sG := lt_of_lt_of_le hss (min_le_right _ _)
  obtain ⟨hLs, hLc⟩ := pcgb_log_potential_props S P b Gd ε hε
  obtain ⟨C, hC⟩ := hpb ε hε
  have hball : Metric.closedBall Gd.x₀ r₁ ⊆ P.W Gd.j₀ :=
    (Metric.closedBall_subset_closedBall hr₁le).trans Gd.ball_sub
  have hbpos : ∀ x ∈ Metric.closedBall Gd.x₀ r₁, 2 * r₁ ≤ b (P.param Gd.j₀ x) := fun x hx =>
    le_trans (by linarith) (Gd.ball_pos x (Metric.closedBall_subset_closedBall hr₁le hx))
  obtain ⟨hI1, hI2, hsum⟩ := pcgb_pole_divergence S P ρ Kc hρnn hρs hK hρK hρO b hb hρ1
    Gd.j₀ Gd.x₀ Gd.p₀ r₁ hr₁ Gd.param_x₀ hball hbpos Gd.U Gd.U_open Gd.R_sub
    (fun j y => (1 / 2 : ℝ) * Real.log
      (sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) y + ε))
    hLs hLc C hC s hs hsr
  beta_reduce at hI1 hI2 hsum
  have hbulk := fun j => pcgb_bulk_kato_le S P ρ Kc hρnn hρs hK hρK b hb Gd hkato ε hε s hs j
    (hI1 j)
  have hE : ∀ j, (∫ x in P.W j, ρ j (P.param j x) *
      (s⁻¹ * deriv Real.smoothTransition (b (P.param j x) / s) *
        (Real.sqrt (sgbGradSq2 (P.h j) (fun y => b (P.param j y)) x) *
            sgbLevelCurv2 (P.h j) (fun y => b (P.param j y)) x -
          ∑ a : Fin 2, ∑ c : Fin 2, (P.h j x)⁻¹ a c * pd2 a (fun y => b (P.param j y)) x *
            pd2 c (fun y => (1 / 2 : ℝ) *
              Real.log (sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) y + ε)) x)) *
      Real.sqrt (P.h j x).det) =
      (∫ x in P.W j, ρ j (P.param j x) *
        (s⁻¹ * deriv Real.smoothTransition (b (P.param j x) / s) *
          Real.sqrt (sgbGradSq2 (P.h j) (fun y => b (P.param j y)) x) *
          sgbLevelCurv2 (P.h j) (fun y => b (P.param j y)) x) *
        Real.sqrt (P.h j x).det) -
      ∫ x in P.W j, ρ j (P.param j x) *
        (s⁻¹ * deriv Real.smoothTransition (b (P.param j x) / s) *
          ∑ a : Fin 2, ∑ c : Fin 2, (P.h j x)⁻¹ a c * pd2 a (fun y => b (P.param j y)) x *
            pd2 c (fun y => (1 / 2 : ℝ) *
              Real.log (sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) y + ε)) x) *
        Real.sqrt (P.h j x).det := by
    intro j
    refine Eq.trans ?_ (MeasureTheory.integral_sub (hcol s hs hsg j) (hI2 j))
    congr 1
    funext x
    beta_reduce
    ring
  unfold sgbCollarGB pcgbDefect pcgbCollarErr eigWInt
  unfold eigWInt at hsum
  beta_reduce
  beta_reduce at hsum
  rw [Finset.sum_congr rfl (fun j _ => hE j), Finset.sum_sub_distrib]
  have h1 := Finset.sum_le_sum (fun j (_ : j ∈ Finset.univ) => hbulk j)
  rw [Finset.sum_add_distrib] at h1
  linarith

theorem e2_eps_weight_dct (W K B : Set E2) (hW : IsOpen W) (hK : IsCompact K) (hKW : K ⊆ W)
    (hB : IsOpen B) (A G : E2 → ℝ) (hA : ContinuousOn A W) (hAK : ∀ x ∈ W, x ∉ K → A x = 0)
    (hGm : MeasureTheory.AEStronglyMeasurable G (MeasureTheory.volume.restrict W))
    (hGnn : ∀ x ∈ W, 0 ≤ G x)
    (hnull : MeasureTheory.volume {x | x ∈ W ∧ x ∈ B ∧ A x ≠ 0 ∧ G x = 0} = 0) :
    ∀ θ : ℝ, 0 < θ → ∃ ε₀ : ℝ, 0 < ε₀ ∧ ∀ ε : ℝ, 0 < ε → ε < ε₀ → ∀ F : E2 → ℝ,
      (∀ x ∈ W, |F x| ≤ B.indicator (fun y => |A y| * (ε / (G y + ε))) x) →
      ∫ x in W, F x ≤ θ :=
by
  intro θ hθ
  have hWm : MeasurableSet W := hW.measurableSet
  have hWae : ∀ᵐ x ∂(MeasureTheory.volume.restrict W), x ∈ W :=
    MeasureTheory.ae_restrict_mem hWm
  have hAint : MeasureTheory.Integrable A (MeasureTheory.volume.restrict W) := by
    have h1 : MeasureTheory.IntegrableOn A K MeasureTheory.volume :=
      (hA.mono hKW).integrableOn_compact hK
    exact h1.of_forall_diff_eq_zero hWm (fun x hx => hAK x hx.1 hx.2)
  have hbint : MeasureTheory.Integrable (fun x => |A x|) (MeasureTheory.volume.restrict W) :=
    hAint.abs
  let g : ℝ → E2 → ℝ := fun ε => B.indicator (fun y => |A y| * (ε / (G y + ε)))
  have hgm : ∀ ε : ℝ,
      MeasureTheory.AEStronglyMeasurable (g ε) (MeasureTheory.volume.restrict W) := by
    intro ε
    have h1 : MeasureTheory.AEStronglyMeasurable (fun y => |A y|)
        (MeasureTheory.volume.restrict W) := hbint.aestronglyMeasurable
    have h2 : MeasureTheory.AEStronglyMeasurable (fun y => ε / (G y + ε))
        (MeasureTheory.volume.restrict W) :=
      ((hGm.aemeasurable.add_const ε).const_div ε).aestronglyMeasurable
    exact (h1.mul h2).indicator hB.measurableSet
  have hgb : ∀ ε : ℝ, 0 < ε → ∀ x ∈ W, 0 ≤ g ε x ∧ g ε x ≤ |A x| := by
    intro ε hε x hx
    have hG := hGnn x hx
    have hq0 : 0 ≤ ε / (G x + ε) := div_nonneg hε.le (by linarith)
    have hq1 : ε / (G x + ε) ≤ 1 := div_le_one_of_le₀ (by linarith) (by linarith)
    by_cases hxB : x ∈ B
    · simp only [g, Set.indicator_of_mem hxB]
      exact ⟨mul_nonneg (abs_nonneg _) hq0, mul_le_of_le_one_right (abs_nonneg _) hq1⟩
    · simp only [g, Set.indicator_of_notMem hxB]
      exact ⟨le_refl 0, abs_nonneg _⟩
  have hgae : ∀ ε : ℝ, 0 < ε → ∀ᵐ x ∂(MeasureTheory.volume.restrict W), ‖g ε x‖ ≤ |A x| := by
    intro ε hε
    filter_upwards [hWae] with x hx
    obtain ⟨h0, h1⟩ := hgb ε hε x hx
    rw [Real.norm_eq_abs, abs_of_nonneg h0]
    exact h1
  have hgi : ∀ ε : ℝ, 0 < ε → MeasureTheory.Integrable (g ε) (MeasureTheory.volume.restrict W) :=
    fun ε hε => hbint.mono' (hgm ε) (hgae ε hε)
  have hlim : ∀ᵐ x ∂(MeasureTheory.volume.restrict W),
      Filter.Tendsto (fun ε => g ε x) (nhdsWithin 0 (Set.Ioi 0)) (nhds 0) := by
    have hN : ∀ᵐ x ∂MeasureTheory.volume,
        x ∉ {x | x ∈ W ∧ x ∈ B ∧ A x ≠ 0 ∧ G x = 0} :=
      MeasureTheory.measure_eq_zero_iff_ae_notMem.mp hnull
    filter_upwards [hWae, MeasureTheory.ae_restrict_of_ae hN] with x hx hxN
    by_cases hxB : x ∈ B
    · by_cases hAx : A x = 0
      · have hfun : (fun ε => g ε x) = fun _ => (0 : ℝ) := by
          funext ε
          simp [g, Set.indicator_of_mem hxB, hAx]
        rw [hfun]
        exact tendsto_const_nhds
      · have hGx : G x ≠ 0 := fun h => hxN ⟨hx, hxB, hAx, h⟩
        have h1 : Filter.Tendsto (fun ε : ℝ => ε / (G x + ε)) (nhds 0)
            (nhds (0 / (G x + 0))) :=
          Filter.tendsto_id.div (tendsto_const_nhds.add Filter.tendsto_id) (by simpa using hGx)
        rw [zero_div] at h1
        have h2 := (h1.mono_left (nhdsWithin_le_nhds (s := Set.Ioi (0 : ℝ)))).const_mul (|A x|)
        rw [mul_zero] at h2
        have hfun : (fun ε => g ε x) = fun ε => |A x| * (ε / (G x + ε)) := by
          funext ε
          simp only [g, Set.indicator_of_mem hxB]
        rw [hfun]
        exact h2
    · have hfun : (fun ε => g ε x) = fun _ => (0 : ℝ) := by
        funext ε
        simp only [g, Set.indicator_of_notMem hxB]
      rw [hfun]
      exact tendsto_const_nhds
  have hdct : Filter.Tendsto (fun ε => ∫ x in W, g ε x) (nhdsWithin 0 (Set.Ioi 0))
      (nhds (∫ x in W, (0 : ℝ))) :=
    MeasureTheory.tendsto_integral_filter_of_dominated_convergence (fun x => |A x|)
      (Filter.Eventually.of_forall hgm)
      (by filter_upwards [self_mem_nhdsWithin] with ε hε using hgae ε hε)
      hbint hlim
  rw [MeasureTheory.integral_zero] at hdct
  have hev : ∀ᶠ ε in nhdsWithin (0 : ℝ) (Set.Ioi 0), ∫ x in W, g ε x < θ :=
    Filter.Tendsto.eventually_lt_const hθ hdct
  obtain ⟨u, hu, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.mp hev
  refine ⟨u, hu, fun ε hε hεu F hF => ?_⟩
  have hlt : ∫ x in W, g ε x < θ := hsub ⟨hε, hεu⟩
  have hFb : ∀ᵐ x ∂(MeasureTheory.volume.restrict W), ‖F x‖ ≤ g ε x := by
    filter_upwards [hWae] with x hx
    rw [Real.norm_eq_abs]
    exact hF x hx
  have hn := MeasureTheory.norm_integral_le_of_norm_le (hgi ε hε) hFb
  rw [Real.norm_eq_abs] at hn
  have habs := le_abs_self (∫ x in W, F x)
  linarith

theorem flat_taylor_decay (V : Set E2) (hV : IsOpen V) (u : E2 → ℝ) (hu : ContDiffOn ℝ ∞ u V)
    (x₀ : E2) (hx₀ : x₀ ∈ V) (hflat : ∀ k : ℕ, 1 ≤ k → iteratedFDeriv ℝ k u x₀ = 0) :
    ∃ ρ : ℝ, 0 < ρ ∧ Metric.closedBall x₀ ρ ⊆ V ∧
      ∀ K : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ x ∈ Metric.closedBall x₀ ρ,
        |u x - u x₀| ≤ C * ‖x - x₀‖ ^ K ∧ ‖fderiv ℝ u x‖ ≤ C * ‖x - x₀‖ ^ K :=
by
  obtain ⟨ε, hε, hεV⟩ := Metric.isOpen_iff.mp hV x₀ hx₀
  have hρ0 : 0 < min (ε / 2) 1 := lt_min (half_pos hε) one_pos
  have hρ1 : min (ε / 2) 1 ≤ 1 := min_le_right _ _
  have hρε : min (ε / 2) 1 < ε := lt_of_le_of_lt (min_le_left _ _) (half_lt_self hε)
  have hB : Metric.closedBall x₀ (min (ε / 2) 1) ⊆ V :=
    (Metric.closedBall_subset_ball hρε).trans hεV
  have hCD : ∀ y ∈ Metric.closedBall x₀ (min (ε / 2) 1), ContDiffAt ℝ ∞ u y :=
    fun y hy => hu.contDiffAt (hV.mem_nhds (hB hy))
  have hDiffG : ∀ m : ℕ, ∀ y ∈ Metric.closedBall x₀ (min (ε / 2) 1),
      DifferentiableAt ℝ (iteratedFDeriv ℝ m u) y := by
    intro m y hy
    refine (hCD y hy).differentiableAt_iteratedFDeriv ?_
    exact WithTop.coe_lt_coe.2 (ENat.coe_lt_top m)
  have hDu : ∀ y ∈ Metric.closedBall x₀ (min (ε / 2) 1), DifferentiableAt ℝ u y :=
    fun y hy => (hCD y hy).differentiableAt (by simp)
  have hsub : ∀ x ∈ Metric.closedBall x₀ (min (ε / 2) 1),
      Metric.closedBall x₀ ‖x - x₀‖ ⊆ Metric.closedBall x₀ (min (ε / 2) 1) := by
    intro x hx
    apply Metric.closedBall_subset_closedBall
    rw [Metric.mem_closedBall, dist_eq_norm] at hx
    exact hx
  have hxmem : ∀ x : E2, x ∈ Metric.closedBall x₀ ‖x - x₀‖ := by
    intro x
    rw [Metric.mem_closedBall, dist_eq_norm]
  have hx0mem : ∀ x : E2, x₀ ∈ Metric.closedBall x₀ ‖x - x₀‖ :=
    fun x => Metric.mem_closedBall_self (norm_nonneg _)
  have hynorm : ∀ x y : E2, y ∈ Metric.closedBall x₀ ‖x - x₀‖ → ‖y - x₀‖ ≤ ‖x - x₀‖ := by
    intro x y hy
    rwa [Metric.mem_closedBall, dist_eq_norm] at hy
  refine ⟨min (ε / 2) 1, hρ0, hB, fun K => ?_⟩
  obtain ⟨M₀, hM₀⟩ := (isCompact_closedBall x₀ (min (ε / 2) 1)).exists_bound_of_continuousOn
    (fun y hy => (hDiffG (K + 1) y hy).continuousAt.continuousWithinAt)
  have hM0 : 0 ≤ max M₀ 0 := le_max_right _ _
  have hMb : ∀ y ∈ Metric.closedBall x₀ (min (ε / 2) 1),
      ‖iteratedFDeriv ℝ (K + 1) u y‖ ≤ max M₀ 0 :=
    fun y hy => (hM₀ y hy).trans (le_max_left _ _)
  have hind : ∀ j : ℕ, j ≤ K → ∀ x ∈ Metric.closedBall x₀ (min (ε / 2) 1),
      ‖iteratedFDeriv ℝ (K - j + 1) u x‖ ≤ max M₀ 0 * ‖x - x₀‖ ^ j := by
    intro j
    induction j with
    | zero =>
      intro _ x hx
      simpa using hMb x hx
    | succ j ih =>
      intro hj x hx
      have hm1 : 1 ≤ K - (j + 1) + 1 := Nat.le_add_left 1 _
      have hmeq : K - (j + 1) + 1 + 1 = K - j + 1 := by omega
      have hzero := hflat (K - (j + 1) + 1) hm1
      have hmvt := Convex.norm_image_sub_le_of_norm_fderiv_le
        (f := iteratedFDeriv ℝ (K - (j + 1) + 1) u) (C := max M₀ 0 * ‖x - x₀‖ ^ j)
        (fun y hy => hDiffG _ y (hsub x hx hy))
        (fun y hy => by
          rw [norm_fderiv_iteratedFDeriv, hmeq]
          calc ‖iteratedFDeriv ℝ (K - j + 1) u y‖ ≤ max M₀ 0 * ‖y - x₀‖ ^ j :=
                ih (by omega) y (hsub x hx hy)
            _ ≤ max M₀ 0 * ‖x - x₀‖ ^ j :=
                mul_le_mul_of_nonneg_left
                  (pow_le_pow_left₀ (norm_nonneg _) (hynorm x y hy) j) hM0)
        (convex_closedBall x₀ ‖x - x₀‖) (hx0mem x) (hxmem x)
      rw [hzero, sub_zero] at hmvt
      calc ‖iteratedFDeriv ℝ (K - (j + 1) + 1) u x‖
          ≤ max M₀ 0 * ‖x - x₀‖ ^ j * ‖x - x₀‖ := hmvt
        _ = max M₀ 0 * ‖x - x₀‖ ^ (j + 1) := by ring
  have hgrad : ∀ x ∈ Metric.closedBall x₀ (min (ε / 2) 1),
      ‖fderiv ℝ u x‖ ≤ max M₀ 0 * ‖x - x₀‖ ^ K := by
    intro x hx
    have h1 := hind K le_rfl x hx
    rw [Nat.sub_self, zero_add, norm_iteratedFDeriv_one] at h1
    exact h1
  refine ⟨max M₀ 0, hM0, fun x hx => ⟨?_, hgrad x hx⟩⟩
  have hmvt := Convex.norm_image_sub_le_of_norm_fderiv_le (f := u)
    (C := max M₀ 0 * ‖x - x₀‖ ^ K)
    (fun y hy => hDu y (hsub x hx hy))
    (fun y hy => (hgrad y (hsub x hx hy)).trans
      (mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _) (hynorm x y hy) K) hM0))
    (convex_closedBall x₀ ‖x - x₀‖) (hx0mem x) (hxmem x)
  rw [Real.norm_eq_abs] at hmvt
  have hxr : ‖x - x₀‖ ≤ min (ε / 2) 1 := by
    rw [Metric.mem_closedBall, dist_eq_norm] at hx
    exact hx
  have hr1 : ‖x - x₀‖ ≤ 1 := hxr.trans hρ1
  calc |u x - u x₀| ≤ max M₀ 0 * ‖x - x₀‖ ^ K * ‖x - x₀‖ := hmvt
    _ ≤ max M₀ 0 * ‖x - x₀‖ ^ K * 1 :=
        mul_le_mul_of_nonneg_left hr1 (mul_nonneg hM0 (pow_nonneg (norm_nonneg _) _))
    _ = max M₀ 0 * ‖x - x₀‖ ^ K := mul_one _

theorem frequency_ode_vanish (T C : ℝ) (hC : 0 ≤ C) (H D X Y Q g q : ℝ → ℝ)
    (hH0 : ∀ t < T, 0 ≤ H t) (hX0 : ∀ t < T, 0 ≤ X t) (hY0 : ∀ t < T, 0 ≤ Y t)
    (hCS : ∀ t < T, D t ^ 2 ≤ H t * X t)
    (hHd : ∀ t < T, HasDerivAt H (2 * D t + g t) t)
    (hg : ∀ t < T, |g t| ≤ C * Real.exp t * H t)
    (hDd : ∀ t < T, HasDerivAt D (X t + Y t) t)
    (hQ : ∀ t < T, Q t = X t - Y t)
    (hQd : ∀ t < T, HasDerivAt Q (q t) t)
    (hq : ∀ t < T, |q t| ≤ C * Real.exp t * (X t + Y t))
    (hDlim : Tendsto D atBot (𝓝 0)) (hQlim : Tendsto Q atBot (𝓝 0))
    (hdecay : ∀ K : ℕ, ∃ CK : ℝ, ∀ t < T, H t ≤ CK * Real.exp (K * t)) :
    ∀ t < T, H t = 0 :=
by
  
  have hD0 : ∀ t < T, 0 ≤ D t := by
    intro t ht
    have hmono : MonotoneOn D (Set.Iic t) := by
      apply monotoneOn_of_hasDerivWithinAt_nonneg (f' := fun r => X r + Y r) (convex_Iic t)
      · intro r hr
        exact (hDd r (lt_of_le_of_lt hr ht)).continuousAt.continuousWithinAt
      · intro r hr
        rw [interior_Iic] at hr
        exact (hDd r (lt_trans hr ht)).hasDerivWithinAt
      · intro r hr
        rw [interior_Iic] at hr
        have hrT := lt_trans hr ht
        beta_reduce
        linarith [hX0 r hrT, hY0 r hrT]
    have hev : ∀ᶠ s in atBot, D s ≤ D t := by
      filter_upwards [eventually_le_atBot t] with s hs
      exact hmono hs (Set.mem_Iic.mpr le_rfl) hs
    exact le_of_tendsto hDlim hev
  
  have hrel : ∀ t < T, ∀ σ : ℝ, (σ = 1 ∨ σ = -1) → σ * Q t ≤ C * Real.exp t * D t := by
    intro t ht σ hσ
    have hanti : AntitoneOn (fun r => σ * Q r - C * Real.exp t * D r) (Set.Iic t) := by
      apply antitoneOn_of_hasDerivWithinAt_nonpos
        (f' := fun r => σ * q r - C * Real.exp t * (X r + Y r)) (convex_Iic t)
      · intro r hr
        have hrT := lt_of_le_of_lt hr ht
        exact (((hQd r hrT).const_mul σ).sub
          ((hDd r hrT).const_mul (C * Real.exp t))).continuousAt.continuousWithinAt
      · intro r hr
        rw [interior_Iic] at hr
        have hrT := lt_trans hr ht
        exact (((hQd r hrT).const_mul σ).sub
          ((hDd r hrT).const_mul (C * Real.exp t))).hasDerivWithinAt
      · intro r hr
        rw [interior_Iic] at hr
        have hrT := lt_trans hr ht
        have h1 : σ * q r ≤ |q r| := by
          rcases hσ with h | h
          · rw [h, one_mul]; exact le_abs_self _
          · rw [h, neg_one_mul]; exact neg_le_abs _
        have h2 := hq r hrT
        have h3 : Real.exp r ≤ Real.exp t := Real.exp_le_exp.mpr hr.le
        have h4 : 0 ≤ X r + Y r := by linarith [hX0 r hrT, hY0 r hrT]
        have h5 : C * Real.exp r * (X r + Y r) ≤ C * Real.exp t * (X r + Y r) := by
          apply mul_le_mul_of_nonneg_right _ h4
          exact mul_le_mul_of_nonneg_left h3 hC
        beta_reduce
        linarith
    have hlim : Tendsto (fun r => σ * Q r - C * Real.exp t * D r) atBot (𝓝 0) := by
      have := (hQlim.const_mul σ).sub (hDlim.const_mul (C * Real.exp t))
      rwa [mul_zero, mul_zero, sub_zero] at this
    have hev : ∀ᶠ s in atBot, σ * Q t - C * Real.exp t * D t ≤ σ * Q s - C * Real.exp t * D s := by
      filter_upwards [eventually_le_atBot t] with s hs
      exact hanti hs (Set.mem_Iic.mpr le_rfl) hs
    have := ge_of_tendsto hlim hev
    linarith
  have hXY : ∀ t < T, |X t - Y t| ≤ C * Real.exp t * D t := by
    intro t ht
    have h1 := hrel t ht 1 (Or.inl rfl)
    have h2 := hrel t ht (-1) (Or.inr rfl)
    rw [← hQ t ht, abs_le]
    constructor <;> linarith
  
  intro t₀ ht₀
  refine le_antisymm ?_ (hH0 t₀ ht₀)
  by_contra hneg
  push_neg at hneg
  obtain ⟨N₀, hN₀⟩ : ∃ N₀, N₀ = D t₀ / H t₀ * Real.exp (2 * C * Real.exp t₀) := ⟨_, rfl⟩
  obtain ⟨L, hLdef⟩ : ∃ L, L = 2 * N₀ + C * Real.exp t₀ := ⟨_, rfl⟩
  have hN₀0 : 0 ≤ N₀ := by
    rw [hN₀]
    exact mul_nonneg (div_nonneg (hD0 t₀ ht₀) hneg.le) (Real.exp_pos _).le
  have hL0 : 0 ≤ L := by
    rw [hLdef]
    exact add_nonneg (by linarith) (mul_nonneg hC (Real.exp_pos _).le)
  
  have himp : ∀ a ≤ t₀, (∀ r ∈ Set.Icc a t₀, 0 < H r) →
      H t₀ * Real.exp (L * (a - t₀)) ≤ H a := by
    intro a hat hpos
    have hT : ∀ r ∈ Set.Icc a t₀, r < T := fun r hr => lt_of_le_of_lt hr.2 ht₀
    have hNd : ∀ r ∈ Set.Icc a t₀, HasDerivAt (fun s => D s / H s * Real.exp (2 * C * Real.exp s))
        (((X r + Y r) * H r - D r * (2 * D r + g r)) / H r ^ 2 * Real.exp (2 * C * Real.exp r)
          + D r / H r * (Real.exp (2 * C * Real.exp r) * (2 * C * Real.exp r))) r := by
      intro r hr
      have h1 := (hDd r (hT r hr)).div (hHd r (hT r hr)) (hpos r hr).ne'
      have h2 := ((Real.hasDerivAt_exp r).const_mul (2 * C)).exp
      exact h1.mul h2
    have hNd_nonneg : ∀ r ∈ Set.Icc a t₀, 0 ≤
        ((X r + Y r) * H r - D r * (2 * D r + g r)) / H r ^ 2 * Real.exp (2 * C * Real.exp r)
          + D r / H r * (Real.exp (2 * C * Real.exp r) * (2 * C * Real.exp r)) := by
      intro r hr
      have hrT := hT r hr
      have hHr := hpos r hr
      have hHne := hHr.ne'
      have hDr := hD0 r hrT
      obtain ⟨hxy1, hxy2⟩ := abs_le.1 (hXY r hrT)
      obtain ⟨hg1, hg2⟩ := abs_le.1 (hg r hrT)
      have p1 : 0 ≤ (C * Real.exp r * D r - (X r - Y r)) * H r := mul_nonneg (by linarith) hHr.le
      have p2 : 0 ≤ D r * (C * Real.exp r * H r - g r) := mul_nonneg hDr (by linarith)
      have hCSr := hCS r hrT
      have hΦ : 0 ≤ (X r + Y r) * H r - D r * (2 * D r + g r)
          + 2 * (C * Real.exp r) * D r * H r := by nlinarith
      have heq : ((X r + Y r) * H r - D r * (2 * D r + g r)) / H r ^ 2
            * Real.exp (2 * C * Real.exp r)
          + D r / H r * (Real.exp (2 * C * Real.exp r) * (2 * C * Real.exp r))
          = Real.exp (2 * C * Real.exp r) * ((X r + Y r) * H r - D r * (2 * D r + g r)
            + 2 * (C * Real.exp r) * D r * H r) / H r ^ 2 := by
        field_simp
      rw [heq]
      exact div_nonneg (mul_nonneg (Real.exp_pos _).le hΦ) (sq_nonneg _)
    have hNmono : MonotoneOn (fun s => D s / H s * Real.exp (2 * C * Real.exp s))
        (Set.Icc a t₀) := by
      apply monotoneOn_of_hasDerivWithinAt_nonneg
        (f' := fun r => ((X r + Y r) * H r - D r * (2 * D r + g r)) / H r ^ 2
          * Real.exp (2 * C * Real.exp r)
          + D r / H r * (Real.exp (2 * C * Real.exp r) * (2 * C * Real.exp r)))
        (convex_Icc a t₀)
      · intro r hr
        exact (hNd r hr).continuousAt.continuousWithinAt
      · intro r hr
        rw [interior_Icc] at hr
        exact (hNd r (Set.Ioo_subset_Icc_self hr)).hasDerivWithinAt
      · intro r hr
        rw [interior_Icc] at hr
        exact hNd_nonneg r (Set.Ioo_subset_Icc_self hr)
    have hDle : ∀ r ∈ Set.Icc a t₀, D r ≤ N₀ * H r := by
      intro r hr
      have h1 : D r / H r * Real.exp (2 * C * Real.exp r)
          ≤ D t₀ / H t₀ * Real.exp (2 * C * Real.exp t₀) :=
        hNmono hr (Set.right_mem_Icc.2 hat) hr.2
      have hE1 : 1 ≤ Real.exp (2 * C * Real.exp r) :=
        Real.one_le_exp (mul_nonneg (mul_nonneg (by norm_num) hC) (Real.exp_pos r).le)
      have hN0 : 0 ≤ D r / H r := div_nonneg (hD0 r (hT r hr)) (hpos r hr).le
      have h2 : D r / H r ≤ N₀ := by
        calc D r / H r = D r / H r * 1 := (mul_one _).symm
          _ ≤ D r / H r * Real.exp (2 * C * Real.exp r) := mul_le_mul_of_nonneg_left hE1 hN0
          _ ≤ N₀ := h1.trans (le_of_eq hN₀.symm)
      rwa [div_le_iff₀ (hpos r hr)] at h2
    have h2Dg : ∀ r ∈ Set.Icc a t₀, 2 * D r + g r ≤ L * H r := by
      intro r hr
      have h1 := hDle r hr
      have h2 := (abs_le.1 (hg r (hT r hr))).2
      have h3 : C * Real.exp r * H r ≤ C * Real.exp t₀ * H r :=
        mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left (Real.exp_le_exp.2 hr.2) hC)
          (hpos r hr).le
      rw [hLdef]
      nlinarith
    have hGd : ∀ r ∈ Set.Icc a t₀, HasDerivAt (fun s => H s * Real.exp (-L * s))
        ((2 * D r + g r) * Real.exp (-L * r) + H r * (Real.exp (-L * r) * (-L * 1))) r := by
      intro r hr
      exact (hHd r (hT r hr)).mul (((hasDerivAt_id' r).const_mul (-L)).exp)
    have hGanti : AntitoneOn (fun s => H s * Real.exp (-L * s)) (Set.Icc a t₀) := by
      apply antitoneOn_of_hasDerivWithinAt_nonpos
        (f' := fun r => (2 * D r + g r) * Real.exp (-L * r) + H r * (Real.exp (-L * r) * (-L * 1)))
        (convex_Icc a t₀)
      · intro r hr
        exact (hGd r hr).continuousAt.continuousWithinAt
      · intro r hr
        rw [interior_Icc] at hr
        exact (hGd r (Set.Ioo_subset_Icc_self hr)).hasDerivWithinAt
      · intro r hr
        rw [interior_Icc] at hr
        have hr' := Set.Ioo_subset_Icc_self hr
        have hle := h2Dg r hr'
        have he := Real.exp_pos (-L * r)
        have := mul_le_mul_of_nonneg_left hle he.le
        beta_reduce
        nlinarith
    have key : H t₀ * Real.exp (-L * t₀) ≤ H a * Real.exp (-L * a) :=
      hGanti (Set.left_mem_Icc.2 hat) (Set.right_mem_Icc.2 hat) hat
    have e1 : Real.exp (L * (a - t₀)) = Real.exp (-L * t₀) * Real.exp (L * a) := by
      rw [← Real.exp_add]; congr 1; ring
    have e2 : Real.exp (-L * a) * Real.exp (L * a) = 1 := by
      rw [← Real.exp_add, show -L * a + L * a = 0 by ring, Real.exp_zero]
    calc H t₀ * Real.exp (L * (a - t₀))
        = (H t₀ * Real.exp (-L * t₀)) * Real.exp (L * a) := by rw [e1]; ring
      _ ≤ (H a * Real.exp (-L * a)) * Real.exp (L * a) :=
          mul_le_mul_of_nonneg_right key (Real.exp_pos _).le
      _ = H a := by rw [mul_assoc, e2, mul_one]
  
  have hposAll : ∀ a ≤ t₀, ∀ r ∈ Set.Icc a t₀, 0 < H r := by
    intro a hat
    by_contra hcon
    push_neg at hcon
    obtain ⟨r₀, hr₀, hHr₀⟩ := hcon
    have hHc : ContinuousOn H (Set.Icc a t₀) := fun r hr =>
      (hHd r (lt_of_le_of_lt hr.2 ht₀)).continuousAt.continuousWithinAt
    have hZc : IsClosed (Set.Icc a t₀ ∩ H ⁻¹' Set.Iic 0) :=
      hHc.preimage_isClosed_of_isClosed isClosed_Icc isClosed_Iic
    have hZne : (Set.Icc a t₀ ∩ H ⁻¹' Set.Iic 0).Nonempty := ⟨r₀, hr₀, hHr₀⟩
    have hZbdd : BddAbove (Set.Icc a t₀ ∩ H ⁻¹' Set.Iic 0) := ⟨t₀, fun r hr => hr.1.2⟩
    have hsZ := hZc.csSup_mem hZne hZbdd
    obtain ⟨s, hs⟩ : ∃ s, s = sSup (Set.Icc a t₀ ∩ H ⁻¹' Set.Iic 0) := ⟨_, rfl⟩
    rw [← hs] at hsZ
    have hs2 : s ≤ t₀ := hsZ.1.2
    have hHs : H s ≤ 0 := hsZ.2
    have hst : s < t₀ := lt_of_le_of_ne hs2 (fun h => by rw [h] at hHs; linarith)
    have hposR : ∀ r ∈ Set.Ioc s t₀, 0 < H r := by
      intro r hr
      by_contra hle
      push_neg at hle
      have hmem : r ∈ Set.Icc a t₀ ∩ H ⁻¹' Set.Iic 0 :=
        ⟨⟨by linarith [hr.1, hsZ.1.1], hr.2⟩, hle⟩
      have := le_csSup hZbdd hmem
      rw [← hs] at this
      linarith [hr.1]
    have hm : 0 < H t₀ * Real.exp (L * (s - t₀)) := mul_pos hneg (Real.exp_pos _)
    have hlow : ∀ r ∈ Set.Ioo s t₀, H t₀ * Real.exp (L * (s - t₀)) ≤ H r := by
      intro r hr
      have h1 := himp r hr.2.le (fun x hx => hposR x ⟨lt_of_lt_of_le hr.1 hx.1, hx.2⟩)
      have h2 : Real.exp (L * (s - t₀)) ≤ Real.exp (L * (r - t₀)) :=
        Real.exp_le_exp.2 (mul_le_mul_of_nonneg_left (by linarith [hr.1]) hL0)
      calc H t₀ * Real.exp (L * (s - t₀)) ≤ H t₀ * Real.exp (L * (r - t₀)) :=
            mul_le_mul_of_nonneg_left h2 hneg.le
        _ ≤ H r := h1
    have hcont : Tendsto H (𝓝[>] s) (𝓝 (H s)) :=
      (hHd s (lt_trans hst ht₀)).continuousAt.continuousWithinAt.tendsto
    have hev : ∀ᶠ r in 𝓝[>] s, H t₀ * Real.exp (L * (s - t₀)) ≤ H r := by
      filter_upwards [Ioo_mem_nhdsGT hst] with r hr using hlow r hr
    have := ge_of_tendsto hcont hev
    linarith
  have hlowAll : ∀ a ≤ t₀, H t₀ * Real.exp (L * (a - t₀)) ≤ H a :=
    fun a hat => himp a hat (hposAll a hat)
  
  obtain ⟨CK, hCK⟩ := hdecay (⌈L⌉₊ + 1)
  obtain ⟨K, hK⟩ : ∃ K : ℝ, K = ((⌈L⌉₊ + 1 : ℕ) : ℝ) := ⟨_, rfl⟩
  rw [← hK] at hCK
  have hKL : 0 < K - L := by
    have h1 := Nat.le_ceil L
    have h2 : K = (⌈L⌉₊ : ℝ) + 1 := by rw [hK]; push_cast; ring
    linarith
  have hbound : ∀ r ≤ t₀, H t₀ ≤ CK * Real.exp (L * t₀) * Real.exp ((K - L) * r) := by
    intro r hr
    have h1 := hlowAll r hr
    have h2 := hCK r (lt_of_le_of_lt hr ht₀)
    have e : Real.exp (K * r) =
        Real.exp (L * t₀) * Real.exp ((K - L) * r) * Real.exp (L * (r - t₀)) := by
      rw [← Real.exp_add, ← Real.exp_add]; congr 1; ring
    have hE := Real.exp_pos (L * (r - t₀))
    have h3 : H t₀ * Real.exp (L * (r - t₀)) ≤
        CK * Real.exp (L * t₀) * Real.exp ((K - L) * r) * Real.exp (L * (r - t₀)) := by
      calc H t₀ * Real.exp (L * (r - t₀)) ≤ H r := h1
        _ ≤ CK * Real.exp (K * r) := h2
        _ = _ := by rw [e]; ring
    exact le_of_mul_le_mul_right h3 hE
  have hlim : Tendsto (fun r => CK * Real.exp (L * t₀) * Real.exp ((K - L) * r)) atBot (𝓝 0) := by
    have h1 : Tendsto (fun r : ℝ => (K - L) * r) atBot atBot :=
      tendsto_id.const_mul_atBot hKL
    have h2 := (Real.tendsto_exp_atBot.comp h1).const_mul (CK * Real.exp (L * t₀))
    rw [mul_zero] at h2
    exact h2
  have hev : ∀ᶠ r in atBot, H t₀ ≤ CK * Real.exp (L * t₀) * Real.exp ((K - L) * r) := by
    filter_upwards [eventually_le_atBot t₀] with r hr using hbound r hr
  have := ge_of_tendsto hlim hev
  linarith

theorem cyl_coeff_field_facts (V : Set E2) (hV : IsOpen V) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) V)
    (hpos : ∀ x ∈ V, (h x).PosDef) :
    (∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => cylA h x i j) V) ∧
    (∀ x ∈ V, ∀ i j : Fin 2, cylA h x i j = cylA h x j i) ∧
    (∀ x ∈ V, cylA h x 0 0 * cylA h x 1 1 - cylA h x 0 1 ^ 2 = 1) ∧
    (∀ x ∈ V, 0 < cylA h x 0 0) :=
by
  have hdpos : ∀ x ∈ V, 0 < (h x).det := fun x hx => (hpos x hx).det_pos
  have hdetC : ContDiffOn ℝ ∞ (fun x => (h x).det) V := by
    have : (fun x => (h x).det) = fun x => h x 0 0 * h x 1 1 - h x 0 1 * h x 1 0 :=
      funext fun x => Matrix.det_fin_two _
    rw [this]
    exact ((hh 0 0).mul (hh 1 1)).sub ((hh 0 1).mul (hh 1 0))
  have hsC : ContDiffOn ℝ ∞ (fun x => Real.sqrt (h x).det) V :=
    hdetC.sqrt (fun x hx => (hdpos x hx).ne')
  have hdinvC : ContDiffOn ℝ ∞ (fun x => ((h x).det)⁻¹) V :=
    hdetC.inv (fun x hx => (hdpos x hx).ne')
  have hadjC : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => (h x).adjugate a b) V := by
    intro a b
    have : (fun x => (h x).adjugate a b) =
        fun x => !![h x 1 1, -h x 0 1; -h x 1 0, h x 0 0] a b :=
      funext fun x => by rw [Matrix.adjugate_fin_two]
    rw [this]
    fin_cases a <;> fin_cases b <;> simp <;> first | exact hh _ _ | exact (hh _ _).neg
  have hinvC : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => (h x)⁻¹ a b) V := by
    intro a b
    have : (fun x => (h x)⁻¹ a b) = fun x => ((h x).det)⁻¹ * (h x).adjugate a b :=
      funext fun x => by rw [Matrix.inv_def, Matrix.smul_apply, Ring.inverse_eq_inv, smul_eq_mul]
    rw [this]
    exact hdinvC.mul (hadjC a b)
  have hsym : ∀ x ∈ V, ∀ i j : Fin 2, (h x)⁻¹ i j = (h x)⁻¹ j i := by
    intro x hx i j
    have hH : ((h x)⁻¹).IsHermitian := (hpos x hx).isHermitian.inv
    have := hH.apply i j
    simpa using this.symm
  have hsymA : ∀ x ∈ V, ∀ i j : Fin 2, cylA h x i j = cylA h x j i := by
    intro x hx i j
    simp only [cylA, hsym x hx i j]
  refine ⟨?_, hsymA, ?_, ?_⟩
  · intro i j
    exact hsC.mul (hinvC i j)
  · intro x hx
    have hd : 0 < (h x).det := hdpos x hx
    have hdet1 : (Real.sqrt (h x).det • (h x)⁻¹).det = 1 := by
      rw [Matrix.det_smul, Matrix.det_nonsing_inv, Ring.inverse_eq_inv, Fintype.card_fin,
        Real.sq_sqrt hd.le]
      exact mul_inv_cancel₀ hd.ne'
    rw [Matrix.det_fin_two] at hdet1
    simp only [Matrix.smul_apply, smul_eq_mul] at hdet1
    have h10 := hsymA x hx 1 0
    simp only [cylA] at h10 ⊢
    rw [h10] at hdet1
    rw [sq]
    exact hdet1
  · intro x hx
    exact mul_pos (Real.sqrt_pos.mpr (hdpos x hx)) (hpos x hx).inv.diag_pos

theorem cyl_polar_div_pullback (P : Matrix (Fin 2) (Fin 2) ℝ) (x₀ : E2) (F₀ F₁ : E2 → ℝ)
    (p : ℝ × ℝ) (h0 : DifferentiableAt ℝ F₀ (cylPhi x₀ P p))
    (h1 : DifferentiableAt ℝ F₁ (cylPhi x₀ P p)) :
    fplDt (fun q => Real.exp q.1 * (Real.cos q.2 * (P 1 1 * F₀ (cylPhi x₀ P q) -
        P 0 1 * F₁ (cylPhi x₀ P q)) + Real.sin q.2 * (-P 1 0 * F₀ (cylPhi x₀ P q) +
        P 0 0 * F₁ (cylPhi x₀ P q)))) p +
      fplDs (fun q => Real.exp q.1 * (-Real.sin q.2 * (P 1 1 * F₀ (cylPhi x₀ P q) -
        P 0 1 * F₁ (cylPhi x₀ P q)) + Real.cos q.2 * (-P 1 0 * F₀ (cylPhi x₀ P q) +
        P 0 0 * F₁ (cylPhi x₀ P q)))) p =
    Real.exp (2 * p.1) * (P 0 0 * P 1 1 - P 0 1 * P 1 0) *
      (pd2 0 F₀ (cylPhi x₀ P p) + pd2 1 F₁ (cylPhi x₀ P p)) :=
by
  have hexp : HasFDerivAt (fun q : ℝ × ℝ => Real.exp q.1)
      (Real.exp p.1 • ContinuousLinearMap.fst ℝ ℝ ℝ) p :=
    (Real.hasDerivAt_exp p.1).comp_hasFDerivAt p hasFDerivAt_fst
  have hcos : HasFDerivAt (fun q : ℝ × ℝ => Real.cos q.2)
      ((-Real.sin p.2) • ContinuousLinearMap.snd ℝ ℝ ℝ) p :=
    (Real.hasDerivAt_cos p.2).comp_hasFDerivAt p hasFDerivAt_snd
  have hsin : HasFDerivAt (fun q : ℝ × ℝ => Real.sin q.2)
      (Real.cos p.2 • ContinuousLinearMap.snd ℝ ℝ ℝ) p :=
    (Real.hasDerivAt_sin p.2).comp_hasFDerivAt p hasFDerivAt_snd
  have hΦeq : cylPhi x₀ P = fun q => x₀ +
      ((Real.exp q.1 * (P 0 0 * Real.cos q.2 + P 0 1 * Real.sin q.2)) • e2 0 +
        (Real.exp q.1 * (P 1 0 * Real.cos q.2 + P 1 1 * Real.sin q.2)) • e2 1) := by
    funext q
    ext i
    fin_cases i <;> simp [cylPhi, e2, EuclideanSpace.single_apply]
  obtain ⟨Φ', hΦ, hΦt, hΦs⟩ : ∃ Φ' : ℝ × ℝ →L[ℝ] E2, HasFDerivAt (cylPhi x₀ P) Φ' p ∧
      Φ' (1, 0) = (Real.exp p.1 * (P 0 0 * Real.cos p.2 + P 0 1 * Real.sin p.2)) • e2 0 +
        (Real.exp p.1 * (P 1 0 * Real.cos p.2 + P 1 1 * Real.sin p.2)) • e2 1 ∧
      Φ' (0, 1) = (Real.exp p.1 * (-P 0 0 * Real.sin p.2 + P 0 1 * Real.cos p.2)) • e2 0 +
        (Real.exp p.1 * (-P 1 0 * Real.sin p.2 + P 1 1 * Real.cos p.2)) • e2 1 := by
    have hc0 := hexp.fun_mul ((hcos.const_mul (P 0 0)).fun_add (hsin.const_mul (P 0 1)))
    have hc1 := hexp.fun_mul ((hcos.const_mul (P 1 0)).fun_add (hsin.const_mul (P 1 1)))
    have hsum := ((hc0.smul_const (e2 0)).add (hc1.smul_const (e2 1))).const_add x₀
    rw [hΦeq]
    refine ⟨_, hsum, ?_, ?_⟩
    · ext i
      fin_cases i <;> simp [e2, EuclideanSpace.single_apply] <;> ring
    · ext i
      fin_cases i <;> simp [e2, EuclideanSpace.single_apply] <;> ring
  have hf0 := h0.hasFDerivAt.comp p hΦ
  have hf1 := h1.hasFDerivAt.comp p hΦ
  have hG0 := (hf0.const_mul (P 1 1)).fun_sub (hf1.const_mul (P 0 1))
  have hG1 := (hf0.const_mul (-P 1 0)).fun_add (hf1.const_mul (P 0 0))
  have hW0 : HasFDerivAt (fun q => Real.exp q.1 * (Real.cos q.2 * (P 1 1 * F₀ (cylPhi x₀ P q) -
        P 0 1 * F₁ (cylPhi x₀ P q)) + Real.sin q.2 * (-P 1 0 * F₀ (cylPhi x₀ P q) +
        P 0 0 * F₁ (cylPhi x₀ P q)))) _ p :=
    hexp.fun_mul ((hcos.fun_mul hG0).fun_add (hsin.fun_mul hG1))
  have hW1 : HasFDerivAt (fun q => Real.exp q.1 * (-Real.sin q.2 * (P 1 1 * F₀ (cylPhi x₀ P q) -
        P 0 1 * F₁ (cylPhi x₀ P q)) + Real.cos q.2 * (-P 1 0 * F₀ (cylPhi x₀ P q) +
        P 0 0 * F₁ (cylPhi x₀ P q)))) _ p :=
    hexp.fun_mul ((hsin.neg.fun_mul hG0).fun_add (hcos.fun_mul hG1))
  have hX : Real.exp (2 * p.1) = Real.exp p.1 * Real.exp p.1 := by
    rw [two_mul, Real.exp_add]
  have hCS := Real.cos_sq_add_sin_sq p.2
  unfold fplDt fplDs
  rw [hW0.fderiv, hW1.fderiv]
  simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.sub_apply,
    ContinuousLinearMap.neg_apply, ContinuousLinearMap.smul_apply,
    ContinuousLinearMap.coe_comp', Function.comp_apply, ContinuousLinearMap.coe_fst',
    ContinuousLinearMap.coe_snd', smul_eq_mul, hΦt, hΦs, map_add, map_smul, pd2, Pi.neg_apply]
  linear_combination (Real.exp p.1 ^ 2 * (P 0 0 * P 1 1 - P 0 1 * P 1 0) *
      (fderiv ℝ F₀ (cylPhi x₀ P p) (e2 0) + fderiv ℝ F₁ (cylPhi x₀ P p) (e2 1))) * hCS -
    ((P 0 0 * P 1 1 - P 0 1 * P 1 0) *
      (fderiv ℝ F₀ (cylPhi x₀ P p) (e2 0) + fderiv ℝ F₁ (cylPhi x₀ P p) (e2 1))) * hX

theorem cyl_polar_grad_chain (x₀ : E2) (P : Matrix (Fin 2) (Fin 2) ℝ) :
    ContDiff ℝ ∞ (cylPhi x₀ P) ∧
    (∀ t θ : ℝ, cylPhi x₀ P (t, θ + 2 * Real.pi) = cylPhi x₀ P (t, θ)) ∧
    (∀ p : ℝ × ℝ, ‖cylPhi x₀ P p - x₀‖ ≤
      (|P 0 0| + |P 0 1| + |P 1 0| + |P 1 1|) * Real.exp p.1) ∧
    ∀ (v : E2 → ℝ) (p : ℝ × ℝ), DifferentiableAt ℝ v (cylPhi x₀ P p) →
      fplDt (fun q => v (cylPhi x₀ P q)) p = Real.exp p.1 *
        ((P 0 0 * Real.cos p.2 + P 0 1 * Real.sin p.2) * pd2 0 v (cylPhi x₀ P p) +
          (P 1 0 * Real.cos p.2 + P 1 1 * Real.sin p.2) * pd2 1 v (cylPhi x₀ P p)) ∧
      fplDs (fun q => v (cylPhi x₀ P q)) p = Real.exp p.1 *
        ((-P 0 0 * Real.sin p.2 + P 0 1 * Real.cos p.2) * pd2 0 v (cylPhi x₀ P p) +
          (-P 1 0 * Real.sin p.2 + P 1 1 * Real.cos p.2) * pd2 1 v (cylPhi x₀ P p)) ∧
      |fplDt (fun q => v (cylPhi x₀ P q)) p| ≤
        (|P 0 0| + |P 0 1| + |P 1 0| + |P 1 1|) * Real.exp p.1 * ‖fderiv ℝ v (cylPhi x₀ P p)‖ ∧
      |fplDs (fun q => v (cylPhi x₀ P q)) p| ≤
        (|P 0 0| + |P 0 1| + |P 1 0| + |P 1 1|) * Real.exp p.1 * ‖fderiv ℝ v (cylPhi x₀ P p)‖ :=
by
  
  have hsmooth : ContDiff ℝ ∞ (cylPhi x₀ P) := by
    have h1 : ContDiff ℝ ∞ (fun q : ℝ × ℝ =>
        (fun i : Fin 2 => P i 0 * Real.cos q.2 + P i 1 * Real.sin q.2)) := by
      refine contDiff_pi.2 (fun i => ?_)
      exact (contDiff_const.mul (Real.contDiff_cos.comp contDiff_snd)).add
        (contDiff_const.mul (Real.contDiff_sin.comp contDiff_snd))
    unfold cylPhi
    exact contDiff_const.add ((Real.contDiff_exp.comp contDiff_fst).smul
      ((EuclideanSpace.equiv (Fin 2) ℝ).symm.contDiff.comp h1))
  have hdiff : ∀ p : ℝ × ℝ, DifferentiableAt ℝ (cylPhi x₀ P) p :=
    fun p => hsmooth.differentiable (by simp) p
  
  have hbasis : ∀ w : Fin 2 → ℝ,
      (EuclideanSpace.equiv (Fin 2) ℝ).symm w = w 0 • e2 0 + w 1 • e2 1 := by
    intro w
    refine PiLp.ext (fun i => ?_)
    rw [show ((EuclideanSpace.equiv (Fin 2) ℝ).symm w).ofLp i = w i from rfl]
    fin_cases i <;> simp [e2, EuclideanSpace.single_apply]
  have hlin : ∀ (D : E2 →L[ℝ] ℝ) (w : Fin 2 → ℝ),
      D ((EuclideanSpace.equiv (Fin 2) ℝ).symm w) = w 0 * D (e2 0) + w 1 * D (e2 1) := by
    intro D w
    rw [hbasis w, map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul]
  have hnormL : ∀ w : Fin 2 → ℝ,
      ‖(EuclideanSpace.equiv (Fin 2) ℝ).symm w‖ ≤ |w 0| + |w 1| := by
    intro w
    rw [hbasis w]
    calc ‖w 0 • e2 0 + w 1 • e2 1‖ ≤ ‖w 0 • e2 0‖ + ‖w 1 • e2 1‖ := norm_add_le _ _
      _ = |w 0| + |w 1| := by simp [norm_smul, e2, EuclideanSpace.norm_single]
  have hcoord : ∀ (D : E2 →L[ℝ] ℝ) (i : Fin 2), |D (e2 i)| ≤ ‖D‖ := by
    intro D i
    have h := D.le_opNorm (e2 i)
    rw [Real.norm_eq_abs] at h
    have he : ‖e2 i‖ = 1 := by simp [e2, EuclideanSpace.norm_single]
    rw [he, mul_one] at h
    exact h
  have htrig : ∀ a b c s : ℝ, |c| ≤ 1 → |s| ≤ 1 → |a * c + b * s| ≤ |a| + |b| := by
    intro a b c s hc hs
    calc |a * c + b * s| ≤ |a * c| + |b * s| := abs_add_le _ _
      _ = |a| * |c| + |b| * |s| := by rw [abs_mul, abs_mul]
      _ ≤ |a| * 1 + |b| * 1 := by gcongr
      _ = |a| + |b| := by ring
  have hbnd : ∀ E A B kA kB g0 g1 N : ℝ, 0 ≤ E → |A| ≤ kA → |B| ≤ kB → |g0| ≤ N → |g1| ≤ N →
      |E * (A * g0 + B * g1)| ≤ (kA + kB) * E * N := by
    intro E A B kA kB g0 g1 N hE hA hB hg0 hg1
    rw [abs_mul, abs_of_nonneg hE]
    have h : |A * g0 + B * g1| ≤ kA * N + kB * N :=
      calc |A * g0 + B * g1| ≤ |A * g0| + |B * g1| := abs_add_le _ _
        _ = |A| * |g0| + |B| * |g1| := by rw [abs_mul, abs_mul]
        _ ≤ kA * N + kB * N := add_le_add
            (mul_le_mul hA hg0 (abs_nonneg _) ((abs_nonneg _).trans hA))
            (mul_le_mul hB hg1 (abs_nonneg _) ((abs_nonneg _).trans hB))
    calc E * |A * g0 + B * g1| ≤ E * (kA * N + kB * N) := mul_le_mul_of_nonneg_left h hE
      _ = (kA + kB) * E * N := by ring
  
  have hdirT : ∀ p : ℝ × ℝ, fderiv ℝ (cylPhi x₀ P) p (1, 0) = Real.exp p.1 •
      (EuclideanSpace.equiv (Fin 2) ℝ).symm (fun i => P i 0 * Real.cos p.2 + P i 1 * Real.sin p.2) := by
    rintro ⟨t, θ⟩
    have hΦ : HasFDerivAt (cylPhi x₀ P) (fderiv ℝ (cylPhi x₀ P) (t, θ)) (t, θ) :=
      (hdiff _).hasFDerivAt
    have hℓ : HasDerivAt (fun τ : ℝ => (τ, θ)) ((1 : ℝ), (0 : ℝ)) t :=
      (hasDerivAt_id' t).prodMk (hasDerivAt_const t θ)
    have h1 : HasDerivAt (cylPhi x₀ P ∘ fun τ : ℝ => (τ, θ))
        (fderiv ℝ (cylPhi x₀ P) (t, θ) (1, 0)) t := hΦ.comp_hasDerivAt t hℓ
    have h2 : HasDerivAt (fun τ : ℝ => x₀ + Real.exp τ • (EuclideanSpace.equiv (Fin 2) ℝ).symm
        (fun i => P i 0 * Real.cos θ + P i 1 * Real.sin θ))
        (Real.exp t • (EuclideanSpace.equiv (Fin 2) ℝ).symm
          (fun i => P i 0 * Real.cos θ + P i 1 * Real.sin θ)) t :=
      ((Real.hasDerivAt_exp t).smul_const _).const_add x₀
    exact h1.unique h2
  have hdirS : ∀ p : ℝ × ℝ, fderiv ℝ (cylPhi x₀ P) p (0, 1) = Real.exp p.1 •
      (EuclideanSpace.equiv (Fin 2) ℝ).symm (fun i => -P i 0 * Real.sin p.2 + P i 1 * Real.cos p.2) := by
    rintro ⟨t, θ⟩
    have hΦ : HasFDerivAt (cylPhi x₀ P) (fderiv ℝ (cylPhi x₀ P) (t, θ)) (t, θ) :=
      (hdiff _).hasFDerivAt
    have hℓ : HasDerivAt (fun τ : ℝ => (t, τ)) ((0 : ℝ), (1 : ℝ)) θ :=
      (hasDerivAt_const θ t).prodMk (hasDerivAt_id' θ)
    have h1 : HasDerivAt (cylPhi x₀ P ∘ fun τ : ℝ => (t, τ))
        (fderiv ℝ (cylPhi x₀ P) (t, θ) (0, 1)) θ := hΦ.comp_hasDerivAt θ hℓ
    have hg : HasDerivAt (fun τ : ℝ => (fun i : Fin 2 => P i 0 * Real.cos τ + P i 1 * Real.sin τ))
        (fun i : Fin 2 => -P i 0 * Real.sin θ + P i 1 * Real.cos θ) θ := by
      refine hasDerivAt_pi.2 (fun i => ?_)
      have := ((Real.hasDerivAt_cos θ).const_mul (P i 0)).add
        ((Real.hasDerivAt_sin θ).const_mul (P i 1))
      convert this using 1
      ring
    have hLg := (EuclideanSpace.equiv (Fin 2) ℝ).symm.hasFDerivAt.comp_hasDerivAt θ hg
    have h2 := (hLg.const_smul (Real.exp t)).const_add x₀
    rw [h1.unique h2, ContinuousLinearEquiv.coe_coe]
  
  have hchain : ∀ (v : E2 → ℝ) (p d : ℝ × ℝ), DifferentiableAt ℝ v (cylPhi x₀ P p) →
      fderiv ℝ (fun q => v (cylPhi x₀ P q)) p d =
        fderiv ℝ v (cylPhi x₀ P p) (fderiv ℝ (cylPhi x₀ P) p d) := by
    intro v p d hv
    rw [fderiv_comp' p hv (hdiff p)]
    rfl
  refine ⟨hsmooth, ?_, ?_, ?_⟩
  · intro t θ
    simp only [cylPhi, Real.cos_add_two_pi, Real.sin_add_two_pi]
  · intro p
    have hsub : cylPhi x₀ P p - x₀ = Real.exp p.1 • (EuclideanSpace.equiv (Fin 2) ℝ).symm
        (fun i => P i 0 * Real.cos p.2 + P i 1 * Real.sin p.2) := by
      simp only [cylPhi, add_sub_cancel_left]
    rw [hsub, norm_smul, Real.norm_eq_abs, abs_of_pos (Real.exp_pos _)]
    have hL := hnormL (fun i => P i 0 * Real.cos p.2 + P i 1 * Real.sin p.2)
    have h0 := htrig (P 0 0) (P 0 1) _ _ (Real.abs_cos_le_one p.2) (Real.abs_sin_le_one p.2)
    have h1 := htrig (P 1 0) (P 1 1) _ _ (Real.abs_cos_le_one p.2) (Real.abs_sin_le_one p.2)
    have hE := Real.exp_pos p.1
    have hk : ‖(EuclideanSpace.equiv (Fin 2) ℝ).symm
        (fun i => P i 0 * Real.cos p.2 + P i 1 * Real.sin p.2)‖ ≤
        |P 0 0| + |P 0 1| + |P 1 0| + |P 1 1| := by
      refine hL.trans ?_
      show |P 0 0 * Real.cos p.2 + P 0 1 * Real.sin p.2| +
        |P 1 0 * Real.cos p.2 + P 1 1 * Real.sin p.2| ≤ _
      linarith
    calc Real.exp p.1 * ‖(EuclideanSpace.equiv (Fin 2) ℝ).symm
          (fun i => P i 0 * Real.cos p.2 + P i 1 * Real.sin p.2)‖
        ≤ Real.exp p.1 * (|P 0 0| + |P 0 1| + |P 1 0| + |P 1 1|) :=
          mul_le_mul_of_nonneg_left hk hE.le
      _ = (|P 0 0| + |P 0 1| + |P 1 0| + |P 1 1|) * Real.exp p.1 := by ring
  · intro v p hv
    have hT : fplDt (fun q => v (cylPhi x₀ P q)) p = Real.exp p.1 *
        ((P 0 0 * Real.cos p.2 + P 0 1 * Real.sin p.2) * pd2 0 v (cylPhi x₀ P p) +
          (P 1 0 * Real.cos p.2 + P 1 1 * Real.sin p.2) * pd2 1 v (cylPhi x₀ P p)) := by
      unfold fplDt
      rw [hchain v p _ hv, hdirT p, map_smul, smul_eq_mul, hlin]
      rfl
    have hS : fplDs (fun q => v (cylPhi x₀ P q)) p = Real.exp p.1 *
        ((-P 0 0 * Real.sin p.2 + P 0 1 * Real.cos p.2) * pd2 0 v (cylPhi x₀ P p) +
          (-P 1 0 * Real.sin p.2 + P 1 1 * Real.cos p.2) * pd2 1 v (cylPhi x₀ P p)) := by
      unfold fplDs
      rw [hchain v p _ hv, hdirS p, map_smul, smul_eq_mul, hlin]
      rfl
    have hE := (Real.exp_pos p.1).le
    have hg0 : |pd2 0 v (cylPhi x₀ P p)| ≤ ‖fderiv ℝ v (cylPhi x₀ P p)‖ := hcoord _ 0
    have hg1 : |pd2 1 v (cylPhi x₀ P p)| ≤ ‖fderiv ℝ v (cylPhi x₀ P p)‖ := hcoord _ 1
    have hc := Real.abs_cos_le_one p.2
    have hs := Real.abs_sin_le_one p.2
    refine ⟨hT, hS, ?_, ?_⟩
    · rw [hT]
      refine (hbnd _ _ _ _ _ _ _ _ hE (htrig (P 0 0) (P 0 1) _ _ hc hs)
        (htrig (P 1 0) (P 1 1) _ _ hc hs) hg0 hg1).trans (le_of_eq ?_)
      ring
    · rw [hS]
      have hA := htrig (-P 0 0) (P 0 1) _ _ hs hc
      have hB := htrig (-P 1 0) (P 1 1) _ _ hs hc
      rw [abs_neg] at hA hB
      refine (hbnd _ _ _ _ _ _ _ _ hE hA hB hg0 hg1).trans (le_of_eq ?_)
      ring

theorem cyl_rotated_coeff_bounds (M00 M01 M11 : ℝ × ℝ → ℝ) (p : ℝ × ℝ) (η : ℝ) (hη : 0 ≤ η)
    (hd0 : DifferentiableAt ℝ M00 p) (hd1 : DifferentiableAt ℝ M01 p)
    (hd2 : DifferentiableAt ℝ M11 p)
    (hb0 : |M00 p - 1| ≤ η) (hb1 : |M01 p| ≤ η) (hb2 : |M11 p - 1| ≤ η)
    (ht0 : |fplDt M00 p| ≤ η) (ht1 : |fplDt M01 p| ≤ η) (ht2 : |fplDt M11 p| ≤ η)
    (hs0 : |fplDs M00 p| ≤ η) (hs1 : |fplDs M01 p| ≤ η) (hs2 : |fplDs M11 p| ≤ η) :
    |cylRotA p.2 (M00 p) (M01 p) (M11 p) - 1| ≤ 2 * η ∧
    |cylRotB p.2 (M00 p) (M01 p) (M11 p)| ≤ 2 * η ∧
    |fplDt (fun q => cylRotA q.2 (M00 q) (M01 q) (M11 q)) p| ≤ 2 * η ∧
    |fplDt (fun q => cylRotB q.2 (M00 q) (M01 q) (M11 q)) p| ≤ 2 * η ∧
    |fplDs (fun q => cylRotA q.2 (M00 q) (M01 q) (M11 q)) p| ≤ 6 * η ∧
    |fplDs (fun q => cylRotB q.2 (M00 q) (M01 q) (M11 q)) p| ≤ 6 * η ∧
    cylRotA p.2 (M00 p) (M01 p) (M11 p) * cylRotC p.2 (M00 p) (M01 p) (M11 p) -
      cylRotB p.2 (M00 p) (M01 p) (M11 p) ^ 2 = M00 p * M11 p - M01 p ^ 2 :=
by
  have hCS : Real.cos p.2 ^ 2 + Real.sin p.2 ^ 2 = 1 := Real.cos_sq_add_sin_sq p.2
  
  have key : ∀ C S : ℝ, C ^ 2 + S ^ 2 = 1 → ∀ d0 d1 d2 : ℝ, |d0| ≤ η → |d1| ≤ η → |d2| ≤ η →
      |C ^ 2 * d0 + 2 * C * S * d1 + S ^ 2 * d2| ≤ 2 * η ∧
      |-(C * S * d0) + (C ^ 2 - S ^ 2) * d1 + C * S * d2| ≤ 2 * η ∧
      |-(2 * C * S * d0) + 2 * (C ^ 2 - S ^ 2) * d1 + 2 * C * S * d2| ≤ 4 * η ∧
      |-((C ^ 2 - S ^ 2) * d0) - 4 * C * S * d1 + (C ^ 2 - S ^ 2) * d2| ≤ 4 * η := by
    intro C S hCS d0 d1 d2 h0 h1 h2
    have term : ∀ u d : ℝ, |d| ≤ η → -(|u| * η) ≤ u * d ∧ u * d ≤ |u| * η := fun u d hd =>
      abs_le.mp (by rw [abs_mul]; exact mul_le_mul_of_nonneg_left hd (abs_nonneg u))
    have hT1 : 2 * |C * S| ≤ 1 := by
      rw [abs_mul]
      have a := sq_abs C
      have b := sq_abs S
      nlinarith [sq_nonneg (|C| - |S|)]
    have hT2 : |C ^ 2 - S ^ 2| ≤ 1 :=
      abs_le.mpr ⟨by nlinarith [sq_nonneg C, sq_nonneg S], by nlinarith [sq_nonneg C, sq_nonneg S]⟩
    have hT1' := mul_le_mul_of_nonneg_right hT1 hη
    have hT2' := mul_le_mul_of_nonneg_right hT2 hη
    have hsum : C ^ 2 * η + S ^ 2 * η = η := by rw [← add_mul, hCS, one_mul]
    have hC2 : |C ^ 2| = C ^ 2 := abs_of_nonneg (sq_nonneg C)
    have hS2 : |S ^ 2| = S ^ 2 := abs_of_nonneg (sq_nonneg S)
    obtain ⟨a0, a0'⟩ := term (C ^ 2) d0 h0
    obtain ⟨a2, a2'⟩ := term (S ^ 2) d2 h2
    rw [hC2] at a0 a0'
    rw [hS2] at a2 a2'
    obtain ⟨b0, b0'⟩ := term (C * S) d0 h0
    obtain ⟨b1, b1'⟩ := term (C * S) d1 h1
    obtain ⟨b2, b2'⟩ := term (C * S) d2 h2
    obtain ⟨c0, c0'⟩ := term (C ^ 2 - S ^ 2) d0 h0
    obtain ⟨c1, c1'⟩ := term (C ^ 2 - S ^ 2) d1 h1
    obtain ⟨c2, c2'⟩ := term (C ^ 2 - S ^ 2) d2 h2
    refine ⟨abs_le.mpr ⟨by linarith, by linarith⟩, abs_le.mpr ⟨by linarith, by linarith⟩,
      abs_le.mpr ⟨by linarith, by linarith⟩, abs_le.mpr ⟨by linarith, by linarith⟩⟩
  
  have hM0 := hd0.hasFDerivAt
  have hM1 := hd1.hasFDerivAt
  have hM2 := hd2.hasFDerivAt
  have hc : HasFDerivAt (fun q : ℝ × ℝ => Real.cos q.2)
      ((-Real.sin p.2) • ContinuousLinearMap.snd ℝ ℝ ℝ) p :=
    (Real.hasDerivAt_cos p.2).comp_hasFDerivAt p hasFDerivAt_snd
  have hs : HasFDerivAt (fun q : ℝ × ℝ => Real.sin q.2)
      (Real.cos p.2 • ContinuousLinearMap.snd ℝ ℝ ℝ) p :=
    (Real.hasDerivAt_sin p.2).comp_hasFDerivAt p hasFDerivAt_snd
  have hA : HasFDerivAt (fun q : ℝ × ℝ => cylRotA q.2 (M00 q) (M01 q) (M11 q)) _ p :=
    (((hc.pow 2).mul hM0).add (((hc.const_mul 2).mul hs).mul hM1)).add ((hs.pow 2).mul hM2)
  have hB : HasFDerivAt (fun q : ℝ × ℝ => cylRotB q.2 (M00 q) (M01 q) (M11 q)) _ p :=
    ((((hc.mul hs).mul hM0).neg).add (((hc.pow 2).sub (hs.pow 2)).mul hM1)).add
      ((hc.mul hs).mul hM2)
  have dtA : fplDt (fun q : ℝ × ℝ => cylRotA q.2 (M00 q) (M01 q) (M11 q)) p =
      cylRotA p.2 (fplDt M00 p) (fplDt M01 p) (fplDt M11 p) := by
    unfold fplDt; rw [hA.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.sub_apply,
      ContinuousLinearMap.neg_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.coe_snd', smul_eq_mul, cylRotA]
    norm_num
    try ring
  have dtB : fplDt (fun q : ℝ × ℝ => cylRotB q.2 (M00 q) (M01 q) (M11 q)) p =
      cylRotB p.2 (fplDt M00 p) (fplDt M01 p) (fplDt M11 p) := by
    unfold fplDt; rw [hB.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.sub_apply,
      ContinuousLinearMap.neg_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.coe_snd', smul_eq_mul, cylRotB]
    norm_num
    try ring
  have dsA : fplDs (fun q : ℝ × ℝ => cylRotA q.2 (M00 q) (M01 q) (M11 q)) p =
      cylRotA p.2 (fplDs M00 p) (fplDs M01 p) (fplDs M11 p) +
        (-(2 * Real.cos p.2 * Real.sin p.2 * (M00 p - 1)) +
          2 * (Real.cos p.2 ^ 2 - Real.sin p.2 ^ 2) * M01 p +
          2 * Real.cos p.2 * Real.sin p.2 * (M11 p - 1)) := by
    unfold fplDs; rw [hA.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.sub_apply,
      ContinuousLinearMap.neg_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.coe_snd', smul_eq_mul, cylRotA]
    norm_num
    ring
  have dsB : fplDs (fun q : ℝ × ℝ => cylRotB q.2 (M00 q) (M01 q) (M11 q)) p =
      cylRotB p.2 (fplDs M00 p) (fplDs M01 p) (fplDs M11 p) +
        (-((Real.cos p.2 ^ 2 - Real.sin p.2 ^ 2) * (M00 p - 1)) -
          4 * Real.cos p.2 * Real.sin p.2 * M01 p +
          (Real.cos p.2 ^ 2 - Real.sin p.2 ^ 2) * (M11 p - 1)) := by
    unfold fplDs; rw [hB.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.sub_apply,
      ContinuousLinearMap.neg_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.coe_snd', smul_eq_mul, cylRotB]
    norm_num
    ring
  have kb := key _ _ hCS _ _ _ hb0 hb1 hb2
  have kt := key _ _ hCS _ _ _ ht0 ht1 ht2
  have ks := key _ _ hCS _ _ _ hs0 hs1 hs2
  have e1 : cylRotA p.2 (M00 p) (M01 p) (M11 p) - 1 =
      Real.cos p.2 ^ 2 * (M00 p - 1) + 2 * Real.cos p.2 * Real.sin p.2 * M01 p +
        Real.sin p.2 ^ 2 * (M11 p - 1) := by
    unfold cylRotA; linear_combination hCS
  have e2 : cylRotB p.2 (M00 p) (M01 p) (M11 p) =
      -(Real.cos p.2 * Real.sin p.2 * (M00 p - 1)) +
        (Real.cos p.2 ^ 2 - Real.sin p.2 ^ 2) * M01 p +
        Real.cos p.2 * Real.sin p.2 * (M11 p - 1) := by
    unfold cylRotB; ring
  refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
  · rw [e1]; exact kb.1
  · rw [e2]; exact kb.2.1
  · rw [dtA]; exact kt.1
  · rw [dtB]; exact kt.2.1
  · rw [dsA]
    calc _ ≤ |cylRotA p.2 (fplDs M00 p) (fplDs M01 p) (fplDs M11 p)| +
          |-(2 * Real.cos p.2 * Real.sin p.2 * (M00 p - 1)) +
            2 * (Real.cos p.2 ^ 2 - Real.sin p.2 ^ 2) * M01 p +
            2 * Real.cos p.2 * Real.sin p.2 * (M11 p - 1)| := abs_add_le _ _
      _ ≤ 2 * η + 4 * η := add_le_add ks.1 kb.2.2.1
      _ = 6 * η := by ring
  · rw [dsB]
    calc _ ≤ |cylRotB p.2 (fplDs M00 p) (fplDs M01 p) (fplDs M11 p)| +
          |-((Real.cos p.2 ^ 2 - Real.sin p.2 ^ 2) * (M00 p - 1)) -
            4 * Real.cos p.2 * Real.sin p.2 * M01 p +
            (Real.cos p.2 ^ 2 - Real.sin p.2 ^ 2) * (M11 p - 1)| := abs_add_le _ _
      _ ≤ 2 * η + 4 * η := add_le_add ks.2.1 kb.2.2.2
      _ = 6 * η := by ring
  · unfold cylRotA cylRotB cylRotC
    linear_combination ((Real.cos p.2 ^ 2 + Real.sin p.2 ^ 2) + 1) *
      (M00 p * M11 p - M01 p ^ 2) * hCS

theorem cyl_polar_cover (P : Matrix (Fin 2) (Fin 2) ℝ) (hP : P 0 0 * P 1 1 - P 0 1 * P 1 0 = 1)
    (x₀ : E2) (T : ℝ) (f : E2 → ℝ) (hf0 : f x₀ = 0)
    (hf : ∀ p : ℝ × ℝ, p.1 < T → f (cylPhi x₀ P p) = 0) :
    ∀ᶠ x in 𝓝 x₀, f x = 0 :=
by
  obtain ⟨κ, hκ⟩ : ∃ k : ℝ, k = |P 0 0| + |P 0 1| + |P 1 0| + |P 1 1| := ⟨_, rfl⟩
  have hκ0 : 0 ≤ κ := by rw [hκ]; positivity
  have hκ1 : 0 < κ + 1 := by linarith
  have hδ : 0 < Real.exp T / (κ + 1) := div_pos (Real.exp_pos T) hκ1
  have hcoord : ∀ (p : ℝ × ℝ) (i : Fin 2), cylPhi x₀ P p i =
      x₀ i + Real.exp p.1 * (P i 0 * Real.cos p.2 + P i 1 * Real.sin p.2) := by
    intro p i
    simp [cylPhi]
  filter_upwards [Metric.ball_mem_nhds x₀ hδ] with x hx
  rw [Metric.mem_ball, dist_eq_norm, lt_div_iff₀ hκ1] at hx
  have hy : ∀ i : Fin 2, |x i - x₀ i| ≤ ‖x - x₀‖ := by
    intro i
    have := PiLp.norm_apply_le (x - x₀) i
    simpa [Real.norm_eq_abs] using this
  obtain ⟨y₀, hy₀⟩ : ∃ a : ℝ, a = x 0 - x₀ 0 := ⟨_, rfl⟩
  obtain ⟨y₁, hy₁⟩ : ∃ a : ℝ, a = x 1 - x₀ 1 := ⟨_, rfl⟩
  have hy0b : |y₀| ≤ ‖x - x₀‖ := by rw [hy₀]; exact hy 0
  have hy1b : |y₁| ≤ ‖x - x₀‖ := by rw [hy₁]; exact hy 1
  obtain ⟨z₀, hz₀⟩ : ∃ a : ℝ, a = P 1 1 * y₀ - P 0 1 * y₁ := ⟨_, rfl⟩
  obtain ⟨z₁, hz₁⟩ : ∃ a : ℝ, a = -P 1 0 * y₀ + P 0 0 * y₁ := ⟨_, rfl⟩
  have hI0 : P 0 0 * z₀ + P 0 1 * z₁ = y₀ := by
    rw [hz₀, hz₁]; linear_combination y₀ * hP
  have hI1 : P 1 0 * z₀ + P 1 1 * z₁ = y₁ := by
    rw [hz₀, hz₁]; linear_combination y₁ * hP
  by_cases hz : z₀ = 0 ∧ z₁ = 0
  · obtain ⟨h0, h1⟩ := hz
    have e0 : x 0 = x₀ 0 := by
      have : y₀ = 0 := by rw [← hI0, h0, h1]; ring
      linarith
    have e1 : x 1 = x₀ 1 := by
      have : y₁ = 0 := by rw [← hI1, h0, h1]; ring
      linarith
    have hxx : x = x₀ := by
      refine PiLp.ext ?_
      intro i
      fin_cases i
      · exact e0
      · exact e1
    rw [hxx]; exact hf0
  · let ζ : ℂ := ⟨z₀, z₁⟩
    have hζ0 : ζ ≠ 0 := by
      intro h
      apply hz
      exact ⟨congrArg Complex.re h, congrArg Complex.im h⟩
    have hr : 0 < ‖ζ‖ := norm_pos_iff.mpr hζ0
    have hcos : ‖ζ‖ * Real.cos ζ.arg = z₀ := Complex.norm_mul_cos_arg ζ
    have hsin : ‖ζ‖ * Real.sin ζ.arg = z₁ := Complex.norm_mul_sin_arg ζ
    have hrle : ‖ζ‖ ≤ |z₀| + |z₁| := Complex.norm_le_abs_re_add_abs_im ζ
    have hp1 : |P 1 1 * y₀| ≤ |P 1 1| * ‖x - x₀‖ := by
      rw [abs_mul]; exact mul_le_mul_of_nonneg_left hy0b (abs_nonneg _)
    have hp2 : |P 0 1 * y₁| ≤ |P 0 1| * ‖x - x₀‖ := by
      rw [abs_mul]; exact mul_le_mul_of_nonneg_left hy1b (abs_nonneg _)
    have hp3 : |P 1 0 * y₀| ≤ |P 1 0| * ‖x - x₀‖ := by
      rw [abs_mul]; exact mul_le_mul_of_nonneg_left hy0b (abs_nonneg _)
    have hp4 : |P 0 0 * y₁| ≤ |P 0 0| * ‖x - x₀‖ := by
      rw [abs_mul]; exact mul_le_mul_of_nonneg_left hy1b (abs_nonneg _)
    have hz0b : |z₀| ≤ |P 1 1| * ‖x - x₀‖ + |P 0 1| * ‖x - x₀‖ := by
      rw [hz₀]
      have a1 := abs_le.mp hp1
      have a2 := abs_le.mp hp2
      exact abs_le.mpr ⟨by linarith [a1.1, a2.2], by linarith [a1.2, a2.1]⟩
    have hz1b : |z₁| ≤ |P 1 0| * ‖x - x₀‖ + |P 0 0| * ‖x - x₀‖ := by
      rw [hz₁]
      have a1 := abs_le.mp hp3
      have a2 := abs_le.mp hp4
      exact abs_le.mpr ⟨by linarith [a1.2, a2.1], by linarith [a1.1, a2.2]⟩
    have hnn := norm_nonneg (x - x₀)
    have hlt : ‖ζ‖ < Real.exp T := by
      have : ‖ζ‖ ≤ ‖x - x₀‖ * κ := by rw [hκ]; linarith
      nlinarith
    have ht : Real.log ‖ζ‖ < T := (Real.log_lt_iff_lt_exp hr).2 hlt
    have hexp : Real.exp (Real.log ‖ζ‖) = ‖ζ‖ := Real.exp_log hr
    have c0 : cylPhi x₀ P (Real.log ‖ζ‖, ζ.arg) 0 = x 0 := by
      rw [hcoord]
      simp only
      rw [hexp]
      linear_combination P 0 0 * hcos + P 0 1 * hsin + hI0 + hy₀
    have c1 : cylPhi x₀ P (Real.log ‖ζ‖, ζ.arg) 1 = x 1 := by
      rw [hcoord]
      simp only
      rw [hexp]
      linear_combination P 1 0 * hcos + P 1 1 * hsin + hI1 + hy₁
    have hΦ : cylPhi x₀ P (Real.log ‖ζ‖, ζ.arg) = x := by
      refine PiLp.ext ?_
      intro i
      fin_cases i
      · exact c0
      · exact c1
    rw [← hΦ]
    exact hf _ ht

theorem lap2_cylinder_reduction (V : Set E2) (hV : IsOpen V)
    (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) V)
    (hpos : ∀ x ∈ V, (h x).PosDef)
    (u : E2 → ℝ) (hu : ContDiffOn ℝ ∞ u V) (hharm : ∀ x ∈ V, lap2 h u x = 0)
    (x₀ : E2) (ρ : ℝ) (hρ : 0 < ρ) (hball : Metric.closedBall x₀ ρ ⊆ V)
    (hdec : ∀ K : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ x ∈ Metric.closedBall x₀ ρ,
      |u x - u x₀| ≤ C * ‖x - x₀‖ ^ K ∧ ‖fderiv ℝ u x‖ ≤ C * ‖x - x₀‖ ^ K) :
    ∃ (T C₁ : ℝ) (a b c w : ℝ × ℝ → ℝ), 0 ≤ C₁ ∧ fplCylData T C₁ a b c w ∧
      (∀ K : ℕ, ∃ CK : ℝ, ∀ p : ℝ × ℝ, p.1 < T →
        |w p| ≤ CK * Real.exp (K * p.1) ∧ |fplDt w p| ≤ CK * Real.exp (K * p.1) ∧
        |fplDs w p| ≤ CK * Real.exp (K * p.1)) ∧
      ((∀ p : ℝ × ℝ, p.1 < T → w p = 0) → ∀ᶠ x in 𝓝 x₀, u x = u x₀) :=
by
  have cyl_flux_algebra : ∀ (P : Matrix (Fin 2) (Fin 2) ℝ) (A00 A01 A11 g0 g1 θ E : ℝ),
      P 0 0 * P 1 1 - P 0 1 * P 1 0 = 1 →
      cylRotA θ (cylM00 P A00 A01 A11) (cylM01 P A00 A01 A11) (cylM11 P A00 A01 A11) *
          (E * ((P 0 0 * Real.cos θ + P 0 1 * Real.sin θ) * g0 +
            (P 1 0 * Real.cos θ + P 1 1 * Real.sin θ) * g1)) +
        cylRotB θ (cylM00 P A00 A01 A11) (cylM01 P A00 A01 A11) (cylM11 P A00 A01 A11) *
          (E * ((-P 0 0 * Real.sin θ + P 0 1 * Real.cos θ) * g0 +
            (-P 1 0 * Real.sin θ + P 1 1 * Real.cos θ) * g1)) =
        E * (Real.cos θ * (P 1 1 * (A00 * g0 + A01 * g1) - P 0 1 * (A01 * g0 + A11 * g1)) +
          Real.sin θ * (-P 1 0 * (A00 * g0 + A01 * g1) + P 0 0 * (A01 * g0 + A11 * g1))) ∧
      cylRotB θ (cylM00 P A00 A01 A11) (cylM01 P A00 A01 A11) (cylM11 P A00 A01 A11) *
          (E * ((P 0 0 * Real.cos θ + P 0 1 * Real.sin θ) * g0 +
            (P 1 0 * Real.cos θ + P 1 1 * Real.sin θ) * g1)) +
        cylRotC θ (cylM00 P A00 A01 A11) (cylM01 P A00 A01 A11) (cylM11 P A00 A01 A11) *
          (E * ((-P 0 0 * Real.sin θ + P 0 1 * Real.cos θ) * g0 +
            (-P 1 0 * Real.sin θ + P 1 1 * Real.cos θ) * g1)) =
        E * (-Real.sin θ * (P 1 1 * (A00 * g0 + A01 * g1) - P 0 1 * (A01 * g0 + A11 * g1)) +
          Real.cos θ * (-P 1 0 * (A00 * g0 + A01 * g1) + P 0 0 * (A01 * g0 + A11 * g1))) ∧
      cylM00 P A00 A01 A11 * cylM11 P A00 A01 A11 - cylM01 P A00 A01 A11 ^ 2 =
        A00 * A11 - A01 ^ 2 := by
    intro P A00 A01 A11 g0 g1 θ E hd
    unfold cylRotA cylRotB cylRotC cylM00 cylM01 cylM11
    have hCS := Real.cos_sq_add_sin_sq θ
    generalize Real.cos θ = C at hCS ⊢
    generalize Real.sin θ = S at hCS ⊢
    refine ⟨?_, ?_, ?_⟩
    · linear_combination (E * (C * (P 1 1 * (A00 * g0 + A01 * g1) - P 0 1 * (A01 * g0 + A11 * g1)) +
          S * (-P 1 0 * (A00 * g0 + A01 * g1) + P 0 0 * (A01 * g0 + A11 * g1))) *
          (P 0 0 * P 1 1 - P 0 1 * P 1 0)) * hCS +
        (E * (C * (P 1 1 * (A00 * g0 + A01 * g1) - P 0 1 * (A01 * g0 + A11 * g1)) +
          S * (-P 1 0 * (A00 * g0 + A01 * g1) + P 0 0 * (A01 * g0 + A11 * g1)))) * hd
    · linear_combination (E * (-S * (P 1 1 * (A00 * g0 + A01 * g1) - P 0 1 * (A01 * g0 + A11 * g1)) +
          C * (-P 1 0 * (A00 * g0 + A01 * g1) + P 0 0 * (A01 * g0 + A11 * g1))) *
          (P 0 0 * P 1 1 - P 0 1 * P 1 0)) * hCS +
        (E * (-S * (P 1 1 * (A00 * g0 + A01 * g1) - P 0 1 * (A01 * g0 + A11 * g1)) +
          C * (-P 1 0 * (A00 * g0 + A01 * g1) + P 0 0 * (A01 * g0 + A11 * g1)))) * hd
    · linear_combination ((P 0 0 * P 1 1 - P 0 1 * P 1 0 + 1) * (A00 * A11 - A01 ^ 2)) * hd
  have cyl_cholesky_normalise : ∀ (p q r : ℝ), 0 < p → p * r - q ^ 2 = 1 →
      ∃ P : Matrix (Fin 2) (Fin 2) ℝ, P 0 0 * P 1 1 - P 0 1 * P 1 0 = 1 ∧
        cylM00 P p q r = 1 ∧ cylM01 P p q r = 0 ∧ cylM11 P p q r = 1 := by
    intro p q r hp hpr
    have hs : 0 < Real.sqrt p := Real.sqrt_pos.mpr hp
    have hps : p = Real.sqrt p ^ 2 := (Real.sq_sqrt hp.le).symm
    have hinv : Real.sqrt p * (Real.sqrt p)⁻¹ = 1 := mul_inv_cancel₀ hs.ne'
    generalize Real.sqrt p = s at hs hps hinv
    refine ⟨!![s, 0; q * s⁻¹, s⁻¹], ?_, ?_, ?_, ?_⟩ <;>
      simp only [cylM00, cylM01, cylM11, Matrix.of_apply, Matrix.cons_val', Matrix.cons_val_zero,
        Matrix.cons_val_one, Matrix.empty_val', Matrix.cons_val_fin_one]
    · linear_combination hinv
    · linear_combination (s⁻¹ ^ 2) * hps + (s * s⁻¹ + 1) * hinv
    · linear_combination (-q * s⁻¹ ^ 2) * hps + (-q * (s * s⁻¹)) * hinv
    · linear_combination (q ^ 2 * s⁻¹ ^ 2 - r) * hps + hpr + q ^ 2 * (s * s⁻¹ - 1) * hinv
  have cyl_lipschitz_center : ∀ (V : Set E2), IsOpen V → ∀ (f : E2 → ℝ), ContDiffOn ℝ ∞ f V →
      ∀ (x₀ : E2) (ρ : ℝ), Metric.closedBall x₀ ρ ⊆ V →
      ∃ L : ℝ, 0 ≤ L ∧ ∀ x ∈ Metric.closedBall x₀ ρ,
        ‖fderiv ℝ f x‖ ≤ L ∧ |f x - f x₀| ≤ L * ‖x - x₀‖ := by
    intro V hV f hf x₀ ρ hball
    have hc : ContinuousOn (fderiv ℝ f) V := hf.continuousOn_fderiv_of_isOpen hV (by simp)
    obtain ⟨L₀, hL₀⟩ := (isCompact_closedBall x₀ ρ).exists_bound_of_continuousOn (hc.mono hball)
    refine ⟨max L₀ 0, le_max_right _ _, fun x hx => ⟨(hL₀ x hx).trans (le_max_left _ _), ?_⟩⟩
    have hρ : 0 ≤ ρ := le_trans dist_nonneg (Metric.mem_closedBall.mp hx)
    have hx₀ : x₀ ∈ Metric.closedBall x₀ ρ := Metric.mem_closedBall_self hρ
    have hd : ∀ y ∈ Metric.closedBall x₀ ρ, DifferentiableAt ℝ f y := fun y hy =>
      (hf.contDiffAt (hV.mem_nhds (hball hy))).differentiableAt (by simp)
    have hbd : ∀ y ∈ Metric.closedBall x₀ ρ, ‖fderiv ℝ f y‖ ≤ max L₀ 0 := fun y hy =>
      (hL₀ y hy).trans (le_max_left _ _)
    have := Convex.norm_image_sub_le_of_norm_fderiv_le (𝕜 := ℝ) (f := f) (C := max L₀ 0) hd hbd
      (convex_closedBall x₀ ρ) hx₀ hx
    rwa [Real.norm_eq_abs] at this
  obtain ⟨hAs, hAsym, hAdet, hApos⟩ := cyl_coeff_field_facts V hV h hh hpos
  have hx₀V : x₀ ∈ V := hball (Metric.mem_closedBall_self hρ.le)
  obtain ⟨P, hPdet, hP00, hP01, hP11⟩ := cyl_cholesky_normalise (cylA h x₀ 0 0)
    (cylA h x₀ 0 1) (cylA h x₀ 1 1) (hApos x₀ hx₀V) (hAdet x₀ hx₀V)
  obtain ⟨κ0, hκ0⟩ : ∃ k : ℝ, k = |P 0 0| + |P 0 1| + |P 1 0| + |P 1 1| := ⟨_, rfl⟩
  have hκ0nn : 0 ≤ κ0 := by rw [hκ0]; positivity
  have hκpos : 0 < κ0 + 1 := by linarith
  obtain ⟨hΦs, hΦper, hΦnorm, hΦchain⟩ := cyl_polar_grad_chain x₀ P
  simp only [← hκ0] at hΦnorm hΦchain
  have hΦd : ∀ p, DifferentiableAt ℝ (cylPhi x₀ P) p := fun p => hΦs.differentiable (by simp) p
  
  obtain ⟨m00, hm00⟩ : ∃ f : E2 → ℝ, ∀ x, f x = cylM00 P (cylA h x 0 0) (cylA h x 0 1) (cylA h x 1 1) :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨m01, hm01⟩ : ∃ f : E2 → ℝ, ∀ x, f x = cylM01 P (cylA h x 0 0) (cylA h x 0 1) (cylA h x 1 1) :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨m11, hm11⟩ : ∃ f : E2 → ℝ, ∀ x, f x = cylM11 P (cylA h x 0 0) (cylA h x 0 1) (cylA h x 1 1) :=
    ⟨_, fun _ => rfl⟩
  have hm00s : ContDiffOn ℝ ∞ m00 V := by
    rw [show m00 = _ from funext hm00]; unfold cylM00
    exact ((contDiffOn_const.mul (hAs 0 0)).sub (contDiffOn_const.mul (hAs 0 1))).add
      (contDiffOn_const.mul (hAs 1 1))
  have hm01s : ContDiffOn ℝ ∞ m01 V := by
    rw [show m01 = _ from funext hm01]; unfold cylM01
    exact ((contDiffOn_const.mul (hAs 0 0)).neg.add (contDiffOn_const.mul (hAs 0 1))).sub
      (contDiffOn_const.mul (hAs 1 1))
  have hm11s : ContDiffOn ℝ ∞ m11 V := by
    rw [show m11 = _ from funext hm11]; unfold cylM11
    exact ((contDiffOn_const.mul (hAs 0 0)).sub (contDiffOn_const.mul (hAs 0 1))).add
      (contDiffOn_const.mul (hAs 1 1))
  obtain ⟨L00, hL00nn, hLip00⟩ := cyl_lipschitz_center V hV m00 hm00s x₀ ρ hball
  obtain ⟨L01, -, hLip01⟩ := cyl_lipschitz_center V hV m01 hm01s x₀ ρ hball
  obtain ⟨L11, -, hLip11⟩ := cyl_lipschitz_center V hV m11 hm11s x₀ ρ hball
  obtain ⟨L, hL0, hL00, hL01, hL11⟩ : ∃ L : ℝ, 0 ≤ L ∧ L00 ≤ L ∧ L01 ≤ L ∧ L11 ≤ L :=
    ⟨max (max L00 L01) L11, le_trans hL00nn (le_trans (le_max_left _ _) (le_max_left _ _)),
      le_trans (le_max_left _ _) (le_max_left _ _), le_trans (le_max_right _ _) (le_max_left _ _),
      le_max_right _ _⟩
  
  obtain ⟨δ, hδ⟩ : ∃ d : ℝ, d = min (ρ / (κ0 + 1)) (1 / (4 * (L * (κ0 + 1) + 1))) := ⟨_, rfl⟩
  have hLκ0 : 0 ≤ L * (κ0 + 1) := mul_nonneg hL0 hκpos.le
  have hδpos : 0 < δ := by
    rw [hδ]; exact lt_min (div_pos hρ hκpos) (by positivity)
  have hexpT : Real.exp (Real.log δ) = δ := Real.exp_log hδpos
  have hκδ : (κ0 + 1) * δ ≤ ρ := by
    have h1 : δ ≤ ρ / (κ0 + 1) := by rw [hδ]; exact min_le_left _ _
    rw [le_div_iff₀ hκpos] at h1; linarith
  have hLκδ : L * (κ0 + 1) * δ ≤ 1 / 4 := by
    have h1 : δ ≤ 1 / (4 * (L * (κ0 + 1) + 1)) := by rw [hδ]; exact min_le_right _ _
    rw [le_div_iff₀ (by positivity)] at h1; nlinarith
  have hexple : ∀ p : ℝ × ℝ, p.1 < Real.log δ → Real.exp p.1 ≤ δ := fun p hp => by
    rw [← hexpT]; exact Real.exp_le_exp.mpr hp.le
  have hκ0e : ∀ p : ℝ × ℝ, κ0 * Real.exp p.1 ≤ (κ0 + 1) * Real.exp p.1 := fun p => by
    have := Real.exp_pos p.1; nlinarith
  have hΦball : ∀ p : ℝ × ℝ, p.1 < Real.log δ → cylPhi x₀ P p ∈ Metric.closedBall x₀ ρ := by
    intro p hp
    rw [Metric.mem_closedBall, dist_eq_norm]
    calc ‖cylPhi x₀ P p - x₀‖ ≤ κ0 * Real.exp p.1 := hΦnorm p
      _ ≤ (κ0 + 1) * Real.exp p.1 := hκ0e p
      _ ≤ (κ0 + 1) * δ := mul_le_mul_of_nonneg_left (hexple p hp) hκpos.le
      _ ≤ ρ := hκδ
  have hΦV : ∀ p : ℝ × ℝ, p.1 < Real.log δ → cylPhi x₀ P p ∈ V := fun p hp => hball (hΦball p hp)
  have hUo : IsOpen {p : ℝ × ℝ | p.1 < Real.log δ} := isOpen_lt continuous_fst continuous_const
  have hmapsU : Set.MapsTo (cylPhi x₀ P) {p : ℝ × ℝ | p.1 < Real.log δ} V := fun p hp => hΦV p hp
  
  have hmb : ∀ (m : E2 → ℝ) (Lm c : ℝ), ContDiffOn ℝ ∞ m V → Lm ≤ L →
      (∀ x ∈ Metric.closedBall x₀ ρ, ‖fderiv ℝ m x‖ ≤ Lm ∧ |m x - m x₀| ≤ Lm * ‖x - x₀‖) →
      m x₀ = c → ∀ p : ℝ × ℝ, p.1 < Real.log δ →
      DifferentiableAt ℝ (fun q => m (cylPhi x₀ P q)) p ∧
      |m (cylPhi x₀ P p) - c| ≤ L * (κ0 + 1) * Real.exp p.1 ∧
      |fplDt (fun q => m (cylPhi x₀ P q)) p| ≤ L * (κ0 + 1) * Real.exp p.1 ∧
      |fplDs (fun q => m (cylPhi x₀ P q)) p| ≤ L * (κ0 + 1) * Real.exp p.1 := by
    intro m Lm c hms hLm hLip hc p hp
    have hx := hΦball p hp
    have hdm : DifferentiableAt ℝ m (cylPhi x₀ P p) :=
      (hms.contDiffAt (hV.mem_nhds (hball hx))).differentiableAt (by simp)
    obtain ⟨hD, hB⟩ := hLip _ hx
    obtain ⟨-, -, hdt, hds⟩ := hΦchain m p hdm
    have he := Real.exp_pos p.1
    have hLm0 : 0 ≤ Lm := le_trans (norm_nonneg _) hD
    have hκe : 0 ≤ (κ0 + 1) * Real.exp p.1 := by positivity
    refine ⟨hdm.comp p (hΦd p), ?_, ?_, ?_⟩
    · rw [← hc]
      calc |m (cylPhi x₀ P p) - m x₀| ≤ Lm * ‖cylPhi x₀ P p - x₀‖ := hB
        _ ≤ L * ((κ0 + 1) * Real.exp p.1) :=
          mul_le_mul hLm ((hΦnorm p).trans (hκ0e p)) (norm_nonneg _) hL0
        _ = L * (κ0 + 1) * Real.exp p.1 := by ring
    · calc _ ≤ κ0 * Real.exp p.1 * ‖fderiv ℝ m (cylPhi x₀ P p)‖ := hdt
        _ ≤ (κ0 + 1) * Real.exp p.1 * L := mul_le_mul (hκ0e p) (hD.trans hLm) (norm_nonneg _) hκe
        _ = L * (κ0 + 1) * Real.exp p.1 := by ring
    · calc _ ≤ κ0 * Real.exp p.1 * ‖fderiv ℝ m (cylPhi x₀ P p)‖ := hds
        _ ≤ (κ0 + 1) * Real.exp p.1 * L := mul_le_mul (hκ0e p) (hD.trans hLm) (norm_nonneg _) hκe
        _ = L * (κ0 + 1) * Real.exp p.1 := by ring
  
  obtain ⟨a, haf⟩ : ∃ f : ℝ × ℝ → ℝ, f = fun q => cylRotA q.2 (m00 (cylPhi x₀ P q))
      (m01 (cylPhi x₀ P q)) (m11 (cylPhi x₀ P q)) := ⟨_, rfl⟩
  obtain ⟨b, hbf⟩ : ∃ f : ℝ × ℝ → ℝ, f = fun q => cylRotB q.2 (m00 (cylPhi x₀ P q))
      (m01 (cylPhi x₀ P q)) (m11 (cylPhi x₀ P q)) := ⟨_, rfl⟩
  obtain ⟨c, hcf⟩ : ∃ f : ℝ × ℝ → ℝ, f = fun q => cylRotC q.2 (m00 (cylPhi x₀ P q))
      (m01 (cylPhi x₀ P q)) (m11 (cylPhi x₀ P q)) := ⟨_, rfl⟩
  obtain ⟨w, hwf⟩ : ∃ f : ℝ × ℝ → ℝ, f = fun q => u (cylPhi x₀ P q) - u x₀ := ⟨_, rfl⟩
  have hwd : ∀ q, fplDt w q = fplDt (fun q => u (cylPhi x₀ P q)) q ∧
      fplDs w q = fplDs (fun q => u (cylPhi x₀ P q)) q := by
    intro q; rw [hwf]; unfold fplDt fplDs; rw [fderiv_sub_const]; exact ⟨rfl, rfl⟩
  
  obtain ⟨F0, hF0⟩ : ∃ f : E2 → ℝ,
      f = fun z => Real.sqrt (h z).det * ∑ j : Fin 2, (h z)⁻¹ 0 j * pd2 j u z := ⟨_, rfl⟩
  obtain ⟨F1, hF1⟩ : ∃ f : E2 → ℝ,
      f = fun z => Real.sqrt (h z).det * ∑ j : Fin 2, (h z)⁻¹ 1 j * pd2 j u z := ⟨_, rfl⟩
  have hF0s : ∀ z, F0 z = cylA h z 0 0 * pd2 0 u z + cylA h z 0 1 * pd2 1 u z := by
    intro z; rw [hF0]; simp only [cylA, Fin.sum_univ_two]; ring
  have hF1s : ∀ z, F1 z = cylA h z 1 0 * pd2 0 u z + cylA h z 1 1 * pd2 1 u z := by
    intro z; rw [hF1]; simp only [cylA, Fin.sum_univ_two]; ring
  have hpds : ∀ j : Fin 2, ContDiffOn ℝ ∞ (pd2 j u) V := fun j =>
    (hu.fderiv_of_isOpen hV le_rfl).clm_apply contDiffOn_const
  have hF0d : ∀ z ∈ V, DifferentiableAt ℝ F0 z := by
    intro z hz
    have hs : ContDiffOn ℝ ∞ F0 V := by
      rw [show F0 = _ from funext hF0s]
      exact ((hAs 0 0).mul (hpds 0)).add ((hAs 0 1).mul (hpds 1))
    exact (hs.contDiffAt (hV.mem_nhds hz)).differentiableAt (by simp)
  have hF1d : ∀ z ∈ V, DifferentiableAt ℝ F1 z := by
    intro z hz
    have hs : ContDiffOn ℝ ∞ F1 V := by
      rw [show F1 = _ from funext hF1s]
      exact ((hAs 1 0).mul (hpds 0)).add ((hAs 1 1).mul (hpds 1))
    exact (hs.contDiffAt (hV.mem_nhds hz)).differentiableAt (by simp)
  obtain ⟨W0, hW0⟩ : ∃ f : ℝ × ℝ → ℝ, f = fun q => Real.exp q.1 * (Real.cos q.2 *
      (P 1 1 * F0 (cylPhi x₀ P q) - P 0 1 * F1 (cylPhi x₀ P q)) + Real.sin q.2 *
      (-P 1 0 * F0 (cylPhi x₀ P q) + P 0 0 * F1 (cylPhi x₀ P q))) := ⟨_, rfl⟩
  obtain ⟨W1, hW1⟩ : ∃ f : ℝ × ℝ → ℝ, f = fun q => Real.exp q.1 * (-Real.sin q.2 *
      (P 1 1 * F0 (cylPhi x₀ P q) - P 0 1 * F1 (cylPhi x₀ P q)) + Real.cos q.2 *
      (-P 1 0 * F0 (cylPhi x₀ P q) + P 0 0 * F1 (cylPhi x₀ P q))) := ⟨_, rfl⟩
  have hVW : ∀ q : ℝ × ℝ, q.1 < Real.log δ → fplV0 a b w q = W0 q ∧ fplV1 b c w q = W1 q := by
    intro q hq
    have hxV := hΦV q hq
    have hdu : DifferentiableAt ℝ u (cylPhi x₀ P q) :=
      (hu.contDiffAt (hV.mem_nhds hxV)).differentiableAt (by simp)
    obtain ⟨ht, hs, -, -⟩ := hΦchain u q hdu
    have halg := cyl_flux_algebra P (cylA h (cylPhi x₀ P q) 0 0) (cylA h (cylPhi x₀ P q) 0 1)
      (cylA h (cylPhi x₀ P q) 1 1) (pd2 0 u (cylPhi x₀ P q)) (pd2 1 u (cylPhi x₀ P q)) q.2
      (Real.exp q.1) hPdet
    have hsym := hAsym _ hxV 1 0
    unfold fplV0 fplV1
    rw [(hwd q).1, (hwd q).2, ht, hs, haf, hbf, hcf, hW0, hW1]
    simp only [hm00, hm01, hm11, hF0s, hF1s, hsym]
    exact ⟨by linear_combination halg.1, by linear_combination halg.2.1⟩
  have h2inf : (2 : WithTop ℕ∞) ≤ ∞ := WithTop.coe_le_coe.mpr le_top
  have hu2 : ContDiffOn ℝ 2 u V := hu.of_le h2inf
  refine ⟨Real.log δ, 6 * L * (κ0 + 1), a, b, c, w,
    mul_nonneg (mul_nonneg (by norm_num) hL0) hκpos.le, ⟨?_, ?_, ?_, ?_, ?_, ?_⟩, ?_, ?_⟩
  · 
    have hcos : ContDiffOn ℝ ∞ (fun q : ℝ × ℝ => Real.cos q.2) {p : ℝ × ℝ | p.1 < Real.log δ} :=
      (Real.contDiff_cos.comp contDiff_snd).contDiffOn
    have hsin : ContDiffOn ℝ ∞ (fun q : ℝ × ℝ => Real.sin q.2) {p : ℝ × ℝ | p.1 < Real.log δ} :=
      (Real.contDiff_sin.comp contDiff_snd).contDiffOn
    rw [haf]; unfold cylRotA
    exact (((hcos.pow 2).mul (hm00s.comp hΦs.contDiffOn hmapsU)).add
      (((contDiffOn_const.mul hcos).mul hsin).mul (hm01s.comp hΦs.contDiffOn hmapsU))).add
      ((hsin.pow 2).mul (hm11s.comp hΦs.contDiffOn hmapsU))
  · have hcos : ContDiffOn ℝ ∞ (fun q : ℝ × ℝ => Real.cos q.2) {p : ℝ × ℝ | p.1 < Real.log δ} :=
      (Real.contDiff_cos.comp contDiff_snd).contDiffOn
    have hsin : ContDiffOn ℝ ∞ (fun q : ℝ × ℝ => Real.sin q.2) {p : ℝ × ℝ | p.1 < Real.log δ} :=
      (Real.contDiff_sin.comp contDiff_snd).contDiffOn
    rw [hbf]; unfold cylRotB
    exact ((((hcos.mul hsin).mul (hm00s.comp hΦs.contDiffOn hmapsU)).neg.add
      (((hcos.pow 2).sub (hsin.pow 2)).mul (hm01s.comp hΦs.contDiffOn hmapsU)))).add
      ((hcos.mul hsin).mul (hm11s.comp hΦs.contDiffOn hmapsU))
  · have hcos : ContDiffOn ℝ ∞ (fun q : ℝ × ℝ => Real.cos q.2) {p : ℝ × ℝ | p.1 < Real.log δ} :=
      (Real.contDiff_cos.comp contDiff_snd).contDiffOn
    have hsin : ContDiffOn ℝ ∞ (fun q : ℝ × ℝ => Real.sin q.2) {p : ℝ × ℝ | p.1 < Real.log δ} :=
      (Real.contDiff_sin.comp contDiff_snd).contDiffOn
    rw [hcf]; unfold cylRotC
    exact (((hsin.pow 2).mul (hm00s.comp hΦs.contDiffOn hmapsU)).sub
      (((contDiffOn_const.mul hcos).mul hsin).mul (hm01s.comp hΦs.contDiffOn hmapsU))).add
      ((hcos.pow 2).mul (hm11s.comp hΦs.contDiffOn hmapsU))
  · rw [hwf]
    exact (hu.comp hΦs.contDiffOn hmapsU).sub contDiffOn_const
  · 
    intro p _
    have hper' : cylPhi x₀ P (p.1, p.2 + 2 * Real.pi) = cylPhi x₀ P p := hΦper p.1 p.2
    rw [haf, hbf, hcf, hwf]
    simp only [cylRotA, cylRotB, cylRotC, hper', Real.cos_add_two_pi, Real.sin_add_two_pi]
    exact ⟨trivial, trivial, trivial, trivial⟩
  · intro p hp
    obtain ⟨hd0, hb0, ht0, hs0⟩ := hmb m00 L00 1 hm00s hL00 hLip00
      (by rw [hm00]; exact hP00) p hp
    obtain ⟨hd1, hb1, ht1, hs1⟩ := hmb m01 L01 0 hm01s hL01 hLip01
      (by rw [hm01]; exact hP01) p hp
    obtain ⟨hd2, hb2, ht2, hs2⟩ := hmb m11 L11 1 hm11s hL11 hLip11
      (by rw [hm11]; exact hP11) p hp
    rw [sub_zero] at hb1
    have he := Real.exp_pos p.1
    have hη0 : 0 ≤ L * (κ0 + 1) * Real.exp p.1 := by positivity
    have hη4 : L * (κ0 + 1) * Real.exp p.1 ≤ 1 / 4 :=
      le_trans (mul_le_mul_of_nonneg_left (hexple p hp) hLκ0) hLκδ
    obtain ⟨r1, r2, r3, r4, r5, r6, r7⟩ := cyl_rotated_coeff_bounds
      (fun q => m00 (cylPhi x₀ P q)) (fun q => m01 (cylPhi x₀ P q)) (fun q => m11 (cylPhi x₀ P q))
      p _ hη0 hd0 hd1 hd2 hb0 hb1 hb2 ht0 ht1 ht2 hs0 hs1 hs2
    have hdetm : m00 (cylPhi x₀ P p) * m11 (cylPhi x₀ P p) - m01 (cylPhi x₀ P p) ^ 2 = 1 := by
      rw [hm00, hm01, hm11, (cyl_flux_algebra P _ _ _ 0 0 0 0 hPdet).2.2]
      exact hAdet _ (hΦV p hp)
    have r1' := abs_le.mp r1
    have r2' := abs_le.mp r2
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · rw [haf, hbf, hcf]; simp only; rw [r7]; exact hdetm
    · rw [haf]; simp only; linarith
    · rw [haf]; simp only; linarith
    · rw [hbf]; simp only; exact abs_le.mpr ⟨by linarith, by linarith⟩
    · rw [haf]; linarith
    · rw [haf]; linarith
    · rw [hbf]; linarith
    · rw [hbf]; linarith
    · 
      have hxV := hΦV p hp
      have hev0 : fplV0 a b w =ᶠ[𝓝 p] W0 :=
        Filter.eventually_of_mem (hUo.mem_nhds hp) (fun q hq => (hVW q hq).1)
      have hev1 : fplV1 b c w =ᶠ[𝓝 p] W1 :=
        Filter.eventually_of_mem (hUo.mem_nhds hp) (fun q hq => (hVW q hq).2)
      have hdt : fplDt (fplV0 a b w) p = fplDt W0 p := by unfold fplDt; rw [hev0.fderiv_eq]
      have hds : fplDs (fplV1 b c w) p = fplDs W1 p := by unfold fplDs; rw [hev1.fderiv_eq]
      have hpb := cyl_polar_div_pullback P x₀ F0 F1 p (hF0d _ hxV) (hF1d _ hxV)
      have hdiv := lap2_divergence_form V hV h u hh hpos hu2 _ hxV
      rw [hdt, hds, hW0, hW1, hpb, hF0, hF1, hdiv, hharm _ hxV]
      ring
  · 
    intro K
    obtain ⟨CK0, hCK0, hdecK⟩ := hdec K
    refine ⟨CK0 * (κ0 + 1) ^ K * (1 + (κ0 + 1) * δ), fun p hp => ?_⟩
    have hx := hΦball p hp
    have hxV := hball hx
    have he := Real.exp_pos p.1
    obtain ⟨G, hG⟩ : ∃ g : ℝ, g = CK0 * (κ0 + 1) ^ K * Real.exp (K * p.1) := ⟨_, rfl⟩
    have hG0 : 0 ≤ G := by
      rw [hG]; exact mul_nonneg (mul_nonneg hCK0 (pow_nonneg hκpos.le K)) (Real.exp_pos _).le
    have hpow : CK0 * ‖cylPhi x₀ P p - x₀‖ ^ K ≤ G := by
      rw [hG, mul_assoc, Real.exp_nat_mul, ← mul_pow]
      exact mul_le_mul_of_nonneg_left (pow_le_pow_left₀ (norm_nonneg _)
        ((hΦnorm p).trans (hκ0e p)) K) hCK0
    have hCKe : CK0 * (κ0 + 1) ^ K * (1 + (κ0 + 1) * δ) * Real.exp (K * p.1) =
        G + (κ0 + 1) * δ * G := by rw [hG]; ring
    obtain ⟨hw1, hw2⟩ := hdecK _ hx
    have hdu : DifferentiableAt ℝ u (cylPhi x₀ P p) :=
      (hu.contDiffAt (hV.mem_nhds hxV)).differentiableAt (by simp)
    obtain ⟨-, -, hdt, hds⟩ := hΦchain u p hdu
    have hκδ0 : 0 ≤ (κ0 + 1) * δ := by positivity
    have hEδ : κ0 * Real.exp p.1 ≤ (κ0 + 1) * δ :=
      (hκ0e p).trans (mul_le_mul_of_nonneg_left (hexple p hp) hκpos.le)
    have hDu : ‖fderiv ℝ u (cylPhi x₀ P p)‖ ≤ G := hw2.trans hpow
    have hκe0 : 0 ≤ κ0 * Real.exp p.1 := by positivity
    refine ⟨?_, ?_, ?_⟩
    · rw [hCKe, hwf]
      have := hw1.trans hpow
      have h2 : 0 ≤ (κ0 + 1) * δ * G := mul_nonneg hκδ0 hG0
      simp only; linarith
    · rw [hCKe, (hwd p).1]
      have h3 : κ0 * Real.exp p.1 * ‖fderiv ℝ u (cylPhi x₀ P p)‖ ≤ (κ0 + 1) * δ * G :=
        mul_le_mul hEδ hDu (norm_nonneg _) hκδ0
      linarith
    · rw [hCKe, (hwd p).2]
      have h3 : κ0 * Real.exp p.1 * ‖fderiv ℝ u (cylPhi x₀ P p)‖ ≤ (κ0 + 1) * δ * G :=
        mul_le_mul hEδ hDu (norm_nonneg _) hκδ0
      linarith
  · 
    intro hw0
    have hcov := cyl_polar_cover P hPdet x₀ (Real.log δ) (fun x => u x - u x₀) (by simp)
      (fun p hp => by
        have := hw0 p hp
        rw [hwf] at this
        exact this)
    filter_upwards [hcov] with x hx
    exact sub_eq_zero.mp hx

theorem cyl_energy_identities (T C₁ : ℝ) (a b c w : ℝ × ℝ → ℝ) (hC₁ : 0 ≤ C₁)
    (hcyl : fplCylData T C₁ a b c w)
    (hdec : ∀ K : ℕ, ∃ CK : ℝ, ∀ p : ℝ × ℝ, p.1 < T →
      |w p| ≤ CK * Real.exp (K * p.1) ∧ |fplDt w p| ≤ CK * Real.exp (K * p.1) ∧
      |fplDs w p| ≤ CK * Real.exp (K * p.1)) :
    (∃ (C : ℝ) (g q : ℝ → ℝ), 0 ≤ C ∧
      (∀ t < T, 0 ≤ fplH a w t ∧ 0 ≤ fplX a b w t ∧ 0 ≤ fplY a w t ∧
        fplD a b w t ^ 2 ≤ fplH a w t * fplX a b w t ∧
        HasDerivAt (fplH a w) (2 * fplD a b w t + g t) t ∧
        |g t| ≤ C * Real.exp t * fplH a w t ∧
        HasDerivAt (fplD a b w) (fplX a b w t + fplY a w t) t ∧
        HasDerivAt (fun s => fplX a b w s - fplY a w s) (q t) t ∧
        |q t| ≤ C * Real.exp t * (fplX a b w t + fplY a w t)) ∧
      Tendsto (fplD a b w) atBot (𝓝 0) ∧
      Tendsto (fun s => fplX a b w s - fplY a w s) atBot (𝓝 0) ∧
      (∀ K : ℕ, ∃ CK : ℝ, ∀ t < T, fplH a w t ≤ CK * Real.exp (K * t))) ∧
    (∀ t < T, fplH a w t = 0 → ∀ θ : ℝ, w (t, θ) = 0) :=
by
  obtain ⟨ha, hb, hc, hw, hper, hpt⟩ := hcyl
  set U : Set (ℝ × ℝ) := {p : ℝ × ℝ | p.1 < T} with hUdef
  have hU : IsOpen U := isOpen_lt continuous_fst continuous_const
  have hpi : -Real.pi ≤ Real.pi := by linarith [Real.pi_pos]
  have hD : ∀ F : ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ F U →
      ContDiffOn ℝ ∞ (fplDt F) U ∧ ContDiffOn ℝ ∞ (fplDs F) U := by
    intro F hF
    have h1 : ContDiffOn ℝ ∞ (fderiv ℝ F) U := hF.fderiv_of_isOpen (m := ∞) hU le_rfl
    exact ⟨h1.clm_apply contDiffOn_const, h1.clm_apply contDiffOn_const⟩
  have hdiff : ∀ F : ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ F U → ∀ p ∈ U, DifferentiableAt ℝ F p :=
    fun F hF p hp => (hF.contDiffAt (hU.mem_nhds hp)).differentiableAt (by simp)
  have hcont : ∀ F : ℝ × ℝ → ℝ, ContinuousOn F U → ∀ t : ℝ, t < T →
      Continuous (fun θ : ℝ => F (t, θ)) :=
    fun F hF t ht => hF.comp_continuous (continuous_const.prodMk continuous_id) (fun _ => ht)
  have hlt : ∀ (F : ℝ × ℝ → ℝ) (t θ : ℝ), DifferentiableAt ℝ F (t, θ) →
      HasDerivAt (fun s => F (s, θ)) (fplDt F (t, θ)) t := by
    intro F t θ hF
    have h2 : HasDerivAt (fun s : ℝ => (s, θ)) ((1 : ℝ), (0 : ℝ)) t :=
      (hasDerivAt_id' t).prodMk (hasDerivAt_const t θ)
    exact hF.hasFDerivAt.comp_hasDerivAt t h2
  have hls : ∀ (F : ℝ × ℝ → ℝ) (t θ : ℝ), DifferentiableAt ℝ F (t, θ) →
      HasDerivAt (fun s => F (t, s)) (fplDs F (t, θ)) θ := by
    intro F t θ hF
    have h2 : HasDerivAt (fun s : ℝ => (t, s)) ((0 : ℝ), (1 : ℝ)) θ :=
      (hasDerivAt_const θ t).prodMk (hasDerivAt_id' θ)
    exact hF.hasFDerivAt.comp_hasDerivAt θ h2
  have hmix : ∀ F : ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ F U → ∀ p ∈ U,
      fplDs (fplDt F) p = fplDt (fplDs F) p := by
    intro F hF p hp
    have hfd : DifferentiableAt ℝ (fderiv ℝ F) p :=
      ((hF.fderiv_of_isOpen (m := ∞) hU le_rfl).contDiffAt (hU.mem_nhds hp)).differentiableAt
        (by simp)
    have hsym := (hF.contDiffAt (hU.mem_nhds hp)).isSymmSndFDerivAt
      (by rw [minSmoothness_of_isRCLikeNormedField]; exact WithTop.coe_le_coe.2 le_top)
    have h1 := fderiv_clm_apply (c := fderiv ℝ F) (u := fun _ => ((1 : ℝ), (0 : ℝ))) hfd
      (differentiableAt_const _)
    have h2 := fderiv_clm_apply (c := fderiv ℝ F) (u := fun _ => ((0 : ℝ), (1 : ℝ))) hfd
      (differentiableAt_const _)
    unfold fplDs fplDt
    rw [h1, h2]
    simp
    exact hsym _ _
  have hperD : ∀ F : ℝ × ℝ → ℝ, (∀ p : ℝ × ℝ, p.1 < T → F (p.1, p.2 + 2 * Real.pi) = F p) →
      ∀ p : ℝ × ℝ, p.1 < T → fderiv ℝ F (p.1, p.2 + 2 * Real.pi) = fderiv ℝ F p := by
    intro F hF p hp
    have hv : ∀ q : ℝ × ℝ, q + ((0 : ℝ), 2 * Real.pi) = (q.1, q.2 + 2 * Real.pi) :=
      fun q => Prod.ext (add_zero q.1) rfl
    have hev : (fun q => F (q + ((0 : ℝ), 2 * Real.pi))) =ᶠ[𝓝 p] F := by
      filter_upwards [hU.mem_nhds (show p ∈ U from hp)] with q hq
      rw [hv]; exact hF q hq
    have h2 := hev.fderiv_eq (𝕜 := ℝ)
    rw [fderiv_comp_add_right] at h2
    rw [← hv]; exact h2
  have hend : ∀ t : ℝ, t < T → a (t, Real.pi) = a (t, -Real.pi) ∧ b (t, Real.pi) = b (t, -Real.pi) ∧
      c (t, Real.pi) = c (t, -Real.pi) ∧ w (t, Real.pi) = w (t, -Real.pi) ∧
      fplDt w (t, Real.pi) = fplDt w (t, -Real.pi) ∧
      fplDs w (t, Real.pi) = fplDs w (t, -Real.pi) := by
    intro t ht
    have e : (((t, -Real.pi) : ℝ × ℝ).1, ((t, -Real.pi) : ℝ × ℝ).2 + 2 * Real.pi) =
        ((t, Real.pi) : ℝ × ℝ) :=
      Prod.ext rfl (show -Real.pi + 2 * Real.pi = Real.pi by ring)
    have h := hper (t, -Real.pi) ht
    have hd := hperD w (fun p hp => (hper p hp).2.2.2) (t, -Real.pi) ht
    rw [e] at h hd
    refine ⟨h.1, h.2.1, h.2.2.1, h.2.2.2, ?_, ?_⟩
    · unfold fplDt; rw [hd]
    · unfold fplDs; rw [hd]
  have hderI : ∀ G : ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ G U → ∀ t : ℝ, t < T →
      HasDerivAt (fun s => ∫ θ in (-Real.pi)..Real.pi, G (s, θ))
        (∫ θ in (-Real.pi)..Real.pi, fplDt G (t, θ)) t := by
    intro G hG t ht
    have hKc : IsCompact (Set.Icc (t - (T - t) / 2) (t + (T - t) / 2) ×ˢ
        Set.Icc (-Real.pi) Real.pi) := isCompact_Icc.prod isCompact_Icc
    have hKU : Set.Icc (t - (T - t) / 2) (t + (T - t) / 2) ×ˢ Set.Icc (-Real.pi) Real.pi ⊆ U := by
      intro q hq
      show q.1 < T
      have := hq.1.2
      linarith
    obtain ⟨M, hM⟩ := hKc.exists_bound_of_continuousOn ((hD G hG).1.continuousOn.mono hKU)
    refine (intervalIntegral.hasDerivAt_integral_of_dominated_loc_of_deriv_le (μ := volume)
      (F := fun x θ => G (x, θ)) (F' := fun x θ => fplDt G (x, θ)) (bound := fun _ => M)
      (s := Set.Ioo (t - (T - t) / 2) (t + (T - t) / 2))
      (Ioo_mem_nhds (by linarith) (by linarith)) ?_ ?_ ?_ ?_ intervalIntegrable_const ?_).2
    · filter_upwards [Iio_mem_nhds ht] with x hx
      exact (hcont G hG.continuousOn x hx).aestronglyMeasurable
    · exact (hcont G hG.continuousOn t ht).intervalIntegrable _ _
    · exact (hcont _ (hD G hG).1.continuousOn t ht).aestronglyMeasurable
    · refine Filter.Eventually.of_forall (fun θ hθ x hx => hM (x, θ) ⟨⟨hx.1.le, hx.2.le⟩, ?_⟩)
      rw [Set.uIoc_of_le hpi] at hθ
      exact ⟨hθ.1.le, hθ.2⟩
    · refine Filter.Eventually.of_forall (fun θ _ x hx => hlt G x θ (hdiff G hG _ ?_))
      show x < T
      linarith [hx.2]
  have hDs0 : ∀ R : ℝ × ℝ → ℝ, ContDiffOn ℝ ∞ R U → ∀ t : ℝ, t < T →
      R (t, Real.pi) = R (t, -Real.pi) → ∫ θ in (-Real.pi)..Real.pi, fplDs R (t, θ) = 0 := by
    intro R hR t ht h
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (f := fun θ => R (t, θ))
      (fun θ _ => hls R t θ (hdiff R hR _ ht))
      ((hcont _ (hD R hR).2.continuousOn t ht).intervalIntegrable _ _)]
    show R (t, Real.pi) - R (t, -Real.pi) = 0
    rw [h, sub_self]
  have ha0U : ∀ q ∈ U, a q ≠ 0 := fun q hq => by
    have := (hpt q hq).2.1; intro h; rw [h] at this; norm_num at this
  have ha20U : ∀ q ∈ U, a q ^ 2 ≠ 0 := fun q hq => pow_ne_zero 2 (ha0U q hq)
  have hwt := (hD w hw).1
  have hws := (hD w hw).2
  have hat := (hD a ha).1
  have hbs := (hD b hb).2
  have hV0 : ContDiffOn ℝ ∞ (fplV0 a b w) U := (ha.mul hwt).add (hb.mul hws)
  have hV1 : ContDiffOn ℝ ∞ (fplV1 b c w) U := (hb.mul hwt).add (hc.mul hws)
  have hG1 : ContDiffOn ℝ ∞ (fun q => a q * w q ^ 2) U := ha.mul (hw.pow 2)
  have hR1 : ContDiffOn ℝ ∞ (fun q => b q * w q ^ 2) U := hb.mul (hw.pow 2)
  have hG2 : ContDiffOn ℝ ∞ (fun q => w q * fplV0 a b w q) U := hw.mul hV0
  have hR2 : ContDiffOn ℝ ∞ (fun q => w q * fplV1 b c w q) U := hw.mul hV1
  have hG3 : ContDiffOn ℝ ∞ (fun q => fplV0 a b w q ^ 2 / a q) U := (hV0.pow 2).div ha ha0U
  have hG4 : ContDiffOn ℝ ∞ (fun q => fplDs w q ^ 2 / a q) U := (hws.pow 2).div ha ha0U
  have hZ : ContDiffOn ℝ ∞ (fun q => -(b q / a q ^ 2) * fplV0 a b w q ^ 2 -
      2 / a q ^ 2 * (fplV0 a b w q * fplDs w q) + b q / a q ^ 2 * fplDs w q ^ 2) U :=
    ((((hb.div (ha.pow 2) ha20U).neg).mul (hV0.pow 2)).sub
      ((contDiffOn_const.div (ha.pow 2) ha20U).mul (hV0.mul hws))).add
      ((hb.div (ha.pow 2) ha20U).mul (hws.pow 2))
  have hgC : ContDiffOn ℝ ∞ (fun q => (fplDt a q + fplDs b q) * w q ^ 2) U :=
    (hat.add hbs).mul (hw.pow 2)
  have hqC : ContDiffOn ℝ ∞ (fun q => (fplDt a q + fplDs b q) *
      (fplDs w q ^ 2 - fplV0 a b w q ^ 2) / a q ^ 2) U :=
    ((hat.add hbs).mul ((hws.pow 2).sub (hV0.pow 2))).div (ha.pow 2) ha20U
  have hP1 : ∀ t θ : ℝ, t < T → fplDt (fun q => a q * w q ^ 2) (t, θ) =
      2 * (w (t, θ) * fplV0 a b w (t, θ)) + (fplDt a (t, θ) + fplDs b (t, θ)) * w (t, θ) ^ 2 -
        fplDs (fun q => b q * w q ^ 2) (t, θ) := by
    intro t θ ht
    have hp : (t, θ) ∈ U := ht
    have e1 := (hlt (fun q => a q * w q ^ 2) t θ (hdiff _ hG1 _ hp)).unique
      ((hlt a t θ (hdiff a ha _ hp)).mul ((hlt w t θ (hdiff w hw _ hp)).pow 2))
    have e2 := (hls (fun q => b q * w q ^ 2) t θ (hdiff _ hR1 _ hp)).unique
      ((hls b t θ (hdiff b hb _ hp)).mul ((hls w t θ (hdiff w hw _ hp)).pow 2))
    rw [e1, e2]
    simp only [fplV0]
    norm_num
    ring
  have hP2 : ∀ t θ : ℝ, t < T → fplDt (fun q => w q * fplV0 a b w q) (t, θ) =
      fplV0 a b w (t, θ) ^ 2 / a (t, θ) + fplDs w (t, θ) ^ 2 / a (t, θ) -
        fplDs (fun q => w q * fplV1 b c w q) (t, θ) := by
    intro t θ ht
    have hp : (t, θ) ∈ U := ht
    have ha0 := ha0U _ hp
    have e1 := (hlt (fun q => w q * fplV0 a b w q) t θ (hdiff _ hG2 _ hp)).unique
      ((hlt w t θ (hdiff w hw _ hp)).mul (hlt _ t θ (hdiff _ hV0 _ hp)))
    have e2 := (hls (fun q => w q * fplV1 b c w q) t θ (hdiff _ hR2 _ hp)).unique
      ((hls w t θ (hdiff w hw _ hp)).mul (hls _ t θ (hdiff _ hV1 _ hp)))
    have E1 := (hpt _ hp).2.2.2.2.2.2.2.2
    have E2 := (hpt _ hp).1
    rw [e1, e2]
    have hV0t : fplDt (fplV0 a b w) (t, θ) = -fplDs (fplV1 b c w) (t, θ) := by linarith
    have hc' : c (t, θ) = (1 + b (t, θ) ^ 2) / a (t, θ) := by
      field_simp; linarith
    rw [hV0t]
    simp only [fplV0, fplV1]
    rw [hc']
    field_simp
    ring
  have hP3 : ∀ t θ : ℝ, t < T →
      fplDt (fun q => fplV0 a b w q ^ 2 / a q) (t, θ) -
        fplDt (fun q => fplDs w q ^ 2 / a q) (t, θ) =
      fplDs (fun q => -(b q / a q ^ 2) * fplV0 a b w q ^ 2 -
        2 / a q ^ 2 * (fplV0 a b w q * fplDs w q) + b q / a q ^ 2 * fplDs w q ^ 2) (t, θ) +
      (fplDt a (t, θ) + fplDs b (t, θ)) * (fplDs w (t, θ) ^ 2 - fplV0 a b w (t, θ) ^ 2) /
        a (t, θ) ^ 2 := by
    intro t θ ht
    have hp : (t, θ) ∈ U := ht
    have ha0 := ha0U _ hp
    have ha20 := ha20U _ hp
    have dA := hdiff a ha _ hp
    have dB := hdiff b hb _ hp
    have dC := hdiff c hc _ hp
    have dWt := hdiff _ hwt _ hp
    have dWs := hdiff _ hws _ hp
    have dV0 := hdiff _ hV0 _ hp
    have dV1 := hdiff _ hV1 _ hp
    have E4 := hmix w hw _ hp
    have e1 := (hlt (fun q => fplV0 a b w q ^ 2 / a q) t θ (hdiff _ hG3 _ hp)).unique
      (((hlt _ t θ dV0).pow 2).div (hlt _ t θ dA) ha0)
    have e2 := (hlt (fun q => fplDs w q ^ 2 / a q) t θ (hdiff _ hG4 _ hp)).unique
      (((hlt _ t θ dWs).pow 2).div (hlt _ t θ dA) ha0)
    have e3 := (hls (fun q => -(b q / a q ^ 2) * fplV0 a b w q ^ 2 -
        2 / a q ^ 2 * (fplV0 a b w q * fplDs w q) + b q / a q ^ 2 * fplDs w q ^ 2) t θ
        (hdiff _ hZ _ hp)).unique
      (((((hls _ t θ dB).div ((hls _ t θ dA).pow 2) ha20).neg.mul ((hls _ t θ dV0).pow 2)).sub
        (((hasDerivAt_const θ (2 : ℝ)).div ((hls _ t θ dA).pow 2) ha20).mul
          ((hls _ t θ dV0).mul (hls _ t θ dWs)))).add
        (((hls _ t θ dB).div ((hls _ t θ dA).pow 2) ha20).mul ((hls _ t θ dWs).pow 2)))
    have e4 := (hls (fplV0 a b w) t θ dV0).unique
      (((hls _ t θ dA).mul (hls _ t θ dWt)).add ((hls _ t θ dB).mul (hls _ t θ dWs)))
    have e5 := (hls (fplV1 b c w) t θ dV1).unique
      (((hls _ t θ dB).mul (hls _ t θ dWt)).add ((hls _ t θ dC).mul (hls _ t θ dWs)))
    have hconst : HasDerivAt (fun s => a (t, s) * c (t, s) - b (t, s) ^ 2) 0 θ := by
      have : (fun s => a (t, s) * c (t, s) - b (t, s) ^ 2) = fun _ => (1 : ℝ) :=
        funext fun s => (hpt (t, s) ht).1
      rw [this]; exact hasDerivAt_const _ _
    have e6 := hconst.unique (((hls _ t θ dA).mul (hls _ t θ dC)).sub ((hls _ t θ dB).pow 2))
    have E1 := (hpt _ hp).2.2.2.2.2.2.2.2
    have E2 := (hpt _ hp).1
    rw [e1, e2, e3, e4]
    rw [e5] at E1
    norm_num at e6 E1 ⊢
    have hV0t : fplDt (fplV0 a b w) (t, θ) = -(fplDs b (t, θ) * fplDt w (t, θ) +
        b (t, θ) * fplDs (fplDt w) (t, θ) + (fplDs c (t, θ) * fplDs w (t, θ) +
        c (t, θ) * fplDs (fplDs w) (t, θ))) := by linarith
    have hcs : fplDs c (t, θ) = (2 * b (t, θ) * fplDs b (t, θ) - fplDs a (t, θ) * c (t, θ)) /
        a (t, θ) := by
      field_simp; linarith
    have hc' : c (t, θ) = (1 + b (t, θ) ^ 2) / a (t, θ) := by
      field_simp; linarith
    rw [hV0t, hcs, hc', ← E4]
    simp only [fplV0]
    field_simp
    ring
  obtain ⟨g, hg⟩ : ∃ g : ℝ → ℝ, ∀ t, g t =
      ∫ θ in (-Real.pi)..Real.pi, (fplDt a (t, θ) + fplDs b (t, θ)) * w (t, θ) ^ 2 :=
    ⟨_, fun _ => rfl⟩
  obtain ⟨qf, hq⟩ : ∃ qf : ℝ → ℝ, ∀ t, qf t =
      ∫ θ in (-Real.pi)..Real.pi, (fplDt a (t, θ) + fplDs b (t, θ)) *
        (fplDs w (t, θ) ^ 2 - fplV0 a b w (t, θ) ^ 2) / a (t, θ) ^ 2 :=
    ⟨_, fun _ => rfl⟩
  have habs : ∀ x y u v E : ℝ, |x| ≤ 2 → |y| ≤ 2 → |u| ≤ E → |v| ≤ E →
      |x * u + y * v| ≤ 4 * E := by
    intro x y u v E hx hy hu hv
    calc |x * u + y * v| ≤ |x * u| + |y * v| := abs_add_le _ _
      _ = |x| * |u| + |y| * |v| := by rw [abs_mul, abs_mul]
      _ ≤ 2 * E + 2 * E := add_le_add (mul_le_mul hx hu (abs_nonneg _) (by norm_num))
          (mul_le_mul hy hv (abs_nonneg _) (by norm_num))
      _ = 4 * E := by ring
  have hlims : Tendsto (fplD a b w) atBot (𝓝 0) ∧
      Tendsto (fun s => fplX a b w s - fplY a w s) atBot (𝓝 0) := by
    obtain ⟨C', hC'⟩ := hdec 1
    have hb1 : ∀ t θ : ℝ, t < T → |w (t, θ)| ≤ C' * Real.exp t ∧
        |fplDt w (t, θ)| ≤ C' * Real.exp t ∧ |fplDs w (t, θ)| ≤ C' * Real.exp t := by
      intro t θ ht
      have h := hC' (t, θ) ht
      simp only [Nat.cast_one, one_mul] at h
      exact h
    have hV : ∀ t θ : ℝ, t < T → |fplV0 a b w (t, θ)| ≤ 4 * (C' * Real.exp t) := by
      intro t θ ht
      have haa : |a (t, θ)| ≤ 2 :=
        abs_le.2 ⟨by linarith [(hpt (t, θ) ht).2.1], (hpt (t, θ) ht).2.2.1⟩
      exact habs _ _ _ _ _ haa (hpt (t, θ) ht).2.2.2.1 (hb1 t θ ht).2.1 (hb1 t θ ht).2.2
    have hlimE : ∀ K0 : ℝ, Tendsto (fun t : ℝ => K0 * (C' * Real.exp t) ^ 2 *
        |Real.pi - -Real.pi|) atBot (𝓝 0) := by
      intro K0
      have h := (((Real.tendsto_exp_atBot.const_mul C').pow 2).const_mul K0).mul_const
        |Real.pi - -Real.pi|
      rw [show K0 * (C' * 0) ^ 2 * |Real.pi - -Real.pi| = (0 : ℝ) by ring] at h
      exact h
    constructor
    · refine squeeze_zero_norm' ?_ (hlimE 4)
      filter_upwards [eventually_lt_atBot T] with t ht
      show ‖fplD a b w t‖ ≤ 4 * (C' * Real.exp t) ^ 2 * |Real.pi - -Real.pi|
      unfold fplD
      apply intervalIntegral.norm_integral_le_of_norm_le_const
      intro θ _
      have h1 := (hb1 t θ ht).1
      have h2 := hV t θ ht
      have hE : 0 ≤ C' * Real.exp t := le_trans (abs_nonneg _) h1
      rw [Real.norm_eq_abs, abs_mul]
      exact (mul_le_mul h1 h2 (abs_nonneg _) hE).trans (le_of_eq (by ring))
    · refine squeeze_zero_norm' ?_ (hlimE 34)
      filter_upwards [eventually_lt_atBot T] with t ht
      show ‖fplX a b w t - fplY a w t‖ ≤ 34 * (C' * Real.exp t) ^ 2 * |Real.pi - -Real.pi|
      have hX : ‖fplX a b w t‖ ≤ 32 * (C' * Real.exp t) ^ 2 * |Real.pi - -Real.pi| := by
        unfold fplX
        apply intervalIntegral.norm_integral_le_of_norm_le_const
        intro θ _
        have ha2 := (hpt (t, θ) ht).2.1
        have hA : 0 < a (t, θ) := by linarith
        have h2 := hV t θ ht
        have hsq : fplV0 a b w (t, θ) ^ 2 ≤ (4 * (C' * Real.exp t)) ^ 2 := by
          rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) h2 2
        have hm := mul_nonneg (sq_nonneg (C' * Real.exp t)) (by linarith : 0 ≤ a (t, θ) - 1 / 2)
        rw [Real.norm_eq_abs, abs_of_nonneg (div_nonneg (sq_nonneg _) hA.le), div_le_iff₀ hA]
        nlinarith [sq_nonneg (fplV0 a b w (t, θ))]
      have hY : ‖fplY a w t‖ ≤ 2 * (C' * Real.exp t) ^ 2 * |Real.pi - -Real.pi| := by
        unfold fplY
        apply intervalIntegral.norm_integral_le_of_norm_le_const
        intro θ _
        have ha2 := (hpt (t, θ) ht).2.1
        have hA : 0 < a (t, θ) := by linarith
        have h2 := (hb1 t θ ht).2.2
        have hsq : fplDs w (t, θ) ^ 2 ≤ (C' * Real.exp t) ^ 2 := by
          rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) h2 2
        have hm := mul_nonneg (sq_nonneg (C' * Real.exp t)) (by linarith : 0 ≤ a (t, θ) - 1 / 2)
        rw [Real.norm_eq_abs, abs_of_nonneg (div_nonneg (sq_nonneg _) hA.le), div_le_iff₀ hA]
        nlinarith [sq_nonneg (fplDs w (t, θ))]
      calc ‖fplX a b w t - fplY a w t‖ ≤ ‖fplX a b w t‖ + ‖fplY a w t‖ := norm_sub_le _ _
        _ ≤ _ := by linarith
  have hHdec : ∀ K : ℕ, ∃ CK : ℝ, ∀ t < T, fplH a w t ≤ CK * Real.exp (K * t) := by
    intro K
    obtain ⟨CK, hCK⟩ := hdec K
    refine ⟨2 * CK ^ 2 * Real.exp (K * |T|) * |Real.pi - -Real.pi|, fun t ht => ?_⟩
    have hP : 0 ≤ |Real.pi - -Real.pi| := abs_nonneg _
    have hu := Real.exp_pos (K * t)
    have huv : Real.exp (K * t) ≤ Real.exp (K * |T|) :=
      Real.exp_le_exp.2 (mul_le_mul_of_nonneg_left (by linarith [le_abs_self T])
        (Nat.cast_nonneg K))
    have hn : ‖fplH a w t‖ ≤ 2 * (CK * Real.exp (K * t)) ^ 2 * |Real.pi - -Real.pi| := by
      unfold fplH
      apply intervalIntegral.norm_integral_le_of_norm_le_const
      intro θ _
      have ha2 := (hpt (t, θ) ht).2.1
      have ha3 := (hpt (t, θ) ht).2.2.1
      have h1 : |w (t, θ)| ≤ CK * Real.exp (K * t) := (hCK (t, θ) ht).1
      have hsq : w (t, θ) ^ 2 ≤ (CK * Real.exp (K * t)) ^ 2 := by
        rw [← sq_abs]; exact pow_le_pow_left₀ (abs_nonneg _) h1 2
      have hm := mul_nonneg (by linarith : 0 ≤ 2 - a (t, θ)) (sq_nonneg (w (t, θ)))
      rw [Real.norm_eq_abs, abs_of_nonneg (mul_nonneg (by linarith) (sq_nonneg _))]
      nlinarith [sq_nonneg (w (t, θ))]
    have h1 := le_abs_self (fplH a w t)
    rw [← Real.norm_eq_abs] at h1
    have h3 := mul_nonneg (mul_nonneg (mul_nonneg (sq_nonneg CK) hP) hu.le) (sub_nonneg.2 huv)
    nlinarith
  have hvan : ∀ t < T, fplH a w t = 0 → ∀ θ : ℝ, w (t, θ) = 0 := by
    intro t ht hH θ
    have hperf : Function.Periodic (fun θ => w (t, θ)) (2 * Real.pi) :=
      fun θ => (hper (t, θ) ht).2.2.2
    obtain ⟨y, hy, hfy⟩ := hperf.exists_mem_Ico Real.two_pi_pos θ (-Real.pi)
    have hfy' : w (t, θ) = w (t, y) := hfy
    rw [hfy']
    by_contra hne
    have hpos : 0 < fplH a w t := by
      unfold fplH
      refine intervalIntegral.integral_pos (by linarith [Real.pi_pos]) ?_ ?_
        ⟨y, ⟨hy.1, by linarith [hy.2]⟩, ?_⟩
      · exact (hcont _ hG1.continuousOn t ht).continuousOn
      · intro x _
        exact mul_nonneg (by linarith [(hpt (t, x) ht).2.1]) (sq_nonneg _)
      · exact mul_pos (by linarith [(hpt (t, y) ht).2.1])
          (lt_of_le_of_ne (sq_nonneg _) (Ne.symm (pow_ne_zero 2 hne)))
    linarith
  refine ⟨⟨4 * C₁, g, qf, by linarith, fun t ht => ?_, hlims.1, hlims.2, hHdec⟩, hvan⟩
  have ii : ∀ F : ℝ × ℝ → ℝ, ContinuousOn F U →
      IntervalIntegrable (fun θ => F (t, θ)) volume (-Real.pi) Real.pi :=
    fun F hF => (hcont F hF t ht).intervalIntegrable _ _
  have iH : IntervalIntegrable (fun θ => a (t, θ) * w (t, θ) ^ 2) volume (-Real.pi) Real.pi :=
    ii _ hG1.continuousOn
  have iD : IntervalIntegrable (fun θ => w (t, θ) * fplV0 a b w (t, θ)) volume
      (-Real.pi) Real.pi := ii _ hG2.continuousOn
  have iX : IntervalIntegrable (fun θ => fplV0 a b w (t, θ) ^ 2 / a (t, θ)) volume
      (-Real.pi) Real.pi := ii _ hG3.continuousOn
  have iY : IntervalIntegrable (fun θ => fplDs w (t, θ) ^ 2 / a (t, θ)) volume
      (-Real.pi) Real.pi := ii _ hG4.continuousOn
  have ig : IntervalIntegrable (fun θ => (fplDt a (t, θ) + fplDs b (t, θ)) * w (t, θ) ^ 2) volume
      (-Real.pi) Real.pi := ii _ hgC.continuousOn
  have iqq : IntervalIntegrable (fun θ => (fplDt a (t, θ) + fplDs b (t, θ)) *
      (fplDs w (t, θ) ^ 2 - fplV0 a b w (t, θ) ^ 2) / a (t, θ) ^ 2) volume
      (-Real.pi) Real.pi := ii _ hqC.continuousOn
  have iR1 : IntervalIntegrable (fun θ => fplDs (fun q => b q * w q ^ 2) (t, θ)) volume
      (-Real.pi) Real.pi := ii _ (hD _ hR1).2.continuousOn
  have iR2 : IntervalIntegrable (fun θ => fplDs (fun q => w q * fplV1 b c w q) (t, θ)) volume
      (-Real.pi) Real.pi := ii _ (hD _ hR2).2.continuousOn
  have iG3t : IntervalIntegrable (fun θ => fplDt (fun q => fplV0 a b w q ^ 2 / a q) (t, θ))
      volume (-Real.pi) Real.pi := ii _ (hD _ hG3).1.continuousOn
  have iG4t : IntervalIntegrable (fun θ => fplDt (fun q => fplDs w q ^ 2 / a q) (t, θ))
      volume (-Real.pi) Real.pi := ii _ (hD _ hG4).1.continuousOn
  have iZs : IntervalIntegrable (fun θ => fplDs (fun q => -(b q / a q ^ 2) * fplV0 a b w q ^ 2 -
      2 / a q ^ 2 * (fplV0 a b w q * fplDs w q) + b q / a q ^ 2 * fplDs w q ^ 2) (t, θ))
      volume (-Real.pi) Real.pi := ii _ (hD _ hZ).2.continuousOn
  obtain ⟨ea, eb, ec, ew, ewt, ews⟩ := hend t ht
  have hH0 : 0 ≤ fplH a w t := by
    unfold fplH
    exact intervalIntegral.integral_nonneg hpi (fun θ _ =>
      mul_nonneg (by linarith [(hpt (t, θ) ht).2.1]) (sq_nonneg _))
  have hX0 : 0 ≤ fplX a b w t := by
    unfold fplX
    exact intervalIntegral.integral_nonneg hpi (fun θ _ =>
      div_nonneg (sq_nonneg _) (by linarith [(hpt (t, θ) ht).2.1]))
  have hY0 : 0 ≤ fplY a w t := by
    unfold fplY
    exact intervalIntegral.integral_nonneg hpi (fun θ _ =>
      div_nonneg (sq_nonneg _) (by linarith [(hpt (t, θ) ht).2.1]))
  have hCS : fplD a b w t ^ 2 ≤ fplH a w t * fplX a b w t := by
    have key : ∀ x : ℝ, 0 ≤ fplH a w t * (x * x) + (2 * fplD a b w t) * x + fplX a b w t := by
      intro x
      have e : ∫ θ in (-Real.pi)..Real.pi, ((x * x) * (a (t, θ) * w (t, θ) ^ 2) +
          (2 * x) * (w (t, θ) * fplV0 a b w (t, θ)) + fplV0 a b w (t, θ) ^ 2 / a (t, θ)) =
          fplH a w t * (x * x) + (2 * fplD a b w t) * x + fplX a b w t := by
        rw [intervalIntegral.integral_add ((iH.const_mul _).add (iD.const_mul _)) iX,
          intervalIntegral.integral_add (iH.const_mul _) (iD.const_mul _),
          intervalIntegral.integral_const_mul, intervalIntegral.integral_const_mul]
        unfold fplH fplD fplX
        ring
      rw [← e]
      apply intervalIntegral.integral_nonneg hpi
      intro θ _
      have ha2 := (hpt (t, θ) ht).2.1
      have ha0 : a (t, θ) ≠ 0 := ha0U (t, θ) ht
      have hr : (x * x) * (a (t, θ) * w (t, θ) ^ 2) +
          (2 * x) * (w (t, θ) * fplV0 a b w (t, θ)) + fplV0 a b w (t, θ) ^ 2 / a (t, θ) =
          a (t, θ) * (x * w (t, θ) + fplV0 a b w (t, θ) / a (t, θ)) ^ 2 := by
        field_simp; ring
      rw [hr]
      exact mul_nonneg (by linarith) (sq_nonneg _)
    have hd := discrim_le_zero key
    unfold discrim at hd
    nlinarith
  have hHd : HasDerivAt (fplH a w) (2 * fplD a b w t + g t) t := by
    have h1 : HasDerivAt (fplH a w)
        (∫ θ in (-Real.pi)..Real.pi, fplDt (fun q => a q * w q ^ 2) (t, θ)) t := hderI _ hG1 t ht
    refine h1.congr_deriv ?_
    have eR1 : (fun q => b q * w q ^ 2) (t, Real.pi) = (fun q => b q * w q ^ 2) (t, -Real.pi) := by
      simp only [eb, ew]
    rw [intervalIntegral.integral_congr (fun θ _ => hP1 t θ ht),
      intervalIntegral.integral_sub ((iD.const_mul 2).add ig) iR1,
      intervalIntegral.integral_add (iD.const_mul 2) ig, intervalIntegral.integral_const_mul,
      hDs0 _ hR1 t ht eR1, hg]
    unfold fplD
    ring
  have hDd : HasDerivAt (fplD a b w) (fplX a b w t + fplY a w t) t := by
    have h1 : HasDerivAt (fplD a b w)
        (∫ θ in (-Real.pi)..Real.pi, fplDt (fun q => w q * fplV0 a b w q) (t, θ)) t :=
      hderI _ hG2 t ht
    refine h1.congr_deriv ?_
    have eR2 : (fun q => w q * fplV1 b c w q) (t, Real.pi) =
        (fun q => w q * fplV1 b c w q) (t, -Real.pi) := by
      simp only [fplV1, eb, ec, ew, ewt, ews]
    rw [intervalIntegral.integral_congr (fun θ _ => hP2 t θ ht),
      intervalIntegral.integral_sub (iX.add iY) iR2, intervalIntegral.integral_add iX iY,
      hDs0 _ hR2 t ht eR2]
    unfold fplX fplY
    ring
  have hQd : HasDerivAt (fun s => fplX a b w s - fplY a w s) (qf t) t := by
    have h3 : HasDerivAt (fplX a b w)
        (∫ θ in (-Real.pi)..Real.pi, fplDt (fun q => fplV0 a b w q ^ 2 / a q) (t, θ)) t :=
      hderI _ hG3 t ht
    have h4 : HasDerivAt (fplY a w)
        (∫ θ in (-Real.pi)..Real.pi, fplDt (fun q => fplDs w q ^ 2 / a q) (t, θ)) t :=
      hderI _ hG4 t ht
    refine (h3.sub h4).congr_deriv ?_
    have eZ : (fun q => -(b q / a q ^ 2) * fplV0 a b w q ^ 2 -
        2 / a q ^ 2 * (fplV0 a b w q * fplDs w q) + b q / a q ^ 2 * fplDs w q ^ 2) (t, Real.pi) =
        (fun q => -(b q / a q ^ 2) * fplV0 a b w q ^ 2 -
        2 / a q ^ 2 * (fplV0 a b w q * fplDs w q) + b q / a q ^ 2 * fplDs w q ^ 2)
          (t, -Real.pi) := by
      simp only [fplV0, ea, eb, ew, ewt, ews]
    rw [← intervalIntegral.integral_sub iG3t iG4t,
      intervalIntegral.integral_congr (fun θ _ => hP3 t θ ht),
      intervalIntegral.integral_add iZs iqq, hDs0 _ hZ t ht eZ, zero_add, hq]
  have hkb : ∀ θ : ℝ, |fplDt a (t, θ) + fplDs b (t, θ)| ≤ 2 * (C₁ * Real.exp t) := by
    intro θ
    have h1 : |fplDt a (t, θ)| ≤ C₁ * Real.exp t := (hpt (t, θ) ht).2.2.2.2.1
    have h2 : |fplDs b (t, θ)| ≤ C₁ * Real.exp t := (hpt (t, θ) ht).2.2.2.2.2.2.2.1
    linarith [abs_add_le (fplDt a (t, θ)) (fplDs b (t, θ))]
  have hE : 0 ≤ C₁ * Real.exp t := mul_nonneg hC₁ (Real.exp_pos t).le
  have hgb : |g t| ≤ 4 * C₁ * Real.exp t * fplH a w t := by
    rw [hg]
    calc |∫ θ in (-Real.pi)..Real.pi, (fplDt a (t, θ) + fplDs b (t, θ)) * w (t, θ) ^ 2|
        ≤ ∫ θ in (-Real.pi)..Real.pi, |(fplDt a (t, θ) + fplDs b (t, θ)) * w (t, θ) ^ 2| :=
          intervalIntegral.abs_integral_le_integral_abs hpi
      _ ≤ ∫ θ in (-Real.pi)..Real.pi, 4 * C₁ * Real.exp t * (a (t, θ) * w (t, θ) ^ 2) := by
          refine intervalIntegral.integral_mono_on hpi ig.abs (iH.const_mul _) (fun θ _ => ?_)
          have hk := hkb θ
          have ha2 := (hpt (t, θ) ht).2.1
          rw [abs_mul, abs_of_nonneg (sq_nonneg (w (t, θ)))]
          have h1 := mul_le_mul_of_nonneg_right hk (sq_nonneg (w (t, θ)))
          have h2 := mul_nonneg (mul_nonneg hE (sq_nonneg (w (t, θ))))
            (show 0 ≤ 2 * a (t, θ) - 1 by linarith)
          nlinarith
      _ = 4 * C₁ * Real.exp t * fplH a w t := intervalIntegral.integral_const_mul _ _
  have hqb : |qf t| ≤ 4 * C₁ * Real.exp t * (fplX a b w t + fplY a w t) := by
    rw [hq]
    calc |∫ θ in (-Real.pi)..Real.pi, (fplDt a (t, θ) + fplDs b (t, θ)) *
          (fplDs w (t, θ) ^ 2 - fplV0 a b w (t, θ) ^ 2) / a (t, θ) ^ 2|
        ≤ ∫ θ in (-Real.pi)..Real.pi, |(fplDt a (t, θ) + fplDs b (t, θ)) *
          (fplDs w (t, θ) ^ 2 - fplV0 a b w (t, θ) ^ 2) / a (t, θ) ^ 2| :=
          intervalIntegral.abs_integral_le_integral_abs hpi
      _ ≤ ∫ θ in (-Real.pi)..Real.pi, 4 * C₁ * Real.exp t *
          (fplV0 a b w (t, θ) ^ 2 / a (t, θ) + fplDs w (t, θ) ^ 2 / a (t, θ)) := by
          refine intervalIntegral.integral_mono_on hpi iqq.abs ((iX.add iY).const_mul _)
            (fun θ _ => ?_)
          have hk := hkb θ
          have ha2 := (hpt (t, θ) ht).2.1
          have hA : 0 < a (t, θ) := by linarith
          have h1 : |fplDs w (t, θ) ^ 2 - fplV0 a b w (t, θ) ^ 2| ≤
              fplDs w (t, θ) ^ 2 + fplV0 a b w (t, θ) ^ 2 :=
            abs_le.2 ⟨by nlinarith [sq_nonneg (fplDs w (t, θ)), sq_nonneg (fplV0 a b w (t, θ))],
              by nlinarith [sq_nonneg (fplDs w (t, θ)), sq_nonneg (fplV0 a b w (t, θ))]⟩
          have h2 := mul_le_mul hk h1 (abs_nonneg _) (by linarith)
          have h3 := mul_nonneg (mul_nonneg hE (add_nonneg (sq_nonneg (fplDs w (t, θ)))
            (sq_nonneg (fplV0 a b w (t, θ))))) (show 0 ≤ 2 * a (t, θ) - 1 by linarith)
          have heq : 4 * C₁ * Real.exp t * (fplV0 a b w (t, θ) ^ 2 / a (t, θ) +
              fplDs w (t, θ) ^ 2 / a (t, θ)) * a (t, θ) ^ 2 =
              4 * C₁ * Real.exp t * (fplDs w (t, θ) ^ 2 + fplV0 a b w (t, θ) ^ 2) * a (t, θ) := by
            field_simp; ring
          rw [abs_div, abs_mul, abs_of_pos (by positivity : (0 : ℝ) < a (t, θ) ^ 2),
            div_le_iff₀ (by positivity), heq]
          nlinarith
      _ = 4 * C₁ * Real.exp t * (fplX a b w t + fplY a w t) := by
          rw [intervalIntegral.integral_const_mul, intervalIntegral.integral_add iX iY]
          rfl
  exact ⟨hH0, hX0, hY0, hCS, hHd, hgb, hDd, hQd, hqb⟩

theorem lap2_flat_point_locally_const (V : Set E2) (hV : IsOpen V)
    (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a b) V)
    (hpos : ∀ x ∈ V, (h x).PosDef)
    (u : E2 → ℝ) (hu : ContDiffOn ℝ ∞ u V) (hharm : ∀ x ∈ V, lap2 h u x = 0)
    (x₀ : E2) (hx₀ : x₀ ∈ V)
    (hflat : ∀ k : ℕ, 1 ≤ k → iteratedFDeriv ℝ k u x₀ = 0) :
    ∀ᶠ x in 𝓝 x₀, u x = u x₀ :=
by
  obtain ⟨ρ, hρ, hball, hdec⟩ := flat_taylor_decay V hV u hu x₀ hx₀ hflat
  obtain ⟨T, C₁, a, b, c, w, hC₁, hcyl, hwdec, hfin⟩ :=
    lap2_cylinder_reduction V hV h hh hpos u hu hharm x₀ ρ hρ hball hdec
  obtain ⟨⟨C, g, q, hC, hpt, hDlim, hQlim, hHdec⟩, hvan⟩ :=
    cyl_energy_identities T C₁ a b c w hC₁ hcyl hwdec
  have hH0 := frequency_ode_vanish T C hC (fplH a w) (fplD a b w) (fplX a b w) (fplY a w)
    (fun s => fplX a b w s - fplY a w s) g q
    (fun t ht => (hpt t ht).1) (fun t ht => (hpt t ht).2.1) (fun t ht => (hpt t ht).2.2.1)
    (fun t ht => (hpt t ht).2.2.2.1) (fun t ht => (hpt t ht).2.2.2.2.1)
    (fun t ht => (hpt t ht).2.2.2.2.2.1) (fun t ht => (hpt t ht).2.2.2.2.2.2.1)
    (fun _ _ => rfl) (fun t ht => (hpt t ht).2.2.2.2.2.2.2.1)
    (fun t ht => (hpt t ht).2.2.2.2.2.2.2.2) hDlim hQlim hHdec
  apply hfin
  intro p hp
  exact hvan p.1 hp (hH0 p.1 hp) p.2

theorem e2_crit_nonflat_null (hsub : ∀ (W : Set E2) (f : E2 → ℝ), IsOpen W → ContDiffOn ℝ ∞ f W →
      (∀ z ∈ W, fderiv ℝ f z ≠ 0) → MeasureTheory.volume (W ∩ f ⁻¹' {0}) = 0)
    (V : Set E2) (hV : IsOpen V) (f : E2 → ℝ) (hf : ContDiffOn ℝ ∞ f V) :
    MeasureTheory.volume {x | x ∈ V ∧ fderiv ℝ f x = 0 ∧
      ∃ k : ℕ, 1 ≤ k ∧ iteratedFDeriv ℝ k f x ≠ 0} = 0 :=
by
  classical
  
  have hsm : ∀ (m : ℕ) (u : Fin m → E2),
      ContDiffOn ℝ ∞ (fun y => iteratedFDeriv ℝ m f y u) V ∧
      ∀ y ∈ V, ∀ v : E2,
        fderiv ℝ (fun y' => iteratedFDeriv ℝ m f y' u) y v =
          fderiv ℝ (iteratedFDeriv ℝ m f) y v u := by
    intro m u
    have hat : ∀ y ∈ V, ContDiffAt ℝ ∞ (iteratedFDeriv ℝ m f) y := by
      intro y hy
      have hfy : ContDiffAt ℝ ∞ f y := hf.contDiffAt (hV.mem_nhds hy)
      refine hfy.iteratedFDeriv_right ?_
      rw [← WithTop.coe_natCast, ← WithTop.coe_add, top_add]
    refine ⟨fun y hy => ?_, fun y hy v => ?_⟩
    · have h1 := (ContinuousMultilinearMap.apply ℝ (fun _ : Fin m => E2) ℝ u).contDiff.contDiffAt.comp
        y (hat y hy)
      exact h1.contDiffWithinAt
    · have hd : DifferentiableAt ℝ (iteratedFDeriv ℝ m f) y :=
        (hat y hy).differentiableAt (by simp)
      exact fderiv_continuousMultilinear_apply_const_apply hd u v
  
  have hbw : ∀ (m : ℕ) (L : ContinuousMultilinearMap ℝ (fun _ : Fin m => E2) ℝ), L ≠ 0 →
      ∃ ι : Fin m → Fin 2, L (fun i => e2 (ι i)) ≠ 0 := by
    intro m L hL
    by_contra hcon
    push_neg at hcon
    apply hL
    apply ContinuousMultilinearMap.toMultilinearMap_injective
    rw [ContinuousMultilinearMap.toMultilinearMap_zero]
    refine Module.Basis.ext_multilinear (ιM := fun _ => Fin 2)
      (fun _ => (EuclideanSpace.basisFun (Fin 2) ℝ).toBasis) ?_
    intro v
    simp only [OrthonormalBasis.coe_toBasis, EuclideanSpace.basisFun_apply,
      ContinuousMultilinearMap.coe_coe, MultilinearMap.zero_apply]
    exact hcon v
  
  let φ : (Σ m : ℕ, Fin m → Fin 2) → E2 → ℝ :=
    fun p y => iteratedFDeriv ℝ p.1 f y (fun i => e2 (p.2 i))
  let N : (Σ m : ℕ, Fin m → Fin 2) → Set E2 :=
    fun p => (V ∩ (fderiv ℝ (φ p)) ⁻¹' {0}ᶜ) ∩ φ p ⁻¹' {0}
  have hN : ∀ p, MeasureTheory.volume (N p) = 0 := by
    intro p
    have hφ := (hsm p.1 (fun i => e2 (p.2 i))).1
    have hopen : IsOpen (V ∩ (fderiv ℝ (φ p)) ⁻¹' {0}ᶜ) :=
      (hφ.continuousOn_fderiv_of_isOpen hV (by simp)).isOpen_inter_preimage hV
        isOpen_compl_singleton
    exact hsub _ (φ p) hopen (hφ.mono Set.inter_subset_left) (fun z hz => hz.2)
  have hcover : {x | x ∈ V ∧ fderiv ℝ f x = 0 ∧
      ∃ k : ℕ, 1 ≤ k ∧ iteratedFDeriv ℝ k f x ≠ 0} ⊆ ⋃ p, N p := by
    rintro x ⟨hxV, hdf, H⟩
    have hk1 := Nat.find_spec H
    set k₀ := Nat.find H with hk₀
    have hne1 : k₀ ≠ 1 := by
      intro h1
      apply hk1.2
      rw [h1]
      rw [← norm_eq_zero, norm_iteratedFDeriv_one, hdf, norm_zero]
    obtain ⟨m, hm⟩ : ∃ m, k₀ = m + 1 := ⟨k₀ - 1, by omega⟩
    have hm1 : 1 ≤ m := by omega
    have hDm : iteratedFDeriv ℝ m f x = 0 := by
      have hmin := Nat.find_min H (show m < Nat.find H by omega)
      push_neg at hmin
      exact hmin hm1
    have hDm1 : iteratedFDeriv ℝ (m + 1) f x ≠ 0 := by rw [← hm]; exact hk1.2
    obtain ⟨v, hv⟩ : ∃ v, iteratedFDeriv ℝ (m + 1) f x v ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      exact hDm1 (ContinuousMultilinearMap.ext hcon)
    rw [iteratedFDeriv_succ_apply_left] at hv
    have hL : fderiv ℝ (iteratedFDeriv ℝ m f) x (v 0) ≠ 0 := by
      intro h0
      rw [h0, ContinuousMultilinearMap.zero_apply] at hv
      exact hv rfl
    obtain ⟨ι, hι⟩ := hbw m _ hL
    refine Set.mem_iUnion.2 ⟨⟨m, ι⟩, ⟨hxV, ?_⟩, ?_⟩
    · show fderiv ℝ (φ ⟨m, ι⟩) x ∉ ({0} : Set (E2 →L[ℝ] ℝ))
      intro h0
      have h0' : fderiv ℝ (φ ⟨m, ι⟩) x = 0 := h0
      have hfor := (hsm m (fun i => e2 (ι i))).2 x hxV (v 0)
      apply hι
      rw [← hfor]
      show fderiv ℝ (φ ⟨m, ι⟩) x (v 0) = 0
      rw [h0']
      rfl
    · show iteratedFDeriv ℝ m f x (fun i => e2 (ι i)) = 0
      rw [hDm]
      rfl
  exact MeasureTheory.measure_mono_null hcover (MeasureTheory.measure_iUnion_null hN)

theorem pcgb_no_flat_point {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (b : X → ℝ)
    (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (hRconn : IsConnected {q | q ∈ S ∧ 0 ≤ b q})
    (hbd : ∃ q ∈ S, b q = 0) (Gd : PcgbGreenData P b)
    (hsucp : ∀ j, ∀ x ∈ P.W j, 0 < b (P.param j x) → P.param j x ≠ Gd.p₀ →
      (∀ k : ℕ, 1 ≤ k → iteratedFDeriv ℝ k (fun y => Gd.w (P.param j y)) x = 0) →
      ∀ᶠ y in 𝓝 x, Gd.w (P.param j y) = Gd.w (P.param j x)) :
    ∀ j, ∀ x ∈ P.W j, 0 < b (P.param j x) → P.param j x ≠ Gd.p₀ →
      ∃ k : ℕ, 1 ≤ k ∧ iteratedFDeriv ℝ k (fun y => Gd.w (P.param j y)) x ≠ 0 :=
by
  intro j x hx hbx hp
  by_contra hcon
  push_neg at hcon
  
  have hparamS : ∀ i, ∀ y ∈ P.W i, P.param i y ∈ S ∧ P.param i y ∈ P.O i := by
    intro i y hy
    have h1 : P.param i y ∈ P.param i '' P.W i := Set.mem_image_of_mem _ hy
    rw [P.image_eq i] at h1
    exact ⟨h1.2, h1.1⟩
  have hC0 : ∀ q ∈ S, ∃ i, ∃ y ∈ P.W i, P.param i y = q := by
    intro q hq
    obtain ⟨i, hi⟩ := Set.mem_iUnion.mp (P.cover hq)
    have h1 : q ∈ P.param i '' P.W i := by rw [P.image_eq i]; exact ⟨hi, hq⟩
    obtain ⟨y, hy, hyq⟩ := h1
    exact ⟨i, y, hy, hyq⟩
  have htrans : ∀ i, ∀ y ∈ P.W i, ∀ p : E2 → Prop, (∀ᶠ z in 𝓝 y, p z) →
      ∀ᶠ q in 𝓝 (P.param i y), q ∈ S → ∃ z ∈ P.W i, P.param i z = q ∧ p z := by
    intro i y hy p hpz
    obtain ⟨t, ht, hto, hyt⟩ := _root_.eventually_nhds_iff.mp hpz
    have hN : IsOpen (P.O i ∩ P.proj i ⁻¹' (t ∩ P.W i)) :=
      (P.proj_cont i).isOpen_inter_preimage (P.O_open i) (hto.inter (P.W_open i))
    have hqN : P.param i y ∈ P.O i ∩ P.proj i ⁻¹' (t ∩ P.W i) := by
      refine ⟨(hparamS i y hy).2, ?_⟩
      show P.proj i (P.param i y) ∈ t ∩ P.W i
      rw [P.proj_param i y hy]
      exact ⟨hyt, hy⟩
    filter_upwards [hN.mem_nhds hqN] with q hq hqS
    have h1 : q ∈ P.param i '' P.W i := by rw [P.image_eq i]; exact ⟨hq.1, hqS⟩
    obtain ⟨z, hz, rfl⟩ := h1
    have h2 : P.proj i (P.param i z) ∈ t ∩ P.W i := hq.2
    rw [P.proj_param i z hz] at h2
    exact ⟨z, hz, rfl, ht z h2.1⟩
  have hback : ∀ i, ∀ y ∈ P.W i, ∀ Φ : X → Prop, (∀ᶠ q in 𝓝 (P.param i y), Φ q) →
      ∀ᶠ z in 𝓝 y, z ∈ P.W i ∧ Φ (P.param i z) := by
    intro i y hy Φ hΦ
    have hc : ContinuousAt (P.param i) y :=
      (P.param_cont i).continuousAt ((P.W_open i).mem_nhds hy)
    have hW : ∀ᶠ z in 𝓝 y, z ∈ P.W i := (P.W_open i).mem_nhds hy
    exact hW.and (Filter.Tendsto.eventually hc hΦ)
  have hsmoothAt : ∀ i, ∀ y ∈ P.W i, P.param i y ∈ Gd.U → P.param i y ≠ Gd.p₀ →
      ContDiffAt ℝ ∞ (fun z => Gd.w (P.param i z)) y := by
    intro i y hy hU hne
    have hV : IsOpen (P.W i ∩ P.param i ⁻¹' (Gd.U \ {Gd.p₀})) :=
      (P.param_cont i).isOpen_inter_preimage (P.W_open i) (Gd.U_open.sdiff isClosed_singleton)
    exact (Gd.smooth i).contDiffAt (hV.mem_nhds ⟨hy, hU, hne⟩)
  have hbp₀ : 0 < b Gd.p₀ := by
    have h1 := Gd.ball_pos Gd.x₀ (Metric.mem_closedBall_self Gd.r_pos.le)
    rw [Gd.param_x₀] at h1
    linarith [Gd.r_pos]
  
  have hgood : ∀ (c : ℝ) (i : Fin P.n), ∀ y ∈ P.W i, 0 < b (P.param i y) →
      P.param i y ≠ Gd.p₀ → (∀ᶠ z in 𝓝 y, Gd.w (P.param i z) = c) →
      ∀ᶠ q in 𝓝 (P.param i y), q ∈ S → Gd.w q = c ∧ 0 < b q ∧ q ≠ Gd.p₀ := by
    intro c i y hy hby hpy hc
    have hbc : ContinuousAt (fun z => b (P.param i z)) y :=
      (hb i).continuousOn.continuousAt ((P.W_open i).mem_nhds hy)
    have hbpos : ∀ᶠ z in 𝓝 y, 0 < b (P.param i z) :=
      Filter.Tendsto.eventually hbc (lt_mem_nhds hby)
    have hne : ∀ᶠ q in 𝓝 (P.param i y), q ≠ Gd.p₀ := eventually_ne_nhds hpy
    filter_upwards [htrans i y hy _ (hc.and hbpos), hne] with q hq hq0 hqS
    obtain ⟨z, hz, rfl, hzc, hzb⟩ := hq hqS
    exact ⟨hzc, hzb, hq0⟩
  
  have hbdry : ∀ (c : ℝ), c < 0 → ∀ q ∈ S, b q = 0 →
      ∀ᶠ q' in 𝓝 q, q' ∈ S → c < Gd.w q' := by
    intro c hc q hqS hq0
    obtain ⟨i, y, hy, rfl⟩ := hC0 q hqS
    have hw0 := (Gd.dirichlet i y hy hq0).1
    have hne : P.param i y ≠ Gd.p₀ := by
      intro h
      rw [h] at hq0
      linarith
    have hU : P.param i y ∈ Gd.U := Gd.R_sub ⟨hqS, hq0.ge⟩
    have hcont := (hsmoothAt i y hy hU hne).continuousAt
    have hnb : ∀ᶠ t in 𝓝 (Gd.w (P.param i y)), c < t := by
      rw [hw0]
      exact lt_mem_nhds hc
    have hev : ∀ᶠ z in 𝓝 y, c < Gd.w (P.param i z) := Filter.Tendsto.eventually hcont hnb
    filter_upwards [htrans i y hy _ hev] with q' hq' hq'S
    obtain ⟨z, hz, rfl, hzc⟩ := hq' hq'S
    exact hzc
  
  have hpole : ∀ c : ℝ, ∀ᶠ q in 𝓝 Gd.p₀, q ∈ S → q ≠ Gd.p₀ → Gd.w q < c := by
    intro c
    have hx₀W : Gd.x₀ ∈ P.W Gd.j₀ := Gd.ball_sub (Metric.mem_closedBall_self Gd.r_pos.le)
    have hHpd : (P.h Gd.j₀ Gd.x₀).PosDef := P.h_posDef Gd.j₀ Gd.x₀ hx₀W
    obtain ⟨Mb, hMb⟩ : ∃ Mb : ℝ, Mb = ∑ a : Fin 2, ∑ a' : Fin 2, |P.h Gd.j₀ Gd.x₀ a a'| :=
      ⟨_, rfl⟩
    have hMb0 : 0 ≤ Mb := by
      rw [hMb]
      exact Finset.sum_nonneg (fun a _ => Finset.sum_nonneg (fun a' _ => abs_nonneg _))
    obtain ⟨E, hE⟩ : ∃ E : ℝ, E = Real.exp (c - Gd.C) := ⟨_, rfl⟩
    have hE0 : 0 < E := by rw [hE]; exact Real.exp_pos _
    obtain ⟨δ, hδ⟩ : ∃ δ : ℝ, δ = min Gd.r (min 1 (E ^ 2 / (Mb + 1))) := ⟨_, rfl⟩
    have hδ0 : 0 < δ := by
      rw [hδ]
      exact lt_min Gd.r_pos (lt_min one_pos (div_pos (pow_pos hE0 2) (by linarith)))
    have key : ∀ y ∈ Metric.ball Gd.x₀ δ, y ≠ Gd.x₀ → Gd.w (P.param Gd.j₀ y) < c := by
      intro y hy hyne
      have hd : dist y Gd.x₀ < δ := hy
      rw [hδ] at hd
      obtain ⟨hdr, hd'⟩ := lt_min_iff.mp hd
      obtain ⟨hd1, hdE⟩ := lt_min_iff.mp hd'
      have hd0 : 0 ≤ dist y Gd.x₀ := dist_nonneg
      have hvne : (fun a => (y - Gd.x₀) a) ≠ 0 := by
        intro h
        apply hyne
        have : y - Gd.x₀ = 0 := by
          ext a
          have := congrFun h a
          simpa using this
        exact sub_eq_zero.mp this
      have hQpos : 0 < ∑ a : Fin 2, ∑ a' : Fin 2,
          P.h Gd.j₀ Gd.x₀ a a' * (y - Gd.x₀) a * (y - Gd.x₀) a' := by
        have h := hHpd.dotProduct_mulVec_pos hvne
        have heq : dotProduct (star (fun a => (y - Gd.x₀) a))
            ((P.h Gd.j₀ Gd.x₀).mulVec (fun a => (y - Gd.x₀) a)) =
            ∑ a : Fin 2, ∑ a' : Fin 2,
              P.h Gd.j₀ Gd.x₀ a a' * (y - Gd.x₀) a * (y - Gd.x₀) a' := by
          simp [dotProduct, Matrix.mulVec, Fin.sum_univ_two]
          ring
        linarith
      have hva : ∀ a, |(y - Gd.x₀) a| ≤ dist y Gd.x₀ := by
        intro a
        rw [dist_eq_norm]
        have := PiLp.norm_apply_le (y - Gd.x₀) a
        rwa [Real.norm_eq_abs] at this
      have hQle : ∑ a : Fin 2, ∑ a' : Fin 2,
          P.h Gd.j₀ Gd.x₀ a a' * (y - Gd.x₀) a * (y - Gd.x₀) a' ≤ Mb * dist y Gd.x₀ ^ 2 := by
        rw [hMb, Finset.sum_mul]
        apply Finset.sum_le_sum
        intro a _
        rw [Finset.sum_mul]
        apply Finset.sum_le_sum
        intro a' _
        have h1 := hva a
        have h2 := hva a'
        calc P.h Gd.j₀ Gd.x₀ a a' * (y - Gd.x₀) a * (y - Gd.x₀) a'
            ≤ |P.h Gd.j₀ Gd.x₀ a a' * (y - Gd.x₀) a * (y - Gd.x₀) a'| := le_abs_self _
          _ = |P.h Gd.j₀ Gd.x₀ a a'| * |(y - Gd.x₀) a| * |(y - Gd.x₀) a'| := by
            rw [abs_mul, abs_mul]
          _ ≤ |P.h Gd.j₀ Gd.x₀ a a'| * dist y Gd.x₀ * dist y Gd.x₀ := by gcongr
          _ = |P.h Gd.j₀ Gd.x₀ a a'| * dist y Gd.x₀ ^ 2 := by ring
      have hQE : ∑ a : Fin 2, ∑ a' : Fin 2,
          P.h Gd.j₀ Gd.x₀ a a' * (y - Gd.x₀) a * (y - Gd.x₀) a' < E ^ 2 := by
        have h1 : dist y Gd.x₀ ^ 2 ≤ dist y Gd.x₀ := by nlinarith
        have h2 : dist y Gd.x₀ * (Mb + 1) < E ^ 2 := (lt_div_iff₀ (by linarith)).mp hdE
        have h3 : Mb * dist y Gd.x₀ ^ 2 ≤ Mb * dist y Gd.x₀ := mul_le_mul_of_nonneg_left h1 hMb0
        nlinarith
      have hrad : pcgbPoleRad P Gd.j₀ Gd.x₀ y < E := by
        unfold pcgbPoleRad
        rw [Real.sqrt_lt' hE0]
        exact hQE
      have hradpos : 0 < pcgbPoleRad P Gd.j₀ Gd.x₀ y := by
        unfold pcgbPoleRad
        exact Real.sqrt_pos.mpr hQpos
      have hlog : Real.log (pcgbPoleRad P Gd.j₀ Gd.x₀ y) < c - Gd.C := by
        rw [Real.log_lt_iff_lt_exp hradpos, ← hE]
        exact hrad
      have hpb := (Gd.pole y (Metric.mem_ball.mpr hdr) hyne).1
      have := (abs_le.mp hpb).2
      linarith
    have hballnhds : ∀ᶠ z in 𝓝 Gd.x₀, z ∈ Metric.ball Gd.x₀ δ := Metric.ball_mem_nhds _ hδ0
    have htr := htrans Gd.j₀ Gd.x₀ hx₀W _ hballnhds
    rw [Gd.param_x₀] at htr
    filter_upwards [htr] with q hq hqS hqne
    obtain ⟨z, hz, rfl, hzb⟩ := hq hqS
    have hzne : z ≠ Gd.x₀ := by
      intro h
      apply hqne
      rw [h, Gd.param_x₀]
    exact key z hzb hzne
  
  have hinterior : ∀ (c : ℝ), ∀ q ∈ S, 0 < b q → q ≠ Gd.p₀ →
      (∃ᶠ q' in 𝓝 q, q' ∈ S ∧
        ∀ᶠ q'' in 𝓝 q', q'' ∈ S → Gd.w q'' = c ∧ 0 < b q'' ∧ q'' ≠ Gd.p₀) →
      ∀ᶠ q' in 𝓝 q, q' ∈ S → Gd.w q' = c ∧ 0 < b q' ∧ q' ≠ Gd.p₀ := by
    intro c q hqS hbq hqp hfreq
    obtain ⟨i, y, hy, rfl⟩ := hC0 q hqS
    have hU : P.param i y ∈ Gd.U := Gd.R_sub ⟨hqS, hbq.le⟩
    have hcd := hsmoothAt i y hy hU hqp
    have hacc : ∃ᶠ z in 𝓝 y, ∀ᶠ z' in 𝓝 z, Gd.w (P.param i z') = c := by
      intro hnot
      have h1 := htrans i y hy _ hnot
      obtain ⟨q', ⟨hq'S, hq'good⟩, hq'z⟩ := (hfreq.and_eventually h1).exists
      obtain ⟨z, hz, rfl, hznot⟩ := hq'z hq'S
      apply hznot
      have h2 := hback i z hz _ hq'good
      filter_upwards [h2] with z' hz'
      exact (hz'.2 (hparamS i z' hz'.1).1).1
    have hflat : ∀ k : ℕ, 1 ≤ k →
        iteratedFDeriv ℝ k (fun z => Gd.w (P.param i z)) y = 0 := by
      intro k hk
      by_contra hne
      have hcont : ContinuousAt (iteratedFDeriv ℝ k (fun z => Gd.w (P.param i z))) y :=
        hcd.continuousAt_iteratedFDeriv (by exact_mod_cast le_top)
      have hev := hcont.eventually_ne hne
      obtain ⟨z, hzc, hzne⟩ := (hacc.and_eventually hev).exists
      apply hzne
      have heq : (fun z' => Gd.w (P.param i z')) =ᶠ[𝓝 z] (fun _ => c) := hzc
      rw [(heq.iteratedFDeriv ℝ k).eq_of_nhds, iteratedFDeriv_const_of_ne (by omega : k ≠ 0)]
      rfl
    have hloc := hsucp i y hy hbq hqp hflat
    have hval : Gd.w (P.param i y) = c := by
      obtain ⟨z, hzc, hzl⟩ := (hacc.and_eventually hloc).exists
      rw [← hzl]
      exact hzc.self_of_nhds
    exact hgood c i y hy hbq hqp (hloc.mono fun z hz => hz.trans hval)
  
  have hq₁S := (hparamS j x hx).1
  have hc0 : Gd.w (P.param j x) < 0 := Gd.neg _ hq₁S hbx hp
  have hloc₁ := hsucp j x hx hbx hp hcon
  obtain ⟨c, hcdef⟩ : ∃ c : ℝ, c = Gd.w (P.param j x) := ⟨_, rfl⟩
  rw [← hcdef] at hc0 hloc₁
  have hgood₁ := hgood c j x hx hbx hp hloc₁
  let Good : X → Prop := fun q =>
    ∀ᶠ q' in 𝓝 q, q' ∈ S → Gd.w q' = c ∧ 0 < b q' ∧ q' ≠ Gd.p₀
  have hu : IsOpen {q | Good q} := isOpen_setOf_eventually_nhds
  have hv : IsOpen {q | ∀ᶠ q' in 𝓝 q, q' ∈ S → ¬ Good q'} := isOpen_setOf_eventually_nhds
  have hdisj : {q | q ∈ S ∧ 0 ≤ b q} ∩
      ({q | Good q} ∩ {q | ∀ᶠ q' in 𝓝 q, q' ∈ S → ¬ Good q'}) = ∅ := by
    ext q
    constructor
    · rintro ⟨⟨hqS, _⟩, hqu, hqv⟩
      exact absurd hqu (hqv.self_of_nhds hqS)
    · intro h
      exact h.elim
  have hcover : {q | q ∈ S ∧ 0 ≤ b q} ⊆
      {q | Good q} ∪ {q | ∀ᶠ q' in 𝓝 q, q' ∈ S → ¬ Good q'} := by
    rintro q ⟨hqS, hbq⟩
    by_cases hqv : ∀ᶠ q' in 𝓝 q, q' ∈ S → ¬ Good q'
    · exact Or.inr hqv
    left
    have F : ∃ᶠ q' in 𝓝 q, q' ∈ S ∧ Good q' := by
      rw [Filter.not_eventually] at hqv
      exact hqv.mono fun q' h =>
        ⟨(_root_.not_imp.mp h).1, not_not.mp (_root_.not_imp.mp h).2⟩
    rcases eq_or_lt_of_le hbq with h0 | hpos
    · exfalso
      obtain ⟨q', ⟨hq'S, hq'g⟩, hlt⟩ := (F.and_eventually (hbdry c hc0 q hqS h0.symm)).exists
      have h1 := (hq'g.self_of_nhds hq'S).1
      have h2 := hlt hq'S
      linarith
    · by_cases hqp : q = Gd.p₀
      · exfalso
        rw [hqp] at F
        obtain ⟨q', ⟨hq'S, hq'g⟩, hlt⟩ := (F.and_eventually (hpole c)).exists
        obtain ⟨h1, _, h3⟩ := hq'g.self_of_nhds hq'S
        have h4 := hlt hq'S h3
        linarith
      · exact hinterior c q hqS hpos hqp F
  rcases isPreconnected_iff_subset_of_disjoint.mp hRconn.isPreconnected _ _ hu hv hcover hdisj
    with hRu | hRv
  · obtain ⟨qb, hqbS, hqb0⟩ := hbd
    have hg : Good qb := hRu ⟨hqbS, hqb0.ge⟩
    have h1 := (hg.self_of_nhds hqbS).2.1
    linarith
  · have hg : ∀ᶠ q' in 𝓝 (P.param j x), q' ∈ S → ¬ Good q' := hRv ⟨hq₁S, hbx.le⟩
    exact hg.self_of_nhds hq₁S hgood₁

theorem e2_submersion_zero_null (W : Set E2) (hW : IsOpen W) (f : E2 → ℝ)
    (hf : ContDiffOn ℝ ∞ f W) (hdf : ∀ z ∈ W, fderiv ℝ f z ≠ 0) :
    MeasureTheory.volume (W ∩ f ⁻¹' {0}) = 0 :=
by
  classical
  set v0 : E2 := EuclideanSpace.single (0 : Fin 2) (1 : ℝ) with hv0
  set v1 : E2 := EuclideanSpace.single (1 : Fin 2) (1 : ℝ) with hv1
  have h1n : (1 : WithTop ℕ∞) ≤ ∞ := by simp
  have hfd : ∀ z ∈ W, HasFDerivAt f (fderiv ℝ f z) z := fun z hz =>
    ((hf.differentiableOn (by simp)).differentiableAt (hW.mem_nhds hz)).hasFDerivAt
  have hDc : ContinuousOn (fderiv ℝ f) W := hf.continuousOn_fderiv_of_isOpen hW h1n
  
  have hZm : ∀ v : E2, MeasurableSet {z | z ∈ W ∧ f z = 0 ∧ fderiv ℝ f z v ≠ 0} := by
    intro v
    have hc : ContinuousOn (fun z => fderiv ℝ f z v) W := hDc.clm_apply continuousOn_const
    have hA : IsOpen (W ∩ (fun z => fderiv ℝ f z v) ⁻¹' {0}ᶜ) :=
      hc.isOpen_inter_preimage hW isOpen_compl_singleton
    have hB : IsOpen ((W ∩ (fun z => fderiv ℝ f z v) ⁻¹' {0}ᶜ) ∩ f ⁻¹' {0}ᶜ) :=
      (hf.continuousOn.mono Set.inter_subset_left).isOpen_inter_preimage hA
        isOpen_compl_singleton
    have hEq : {z | z ∈ W ∧ f z = 0 ∧ fderiv ℝ f z v ≠ 0} =
        (W ∩ (fun z => fderiv ℝ f z v) ⁻¹' {0}ᶜ) \
          ((W ∩ (fun z => fderiv ℝ f z v) ⁻¹' {0}ᶜ) ∩ f ⁻¹' {0}ᶜ) := by
      ext z
      simp only [Set.mem_setOf_eq, Set.mem_diff, Set.mem_inter_iff, Set.mem_preimage,
        Set.mem_compl_iff, Set.mem_singleton_iff]
      tauto
    rw [hEq]
    exact hA.measurableSet.diff hB.measurableSet
  
  have hslice : ∀ v p : E2,
      volume {t : ℝ | p + t • v ∈ {z | z ∈ W ∧ f z = 0 ∧ fderiv ℝ f z v ≠ 0}} = 0 := by
    intro v p
    apply measure_null_of_locally_null
    intro b hb
    simp only [Set.mem_setOf_eq] at hb
    obtain ⟨hbW, hb0, hbd⟩ := hb
    have hℓ : HasDerivAt (fun t : ℝ => p + t • v) v b := by
      simpa using ((hasDerivAt_id b).smul_const v).const_add p
    have hg : HasDerivAt (fun t : ℝ => f (p + t • v)) (fderiv ℝ f (p + b • v) v) b :=
      (hfd _ hbW).comp_hasDerivAt b hℓ
    have hev : ∀ᶠ z in 𝓝[≠] b, f (p + z • v) ≠ 0 := hg.eventually_ne hbd
    rw [eventually_nhdsWithin_iff] at hev
    refine ⟨_, inter_mem_nhdsWithin _ hev, ?_⟩
    apply measure_mono_null _ (Real.volume_singleton (a := b))
    rintro t ⟨ht, htV⟩
    simp only [Set.mem_setOf_eq] at ht
    by_contra hne
    exact htV hne ht.2.1
  
  have hτ : MeasurePreserving (fun q : ℝ × ℝ => q.1 • v0 + q.2 • v1) volume volume := by
    have h1 := (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 2)).trans
      (volume_preserving_finTwoArrow ℝ)
    have h2 := MeasurePreserving.symm
      ((MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.trans MeasurableEquiv.finTwoArrow) h1
    convert h2 using 1
    funext q
    ext j
    fin_cases j <;> simp [v0, v1] <;> rfl
  have hZ1 : volume {z | z ∈ W ∧ f z = 0 ∧ fderiv ℝ f z v1 ≠ 0} = 0 := by
    rw [← hτ.measure_preimage (hZm v1).nullMeasurableSet, Measure.volume_eq_prod,
      Measure.prod_apply ((hZm v1).preimage hτ.measurable)]
    refine (lintegral_congr (fun a => ?_)).trans lintegral_zero
    exact hslice v1 (a • v0)
  have hZ0 : volume {z | z ∈ W ∧ f z = 0 ∧ fderiv ℝ f z v0 ≠ 0} = 0 := by
    rw [← hτ.measure_preimage (hZm v0).nullMeasurableSet, Measure.volume_eq_prod,
      Measure.prod_apply_symm ((hZm v0).preimage hτ.measurable)]
    refine (lintegral_congr (fun b => ?_)).trans lintegral_zero
    have hs : (fun a : ℝ => (a, b)) ⁻¹'
        ((fun q : ℝ × ℝ => q.1 • v0 + q.2 • v1) ⁻¹'
          {z | z ∈ W ∧ f z = 0 ∧ fderiv ℝ f z v0 ≠ 0}) =
        {t : ℝ | b • v1 + t • v0 ∈ {z | z ∈ W ∧ f z = 0 ∧ fderiv ℝ f z v0 ≠ 0}} := by
      ext t
      simp only [Set.mem_preimage, Set.mem_setOf_eq]
      rw [add_comm]
    rw [hs]
    exact hslice v0 (b • v1)
  have hcover : W ∩ f ⁻¹' {0} ⊆ {z | z ∈ W ∧ f z = 0 ∧ fderiv ℝ f z v0 ≠ 0} ∪
      {z | z ∈ W ∧ f z = 0 ∧ fderiv ℝ f z v1 ≠ 0} := by
    rintro z ⟨hzW, hz0⟩
    have hz0' : f z = 0 := hz0
    by_cases h0 : fderiv ℝ f z v0 = 0
    · by_cases h1 : fderiv ℝ f z v1 = 0
      · exfalso
        apply hdf z hzW
        ext w
        have hw : w = w 0 • v0 + w 1 • v1 := by
          ext j
          fin_cases j <;> simp [v0, v1]
        calc fderiv ℝ f z w = fderiv ℝ f z (w 0 • v0 + w 1 • v1) := by
              conv_lhs => rw [hw]
          _ = 0 := by simp [h0, h1]
          _ = (0 : E2 →L[ℝ] ℝ) w := rfl
      · exact Or.inr ⟨hzW, hz0', h1⟩
    · exact Or.inl ⟨hzW, hz0', h0⟩
  exact measure_mono_null hcover (measure_union_null hZ0 hZ1)

theorem pcgb_defect_small {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρnn : ∀ j q, 0 ≤ ρ j q)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (hρO : ∀ j q, q ∉ P.O j → ρ j q = 0)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (hRc : IsCompact {q | q ∈ S ∧ 0 ≤ b q})
    (hRconn : IsConnected {q | q ∈ S ∧ 0 ≤ b q})
    (hρ1 : ∀ q, q ∈ S → 0 ≤ b q → ∑ j, ρ j q = 1)
    (hreg : ∀ j, ∀ x ∈ P.W j, b (P.param j x) = 0 →
      fderiv ℝ (fun y => b (P.param j y)) x ≠ 0)
    (hbd : ∃ q ∈ S, b q = 0) (Gd : PcgbGreenData P b) :
    ∀ θ : ℝ, 0 < θ → ∃ ε₀ : ℝ, 0 < ε₀ ∧ ∀ ε : ℝ, 0 < ε → ε < ε₀ → ∀ s : ℝ, 0 < s →
      pcgbDefect P ρ b Gd.w ε s ≤ θ :=
by
  intro θ hθ
  have hθ' : 0 < θ / ((P.n : ℝ) + 1) := div_pos hθ (by positivity)
  
  have hV : ∀ j : Fin P.n, ∃ V : Set E2, IsOpen V ∧ V ⊆ P.W j ∧
      (∀ x ∈ P.W j, 0 < b (P.param j x) → P.param j x ≠ Gd.p₀ → x ∈ V) ∧
      ContDiffOn ℝ ∞ (fun y => Gd.w (P.param j y)) V ∧
      (∀ y ∈ V, lap2 (P.h j) (fun y => Gd.w (P.param j y)) y = 0) := by
    intro j
    refine ⟨(P.W j ∩ P.param j ⁻¹' (Gd.U \ {Gd.p₀})) ∩
      (P.W j ∩ (fun x => b (P.param j x)) ⁻¹' Set.Ioi 0), ?_, ?_, ?_, ?_, ?_⟩
    · exact ((P.param_cont j).isOpen_inter_preimage (P.W_open j)
        (Gd.U_open.sdiff isClosed_singleton)).inter
        ((hb j).continuousOn.isOpen_inter_preimage (P.W_open j) isOpen_Ioi)
    · exact fun y hy => hy.1.1
    · intro x hx hb0 hp
      have hS : P.param j x ∈ P.param j '' P.W j := ⟨x, hx, rfl⟩
      rw [P.image_eq j] at hS
      have hU : P.param j x ∈ Gd.U := Gd.R_sub ⟨hS.2, le_of_lt hb0⟩
      exact ⟨⟨hx, hU, hp⟩, hx, hb0⟩
    · exact (Gd.smooth j).mono (fun y hy => hy.1)
    · intro y hy
      have h1 : (0 : ℝ) < b (P.param j y) := hy.2.2
      have h2 : P.param j y ≠ Gd.p₀ := hy.1.2.2
      exact Gd.harm j y hy.1.1 (le_of_lt h1) h2
  
  have hsucp : ∀ j, ∀ x ∈ P.W j, 0 < b (P.param j x) → P.param j x ≠ Gd.p₀ →
      (∀ k : ℕ, 1 ≤ k → iteratedFDeriv ℝ k (fun y => Gd.w (P.param j y)) x = 0) →
      ∀ᶠ y in 𝓝 x, Gd.w (P.param j y) = Gd.w (P.param j x) := by
    intro j x hx hb0 hp hflat
    obtain ⟨V, hVo, hVW, hVmem, hVs, hVh⟩ := hV j
    exact lap2_flat_point_locally_const V hVo (P.h j) (fun a c => (P.h_smooth j a c).mono hVW)
      (fun y hy => P.h_posDef j y (hVW hy)) _ hVs hVh x (hVmem x hx hb0 hp) hflat
  
  have hchart : ∀ j : Fin P.n, ∀ᶠ ε in 𝓝[>] (0 : ℝ), ∀ s : ℝ, 0 < s →
      ∫ x in P.W j, ρ j (P.param j x) * (Real.smoothTransition (b (P.param j x) / s) *
        gaussCurv2 (P.h j) x * (ε / (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x + ε))) *
        Real.sqrt (P.h j x).det ≤ θ / ((P.n : ℝ) + 1) := by
    intro j
    have hW : IsOpen (P.W j) := P.W_open j
    have hB : IsOpen (P.W j ∩ (fun x => b (P.param j x)) ⁻¹' Set.Ioi 0) :=
      (hb j).continuousOn.isOpen_inter_preimage hW isOpen_Ioi
    have hmat : ContinuousOn (P.h j) (P.W j) :=
      continuousOn_pi.2 fun a => continuousOn_pi.2 fun c => (P.h_smooth j a c).continuousOn
    have hdetc : ContinuousOn (fun x => (P.h j x).det) (P.W j) :=
      (continuous_id.matrix_det).comp_continuousOn hmat
    have hA : ContinuousOn (fun x => ρ j (P.param j x) * gaussCurv2 (P.h j) x *
        Real.sqrt (P.h j x).det) (P.W j) :=
      ((hρs j j).continuousOn.mul (gaussCurv2_continuousOn (P.h j) (P.W j) hW (P.h_smooth j)
        (P.h_posDef j))).mul hdetc.sqrt
    have hAK : ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) * gaussCurv2 (P.h j) x *
        Real.sqrt (P.h j x).det = 0 := by
      intro x hx hxK
      rw [hρK j x hx hxK]
      ring
    have hinvc : ContinuousOn (fun x => (P.h j x)⁻¹) (P.W j) := by
      refine ContinuousOn.congr ((hdetc.inv₀ fun x hx => (P.h_posDef j x hx).det_pos.ne').smul
        ((continuous_id.matrix_adjugate).comp_continuousOn hmat)) ?_
      intro x _
      show (P.h j x)⁻¹ = (P.h j x).det⁻¹ • (P.h j x).adjugate
      rw [Matrix.inv_def, Ring.inverse_eq_inv']
    have hGm : AEStronglyMeasurable (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)))
        (volume.restrict (P.W j)) := by
      have h1 : ∀ a c : Fin 2, AEStronglyMeasurable (fun x => (P.h j x)⁻¹ a c)
          (volume.restrict (P.W j)) := fun a c =>
        (continuousOn_pi.1 (continuousOn_pi.1 hinvc a) c).aestronglyMeasurable hW.measurableSet
      have h2 : ∀ a : Fin 2, AEStronglyMeasurable (pd2 a (fun y => Gd.w (P.param j y)))
          (volume.restrict (P.W j)) := fun a =>
        (measurable_fderiv_apply_const ℝ (fun y => Gd.w (P.param j y)) (e2 a)).aestronglyMeasurable
      unfold sgbGradSq2
      exact Finset.aestronglyMeasurable_fun_sum _ fun a _ =>
        Finset.aestronglyMeasurable_fun_sum _ fun c _ => ((h1 a c).mul (h2 a)).mul (h2 c)
    have hGnn : ∀ x ∈ P.W j, 0 ≤ sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x :=
      fun x hx => ((posDef_inv_quad_facts (P.h j x) (P.h_posDef j x hx)).1
        (fun a => pd2 a (fun y => Gd.w (P.param j y)) x)).1
    have hnull : volume {x | x ∈ P.W j ∧ x ∈ P.W j ∩ (fun x => b (P.param j x)) ⁻¹' Set.Ioi 0 ∧
        ρ j (P.param j x) * gaussCurv2 (P.h j) x * Real.sqrt (P.h j x).det ≠ 0 ∧
        sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x = 0} = 0 := by
      obtain ⟨V, hVo, hVW, hVmem, hVs, hVh⟩ := hV j
      have hpole : volume {x | x ∈ P.W j ∧ P.param j x = Gd.p₀} = 0 := by
        apply Set.Subsingleton.measure_zero
        intro x hx y hy
        rw [← P.proj_param j x hx.1, ← P.proj_param j y hy.1, hx.2, hy.2]
      have hZ : volume {x | x ∈ V ∧ fderiv ℝ (fun y => Gd.w (P.param j y)) x = 0 ∧
          ∃ k : ℕ, 1 ≤ k ∧ iteratedFDeriv ℝ k (fun y => Gd.w (P.param j y)) x ≠ 0} = 0 :=
        e2_crit_nonflat_null (fun W f hW hf hdf => e2_submersion_zero_null W hW f hf hdf)
          V hVo _ hVs
      refine measure_mono_null ?_ (measure_union_null hpole hZ)
      rintro x ⟨hxW, ⟨-, hbx⟩, -, hGx⟩
      by_cases hp : P.param j x = Gd.p₀
      · exact Or.inl ⟨hxW, hp⟩
      · have hbx' : (0 : ℝ) < b (P.param j x) := hbx
        have hξ := ((posDef_inv_quad_facts (P.h j x) (P.h_posDef j x hxW)).1
          (fun a => pd2 a (fun y => Gd.w (P.param j y)) x)).2 hGx
        have h0 : fderiv ℝ (fun y => Gd.w (P.param j y)) x (e2 0) = 0 := congrFun hξ 0
        have h1 : fderiv ℝ (fun y => Gd.w (P.param j y)) x (e2 1) = 0 := congrFun hξ 1
        have hD : fderiv ℝ (fun y => Gd.w (P.param j y)) x = 0 := by
          refine ContinuousLinearMap.ext fun v => ?_
          have hv : v = v 0 • e2 0 + v 1 • e2 1 := by
            ext i
            fin_cases i <;> simp
          rw [ContinuousLinearMap.zero_apply, hv, map_add, map_smul, map_smul, h0, h1]
          simp
        exact Or.inr ⟨hVmem x hxW hbx' hp, hD,
          pcgb_no_flat_point S P b hb hRconn hbd Gd hsucp j x hxW hbx' hp⟩
    obtain ⟨ε₀, hε₀, hdct⟩ := e2_eps_weight_dct (P.W j) (Kc j)
      (P.W j ∩ (fun x => b (P.param j x)) ⁻¹' Set.Ioi 0) hW (hK j).1 (hK j).2 hB
      (fun x => ρ j (P.param j x) * gaussCurv2 (P.h j) x * Real.sqrt (P.h j x).det)
      (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y))) hA hAK hGm hGnn hnull
      (θ / ((P.n : ℝ) + 1)) hθ'
    filter_upwards [Ioo_mem_nhdsGT hε₀] with ε hε s hs
    have hε0 : 0 < ε := hε.1
    refine hdct ε hε.1 hε.2 (fun x => ρ j (P.param j x) *
      (Real.smoothTransition (b (P.param j x) / s) * gaussCurv2 (P.h j) x *
        (ε / (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x + ε))) *
      Real.sqrt (P.h j x).det) ?_
    intro x hx
    have hGx := hGnn x hx
    have hq : 0 ≤ ε / (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x + ε) :=
      div_nonneg hε0.le (by linarith)
    have hind_nn : 0 ≤ (P.W j ∩ (fun x => b (P.param j x)) ⁻¹' Set.Ioi 0).indicator
        (fun y => |ρ j (P.param j y) * gaussCurv2 (P.h j) y * Real.sqrt (P.h j y).det| *
          (ε / (sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) y + ε))) x := by
      apply Set.indicator_nonneg
      intro y hy
      exact mul_nonneg (abs_nonneg _) (div_nonneg hε0.le (by linarith [hGnn y hy.1]))
    by_cases hbx : 0 < b (P.param j x)
    · have hmem : x ∈ P.W j ∩ (fun x => b (P.param j x)) ⁻¹' Set.Ioi 0 := ⟨hx, hbx⟩
      have hη0 := Real.smoothTransition.nonneg (b (P.param j x) / s)
      have hη1 := Real.smoothTransition.le_one (b (P.param j x) / s)
      have heq : ρ j (P.param j x) * (Real.smoothTransition (b (P.param j x) / s) *
          gaussCurv2 (P.h j) x * (ε / (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x + ε))) *
          Real.sqrt (P.h j x).det = Real.smoothTransition (b (P.param j x) / s) *
          ((ρ j (P.param j x) * gaussCurv2 (P.h j) x * Real.sqrt (P.h j x).det) *
            (ε / (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x + ε))) := by ring
      have hbound : |ρ j (P.param j x) * (Real.smoothTransition (b (P.param j x) / s) *
          gaussCurv2 (P.h j) x * (ε / (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x + ε))) *
          Real.sqrt (P.h j x).det| ≤
          |ρ j (P.param j x) * gaussCurv2 (P.h j) x * Real.sqrt (P.h j x).det| *
            (ε / (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x + ε)) := by
        rw [heq, abs_mul, abs_of_nonneg hη0, abs_mul, abs_of_nonneg hq]
        exact mul_le_of_le_one_left (mul_nonneg (abs_nonneg _) hq) hη1
      rw [Set.indicator_of_mem hmem]
      exact hbound
    · have hη : Real.smoothTransition (b (P.param j x) / s) = 0 :=
        Real.smoothTransition.zero_of_nonpos
          (div_nonpos_of_nonpos_of_nonneg (not_lt.1 hbx) hs.le)
      have hzero : |ρ j (P.param j x) * (Real.smoothTransition (b (P.param j x) / s) *
          gaussCurv2 (P.h j) x * (ε / (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x + ε))) *
          Real.sqrt (P.h j x).det| = 0 := by
        rw [hη]
        simp
      exact (le_of_eq hzero).trans hind_nn
  
  have hall := Filter.eventually_all.2 hchart
  obtain ⟨u, hu, hsub⟩ := mem_nhdsGT_iff_exists_Ioo_subset.1 hall
  refine ⟨u, hu, fun ε hε hεu s hs => ?_⟩
  have hj := hsub ⟨hε, hεu⟩
  simp only [Set.mem_setOf_eq] at hj
  have hdef : pcgbDefect P ρ b Gd.w ε s = ∑ j : Fin P.n, ∫ x in P.W j,
      ρ j (P.param j x) * (Real.smoothTransition (b (P.param j x) / s) *
        gaussCurv2 (P.h j) x * (ε / (sgbGradSq2 (P.h j) (fun y => Gd.w (P.param j y)) x + ε))) *
        Real.sqrt (P.h j x).det := rfl
  rw [hdef]
  calc _ ≤ ∑ _j : Fin P.n, θ / ((P.n : ℝ) + 1) := Finset.sum_le_sum fun j _ => hj j s hs
    _ = (P.n : ℝ) * (θ / ((P.n : ℝ) + 1)) := by simp
    _ ≤ θ := by
      rw [mul_div_assoc', div_le_iff₀ (by positivity)]
      nlinarith

theorem pcgb_levelset_second_order (W : Set E2) (hW : IsOpen W) (b w : E2 → ℝ)
    (hb : ContDiffOn ℝ ∞ b W) (hw : ContDiffOn ℝ ∞ w W) (x : E2) (hx : x ∈ W)
    (hbx : b x = 0) (hdb : fderiv ℝ b x ≠ 0) (hvan : ∀ y ∈ W, b y = 0 → w y = 0) :
    ∃ lam : ℝ, (∀ a : Fin 2, pd2 a w x = lam * pd2 a b x) ∧
      ∀ τ : Fin 2 → ℝ, τ 0 * pd2 0 b x + τ 1 * pd2 1 b x = 0 →
        ∑ i : Fin 2, ∑ j : Fin 2, τ i * τ j * pd2 i (pd2 j w) x =
          lam * ∑ i : Fin 2, ∑ j : Fin 2, τ i * τ j * pd2 i (pd2 j b) x :=
by
  classical
  have hinf0 : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  have h2inf : (2 : WithTop ℕ∞) ≤ ∞ := WithTop.coe_le_coe.mpr le_top
  have h11inf : (1 : WithTop ℕ∞) + 1 ≤ ∞ := WithTop.coe_le_coe.mpr le_top
  have hWn : W ∈ 𝓝 x := hW.mem_nhds hx
  have hbA : ContDiffAt ℝ ∞ b x := hb.contDiffAt hWn
  have hwA : ContDiffAt ℝ ∞ w x := hw.contDiffAt hWn
  
  have hdd : ∀ g : E2 → ℝ, ContDiffAt ℝ ∞ g x → DifferentiableAt ℝ (fderiv ℝ g) x :=
    fun g hg => (hg.fderiv_right (m := 1) h11inf).differentiableAt one_ne_zero
  
  have hbS : HasStrictFDerivAt b (fderiv ℝ b x) x :=
    hbA.hasStrictFDerivAt' (hbA.differentiableAt hinf0).hasFDerivAt hinf0
  have hwS : HasStrictFDerivAt w (fderiv ℝ w x) x :=
    hwA.hasStrictFDerivAt' (hwA.differentiableAt hinf0).hasFDerivAt hinf0
  have hmin : IsMinFilter w (𝓝[{y | b y = b x}] x) x := by
    show ∀ᶠ y in 𝓝[{y | b y = b x}] x, w x ≤ w y
    filter_upwards [mem_nhdsWithin_of_mem_nhds hWn, self_mem_nhdsWithin] with y hyW hyb
    have hy0 : b y = 0 := by simpa [hbx] using hyb
    rw [hvan x hx hbx, hvan y hyW hy0]
  have hext : IsLocalExtrOn w {y | b y = b x} x := Or.inl hmin
  obtain ⟨α, β, hαβ, hrel⟩ := hext.exists_multipliers_of_hasStrictFDerivAt_1d hbS hwS
  have hβ : β ≠ 0 := by
    rintro rfl
    have hα : α ≠ 0 := by
      intro h
      apply hαβ
      simp [h]
    simp only [zero_smul, add_zero] at hrel
    exact hdb ((smul_eq_zero.mp hrel).resolve_left hα)
  have hDw : ∀ u : E2, fderiv ℝ w x u = (-α / β) * fderiv ℝ b x u := by
    intro u
    have h := congrArg (fun f : E2 →L[ℝ] ℝ => f u) hrel
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul,
      ContinuousLinearMap.zero_apply] at h
    rw [div_mul_eq_mul_div, eq_div_iff hβ]
    linear_combination h
  
  have hexp : ∀ g : E2 → ℝ, DifferentiableAt ℝ (fderiv ℝ g) x → ∀ i j : Fin 2,
      pd2 i (pd2 j g) x = fderiv ℝ (fderiv ℝ g) x (e2 i) (e2 j) := by
    intro g hg i j
    have h1 : HasFDerivAt (fun y => fderiv ℝ g y (e2 j))
        ((fderiv ℝ g x).comp (0 : E2 →L[ℝ] E2) + (fderiv ℝ (fderiv ℝ g) x).flip (e2 j)) x :=
      hg.hasFDerivAt.clm_apply (hasFDerivAt_const (e2 j) x)
    show fderiv ℝ (fun y => fderiv ℝ g y (e2 j)) x (e2 i) = _
    rw [h1.fderiv]
    simp
  have hquad : ∀ g : E2 → ℝ, DifferentiableAt ℝ (fderiv ℝ g) x → ∀ τ : Fin 2 → ℝ,
      ∑ i : Fin 2, ∑ j : Fin 2, τ i * τ j * pd2 i (pd2 j g) x =
        fderiv ℝ (fderiv ℝ g) x (τ 0 • e2 0 + τ 1 • e2 1) (τ 0 • e2 0 + τ 1 • e2 1) := by
    intro g hg τ
    simp only [Fin.sum_univ_two, hexp g hg, map_add, map_smul, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  
  have hsecond : ∀ g : E2 → ℝ, ContDiffOn ℝ ∞ g W → ∀ γ : ℝ → E2, ContDiffAt ℝ ∞ γ 0 →
      γ 0 = x → (∀ᶠ t in 𝓝 (0 : ℝ), γ t ∈ W ∧ g (γ t) = 0) →
      fderiv ℝ (fderiv ℝ g) x (deriv γ 0) (deriv γ 0) + fderiv ℝ g x (deriv (deriv γ) 0) = 0 := by
    intro g hg γ hγ hγ0 hev
    have hgd : ∀ y ∈ W, DifferentiableAt ℝ g y :=
      fun y hy => (hg.contDiffAt (hW.mem_nhds hy)).differentiableAt hinf0
    have hγ2 : ContDiffAt ℝ 2 γ 0 := hγ.of_le h2inf
    have hγev : ∀ᶠ t in 𝓝 (0 : ℝ), DifferentiableAt ℝ γ t :=
      (hγ2.eventually (by simp)).mono fun t ht => ht.differentiableAt (by simp)
    have hγd0 : DifferentiableAt ℝ γ 0 := hγ.differentiableAt hinf0
    have hγdd : DifferentiableAt ℝ (deriv γ) 0 := by
      have h1 : DifferentiableAt ℝ (fderiv ℝ γ) 0 :=
        (hγ.fderiv_right (m := 1) h11inf).differentiableAt one_ne_zero
      exact h1.clm_apply (differentiableAt_const (1 : ℝ))
    have hcomp : (fun t => g (γ t)) =ᶠ[𝓝 (0 : ℝ)] fun _ => (0 : ℝ) := hev.mono fun t ht => ht.2
    have hk0 : (fun y => ((fderiv ℝ g ∘ γ) y) (deriv γ y)) =ᶠ[𝓝 (0 : ℝ)] fun _ => (0 : ℝ) := by
      filter_upwards [hcomp.deriv, hev, hγev] with t h1t ht hγt
      have hD := (hgd _ ht.1).hasFDerivAt.comp_hasDerivAt t hγt.hasDerivAt
      rw [deriv_const] at h1t
      exact hD.deriv.symm.trans h1t
    have hc : HasDerivAt (fderiv ℝ g ∘ γ) (fderiv ℝ (fderiv ℝ g) x (deriv γ 0)) 0 :=
      (hdd g (hg.contDiffAt (hγ0 ▸ hWn))).hasFDerivAt.comp_hasDerivAt_of_eq 0
        hγd0.hasDerivAt hγ0.symm
    have hk := hc.clm_apply hγdd.hasDerivAt
    have e := hk.unique ((hasDerivAt_const (0 : ℝ) (0 : ℝ)).congr_of_eventuallyEq hk0)
    simpa [Function.comp, hγ0] using e
  
  have hcurve : ∀ v : E2, v ≠ 0 → fderiv ℝ b x v = 0 → ∃ γ : ℝ → E2, ContDiffAt ℝ ∞ γ 0 ∧
      γ 0 = x ∧ HasDerivAt γ v 0 ∧ ∀ᶠ t in 𝓝 (0 : ℝ), γ t ∈ W ∧ b (γ t) = 0 := by
    intro v hv0 hDbv
    have hu_exp : ∀ u : E2, u = u 0 • e2 0 + u 1 • e2 1 := by
      intro u; ext i; fin_cases i <;> simp
    have hinner : ∀ u : E2, innerSL ℝ v u = v 0 * u 0 + v 1 * u 1 := by
      intro u
      simp [PiLp.inner_apply, Fin.sum_univ_two] <;> ring
    have hDb : ∀ u : E2, fderiv ℝ b x u = u 0 * fderiv ℝ b x (e2 0) + u 1 * fderiv ℝ b x (e2 1) := by
      intro u
      conv_lhs => rw [hu_exp u]
      simp only [map_add, map_smul, smul_eq_mul]
    have hβne : fderiv ℝ b x (e2 0) ≠ 0 ∨ fderiv ℝ b x (e2 1) ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      apply hdb
      refine ContinuousLinearMap.ext fun u => ?_
      rw [hDb u, hcon.1, hcon.2]
      simp
    have hvne : v 0 ≠ 0 ∨ v 1 ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      apply hv0
      rw [hu_exp v, hcon.1, hcon.2]
      simp
    have hpos : 0 < v 0 ^ 2 + v 1 ^ 2 := by
      rcases hvne with h | h
      · have := lt_of_le_of_ne (sq_nonneg (v 0)) (Ne.symm (pow_ne_zero 2 h))
        nlinarith [sq_nonneg (v 1)]
      · have := lt_of_le_of_ne (sq_nonneg (v 1)) (Ne.symm (pow_ne_zero 2 h))
        nlinarith [sq_nonneg (v 0)]
    let L : E2 →L[ℝ] ℝ × ℝ := (fderiv ℝ b x).prod (innerSL ℝ v)
    have hLapp : ∀ u : E2, L u = (fderiv ℝ b x u, innerSL ℝ v u) := fun u => rfl
    have hLinj : Function.Injective L := by
      rw [injective_iff_map_eq_zero]
      intro u hu
      rw [hLapp] at hu
      have h1 : fderiv ℝ b x u = 0 := congrArg Prod.fst hu
      have h2 : innerSL ℝ v u = 0 := congrArg Prod.snd hu
      rw [hDb] at h1
      rw [hinner] at h2
      have e2' := hDbv
      rw [hDb] at e2'
      have hD : u 0 * v 1 - u 1 * v 0 = 0 := by
        rcases hβne with h | h
        · have : fderiv ℝ b x (e2 0) * (u 0 * v 1 - u 1 * v 0) = 0 := by
            linear_combination (v 1) * h1 - (u 1) * e2'
          exact (mul_eq_zero.mp this).resolve_left h
        · have : fderiv ℝ b x (e2 1) * (u 0 * v 1 - u 1 * v 0) = 0 := by
            linear_combination (u 0) * e2' - (v 0) * h1
          exact (mul_eq_zero.mp this).resolve_left h
      have hu0 : u 0 = 0 := by
        have : u 0 * (v 0 ^ 2 + v 1 ^ 2) = 0 := by linear_combination (v 0) * h2 + (v 1) * hD
        exact (mul_eq_zero.mp this).resolve_right (ne_of_gt hpos)
      have hu1 : u 1 = 0 := by
        have : u 1 * (v 0 ^ 2 + v 1 ^ 2) = 0 := by linear_combination (v 1) * h2 - (v 0) * hD
        exact (mul_eq_zero.mp this).resolve_right (ne_of_gt hpos)
      rw [hu_exp u, hu0, hu1]
      simp
    have hfin : Module.finrank ℝ E2 = Module.finrank ℝ (ℝ × ℝ) := by
      rw [finrank_euclideanSpace_fin]; simp
    have hLsurj : Function.Surjective L :=
      (LinearMap.injective_iff_surjective_of_finrank_eq_finrank hfin (f := (L : E2 →ₗ[ℝ] ℝ × ℝ))).mp
        hLinj
    let L' : E2 ≃L[ℝ] ℝ × ℝ := ContinuousLinearEquiv.ofBijective L
      (LinearMap.ker_eq_bot.mpr hLinj) (LinearMap.range_eq_top.mpr hLsurj)
    have hL'coe : (L' : E2 →L[ℝ] ℝ × ℝ) = L := ContinuousLinearEquiv.coe_ofBijective _ _ _
    obtain ⟨Φ, hΦdef⟩ : ∃ Φ : E2 → ℝ × ℝ, Φ = fun y => (b y, innerSL ℝ v y) := ⟨_, rfl⟩
    have hΦL : HasFDerivAt Φ L x := by
      rw [hΦdef]
      exact (hbA.differentiableAt hinf0).hasFDerivAt.prodMk (innerSL ℝ v).hasFDerivAt
    have hΦL' : HasFDerivAt Φ (L' : E2 →L[ℝ] ℝ × ℝ) x := by rw [hL'coe]; exact hΦL
    have hΦc : ContDiffAt ℝ ∞ Φ x := by
      rw [hΦdef]
      exact hbA.prodMk (innerSL ℝ v).contDiff.contDiffAt
    have hS : HasStrictFDerivAt Φ (L' : E2 →L[ℝ] ℝ × ℝ) x := hΦc.hasStrictFDerivAt' hΦL' hinf0
    obtain ⟨Ψ, hΨc, hΨx, hright, hΨd⟩ : ∃ Ψ : ℝ × ℝ → E2, ContDiffAt ℝ ∞ Ψ (Φ x) ∧
        Ψ (Φ x) = x ∧ (∀ᶠ z in 𝓝 (Φ x), Φ (Ψ z) = z) ∧
        HasFDerivAt Ψ (L'.symm : ℝ × ℝ →L[ℝ] E2) (Φ x) :=
      ⟨_, hΦc.to_localInverse hΦL' hinf0, hΦc.localInverse_apply_image hΦL' hinf0,
        hS.eventually_right_inverse, hS.to_localInverse.hasFDerivAt⟩
    have hLv : L' v = ((0 : ℝ), innerSL ℝ v v) := by
      rw [← ContinuousLinearEquiv.coe_coe, hL'coe, hLapp, hDbv]
    have hℓ : HasDerivAt (fun t : ℝ => Φ x + t • ((0 : ℝ), innerSL ℝ v v))
        ((0 : ℝ), innerSL ℝ v v) 0 := by
      have := ((hasDerivAt_id (0 : ℝ)).smul_const ((0 : ℝ), innerSL ℝ v v)).const_add (Φ x)
      simpa using this
    have hℓc : ContDiffAt ℝ ∞ (fun t : ℝ => Φ x + t • ((0 : ℝ), innerSL ℝ v v)) 0 :=
      (contDiff_const.add (contDiff_id.smul contDiff_const)).contDiffAt
    have hℓ0 : (fun t : ℝ => Φ x + t • ((0 : ℝ), innerSL ℝ v v)) 0 = Φ x := by simp
    refine ⟨fun t => Ψ (Φ x + t • ((0 : ℝ), innerSL ℝ v v)), ?_, ?_, ?_, ?_⟩
    · have h1 : ContDiffAt ℝ ∞ Ψ ((fun t : ℝ => Φ x + t • ((0 : ℝ), innerSL ℝ v v)) 0) := by
        rw [hℓ0]; exact hΨc
      exact h1.comp (0 : ℝ) hℓc
    · simp [hΨx]
    · have h1 := hΨd.comp_hasDerivAt_of_eq (0 : ℝ) hℓ hℓ0.symm
      have h2 : (L'.symm : ℝ × ℝ →L[ℝ] E2) ((0 : ℝ), innerSL ℝ v v) = v := by
        rw [ContinuousLinearEquiv.coe_coe, ContinuousLinearEquiv.symm_apply_eq, hLv]
      rw [h2] at h1
      exact h1
    · have hγc : ContinuousAt (fun t : ℝ => Ψ (Φ x + t • ((0 : ℝ), innerSL ℝ v v))) 0 := by
        have h1 : ContDiffAt ℝ ∞ Ψ ((fun t : ℝ => Φ x + t • ((0 : ℝ), innerSL ℝ v v)) 0) := by
          rw [hℓ0]; exact hΨc
        exact (h1.comp (0 : ℝ) hℓc).continuousAt
      have hmemW : ∀ᶠ t in 𝓝 (0 : ℝ), Ψ (Φ x + t • ((0 : ℝ), innerSL ℝ v v)) ∈ W := by
        apply hγc.eventually_mem
        simp only [zero_smul, add_zero, hΨx]
        exact hWn
      have htend : Tendsto (fun t : ℝ => Φ x + t • ((0 : ℝ), innerSL ℝ v v)) (𝓝 0) (𝓝 (Φ x)) := by
        have := hℓ.continuousAt.tendsto
        rw [zero_smul, add_zero] at this
        exact this
      have hfst : ∀ y, (Φ y).1 = b y := fun y => by rw [hΦdef]
      filter_upwards [hmemW, htend.eventually hright] with t htW htR
      refine ⟨htW, ?_⟩
      have h1 := congrArg Prod.fst htR
      rw [← hfst (Ψ (Φ x + t • ((0 : ℝ), innerSL ℝ v v))), h1]
      simp [hfst, hbx]
  refine ⟨-α / β, fun a => hDw (e2 a), ?_⟩
  intro τ hτ
  obtain ⟨v, hv⟩ : ∃ v : E2, v = τ 0 • e2 0 + τ 1 • e2 1 := ⟨_, rfl⟩
  rw [hquad w (hdd w hwA) τ, hquad b (hdd b hbA) τ, ← hv]
  by_cases hv0 : v = 0
  · simp [hv0]
  have hDbv : fderiv ℝ b x v = 0 := by
    rw [hv]
    simp only [map_add, map_smul, smul_eq_mul]
    exact hτ
  obtain ⟨γ, hγc, hγ0, hγv, hγev⟩ := hcurve v hv0 hDbv
  have eb := hsecond b hb γ hγc hγ0 (hγev.mono fun t ht => ht)
  have ew := hsecond w hw γ hγc hγ0 (hγev.mono fun t ht => ⟨ht.1, hvan _ ht.1 ht.2⟩)
  rw [hγv.deriv] at eb ew
  linear_combination ew - (-α / β) * eb - hDw (deriv (deriv γ) 0)

theorem pcgb_boundary_curvature_algebra (W : Set E2) (hW : IsOpen W)
    (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (hh : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun y => h y a c) W)
    (hpd : ∀ y ∈ W, (h y).PosDef) (b w : E2 → ℝ) (hb : ContDiffOn ℝ ∞ b W)
    (hw : ContDiffOn ℝ ∞ w W) (x : E2) (hx : x ∈ W) (hdb : fderiv ℝ b x ≠ 0)
    (hdw : fderiv ℝ w x ≠ 0) (lam : ℝ)
    (H1 : ∀ a : Fin 2, pd2 a w x = lam * pd2 a b x)
    (H2 : ∀ τ : Fin 2 → ℝ, τ 0 * pd2 0 b x + τ 1 * pd2 1 b x = 0 →
        ∑ i : Fin 2, ∑ j : Fin 2, τ i * τ j * pd2 i (pd2 j w) x =
          lam * ∑ i : Fin 2, ∑ j : Fin 2, τ i * τ j * pd2 i (pd2 j b) x)
    (H3 : lap2 h w x = 0) :
    ∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a b x *
        pd2 c (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y)) x =
      Real.sqrt (sgbGradSq2 h b x) * sgbLevelCurv2 h b x :=
by
  have hxU : W ∈ 𝓝 x := hW.mem_nhds hx
  have hsymm : ∀ z ∈ W, ∀ i j : Fin 2, h z i j = h z j i := by
    intro z hz i j
    have := (hpd z hz).isHermitian.apply j i
    simpa using this
  have hdh : ∀ a c : Fin 2, DifferentiableAt ℝ (fun z => h z a c) x := fun a c =>
    ((hh a c).differentiableOn (by simp)).differentiableAt hxU
  
  have pmul : ∀ (f g : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
      pd2 k (fun z => f z * g z) x = pd2 k f x * g x + f x * pd2 k g x := by
    intro f g k hf hg
    unfold pd2
    rw [fderiv_fun_mul hf hg]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have padd : ∀ (f g : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
      pd2 k (fun z => f z + g z) x = pd2 k f x + pd2 k g x := by
    intro f g k hf hg
    unfold pd2
    rw [fderiv_fun_add hf hg]
    rfl
  have psub : ∀ (f g : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
      pd2 k (fun z => f z - g z) x = pd2 k f x - pd2 k g x := by
    intro f g k hf hg
    unfold pd2
    rw [fderiv_fun_sub hf hg]
    rfl
  have pneg : ∀ (f : E2 → ℝ) (k : Fin 2), pd2 k (fun z => -f z) x = -pd2 k f x := by
    intro f k
    unfold pd2
    rw [show (fun z => -f z) = -f from rfl, fderiv_neg]
    rfl
  have pinv : ∀ (f : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → f x ≠ 0 →
      pd2 k (fun z => (f z)⁻¹) x = -pd2 k f x / (f x) ^ 2 := by
    intro f k hf hf0
    unfold pd2
    have H := (hasDerivAt_inv hf0).comp_hasFDerivAt x hf.hasFDerivAt
    rw [show (fun z => (f z)⁻¹) = (fun y : ℝ => y⁻¹) ∘ f from rfl, H.fderiv]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    field_simp
  have psqrt : ∀ (f : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → f x ≠ 0 →
      pd2 k (fun z => Real.sqrt (f z)) x = pd2 k f x / (2 * Real.sqrt (f x)) := by
    intro f k hf hf0
    unfold pd2
    rw [fderiv_sqrt hf hf0]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have pdiv : ∀ (f g : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
      g x ≠ 0 →
      pd2 k (fun z => f z / g z) x = pd2 k f x * (g x)⁻¹ + f x * (-pd2 k g x / (g x) ^ 2) := by
    intro f g k hf hg hg0
    have e : (fun z => f z / g z) = fun z => f z * (g z)⁻¹ := funext fun z => div_eq_mul_inv _ _
    rw [e, pmul _ _ k hf (hg.fun_inv hg0), pinv _ k hg hg0]
  have hfz : ∀ f : E2 → ℝ, pd2 0 f x = 0 → pd2 1 f x = 0 → fderiv ℝ f x = 0 := by
    intro f h0 h1
    refine ContinuousLinearMap.ext fun v => ?_
    have hv : v = v 0 • e2 0 + v 1 • e2 1 := by
      ext i; fin_cases i <;> simp [e2]
    rw [hv, map_add, map_smul, map_smul]
    unfold pd2 at h0 h1
    rw [h0, h1]
    simp
  
  have hinvE : ∀ (A : Matrix (Fin 2) (Fin 2) ℝ) (i j : Fin 2),
      A⁻¹ i j = A.det⁻¹ * A.adjugate i j := by
    intro A i j
    rw [Matrix.inv_def, Ring.inverse_eq_inv']
    rfl
  have hadj00 : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.adjugate 0 0 = A 1 1 := by
    intro A; simp [Matrix.adjugate_fin_two]
  have hadj01 : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.adjugate 0 1 = -A 0 1 := by
    intro A; simp [Matrix.adjugate_fin_two]
  have hadj10 : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.adjugate 1 0 = -A 1 0 := by
    intro A; simp [Matrix.adjugate_fin_two]
  have hadj11 : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.adjugate 1 1 = A 0 0 := by
    intro A; simp [Matrix.adjugate_fin_two]
  have hdetE : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.det = A 0 0 * A 1 1 - A 0 1 * A 1 0 :=
    fun A => Matrix.det_fin_two A
  have hDpos : 0 < (h x).det := (hpd x hx).det_pos
  have hD0 : (h x).det ≠ 0 := hDpos.ne'
  have hx10 : h x 1 0 = h x 0 1 := hsymm x hx 1 0
  have hd10 : ∀ l : Fin 2, pd2 l (fun z => h z 1 0) x = pd2 l (fun z => h z 0 1) x := by
    intro l
    have hev : (fun z => h z 1 0) =ᶠ[𝓝 x] (fun z => h z 0 1) :=
      Filter.eventually_of_mem hxU (fun z hz => hsymm z hz 1 0)
    unfold pd2
    rw [Filter.EventuallyEq.fderiv_eq hev]
  have hdetfun : (fun z => (h z).det) = fun z => h z 0 0 * h z 1 1 - h z 0 1 * h z 1 0 := by
    funext z; exact hdetE (h z)
  have hdD : DifferentiableAt ℝ (fun z => (h z).det) x := by
    rw [hdetfun]; exact ((hdh 0 0).mul (hdh 1 1)).sub ((hdh 0 1).mul (hdh 1 0))
  have hdS : DifferentiableAt ℝ (fun z => Real.sqrt (h z).det) x := hdD.sqrt hD0
  have hdpd : ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f W → ∀ j : Fin 2,
      DifferentiableAt ℝ (pd2 j f) x := by
    intro f hf j
    have h2 : ContDiffOn ℝ 2 f W := contDiffOn_infty.mp hf 2
    have h1 : ContDiffOn ℝ 1 (fun y => fderiv ℝ f y) W := h2.fderiv_of_isOpen hW (by norm_num)
    have h3 : ContDiffOn ℝ 1 (pd2 j f) W := h1.clm_apply contDiffOn_const
    exact (h3.differentiableOn (by norm_num)).differentiableAt hxU
  have hdbj := hdpd b hb
  have hdI : ∀ i j : Fin 2, DifferentiableAt ℝ (fun z => (h z)⁻¹ i j) x := by
    intro i j
    have e : (fun z => (h z)⁻¹ i j) = fun z => ((h z).det)⁻¹ * (h z).adjugate i j :=
      funext fun z => hinvE (h z) i j
    rw [e]
    refine (hdD.inv hD0).mul ?_
    fin_cases i <;> fin_cases j
    · simp only [Fin.zero_eta, hadj00]; exact hdh 1 1
    · simp only [Fin.zero_eta, Fin.mk_one, hadj01]; exact (hdh 0 1).neg
    · simp only [Fin.zero_eta, Fin.mk_one, hadj10]; exact (hdh 1 0).neg
    · simp only [Fin.mk_one, hadj11]; exact hdh 0 0
  
  have pD : ∀ k : Fin 2, pd2 k (fun z => (h z).det) x =
      pd2 k (fun z => h z 0 0) x * h x 1 1 + h x 0 0 * pd2 k (fun z => h z 1 1) x -
        (pd2 k (fun z => h z 0 1) x * h x 1 0 + h x 0 1 * pd2 k (fun z => h z 1 0) x) := by
    intro k
    rw [hdetfun, psub _ _ k ((hdh 0 0).fun_mul (hdh 1 1)) ((hdh 0 1).fun_mul (hdh 1 0)),
      pmul _ _ k (hdh 0 0) (hdh 1 1), pmul _ _ k (hdh 0 1) (hdh 1 0)]
  have pS : ∀ k : Fin 2, pd2 k (fun z => Real.sqrt (h z).det) x =
      Real.sqrt (h x).det * pd2 k (fun z => (h z).det) x / (2 * (h x).det) := by
    intro k
    rw [psqrt _ k hdD hD0]
    have hs0 : 0 < Real.sqrt (h x).det := Real.sqrt_pos.mpr hDpos
    have hss : Real.sqrt (h x).det * Real.sqrt (h x).det = (h x).det :=
      Real.mul_self_sqrt hDpos.le
    generalize Real.sqrt (h x).det = s at hs0 hss ⊢
    rw [← hss]
    field_simp
  have pI00 : ∀ k : Fin 2, pd2 k (fun z => (h z)⁻¹ 0 0) x =
      -pd2 k (fun z => (h z).det) x / (h x).det ^ 2 * h x 1 1 +
        (h x).det⁻¹ * pd2 k (fun z => h z 1 1) x := by
    intro k
    simp only [hinvE, hadj00]
    rw [pmul _ _ k (hdD.fun_inv hD0) (hdh 1 1), pinv _ k hdD hD0]
  have pI01 : ∀ k : Fin 2, pd2 k (fun z => (h z)⁻¹ 0 1) x =
      -pd2 k (fun z => (h z).det) x / (h x).det ^ 2 * (-h x 0 1) +
        (h x).det⁻¹ * (-pd2 k (fun z => h z 0 1) x) := by
    intro k
    simp only [hinvE, hadj01]
    rw [pmul _ _ k (hdD.fun_inv hD0) (hdh 0 1).fun_neg, pinv _ k hdD hD0, pneg]
  have pI10 : ∀ k : Fin 2, pd2 k (fun z => (h z)⁻¹ 1 0) x =
      -pd2 k (fun z => (h z).det) x / (h x).det ^ 2 * (-h x 1 0) +
        (h x).det⁻¹ * (-pd2 k (fun z => h z 1 0) x) := by
    intro k
    simp only [hinvE, hadj10]
    rw [pmul _ _ k (hdD.fun_inv hD0) (hdh 1 0).fun_neg, pinv _ k hdD hD0, pneg]
  have pI11 : ∀ k : Fin 2, pd2 k (fun z => (h z)⁻¹ 1 1) x =
      -pd2 k (fun z => (h z).det) x / (h x).det ^ 2 * h x 0 0 +
        (h x).det⁻¹ * pd2 k (fun z => h z 0 0) x := by
    intro k
    simp only [hinvE, hadj11]
    rw [pmul _ _ k (hdD.fun_inv hD0) (hdh 0 0), pinv _ k hdD hD0]
  
  have hdiv : pd2 0 (fun z => Real.sqrt (h z).det * ∑ j : Fin 2, (h z)⁻¹ 0 j * pd2 j b z) x +
      pd2 1 (fun z => Real.sqrt (h z).det * ∑ j : Fin 2, (h z)⁻¹ 1 j * pd2 j b z) x =
      Real.sqrt (h x).det * lap2 h b x := by
    simp only [Fin.sum_univ_two]
    have hdA : ∀ i : Fin 2, DifferentiableAt ℝ
        (fun z => (h z)⁻¹ i 0 * pd2 0 b z + (h z)⁻¹ i 1 * pd2 1 b z) x :=
      fun i => ((hdI i 0).fun_mul (hdbj 0)).fun_add ((hdI i 1).fun_mul (hdbj 1))
    rw [pmul _ _ 0 hdS (hdA 0), pmul _ _ 1 hdS (hdA 1),
      padd _ _ 0 ((hdI 0 0).fun_mul (hdbj 0)) ((hdI 0 1).fun_mul (hdbj 1)),
      padd _ _ 1 ((hdI 1 0).fun_mul (hdbj 0)) ((hdI 1 1).fun_mul (hdbj 1)),
      pmul _ _ 0 (hdI 0 0) (hdbj 0), pmul _ _ 0 (hdI 0 1) (hdbj 1),
      pmul _ _ 1 (hdI 1 0) (hdbj 0), pmul _ _ 1 (hdI 1 1) (hdbj 1),
      pS 0, pS 1, pI00 0, pI01 0, pI10 1, pI11 1, pD 0, pD 1]
    simp only [lap2, christoffel2, Fin.sum_univ_two, hinvE (h x), hadj00, hadj01, hadj10, hadj11]
    have hD1 : h x 0 0 * h x 1 1 - h x 0 1 * h x 0 1 ≠ 0 := by
      have e := hdetE (h x)
      rw [hx10] at e
      rw [← e]
      exact hD0
    generalize Real.sqrt (h x).det = s
    simp only [hx10, hd10]
    field_simp
    simp only [hdetE (h x), hx10]
    ring
  simp only [Fin.sum_univ_two] at hdiv
  have hX1 := eq_sub_of_add_eq' hdiv
  
  have hA10 : (h x)⁻¹ 1 0 = (h x)⁻¹ 0 1 := by
    have := (hpd x hx).inv.isHermitian.apply 0 1
    simpa using this
  have hβ : (fun a : Fin 2 => pd2 a b x) ≠ 0 := by
    intro h0
    exact hdb (hfz b (congrFun h0 0) (congrFun h0 1))
  have hNpos : 0 < sgbGradSq2 h b x := by
    have hp := (hpd x hx).inv.dotProduct_mulVec_pos hβ
    have e : sgbGradSq2 h b x = dotProduct (star (fun a : Fin 2 => pd2 a b x))
        (Matrix.mulVec (h x)⁻¹ (fun a : Fin 2 => pd2 a b x)) := by
      simp only [sgbGradSq2, dotProduct, Matrix.mulVec, Fin.sum_univ_two, Pi.star_apply,
        star_trivial]
      ring
    rw [e]; exact hp
  have hN0 : sgbGradSq2 h b x ≠ 0 := hNpos.ne'
  have hlam : lam ≠ 0 := by
    intro hl
    apply hdw
    refine hfz w ?_ ?_
    · rw [H1 0, hl, zero_mul]
    · rw [H1 1, hl, zero_mul]
  
  have pGf : ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f W →
      DifferentiableAt ℝ (sgbGradSq2 h f) x ∧ ∀ k : Fin 2, pd2 k (sgbGradSq2 h f) x =
        ∑ a : Fin 2, ∑ d : Fin 2, (pd2 k (fun y => (h y)⁻¹ a d) x * pd2 a f x * pd2 d f x +
          (h x)⁻¹ a d * (pd2 k (pd2 a f) x * pd2 d f x + pd2 a f x * pd2 k (pd2 d f) x)) := by
    intro f hf
    have hf1 := hdpd f hf
    have hT : ∀ a d : Fin 2,
        DifferentiableAt ℝ (fun y => (h y)⁻¹ a d * pd2 a f y * pd2 d f y) x :=
      fun a d => ((hdI a d).fun_mul (hf1 a)).fun_mul (hf1 d)
    have pT : ∀ a d k : Fin 2, pd2 k (fun y => (h y)⁻¹ a d * pd2 a f y * pd2 d f y) x =
        pd2 k (fun y => (h y)⁻¹ a d) x * pd2 a f x * pd2 d f x +
          (h x)⁻¹ a d * (pd2 k (pd2 a f) x * pd2 d f x + pd2 a f x * pd2 k (pd2 d f) x) := by
      intro a d k
      rw [pmul _ _ k ((hdI a d).fun_mul (hf1 a)) (hf1 d), pmul _ _ k (hdI a d) (hf1 a)]
      ring
    have e : sgbGradSq2 h f = fun y => ((h y)⁻¹ 0 0 * pd2 0 f y * pd2 0 f y +
        (h y)⁻¹ 0 1 * pd2 0 f y * pd2 1 f y) + ((h y)⁻¹ 1 0 * pd2 1 f y * pd2 0 f y +
        (h y)⁻¹ 1 1 * pd2 1 f y * pd2 1 f y) := by
      funext y; simp only [sgbGradSq2, Fin.sum_univ_two]
    rw [e]
    refine ⟨((hT 0 0).fun_add (hT 0 1)).fun_add ((hT 1 0).fun_add (hT 1 1)), fun k => ?_⟩
    rw [padd _ _ k ((hT 0 0).fun_add (hT 0 1)) ((hT 1 0).fun_add (hT 1 1)),
      padd _ _ k (hT 0 0) (hT 0 1), padd _ _ k (hT 1 0) (hT 1 1), pT, pT, pT, pT]
    simp only [Fin.sum_univ_two]
  obtain ⟨hGwd, hGw'⟩ := pGf w hw
  obtain ⟨hGbd, hGb'⟩ := pGf b hb
  have hGwx : sgbGradSq2 h w x = lam ^ 2 * sgbGradSq2 h b x := by
    simp only [sgbGradSq2, H1, Fin.sum_univ_two]
    ring
  have hGw0 : sgbGradSq2 h w x ≠ 0 := by
    rw [hGwx]; exact mul_ne_zero (pow_ne_zero 2 hlam) hN0
  
  have pLog : ∀ k : Fin 2,
      pd2 k (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y)) x =
        (1 / 2 : ℝ) * ((sgbGradSq2 h w x)⁻¹ * pd2 k (sgbGradSq2 h w) x) := by
    intro k
    unfold pd2
    rw [fderiv_const_mul (hGwd.log hGw0), fderiv.log hGwd hGw0]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
  
  have hdV : DifferentiableAt ℝ (fun y => Real.sqrt (sgbGradSq2 h b y)) x := hGbd.sqrt hN0
  have hV0 : Real.sqrt (sgbGradSq2 h b x) ≠ 0 := (Real.sqrt_pos.mpr hNpos).ne'
  have hdU : ∀ i : Fin 2, DifferentiableAt ℝ (fun y => Real.sqrt (h y).det *
      ((h y)⁻¹ i 0 * pd2 0 b y + (h y)⁻¹ i 1 * pd2 1 b y)) x :=
    fun i => hdS.fun_mul (((hdI i 0).fun_mul (hdbj 0)).fun_add ((hdI i 1).fun_mul (hdbj 1)))
  have hRHS : Real.sqrt (sgbGradSq2 h b x) * sgbLevelCurv2 h b x =
      -lap2 h b x + (((h x)⁻¹ 0 0 * pd2 0 b x + (h x)⁻¹ 0 1 * pd2 1 b x) *
          pd2 0 (sgbGradSq2 h b) x +
        ((h x)⁻¹ 1 0 * pd2 0 b x + (h x)⁻¹ 1 1 * pd2 1 b x) * pd2 1 (sgbGradSq2 h b) x) /
        (2 * sgbGradSq2 h b x) := by
    have hLC : sgbLevelCurv2 h b x = -((Real.sqrt (h x).det)⁻¹ *
        (pd2 0 (fun y => Real.sqrt (h y).det * ((h y)⁻¹ 0 0 * pd2 0 b y +
            (h y)⁻¹ 0 1 * pd2 1 b y) / Real.sqrt (sgbGradSq2 h b y)) x +
          pd2 1 (fun y => Real.sqrt (h y).det * ((h y)⁻¹ 1 0 * pd2 0 b y +
            (h y)⁻¹ 1 1 * pd2 1 b y) / Real.sqrt (sgbGradSq2 h b y)) x)) := by
      simp only [sgbLevelCurv2, Fin.sum_univ_two]
    rw [hLC, pdiv _ _ 0 (hdU 0) hdV hV0, pdiv _ _ 1 (hdU 1) hdV hV0,
      psqrt _ 0 hGbd hN0, psqrt _ 1 hGbd hN0, hX1]
    have hrr : Real.sqrt (sgbGradSq2 h b x) * Real.sqrt (sgbGradSq2 h b x) = sgbGradSq2 h b x :=
      Real.mul_self_sqrt hNpos.le
    have hs0 : Real.sqrt (h x).det ≠ 0 := (Real.sqrt_pos.mpr hDpos).ne'
    generalize Real.sqrt (sgbGradSq2 h b x) = r at hrr hV0 ⊢
    generalize Real.sqrt (h x).det = s at hs0 ⊢
    rw [← hrr]
    field_simp
    ring
  
  have H3' := H3
  simp only [lap2, H1, Fin.sum_univ_two, hA10] at H3'
  have H2' := H2 ![-(pd2 1 b x), pd2 0 b x]
    (by simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]; ring)
  simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one,
    Matrix.head_cons] at H2'
  have hNe : sgbGradSq2 h b x = (h x)⁻¹ 0 0 * pd2 0 b x * pd2 0 b x +
      (h x)⁻¹ 0 1 * pd2 0 b x * pd2 1 b x + ((h x)⁻¹ 0 1 * pd2 1 b x * pd2 0 b x +
      (h x)⁻¹ 1 1 * pd2 1 b x * pd2 1 b x) := by
    simp only [sgbGradSq2, Fin.sum_univ_two, hA10]
  
  rw [hRHS]
  simp only [pLog, hGw', hGb', hGwx, H1]
  simp only [lap2, Fin.sum_univ_two, hA10]
  linear_combination (norm := skip) (1 / lam) * H3' +
    (-((h x)⁻¹ 0 0 * (h x)⁻¹ 1 1 - (h x)⁻¹ 0 1 * (h x)⁻¹ 0 1) /
      (lam * sgbGradSq2 h b x)) * H2'
  field_simp
  rw [hNe]
  ring

theorem pcgb_thin_band_volume (W : Set E2) (hW : IsOpen W) (Kc : Set E2) (hKc : IsCompact Kc)
    (hKW : Kc ⊆ W) (b : E2 → ℝ) (hb : ContDiffOn ℝ ∞ b W)
    (hreg : ∀ x ∈ W, b x = 0 → fderiv ℝ b x ≠ 0) :
    ∃ Cb s₄ : ℝ, 0 < s₄ ∧ ∀ s : ℝ, 0 < s → s < s₄ →
      MeasureTheory.volume (Kc ∩ {x | 0 < b x ∧ b x < s}) ≤ ENNReal.ofReal (Cb * s) :=
by
  classical
  
  have growth : ∀ y₀ ∈ W, fderiv ℝ b y₀ ≠ 0 →
      ∃ R cc : ℝ, ∃ v : E2, 0 < R ∧ 0 < cc ∧ ‖v‖ = 1 ∧ Metric.ball y₀ (2 * R) ⊆ W ∧
        ∀ y ∈ Metric.ball y₀ R, ∀ t : ℝ, 0 ≤ t → t ≤ R → b y + cc * t ≤ b (y + t • v) := by
    intro y₀ hy₀ hd
    obtain ⟨w, hw⟩ : ∃ w, fderiv ℝ b y₀ w ≠ 0 := by
      by_contra hcon
      push_neg at hcon
      exact hd (ContinuousLinearMap.ext hcon)
    have hw0 : w ≠ 0 := by
      rintro rfl
      simp at hw
    have hwn : 0 < ‖w‖ := norm_pos_iff.mpr hw0
    have hwi : 0 < ‖w‖⁻¹ := inv_pos.mpr hwn
    obtain ⟨v, hv1, hav⟩ : ∃ v : E2, ‖v‖ = 1 ∧ 0 < fderiv ℝ b y₀ v := by
      rcases lt_or_gt_of_ne hw with h | h
      · refine ⟨-(‖w‖⁻¹ • w), ?_, ?_⟩
        · rw [norm_neg, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hwn.ne']
        · rw [map_neg, map_smul, smul_eq_mul]
          nlinarith
      · refine ⟨‖w‖⁻¹ • w, ?_, ?_⟩
        · rw [norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hwn.ne']
        · rw [map_smul, smul_eq_mul]
          exact mul_pos hwi h
    have hfc : ContinuousOn (fderiv ℝ b) W :=
      hb.continuousOn_fderiv_of_isOpen hW (by simp)
    have hfca : ContinuousAt (fderiv ℝ b) y₀ := hfc.continuousAt (hW.mem_nhds hy₀)
    obtain ⟨δ₁, hδ₁, hδ₁'⟩ := Metric.continuousAt_iff.mp hfca (fderiv ℝ b y₀ v / 2)
      (by linarith)
    obtain ⟨δ₂, hδ₂, hδ₂'⟩ := Metric.isOpen_iff.mp hW y₀ hy₀
    have hδ : 0 < min δ₁ δ₂ := lt_min hδ₁ hδ₂
    have hballT : Metric.ball y₀ (min δ₁ δ₂) ⊆ W :=
      (Metric.ball_subset_ball (min_le_right _ _)).trans hδ₂'
    have hder : ∀ z ∈ Metric.ball y₀ (min δ₁ δ₂), fderiv ℝ b y₀ v / 2 < fderiv ℝ b z v := by
      intro z hz
      have hz1 : dist z y₀ < δ₁ := lt_of_lt_of_le hz (min_le_left _ _)
      have h1 := hδ₁' hz1
      rw [dist_eq_norm] at h1
      have h2 : ‖(fderiv ℝ b z - fderiv ℝ b y₀) v‖ ≤ ‖fderiv ℝ b z - fderiv ℝ b y₀‖ * ‖v‖ :=
        ContinuousLinearMap.le_opNorm _ _
      rw [hv1, mul_one, ContinuousLinearMap.sub_apply, Real.norm_eq_abs] at h2
      have h3 := neg_abs_le (fderiv ℝ b z v - fderiv ℝ b y₀ v)
      linarith
    refine ⟨min δ₁ δ₂ / 2, fderiv ℝ b y₀ v / 2, v, by linarith, by linarith, hv1, ?_, ?_⟩
    · rw [show 2 * (min δ₁ δ₂ / 2) = min δ₁ δ₂ by ring]
      exact hballT
    · intro y hy t ht0 htR
      have hseg : ∀ τ : ℝ, 0 ≤ τ → τ ≤ t → y + τ • v ∈ Metric.ball y₀ (min δ₁ δ₂) := by
        intro τ hτ0 hτt
        rw [Metric.mem_ball] at hy ⊢
        calc dist (y + τ • v) y₀ ≤ dist (y + τ • v) y + dist y y₀ := dist_triangle _ _ _
          _ = τ + dist y y₀ := by
              rw [dist_eq_norm, add_sub_cancel_left, norm_smul, hv1, mul_one, Real.norm_eq_abs,
                abs_of_nonneg hτ0]
          _ < min δ₁ δ₂ := by linarith
      have hderiv : ∀ τ : ℝ, 0 ≤ τ → τ ≤ t →
          HasDerivAt (fun τ => b (y + τ • v)) (fderiv ℝ b (y + τ • v) v) τ := by
        intro τ hτ0 hτt
        have hmem := hballT (hseg τ hτ0 hτt)
        have hbd : DifferentiableAt ℝ b (y + τ • v) :=
          (hb.contDiffAt (hW.mem_nhds hmem)).differentiableAt (by simp)
        have hp : HasDerivAt (fun τ : ℝ => y + τ • v) v τ := by
          simpa using ((hasDerivAt_id τ).smul_const v).const_add y
        exact hbd.hasFDerivAt.comp_hasDerivAt τ hp
      rcases eq_or_lt_of_le ht0 with h | h
      · subst h
        simp
      · have hcont : ContinuousOn (fun τ => b (y + τ • v)) (Set.Icc 0 t) := by
          intro τ hτ
          exact (hderiv τ hτ.1 hτ.2).continuousAt.continuousWithinAt
        obtain ⟨ξ, hξ, hξeq⟩ := exists_hasDerivAt_eq_slope (fun τ => b (y + τ • v))
          (fun τ => fderiv ℝ b (y + τ • v) v) h hcont
          (fun τ hτ => hderiv τ hτ.1.le hτ.2.le)
        have hgt := hder _ (hseg ξ hξ.1.le hξ.2.le)
        rw [hξeq] at hgt
        simp only [zero_smul, add_zero, sub_zero] at hgt
        rw [lt_div_iff₀ h] at hgt
        linarith
  
  have pack : ∀ (y₀ v : E2) (R cc : ℝ), 0 < R → 0 < cc → ‖v‖ = 1 →
      ContinuousOn b (Metric.ball y₀ R) →
      (∀ y ∈ Metric.ball y₀ R, ∀ t : ℝ, 0 ≤ t → t ≤ R → b y + cc * t ≤ b (y + t • v)) →
      ∀ s : ℝ, 0 < s → s < R * cc →
        MeasureTheory.volume (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s}) ≤
          ENNReal.ofReal (2 * (MeasureTheory.volume (Metric.ball y₀ (2 * R))).toReal /
            (R * cc) * s) := by
    intro y₀ v R cc hR hcc hv hbc hgrow s hs hsR
    have hUo : IsOpen (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s}) :=
      hbc.isOpen_inter_preimage Metric.isOpen_ball (isOpen_Ioo (a := (0 : ℝ)) (b := s))
    have hhpos : 0 < s / cc := div_pos hs hcc
    have hx1 : 1 < R * cc / s := by rw [lt_div_iff₀ hs]; linarith
    have hN1 : 0 < ⌊R * cc / s⌋₊ := Nat.floor_pos.mpr hx1.le
    have hNx : (⌊R * cc / s⌋₊ : ℝ) ≤ R * cc / s := Nat.floor_le (by linarith)
    have hxN : R * cc / s < ⌊R * cc / s⌋₊ + 1 := Nat.lt_floor_add_one _
    have hNh : (⌊R * cc / s⌋₊ : ℝ) * (s / cc) ≤ R := by
      calc (⌊R * cc / s⌋₊ : ℝ) * (s / cc) ≤ R * cc / s * (s / cc) :=
            mul_le_mul_of_nonneg_right hNx hhpos.le
        _ = R := by field_simp
    have hUkm : ∀ k : ℕ, MeasurableSet
        ((fun z => z + (-((k : ℝ) * (s / cc))) • v) ⁻¹'
          (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})) := fun k =>
      (measurable_add_const _) hUo.measurableSet
    have hUkv : ∀ k : ℕ, MeasureTheory.volume
        ((fun z => z + (-((k : ℝ) * (s / cc))) • v) ⁻¹'
          (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})) =
        MeasureTheory.volume (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s}) := fun k =>
      MeasureTheory.measure_preimage_add_right MeasureTheory.volume _ _
    have hUksub : ∀ k ∈ Finset.range ⌊R * cc / s⌋₊,
        (fun z => z + (-((k : ℝ) * (s / cc))) • v) ⁻¹'
          (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s}) ⊆ Metric.ball y₀ (2 * R) := by
      intro k hk z hz
      have hkN : (k : ℝ) ≤ ⌊R * cc / s⌋₊ := by exact_mod_cast (Finset.mem_range.mp hk).le
      have hd : dist (z + (-((k : ℝ) * (s / cc))) • v) y₀ < R := hz.1
      have hkh : 0 ≤ (k : ℝ) * (s / cc) := mul_nonneg (Nat.cast_nonneg k) hhpos.le
      have hkh2 : (k : ℝ) * (s / cc) ≤ ⌊R * cc / s⌋₊ * (s / cc) :=
        mul_le_mul_of_nonneg_right hkN hhpos.le
      have hdz : dist z (z + (-((k : ℝ) * (s / cc))) • v) = (k : ℝ) * (s / cc) := by
        rw [dist_eq_norm, sub_add_cancel_left, norm_neg, norm_smul, hv, mul_one,
          Real.norm_eq_abs, abs_neg, abs_of_nonneg hkh]
      rw [Metric.mem_ball]
      calc dist z y₀ ≤ dist z (z + (-((k : ℝ) * (s / cc))) • v) +
            dist (z + (-((k : ℝ) * (s / cc))) • v) y₀ := dist_triangle _ _ _
        _ < (k : ℝ) * (s / cc) + R := by rw [hdz]; linarith
        _ ≤ 2 * R := by linarith
    have key : ∀ j k : ℕ, j < k → k < ⌊R * cc / s⌋₊ → Disjoint
        ((fun z => z + (-((j : ℝ) * (s / cc))) • v) ⁻¹'
          (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s}))
        ((fun z => z + (-((k : ℝ) * (s / cc))) • v) ⁻¹'
          (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})) := by
      intro j k hjk hkN
      rw [Set.disjoint_left]
      intro z hzj hzk
      have hj : z + (-((j : ℝ) * (s / cc))) • v ∈
          Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s} := hzj
      have hk : z + (-((k : ℝ) * (s / cc))) • v ∈
          Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s} := hzk
      have hjk' : (j : ℝ) + 1 ≤ k := by exact_mod_cast hjk
      have hkN' : (k : ℝ) ≤ ⌊R * cc / s⌋₊ := by exact_mod_cast hkN.le
      have hj0 : (0 : ℝ) ≤ j := Nat.cast_nonneg j
      have ht0 : s / cc ≤ ((k : ℝ) - j) * (s / cc) := by nlinarith
      have htR : ((k : ℝ) - j) * (s / cc) ≤ R := by
        have : ((k : ℝ) - j) * (s / cc) ≤ (⌊R * cc / s⌋₊ : ℝ) * (s / cc) := by nlinarith
        linarith
      have heq : z + (-((k : ℝ) * (s / cc))) • v + (((k : ℝ) - j) * (s / cc)) • v =
          z + (-((j : ℝ) * (s / cc))) • v := by
        rw [add_assoc, ← add_smul]
        congr 2
        ring
      have hg := hgrow _ hk.1 (((k : ℝ) - j) * (s / cc)) (by linarith) htR
      rw [heq] at hg
      have h1 : 0 < b (z + (-((k : ℝ) * (s / cc))) • v) := hk.2.1
      have h2 : b (z + (-((j : ℝ) * (s / cc))) • v) < s := hj.2.2
      have h3 : cc * (s / cc) ≤ cc * (((k : ℝ) - j) * (s / cc)) :=
        mul_le_mul_of_nonneg_left ht0 hcc.le
      have hcs : cc * (s / cc) = s := by field_simp
      linarith
    have hdisj : Set.PairwiseDisjoint (↑(Finset.range ⌊R * cc / s⌋₊) : Set ℕ)
        (fun k : ℕ => (fun z => z + (-((k : ℝ) * (s / cc))) • v) ⁻¹'
          (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})) := by
      intro j hj k hk hne
      rcases lt_or_gt_of_ne hne with h' | h'
      · exact key j k h' (Finset.mem_range.mp hk)
      · exact (key k j h' (Finset.mem_range.mp hj)).symm
    have hsum : ∑ k ∈ Finset.range ⌊R * cc / s⌋₊, MeasureTheory.volume
        ((fun z => z + (-((k : ℝ) * (s / cc))) • v) ⁻¹'
          (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})) ≤
        MeasureTheory.volume (Metric.ball y₀ (2 * R)) := by
      rw [← MeasureTheory.measure_biUnion_finset hdisj (fun k _ => hUkm k)]
      exact MeasureTheory.measure_mono (Set.iUnion₂_subset hUksub)
    simp only [hUkv, Finset.sum_const, Finset.card_range, nsmul_eq_mul] at hsum
    have hWt : MeasureTheory.volume (Metric.ball y₀ (2 * R)) ≠ ⊤ := measure_ball_lt_top.ne
    have hUt : MeasureTheory.volume (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s}) ≠ ⊤ := by
      intro htop
      rw [htop, ENNReal.mul_top (Nat.cast_ne_zero.mpr (by omega))] at hsum
      exact hWt (top_le_iff.mp hsum)
    have hreal : (⌊R * cc / s⌋₊ : ℝ) *
        (MeasureTheory.volume (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})).toReal ≤
        (MeasureTheory.volume (Metric.ball y₀ (2 * R))).toReal := by
      have := ENNReal.toReal_mono hWt hsum
      rwa [ENNReal.toReal_mul, ENNReal.toReal_natCast] at this
    rw [← ENNReal.ofReal_toReal hUt]
    apply ENNReal.ofReal_le_ofReal
    have hU0 : 0 ≤ (MeasureTheory.volume (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})).toReal :=
      ENNReal.toReal_nonneg
    have hN1' : (1 : ℝ) ≤ ⌊R * cc / s⌋₊ := by exact_mod_cast hN1
    have hRc : R * cc ≤ 2 * ⌊R * cc / s⌋₊ * s := by
      have h2N : R * cc / s ≤ 2 * ⌊R * cc / s⌋₊ := by linarith
      rw [div_le_iff₀ hs] at h2N
      linarith
    rw [div_mul_eq_mul_div, le_div_iff₀ (mul_pos hR hcc)]
    calc (MeasureTheory.volume (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})).toReal * (R * cc)
        ≤ (MeasureTheory.volume (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})).toReal *
            (2 * ⌊R * cc / s⌋₊ * s) := mul_le_mul_of_nonneg_left hRc hU0
      _ = 2 * s * ((⌊R * cc / s⌋₊ : ℝ) *
            (MeasureTheory.volume (Metric.ball y₀ R ∩ {y | 0 < b y ∧ b y < s})).toReal) := by
          ring
      _ ≤ 2 * s * (MeasureTheory.volume (Metric.ball y₀ (2 * R))).toReal :=
          mul_le_mul_of_nonneg_left hreal (by linarith)
      _ = 2 * (MeasureTheory.volume (Metric.ball y₀ (2 * R))).toReal * s := by ring
  
  have hloc : ∀ y₀ ∈ Kc, ∃ r C s₁ : ℝ, 0 < r ∧ 0 ≤ C ∧ 0 < s₁ ∧ ∀ s : ℝ, 0 < s → s < s₁ →
      MeasureTheory.volume (Metric.ball y₀ r ∩ {y | 0 < b y ∧ b y < s}) ≤
        ENNReal.ofReal (C * s) := by
    intro y₀ hy₀
    have hy₀T := hKW hy₀
    by_cases hb0 : b y₀ = 0
    · obtain ⟨R, cc, v, hR, hcc, hv, hball, hgrow⟩ := growth y₀ hy₀T (hreg y₀ hy₀T hb0)
      have hbc : ContinuousOn b (Metric.ball y₀ R) :=
        hb.continuousOn.mono ((Metric.ball_subset_ball (by linarith)).trans hball)
      refine ⟨R, 2 * (MeasureTheory.volume (Metric.ball y₀ (2 * R))).toReal / (R * cc), R * cc, hR,
        div_nonneg (mul_nonneg zero_le_two ENNReal.toReal_nonneg) (mul_pos hR hcc).le,
        mul_pos hR hcc, ?_⟩
      exact pack y₀ v R cc hR hcc hv hbc hgrow
    · have hm : 0 < |b y₀| := abs_pos.mpr hb0
      have hca : ContinuousAt b y₀ := hb.continuousOn.continuousAt (hW.mem_nhds hy₀T)
      obtain ⟨r, hr, hr'⟩ := Metric.continuousAt_iff.mp hca (|b y₀| / 2) (by linarith)
      refine ⟨r, 0, |b y₀| / 2, hr, le_rfl, by linarith, fun s hs hss => ?_⟩
      have hempty : Metric.ball y₀ r ∩ {y | 0 < b y ∧ b y < s} = ∅ := by
        rw [Set.eq_empty_iff_forall_notMem]
        rintro z ⟨hz, hz1, hz2⟩
        have h1 : dist (b z) (b y₀) < |b y₀| / 2 := hr' hz
        rw [Real.dist_eq] at h1
        have h2 := abs_sub_abs_le_abs_sub (b y₀) (b z)
        have h3 : |b y₀ - b z| = |b z - b y₀| := abs_sub_comm _ _
        rw [abs_of_pos hz1] at h2
        linarith
      rw [hempty, MeasureTheory.measure_empty]
      exact zero_le _
  
  choose! r C s₁ hr hC hs₁ hbd using hloc
  obtain ⟨t, htK, hcover⟩ := hKc.elim_nhds_subcover (fun y => Metric.ball y (r y))
    (fun y hy => Metric.ball_mem_nhds y (hr y hy))
  refine ⟨∑ y ∈ t, C y, (insert 1 (t.image s₁)).min' (Finset.insert_nonempty _ _), ?_,
    fun s hs hss => ?_⟩
  · have hm := Finset.min'_mem (insert 1 (t.image s₁)) (Finset.insert_nonempty _ _)
    rw [Finset.mem_insert, Finset.mem_image] at hm
    rcases hm with h | ⟨y, hy, hy'⟩
    · rw [h]; exact one_pos
    · rw [← hy']; exact hs₁ y (htK y hy)
  · have hle : ∀ y ∈ t, s < s₁ y := fun y hy => lt_of_lt_of_le hss
      (Finset.min'_le _ _ (Finset.mem_insert_of_mem (Finset.mem_image_of_mem _ hy)))
    calc MeasureTheory.volume (Kc ∩ {x | 0 < b x ∧ b x < s})
        ≤ MeasureTheory.volume (⋃ y ∈ t, (Metric.ball y (r y) ∩ {y | 0 < b y ∧ b y < s})) := by
          apply MeasureTheory.measure_mono
          rintro z ⟨hzK, hz⟩
          have hzc := hcover hzK
          rw [Set.mem_iUnion₂] at hzc ⊢
          obtain ⟨y, hy, hzy⟩ := hzc
          exact ⟨y, hy, hzy, hz⟩
      _ ≤ ∑ y ∈ t, MeasureTheory.volume (Metric.ball y (r y) ∩ {y | 0 < b y ∧ b y < s}) :=
          MeasureTheory.measure_biUnion_finset_le _ _
      _ ≤ ∑ y ∈ t, ENNReal.ofReal (C y * s) :=
          Finset.sum_le_sum (fun y hy => hbd y (htK y hy) s hs (hle y hy))
      _ = ENNReal.ofReal (∑ y ∈ t, C y * s) :=
          (ENNReal.ofReal_sum_of_nonneg (fun y hy => mul_nonneg (hC y (htK y hy)) hs.le)).symm
      _ = ENNReal.ofReal ((∑ y ∈ t, C y) * s) := by rw [Finset.sum_mul]

theorem pcgb_patch_collar_bound (W : Set E2) (hW : IsOpen W) (Kc : Set E2) (hKc : IsCompact Kc)
    (hKW : Kc ⊆ W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun y => h y a c) W) (hpd : ∀ y ∈ W, (h y).PosDef)
    (b w : E2 → ℝ) (hb : ContDiffOn ℝ ∞ b W) (V : Set E2) (hV : IsOpen V) (hVW : V ⊆ W)
    (σ₀ : ℝ) (hσ₀ : 0 < σ₀) (hbV : ∀ x ∈ W, 0 ≤ b x → b x ≤ σ₀ → x ∈ V)
    (hw : ContDiffOn ℝ ∞ w V)
    (hreg : ∀ x ∈ W, b x = 0 → fderiv ℝ b x ≠ 0)
    (hdw : ∀ x ∈ W, b x = 0 → fderiv ℝ w x ≠ 0)
    (hzero : ∀ x ∈ W, b x = 0 → ∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a b x *
        pd2 c (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y)) x =
      Real.sqrt (sgbGradSq2 h b x) * sgbLevelCurv2 h b x) :
    ∃ A : ℝ, 0 ≤ A ∧ ∀ δ : ℝ, 0 < δ → ∃ σ : ℝ, 0 < σ ∧ ∀ ε : ℝ, 0 < ε → ∀ x ∈ Kc,
      0 < b x → b x < σ →
      |Real.sqrt (sgbGradSq2 h b x) * sgbLevelCurv2 h b x -
        ∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a b x *
          pd2 c (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y + ε)) x| ≤ δ + A * ε :=
by
  classical
  have hne : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  
  have sep : ∀ (K : Set E2), IsCompact K → ∀ (bb F : E2 → ℝ), ContinuousOn bb K →
      ContinuousOn F K → ∀ (δ' : ℝ), (∀ x ∈ K, bb x = 0 → F x < δ') →
      ∃ σ : ℝ, 0 < σ ∧ ∀ x ∈ K, 0 ≤ bb x → bb x < σ → F x < δ' := by
    intro K hK bb F hbb hF δ' hz
    have hK1 : IsClosed (K ∩ bb ⁻¹' Set.Ici 0) :=
      hbb.preimage_isClosed_of_isClosed hK.isClosed isClosed_Ici
    have hK2 : IsClosed ((K ∩ bb ⁻¹' Set.Ici 0) ∩ F ⁻¹' Set.Ici δ') :=
      (hF.mono Set.inter_subset_left).preimage_isClosed_of_isClosed hK1 isClosed_Ici
    have hK'c : IsCompact ((K ∩ bb ⁻¹' Set.Ici 0) ∩ F ⁻¹' Set.Ici δ') :=
      hK.of_isClosed_subset hK2 (fun x hx => hx.1.1)
    rcases Set.eq_empty_or_nonempty ((K ∩ bb ⁻¹' Set.Ici 0) ∩ F ⁻¹' Set.Ici δ') with hE | hE
    · refine ⟨1, one_pos, fun x hx h0 _ => ?_⟩
      by_contra hc
      have hmem : x ∈ ((K ∩ bb ⁻¹' Set.Ici 0) ∩ F ⁻¹' Set.Ici δ') :=
        ⟨⟨hx, h0⟩, not_lt.mp hc⟩
      rw [hE] at hmem
      exact hmem
    · obtain ⟨x₀, hx₀, hmin⟩ := hK'c.exists_isMinOn hE (hbb.mono (fun x hx => hx.1.1))
      have hx₀b : (0 : ℝ) ≤ bb x₀ := hx₀.1.2
      have hx₀F : δ' ≤ F x₀ := hx₀.2
      have hpos : 0 < bb x₀ := by
        rcases lt_or_eq_of_le hx₀b with h | h
        · exact h
        · exact absurd (hz x₀ hx₀.1.1 h.symm) (not_lt.mpr hx₀F)
      refine ⟨bb x₀, hpos, fun x hx h0 hlt => ?_⟩
      by_contra hc
      have hmem : x ∈ ((K ∩ bb ⁻¹' Set.Ici 0) ∩ F ⁻¹' Set.Ici δ') :=
        ⟨⟨hx, h0⟩, not_lt.mp hc⟩
      have := isMinOn_iff.mp hmin x hmem
      linarith
  
  have gpos : ∀ (f : E2 → ℝ) (x : E2), (h x).PosDef → fderiv ℝ f x ≠ 0 →
      0 < sgbGradSq2 h f x := by
    intro f x hx hd
    have hξ : (![pd2 0 f x, pd2 1 f x] : Fin 2 → ℝ) ≠ 0 := by
      intro h0
      apply hd
      have h0' : fderiv ℝ f x (e2 0) = 0 := by simpa [pd2] using congrFun h0 0
      have h1' : fderiv ℝ f x (e2 1) = 0 := by simpa [pd2] using congrFun h0 1
      refine ContinuousLinearMap.ext (fun v => ?_)
      have hv : v = v 0 • e2 0 + v 1 • e2 1 := by
        ext i
        fin_cases i <;> simp [e2, EuclideanSpace.single_apply]
      rw [hv, map_add, map_smul, map_smul, h0', h1']
      simp
    refine lt_of_lt_of_eq (hx.inv.dotProduct_mulVec_pos hξ) ?_
    simp only [sgbGradSq2, dotProduct, Matrix.mulVec, Fin.sum_univ_two, star_trivial,
      Pi.star_apply, Matrix.cons_val_zero, Matrix.cons_val_one]
    ring
  
  have hdetW : ∀ y ∈ W, (h y).det ≠ 0 := fun y hy => (hpd y hy).det_pos.ne'
  have hdetS : ContDiffOn ℝ ∞ (fun y => (h y).det) W := by
    have e : (fun y => (h y).det) = fun y => h y 0 0 * h y 1 1 - h y 0 1 * h y 1 0 := by
      funext y
      exact Matrix.det_fin_two _
    rw [e]
    exact ((hh 0 0).mul (hh 1 1)).sub ((hh 0 1).mul (hh 1 0))
  have hinvW : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y)⁻¹ a c) W := by
    have hdi : ContDiffOn ℝ ∞ (fun y => ((h y).det)⁻¹) W := hdetS.inv hdetW
    have e : ∀ y, ∀ a c : Fin 2, (h y)⁻¹ a c = ((h y).det)⁻¹ * (h y).adjugate a c := by
      intro y a c
      rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
    have hadj : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y).adjugate a c) W := by
      intro a c
      have e2' : (fun y => (h y).adjugate a c) = fun y =>
          (!![h y 1 1, -h y 0 1; -h y 1 0, h y 0 0] : Matrix (Fin 2) (Fin 2) ℝ) a c := by
        funext y
        rw [Matrix.adjugate_fin_two]
      rw [e2']
      fin_cases a <;> fin_cases c
      · simpa using hh 1 1
      · simpa using (hh 0 1).neg
      · simpa using (hh 1 0).neg
      · simpa using hh 0 0
    intro a c
    exact (hdi.mul (hadj a c)).congr (fun y _ => e y a c)
  
  have pdS : ∀ (U : Set E2), IsOpen U → ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f U →
      ∀ a : Fin 2, ContDiffOn ℝ ∞ (pd2 a f) U := by
    intro U hU f hf a
    exact (hf.fderiv_of_isOpen hU le_rfl).clm_apply contDiffOn_const
  have gS : ∀ (U : Set E2), IsOpen U → U ⊆ W → ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f U →
      ContDiffOn ℝ ∞ (sgbGradSq2 h f) U := by
    intro U hU hUW f hf
    have hp := pdS U hU f hf
    show ContDiffOn ℝ ∞ (fun x => ∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a f x * pd2 c f x) U
    exact ContDiffOn.sum (fun a _ => ContDiffOn.sum (fun c _ =>
      (((hinvW a c).mono hUW).mul (hp a)).mul (hp c)))
  
  have kC : ∀ (U : Set E2), IsOpen U → U ⊆ W → ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f U →
      (∀ x ∈ U, 0 < sgbGradSq2 h f x) → ContinuousOn (sgbLevelCurv2 h f) U := by
    intro U hU hUW f hf hpos
    have hsd : ContDiffOn ℝ ∞ (fun y => Real.sqrt (h y).det) U :=
      (hdetS.mono hUW).sqrt (fun y hy => hdetW y (hUW hy))
    have hsdne : ∀ y ∈ U, Real.sqrt (h y).det ≠ 0 :=
      fun y hy => (Real.sqrt_pos.2 (hpd y (hUW hy)).det_pos).ne'
    have hG : ContDiffOn ℝ ∞ (sgbGradSq2 h f) U := gS U hU hUW f hf
    have hsG : ContDiffOn ℝ ∞ (fun y => Real.sqrt (sgbGradSq2 h f y)) U :=
      hG.sqrt (fun y hy => (hpos y hy).ne')
    have hsGne : ∀ y ∈ U, Real.sqrt (sgbGradSq2 h f y) ≠ 0 :=
      fun y hy => (Real.sqrt_pos.2 (hpos y hy)).ne'
    have hp := pdS U hU f hf
    have hY : ∀ i : Fin 2, ContDiffOn ℝ ∞ (fun y => Real.sqrt (h y).det *
        (∑ a : Fin 2, (h y)⁻¹ i a * pd2 a f y) / Real.sqrt (sgbGradSq2 h f y)) U := by
      intro i
      have h1 : ContDiffOn ℝ ∞ (fun y => Real.sqrt (h y).det *
          (∑ a : Fin 2, (h y)⁻¹ i a * pd2 a f y)) U :=
        hsd.mul (ContDiffOn.sum (fun a _ => ((hinvW i a).mono hUW).mul (hp a)))
      exact h1.div hsG hsGne
    have hYd : ∀ i : Fin 2, ContinuousOn (fun x => pd2 i (fun y => Real.sqrt (h y).det *
        (∑ a : Fin 2, (h y)⁻¹ i a * pd2 a f y) / Real.sqrt (sgbGradSq2 h f y)) x) U := by
      intro i
      exact ((hY i).continuousOn_fderiv_of_isOpen hU (by simp)).clm_apply continuousOn_const
    have hinvd : ContinuousOn (fun x => (Real.sqrt (h x).det)⁻¹) U :=
      hsd.continuousOn.inv₀ hsdne
    show ContinuousOn (fun x => -((Real.sqrt (h x).det)⁻¹ * ∑ i : Fin 2,
      pd2 i (fun y => Real.sqrt (h y).det * (∑ a : Fin 2, (h y)⁻¹ i a * pd2 a f y) /
        Real.sqrt (sgbGradSq2 h f y)) x)) U
    exact (hinvd.mul (continuousOn_finset_sum _ (fun i _ => hYd i))).neg
  
  have logd : ∀ (F : E2 → ℝ) (x : E2) (ε : ℝ), DifferentiableAt ℝ F x → 0 < F x + ε →
      ∀ c : Fin 2, pd2 c (fun y => (1 / 2 : ℝ) * Real.log (F y + ε)) x =
        pd2 c F x / (2 * (F x + ε)) := by
    intro F x ε hF hpos c
    have h1 : HasFDerivAt (fun y => F y + ε) (fderiv ℝ F x) x := hF.hasFDerivAt.add_const ε
    have h2 := (h1.log hpos.ne').const_mul (1 / 2 : ℝ)
    simp only [pd2]
    rw [h2.fderiv]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    field_simp
  
  have alg : ∀ q g ε A : ℝ, 0 < g → 0 < ε → |q| / (2 * g ^ 2) ≤ A →
      |q / (2 * g) - q / (2 * (g + ε))| ≤ A * ε := by
    intro q g ε A hg hε hA
    have hgε : 0 < g + ε := by linarith
    have h2g : (2 * g) ≠ 0 := (mul_pos two_pos hg).ne'
    have h2gε : (2 * (g + ε)) ≠ 0 := (mul_pos two_pos hgε).ne'
    have hden : 0 < 2 * g * (g + ε) := mul_pos (mul_pos two_pos hg) hgε
    have hden2 : 0 < 2 * g ^ 2 := mul_pos two_pos (pow_pos hg 2)
    have e : q / (2 * g) - q / (2 * (g + ε)) = q * ε / (2 * g * (g + ε)) := by
      field_simp
      ring
    rw [e, abs_div, abs_mul, abs_of_pos hε, abs_of_pos hden]
    have h1 : |q| * ε / (2 * g * (g + ε)) ≤ |q| * ε / (2 * g ^ 2) := by
      apply div_le_div_of_nonneg_left (mul_nonneg (abs_nonneg q) hε.le) hden2
      nlinarith
    calc |q| * ε / (2 * g * (g + ε)) ≤ |q| * ε / (2 * g ^ 2) := h1
      _ = |q| / (2 * g ^ 2) * ε := by ring
      _ ≤ A * ε := mul_le_mul_of_nonneg_right hA hε.le
  
  obtain ⟨Q, hQ⟩ : ∃ Q : E2 → ℝ, Q = fun x => ∑ a : Fin 2, ∑ c : Fin 2,
      (h x)⁻¹ a c * pd2 a b x * pd2 c (sgbGradSq2 h w) x := ⟨_, rfl⟩
  have hpdb : ∀ a, ContDiffOn ℝ ∞ (pd2 a b) W := pdS W hW b hb
  have hGV : ContDiffOn ℝ ∞ (sgbGradSq2 h w) V := gS V hV hVW w hw
  have hGbW : ContDiffOn ℝ ∞ (sgbGradSq2 h b) W := gS W hW Set.Subset.rfl b hb
  have hGdiff : ∀ x ∈ V, DifferentiableAt ℝ (sgbGradSq2 h w) x :=
    fun x hx => (hGV.contDiffAt (hV.mem_nhds hx)).differentiableAt hne
  have hpdG : ∀ c, ContinuousOn (pd2 c (sgbGradSq2 h w)) V :=
    fun c => (pdS V hV _ hGV c).continuousOn
  have hQc : ContinuousOn Q V := by
    rw [hQ]
    exact continuousOn_finset_sum _ (fun a _ => continuousOn_finset_sum _ (fun c _ =>
      (((hinvW a c).mono hVW).continuousOn.mul ((hpdb a).continuousOn.mono hVW)).mul (hpdG c)))
  
  have hPε : ∀ x ∈ V, 0 < sgbGradSq2 h w x → ∀ ε : ℝ, 0 ≤ ε →
      ∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a b x *
        pd2 c (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y + ε)) x =
      Q x / (2 * (sgbGradSq2 h w x + ε)) := by
    intro x hx hG ε hε
    have hpos : 0 < sgbGradSq2 h w x + ε := by linarith
    simp only [logd _ x ε (hGdiff x hx) hpos, hQ]
    rw [Finset.sum_div]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    rw [Finset.sum_div]
    refine Finset.sum_congr rfl (fun c _ => ?_)
    ring
  have hP0 : ∀ x ∈ V, 0 < sgbGradSq2 h w x →
      ∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a b x *
        pd2 c (fun y => (1 / 2 : ℝ) * Real.log (sgbGradSq2 h w y)) x =
      Q x / (2 * sgbGradSq2 h w x) := by
    intro x hx hG
    have := hPε x hx hG 0 le_rfl
    simpa only [add_zero] using this
  
  obtain ⟨O, hOdef⟩ : ∃ O : Set E2,
      O = {x | x ∈ V ∧ 0 < sgbGradSq2 h w x ∧ 0 < sgbGradSq2 h b x} := ⟨_, rfl⟩
  have hOmem : ∀ x, x ∈ O ↔ (x ∈ V ∧ 0 < sgbGradSq2 h w x ∧ 0 < sgbGradSq2 h b x) := by
    intro x
    subst hOdef
    exact Iff.rfl
  have hOV : O ⊆ V := fun x hx => ((hOmem x).1 hx).1
  have hOW : O ⊆ W := hOV.trans hVW
  have hOo : IsOpen O := by
    have h1 : IsOpen (V ∩ sgbGradSq2 h w ⁻¹' Set.Ioi 0) :=
      hGV.continuousOn.isOpen_inter_preimage hV isOpen_Ioi
    have h2 : IsOpen ((V ∩ sgbGradSq2 h w ⁻¹' Set.Ioi 0) ∩ sgbGradSq2 h b ⁻¹' Set.Ioi 0) :=
      (hGbW.continuousOn.mono (fun x hx => hVW hx.1)).isOpen_inter_preimage h1 isOpen_Ioi
    have e : O = (V ∩ sgbGradSq2 h w ⁻¹' Set.Ioi 0) ∩ sgbGradSq2 h b ⁻¹' Set.Ioi 0 := by
      ext x
      rw [hOmem x]
      simp only [Set.mem_inter_iff, Set.mem_preimage, Set.mem_Ioi, and_assoc]
    rw [e]
    exact h2
  
  have hf0c : ContinuousOn (fun x => Real.sqrt (sgbGradSq2 h b x) * sgbLevelCurv2 h b x -
      Q x / (2 * sgbGradSq2 h w x)) O := by
    have hk : ContinuousOn (sgbLevelCurv2 h b) O :=
      kC O hOo hOW b (hb.mono hOW) (fun x hx => ((hOmem x).1 hx).2.2)
    have hs : ContinuousOn (fun x => Real.sqrt (sgbGradSq2 h b x)) O :=
      (hGbW.continuousOn.mono hOW).sqrt
    have hq : ContinuousOn (fun x => Q x / (2 * sgbGradSq2 h w x)) O :=
      (hQc.mono hOV).div (continuousOn_const.mul (hGV.continuousOn.mono hOV))
        (fun x hx => (mul_pos two_pos ((hOmem x).1 hx).2.1).ne')
    exact (hs.mul hk).sub hq
  
  have hbK : ContinuousOn b Kc := hb.continuousOn.mono hKW
  have hK0c : IsCompact (Kc ∩ b ⁻¹' Set.Icc 0 σ₀) :=
    hKc.of_isClosed_subset (hbK.preimage_isClosed_of_isClosed hKc.isClosed isClosed_Icc)
      Set.inter_subset_left
  have hK0V : Kc ∩ b ⁻¹' Set.Icc 0 σ₀ ⊆ V := fun x hx => hbV x (hKW hx.1) hx.2.1 hx.2.2
  obtain ⟨σ', hσ', hσ'P⟩ := sep (Kc ∩ b ⁻¹' Set.Icc 0 σ₀) hK0c b
    (fun x => |sgbGradSq2 h w x - sgbGradSq2 h b x| - (sgbGradSq2 h w x + sgbGradSq2 h b x))
    (hbK.mono Set.inter_subset_left)
    ((((hGV.continuousOn.mono hK0V).sub
        (hGbW.continuousOn.mono (fun x hx => hKW hx.1))).abs).sub
      ((hGV.continuousOn.mono hK0V).add
        (hGbW.continuousOn.mono (fun x hx => hKW hx.1)))) 0
    (fun x hx hbx => by
      have hxW := hKW hx.1
      have h1 := gpos w x (hpd x hxW) (hdw x hxW hbx)
      have h2 := gpos b x (hpd x hxW) (hreg x hxW hbx)
      have h3 : |sgbGradSq2 h w x - sgbGradSq2 h b x| <
          sgbGradSq2 h w x + sgbGradSq2 h b x :=
        abs_sub_lt_iff.mpr ⟨by linarith, by linarith⟩
      show |sgbGradSq2 h w x - sgbGradSq2 h b x| -
        (sgbGradSq2 h w x + sgbGradSq2 h b x) < 0
      linarith)
  have hσ₁ : 0 < min σ₀ (σ' / 2) := lt_min hσ₀ (half_pos hσ')
  have hK1c : IsCompact (Kc ∩ b ⁻¹' Set.Icc 0 (min σ₀ (σ' / 2))) :=
    hKc.of_isClosed_subset (hbK.preimage_isClosed_of_isClosed hKc.isClosed isClosed_Icc)
      Set.inter_subset_left
  have hK1O : Kc ∩ b ⁻¹' Set.Icc 0 (min σ₀ (σ' / 2)) ⊆ O := by
    intro x hx
    have hb0 : 0 ≤ b x := hx.2.1
    have hb1 : b x ≤ min σ₀ (σ' / 2) := hx.2.2
    have hbσ₀ : b x ≤ σ₀ := hb1.trans (min_le_left _ _)
    have hbσ' : b x < σ' := lt_of_le_of_lt (hb1.trans (min_le_right _ _)) (half_lt_self hσ')
    have hxV := hbV x (hKW hx.1) hb0 hbσ₀
    have hneg : |sgbGradSq2 h w x - sgbGradSq2 h b x| -
        (sgbGradSq2 h w x + sgbGradSq2 h b x) < 0 :=
      hσ'P x ⟨hx.1, hb0, hbσ₀⟩ hb0 hbσ'
    have e1 := le_abs_self (sgbGradSq2 h w x - sgbGradSq2 h b x)
    have e2 := neg_abs_le (sgbGradSq2 h w x - sgbGradSq2 h b x)
    exact (hOmem x).2 ⟨hxV, by linarith, by linarith⟩
  
  have hrc : ContinuousOn (fun x => |Q x| / (2 * sgbGradSq2 h w x ^ 2)) O :=
    (hQc.mono hOV).abs.div (continuousOn_const.mul ((hGV.continuousOn.mono hOV).pow 2))
      (fun x hx => (mul_pos two_pos (pow_pos ((hOmem x).1 hx).2.1 2)).ne')
  obtain ⟨C, hC⟩ := hK1c.exists_bound_of_continuousOn (hrc.mono hK1O)
  refine ⟨max C 0, le_max_right _ _, ?_⟩
  have hdiff : ∀ x ∈ Kc ∩ b ⁻¹' Set.Icc 0 (min σ₀ (σ' / 2)), ∀ ε : ℝ, 0 < ε →
      |Q x / (2 * sgbGradSq2 h w x) - Q x / (2 * (sgbGradSq2 h w x + ε))| ≤ max C 0 * ε := by
    intro x hx ε hε
    have hG : 0 < sgbGradSq2 h w x := ((hOmem x).1 (hK1O hx)).2.1
    have hr : |Q x| / (2 * sgbGradSq2 h w x ^ 2) ≤ max C 0 := by
      have h1 : ‖|Q x| / (2 * sgbGradSq2 h w x ^ 2)‖ ≤ C := hC x hx
      rw [Real.norm_eq_abs] at h1
      exact (le_abs_self _).trans (h1.trans (le_max_left _ _))
    exact alg (Q x) (sgbGradSq2 h w x) ε (max C 0) hG hε hr
  
  intro δ hδ
  obtain ⟨σ₂, hσ₂, hσ₂P⟩ := sep (Kc ∩ b ⁻¹' Set.Icc 0 (min σ₀ (σ' / 2))) hK1c b
    (fun x => |Real.sqrt (sgbGradSq2 h b x) * sgbLevelCurv2 h b x -
      Q x / (2 * sgbGradSq2 h w x)|)
    (hbK.mono Set.inter_subset_left) ((hf0c.mono hK1O).abs) δ
    (fun x hx hbx => by
      have hxO := hK1O hx
      have hxW := hKW hx.1
      have hG := ((hOmem x).1 hxO).2.1
      have h1 := hzero x hxW hbx
      rw [hP0 x ((hOmem x).1 hxO).1 hG] at h1
      show |Real.sqrt (sgbGradSq2 h b x) * sgbLevelCurv2 h b x -
        Q x / (2 * sgbGradSq2 h w x)| < δ
      rw [← h1, sub_self, abs_zero]
      exact hδ)
  refine ⟨min (min σ₀ (σ' / 2)) σ₂, lt_min hσ₁ hσ₂, fun ε hε x hx hbx hbσ => ?_⟩
  have hx1 : x ∈ Kc ∩ b ⁻¹' Set.Icc 0 (min σ₀ (σ' / 2)) :=
    ⟨hx, hbx.le, hbσ.le.trans (min_le_left _ _)⟩
  have hxO := hK1O hx1
  have hG := ((hOmem x).1 hxO).2.1
  have hxV := ((hOmem x).1 hxO).1
  have h1 : |Real.sqrt (sgbGradSq2 h b x) * sgbLevelCurv2 h b x -
      Q x / (2 * sgbGradSq2 h w x)| < δ :=
    hσ₂P x hx1 hbx.le (lt_of_lt_of_le hbσ (min_le_right _ _))
  have h2 := hdiff x hx1 ε hε
  rw [hPε x hxV hG ε hε.le]
  have h3 := abs_sub_le (Real.sqrt (sgbGradSq2 h b x) * sgbLevelCurv2 h b x)
    (Q x / (2 * sgbGradSq2 h w x)) (Q x / (2 * (sgbGradSq2 h w x + ε)))
  linarith

theorem pcgb_collar_error_small {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρnn : ∀ j q, 0 ≤ ρ j q)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (hρO : ∀ j q, q ∉ P.O j → ρ j q = 0)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (hRc : IsCompact {q | q ∈ S ∧ 0 ≤ b q})
    (hRconn : IsConnected {q | q ∈ S ∧ 0 ≤ b q})
    (hρ1 : ∀ q, q ∈ S → 0 ≤ b q → ∑ j, ρ j q = 1)
    (hreg : ∀ j, ∀ x ∈ P.W j, b (P.param j x) = 0 →
      fderiv ℝ (fun y => b (P.param j y)) x ≠ 0)
    (hbd : ∃ q ∈ S, b q = 0) (Gd : PcgbGreenData P b) :
    ∀ θ : ℝ, 0 < θ → ∃ ε₀ : ℝ, 0 < ε₀ ∧ ∀ ε : ℝ, 0 < ε → ε < ε₀ →
      ∃ s₀ : ℝ, 0 < s₀ ∧ ∀ s : ℝ, 0 < s → s < s₀ →
        pcgbCollarErr P ρ b Gd.w ε s ≤ θ :=
by
  
  obtain ⟨Cη, hCη0, hη⟩ : ∃ Cη : ℝ, 0 ≤ Cη ∧ ∀ t : ℝ,
      |deriv Real.smoothTransition t| ≤ Cη ∧
        (deriv Real.smoothTransition t ≠ 0 → 0 < t ∧ t < 1) := by
    have hvan : ∀ t : ℝ, ¬ (0 < t ∧ t < 1) → deriv Real.smoothTransition t = 0 := by
      intro t ht
      by_cases h0 : t ≤ 0
      · have hmin : IsLocalMin Real.smoothTransition t :=
          Filter.Eventually.of_forall (fun y => by
            rw [Real.smoothTransition.zero_of_nonpos h0]
            exact Real.smoothTransition.nonneg y)
        exact hmin.deriv_eq_zero
      · have h1 : 1 ≤ t := by
          by_contra h1
          exact ht ⟨lt_of_not_ge h0, lt_of_not_ge h1⟩
        have hmax : IsLocalMax Real.smoothTransition t :=
          Filter.Eventually.of_forall (fun y => by
            rw [Real.smoothTransition.one_of_one_le h1]
            exact Real.smoothTransition.le_one y)
        exact hmax.deriv_eq_zero
    have hc : Continuous (deriv Real.smoothTransition) :=
      (Real.smoothTransition.contDiff (n := 1)).continuous_deriv (by norm_num)
    obtain ⟨C, hC⟩ := (isCompact_Icc (a := (0 : ℝ)) (b := 1)).exists_bound_of_continuousOn
      hc.continuousOn
    refine ⟨max C 0, le_max_right _ _, fun t => ⟨?_, ?_⟩⟩
    · by_cases ht : 0 < t ∧ t < 1
      · have := hC t ⟨ht.1.le, ht.2.le⟩
        rw [Real.norm_eq_abs] at this
        exact this.trans (le_max_left _ _)
      · rw [hvan t ht, abs_zero]
        exact le_max_right _ _
    · intro hne
      by_contra ht
      exact hne (hvan t ht)
  
  have hband : ∀ (W : Set E2), IsOpen W → ∀ (K : Set E2), IsCompact K → K ⊆ W →
      ∀ (bb : E2 → ℝ), ContinuousOn bb W → ∀ (ρ' d f : E2 → ℝ),
      (∀ x ∈ W, x ∉ K → ρ' x = 0) → ∀ (R D Cb s : ℝ), 0 < s → 0 ≤ R → 0 ≤ D → 0 ≤ Cb →
      (∀ x ∈ K, |ρ' x * d x| ≤ R) → (∀ x ∈ K, 0 < bb x → bb x < s → |f x| ≤ D) →
      MeasureTheory.volume (K ∩ {x | 0 < bb x ∧ bb x < s}) ≤ ENNReal.ofReal (Cb * s) →
      |∫ x in W, ρ' x * (s⁻¹ * deriv Real.smoothTransition (bb x / s) * f x) * d x| ≤
        R * Cη * D * Cb := by
    intro W hW K hK hKW bb hbb ρ' d f hρ' R D Cb s hs hR0 hD0 hCb0 hR hD hvolB
    have hBdW : K ∩ {x | 0 < bb x ∧ bb x < s} ⊆ W := fun x hx => hKW hx.1
    have hBdeq : K ∩ {x | 0 < bb x ∧ bb x < s} = K ∩ (W ∩ bb ⁻¹' Set.Ioo 0 s) := by
      ext x
      constructor
      · rintro ⟨h1, h2, h3⟩
        exact ⟨h1, hKW h1, h2, h3⟩
      · rintro ⟨h1, -, h2, h3⟩
        exact ⟨h1, h2, h3⟩
    have hBdm : MeasurableSet (K ∩ {x | 0 < bb x ∧ bb x < s}) := by
      rw [hBdeq]
      exact hK.isClosed.measurableSet.inter
        (hbb.isOpen_inter_preimage hW isOpen_Ioo).measurableSet
    have hz : ∀ x ∈ W \ (K ∩ {x | 0 < bb x ∧ bb x < s}),
        ρ' x * (s⁻¹ * deriv Real.smoothTransition (bb x / s) * f x) * d x = 0 := by
      rintro x ⟨hxW, hxB⟩
      by_cases hxK : x ∈ K
      · have hnot : ¬ (0 < bb x ∧ bb x < s) := fun h => hxB ⟨hxK, h⟩
        have hη0 : deriv Real.smoothTransition (bb x / s) = 0 := by
          by_contra hne
          obtain ⟨h1, h2⟩ := (hη (bb x / s)).2 hne
          exact hnot ⟨(div_pos_iff_of_pos_right hs).mp h1, (div_lt_one hs).mp h2⟩
        rw [hη0]
        ring
      · rw [hρ' x hxW hxK]
        ring
    rw [MeasureTheory.setIntegral_eq_of_subset_of_forall_diff_eq_zero hW.measurableSet hBdW hz]
    have hvol : MeasureTheory.volume (K ∩ {x | 0 < bb x ∧ bb x < s}) < ⊤ :=
      lt_of_le_of_lt (MeasureTheory.measure_mono Set.inter_subset_left) hK.measure_lt_top
    have hbound : ∀ x ∈ K ∩ {x | 0 < bb x ∧ bb x < s},
        ‖ρ' x * (s⁻¹ * deriv Real.smoothTransition (bb x / s) * f x) * d x‖ ≤
          R * s⁻¹ * Cη * D := by
      rintro x ⟨hxK, h1, h2⟩
      rw [Real.norm_eq_abs]
      have e : ρ' x * (s⁻¹ * deriv Real.smoothTransition (bb x / s) * f x) * d x =
          (ρ' x * d x) * s⁻¹ * deriv Real.smoothTransition (bb x / s) * f x := by ring
      rw [e, abs_mul, abs_mul, abs_mul, abs_of_pos (inv_pos.mpr hs)]
      have a1 := hR x hxK
      have a2 := (hη (bb x / s)).1
      have a3 := hD x hxK h1 h2
      have hsi : 0 ≤ s⁻¹ := inv_nonneg.mpr hs.le
      exact mul_le_mul (mul_le_mul (mul_le_mul_of_nonneg_right a1 hsi) a2 (abs_nonneg _)
        (mul_nonneg hR0 hsi)) a3 (abs_nonneg _) (mul_nonneg (mul_nonneg hR0 hsi) hCη0)
    have hI := MeasureTheory.norm_setIntegral_le_of_norm_le_const hvol hbound
    have hreal : MeasureTheory.volume.real (K ∩ {x | 0 < bb x ∧ bb x < s}) ≤ Cb * s := by
      rw [MeasureTheory.measureReal_def]
      exact ENNReal.toReal_le_of_le_ofReal (mul_nonneg hCb0 hs.le) hvolB
    rw [← Real.norm_eq_abs]
    have hc0 : 0 ≤ R * s⁻¹ * Cη * D :=
      mul_nonneg (mul_nonneg (mul_nonneg hR0 (inv_nonneg.mpr hs.le)) hCη0) hD0
    calc _ ≤ R * s⁻¹ * Cη * D * MeasureTheory.volume.real (K ∩ {x | 0 < bb x ∧ bb x < s}) := hI
      _ ≤ R * s⁻¹ * Cη * D * (Cb * s) := mul_le_mul_of_nonneg_left hreal hc0
      _ = R * Cη * D * Cb := by field_simp
  
  have hVo : ∀ j, IsOpen (P.W j ∩ P.param j ⁻¹' (Gd.U \ {Gd.p₀})) := fun j =>
    (P.param_cont j).isOpen_inter_preimage (P.W_open j) (Gd.U_open.sdiff isClosed_singleton)
  have hcollar : ∀ j, ∀ x ∈ P.W j, 0 ≤ b (P.param j x) → b (P.param j x) ≤ Gd.r →
      x ∈ P.W j ∩ P.param j ⁻¹' (Gd.U \ {Gd.p₀}) := by
    intro j x hx h0 hr
    have hS : P.param j x ∈ P.O j ∩ S := by
      rw [← P.image_eq j]
      exact ⟨x, hx, rfl⟩
    refine ⟨hx, Gd.R_sub ⟨hS.2, h0⟩, ?_⟩
    intro heq
    have heq' : P.param j x = Gd.p₀ := heq
    have hpos := Gd.ball_pos Gd.x₀ (Metric.mem_closedBall_self Gd.r_pos.le)
    rw [Gd.param_x₀, ← heq'] at hpos
    linarith [Gd.r_pos]
  
  have hzero : ∀ j, ∀ x ∈ P.W j, b (P.param j x) = 0 →
      ∑ a : Fin 2, ∑ c : Fin 2, (P.h j x)⁻¹ a c * pd2 a (fun y => b (P.param j y)) x *
        pd2 c (fun y => (1 / 2 : ℝ) *
          Real.log (sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) y)) x =
      Real.sqrt (sgbGradSq2 (P.h j) (fun y => b (P.param j y)) x) *
        sgbLevelCurv2 (P.h j) (fun y => b (P.param j y)) x := by
    intro j x hx hbx
    have hxV := hcollar j x hx (le_of_eq hbx.symm) (by rw [hbx]; exact Gd.r_pos.le)
    have hbV : ContDiffOn ℝ ∞ (fun y => b (P.param j y))
        (P.W j ∩ P.param j ⁻¹' (Gd.U \ {Gd.p₀})) := (hb j).mono Set.inter_subset_left
    obtain ⟨lam, H1, H2⟩ := pcgb_levelset_second_order _ (hVo j) (fun y => b (P.param j y))
      (fun z => Gd.w (P.param j z)) hbV (Gd.smooth j) x hxV hbx (hreg j x hx hbx)
      (fun y hy hby => (Gd.dirichlet j y hy.1 hby).1)
    have hharm := Gd.harm j x hx (le_of_eq hbx.symm) hxV.2.2
    exact pcgb_boundary_curvature_algebra _ (hVo j) (P.h j)
      (fun a c => (P.h_smooth j a c).mono Set.inter_subset_left)
      (fun y hy => P.h_posDef j y hy.1) (fun y => b (P.param j y))
      (fun z => Gd.w (P.param j z)) hbV (Gd.smooth j) x hxV (hreg j x hx hbx)
      (Gd.dirichlet j x hx hbx).2 lam H1 H2 hharm
  
  have hs4 := fun j => pcgb_patch_collar_bound (P.W j) (P.W_open j) (Kc j) (hK j).1 (hK j).2
    (P.h j) (P.h_smooth j) (P.h_posDef j) (fun y => b (P.param j y))
    (fun z => Gd.w (P.param j z)) (hb j) _ (hVo j) Set.inter_subset_left Gd.r Gd.r_pos
    (hcollar j) (Gd.smooth j) (hreg j) (fun x hx hbx => (Gd.dirichlet j x hx hbx).2) (hzero j)
  choose A hA0 hAσ using hs4
  have hs3 := fun j => pcgb_thin_band_volume (P.W j) (P.W_open j) (Kc j) (hK j).1 (hK j).2
    (fun y => b (P.param j y)) (hb j) (hreg j)
  choose Cb s4 hs4pos hCb using hs3
  have hRbd : ∀ j, ∃ R : ℝ, ∀ x ∈ Kc j,
      ‖ρ j (P.param j x) * Real.sqrt (P.h j x).det‖ ≤ R := by
    intro j
    have hdet : ContinuousOn (fun x => (P.h j x).det) (P.W j) := by
      have e : (fun x => (P.h j x).det) =
          fun x => P.h j x 0 0 * P.h j x 1 1 - P.h j x 0 1 * P.h j x 1 0 := by
        funext x
        exact Matrix.det_fin_two _
      rw [e]
      exact ((P.h_smooth j 0 0).continuousOn.mul (P.h_smooth j 1 1).continuousOn).sub
        ((P.h_smooth j 0 1).continuousOn.mul (P.h_smooth j 1 0).continuousOn)
    have hc : ContinuousOn (fun x => ρ j (P.param j x) * Real.sqrt (P.h j x).det) (P.W j) :=
      (hρs j j).continuousOn.mul hdet.sqrt
    exact (hK j).1.exists_bound_of_continuousOn (hc.mono (hK j).2)
  choose Rb hRb using hRbd
  
  intro θ hθ
  have hB0 : ∀ j, 0 ≤ max (Rb j) 0 * Cη * max (Cb j) 0 := fun j =>
    mul_nonneg (mul_nonneg (le_max_right _ _) hCη0) (le_max_right _ _)
  have hSB0 : 0 ≤ ∑ j, max (Rb j) 0 * Cη * max (Cb j) 0 :=
    Finset.sum_nonneg (fun j _ => hB0 j)
  have hSA0 : 0 ≤ ∑ j, max (Rb j) 0 * Cη * max (Cb j) 0 * A j :=
    Finset.sum_nonneg (fun j _ => mul_nonneg (hB0 j) (hA0 j))
  refine ⟨θ / (2 * (∑ j, max (Rb j) 0 * Cη * max (Cb j) 0 * A j) + 2), by positivity, ?_⟩
  intro ε hε hεlt
  have hδ : 0 < θ / (2 * (∑ j, max (Rb j) 0 * Cη * max (Cb j) 0) + 2) := by positivity
  have hσj := fun j => hAσ j _ hδ
  choose σ hσpos hσ using hσj
  have hT0 : 0 ≤ ∑ j, (1 / σ j + 1 / s4 j) :=
    Finset.sum_nonneg (fun j _ => add_nonneg (one_div_pos.mpr (hσpos j)).le
      (one_div_pos.mpr (hs4pos j)).le)
  refine ⟨1 / (1 + ∑ j, (1 / σ j + 1 / s4 j)), by positivity, ?_⟩
  intro s hs hss
  have hterm : ∀ j, 1 / σ j + 1 / s4 j ≤ ∑ j, (1 / σ j + 1 / s4 j) := fun j =>
    Finset.single_le_sum (f := fun j => 1 / σ j + 1 / s4 j)
      (fun i _ => add_nonneg (one_div_pos.mpr (hσpos i)).le (one_div_pos.mpr (hs4pos i)).le)
      (Finset.mem_univ j)
  have hsσ : ∀ j, s < σ j := by
    intro j
    have h1 : 1 / σ j < 1 + ∑ j, (1 / σ j + 1 / s4 j) := by
      have := hterm j
      have := (one_div_pos.mpr (hs4pos j)).le
      linarith
    have h2 := (one_div_lt (hσpos j) (by positivity)).mp h1
    linarith
  have hss4 : ∀ j, s < s4 j := by
    intro j
    have h1 : 1 / s4 j < 1 + ∑ j, (1 / σ j + 1 / s4 j) := by
      have := hterm j
      have := (one_div_pos.mpr (hσpos j)).le
      linarith
    have h2 := (one_div_lt (hs4pos j) (by positivity)).mp h1
    linarith
  
  have hI : ∀ j, |∫ x in P.W j, ρ j (P.param j x) *
      (s⁻¹ * deriv Real.smoothTransition (b (P.param j x) / s) *
        (Real.sqrt (sgbGradSq2 (P.h j) (fun y => b (P.param j y)) x) *
            sgbLevelCurv2 (P.h j) (fun y => b (P.param j y)) x -
          ∑ a : Fin 2, ∑ c : Fin 2, (P.h j x)⁻¹ a c * pd2 a (fun y => b (P.param j y)) x *
            pd2 c (fun y => (1 / 2 : ℝ) *
              Real.log (sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) y + ε)) x)) *
      Real.sqrt (P.h j x).det| ≤
      max (Rb j) 0 * Cη * max (Cb j) 0 *
          (θ / (2 * (∑ j, max (Rb j) 0 * Cη * max (Cb j) 0) + 2)) +
        max (Rb j) 0 * Cη * max (Cb j) 0 * A j * ε := by
    intro j
    have hD0 : 0 ≤ θ / (2 * (∑ j, max (Rb j) 0 * Cη * max (Cb j) 0) + 2) + A j * ε :=
      add_nonneg hδ.le (mul_nonneg (hA0 j) hε.le)
    have key := hband (P.W j) (P.W_open j) (Kc j) (hK j).1 (hK j).2
      (fun y => b (P.param j y)) (hb j).continuousOn (fun x => ρ j (P.param j x))
      (fun x => Real.sqrt (P.h j x).det)
      (fun x => Real.sqrt (sgbGradSq2 (P.h j) (fun y => b (P.param j y)) x) *
            sgbLevelCurv2 (P.h j) (fun y => b (P.param j y)) x -
          ∑ a : Fin 2, ∑ c : Fin 2, (P.h j x)⁻¹ a c * pd2 a (fun y => b (P.param j y)) x *
            pd2 c (fun y => (1 / 2 : ℝ) *
              Real.log (sgbGradSq2 (P.h j) (fun z => Gd.w (P.param j z)) y + ε)) x)
      (hρK j) (max (Rb j) 0)
      (θ / (2 * (∑ j, max (Rb j) 0 * Cη * max (Cb j) 0) + 2) + A j * ε)
      (max (Cb j) 0) s hs (le_max_right _ _) hD0 (le_max_right _ _)
      (fun x hx => by
        have := hRb j x hx
        rw [Real.norm_eq_abs] at this
        exact this.trans (le_max_left _ _))
      (fun x hx h1 h2 => hσ j ε hε x hx h1 (h2.trans (hsσ j)))
      ((hCb j s hs (hss4 j)).trans
        (ENNReal.ofReal_le_ofReal (mul_le_mul_of_nonneg_right (le_max_left _ _) hs.le)))
    calc _ ≤ _ := key
      _ = _ := by ring
  
  have hδθ : (∑ j, max (Rb j) 0 * Cη * max (Cb j) 0) *
      (θ / (2 * (∑ j, max (Rb j) 0 * Cη * max (Cb j) 0) + 2)) ≤ θ / 2 := by
    rw [← mul_div_assoc, div_le_iff₀ (by positivity)]
    nlinarith
  have hεθ : (∑ j, max (Rb j) 0 * Cη * max (Cb j) 0 * A j) * ε ≤ θ / 2 := by
    have h1 := (lt_div_iff₀ (by positivity)).mp hεlt
    nlinarith
  unfold pcgbCollarErr eigWInt
  calc _ ≤ ∑ j, (max (Rb j) 0 * Cη * max (Cb j) 0 *
          (θ / (2 * (∑ j, max (Rb j) 0 * Cη * max (Cb j) 0) + 2)) +
        max (Rb j) 0 * Cη * max (Cb j) 0 * A j * ε) :=
        Finset.sum_le_sum (fun j _ => (le_abs_self _).trans (hI j))
    _ = (∑ j, max (Rb j) 0 * Cη * max (Cb j) 0) *
          (θ / (2 * (∑ j, max (Rb j) 0 * Cη * max (Cb j) 0) + 2)) +
        (∑ j, max (Rb j) 0 * Cη * max (Cb j) 0 * A j) * ε := by
        rw [Finset.sum_add_distrib, Finset.sum_mul, Finset.sum_mul]
    _ ≤ θ / 2 + θ / 2 := add_le_add hδθ hεθ
    _ = θ := by ring

theorem patched_collar_gauss_bonnet {X : Type*} [TopologicalSpace X] [T2Space X]
    (S : Set X) (P : EigPatchedSurface X S) (ρ : Fin P.n → X → ℝ) (Kc : Fin P.n → Set E2)
    (hρnn : ∀ j q, 0 ≤ ρ j q)
    (hρs : ∀ j k, ContDiffOn ℝ ∞ (fun x => ρ j (P.param k x)) (P.W k))
    (hK : ∀ j, IsCompact (Kc j) ∧ Kc j ⊆ P.W j)
    (hρK : ∀ j, ∀ x ∈ P.W j, x ∉ Kc j → ρ j (P.param j x) = 0)
    (hρO : ∀ j q, q ∉ P.O j → ρ j q = 0)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (hRc : IsCompact {q | q ∈ S ∧ 0 ≤ b q})
    (hRconn : IsConnected {q | q ∈ S ∧ 0 ≤ b q})
    (hρ1 : ∀ q, q ∈ S → 0 ≤ b q → ∑ j, ρ j q = 1)
    (hreg : ∀ j, ∀ x ∈ P.W j, b (P.param j x) = 0 →
      fderiv ℝ (fun y => b (P.param j y)) x ≠ 0)
    (hbd : ∃ q ∈ S, b q = 0) :
    ∀ θ : ℝ, 0 < θ → ∃ s₀ : ℝ, 0 < s₀ ∧ ∀ s : ℝ, 0 < s → s < s₀ →
      sgbCollarGB P ρ b s ≤ 2 * Real.pi + θ :=
by
  intro θ hθ
  obtain ⟨Gd⟩ := pcgb_green_function S P ρ Kc hρnn hρs hK hρK hρO b hb hRc hRconn hρ1 hreg hbd
  obtain ⟨s₁, hs₁, hmain⟩ := pcgb_main_inequality S P ρ Kc hρnn hρs hK hρK hρO b hb hRc hRconn
    hρ1 hreg hbd Gd
  obtain ⟨ε₁, hε₁, hdef⟩ := pcgb_defect_small S P ρ Kc hρnn hρs hK hρK hρO b hb hRc hRconn
    hρ1 hreg hbd Gd (θ / 2) (half_pos hθ)
  obtain ⟨ε₂, hε₂, hcol⟩ := pcgb_collar_error_small S P ρ Kc hρnn hρs hK hρK hρO b hb hRc hRconn
    hρ1 hreg hbd Gd (θ / 2) (half_pos hθ)
  have hm : 0 < min ε₁ ε₂ := lt_min hε₁ hε₂
  have hε0 : 0 < min ε₁ ε₂ / 2 := half_pos hm
  have hεlt : min ε₁ ε₂ / 2 < min ε₁ ε₂ := half_lt_self hm
  have hε1 : min ε₁ ε₂ / 2 < ε₁ := lt_of_lt_of_le hεlt (min_le_left _ _)
  have hε2 : min ε₁ ε₂ / 2 < ε₂ := lt_of_lt_of_le hεlt (min_le_right _ _)
  obtain ⟨s₂, hs₂, hcol'⟩ := hcol (min ε₁ ε₂ / 2) hε0 hε2
  refine ⟨min s₁ s₂, lt_min hs₁ hs₂, fun s hs hss => ?_⟩
  have h1 := hmain (min ε₁ ε₂ / 2) hε0 s hs (lt_of_lt_of_le hss (min_le_left _ _))
  have h2 := hdef (min ε₁ ε₂ / 2) hε0 hε1 s hs
  have h3 := hcol' s hs (lt_of_lt_of_le hss (min_le_right _ _))
  linarith

theorem pdiffeo_lift_smooth [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (P : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (f : E3 → ℝ) (hf : ContDiff ℝ ∞ f)
    (hfc : HasCompactSupport f) (hfs : tsupport f ⊆ P.source) :
    ∃ F : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ F ∧ (∀ y ∈ P.source, F (P y) = f y) ∧
      (∀ z, z ∉ P '' tsupport f → F z = 0) ∧ IsCompact (P '' tsupport f) ∧
      tsupport F ⊆ P '' tsupport f ∧ (∀ z, F z = 0 ∨ ∃ y ∈ P.source, F z = f y) :=
by
  classical
  let F : M → ℝ := P.target.indicator (fun z => f (P.toPartialEquiv.symm z))
  have hFin : ∀ z ∈ P.target, F z = f (P.toPartialEquiv.symm z) :=
    fun z hz => Set.indicator_of_mem hz _
  have hFout : ∀ z ∉ P.target, F z = 0 := fun z hz => Set.indicator_of_notMem hz _
  have hK : IsCompact (P '' tsupport f) :=
    hfc.isCompact.image_of_continuousOn (P.contMDiffOn.continuousOn.mono hfs)
  have hKc : IsClosed (P '' tsupport f) := hK.isClosed
  have hKt : P '' tsupport f ⊆ P.target := by
    rintro _ ⟨y, hy, rfl⟩
    exact P.toPartialEquiv.map_source (hfs hy)
  have hC2 : ∀ y ∈ P.source, F (P y) = f y := by
    intro y hy
    rw [hFin _ (P.toPartialEquiv.map_source hy)]
    exact congrArg f (P.toPartialEquiv.left_inv hy)
  have hC3 : ∀ z, z ∉ P '' tsupport f → F z = 0 := by
    intro z hz
    by_cases hzt : z ∈ P.target
    · rw [hFin z hzt]
      apply image_eq_zero_of_notMem_tsupport
      intro hy
      exact hz ⟨_, hy, P.toPartialEquiv.right_inv hzt⟩
    · exact hFout z hzt
  have hC5 : tsupport F ⊆ P '' tsupport f :=
    closure_minimal (Function.support_subset_iff'.mpr hC3) hKc
  have hC6 : ∀ z, F z = 0 ∨ ∃ y ∈ P.source, F z = f y := by
    intro z
    by_cases hzt : z ∈ P.target
    · exact Or.inr ⟨_, P.toPartialEquiv.map_target hzt, hFin z hzt⟩
    · exact Or.inl (hFout z hzt)
  have hC1 : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ F := by
    apply contMDiff_of_tsupport
    intro x hx
    have hxT : x ∈ P.target := hKt (hC5 hx)
    have hT : P.target ∈ 𝓝 x := P.open_target.mem_nhds hxT
    have hG : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (f ∘ P.invFun) P.target :=
      hf.contMDiff.comp_contMDiffOn P.contMDiffOn_invFun
    refine (hG.contMDiffAt hT).congr_of_eventuallyEq ?_
    filter_upwards [hT] with z hz
    exact hFin z hz
  exact ⟨F, hC1, hC2, hC3, hK, hC5, hC6⟩

theorem slice_side_bumps : ∀ L t : ℝ, ∃ ψ χ : E3 → ℝ, ContDiff ℝ ∞ ψ ∧ ContDiff ℝ ∞ χ ∧
    HasCompactSupport ψ ∧ HasCompactSupport χ ∧
    tsupport ψ ⊆ {y : E3 | |y 0 - t| ≤ 1 ∧ L ^ 2 - 7 / 4 ≤ y 1 ^ 2 + y 2 ^ 2 ∧
      y 1 ^ 2 + y 2 ^ 2 ≤ L ^ 2 + 1} ∧
    tsupport χ ⊆ {y : E3 | |y 0 - t| ≤ 1 ∧ L ^ 2 - 7 / 4 ≤ y 1 ^ 2 + y 2 ^ 2 ∧
      y 1 ^ 2 + y 2 ^ 2 ≤ L ^ 2 + 3 / 8} ∧
    (∀ y, 0 ≤ ψ y ∧ ψ y ≤ 1) ∧ (∀ y, 0 ≤ χ y) ∧
    (∀ a c : ℝ, L ^ 2 - 1 ≤ a ^ 2 + c ^ 2 → a ^ 2 + c ^ 2 ≤ L ^ 2 + 1 / 2 → ψ (cylPt t a c) = 1) ∧
    (∀ a c : ℝ, L ^ 2 - 3 / 2 ≤ a ^ 2 + c ^ 2 → a ^ 2 + c ^ 2 ≤ L ^ 2 + 1 / 4 →
      χ (cylPt t a c) = 1) :=
by
  intro L t
  have hc : ∀ i : Fin 3, ContDiff ℝ ∞ (fun y : E3 => y i) := fun i => contDiff_piLp_apply 2
  have hcont : ∀ i : Fin 3, Continuous (fun y : E3 => y i) := fun i => (hc i).continuous
  have hη : ContDiff ℝ ∞ Real.smoothTransition := Real.smoothTransition.contDiff
  have hnsq : ∀ x : E3, ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 + x 2 ^ 2 := by
    intro x
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  have hcyl : ∀ a b : ℝ, (cylPt t a b) 0 = t ∧ (cylPt t a b) 1 = a ∧ (cylPt t a b) 2 = b := by
    intro a b
    simp [cylPt, EuclideanSpace.single_apply]
  have hpos : ∀ x : ℝ, Real.smoothTransition x ≠ 0 → 0 < x := by
    intro x hx
    by_contra h
    push_neg at h
    exact hx (Real.smoothTransition.zero_of_nonpos h)
  have hclosed : ∀ c : ℝ, IsClosed {y : E3 | |y 0 - t| ≤ 1 ∧ L ^ 2 - 7 / 4 ≤ y 1 ^ 2 + y 2 ^ 2 ∧
      y 1 ^ 2 + y 2 ^ 2 ≤ L ^ 2 + c} := by
    intro c
    exact (isClosed_le ((hcont 0).sub continuous_const).abs continuous_const).inter
      ((isClosed_le continuous_const (((hcont 1).pow 2).add ((hcont 2).pow 2))).inter
        (isClosed_le (((hcont 1).pow 2).add ((hcont 2).pow 2)) continuous_const))
  have hbdd : ∀ c : ℝ, c ≤ 1 → {y : E3 | |y 0 - t| ≤ 1 ∧ L ^ 2 - 7 / 4 ≤ y 1 ^ 2 + y 2 ^ 2 ∧
      y 1 ^ 2 + y 2 ^ 2 ≤ L ^ 2 + c} ⊆ Metric.closedBall (0 : E3) (|t| + |L| + 2) := by
    intro c hc1 y hy
    obtain ⟨h1, h2, h3⟩ := hy
    rw [mem_closedBall_zero_iff]
    have h0 : |y 0| ≤ |t| + 1 := by
      have := abs_sub_abs_le_abs_sub (y 0) t
      linarith
    have hy0 : y 0 ^ 2 ≤ (|t| + 1) ^ 2 := by
      rw [← sq_abs (y 0)]
      exact pow_le_pow_left₀ (abs_nonneg _) h0 2
    have hL : L ^ 2 = |L| ^ 2 := (sq_abs L).symm
    have hn := hnsq y
    have hB : 0 ≤ |t| + |L| + 2 := by positivity
    have ht0 := abs_nonneg t
    have hL0 := abs_nonneg L
    have hsq : ‖y‖ ^ 2 ≤ (|t| + |L| + 2) ^ 2 := by nlinarith [mul_nonneg ht0 hL0]
    by_contra hcon
    push_neg at hcon
    nlinarith [norm_nonneg y]
  have hr : ContDiff ℝ ∞ (fun y : E3 => y 1 ^ 2 + y 2 ^ 2) := ((hc 1).pow 2).add ((hc 2).pow 2)
  have hd : ContDiff ℝ ∞ (fun y : E3 => 2 - 2 * (y 0 - t) ^ 2) :=
    contDiff_const.sub (contDiff_const.mul (((hc 0).sub contDiff_const).pow 2))
  obtain ⟨ψ, hψ⟩ : ∃ ψ : E3 → ℝ, ψ = fun y =>
      Real.smoothTransition (4 / 3 * (y 1 ^ 2 + y 2 ^ 2 - L ^ 2 + 7 / 4)) *
      Real.smoothTransition (2 * (L ^ 2 + 1 - (y 1 ^ 2 + y 2 ^ 2))) *
      Real.smoothTransition (2 - 2 * (y 0 - t) ^ 2) := ⟨_, rfl⟩
  obtain ⟨χ, hχ⟩ : ∃ χ : E3 → ℝ, χ = fun y =>
      Real.smoothTransition (4 * (y 1 ^ 2 + y 2 ^ 2 - L ^ 2 + 7 / 4)) *
      Real.smoothTransition (8 * (L ^ 2 + 3 / 8 - (y 1 ^ 2 + y 2 ^ 2))) *
      Real.smoothTransition (2 - 2 * (y 0 - t) ^ 2) := ⟨_, rfl⟩
  have hψS : tsupport ψ ⊆ {y : E3 | |y 0 - t| ≤ 1 ∧ L ^ 2 - 7 / 4 ≤ y 1 ^ 2 + y 2 ^ 2 ∧
      y 1 ^ 2 + y 2 ^ 2 ≤ L ^ 2 + 1} := by
    refine closure_minimal ?_ (hclosed 1)
    intro y hy
    rw [Function.mem_support, hψ] at hy
    obtain ⟨hAB, hC⟩ := mul_ne_zero_iff.mp hy
    obtain ⟨hA, hB⟩ := mul_ne_zero_iff.mp hAB
    have pA := hpos _ hA
    have pB := hpos _ hB
    have pC := hpos _ hC
    exact ⟨abs_le.mpr ⟨by nlinarith, by nlinarith⟩, by linarith, by linarith⟩
  have hχS : tsupport χ ⊆ {y : E3 | |y 0 - t| ≤ 1 ∧ L ^ 2 - 7 / 4 ≤ y 1 ^ 2 + y 2 ^ 2 ∧
      y 1 ^ 2 + y 2 ^ 2 ≤ L ^ 2 + 3 / 8} := by
    refine closure_minimal ?_ (hclosed (3 / 8))
    intro y hy
    rw [Function.mem_support, hχ] at hy
    obtain ⟨hAB, hC⟩ := mul_ne_zero_iff.mp hy
    obtain ⟨hA, hB⟩ := mul_ne_zero_iff.mp hAB
    have pA := hpos _ hA
    have pB := hpos _ hB
    have pC := hpos _ hC
    exact ⟨abs_le.mpr ⟨by nlinarith, by nlinarith⟩, by linarith, by linarith⟩
  refine ⟨ψ, χ, ?_, ?_, ?_, ?_, hψS, hχS, ?_, ?_, ?_, ?_⟩
  · rw [hψ]
    exact ((hη.comp (contDiff_const.mul ((hr.sub contDiff_const).add contDiff_const))).mul
      (hη.comp (contDiff_const.mul (contDiff_const.sub hr)))).mul (hη.comp hd)
  · rw [hχ]
    exact ((hη.comp (contDiff_const.mul ((hr.sub contDiff_const).add contDiff_const))).mul
      (hη.comp (contDiff_const.mul (contDiff_const.sub hr)))).mul (hη.comp hd)
  · exact (isCompact_closedBall (0 : E3) (|t| + |L| + 2)).of_isClosed_subset
      (isClosed_tsupport ψ) (hψS.trans (hbdd 1 le_rfl))
  · exact (isCompact_closedBall (0 : E3) (|t| + |L| + 2)).of_isClosed_subset
      (isClosed_tsupport χ) (hχS.trans (hbdd (3 / 8) (by norm_num)))
  · intro y
    rw [hψ]
    have a1 := Real.smoothTransition.nonneg (4 / 3 * (y 1 ^ 2 + y 2 ^ 2 - L ^ 2 + 7 / 4))
    have a2 := Real.smoothTransition.nonneg (2 * (L ^ 2 + 1 - (y 1 ^ 2 + y 2 ^ 2)))
    have a3 := Real.smoothTransition.nonneg (2 - 2 * (y 0 - t) ^ 2)
    have b1 := Real.smoothTransition.le_one (4 / 3 * (y 1 ^ 2 + y 2 ^ 2 - L ^ 2 + 7 / 4))
    have b2 := Real.smoothTransition.le_one (2 * (L ^ 2 + 1 - (y 1 ^ 2 + y 2 ^ 2)))
    have b3 := Real.smoothTransition.le_one (2 - 2 * (y 0 - t) ^ 2)
    refine ⟨mul_nonneg (mul_nonneg a1 a2) a3, ?_⟩
    exact mul_le_one₀ (mul_le_one₀ b1 a2 b2) a3 b3
  · intro y
    rw [hχ]
    exact mul_nonneg (mul_nonneg (Real.smoothTransition.nonneg _)
      (Real.smoothTransition.nonneg _)) (Real.smoothTransition.nonneg _)
  · intro a c h1 h2
    obtain ⟨e0, e1, e2⟩ := hcyl a c
    have k1 : Real.smoothTransition (4 / 3 * (a ^ 2 + c ^ 2 - L ^ 2 + 7 / 4)) = 1 :=
      Real.smoothTransition.one_of_one_le (by linarith)
    have k2 : Real.smoothTransition (2 * (L ^ 2 + 1 - (a ^ 2 + c ^ 2))) = 1 :=
      Real.smoothTransition.one_of_one_le (by linarith)
    have k3 : Real.smoothTransition (2 - 2 * (t - t) ^ 2) = 1 :=
      Real.smoothTransition.one_of_one_le (by norm_num)
    rw [hψ]
    simp only [e0, e1, e2, k1, k2, k3, mul_one]
  · intro a c h1 h2
    obtain ⟨e0, e1, e2⟩ := hcyl a c
    have k1 : Real.smoothTransition (4 * (a ^ 2 + c ^ 2 - L ^ 2 + 7 / 4)) = 1 :=
      Real.smoothTransition.one_of_one_le (by linarith)
    have k2 : Real.smoothTransition (8 * (L ^ 2 + 3 / 8 - (a ^ 2 + c ^ 2))) = 1 :=
      Real.smoothTransition.one_of_one_le (by linarith)
    have k3 : Real.smoothTransition (2 - 2 * (t - t) ^ 2) = 1 :=
      Real.smoothTransition.one_of_one_le (by norm_num)
    rw [hχ]
    simp only [e0, e1, e2, k1, k2, k3, mul_one]

theorem pullback_metric_side_regular [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (Φ : EndChart M) (X Y : E3 → E3) (q R₀ R₁ C : ℝ) (hXY : CoordChange X Y q R₀ R₁ C) :
    (∀ a c : Fin 3, ContDiffOn ℝ ∞ (fun y => pullbackMetric (g.coeff Φ.Φ) Y y a c)
      {y : E3 | R₁ < ‖y‖}) ∧
    (∀ (y : E3) (a c : Fin 3),
      pullbackMetric (g.coeff Φ.Φ) Y y a c = pullbackMetric (g.coeff Φ.Φ) Y y c a) ∧
    (∀ y : E3, R₁ < ‖y‖ → (pullbackMetric (g.coeff Φ.Φ) Y y).PosDef) :=
by
  have hcoeffS : ∀ (Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞) (i j : Fin 3),
      ContDiffOn ℝ ∞ (fun x => g.coeff Φ x i j) Φ.source := by
    intro Φ i j
    have hw : ∀ w : E3, w = ∑ a : Fin 3, w a • e a := by
      intro w
      ext k
      simp [e, Pi.single_apply]
    have hexp : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (D : E3 →L[ℝ] E3) (w1 w2 : E3),
        B (D w1) (D w2) = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
      intro B D w1 w2
      calc B (D w1) (D w2)
          = B (D (∑ a : Fin 3, w1 a • e a)) (D (∑ b : Fin 3, w2 b • e b)) := by
            rw [← hw w1, ← hw w2]
        _ = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
            simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
              ContinuousLinearMap.smul_apply, smul_eq_mul, Finset.mul_sum]
            conv_lhs => rw [Finset.sum_comm]
            refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
            ring
    have hΦ : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ Φ Φ.source := Φ.contMDiffOn_toFun
    apply contDiffOn_of_locally_contDiffOn
    intro x0 hx0
    have hu : IsOpen (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) :=
      hΦ.continuousOn.isOpen_inter_preimage Φ.open_source (chartAt E3 (Φ x0)).open_source
    have hF : ContDiffOn ℝ ∞ (fun y => chartAt E3 (Φ x0) (Φ y))
        (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) := by
      have h1 := (contMDiffOn_iff_target.mp hΦ).2 (Φ x0)
      rw [extChartAt_source] at h1
      have h2 := contMDiffOn_iff_contDiffOn.mp h1
      simpa [extChartAt_coe, Function.comp_def] using h2
    have hmaps : Set.MapsTo (fun y => chartAt E3 (Φ x0) (Φ y))
        (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) (chartAt E3 (Φ x0)).target :=
      fun y hy => (chartAt E3 (Φ x0)).map_source hy.2
    have hD : ContDiffOn ℝ ∞ (fderiv ℝ (fun y => chartAt E3 (Φ x0) (Φ y)))
        (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hu).mp hF).2
    have hcoord : ∀ k a : Fin 3, ContDiffOn ℝ ∞
        (fun x => (fderiv ℝ (fun y => chartAt E3 (Φ x0) (Φ y)) x (e k)) a)
        (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) := by
      intro k a
      have h2 : ContDiffOn ℝ ∞ (fun x => fderiv ℝ (fun y => chartAt E3 (Φ x0) (Φ y)) x (e k))
          (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) := hD.clm_apply contDiffOn_const
      exact (EuclideanSpace.proj a : E3 →L[ℝ] ℝ).contDiff.comp_contDiffOn h2
    have hG : ∀ a b : Fin 3, ContDiffOn ℝ ∞
        (fun x => g.coeff (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x)) a b)
        (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) :=
      fun a b => (g.smooth (Φ x0) a b).comp hF hmaps
    have hR : ContDiffOn ℝ ∞ (fun x => ∑ a : Fin 3, ∑ b : Fin 3,
        (fderiv ℝ (fun y => chartAt E3 (Φ x0) (Φ y)) x (e i)) a *
        (fderiv ℝ (fun y => chartAt E3 (Φ x0) (Φ y)) x (e j)) b *
        g.coeff (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x)) a b)
        (Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source) := by
      apply ContDiffOn.sum
      intro a _
      apply ContDiffOn.sum
      intro b _
      exact ((hcoord i a).mul (hcoord j b)).mul (hG a b)
    have key : ∀ x ∈ Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source,
        g.coeff Φ x i j = ∑ a : Fin 3, ∑ b : Fin 3,
        (fderiv ℝ (fun y => chartAt E3 (Φ x0) (Φ y)) x (e i)) a *
        (fderiv ℝ (fun y => chartAt E3 (Φ x0) (Φ y)) x (e j)) b *
        g.coeff (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x)) a b := by
      intro x hx
      have hcont : ContinuousAt Φ x :=
        hΦ.continuousOn.continuousAt (Φ.open_source.mem_nhds hx.1)
      have hFdiff : DifferentiableAt ℝ (fun y => chartAt E3 (Φ x0) (Φ y)) x :=
        (hF.contDiffAt (hu.mem_nhds hx)).differentiableAt (by simp)
      have hFx : chartAt E3 (Φ x0) (Φ x) ∈ (chartAt E3 (Φ x0)).target := hmaps hx
      have hev : (Φ : E3 → M) =ᶠ[𝓝 x]
          ((chartAt E3 (Φ x0)).symm ∘ fun y => chartAt E3 (Φ x0) (Φ y)) := by
        have hmem : (Φ : E3 → M) ⁻¹' (chartAt E3 (Φ x0)).source ∈ 𝓝 x :=
          hcont.preimage_mem_nhds ((chartAt E3 (Φ x0)).open_source.mem_nhds hx.2)
        filter_upwards [hmem] with y hy
        simp only [Function.comp_apply]
        exact ((chartAt E3 (Φ x0)).left_inv hy).symm
      have hg : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x0)).symm
          (chartAt E3 (Φ x0) (Φ x)) :=
        ((contMDiffOn_chart_symm (n := ∞)).contMDiffAt
          ((chartAt E3 (Φ x0)).open_target.mem_nhds hFx)).mdifferentiableAt (by simp)
      have hfac : ∀ v : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ x v =
          mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x))
            (fderiv ℝ (fun y => chartAt E3 (Φ x0) (Φ y)) x v) := by
        intro v
        rw [hev.mfderiv_eq, mfderiv_comp x hg hFdiff.mdifferentiableAt, mfderiv_eq_fderiv]
        rfl
      have hpt : (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x)) = Φ x :=
        (chartAt E3 (Φ x0)).left_inv hx.2
      have h1 : g.coeff Φ x i j = g.g (Φ x) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ x (e i))
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ x (e j)) := rfl
      have h2 : ∀ a b : Fin 3,
          g.coeff (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x)) a b =
          g.g (Φ x)
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x)) (e a))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x)) (e b)) := by
        intro a b
        show g.g ((chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x))) _ _ = _
        rw [show g.g ((chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x))) = g.g (Φ x) from
          congrArg g.g hpt]
      rw [h1, hfac, hfac]
      simp only [h2]
      exact hexp (g.g (Φ x))
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (Φ x0)).symm (chartAt E3 (Φ x0) (Φ x)))
        _ _
    refine ⟨Φ.source ∩ Φ ⁻¹' (chartAt E3 (Φ x0)).source, hu,
      ⟨hx0, mem_chart_source E3 (Φ x0)⟩, ?_⟩
    rw [Set.inter_eq_right.mpr Set.inter_subset_left]
    exact hR.congr key
  have hw : ∀ w : E3, w = ∑ a : Fin 3, w a • e a := by
    intro w
    ext k
    simp [e, Pi.single_apply]
  have hexp : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (D : E3 →L[ℝ] E3) (w1 w2 : E3),
      B (D w1) (D w2) = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
    intro B D w1 w2
    calc B (D w1) (D w2)
        = B (D (∑ a : Fin 3, w1 a • e a)) (D (∑ b : Fin 3, w2 b • e b)) := by
          rw [← hw w1, ← hw w2]
      _ = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
          simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
            ContinuousLinearMap.smul_apply, smul_eq_mul, Finset.mul_sum]
          conv_lhs => rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
          ring
  set G := pullbackMetric (g.coeff Φ.Φ) Y with hGdef
  obtain ⟨hR0, hR01, hC, hXs, hYs, hinv, hinj, hbd⟩ := hXY
  have hU : IsOpen {x : E3 | R₁ < ‖x‖} := isOpen_lt continuous_const continuous_norm
  have hV : IsOpen {y : E3 | R₀ < ‖y‖} := isOpen_lt continuous_const continuous_norm
  have hne : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  have hmapsW : Set.MapsTo Y {x : E3 | R₁ < ‖x‖} {y : E3 | 1 < ‖y‖} := by
    intro x hx
    have h1 := (hinv x hx).1
    show (1 : ℝ) < ‖Y x‖
    linarith
  have hsmooth : ∀ i j : Fin 3,
      ContDiffOn ℝ ∞ (fun y => g.coeff Φ.Φ y i j) {y : E3 | 1 < ‖y‖} := by
    intro i j
    have h := hcoeffS Φ.Φ i j
    rwa [Φ.source_eq] at h
  have hcoordF : ∀ (F : E3 → E3) (S : Set E3), ContDiffOn ℝ ∞ F S →
      ∀ d : Fin 3, ContDiffOn ℝ ∞ (fun w => F w d) S := by
    intro F S hF d
    exact (EuclideanSpace.proj d : E3 →L[ℝ] ℝ).contDiff.comp_contDiffOn hF
  have hfd : ∀ a i : Fin 3, ContDiffOn ℝ ∞ (fun z => (fderiv ℝ Y z (e a)) i)
      {x : E3 | R₁ < ‖x‖} := by
    intro a i
    have h1 : ContDiffOn ℝ ∞ (fderiv ℝ Y) {x : E3 | R₁ < ‖x‖} := hYs.fderiv_of_isOpen hU le_rfl
    have h2 : ContDiffOn ℝ ∞ (fun z => fderiv ℝ Y z (e a)) {x : E3 | R₁ < ‖x‖} :=
      h1.clm_apply contDiffOn_const
    exact hcoordF _ _ h2 i
  have hGs : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => G x a b) {x : E3 | R₁ < ‖x‖} := by
    intro a b
    have hGY : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => g.coeff Φ.Φ (Y x) i j)
        {x : E3 | R₁ < ‖x‖} := fun i j => (hsmooth i j).comp hYs hmapsW
    show ContDiffOn ℝ ∞ (fun x => ∑ i : Fin 3, ∑ j : Fin 3,
      (fderiv ℝ Y x (e a)) i * g.coeff Φ.Φ (Y x) i j * (fderiv ℝ Y x (e b)) j) _
    exact ContDiffOn.sum (fun i _ => ContDiffOn.sum (fun j _ =>
      ((hfd a i).mul (hGY i j)).mul (hfd b j)))
  have hsymmG : ∀ (y : E3) (a c : Fin 3), G y a c = G y c a := by
    intro y a c
    show ∑ i : Fin 3, ∑ j : Fin 3,
        (fderiv ℝ Y y (e a)) i * g.coeff Φ.Φ (Y y) i j * (fderiv ℝ Y y (e c)) j =
      ∑ i : Fin 3, ∑ j : Fin 3,
        (fderiv ℝ Y y (e c)) i * g.coeff Φ.Φ (Y y) i j * (fderiv ℝ Y y (e a)) j
    conv_lhs => rw [Finset.sum_comm]
    refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
    have hs : g.coeff Φ.Φ (Y y) j i = g.coeff Φ.Φ (Y y) i j := by
      simp only [RiemannianMetric3.coeff, coeffMatrix]
      exact g.symm _ _ _
    rw [hs]
    ring
  refine ⟨hGs, hsymmG, fun x hx => ?_⟩
  have hYx : Y x ∈ Φ.Φ.source := by rw [Φ.source_eq]; exact hmapsW hx
  have hloc := PartialDiffeomorph.isLocalDiffeomorphAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ Φ.Φ hYx
  have hDinj : ∀ w : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ.Φ (Y x) w = 0 → w = 0 := by
    intro w hw0
    have hL : ∀ u : E3, (hloc.mfderivToContinuousLinearEquiv hne) u =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ.Φ (Y x) u := by
      intro u
      rw [← hloc.mfderivToContinuousLinearEquiv_coe hne]
      rfl
    apply (hloc.mfderivToContinuousLinearEquiv hne).injective
    rw [hL, hw0, map_zero]
  have hYd : DifferentiableAt ℝ Y x := (hYs.contDiffAt (hU.mem_nhds hx)).differentiableAt hne
  have hXd : DifferentiableAt ℝ X (Y x) :=
    (hXs.contDiffAt (hV.mem_nhds (hinv x hx).1)).differentiableAt hne
  have hc2 : (fderiv ℝ X (Y x)).comp (fderiv ℝ Y x) = ContinuousLinearMap.id ℝ E3 := by
    rw [← fderiv_comp x hXd hYd]
    have hev : X ∘ Y =ᶠ[𝓝 x] id := by
      filter_upwards [hU.mem_nhds hx] with z hz
      exact (hinv z hz).2
    rw [hev.fderiv_eq, fderiv_id]
  have hJinj : ∀ v : E3, fderiv ℝ Y x v = 0 → v = 0 := by
    intro v hv
    have h := congrArg (fun T : E3 →L[ℝ] E3 => T v) hc2
    simp only [ContinuousLinearMap.comp_apply, ContinuousLinearMap.id_apply, hv,
      map_zero] at h
    exact h.symm
  have hGform : ∀ a c : Fin 3, G x a c = g.g (Φ.Φ (Y x))
      (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ.Φ (Y x) (fderiv ℝ Y x (e a)))
      (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ.Φ (Y x) (fderiv ℝ Y x (e c))) := by
    intro a c
    have hh := hexp (g.g (Φ.Φ (Y x))) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ.Φ (Y x))
      (fderiv ℝ Y x (e a)) (fderiv ℝ Y x (e c))
    refine Eq.trans ?_ hh.symm
    show ∑ i : Fin 3, ∑ j : Fin 3,
      (fderiv ℝ Y x (e a)) i * g.coeff Φ.Φ (Y x) i j * (fderiv ℝ Y x (e c)) j = _
    refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
    simp only [RiemannianMetric3.coeff, coeffMatrix]
    exact mul_right_comm _ _ _
  apply Matrix.PosDef.of_dotProduct_mulVec_pos
  · apply Matrix.IsHermitian.ext
    intro i j
    simp only [star_trivial]
    exact hsymmG x j i
  · intro w hw0
    set v : E3 := w 0 • e 0 + w 1 • e 1 + w 2 • e 2 with hvdef
    have hv0 : v ≠ 0 := by
      intro h0
      apply hw0
      have h0' := congrArg (fun u : E3 => u 0) h0
      have h1' := congrArg (fun u : E3 => u 1) h0
      have h2' := congrArg (fun u : E3 => u 2) h0
      simp [v, e, EuclideanSpace.single_apply] at h0' h1' h2'
      funext k
      fin_cases k
      · simpa using h0'
      · simpa using h1'
      · simpa using h2'
    have hpos := g.posDef (Φ.Φ (Y x)) _ (fun h => hv0 (hJinj _ (hDinj _ h)))
    have key : star w ⬝ᵥ (G x).mulVec w =
        g.g (Φ.Φ (Y x)) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ.Φ (Y x) (fderiv ℝ Y x v))
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) Φ.Φ (Y x) (fderiv ℝ Y x v)) := by
      simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_three, Pi.star_apply, star_trivial,
        hGform, hvdef, map_add, map_smul, ContinuousLinearMap.add_apply,
        ContinuousLinearMap.smul_apply, smul_eq_mul]
      ring
    rw [key]
    exact hpos

theorem ssd_side_patch_chart [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (Φ : EndChart M) (u : M → ℝ) (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u) (X Y : E3 → E3)
    (q R₀ R₁ C t : ℝ) (hXY : CoordChange X Y q R₀ R₁ C)
    (hu1 : ∀ x : E3, R₁ < ‖x‖ → u (sternPsi Φ Y x) = x 0)
    (hch : ∀ x : E3, R₁ < ‖x‖ → g.coeff (sternPsi Φ Y) x = pullbackMetric (g.coeff Φ.Φ) Y x)
    (hpd : ∀ x : E2, R₁ < ‖cylPt t (x 0) (x 1)‖ →
      (sgbSideMetric (pullbackMetric (g.coeff Φ.Φ) Y) t x).PosDef) :
    ContMDiffOn 𝓘(ℝ, E2) 𝓘(ℝ, E3) ∞ (fun x : E2 => sternPsi Φ Y (cylPt t (x 0) (x 1)))
      {x : E2 | R₁ < ‖cylPt t (x 0) (x 1)‖} ∧
    (∀ x : E2, R₁ < ‖cylPt t (x 0) (x 1)‖ →
      mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u (sternPsi Φ Y (cylPt t (x 0) (x 1))) ≠ 0) ∧
    ∀ q' : M, ContDiffOn ℝ ∞ (fun x : E2 => chartAt E3 q' (sternPsi Φ Y (cylPt t (x 0) (x 1))))
      ({x : E2 | R₁ < ‖cylPt t (x 0) (x 1)‖} ∩
        (fun x : E2 => sternPsi Φ Y (cylPt t (x 0) (x 1))) ⁻¹' (chartAt E3 q').source) ∧
      ∀ x : E2, R₁ < ‖cylPt t (x 0) (x 1)‖ →
        sternPsi Φ Y (cylPt t (x 0) (x 1)) ∈ (chartAt E3 q').source →
        Function.Injective
          (fderiv ℝ (fun y : E2 => chartAt E3 q' (sternPsi Φ Y (cylPt t (y 0) (y 1)))) x) ∧
        sgbSideMetric (pullbackMetric (g.coeff Φ.Φ) Y) t x =
          pullMetric2 (g.coeff (chartAt E3 q').symm)
            (fun y : E2 => chartAt E3 q' (sternPsi Φ Y (cylPt t (y 0) (y 1)))) x :=
by
  classical
  have hne : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  have hD : IsOpen {y : E3 | R₁ < ‖y‖} := isOpen_lt continuous_const continuous_norm
  obtain ⟨hR0, hR01, hC, hXs, hYs, hinv, hinj, hbd⟩ := hXY
  
  have hw : ∀ w : E3, w = ∑ a : Fin 3, w a • e a := by
    intro w
    ext k
    simp [e, Pi.single_apply]
  have hexp : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (D : E3 →L[ℝ] E3) (w1 w2 : E3),
      B (D w1) (D w2) = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
    intro B D w1 w2
    calc B (D w1) (D w2)
        = B (D (∑ a : Fin 3, w1 a • e a)) (D (∑ b : Fin 3, w2 b • e b)) := by
          rw [← hw w1, ← hw w2]
      _ = ∑ a : Fin 3, ∑ b : Fin 3, w1 a * w2 b * B (D (e a)) (D (e b)) := by
          simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply,
            ContinuousLinearMap.smul_apply, smul_eq_mul, Finset.mul_sum]
          conv_lhs => rw [Finset.sum_comm]
          refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
          ring
  
  have hs6 : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F : E2 → E3) (x : E2),
      (pullMetric2 G F x).PosDef → Function.Injective (fderiv ℝ F x) := by
    intro G F x hP
    rw [injective_iff_map_eq_zero]
    intro v hv
    by_contra hv0
    have hw0 : (fun i : Fin 2 => v i) ≠ 0 := by
      intro h
      apply hv0
      ext i
      simpa using congrFun h i
    have hpos := hP.dotProduct_mulVec_pos hw0
    have hvdec : v = v 0 • e2 0 + v 1 • e2 1 := by
      ext i
      fin_cases i <;> simp [e2]
    have hs : ∀ k : Fin 3,
        v 0 * (fderiv ℝ F x (e2 0)) k + v 1 * (fderiv ℝ F x (e2 1)) k = 0 := by
      intro k
      have h1 := congrArg (fun z : E3 => z k) hv
      rw [hvdec] at h1
      simpa [map_add, map_smul] using h1
    have key : star (fun i : Fin 2 => v i) ⬝ᵥ (pullMetric2 G F x).mulVec (fun i : Fin 2 => v i) =
        ∑ k : Fin 3, ∑ l : Fin 3,
          (v 0 * (fderiv ℝ F x (e2 0)) k + v 1 * (fderiv ℝ F x (e2 1)) k) * G (F x) k l *
          (v 0 * (fderiv ℝ F x (e2 0)) l + v 1 * (fderiv ℝ F x (e2 1)) l) := by
      simp only [dotProduct, Matrix.mulVec, pullMetric2, Fin.sum_univ_two, Fin.sum_univ_three,
        Pi.star_apply, star_trivial]
      ring
    rw [key] at hpos
    simp only [hs, zero_mul, Finset.sum_const_zero] at hpos
    exact lt_irrefl 0 hpos
  
  have hΨ : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) ∞ (sternPsi Φ Y) {y : E3 | R₁ < ‖y‖} := by
    have hmaps : Set.MapsTo Y {y : E3 | R₁ < ‖y‖} Φ.Φ.source := by
      intro x hx
      rw [Φ.source_eq]
      have h1 := (hinv x hx).1
      show (1 : ℝ) < ‖Y x‖
      linarith
    exact Φ.Φ.contMDiffOn_toFun.comp hYs.contMDiffOn hmaps
  
  obtain ⟨Lι, hLι⟩ : ∃ L : E2 →L[ℝ] E3,
      L = (EuclideanSpace.proj (0 : Fin 2) : E2 →L[ℝ] ℝ).smulRight (e 1) +
        (EuclideanSpace.proj (1 : Fin 2) : E2 →L[ℝ] ℝ).smulRight (e 2) := ⟨_, rfl⟩
  have hιfun : (fun y : E2 => cylPt t (y 0) (y 1)) = fun y => t • e 0 + Lι y := by
    funext y
    rw [hLι]
    simp only [cylPt, ContinuousLinearMap.add_apply, ContinuousLinearMap.smulRight_apply]
    rw [add_assoc]
    rfl
  have hιd : ∀ x : E2, HasFDerivAt (fun y : E2 => cylPt t (y 0) (y 1)) Lι x := by
    intro x
    rw [hιfun]
    exact Lι.hasFDerivAt.const_add (t • e 0)
  have hιs : ContDiff ℝ ∞ (fun y : E2 => cylPt t (y 0) (y 1)) := by
    rw [hιfun]
    exact contDiff_const.add Lι.contDiff
  have hLe : ∀ a : Fin 2, Lι (e2 a) = e a.succ := by
    intro a
    rw [hLι]
    fin_cases a <;> simp [e2, e]
  
  have hσ : ContMDiffOn 𝓘(ℝ, E2) 𝓘(ℝ, E3) ∞
      (fun x : E2 => sternPsi Φ Y (cylPt t (x 0) (x 1)))
      {x : E2 | R₁ < ‖cylPt t (x 0) (x 1)‖} :=
    hΨ.comp hιs.contMDiff.contMDiffOn (fun x hx => hx)
  
  have hreg : ∀ y ∈ {y : E3 | R₁ < ‖y‖},
      mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u (sternPsi Φ Y y) ≠ 0 := by
    intro y hy h0
    have hΨy : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (sternPsi Φ Y) y :=
      (hΨ.contMDiffAt (hD.mem_nhds hy)).mdifferentiableAt hne
    have huy : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u (sternPsi Φ Y y) :=
      hu.contMDiffAt.mdifferentiableAt hne
    have hcomp := mfderiv_comp y huy hΨy
    have hev : (u ∘ sternPsi Φ Y) =ᶠ[𝓝 y] (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ) := by
      filter_upwards [hD.mem_nhds hy] with z hz
      exact hu1 z hz
    rw [hev.mfderiv_eq, mfderiv_eq_fderiv, ContinuousLinearMap.fderiv, h0,
      ContinuousLinearMap.zero_comp] at hcomp
    have h3 : (EuclideanSpace.proj (0 : Fin 3) : E3 →L[ℝ] ℝ) (e 0) = 1 := by
      simp [e, EuclideanSpace.single_apply]
    rw [hcomp] at h3
    have h4 : (0 : ℝ) = 1 := h3
    exact zero_ne_one h4
  refine ⟨hσ, fun x hx => hreg _ hx, fun q' => ⟨?_, fun x hx hsrc => ?_⟩⟩
  · 
    exact contMDiffOn_iff_contDiffOn.mp
      ((contMDiffOn_chart (I := 𝓘(ℝ, E3)) (n := ∞) (x := q')).comp
        (hσ.mono Set.inter_subset_left) (fun x hx => hx.2))
  · 
    have hN : IsOpen ({y : E3 | R₁ < ‖y‖} ∩ sternPsi Φ Y ⁻¹' (chartAt E3 q').source) :=
      hΨ.continuousOn.isOpen_inter_preimage hD (chartAt E3 q').open_source
    have hy₀ : cylPt t (x 0) (x 1) ∈
        {y : E3 | R₁ < ‖y‖} ∩ sternPsi Φ Y ⁻¹' (chartAt E3 q').source := ⟨hx, hsrc⟩
    have hT : ContDiffOn ℝ ∞ (fun z : E3 => chartAt E3 q' (sternPsi Φ Y z))
        ({y : E3 | R₁ < ‖y‖} ∩ sternPsi Φ Y ⁻¹' (chartAt E3 q').source) :=
      contMDiffOn_iff_contDiffOn.mp
        ((contMDiffOn_chart (I := 𝓘(ℝ, E3)) (n := ∞) (x := q')).comp
          (hΨ.mono Set.inter_subset_left) (fun z hz => hz.2))
    have hTd : DifferentiableAt ℝ (fun z : E3 => chartAt E3 q' (sternPsi Φ Y z))
        (cylPt t (x 0) (x 1)) :=
      (hT.contDiffAt (hN.mem_nhds hy₀)).differentiableAt hne
    have hFd : HasFDerivAt (fun y : E2 => chartAt E3 q' (sternPsi Φ Y (cylPt t (y 0) (y 1))))
        ((fderiv ℝ (fun z : E3 => chartAt E3 q' (sternPsi Φ Y z)) (cylPt t (x 0) (x 1))).comp Lι)
        x := by
      have hc := hTd.hasFDerivAt.comp x (hιd x)
      exact hc
    have hFe : ∀ a : Fin 2,
        fderiv ℝ (fun y : E2 => chartAt E3 q' (sternPsi Φ Y (cylPt t (y 0) (y 1)))) x (e2 a) =
          fderiv ℝ (fun z : E3 => chartAt E3 q' (sternPsi Φ Y z)) (cylPt t (x 0) (x 1))
            (e a.succ) := by
      intro a
      rw [hFd.fderiv, ContinuousLinearMap.comp_apply, hLe a]
    
    have hev : sternPsi Φ Y =ᶠ[𝓝 (cylPt t (x 0) (x 1))]
        ((chartAt E3 q').symm ∘ fun z : E3 => chartAt E3 q' (sternPsi Φ Y z)) := by
      filter_upwards [hN.mem_nhds hy₀] with z hz
      exact ((chartAt E3 q').left_inv hz.2).symm
    have hcs : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q').symm
        (chartAt E3 q' (sternPsi Φ Y (cylPt t (x 0) (x 1)))) :=
      ((contMDiffOn_chart_symm (I := 𝓘(ℝ, E3)) (n := ∞) (x := q')).contMDiffAt
        ((chartAt E3 q').open_target.mem_nhds
          ((chartAt E3 q').map_source hsrc))).mdifferentiableAt hne
    have hfac : ∀ v : E3,
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (sternPsi Φ Y) (cylPt t (x 0) (x 1)) v =
          mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q').symm
            (chartAt E3 q' (sternPsi Φ Y (cylPt t (x 0) (x 1))))
            (fderiv ℝ (fun z : E3 => chartAt E3 q' (sternPsi Φ Y z)) (cylPt t (x 0) (x 1)) v) := by
      intro v
      rw [hev.mfderiv_eq, mfderiv_comp (cylPt t (x 0) (x 1)) hcs hTd.mdifferentiableAt,
        mfderiv_eq_fderiv]
      rfl
    have hpt : (chartAt E3 q').symm (chartAt E3 q' (sternPsi Φ Y (cylPt t (x 0) (x 1)))) =
        sternPsi Φ Y (cylPt t (x 0) (x 1)) := (chartAt E3 q').left_inv hsrc
    have h2 : ∀ k l : Fin 3,
        g.coeff (chartAt E3 q').symm (chartAt E3 q' (sternPsi Φ Y (cylPt t (x 0) (x 1)))) k l =
          g.g (sternPsi Φ Y (cylPt t (x 0) (x 1)))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q').symm
              (chartAt E3 q' (sternPsi Φ Y (cylPt t (x 0) (x 1)))) (e k))
            (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q').symm
              (chartAt E3 q' (sternPsi Φ Y (cylPt t (x 0) (x 1)))) (e l)) := by
      intro k l
      show g.g ((chartAt E3 q').symm (chartAt E3 q' (sternPsi Φ Y (cylPt t (x 0) (x 1))))) _ _ = _
      rw [show g.g ((chartAt E3 q').symm (chartAt E3 q' (sternPsi Φ Y (cylPt t (x 0) (x 1))))) =
        g.g (sternPsi Φ Y (cylPt t (x 0) (x 1))) from congrArg g.g hpt]
    
    have hmet : sgbSideMetric (pullbackMetric (g.coeff Φ.Φ) Y) t x =
        pullMetric2 (g.coeff (chartAt E3 q').symm)
          (fun y : E2 => chartAt E3 q' (sternPsi Φ Y (cylPt t (y 0) (y 1)))) x := by
      funext a b
      have e1 : sgbSideMetric (pullbackMetric (g.coeff Φ.Φ) Y) t x a b =
          g.coeff (sternPsi Φ Y) (cylPt t (x 0) (x 1)) a.succ b.succ := by
        show pullbackMetric (g.coeff Φ.Φ) Y (cylPt t (x 0) (x 1)) a.succ b.succ = _
        rw [hch _ hx]
      rw [e1]
      show g.g (sternPsi Φ Y (cylPt t (x 0) (x 1)))
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (sternPsi Φ Y) (cylPt t (x 0) (x 1)) (e a.succ))
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (sternPsi Φ Y) (cylPt t (x 0) (x 1)) (e b.succ)) =
        ∑ k : Fin 3, ∑ l : Fin 3,
          (fderiv ℝ (fun y : E2 => chartAt E3 q' (sternPsi Φ Y (cylPt t (y 0) (y 1)))) x (e2 a)) k *
          g.coeff (chartAt E3 q').symm (chartAt E3 q' (sternPsi Φ Y (cylPt t (x 0) (x 1)))) k l *
          (fderiv ℝ (fun y : E2 => chartAt E3 q' (sternPsi Φ Y (cylPt t (y 0) (y 1)))) x (e2 b)) l
      rw [hfac (e a.succ), hfac (e b.succ)]
      refine (hexp (g.g (sternPsi Φ Y (cylPt t (x 0) (x 1))))
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q').symm
          (chartAt E3 q' (sternPsi Φ Y (cylPt t (x 0) (x 1))))) _ _).trans ?_
      rw [hFe a, hFe b]
      refine Finset.sum_congr rfl fun k _ => Finset.sum_congr rfl fun l _ => ?_
      rw [h2 k l]
      exact mul_right_comm _ _ _
    have hP : (pullMetric2 (g.coeff (chartAt E3 q').symm)
        (fun y : E2 => chartAt E3 q' (sternPsi Φ Y (cylPt t (y 0) (y 1)))) x).PosDef := by
      rw [← hmet]
      exact hpd x hx
    exact ⟨hs6 _ _ x hP, hmet⟩

theorem gaussCurv2_congr_nhds (h₁ h₂ : E2 → Matrix (Fin 2) (Fin 2) ℝ) (x : E2)
    (hev : h₁ =ᶠ[𝓝 x] h₂) : gaussCurv2 h₁ x = gaussCurv2 h₂ x :=
by
  have hchr : ∀ y : E2, h₁ =ᶠ[𝓝 y] h₂ → ∀ k i j : Fin 2,
      christoffel2 h₁ k i j y = christoffel2 h₂ k i j y := by
    intro y hy k i j
    have hpt : h₁ y = h₂ y := hy.eq_of_nhds
    have hpd : ∀ a b c : Fin 2, pd2 c (fun z => h₁ z a b) y = pd2 c (fun z => h₂ z a b) y := by
      intro a b c
      have he : (fun z => h₁ z a b) =ᶠ[𝓝 y] (fun z => h₂ z a b) :=
        hy.mono (fun z hz => by simp only [hz])
      unfold pd2
      rw [Filter.EventuallyEq.fderiv_eq he]
    simp only [christoffel2, hpt, hpd]
  have hev2 : ∀ k i j : Fin 2, christoffel2 h₁ k i j =ᶠ[𝓝 x] christoffel2 h₂ k i j := by
    intro k i j
    exact hev.eventually_nhds.mono (fun y hy => hchr y hy k i j)
  have hpdc : ∀ c k i j : Fin 2,
      pd2 c (christoffel2 h₁ k i j) x = pd2 c (christoffel2 h₂ k i j) x := by
    intro c k i j
    unfold pd2
    rw [Filter.EventuallyEq.fderiv_eq (hev2 k i j)]
  have hric : ∀ j k : Fin 2, ricci2 h₁ j k x = ricci2 h₂ j k x := by
    intro j k
    simp only [ricci2, hpdc, hchr x hev]
  have hpt : h₁ x = h₂ x := hev.eq_of_nhds
  simp only [gaussCurv2, hpt, hric]

theorem chart_level_gauss [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (u : M → ℝ)
    (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u) (q : M) (S : Set E2) (hS : IsOpen S) (P : E2 → M)
    (hP : ∀ x ∈ S, P x ∈ (chartAt E3 q).source)
    (hsm : ContDiffOn ℝ ∞ (fun x => chartAt E3 q (P x)) S)
    (hinj : ∀ x ∈ S, Function.Injective (fderiv ℝ (fun y => chartAt E3 q (P y)) x)) (c : ℝ)
    (hlev : ∀ x ∈ S, u (P x) = c)
    (hreg : ∀ x ∈ S, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u (P x) ≠ 0) :
    ∀ x ∈ S, gaussCurv2 (pullMetric2 (g.coeff (chartAt E3 q).symm) (fun y => chartAt E3 q (P y))) x =
      levelGaussLoc (g.coeff (chartAt E3 q).symm) (fun y => u ((chartAt E3 q).symm y))
        (chartAt E3 q (P x)) :=
by
  have hFV : ∀ x ∈ S, (fun y => chartAt E3 q (P y)) x ∈ (chartAt E3 q).target :=
    fun x hx => (chartAt E3 q).map_source (hP x hx)
  have hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => g.coeff (chartAt E3 q).symm y i j)
      (chartAt E3 q).target := fun i j => g.smooth q i j
  have hsymm : ∀ (y : E3) (i j : Fin 3),
      g.coeff (chartAt E3 q).symm y i j = g.coeff (chartAt E3 q).symm y j i := by
    intro y i j
    simp only [RiemannianMetric3.coeff, coeffMatrix]
    exact g.symm _ _ _
  have hpd : ∀ y ∈ (chartAt E3 q).target, (g.coeff (chartAt E3 q).symm y).PosDef :=
    fun y hy => coeff_chart_symm_posDef g q y hy
  have hf := (chart_pullback_gradInner g u hu q).1
  have hlev' : ∀ x ∈ S, (fun y => u ((chartAt E3 q).symm y))
      ((fun y => chartAt E3 q (P y)) x) = c := by
    intro x hx
    show u ((chartAt E3 q).symm (chartAt E3 q (P x))) = c
    rw [(chartAt E3 q).left_inv (hP x hx)]
    exact hlev x hx
  have hreg' : ∀ x ∈ S, 0 < gradSqLoc (g.coeff (chartAt E3 q).symm)
      (fun y => u ((chartAt E3 q).symm y)) ((fun y => chartAt E3 q (P y)) x) := by
    intro x hx
    have hd : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u ((chartAt E3 q).symm (chartAt E3 q (P x))) ≠ 0 := by
      rw [(chartAt E3 q).left_inv (hP x hx)]
      exact hreg x hx
    have h := chart_Nsq_pos g u hu q _ (hFV x hx) hd
    unfold gradSqLoc gradInnerLoc
    exact h
  intro x hx
  exact level_gauss_equation (g.coeff (chartAt E3 q).symm) (chartAt E3 q).target
    (chartAt E3 q).open_target hG hsymm hpd (fun y => u ((chartAt E3 q).symm y)) hf
    (fun y => chartAt E3 q (P y)) S hS hsm hFV hinj c hlev' hreg' x hx

theorem patch_gauss_eq_sternGauss [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (u : M → ℝ) (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u) (t : ℝ) (W : Set E2) (hW : IsOpen W)
    (param : E2 → M) (hpc : ContinuousOn param W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hlev : ∀ x ∈ W, u (param x) = t)
    (hreg : ∀ x ∈ W, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u (param x) ≠ 0)
    (hG4 : ∀ q' : M, ContDiffOn ℝ ∞ (fun x => chartAt E3 q' (param x))
      (W ∩ param ⁻¹' (chartAt E3 q').source) ∧
      ∀ x ∈ W ∩ param ⁻¹' (chartAt E3 q').source,
        Function.Injective (fderiv ℝ (fun y => chartAt E3 q' (param y)) x) ∧
        h x = pullMetric2 (g.coeff (chartAt E3 q').symm) (fun y => chartAt E3 q' (param y)) x) :
    ∀ x ∈ W, gaussCurv2 h x = sternGaussM g u (param x) :=
by
  intro x hx
  have hS : IsOpen (W ∩ param ⁻¹' (chartAt E3 (param x)).source) :=
    hpc.isOpen_inter_preimage hW (chartAt E3 (param x)).open_source
  have hxS : x ∈ W ∩ param ⁻¹' (chartAt E3 (param x)).source :=
    ⟨hx, mem_chart_source E3 (param x)⟩
  have hev : h =ᶠ[𝓝 x] pullMetric2 (g.coeff (chartAt E3 (param x)).symm)
      (fun y => chartAt E3 (param x) (param y)) :=
    Filter.eventually_of_mem (hS.mem_nhds hxS) (fun y hy => ((hG4 (param x)).2 y hy).2)
  rw [gaussCurv2_congr_nhds _ _ x hev]
  exact chart_level_gauss g u hu (param x) _ hS param (fun y hy => hy.2) (hG4 (param x)).1
    (fun y hy => ((hG4 (param x)).2 y hy).1) t (fun y hy => hlev y hy.1)
    (fun y hy => hreg y hy.1) x hxS

theorem ssp_side_data [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (Φ : EndChart M) (β u : M → ℝ) (hβ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ β)
    (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u) (X Y : E3 → E3) (q R₀ R₁ C : ℝ)
    (hXY : CoordChange X Y q R₀ R₁ C)
    (hΨ : ∀ x : E3, R₁ < ‖x‖ → u (sternPsi Φ Y x) = x 0 ∧ 0 < β (sternPsi Φ Y x))
    (hmet : ∀ x : E3, R₁ < ‖x‖ → g.coeff (sternPsi Φ Y) x = pullbackMetric (g.coeff Φ.Φ) Y x)
    (L t : ℝ) (hL : R₁ + 1 ≤ L) (ht : |t| < L) :
    ∃ (σ₀ : ℝ) (b ψs : M → ℝ) (Z V Os : Set M) (prs : M → E2) (Kcs : Set E2),
      sspSideData g Φ β u Y R₁ L t σ₀ b ψs Z V Os prs Kcs :=
by
  classical
  have hR0 : (2 : ℝ) ≤ R₀ := hXY.1
  have hR01 : R₀ ≤ R₁ := hXY.2.1
  have hL0 : 0 < L := by linarith
  have hRL : R₁ ^ 2 < L ^ 2 - 2 := by nlinarith
  obtain ⟨P, hPs, hPΨ⟩ := sternPsi_partialDiffeomorph Φ X Y q R₀ R₁ C hXY
  have hnE3 : ∀ y : E3, ‖y‖ ^ 2 = y 0 ^ 2 + y 1 ^ 2 + y 2 ^ 2 := by
    intro y
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  have hmemD : ∀ y : E3, L ^ 2 - 2 ≤ y 0 ^ 2 + y 1 ^ 2 + y 2 ^ 2 → y ∈ P.source := by
    intro y hy
    rw [hPs]
    show R₁ < ‖y‖
    have h := hnE3 y
    by_contra hc
    push_neg at hc
    have := mul_self_le_mul_self (norm_nonneg y) hc
    nlinarith
  have hD : ∀ y ∈ P.source, R₁ < ‖y‖ := by
    intro y hy
    rw [hPs] at hy
    exact hy
  have hΨP : ∀ y ∈ P.source, P y = sternPsi Φ Y y ∧ u (P y) = y 0 ∧ 0 < β (P y) := by
    intro y hy
    rw [hPΨ y hy]
    exact ⟨rfl, hΨ y (hD y hy)⟩
  have hc0 : ∀ a b c : ℝ, (cylPt a b c) 0 = a := by
    intro a b c; simp [cylPt, EuclideanSpace.single_apply]
  have hc1 : ∀ a b c : ℝ, (cylPt a b c) 1 = b := by
    intro a b c; simp [cylPt, EuclideanSpace.single_apply]
  have hc2 : ∀ a b c : ℝ, (cylPt a b c) 2 = c := by
    intro a b c; simp [cylPt, EuclideanSpace.single_apply]
  have hcself : ∀ y : E3, y 0 = t → cylPt t (y 1) (y 2) = y := by
    intro y hy
    ext i
    fin_cases i <;> simp [cylPt, EuclideanSpace.single_apply, hy]
  obtain ⟨π, hπdef⟩ : ∃ π : E3 → E2, π = fun z => z 1 • e2 0 + z 2 • e2 1 := ⟨_, rfl⟩
  have hπ0 : ∀ z : E3, (π z) 0 = z 1 := by
    intro z; rw [hπdef]; simp [e2, EuclideanSpace.single_apply]
  have hπ1 : ∀ z : E3, (π z) 1 = z 2 := by
    intro z; rw [hπdef]; simp [e2, EuclideanSpace.single_apply]
  have hπs : ContDiff ℝ ∞ π := by
    rw [hπdef]
    have h1 : ContDiff ℝ ∞ (fun y : E3 => y 1) :=
      (EuclideanSpace.proj (1 : Fin 3) : E3 →L[ℝ] ℝ).contDiff
    have h2 : ContDiff ℝ ∞ (fun y : E3 => y 2) :=
      (EuclideanSpace.proj (2 : Fin 3) : E3 →L[ℝ] ℝ).contDiff
    exact (h1.smul contDiff_const).add (h2.smul contDiff_const)
  have hπι : ∀ x : E2, π (cylPt t (x 0) (x 1)) = x := by
    intro x
    ext i
    fin_cases i
    · show (π (cylPt t (x 0) (x 1))) 0 = x 0
      rw [hπ0, hc1]
    · show (π (cylPt t (x 0) (x 1))) 1 = x 1
      rw [hπ1, hc2]
  have hιπ : ∀ y : E3, y 0 = t → cylPt t ((π y) 0) ((π y) 1) = y := by
    intro y hy
    rw [hπ0, hπ1]
    exact hcself y hy
  have hcr : Continuous fun y : E3 => y 1 ^ 2 + y 2 ^ 2 := by fun_prop
  have hca : Continuous fun y : E3 => |y 0 - t| := by fun_prop
  have hcr2 : Continuous fun x : E2 => x 0 ^ 2 + x 1 ^ 2 := by fun_prop
  have hcpt : ∀ a c : ℝ, c ≤ L ^ 2 + 1 →
      IsCompact {y : E3 | |y 0 - t| ≤ 1 ∧ a ≤ y 1 ^ 2 + y 2 ^ 2 ∧ y 1 ^ 2 + y 2 ^ 2 ≤ c} := by
    intro a c hc
    apply Metric.isCompact_of_isClosed_isBounded
    · exact (isClosed_le hca continuous_const).inter
        ((isClosed_le continuous_const hcr).inter (isClosed_le hcr continuous_const))
    · refine (Metric.isBounded_closedBall (x := (0 : E3)) (r := |t| + |L| + 2)).subset ?_
      intro y hy
      obtain ⟨h1, h2, h3⟩ := hy
      rw [Metric.mem_closedBall, dist_zero_right]
      have hy0 : |y 0| ≤ |t| + 1 := by
        have := abs_sub_abs_le_abs_sub (y 0) t
        linarith
      have hsq : y 0 ^ 2 ≤ (|t| + 1) ^ 2 := by
        rw [← sq_abs (y 0)]
        exact pow_le_pow_left₀ (abs_nonneg _) hy0 2
      have hL2 : L ^ 2 = |L| ^ 2 := (sq_abs L).symm
      have := hnE3 y
      have hpos : 0 ≤ |t| + |L| + 2 := by positivity
      by_contra hcon
      push_neg at hcon
      have hmm := mul_self_lt_mul_self hpos hcon
      nlinarith [abs_nonneg t, abs_nonneg L, norm_nonneg y]
  have hPc : ContinuousOn P P.source := P.contMDiffOn.continuousOn
  have hβPc : ContinuousOn (fun y => β (P y)) P.source := hβ.continuous.comp_continuousOn hPc
  have hKβD : ∀ y : E3, L ^ 2 - 2 ≤ y 1 ^ 2 + y 2 ^ 2 → y ∈ P.source := fun y hy =>
    hmemD y (by nlinarith [sq_nonneg (y 0)])
  have hKβc := hcpt (L ^ 2 - 2) (L ^ 2 + 1) le_rfl
  have hKβne : (cylPt t L 0) ∈ {y : E3 | |y 0 - t| ≤ 1 ∧ L ^ 2 - 2 ≤ y 1 ^ 2 + y 2 ^ 2 ∧
      y 1 ^ 2 + y 2 ^ 2 ≤ L ^ 2 + 1} := by
    show |(cylPt t L 0) 0 - t| ≤ 1 ∧ L ^ 2 - 2 ≤ (cylPt t L 0) 1 ^ 2 + (cylPt t L 0) 2 ^ 2 ∧
      (cylPt t L 0) 1 ^ 2 + (cylPt t L 0) 2 ^ 2 ≤ L ^ 2 + 1
    rw [hc0, hc1, hc2]
    refine ⟨by simp, by nlinarith, by nlinarith⟩
  obtain ⟨ys, hys, hmin⟩ :=
    hKβc.exists_isMinOn ⟨_, hKβne⟩ (hβPc.mono (fun y hy => hKβD y hy.2.1))
  have hm : 0 < β (P ys) := (hΨP ys (hKβD ys hys.2.1)).2.2
  obtain ⟨σ₀, hσdef⟩ : ∃ σ : ℝ, σ = min (β (P ys) / 4) (1 / 2) := ⟨_, rfl⟩
  have hσpos : 0 < σ₀ := by rw [hσdef]; exact lt_min (by linarith) (by norm_num)
  have hσhalf : σ₀ ≤ 1 / 2 := by rw [hσdef]; exact min_le_right _ _
  have hσm : 4 * σ₀ ≤ β (P ys) := by
    rw [hσdef]; linarith [min_le_left (β (P ys) / 4) (1 / 2)]
