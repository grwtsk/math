  have htt : t ≤ t ^ 2 := by rw [sq]; exact le_mul_of_one_le_right ht0.le ht1
  have ht2p : 0 < t ^ 2 := pow_pos ht0 2
  have hz0 : |z 0| ≤ s := by
    have h : z 0 ^ 2 ≤ s ^ 2 := by linarith [sq_nonneg (z 1)]
    have h2 := sq_le_sq.mp h
    rwa [abs_of_pos hs] at h2
  have hz1 : |z 1| ≤ s := by
    have h : z 1 ^ 2 ≤ s ^ 2 := by linarith [sq_nonneg (z 0)]
    have h2 := sq_le_sq.mp h
    rwa [abs_of_pos hs] at h2
  
  have hqexp : (∑ i : Fin 2, ∑ j : Fin 2, A₀ i j * z i * z j) =
      A₀ 0 0 * z 0 * z 0 + A₀ 0 1 * z 0 * z 1 + (A₀ 1 0 * z 1 * z 0 + A₀ 1 1 * z 1 * z 1) := by
    simp only [Fin.sum_univ_two]
  obtain ⟨q, hQ⟩ : ∃ q : ℝ, (∑ i : Fin 2, ∑ j : Fin 2, A₀ i j * z i * z j) = q := ⟨_, rfl⟩
  rw [hQ] at hqexp hu hH
  have hqlow : μ * s ^ 2 ≤ q := by
    rw [hqexp, hsym, ← hz]
    exact hμq (z 0) (z 1)
  have hq : 0 < q := lt_of_lt_of_le (mul_pos hμ0 (pow_pos hs 2)) hqlow
  have hqup : q ≤ 4 * α * s ^ 2 := by
    have t1 := (abs_le.mp (prod3 _ _ _ _ _ _ (hα 0 0) hz0 hz0)).2
    have t2 := (abs_le.mp (prod3 _ _ _ _ _ _ (hα 0 1) hz0 hz1)).2
    have t3 := (abs_le.mp (prod3 _ _ _ _ _ _ (hα 1 0) hz1 hz0)).2
    have t4 := (abs_le.mp (prod3 _ _ _ _ _ _ (hα 1 1) hz1 hz1)).2
    rw [hqexp]
    linarith
  have hqt : q * t ^ 2 ≤ M := by
    calc q * t ^ 2 ≤ 4 * α * s ^ 2 * t ^ 2 := mul_le_mul_of_nonneg_right hqup ht2p.le
