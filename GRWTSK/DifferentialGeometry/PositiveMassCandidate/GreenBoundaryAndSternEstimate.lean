    have k := abs3 _ _ _ _ _ _ k1 k2 k3
    have hfix : M * s * (2 * M * t ^ 2) * (M * t) = 2 * M ^ 3 * t ^ 2 := by
      linear_combination (2 * M ^ 3 * t ^ 2) * hst
    have e2 : M * (M * t) * (M * t) = M ^ 3 * t ^ 2 := by ring
    have e3 : M * (M * t ^ 2) * M = M ^ 3 * t ^ 2 := by ring
    linarith
  have hNd : ∀ c : Fin 2, |(∑ a : Fin 2, ∑ b : Fin 2, B a b * H c a * p b) -
      ∑ a : Fin 2, ∑ b : Fin 2, A₀⁻¹ a b * (A₀ c a * r - 2 * u c * u a) * u b| ≤
        16 * M ^ 3 * t ^ 2 := by
    intro c
    simp only [← Finset.sum_sub_distrib]
    have h : |∑ a : Fin 2, ∑ b : Fin 2, (B a b * H c a * p b -
