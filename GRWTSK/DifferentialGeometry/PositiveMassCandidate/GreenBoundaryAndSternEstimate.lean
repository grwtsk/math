      sbgbSliceJ g β u q φ (sternDomain (hAF.ends k) β Y L) t s := ⟨_, rfl⟩
  have hκ'c : Continuous κ' := by rw [hκ']; exact continuous_const.sub hκ
  obtain ⟨B, hB⟩ := hA.exists_bound_of_continuousOn hκ'c.continuousOn
  have hκ'int : MeasureTheory.IntegrableOn κ' A := hκ'c.continuousOn.integrableOn_compact hA
  have hcoarea := stern_band_coarea g hAF hR k β Re hβ hmin u hu hharm hneu X Y R₀ R₁ C hXY hRe
    hX hdom hconn hchart L hL q φ hadm A hA hAsub hreg
  obtain ⟨s₀, hs₀, Cb, hbd, hlim⟩ := stern_slice_collar_limit g hAF hR k β Re hβ hmin u hu hharm
    hneu X Y R₀ R₁ C hXY hRe hX hdom hconn hchart L hL q φ hadm A hA hAsub hreg
  have hgb : ∀ t ∈ A, sbgbSliceLim g β u q φ (sternDomain (hAF.ends k) β Y L) t ≤ κ' t := by
    intro t ht
    have htL : |t| < L := abs_lt.mpr (hAsub ht)
    rw [hκ']
    refine stern_slice_gauss_bonnet g hAF hR k β Re hβ hmin u hu hharm hneu X Y R₀ R₁ C hXY hRe
      hX hdom hconn hchart L hL q φ hadm t htL ?_
    intro p hp
    refine hreg p hp.1 ?_
    rw [show u p = t from hp.2]
    exact ht
  have hFint : ∀ s : ℝ, 0 < s → MeasureTheory.IntegrableOn (F s) A := by
    intro s hs
    rw [hF]
    exact (hcoarea s hs).1
  have hFeq : ∀ s : ℝ, 0 < s →
      sternBandJ g β u q φ (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' A) s = ∫ t in A, F s t := by
    intro s hs
    rw [hF]
    exact (hcoarea s hs).2
  have hFbd : ∀ s : ℝ, 0 < s → s < s₀ → ∀ t ∈ A, |F s t| ≤ Cb := by
    intro s hs hs' t ht
    rw [hF]
    exact hbd s hs hs' t ht
  have hFlim : ∀ t ∈ A, Tendsto (fun s => F s t) (𝓝[>] (0 : ℝ))
      (𝓝 (sbgbSliceLim g β u q φ (sternDomain (hAF.ends k) β Y L) t)) := by
    intro t ht
    rw [hF]
    exact hlim t ht
  
  have hHint : ∀ s : ℝ, 0 < s →
      MeasureTheory.IntegrableOn (fun t => max (F s t) (κ' t)) A := by
    intro s hs
    refine ((hFint s hs).sup hκ'int).congr (Filter.Eventually.of_forall fun t => ?_)
    simp only [Pi.sup_apply]
  have hmeasA : MeasurableSet A := hA.measurableSet
  have hDCT : Tendsto (fun s => ∫ t in A, max (F s t) (κ' t)) (𝓝[>] (0 : ℝ))
      (𝓝 (∫ t in A, κ' t)) := by
    refine MeasureTheory.tendsto_integral_filter_of_dominated_convergence
      (fun _ => |Cb| + |B|) ?_ ?_ ?_ ?_
    · filter_upwards [self_mem_nhdsWithin] with s hs
      exact (hHint s hs).aestronglyMeasurable
    · filter_upwards [Ioo_mem_nhdsGT hs₀] with s hs
      refine (MeasureTheory.ae_restrict_iff' hmeasA).mpr (Filter.Eventually.of_forall fun t ht => ?_)
      have ha := abs_le.mp (hFbd s hs.1 hs.2 t ht)
      have hb' : |κ' t| ≤ B := by
        have := hB t ht
        rwa [Real.norm_eq_abs] at this
      have hb := abs_le.mp hb'
      have h1 := le_abs_self Cb
      have h2 := le_abs_self B
      have h3 := abs_nonneg Cb
      have h4 := abs_nonneg B
      rw [Real.norm_eq_abs, abs_le]
      constructor
      · exact le_trans (by linarith) (le_max_left _ _)
      · exact max_le (by linarith) (by linarith)
    · exact continuous_const.continuousOn.integrableOn_compact hA
    · refine (MeasureTheory.ae_restrict_iff' hmeasA).mpr (Filter.Eventually.of_forall fun t ht => ?_)
      have h := (hFlim t ht).max (tendsto_const_nhds (x := κ' t))
      rwa [max_eq_right (hgb t ht)] at h
  have hlt : ∫ t in A, κ' t < (∫ t in A, κ' t) + θ := by linarith
  have hev := hDCT (Iio_mem_nhds hlt)
  obtain ⟨s₂, hs₂, hsub⟩ :=
    mem_nhdsGT_iff_exists_Ioo_subset.mp (Filter.inter_mem hev (Ioo_mem_nhdsGT hs₀))
  refine ⟨s₂, hs₂, fun s hs hss => ?_⟩
  have hmem := hsub ⟨hs, hss⟩
  have hI : ∫ t in A, max (F s t) (κ' t) < (∫ t in A, κ' t) + θ := hmem.1
  have hmono : ∫ t in A, F s t ≤ ∫ t in A, max (F s t) (κ' t) :=
    MeasureTheory.integral_mono (hFint s hs) (hHint s hs) (fun t => le_max_left _ _)
  have hk2 : κ' = fun t =>
      -(sternKappa (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L t - 2 * Real.pi) := by
    rw [hκ']
    funext t
    ring
  have hkint : ∫ t in A, κ' t =
      -(∫ t in A, (sternKappa (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L t - 2 * Real.pi)) := by
    rw [hk2, MeasureTheory.integral_neg]
  rw [hFeq s hs]
  linarith

theorem stern_integration_core [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g)
    (hR : ∀ p : M, 0 ≤ g.scalarCurvature p) (k : Fin hAF.numEnds)
    (β : M → ℝ) (Re : ℝ) (hβ : IsExteriorDomain (hAF.ends k) β Re)
    (hmin : ∀ p : M, β p = 0 → g.levelMeanCurv β p = 0)
    (u : M → ℝ) (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u)
    (hharm : ∀ p : M, 0 ≤ β p → g.lapM u p = 0)
    (hneu : ∀ p : M, β p = 0 → g.gradInner u β p = 0)
    (X Y : E3 → E3) (R₀ R₁ C : ℝ) (hXY : CoordChange X Y (min hAF.q (3 / 4)) R₀ R₁ C)
    (hRe : Re ≤ R₀)
    (hX : ∀ y : E3, R₀ < ‖y‖ → X y = cylPt (u ((hAF.ends k).Φ y)) (y 1) (y 2))
    (hdom : (∀ x : E3, R₁ < ‖x‖ →
        u (sternPsi (hAF.ends k) Y x) = x 0 ∧ 0 < β (sternPsi (hAF.ends k) Y x)) ∧
      ∀ L : ℝ, R₁ < L → IsCompact (sternDomain (hAF.ends k) β Y L) ∧
        IsOpen (sternOuter (hAF.ends k) Y L) ∧ IsClosed (sternOuterClosed (hAF.ends k) Y L) ∧
        ∀ t : ℝ, |t| < L → IsCompact (sternSide (hAF.ends k) Y L ∩ u ⁻¹' {t}))
    (hconn : ∀ L : ℝ, R₁ < L → ∀ t : ℝ, |t| < L →
      (∀ p ∈ sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t},
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0) →
      IsConnected (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t}))
    (hchart : ∀ x : E3, R₁ < ‖x‖ →
      g.coeff (sternPsi (hAF.ends k) Y) x = pullbackMetric (g.coeff (hAF.ends k).Φ) Y x ∧
      g.gradInner u u (sternPsi (hAF.ends k) Y x) =
        (pullbackMetric (g.coeff (hAF.ends k).Φ) Y x)⁻¹ 0 0 ∧
      lapLoc (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) (fun z : E3 => z 0) x = 0)
    (hboch : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (V : Set E3), IsOpen V →
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) V) →
      (∀ (y : E3) (i j : Fin 3), G y i j = G y j i) →
      (∀ y ∈ V, (G y).PosDef) →
      ∀ (f : E3 → ℝ), ContDiffOn ℝ ∞ f V → (∀ y ∈ V, lapLoc G f y = 0) →
      ∀ (ε : ℝ), 0 < ε →
      ∀ y ∈ V, ricGradLoc G f y ≤ sternPhiLoc G f ε y * lapLoc G (sternPhiLoc G f ε) y ∧
        (0 < gradSqLoc G f y →
          (1 / 2 : ℝ) * hessSqLoc G f y +
              (1 / 2 : ℝ) * gradSqLoc G f y * (scalarCurvatureLocal G y - 2 * levelGaussLoc G f y)
            ≤ sternPhiLoc G f ε y * lapLoc G (sternPhiLoc G f ε) y))
    (hneuloc : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (V : Set E3), IsOpen V →
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) V) →
      (∀ (y : E3) (i j : Fin 3), G y i j = G y j i) →
      (∀ y ∈ V, (G y).PosDef) →
      ∀ (f b : E3 → ℝ), ContDiffOn ℝ ∞ f V → ContDiffOn ℝ ∞ b V →
      (∀ z ∈ V, b z = 0 → gradInnerLoc G f b z = 0) →
      ∀ (y : E3), y ∈ V → b y = 0 → 0 < gradSqLoc G b y →
      ∀ (ε : ℝ), 0 < ε →
      -(gradInnerLoc G (sternPhiLoc G f ε) b y) = hessGGLoc G b f y / sternPhiLoc G f ε y)
    (hsard : ∀ (f : E3 → ℝ) (V : Set E3), IsOpen V → ContDiffOn ℝ ∞ f V →
      MeasureTheory.volume (f '' {y | y ∈ V ∧ fderiv ℝ f y = 0}) = 0)
    (hgauss : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (V : Set E3), IsOpen V →
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) V) →
      (∀ (y : E3) (i j : Fin 3), G y i j = G y j i) →
      (∀ y ∈ V, (G y).PosDef) →
      ∀ (f : E3 → ℝ), ContDiffOn ℝ ∞ f V →
      ∀ (F : E2 → E3) (W : Set E2), IsOpen W → ContDiffOn ℝ ∞ F W →
      (∀ x ∈ W, F x ∈ V) → (∀ x ∈ W, Function.Injective (fderiv ℝ F x)) →
      ∀ (c : ℝ), (∀ x ∈ W, f (F x) = c) → (∀ x ∈ W, 0 < gradSqLoc G f (F x)) →
      ∀ x ∈ W, gaussCurv2 (pullMetric2 G F) x = levelGaussLoc G f (F x)) :
    ∃ L₁ : ℝ, ∀ L : ℝ, L₁ ≤ L →
      0 ≤ sternBoundary (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L :=
by
  obtain ⟨L₁a, hA⟩ := stern_cutoff_divergence g hAF hR k β Re hβ hmin u hu hharm hneu
    X Y R₀ R₁ C hXY hRe hX hdom hconn hchart
  obtain ⟨L₁b, hB⟩ := stern_bad_set_estimate g hAF hR k β Re hβ hmin u hu hharm hneu
    X Y R₀ R₁ C hXY hRe hX hdom hconn hchart
  obtain ⟨L₁c, hC⟩ := stern_band_eps_limit g hAF hR k β Re hβ hmin u hu hharm hneu
    X Y R₀ R₁ C hXY hRe hX hdom hconn hchart
  obtain ⟨L₁d, hD⟩ := stern_band_gauss_bonnet g hAF hR k β Re hβ hmin u hu hharm hneu
    X Y R₀ R₁ C hXY hRe hX hdom hconn hchart
  refine ⟨max (max (max L₁a L₁b) (max L₁c L₁d)) (R₁ + 1), fun L hL => ?_⟩
  have hL0 : max (max L₁a L₁b) (max L₁c L₁d) ≤ L := le_trans (le_max_left _ _) hL
  have hLa : L₁a ≤ L :=
    le_trans (le_trans (le_max_left _ _) (le_max_left _ _)) hL0
  have hLb : L₁b ≤ L :=
    le_trans (le_trans (le_max_right _ _) (le_max_left _ _)) hL0
  have hLc : L₁c ≤ L :=
    le_trans (le_trans (le_max_left _ _) (le_max_right _ _)) hL0
  have hLd : L₁d ≤ L :=
    le_trans (le_trans (le_max_right _ _) (le_max_right _ _)) hL0
  have hLR : R₁ < L := by
    have := le_trans (le_max_right _ _) hL
    linarith
  obtain ⟨n, q, φ, hadm, s₀, hs₀, hdiv⟩ := hA L hLa
  have hlim := stern_flux_eps_limit g (hAF.ends k) X Y _ R₀ R₁ C hXY L hLR
  have key : ∀ θ : ℝ, 0 < θ →
      curvTerm (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L - 4 * Real.pi * L - θ ≤
        cylFlux (gradVec (pullbackMetric (g.coeff (hAF.ends k).Φ) Y)) L := by
    intro θ hθ
    have hθ' : 0 < θ / 4 := by positivity
    obtain ⟨δ, hδ, hcomp⟩ :=
      stern_kappa_comparison g (hAF.ends k) X Y _ R₀ R₁ C hXY L hLR (θ / 4) hθ'
    obtain ⟨U, hUo, hUvol, hLU1, hLU2, hcrit, hbad⟩ := hB L hLb q φ hadm (θ / 4) hθ' δ hδ
    have hAc : IsCompact (Set.Icc (-L) L \ U) := isCompact_Icc.diff hUo
    have hAsub : Set.Icc (-L) L \ U ⊆ Set.Ioo (-L) L := by
      rintro t ⟨⟨h1, h2⟩, htU⟩
      refine ⟨lt_of_le_of_ne h1 ?_, lt_of_le_of_ne h2 ?_⟩
      · rintro rfl
        exact htU hLU1
      · rintro rfl
        exact htU hLU2
    have hAreg : ∀ p ∈ sternDomain (hAF.ends k) β Y L, u p ∈ Set.Icc (-L) L \ U →
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0 := by
      intro p hp hpA hzero
      exact hpA.2 (hcrit p hp hzero)
    have hAmeas : MeasurableSet (Set.Icc (-L) L \ U) := hAc.isClosed.measurableSet
    have hAvol : volume (Set.Icc (-L) L \ (Set.Icc (-L) L \ U)) < ENNReal.ofReal δ := by
      refine lt_of_le_of_lt (measure_mono ?_) hUvol
      rintro t ⟨ht1, ht2⟩
      by_contra htU
      exact ht2 ⟨ht1, htU⟩
    have hI := hcomp (Set.Icc (-L) L \ U) hAmeas Set.diff_subset hAvol
    obtain ⟨ε₁, hε₁, hband⟩ := hC L hLc q φ hadm (Set.Icc (-L) L \ U) hAc hAsub hAreg (θ / 4) hθ'
    obtain ⟨s₃, hs₃, hgb⟩ := hD L hLd q φ hadm (Set.Icc (-L) L \ U) hAc hAsub hAreg (θ / 4) hθ'
    have hev : ∀ᶠ ε in 𝓝[>] (0 : ℝ),
        curvTerm (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L - 4 * Real.pi * L - θ ≤
          cylFlux (sternVecEps (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) ε) L := by
      filter_upwards [Ioo_mem_nhdsGT (lt_min hε₁ one_pos)] with ε hε
      have hε0 : 0 < ε := hε.1
      have hεe : ε < ε₁ := lt_of_lt_of_le hε.2 (min_le_left _ _)
      have hε1 : ε ≤ 1 := le_of_lt (lt_of_lt_of_le hε.2 (min_le_right _ _))
      obtain ⟨s₁, hs₁, hbad'⟩ := hbad ε hε0 hε1
      obtain ⟨s₂, hs₂, hband'⟩ := hband ε hε0 hεe
      have hm : 0 < min (min s₀ s₁) (min s₂ s₃) := lt_min (lt_min hs₀ hs₁) (lt_min hs₂ hs₃)
      have hspos : 0 < min (min s₀ s₁) (min s₂ s₃) / 2 := half_pos hm
      have hslt : min (min s₀ s₁) (min s₂ s₃) / 2 < min (min s₀ s₁) (min s₂ s₃) :=
        half_lt_self hm
      have h0 : min (min s₀ s₁) (min s₂ s₃) / 2 < s₀ :=
        lt_of_lt_of_le hslt (le_trans (min_le_left _ _) (min_le_left _ _))
      have h1 : min (min s₀ s₁) (min s₂ s₃) / 2 < s₁ :=
        lt_of_lt_of_le hslt (le_trans (min_le_left _ _) (min_le_right _ _))
      have h2 : min (min s₀ s₁) (min s₂ s₃) / 2 < s₂ :=
        lt_of_lt_of_le hslt (le_trans (min_le_right _ _) (min_le_left _ _))
      have h3 : min (min s₀ s₁) (min s₂ s₃) / 2 < s₃ :=
        lt_of_lt_of_le hslt (le_trans (min_le_right _ _) (min_le_right _ _))
      have e1 := hdiv _ hspos h0 ε hε0
      have e2 := hbad' _ hspos h1
      have e3 := hband' _ hspos h2
      have e4 := hgb _ hspos h3
      linarith
    exact ge_of_tendsto hlim hev
  unfold sternBoundary
  apply le_of_forall_pos_le_add
  intro θ hθ
  have := key θ hθ
  linarith

theorem stern_inequality_of_components [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g)
    (hR : ∀ p : M, 0 ≤ g.scalarCurvature p) (k : Fin hAF.numEnds)
    (β : M → ℝ) (Re : ℝ) (hβ : IsExteriorDomain (hAF.ends k) β Re)
    (hmin : ∀ p : M, β p = 0 → g.levelMeanCurv β p = 0)
    (u : M → ℝ) (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u)
    (hharm : ∀ p : M, 0 ≤ β p → g.lapM u p = 0)
    (hneu : ∀ p : M, β p = 0 → g.gradInner u β p = 0)
    (X Y : E3 → E3) (R₀ R₁ C : ℝ) (hXY : CoordChange X Y (min hAF.q (3 / 4)) R₀ R₁ C)
    (hRe : Re ≤ R₀)
    (hX : ∀ y : E3, R₀ < ‖y‖ → X y = cylPt (u ((hAF.ends k).Φ y)) (y 1) (y 2))
    (hdom : (∀ x : E3, R₁ < ‖x‖ →
        u (sternPsi (hAF.ends k) Y x) = x 0 ∧ 0 < β (sternPsi (hAF.ends k) Y x)) ∧
      ∀ L : ℝ, R₁ < L → IsCompact (sternDomain (hAF.ends k) β Y L) ∧
        IsOpen (sternOuter (hAF.ends k) Y L) ∧ IsClosed (sternOuterClosed (hAF.ends k) Y L) ∧
        ∀ t : ℝ, |t| < L → IsCompact (sternSide (hAF.ends k) Y L ∩ u ⁻¹' {t}))
    (hcomp : ∀ L : ℝ, R₁ < L → ∀ t : ℝ, |t| < L →
      (∀ p ∈ sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t},
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0) →
      ∀ p₀ ∈ sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t},
        (connectedComponentIn (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t}) p₀ ∩
          sternSide (hAF.ends k) Y L).Nonempty) :
    ∃ L₁ : ℝ, ∀ L : ℝ, L₁ ≤ L →
      0 ≤ sternBoundary (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L :=
by
  obtain ⟨hΨ, hdomL⟩ := hdom
  have hR02 : (2 : ℝ) ≤ R₀ := hXY.1
  have hR01 : R₀ ≤ R₁ := hXY.2.1
  have hYs : ContDiffOn ℝ ∞ Y {x : E3 | R₁ < ‖x‖} := hXY.2.2.2.2.1
  have hYX := hXY.2.2.2.2.2.1
  have hY1 : ∀ x : E3, R₁ < ‖x‖ → 1 < ‖Y x‖ := fun x hx => by
    have := (hYX x hx).1
    linarith
  have hYinj : Set.InjOn Y {x : E3 | R₁ < ‖x‖} := by
    intro a ha b hb hab
    rw [← (hYX a ha).2, ← (hYX b hb).2, hab]
  have hsrc : (hAF.ends k).Φ.source = {x : E3 | 1 < ‖x‖} := (hAF.ends k).source_eq
  have hΦc : ContinuousOn (hAF.ends k).Φ (hAF.ends k).Φ.source :=
    (hAF.ends k).Φ.contMDiffOn.continuousOn
  have hΨc : ContinuousOn (sternPsi (hAF.ends k) Y) {x : E3 | R₁ < ‖x‖} := by
    refine hΦc.comp hYs.continuousOn ?_
    intro x hx
    rw [hsrc]
    exact hY1 x hx
  have hΨinj : Set.InjOn (sternPsi (hAF.ends k) Y) {x : E3 | R₁ < ‖x‖} := by
    intro a ha b hb hab
    have h1 : Y a ∈ (hAF.ends k).Φ.source := by rw [hsrc]; exact hY1 a ha
    have h2 : Y b ∈ (hAF.ends k).Φ.source := by rw [hsrc]; exact hY1 b hb
    exact hYinj ha hb ((hAF.ends k).Φ.toPartialEquiv.injOn h1 h2 hab)
  have hnsq : ∀ x : E3, ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 + x 2 ^ 2 := by
    intro x
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  have hcyl : ∀ t a b : ℝ, (cylPt t a b) 0 = t ∧ (cylPt t a b) 1 = a ∧ (cylPt t a b) 2 = b := by
    intro t a b
    simp [cylPt, EuclideanSpace.single_apply]
  
  have hconn : ∀ L : ℝ, R₁ < L → ∀ t : ℝ, |t| < L →
      (∀ p ∈ sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t},
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0) →
      IsConnected (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t}) := by
    intro L hL t ht hreg
    have hL0 : 0 < L := by linarith
    have hbig : ∀ x : E3, L ^ 2 ≤ ‖x‖ ^ 2 → R₁ < ‖x‖ := by
      intro x hx
      have hn := norm_nonneg x
      by_contra hcon
      push_neg at hcon
      nlinarith
    set K := sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t} with hKdef
    let f : ℝ → E3 := fun s => cylPt t (L * Real.cos s) (L * Real.sin s)
    have hfc : Continuous f := by
      simp only [f, cylPt]
      fun_prop
    have hfU : ∀ s : ℝ, R₁ < ‖f s‖ := by
      intro s
      apply hbig
      rw [hnsq]
      obtain ⟨h0, h1, h2⟩ := hcyl t (L * Real.cos s) (L * Real.sin s)
      simp only [f]
      rw [h0, h1, h2]
      have := Real.cos_sq_add_sin_sq s
      nlinarith [sq_nonneg t]
    set Cc := Set.range (fun s => sternPsi (hAF.ends k) Y (f s)) with hCdef
    have hCconn : IsConnected Cc := by
      have : Set.range (fun s => sternPsi (hAF.ends k) Y (f s)) =
          (fun s => sternPsi (hAF.ends k) Y (f s)) '' Set.univ := Set.image_univ.symm
      rw [hCdef, this]
      refine isConnected_univ.image _ ?_
      exact hΨc.comp hfc.continuousOn (fun s _ => hfU s)
    have hCK : Cc ⊆ K := by
      rintro p ⟨s, rfl⟩
      obtain ⟨h0, h1, h2⟩ := hcyl t (L * Real.cos s) (L * Real.sin s)
      refine ⟨⟨?_, ?_⟩, ?_⟩
      · exact le_of_lt (hΨ (f s) (hfU s)).2
      · rintro ⟨x', hx', hxe⟩
        have hx'U : R₁ < ‖x'‖ := by
          apply hbig
          rw [hnsq]
          simp only [Set.mem_setOf_eq, not_and_or, not_le] at hx'
          rcases hx' with h | h
          · have : L ^ 2 < x' 0 ^ 2 := by
              rw [← sq_abs (x' 0)]
              exact pow_lt_pow_left₀ h hL0.le (by norm_num)
            nlinarith [sq_nonneg (x' 1), sq_nonneg (x' 2)]
          · nlinarith [sq_nonneg (x' 0)]
        have hxeq : x' = f s := hΨinj hx'U (hfU s) hxe
        apply hx'
        rw [hxeq]
        simp only [f]
        rw [h0, h1, h2]
        refine ⟨le_of_lt ht, ?_⟩
        have := Real.cos_sq_add_sin_sq s
        nlinarith
      · show u (sternPsi (hAF.ends k) Y (f s)) = t
        rw [(hΨ (f s) (hfU s)).1]
        simp only [f]
        exact h0
    have hreach : ∀ p₀ ∈ K, Cc ⊆ connectedComponentIn K p₀ := by
      intro p₀ hp₀
      obtain ⟨q, hqcomp, hqside⟩ := hcomp L hL t ht hreg p₀ hp₀
      obtain ⟨x, ⟨hx0, hx12⟩, rfl⟩ := hqside
      have hxU : R₁ < ‖x‖ := by
        apply hbig
        rw [hnsq]
        nlinarith [sq_nonneg (x 0)]
      have hqK : sternPsi (hAF.ends k) Y x ∈ K := connectedComponentIn_subset K p₀ hqcomp
      have hxt : x 0 = t := by
        have h1 : u (sternPsi (hAF.ends k) Y x) = t := hqK.2
        rw [(hΨ x hxU).1] at h1
        exact h1
      have hqC : sternPsi (hAF.ends k) Y x ∈ Cc := by
        let z : ℂ := ⟨x 1, x 2⟩
        have hz : ‖z‖ = L := by
          have h1 : ‖z‖ ^ 2 = L ^ 2 := by
            rw [Complex.sq_norm, Complex.normSq_mk]
            nlinarith
          have := norm_nonneg z
          nlinarith
        refine ⟨Complex.arg z, ?_⟩
        have hfx : f (Complex.arg z) = x := by
          obtain ⟨h0, h1, h2⟩ :=
            hcyl t (L * Real.cos (Complex.arg z)) (L * Real.sin (Complex.arg z))
          have hc : L * Real.cos (Complex.arg z) = x 1 := by
            rw [← hz]; exact Complex.norm_mul_cos_arg z
          have hs : L * Real.sin (Complex.arg z) = x 2 := by
            rw [← hz]; exact Complex.norm_mul_sin_arg z
          ext i
          fin_cases i
          · exact h0.trans hxt.symm
          · exact h1.trans hc
          · exact h2.trans hs
        show sternPsi (hAF.ends k) Y (f (Complex.arg z)) = sternPsi (hAF.ends k) Y x
        rw [hfx]
      have hsub : Cc ⊆ connectedComponentIn K (sternPsi (hAF.ends k) Y x) :=
        hCconn.isPreconnected.subset_connectedComponentIn hqC hCK
      rwa [← connectedComponentIn_eq hqcomp] at hsub
    have hc₀ : sternPsi (hAF.ends k) Y (f 0) ∈ Cc := ⟨0, rfl⟩
    have hc₀K : sternPsi (hAF.ends k) Y (f 0) ∈ K := hCK hc₀
    have hKeq : K = connectedComponentIn K (sternPsi (hAF.ends k) Y (f 0)) := by
      refine Set.Subset.antisymm ?_ (connectedComponentIn_subset _ _)
      intro p₀ hp₀
      have h1 : sternPsi (hAF.ends k) Y (f 0) ∈ connectedComponentIn K p₀ := hreach p₀ hp₀ hc₀
      rw [← connectedComponentIn_eq h1]
      exact mem_connectedComponentIn hp₀
    rw [hKeq]
    exact isConnected_connectedComponentIn_iff.mpr hc₀K
  have hharmV : ∀ x : E3, R₁ < ‖x‖ → g.lapM u (sternPsi (hAF.ends k) Y x) = 0 :=
    fun x hx => hharm _ (le_of_lt (hΨ x hx).2)
  have hchart := stern_chart_identities g (hAF.ends k) u hu X Y _ R₀ R₁ C hXY
    (fun x hx => (hΨ x hx).1) hharmV
  exact stern_integration_core g hAF hR k β Re hβ hmin u hu hharm hneu X Y R₀ R₁ C hXY hRe hX
    ⟨hΨ, hdomL⟩ hconn hchart stern_bochner_local stern_neumann_local morse_sard_E3
    level_gauss_equation

theorem stern_cylinder_inequality [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g)
    (hR : ∀ p : M, 0 ≤ g.scalarCurvature p) (k : Fin hAF.numEnds)
    (β : M → ℝ) (Re : ℝ) (hβ : IsExteriorDomain (hAF.ends k) β Re)
    (hmin : ∀ p : M, β p = 0 → g.levelMeanCurv β p = 0)
    (u : M → ℝ) (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u)
    (hharm : ∀ p : M, 0 ≤ β p → g.lapM u p = 0)
    (hneu : ∀ p : M, β p = 0 → g.gradInner u β p = 0)
    (hlev : NoCompactRegularLevel β u)
    (X Y : E3 → E3) (R₀ R₁ C : ℝ) (hXY : CoordChange X Y (min hAF.q (3 / 4)) R₀ R₁ C)
    (hRe : Re ≤ R₀)
    (hX : ∀ y : E3, R₀ < ‖y‖ → X y = cylPt (u ((hAF.ends k).Φ y)) (y 1) (y 2)) :
    ∃ L₁ : ℝ, ∀ L : ℝ, L₁ ≤ L →
      0 ≤ sternBoundary (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L :=
by
  have hq0 : 0 < min hAF.q (3 / 4) :=
    lt_min (lt_trans (by norm_num) hAF.q_gt) (by norm_num)
  have hq1 : min hAF.q (3 / 4) < 1 := lt_of_le_of_lt (min_le_right _ _) (by norm_num)
  have hesc := end_chart_escape g hAF k
  have hdom := stern_domain_facts (hAF.ends k) β u Re hβ X Y (min hAF.q (3 / 4)) R₀ R₁ C
    hq0 hq1 hXY hRe hX hesc
  have hβc : Continuous β := hβ.1.continuous
  have huc : Continuous u := hu.continuous
  have hcomp : ∀ L : ℝ, R₁ < L → ∀ t : ℝ, |t| < L →
      (∀ p ∈ sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t},
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u p ≠ 0) →
      ∀ p₀ ∈ sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t},
        (connectedComponentIn (sternDomain (hAF.ends k) β Y L ∩ u ⁻¹' {t}) p₀ ∩
          sternSide (hAF.ends k) Y L).Nonempty := by
    intro L hL t ht hreg p₀ hp₀
    exact level_components_reach_side (hAF.ends k) β u Y R₁ L t hβc huc hL ht
      (fun x hx => (hdom.1 x hx).1) (hdom.2 L hL).1 (hdom.2 L hL).2.2.1
      ((hdom.2 L hL).2.2.2 t ht) hlev hreg p₀ hp₀
  exact stern_inequality_of_components g hAF hR k β Re hβ hmin u hu hharm hneu
    X Y R₀ R₁ C hXY hRe hX hdom hcomp

theorem stern_harmonic_cylinder_bound [T2Space M] [ConnectedSpace M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hComplete : g.IsCompleteRiemannian) (hAF : AsymptoticallyFlat g)
    (hR : ∀ p : M, 0 ≤ g.scalarCurvature p) (k : Fin hAF.numEnds) :
    ∃ (R₀ R₁ C : ℝ) (X Y : E3 → E3),
      CoordChange X Y (min hAF.q (3 / 4)) R₀ R₁ C ∧
      (∀ x : E3, R₁ < ‖x‖ →
        ∑ i : Fin 3, ∑ j : Fin 3,
          (pullbackMetric (g.coeff (hAF.ends k).Φ) Y x)⁻¹ i j *
            christoffel (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) 0 i j x = 0) ∧
      ∃ L₁ : ℝ, ∀ L : ℝ, L₁ ≤ L →
        0 ≤ sternBoundary (pullbackMetric (g.coeff (hAF.ends k).Φ) Y) L :=
by
  
  have hnormsq : ∀ t a b : ℝ, ‖cylPt t a b‖ ^ 2 = t ^ 2 + a ^ 2 + b ^ 2 := by
    intro t a b
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [cylPt, e, EuclideanSpace.single_apply]
  have hnormge : ∀ t a b L : ℝ, L ^ 2 ≤ t ^ 2 + a ^ 2 + b ^ 2 → L ≤ ‖cylPt t a b‖ := by
    intro t a b L hL
    have h1 := hnormsq t a b
    have h2 : 0 ≤ ‖cylPt t a b‖ := norm_nonneg _
    nlinarith
  have hcongr : ∀ (G₁ G₂ : E3 → Matrix (Fin 3) (Fin 3) ℝ) (R : ℝ),
      (∀ x : E3, R < ‖x‖ → G₁ x = G₂ x) →
      (∀ x : E3, R < ‖x‖ → ∀ k i j : Fin 3, christoffel G₁ k i j x = christoffel G₂ k i j x) ∧
      (∀ L : ℝ, R < L → sternBoundary G₁ L = sternBoundary G₂ L) := by
    intro G₁ G₂ R h
    have hpd : ∀ x : E3, R < ‖x‖ → ∀ (F : Matrix (Fin 3) (Fin 3) ℝ → ℝ) (c : Fin 3),
        partialDeriv c (fun z => F (G₁ z)) x = partialDeriv c (fun z => F (G₂ z)) x := by
      intro x hx F c
      have hU : {y : E3 | R < ‖y‖} ∈ 𝓝 x :=
        (isOpen_lt continuous_const continuous_norm).mem_nhds hx
      have hev : (fun z => F (G₁ z)) =ᶠ[𝓝 x] (fun z => F (G₂ z)) :=
        Filter.eventually_of_mem hU (fun y hy => by simp only [h y hy])
      unfold partialDeriv
      rw [Filter.EventuallyEq.fderiv_eq hev]
    have hpd3 : ∀ x : E3, R < ‖x‖ → ∀ a b c : Fin 3,
        partialDeriv c (fun z => G₁ z a b) x = partialDeriv c (fun z => G₂ z a b) x :=
      fun x hx a b c => hpd x hx (fun A => A a b) c
    have hchr : ∀ x : E3, R < ‖x‖ → ∀ k i j : Fin 3,
        christoffel G₁ k i j x = christoffel G₂ k i j x := by
      intro x hx k i j
      simp only [christoffel, h x hx, hpd3 x hx]
    have hgrad : ∀ x : E3, R < ‖x‖ → gradVec G₁ x = gradVec G₂ x := by
      intro x hx
      have h1 : ∀ l : Fin 3, partialDeriv l (fun z => Real.sqrt ((G₁ z)⁻¹ 0 0)) x =
          partialDeriv l (fun z => Real.sqrt ((G₂ z)⁻¹ 0 0)) x :=
        fun l => hpd x hx (fun A => Real.sqrt (A⁻¹ 0 0)) l
      funext l
      simp only [gradVec, h x hx, h1]
    refine ⟨hchr, fun L hL => ?_⟩
    have hside : ∀ t s : ℝ, R < ‖cylPt t (L * Real.cos s) (L * Real.sin s)‖ := by
      intro t s
      refine lt_of_lt_of_le hL (hnormge _ _ _ _ ?_)
      have := Real.cos_sq_add_sin_sq s
      nlinarith [sq_nonneg t]
    have hcap : ∀ t ρ s : ℝ, t ^ 2 = L ^ 2 →
        R < ‖cylPt t (ρ * Real.cos s) (ρ * Real.sin s)‖ := by
      intro t ρ s ht
      refine lt_of_lt_of_le hL (hnormge _ _ _ _ ?_)
      nlinarith [sq_nonneg (ρ * Real.cos s), sq_nonneg (ρ * Real.sin s)]
    have hcurv : ∀ t s : ℝ, curvIntegrand G₁ t L s = curvIntegrand G₂ t L s := by
      intro t s
      have hP := hside t s
      simp only [curvIntegrand, h _ hP, hpd3 _ hP]
    have hgs : ∀ t s : ℝ, gradVec G₁ (cylPt t (L * Real.cos s) (L * Real.sin s)) =
        gradVec G₂ (cylPt t (L * Real.cos s) (L * Real.sin s)) :=
      fun t s => hgrad _ (hside t s)
    have hgc1 : ∀ ρ s : ℝ, gradVec G₁ (cylPt L (ρ * Real.cos s) (ρ * Real.sin s)) =
        gradVec G₂ (cylPt L (ρ * Real.cos s) (ρ * Real.sin s)) :=
      fun ρ s => hgrad _ (hcap L ρ s rfl)
    have hgc2 : ∀ ρ s : ℝ, gradVec G₁ (cylPt (-L) (ρ * Real.cos s) (ρ * Real.sin s)) =
        gradVec G₂ (cylPt (-L) (ρ * Real.cos s) (ρ * Real.sin s)) :=
      fun ρ s => hgrad _ (hcap (-L) ρ s (by ring))
    simp only [sternBoundary, curvTerm, cylFlux, capFlux, sideFlux, hcurv, hgs, hgc1, hgc2]
  
  obtain ⟨D⟩ := exterior_cover_exists g hComplete hAF hR k
  have hqeq : D.af.q = hAF.q := D.q_eq
  have hq0' : 0 < D.af.q := lt_trans (by norm_num) D.af.q_gt
  have hq'pos : 0 < min hAF.q (3 / 4) :=
    lt_min (lt_trans (by norm_num) hAF.q_gt) (by norm_num)
  have hq'lt1 : min hAF.q (3 / 4) < 1 := lt_of_le_of_lt (min_le_right _ _) (by norm_num)
  have hsrc' : (D.af.ends D.endIdx).Φ.source = {x : E3 | 1 < ‖x‖} :=
    (D.af.ends D.endIdx).source_eq
  have hsmooth' : ∀ i j : Fin 3, ContDiffOn ℝ ∞
      (fun y => D.metric.coeff (D.af.ends D.endIdx).Φ y i j) {x : E3 | 1 < ‖x‖} := by
    intro i j
    rw [← hsrc']
    exact coeff_contDiffOn_source D.metric (D.af.ends D.endIdx).Φ i j
  have hsymm' : ∀ (y : E3) (i j : Fin 3), D.metric.coeff (D.af.ends D.endIdx).Φ y i j =
      D.metric.coeff (D.af.ends D.endIdx).Φ y j i := by
    intro y i j
    exact D.metric.symm _ _ _
  obtain ⟨RG, CG, hRG1, hCG0, hbG⟩ :=
    metric_coeff_bounds (D.metric.coeff (D.af.ends D.endIdx).Φ) D.af.q hq0' hsmooth'
      (D.af.decay D.endIdx)
  
  obtain ⟨u, Ru, Cu, hReRu, hCu, hu, hharm, hneu, hend⟩ :=
    neumann_harmonic_exists D.metric D.af D.endIdx D.β D.Re D.exterior
  rw [hqeq] at hend
  have hlev : NoCompactRegularLevel D.β u :=
    no_compact_regular_level D.metric (D.af.ends D.endIdx) D.β D.Re D.exterior D.separates
      u hu hharm hneu
  
  have hR2 : (2 : ℝ) ≤ max (max Ru RG) 2 := le_max_right _ _
  have hRu : Ru ≤ max (max Ru RG) 2 := le_trans (le_max_left _ _) (le_max_left _ _)
  have hRG : RG ≤ max (max Ru RG) 2 := le_trans (le_max_right _ _) (le_max_left _ _)
  have hv : ContDiffOn ℝ ∞ (fun z => u ((D.af.ends D.endIdx).Φ z))
      {y : E3 | max (max Ru RG) 2 < ‖y‖} := by
    have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (u ∘ (D.af.ends D.endIdx).Φ)
        (D.af.ends D.endIdx).Φ.source :=
      hu.comp_contMDiffOn (D.af.ends D.endIdx).Φ.contMDiffOn
    have h2 := contMDiffOn_iff_contDiffOn.mp h1
    rw [hsrc'] at h2
    refine h2.mono ?_
    intro y hy
    show (1 : ℝ) < ‖y‖
    have : max (max Ru RG) 2 < ‖y‖ := hy
    linarith
  have hvb : ∀ y : E3, max (max Ru RG) 2 < ‖y‖ →
      |u ((D.af.ends D.endIdx).Φ y) - y 0| ≤ Cu * ‖y‖ ^ (1 - min hAF.q (3 / 4)) ∧
      (∀ i : Fin 3, |partialDeriv i (fun z => u ((D.af.ends D.endIdx).Φ z)) y
          - (if i = 0 then (1 : ℝ) else 0)| ≤ Cu * ‖y‖ ^ (-(min hAF.q (3 / 4)))) ∧
      (∀ i j : Fin 3, |partialDeriv i (fun z => partialDeriv j
          (fun w => u ((D.af.ends D.endIdx).Φ w)) z) y|
          ≤ Cu * ‖y‖ ^ (-(min hAF.q (3 / 4)) - 1)) := by
    intro y hy
    exact (hend y (lt_of_le_of_lt hRu hy)).2
  obtain ⟨R₀, R₁, C', Y, hRR₀, hXY⟩ :=
    harmonic_coord_change (fun z => u ((D.af.ends D.endIdx).Φ z)) (min hAF.q (3 / 4))
      (max (max Ru RG) 2) Cu hq'pos hq'lt1 hR2 hCu hv hvb
  
  have hgauge' := gauge_of_harmonic_first_coord (D.metric.coeff (D.af.ends D.endIdx).Φ)
    (fun z => u ((D.af.ends D.endIdx).Φ z)) (min hAF.q (3 / 4)) (max (max Ru RG) 2)
    R₀ R₁ C' Y
    (fun i j => (hsmooth' i j).mono (fun y (hy : max (max Ru RG) 2 < ‖y‖) =>
      (show (1 : ℝ) < ‖y‖ by linarith)))
    hsymm'
    (fun y hy => ne_of_gt (lt_of_lt_of_le (by norm_num)
      (hbG y (lt_of_le_of_lt hRG hy)).1))
    hv
    (fun y hy => (hend y (lt_of_le_of_lt hRu hy)).1)
    hXY hRR₀
  
  have hXY' : CoordChange (fun y => cylPt (u ((D.af.ends D.endIdx).Φ y)) (y 1) (y 2)) Y
      (min D.af.q (3 / 4)) R₀ R₁ C' := by
    rw [hqeq]; exact hXY
  obtain ⟨L₁, hstern'⟩ := stern_cylinder_inequality D.metric D.af D.scal_nonneg D.endIdx
    D.β D.Re D.exterior D.minimal u hu hharm hneu hlev _ Y R₀ R₁ C' hXY'
    (le_trans hReRu (le_trans hRu hRR₀)) (fun y _ => rfl)
  
  have hfar : ∀ x : E3, R₁ < ‖x‖ →
      pullbackMetric (g.coeff (hAF.ends k).Φ) Y x =
        pullbackMetric (D.metric.coeff (D.af.ends D.endIdx).Φ) Y x := by
    intro x hx
    have h1 : R₀ < ‖Y x‖ := (hXY.2.2.2.2.2.1 x hx).1
    have h2 : (2 : ℝ) ≤ R₀ := hXY.1
    have h3 : (1 : ℝ) < ‖Y x‖ := by linarith
    unfold pullbackMetric
    rw [D.coeff_eq (Y x) h3]
  obtain ⟨hchr, hst⟩ := hcongr _ _ R₁ hfar
  refine ⟨R₀, R₁, C', _, Y, hXY, ?_, max L₁ (R₁ + 1), ?_⟩
  · intro x hx
    rw [hfar x hx]
    simp only [hchr x hx]
    exact hgauge' x hx
  · intro L hL
    have hL1 : L₁ ≤ L := le_trans (le_max_left _ _) hL
    have hL2 : R₁ < L := by
      have := le_trans (le_max_right _ _) hL
      linarith
    rw [hst L hL2]
    exact hstern' L hL1

theorem lin3_solve_bound (E : Fin 3 → Fin 3 → ℝ) (m n : Fin 3 → ℝ) (ε ν : ℝ) (hε : ε ≤ 1 / 6)
    (hE : ∀ i j : Fin 3, |E i j| ≤ ε) (hn : ∀ i : Fin 3, |n i| ≤ ν)
    (heq : ∀ i : Fin 3, m i + ∑ j : Fin 3, E i j * m j = n i) :
    ∀ i : Fin 3, |m i| ≤ 2 * ν ∧ |m i - n i| ≤ 6 * ε * ν :=
by
  have hε0 : 0 ≤ ε := le_trans (abs_nonneg _) (hE 0 0)
  have hν0 : 0 ≤ ν := le_trans (abs_nonneg _) (hn 0)
  have hS0 : 0 ≤ |m 0| + |m 1| + |m 2| := by
    have := abs_nonneg (m 0); have := abs_nonneg (m 1); have := abs_nonneg (m 2); linarith
  have hterm : ∀ i j : Fin 3, |E i j * m j| ≤ ε * |m j| := by
    intro i j
    rw [abs_mul]
    exact mul_le_mul_of_nonneg_right (hE i j) (abs_nonneg _)
  have hdiff : ∀ i : Fin 3, |m i - n i| ≤ ε * (|m 0| + |m 1| + |m 2|) := by
    intro i
    have h := heq i
    rw [Fin.sum_univ_three] at h
    have e0 := abs_le.mp (hterm i 0)
    have e1 := abs_le.mp (hterm i 1)
    have e2 := abs_le.mp (hterm i 2)
    rw [abs_le]
    constructor <;> linarith [e0.1, e0.2, e1.1, e1.2, e2.1, e2.2]
  have hmi : ∀ i : Fin 3, |m i| ≤ ν + ε * (|m 0| + |m 1| + |m 2|) := by
    intro i
    have h1 := abs_sub_abs_le_abs_sub (m i) (n i)
    have h2 := hn i
    have h3 := hdiff i
    linarith
  have hS : |m 0| + |m 1| + |m 2| ≤ 6 * ν := by
    have a0 := hmi 0
    have a1 := hmi 1
    have a2 := hmi 2
    have hp : ε * (|m 0| + |m 1| + |m 2|) ≤ 1 / 6 * (|m 0| + |m 1| + |m 2|) :=
      mul_le_mul_of_nonneg_right hε hS0
    linarith
  have hp1 : ε * (|m 0| + |m 1| + |m 2|) ≤ ε * (6 * ν) :=
    mul_le_mul_of_nonneg_left hS hε0
  have hp2 : (6 * ε) * ν ≤ 1 * ν :=
    mul_le_mul_of_nonneg_right (by linarith) hν0
  intro i
  have h1 := hdiff i
  have h2 := hmi i
  constructor
  · linarith
  · linarith

theorem pullback_entry_algebra (B M g dg : Fin 3 → Fin 3 → ℝ) (φ η μ ν : ℝ)
    (hB : ∀ i a : Fin 3, |B i a| ≤ 2)
    (hBφ : ∀ i a : Fin 3, |B i a - (if i = a then (1 : ℝ) else 0)| ≤ φ)
    (hg : ∀ i j : Fin 3, |g i j - (if i = j then (1 : ℝ) else 0)| ≤ η) (hη : η ≤ 1)
    (hM : ∀ i a : Fin 3, |M i a| ≤ μ) (hdg : ∀ i j : Fin 3, |dg i j| ≤ ν) (a b : Fin 3) :
    |∑ i : Fin 3, ∑ j : Fin 3, B i a * g i j * B j b - (if a = b then (1 : ℝ) else 0)|
        ≤ 7 * φ + 36 * η ∧
    |∑ i : Fin 3, ∑ j : Fin 3,
        (M i a * g i j * B j b + B i a * dg i j * B j b + B i a * g i j * M j b)|
        ≤ 72 * μ + 36 * ν :=
by
  have sum3 : ∀ (f : Fin 3 → ℝ) (c : ℝ), (∀ i, |f i| ≤ c) → |∑ i, f i| ≤ 3 * c := by
    intro f c hf
    rw [Fin.sum_univ_three]
    have h0 := abs_le.mp (hf 0)
    have h1 := abs_le.mp (hf 1)
    have h2 := abs_le.mp (hf 2)
    exact abs_le.mpr ⟨by linarith, by linarith⟩
  have sum9 : ∀ (f : Fin 3 → Fin 3 → ℝ) (c : ℝ), (∀ i j, |f i j| ≤ c) →
      |∑ i, ∑ j, f i j| ≤ 9 * c := by
    intro f c hf
    have h := sum3 (fun i => ∑ j, f i j) (3 * c) (fun i => sum3 (f i) c (hf i))
    linarith
  have mul2 : ∀ (x y X Y : ℝ), |x| ≤ X → |y| ≤ Y → |x * y| ≤ X * Y := by
    intro x y X Y hx hy
    rw [abs_mul]
    exact mul_le_mul hx hy (abs_nonneg _) (le_trans (abs_nonneg _) hx)
  have mul3 : ∀ (x y z X Y Z : ℝ), |x| ≤ X → |y| ≤ Y → |z| ≤ Z → |x * y * z| ≤ X * Y * Z :=
    fun x y z X Y Z hx hy hz => mul2 _ _ _ _ (mul2 _ _ _ _ hx hy) hz
  have hg2 : ∀ i j : Fin 3, |g i j| ≤ 2 := by
    intro i j
    have h := abs_le.mp (hg i j)
    by_cases hij : i = j
    · subst hij
      rw [if_pos rfl] at h
      exact abs_le.mpr ⟨by linarith, by linarith⟩
    · rw [if_neg hij] at h
      exact abs_le.mpr ⟨by linarith, by linarith⟩
  have s4 : ∑ i : Fin 3, ∑ j : Fin 3, B i a * g i j * B j b - (if a = b then (1 : ℝ) else 0)
      = ∑ i : Fin 3, ∑ j : Fin 3, B i a * (g i j - (if i = j then (1 : ℝ) else 0)) * B j b
        + ∑ i : Fin 3, B i a * (B i b - (if i = b then (1 : ℝ) else 0))
        + (B b a - (if b = a then (1 : ℝ) else 0)) := by
    fin_cases a <;> fin_cases b <;> simp [Fin.sum_univ_three] <;> ring
  constructor
  · rw [s4]
    have T1 := sum9 (fun i j => B i a * (g i j - (if i = j then (1 : ℝ) else 0)) * B j b)
      (2 * η * 2) (fun i j => mul3 _ _ _ _ _ _ (hB i a) (hg i j) (hB j b))
    have T2 := sum3 (fun i => B i a * (B i b - (if i = b then (1 : ℝ) else 0)))
      (2 * φ) (fun i => mul2 _ _ _ _ (hB i a) (hBφ i b))
    have T3 := hBφ b a
    have e1 := abs_le.mp T1
    have e2 := abs_le.mp T2
    have e3 := abs_le.mp T3
    exact abs_le.mpr ⟨by linarith, by linarith⟩
  · have h := sum9 (fun i j =>
        M i a * g i j * B j b + B i a * dg i j * B j b + B i a * g i j * M j b)
      (μ * 2 * 2 + 2 * ν * 2 + 2 * 2 * μ) (by
        intro i j
        have u1 := abs_le.mp (mul3 _ _ _ _ _ _ (hM i a) (hg2 i j) (hB j b))
        have u2 := abs_le.mp (mul3 _ _ _ _ _ _ (hB i a) (hdg i j) (hB j b))
        have u3 := abs_le.mp (mul3 _ _ _ _ _ _ (hB i a) (hg2 i j) (hM j b))
        exact abs_le.mpr ⟨by linarith, by linarith⟩)
    linarith

theorem coordChange_norm_compare (X Y : E3 → E3) (q R₀ R₁ C : ℝ) (hq0 : 0 < q) (hq1 : q < 1)
    (hXY : CoordChange X Y q R₀ R₁ C) (x : E3) (hx : R₁ < ‖x‖) :
    R₀ < ‖Y x‖ ∧ ‖x‖ ≤ (1 + C) * ‖Y x‖ ∧ ‖Y x‖ ^ (-q) ≤ (1 + C) * ‖x‖ ^ (-q) ∧
      ‖Y x‖ ^ (-q - 1) ≤ (1 + C) ^ 2 * ‖x‖ ^ (-q - 1) :=
by
  obtain ⟨hR0, hR01, hC, -, -, hinv, -, hbd⟩ := hXY
  obtain ⟨hs0, hXYx⟩ := hinv x hx
  obtain ⟨hdisp, -, -⟩ := hbd (Y x) hs0
  rw [hXYx] at hdisp
  have hs1 : (1 : ℝ) ≤ ‖Y x‖ := by linarith
  have hrpos : 0 < ‖x‖ := by linarith
  have hκ1 : (1 : ℝ) ≤ 1 + C := by linarith
  have hκpos : (0 : ℝ) < 1 + C := by linarith
  have hpow : ‖Y x‖ ^ (1 - q) ≤ ‖Y x‖ := by
    have h := Real.rpow_le_rpow_of_exponent_le hs1 (by linarith : 1 - q ≤ 1)
    rwa [Real.rpow_one] at h
  have htri : ‖x‖ ≤ ‖Y x‖ + ‖x - Y x‖ := norm_le_insert' x (Y x)
  have hB : ‖x‖ ≤ (1 + C) * ‖Y x‖ := by
    have h := mul_le_mul_of_nonneg_left hpow hC.le
    linarith
  have hbase : ‖x‖ / (1 + C) ≤ ‖Y x‖ := by
    rw [div_le_iff₀ hκpos]; linarith
  have hbpos : 0 < ‖x‖ / (1 + C) := div_pos hrpos hκpos
  have key : ∀ a : ℝ, 0 ≤ a → ‖Y x‖ ^ (-a) ≤ ‖x‖ ^ (-a) * (1 + C) ^ a := by
    intro a ha
    have h1 := Real.rpow_le_rpow_of_nonpos hbpos hbase (by linarith : -a ≤ 0)
    rw [Real.div_rpow hrpos.le hκpos.le, Real.rpow_neg hκpos.le a, div_inv_eq_mul] at h1
    exact h1
  have hr0 : 0 ≤ ‖x‖ ^ (-q) := Real.rpow_nonneg hrpos.le _
  have hr1 : 0 ≤ ‖x‖ ^ (-q - 1) := Real.rpow_nonneg hrpos.le _
  refine ⟨hs0, hB, ?_, ?_⟩
  · have h1 := key q hq0.le
    have h2 : (1 + C) ^ q ≤ 1 + C := by
      have h := Real.rpow_le_rpow_of_exponent_le hκ1 hq1.le
      rwa [Real.rpow_one] at h
    calc ‖Y x‖ ^ (-q) ≤ ‖x‖ ^ (-q) * (1 + C) ^ q := h1
      _ ≤ ‖x‖ ^ (-q) * (1 + C) := mul_le_mul_of_nonneg_left h2 hr0
      _ = (1 + C) * ‖x‖ ^ (-q) := mul_comm _ _
  · have h1 := key (q + 1) (by linarith)
    have he : -(q + 1) = -q - 1 := by ring
    rw [he] at h1
    have h2 : (1 + C) ^ (q + 1) ≤ (1 + C) ^ (2 : ℕ) := by
      have h := Real.rpow_le_rpow_of_exponent_le hκ1 (by linarith : q + 1 ≤ 2)
      rwa [Real.rpow_two] at h
    calc ‖Y x‖ ^ (-q - 1) ≤ ‖x‖ ^ (-q - 1) * (1 + C) ^ (q + 1) := h1
      _ ≤ ‖x‖ ^ (-q - 1) * (1 + C) ^ (2 : ℕ) := mul_le_mul_of_nonneg_left h2 hr1
      _ = (1 + C) ^ 2 * ‖x‖ ^ (-q - 1) := mul_comm _ _

theorem pullback_metric_decay (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (q : ℝ) (hq0 : 0 < q) (hq1 : q < 1)
    (hsmooth : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) {y : E3 | 1 < ‖y‖})
    (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i)
    (RG CG : ℝ) (hdec : Dec1 G q RG CG)
    (X Y : E3 → E3) (R₀ R₁ C : ℝ) (hXY : CoordChange X Y q R₀ R₁ C) :
    (∀ (x : E3) (a b : Fin 3), pullbackMetric G Y x a b = pullbackMetric G Y x b a) ∧
    (∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => pullbackMetric G Y x a b) {x : E3 | R₁ < ‖x‖}) ∧
    ∃ R₂ C₂ : ℝ, R₁ ≤ R₂ ∧ 0 < C₂ ∧ Dec1 (pullbackMetric G Y) q R₂ C₂ :=
by
  have hXY' := hXY
  unfold CoordChange at hXY'
  obtain ⟨hR0, hR01, hC, hXs, hYs, hinv, hinj, hbd⟩ := hXY'
  have hreg := coordChange_regularity G hsmooth X Y q R₀ R₁ C hXY
  refine ⟨?_, hreg.1, ?_⟩
  · 
    intro x a b
    simp only [pullbackMetric]
    rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun i _ => Finset.sum_congr rfl (fun j _ => ?_))
    rw [hsymm (Y x) j i]
    ring
  
  have sum3 : ∀ (f : Fin 3 → ℝ) (b : ℝ), (∀ i, |f i| ≤ b) → |∑ i, f i| ≤ 3 * b := by
    intro f b hf
    rw [Fin.sum_univ_three]
    have h0 := abs_le.mp (hf 0)
    have h1 := abs_le.mp (hf 1)
    have h2 := abs_le.mp (hf 2)
    exact abs_le.mpr ⟨by linarith, by linarith⟩
  have mulb : ∀ (u v A B : ℝ), |u| ≤ A → |v| ≤ B → |u * v| ≤ A * B := by
    intro u v A B hu hv
    rw [abs_mul]
    exact mul_le_mul hu hv (abs_nonneg _) (le_trans (abs_nonneg _) hu)
  
  obtain ⟨K, hK⟩ : ∃ K : ℝ, K = |CG| := ⟨_, rfl⟩
  have hK0 : 0 ≤ K := by rw [hK]; exact abs_nonneg _
  have hCGK : CG ≤ K := by rw [hK]; exact le_abs_self _
  obtain ⟨κ, hκ⟩ : ∃ κ : ℝ, κ = 1 + C := ⟨_, rfl⟩
  have hκ1 : 1 ≤ κ := by rw [hκ]; linarith
  have hκ0 : 0 < κ := by linarith
  obtain ⟨T, hT⟩ : ∃ T : ℝ, T = (6 * C + K) * κ + 1 := ⟨_, rfl⟩
  have hT0 : 0 < T := by
    have : 0 ≤ (6 * C + K) * κ := mul_nonneg (by linarith) hκ0.le
    rw [hT]; linarith
  have h6CT : 6 * C * κ ≤ T := by
    have : 0 ≤ K * κ := mul_nonneg hK0 hκ0.le
    rw [hT]; nlinarith
  have hKT : K * κ ≤ T := by
    have : 0 ≤ C * κ := mul_nonneg hC.le hκ0.le
    rw [hT]; nlinarith
  refine ⟨max R₁ (max (κ * (|RG| + 1)) (T ^ (1 / q))), (5184 * C + 216 * K + 1) * κ ^ 2,
    le_max_left _ _, mul_pos (by linarith) (pow_pos hκ0 2), ?_⟩
  
  intro x hx a b
  have hxR1 : R₁ < ‖x‖ := lt_of_le_of_lt (le_max_left _ _) hx
  have hxRG : κ * (|RG| + 1) < ‖x‖ :=
    lt_of_le_of_lt (le_trans (le_max_left _ _) (le_max_right _ _)) hx
  have hxT : T ^ (1 / q) < ‖x‖ :=
    lt_of_le_of_lt (le_trans (le_max_right _ _) (le_max_right _ _)) hx
  have hTq0 : 0 < T ^ (1 / q) := Real.rpow_pos_of_pos hT0 _
  have hx0 : 0 < ‖x‖ := lt_trans hTq0 hxT
  have hu_le : ‖x‖ ^ (-q) ≤ T⁻¹ := by
    have h1 : ‖x‖ ^ (-q) ≤ (T ^ (1 / q)) ^ (-q) :=
      Real.rpow_le_rpow_of_nonpos hTq0 hxT.le (by linarith)
    have h2 : (T ^ (1 / q)) ^ (-q) = T⁻¹ := by
      rw [← Real.rpow_mul hT0.le]
      have : 1 / q * -q = -1 := by field_simp
      rw [this, Real.rpow_neg_one]
    rw [h2] at h1
    exact h1
  have hu0 : 0 ≤ ‖x‖ ^ (-q) := Real.rpow_nonneg hx0.le _
  have hv0 : 0 ≤ ‖x‖ ^ (-q - 1) := Real.rpow_nonneg hx0.le _
  have huT : ‖x‖ ^ (-q) * T ≤ 1 := by
    calc ‖x‖ ^ (-q) * T ≤ T⁻¹ * T := mul_le_mul_of_nonneg_right hu_le hT0.le
      _ = 1 := inv_mul_cancel₀ hT0.ne'
  obtain ⟨hs0, hxs, hsq, hsq1⟩ := coordChange_norm_compare X Y q R₀ R₁ C hq0 hq1 hXY x hxR1
  rw [← hκ] at hxs hsq hsq1
  have hs0' : 0 < ‖Y x‖ := by linarith
  have hw0 : 0 ≤ ‖Y x‖ ^ (-q) := Real.rpow_nonneg hs0'.le _
  have hw10 : 0 ≤ ‖Y x‖ ^ (-q - 1) := Real.rpow_nonneg hs0'.le _
  
  have hε : C * ‖Y x‖ ^ (-q) ≤ 1 / 6 := by
    have h1 : C * ‖Y x‖ ^ (-q) ≤ C * (κ * ‖x‖ ^ (-q)) := mul_le_mul_of_nonneg_left hsq hC.le
    have h3 : 6 * C * κ * ‖x‖ ^ (-q) ≤ T * ‖x‖ ^ (-q) := mul_le_mul_of_nonneg_right h6CT hu0
    linarith
  have hη : K * ‖Y x‖ ^ (-q) ≤ 1 := by
    have h1 : K * ‖Y x‖ ^ (-q) ≤ K * (κ * ‖x‖ ^ (-q)) := mul_le_mul_of_nonneg_left hsq hK0
    have h3 : K * κ * ‖x‖ ^ (-q) ≤ T * ‖x‖ ^ (-q) := mul_le_mul_of_nonneg_right hKT hu0
    linarith
  have hsRG : RG < ‖Y x‖ := by
    have h1 : κ * (|RG| + 1) < κ * ‖Y x‖ := lt_of_lt_of_le hxRG hxs
    have h2 : |RG| + 1 < ‖Y x‖ := lt_of_mul_lt_mul_left h1 hκ0.le
    linarith [le_abs_self RG]
  
  have hG0 : ∀ i j : Fin 3,
      |G (Y x) i j - (if i = j then (1 : ℝ) else 0)| ≤ K * ‖Y x‖ ^ (-q) := by
    intro i j
    exact le_trans (hdec (Y x) hsRG i j).1 (mul_le_mul_of_nonneg_right hCGK hw0)
  have hG1 : ∀ i j k : Fin 3,
      |partialDeriv k (fun w => G w i j) (Y x)| ≤ K * ‖Y x‖ ^ (-q - 1) := by
    intro i j k
    exact le_trans ((hdec (Y x) hsRG i j).2 k) (mul_le_mul_of_nonneg_right hCGK hw10)
  
  obtain ⟨hYd, hXd, hBd, hAd, hGd⟩ := hreg.2 x hxR1
  obtain ⟨hI, hII⟩ := inverse_jacobian_identities X Y {z : E3 | R₁ < ‖z‖}
    (isOpen_lt continuous_const continuous_norm) (fun z hz => (hinv z hz).2)
    (fun z hz => (hreg.2 z hz).1) (fun z hz => (hreg.2 z hz).2.1) x hxR1 hAd hBd
  obtain ⟨hXb, hA1, hA2⟩ := hbd (Y x) hs0
  
  have hBb : ∀ i a : Fin 3, |(fderiv ℝ Y x (e a)) i| ≤ 2 * 1 ∧
      |(fderiv ℝ Y x (e a)) i - (if i = a then (1 : ℝ) else 0)|
        ≤ 6 * (C * ‖Y x‖ ^ (-q)) * 1 := by
    intro i a
    refine lin3_solve_bound
      (fun d k => partialDeriv k (fun w => X w d) (Y x) - (if k = d then (1 : ℝ) else 0))
      (fun k => (fderiv ℝ Y x (e a)) k) (fun d => if d = a then (1 : ℝ) else 0)
      (C * ‖Y x‖ ^ (-q)) 1 hε ?_ ?_ ?_ i
    · intro d k
      exact hA1 k d
    · intro d
      show |(if d = a then (1 : ℝ) else 0)| ≤ 1
      split_ifs <;> simp
    · intro d
      have h := hI d a
      have hδ : ∑ k : Fin 3, (if k = d then (1 : ℝ) else 0) * (fderiv ℝ Y x (e a)) k
          = (fderiv ℝ Y x (e a)) d := by simp
      simp only [sub_mul, Finset.sum_sub_distrib, hδ, h]
      ring
  have hB2 : ∀ i a : Fin 3, |(fderiv ℝ Y x (e a)) i| ≤ 2 :=
    fun i a => (hBb i a).1.trans (le_of_eq (mul_one _))
  have hBφ : ∀ i a : Fin 3,
      |(fderiv ℝ Y x (e a)) i - (if i = a then (1 : ℝ) else 0)| ≤ 6 * (C * ‖Y x‖ ^ (-q)) :=
    fun i a => (hBb i a).2.trans (le_of_eq (mul_one _))
  
  have hMb : ∀ c i a : Fin 3, |partialDeriv c (fun z => (fderiv ℝ Y z (e a)) i) x| ≤
      2 * (36 * (C * ‖Y x‖ ^ (-q - 1))) := by
    intro c i a
    refine (lin3_solve_bound
      (fun d k => partialDeriv k (fun w => X w d) (Y x) - (if k = d then (1 : ℝ) else 0))
      (fun k => partialDeriv c (fun z => (fderiv ℝ Y z (e a)) k) x)
      (fun d => -∑ k : Fin 3, (∑ l : Fin 3, (fderiv ℝ Y x (e c)) l *
          partialDeriv l (fun z => partialDeriv k (fun w => X w d) z) (Y x)) *
          (fderiv ℝ Y x (e a)) k)
      (C * ‖Y x‖ ^ (-q)) (36 * (C * ‖Y x‖ ^ (-q - 1))) hε ?_ ?_ ?_ i).1
    · intro d k
      exact hA1 k d
    · intro d
      show |-∑ k : Fin 3, (∑ l : Fin 3, (fderiv ℝ Y x (e c)) l *
          partialDeriv l (fun z => partialDeriv k (fun w => X w d) z) (Y x)) *
          (fderiv ℝ Y x (e a)) k| ≤ 36 * (C * ‖Y x‖ ^ (-q - 1))
      rw [abs_neg]
      have h36 : (36 : ℝ) * (C * ‖Y x‖ ^ (-q - 1))
          = 3 * (3 * (2 * (C * ‖Y x‖ ^ (-q - 1))) * 2) := by ring
      rw [h36]
      apply sum3
      intro k
      apply mulb _ _ _ _ _ (hB2 k a)
      apply sum3
      intro l
      exact mulb _ _ _ _ (hB2 l c) (hA2 l k d)
    · intro d
      have h := hII c d a
      have hδ : ∑ k : Fin 3, (if k = d then (1 : ℝ) else 0) *
            partialDeriv c (fun z => (fderiv ℝ Y z (e a)) k) x
          = partialDeriv c (fun z => (fderiv ℝ Y z (e a)) d) x := by simp
      simp only [sub_mul, Finset.sum_sub_distrib, hδ]
      rw [Finset.sum_add_distrib] at h
      linarith
  have hdg : ∀ c i j : Fin 3,
      |∑ k : Fin 3, (fderiv ℝ Y x (e c)) k * partialDeriv k (fun w => G w i j) (Y x)|
        ≤ 3 * (2 * (K * ‖Y x‖ ^ (-q - 1))) := by
    intro c i j
    apply sum3
    intro k
    exact mulb _ _ _ _ (hB2 k c) (hG1 i j k)
  constructor
  · 
    have hv := (pullback_entry_algebra (fun i a => (fderiv ℝ Y x (e a)) i)
      (fun i a => partialDeriv 0 (fun z => (fderiv ℝ Y z (e a)) i) x)
      (fun i j => G (Y x) i j)
      (fun i j => ∑ k : Fin 3, (fderiv ℝ Y x (e 0)) k * partialDeriv k (fun w => G w i j) (Y x))
      (6 * (C * ‖Y x‖ ^ (-q))) (K * ‖Y x‖ ^ (-q)) (2 * (36 * (C * ‖Y x‖ ^ (-q - 1))))
      (3 * (2 * (K * ‖Y x‖ ^ (-q - 1)))) hB2 hBφ hG0 hη (hMb 0) (hdg 0) a b).1
    refine le_trans hv ?_
    have h1 : (42 * C + 36 * K) * ‖Y x‖ ^ (-q) ≤ (42 * C + 36 * K) * (κ * ‖x‖ ^ (-q)) :=
      mul_le_mul_of_nonneg_left hsq (by linarith)
    have hκκ : 0 ≤ κ ^ 2 - κ := by nlinarith
    have h2a : 0 ≤ (5184 * C + 216 * K + 1) * (κ ^ 2 - κ) :=
      mul_nonneg (by linarith) hκκ
    have h2b : 0 ≤ (5142 * C + 180 * K + 1) * κ := mul_nonneg (by linarith) hκ0.le
    have h2 : (42 * C + 36 * K) * κ ≤ (5184 * C + 216 * K + 1) * κ ^ 2 := by nlinarith
    have h3 := mul_le_mul_of_nonneg_right h2 hu0
    nlinarith
  · 
    intro c
    rw [pullbackMetric_partialDeriv G Y x hYd hBd hGd a b c]
    have hv := (pullback_entry_algebra (fun i a => (fderiv ℝ Y x (e a)) i)
      (fun i a => partialDeriv c (fun z => (fderiv ℝ Y z (e a)) i) x)
      (fun i j => G (Y x) i j)
      (fun i j => ∑ k : Fin 3, (fderiv ℝ Y x (e c)) k * partialDeriv k (fun w => G w i j) (Y x))
      (6 * (C * ‖Y x‖ ^ (-q))) (K * ‖Y x‖ ^ (-q)) (2 * (36 * (C * ‖Y x‖ ^ (-q - 1))))
      (3 * (2 * (K * ‖Y x‖ ^ (-q - 1)))) hB2 hBφ hG0 hη (hMb c) (hdg c) a b).2
    refine le_trans hv ?_
    have h1 : (5184 * C + 216 * K) * ‖Y x‖ ^ (-q - 1)
        ≤ (5184 * C + 216 * K) * (κ ^ 2 * ‖x‖ ^ (-q - 1)) :=
      mul_le_mul_of_nonneg_left hsq1 (by linarith)
    have h2 : 0 ≤ κ ^ 2 * ‖x‖ ^ (-q - 1) := mul_nonneg (sq_nonneg κ) hv0
    nlinarith

theorem det3_near_id_bound (A : Matrix (Fin 3) (Fin 3) ℝ) (ε : ℝ) (hε0 : 0 ≤ ε) (hε : ε ≤ 1 / 100)
    (hA : ∀ i j : Fin 3, |A i j - (if i = j then (1 : ℝ) else 0)| ≤ ε) :
    |A.det - 1| ≤ 4 * ε :=
by
  have e00 := hA 0 0
  have e11 := hA 1 1
  have e22 := hA 2 2
  have e01 := hA 0 1
  have e02 := hA 0 2
  have e10 := hA 1 0
  have e12 := hA 1 2
  have e20 := hA 2 0
  have e21 := hA 2 1
  rw [if_pos rfl] at e00 e11 e22
  rw [if_neg (by decide), sub_zero] at e01 e02 e10 e12 e20 e21
  have hid : A.det - 1 = ((A 0 0 - 1) + (A 1 1 - 1) + (A 2 2 - 1))
      + ((A 0 0 - 1) * (A 1 1 - 1) + (A 1 1 - 1) * (A 2 2 - 1) + (A 2 2 - 1) * (A 0 0 - 1))
      + (A 0 0 - 1) * (A 1 1 - 1) * (A 2 2 - 1)
      - A 0 0 * (A 1 2 * A 2 1) - A 2 2 * (A 0 1 * A 1 0) - A 1 1 * (A 0 2 * A 2 0)
      + A 0 1 * A 1 2 * A 2 0 + A 0 2 * A 1 0 * A 2 1 := by
    rw [Matrix.det_fin_three]; ring
  have m2 : ∀ u v : ℝ, |u| ≤ ε → |v| ≤ ε → |u * v| ≤ ε * ε := fun u v hu hv => by
    rw [abs_mul]; exact mul_le_mul hu hv (abs_nonneg _) hε0
  have m3 : ∀ u v w : ℝ, |u| ≤ ε → |v| ≤ ε → |w| ≤ ε → |u * v * w| ≤ ε * ε * ε :=
    fun u v w hu hv hw => by
      rw [abs_mul, abs_mul]
      exact mul_le_mul (mul_le_mul hu hv (abs_nonneg _) hε0) hw (abs_nonneg _)
        (mul_nonneg hε0 hε0)
  have hd : ∀ t : ℝ, |t - 1| ≤ ε → |t| ≤ 1 + ε := fun t ht => by
    have := abs_le.mp ht
    exact abs_le.mpr ⟨by linarith, by linarith⟩
  have mx : ∀ t u v : ℝ, |t - 1| ≤ ε → |u| ≤ ε → |v| ≤ ε → |t * (u * v)| ≤ ε * ε + ε * ε * ε :=
    fun t u v ht hu hv => by
      rw [abs_mul]
      have h1 := mul_le_mul (hd t ht) (m2 u v hu hv) (abs_nonneg _) (by linarith)
      linarith
  have q1 := abs_le.mp (m2 _ _ e00 e11)
  have q2 := abs_le.mp (m2 _ _ e11 e22)
  have q3 := abs_le.mp (m2 _ _ e22 e00)
  have c1 := abs_le.mp (m3 _ _ _ e00 e11 e22)
  have c2 := abs_le.mp (m3 _ _ _ e01 e12 e20)
  have c3 := abs_le.mp (m3 _ _ _ e02 e10 e21)
  have x1 := abs_le.mp (mx _ _ _ e00 e12 e21)
  have x2 := abs_le.mp (mx _ _ _ e22 e01 e10)
  have x3 := abs_le.mp (mx _ _ _ e11 e02 e20)
  have l1 := abs_le.mp e00
  have l2 := abs_le.mp e11
  have l3 := abs_le.mp e22
  have s2 : ε * ε ≤ ε / 100 := by nlinarith
  have s3 : ε * ε * ε ≤ ε / 10000 := by
    have h0 : 0 ≤ ε * ε := mul_nonneg hε0 hε0
    have : ε * ε * ε ≤ ε * ε * (1 / 100) := mul_le_mul_of_nonneg_left hε h0
    linarith
  rw [hid, abs_le]
  constructor
  · linarith [q1.1, q2.1, q3.1, c1.1, c2.1, c3.1, x1.2, x2.2, x3.2, l1.1, l2.1, l3.1]
  · linarith [q1.2, q2.2, q3.2, c1.2, c2.2, c3.2, x1.1, x2.1, x3.1, l1.2, l2.2, l3.2]

theorem gradVec_eq_formula (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (x : E3)
    (hG : ∀ a b : Fin 3, DifferentiableAt ℝ (fun y => G y a b) x)
    (hdet : (G x).det ≠ 0) (hP : 0 < (G x)⁻¹ 0 0) (k : Fin 3) :
    gradVec G x k = Real.sqrt (G x).det * ∑ l : Fin 3, (G x)⁻¹ k l *
      ((-∑ a : Fin 3, ∑ b : Fin 3,
          (G x)⁻¹ 0 a * partialDeriv l (fun y => G y a b) x * (G x)⁻¹ b 0)
        / (2 * Real.sqrt ((G x)⁻¹ 0 0))) :=
by
  
  have hinv : ∀ m k l : Fin 3, DifferentiableAt ℝ (fun y => (G y)⁻¹ k l) x ∧
      partialDeriv m (fun y => (G y)⁻¹ k l) x =
        -∑ a : Fin 3, ∑ b : Fin 3,
          (G x)⁻¹ k a * partialDeriv m (fun y => G y a b) x * (G x)⁻¹ b l := by
    intro m
    have hdetD : ∀ H : E3 → Matrix (Fin 3) (Fin 3) ℝ,
        (∀ a b : Fin 3, DifferentiableAt ℝ (fun y => H y a b) x) →
        DifferentiableAt ℝ (fun y => (H y).det) x := by
      intro H hH
      have hfun : (fun y => (H y).det) = fun y =>
          H y 0 0 * H y 1 1 * H y 2 2 - H y 0 0 * H y 1 2 * H y 2 1
          - H y 0 1 * H y 1 0 * H y 2 2 + H y 0 1 * H y 1 2 * H y 2 0
          + H y 0 2 * H y 1 0 * H y 2 1 - H y 0 2 * H y 1 1 * H y 2 0 := by
        funext y; exact Matrix.det_fin_three (H y)
      rw [hfun]
      have h00 := hH 0 0
      have h01 := hH 0 1
      have h02 := hH 0 2
      have h10 := hH 1 0
      have h11 := hH 1 1
      have h12 := hH 1 2
      have h20 := hH 2 0
      have h21 := hH 2 1
      have h22 := hH 2 2
      fun_prop
    have hD : DifferentiableAt ℝ (fun y => (G y).det) x := hdetD G hG
    have hPd : ∀ k l : Fin 3, DifferentiableAt ℝ (fun y => (G y)⁻¹ k l) x := by
      intro k l
      have hfun : (fun y => (G y)⁻¹ k l) =
          fun y => ((G y).det)⁻¹ * ((G y).updateRow l (Pi.single k 1)).det := by
        funext y
        rw [Matrix.inv_def, Matrix.smul_apply, Matrix.adjugate_apply, Ring.inverse_eq_inv,
          smul_eq_mul]
      rw [hfun]
      refine (hD.inv hdet).mul (hdetD _ ?_)
      intro a b
      by_cases hal : a = l
      · subst hal
        simp only [Matrix.updateRow_self]
        exact differentiableAt_const _
      · simp only [Matrix.updateRow_ne hal]
        exact hG a b
    have hev : ∀ᶠ y in 𝓝 x, (G y).det ≠ 0 := hD.continuousAt.eventually_ne hdet
    have hE : ∀ a l : Fin 3, ∑ b : Fin 3, G x a b * partialDeriv m (fun y => (G y)⁻¹ b l) x
        + ∑ b : Fin 3, partialDeriv m (fun y => G y a b) x * (G x)⁻¹ b l = 0 := by
      intro a l
      have h1 : HasFDerivAt (fun y => ∑ b : Fin 3, G y a b * (G y)⁻¹ b l)
          (∑ b : Fin 3, (G x a b • fderiv ℝ (fun y => (G y)⁻¹ b l) x
            + (G x)⁻¹ b l • fderiv ℝ (fun y => G y a b) x)) x := by
        have hs := HasFDerivAt.sum (u := Finset.univ)
          (A := fun b y => G y a b * (G y)⁻¹ b l)
          (fun b _ => (hG a b).hasFDerivAt.mul (hPd b l).hasFDerivAt)
        convert hs using 1
      have h2 : HasFDerivAt (fun y => ∑ b : Fin 3, G y a b * (G y)⁻¹ b l)
          (0 : E3 →L[ℝ] ℝ) x := by
        apply (hasFDerivAt_const (if a = l then (1 : ℝ) else 0) x).congr_of_eventuallyEq
        filter_upwards [hev] with y hy
        have := congrFun (congrFun (Matrix.mul_nonsing_inv (G y) (isUnit_iff_ne_zero.mpr hy)) a) l
        rw [Matrix.mul_apply, Matrix.one_apply] at this
        exact this
      have h3 := congrArg (fun L : E3 →L[ℝ] ℝ => L (e m)) (h1.unique h2)
      simp only [ContinuousLinearMap.sum_apply, ContinuousLinearMap.add_apply,
        ContinuousLinearMap.smul_apply, smul_eq_mul, ContinuousLinearMap.zero_apply] at h3
      unfold partialDeriv
      rw [← h3, ← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro b _
      ring
    intro k l
    refine ⟨hPd k l, ?_⟩
    let X : Matrix (Fin 3) (Fin 3) ℝ :=
      Matrix.of fun b l => partialDeriv m (fun y => (G y)⁻¹ b l) x
    let D : Matrix (Fin 3) (Fin 3) ℝ :=
      Matrix.of fun a b => partialDeriv m (fun y => G y a b) x
    have hM : G x * X = -(D * (G x)⁻¹) := by
      ext a l'
      rw [Matrix.mul_apply, Matrix.neg_apply, Matrix.mul_apply, eq_neg_iff_add_eq_zero]
      simp only [X, D, Matrix.of_apply]
      exact hE a l'
    have hX : X = -((G x)⁻¹ * (D * (G x)⁻¹)) := by
      calc X = ((G x)⁻¹ * G x) * X := by
            rw [Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr hdet), Matrix.one_mul]
        _ = (G x)⁻¹ * (G x * X) := Matrix.mul_assoc _ _ _
        _ = _ := by rw [hM, Matrix.mul_neg]
    have hkl := congrFun (congrFun hX k) l
    simp only [X, D, Matrix.of_apply, Matrix.neg_apply, Matrix.mul_apply] at hkl
    rw [hkl]
    congr 1
    apply Finset.sum_congr rfl
    intro a _
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro b _
    ring
  
  have key : ∀ l : Fin 3, partialDeriv l (fun z => Real.sqrt ((G z)⁻¹ 0 0)) x =
      (-∑ a : Fin 3, ∑ b : Fin 3,
          (G x)⁻¹ 0 a * partialDeriv l (fun y => G y a b) x * (G x)⁻¹ b 0)
        / (2 * Real.sqrt ((G x)⁻¹ 0 0)) := by
    intro l
    obtain ⟨hf, hfl⟩ := hinv l 0 0
    have h2 := fderiv_sqrt (f := fun y => (G y)⁻¹ 0 0) hf hP.ne'
    rw [← hfl]
    unfold partialDeriv
    rw [h2, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  
  unfold gradVec
  congr 1
  exact Finset.sum_congr rfl (fun l _ => by rw [key l])

theorem gradVec_formula_bound (P : Matrix (Fin 3) (Fin 3) ℝ) (d : Fin 3 → Fin 3 → Fin 3 → ℝ)
    (D ε δ : ℝ) (hε0 : 0 ≤ ε) (hε : ε ≤ 1 / 100) (hδ : 0 ≤ δ)
    (hPb : ∀ k l : Fin 3, |P k l| ≤ 5)
    (hPe : ∀ k l : Fin 3, |P k l - (if k = l then (1 : ℝ) else 0)| ≤ 13 * ε)
    (hD : |D - 1| ≤ 4 * ε) (hd : ∀ m a b : Fin 3, |d m a b| ≤ δ) (k : Fin 3) :
    |Real.sqrt D * ∑ l : Fin 3, P k l *
        ((-∑ a : Fin 3, ∑ b : Fin 3, P 0 a * d l a b * P b 0) / (2 * Real.sqrt (P 0 0)))
      + (1 / 2 : ℝ) * d k 0 0| ≤ 20000 * ε * δ :=
by
  have hεδ : 0 ≤ ε * δ := mul_nonneg hε0 hδ
  
  have tri : ∀ x y z X Y Z : ℝ, |x| ≤ X → |y| ≤ Y → |z| ≤ Z → |x * y * z| ≤ X * Y * Z := by
    intro x y z X Y Z hx hy hz
    have hX : 0 ≤ X := le_trans (abs_nonneg _) hx
    have hY : 0 ≤ Y := le_trans (abs_nonneg _) hy
    rw [abs_mul, abs_mul]
    exact mul_le_mul (mul_le_mul hx hy (abs_nonneg _) hX) hz (abs_nonneg _) (mul_nonneg hX hY)
  
  have e00 : |P 0 0 - 1| ≤ 13 * ε := by
    have h := hPe 0 0; rwa [if_pos rfl] at h
  have o01 : |P 0 1| ≤ 13 * ε := by
    have h := hPe 0 1; rwa [if_neg (by decide), sub_zero] at h
  have o02 : |P 0 2| ≤ 13 * ε := by
    have h := hPe 0 2; rwa [if_neg (by decide), sub_zero] at h
  have o10 : |P 1 0| ≤ 13 * ε := by
    have h := hPe 1 0; rwa [if_neg (by decide), sub_zero] at h
  have o20 : |P 2 0| ≤ 13 * ε := by
    have h := hPe 2 0; rwa [if_neg (by decide), sub_zero] at h
  
  have quad : ∀ M : Fin 3 → Fin 3 → ℝ, (∀ a b : Fin 3, |M a b| ≤ δ) →
      |(∑ a : Fin 3, ∑ b : Fin 3, P 0 a * M a b * P b 0) - M 0 0| ≤ 702 * ε * δ ∧
      |∑ a : Fin 3, ∑ b : Fin 3, P 0 a * M a b * P b 0| ≤ 225 * δ := by
    intro M hM
    have t00 : |P 0 0 * M 0 0 * P 0 0 - M 0 0| ≤ 78 * ε * δ := by
      have h1 := tri _ _ _ _ _ _ e00 (hM 0 0) (hPb 0 0)
      have h2 : |M 0 0 * (P 0 0 - 1)| ≤ δ * (13 * ε) := by
        rw [abs_mul]; exact mul_le_mul (hM 0 0) e00 (abs_nonneg _) hδ
      have eq : P 0 0 * M 0 0 * P 0 0 - M 0 0
          = (P 0 0 - 1) * M 0 0 * P 0 0 + M 0 0 * (P 0 0 - 1) := by ring
      rw [eq]
      calc |(P 0 0 - 1) * M 0 0 * P 0 0 + M 0 0 * (P 0 0 - 1)|
          ≤ |(P 0 0 - 1) * M 0 0 * P 0 0| + |M 0 0 * (P 0 0 - 1)| := abs_add_le _ _
        _ ≤ 13 * ε * δ * 5 + δ * (13 * ε) := add_le_add h1 h2
        _ = 78 * ε * δ := by ring
    obtain ⟨a00, b00⟩ := abs_le.mp t00
    obtain ⟨a01, b01⟩ := abs_le.mp (tri _ _ _ _ _ _ (hPb 0 0) (hM 0 1) o10)
    obtain ⟨a02, b02⟩ := abs_le.mp (tri _ _ _ _ _ _ (hPb 0 0) (hM 0 2) o20)
    obtain ⟨a10, b10⟩ := abs_le.mp (tri _ _ _ _ _ _ o01 (hM 1 0) (hPb 0 0))
    obtain ⟨a11, b11⟩ := abs_le.mp (tri _ _ _ _ _ _ o01 (hM 1 1) (hPb 1 0))
    obtain ⟨a12, b12⟩ := abs_le.mp (tri _ _ _ _ _ _ o01 (hM 1 2) (hPb 2 0))
    obtain ⟨a20, b20⟩ := abs_le.mp (tri _ _ _ _ _ _ o02 (hM 2 0) (hPb 0 0))
    obtain ⟨a21, b21⟩ := abs_le.mp (tri _ _ _ _ _ _ o02 (hM 2 1) (hPb 1 0))
    obtain ⟨a22, b22⟩ := abs_le.mp (tri _ _ _ _ _ _ o02 (hM 2 2) (hPb 2 0))
    obtain ⟨c00, d00⟩ := abs_le.mp (tri _ _ _ _ _ _ (hPb 0 0) (hM 0 0) (hPb 0 0))
    obtain ⟨c01, d01⟩ := abs_le.mp (tri _ _ _ _ _ _ (hPb 0 0) (hM 0 1) (hPb 1 0))
    obtain ⟨c02, d02⟩ := abs_le.mp (tri _ _ _ _ _ _ (hPb 0 0) (hM 0 2) (hPb 2 0))
    obtain ⟨c10, d10⟩ := abs_le.mp (tri _ _ _ _ _ _ (hPb 0 1) (hM 1 0) (hPb 0 0))
    obtain ⟨c11, d11⟩ := abs_le.mp (tri _ _ _ _ _ _ (hPb 0 1) (hM 1 1) (hPb 1 0))
    obtain ⟨c12, d12⟩ := abs_le.mp (tri _ _ _ _ _ _ (hPb 0 1) (hM 1 2) (hPb 2 0))
    obtain ⟨c20, d20⟩ := abs_le.mp (tri _ _ _ _ _ _ (hPb 0 2) (hM 2 0) (hPb 0 0))
    obtain ⟨c21, d21⟩ := abs_le.mp (tri _ _ _ _ _ _ (hPb 0 2) (hM 2 1) (hPb 1 0))
    obtain ⟨c22, d22⟩ := abs_le.mp (tri _ _ _ _ _ _ (hPb 0 2) (hM 2 2) (hPb 2 0))
    simp only [Fin.sum_univ_three]
    refine ⟨abs_le.mpr ⟨?_, ?_⟩, abs_le.mpr ⟨?_, ?_⟩⟩
    · linarith
    · linarith
    · linarith
    · linarith
  
  have row : ∀ S : Fin 3 → ℝ, (∀ l, |S l - d l 0 0| ≤ 702 * ε * δ) → (∀ l, |S l| ≤ 225 * δ) →
      |∑ l : Fin 3, P k l * S l - d k 0 0| ≤ 9477 * ε * δ := by
    intro S h1 h2
    have hI : ∑ l : Fin 3, (if k = l then (1 : ℝ) else 0) * S l = S k := by
      simp
    have eq : ∑ l : Fin 3, P k l * S l - d k 0 0
        = ∑ l : Fin 3, (P k l - (if k = l then (1 : ℝ) else 0)) * S l + (S k - d k 0 0) := by
      simp only [sub_mul, Finset.sum_sub_distrib, hI]; ring
    rw [eq]
    have hr : ∀ l : Fin 3, |(P k l - (if k = l then (1 : ℝ) else 0)) * S l| ≤ 13 * ε * (225 * δ) := by
      intro l
      rw [abs_mul]
      exact mul_le_mul (hPe k l) (h2 l) (abs_nonneg _) (by linarith)
    refine le_trans (abs_add_le _ _) ?_
    have hs1 := Finset.abs_sum_le_sum_abs
      (fun l : Fin 3 => (P k l - (if k = l then (1 : ℝ) else 0)) * S l) Finset.univ
    have hs2 : ∑ l : Fin 3, |(P k l - (if k = l then (1 : ℝ) else 0)) * S l|
        ≤ ∑ _l : Fin 3, 13 * ε * (225 * δ) := Finset.sum_le_sum (fun l _ => hr l)
    have hs3 : ∑ _l : Fin 3, 13 * ε * (225 * δ) = 3 * (13 * ε * (225 * δ)) := by
      simp only [Fin.sum_univ_three]; ring
    have hk := h1 k
    linarith
  
  have fin : ∀ T : ℝ, |T - d k 0 0| ≤ 9477 * ε * δ →
      |Real.sqrt D * (-T / (2 * Real.sqrt (P 0 0))) + (1 / 2 : ℝ) * d k 0 0| ≤ 20000 * ε * δ := by
    intro T hT
    have hu := hd k 0 0
    obtain ⟨hD1, hD2⟩ := abs_le.mp hD
    obtain ⟨hq1, hq2⟩ := abs_le.mp e00
    have hD0 : 0 ≤ D := by linarith
    have hq0 : 0 ≤ P 0 0 := by linarith
    have hs0 := Real.sqrt_nonneg D
    have hp0 := Real.sqrt_nonneg (P 0 0)
    have hs2 : Real.sqrt D ^ 2 = D := Real.sq_sqrt hD0
    have hp2 : Real.sqrt (P 0 0) ^ 2 = P 0 0 := Real.sq_sqrt hq0
    have hs1 : |Real.sqrt D - 1| ≤ 4 * ε := by
      have e : (Real.sqrt D - 1) * (Real.sqrt D + 1) = D - 1 := by linear_combination hs2
      have e2 : |Real.sqrt D - 1| * (Real.sqrt D + 1) = |D - 1| := by
        rw [← e, abs_mul, abs_of_nonneg (by linarith : (0 : ℝ) ≤ Real.sqrt D + 1)]
      have e3 : |Real.sqrt D - 1| ≤ |Real.sqrt D - 1| * (Real.sqrt D + 1) :=
        le_mul_of_one_le_right (abs_nonneg _) (by linarith)
      linarith
    have hp1 : |Real.sqrt (P 0 0) - 1| ≤ 13 * ε := by
      have e : (Real.sqrt (P 0 0) - 1) * (Real.sqrt (P 0 0) + 1) = P 0 0 - 1 := by
        linear_combination hp2
      have e2 : |Real.sqrt (P 0 0) - 1| * (Real.sqrt (P 0 0) + 1) = |P 0 0 - 1| := by
        rw [← e, abs_mul, abs_of_nonneg (by linarith : (0 : ℝ) ≤ Real.sqrt (P 0 0) + 1)]
      have e3 : |Real.sqrt (P 0 0) - 1| ≤ |Real.sqrt (P 0 0) - 1| * (Real.sqrt (P 0 0) + 1) :=
        le_mul_of_one_le_right (abs_nonneg _) (by linarith)
      linarith
    obtain ⟨hs1a, hs1b⟩ := abs_le.mp hs1
    obtain ⟨hp1a, hp1b⟩ := abs_le.mp hp1
    have hp_pos : 0 < Real.sqrt (P 0 0) := by linarith
    have hpne : Real.sqrt (P 0 0) ≠ 0 := ne_of_gt hp_pos
    have hps : |Real.sqrt (P 0 0) - Real.sqrt D| ≤ 17 * ε :=
      abs_le.mpr ⟨by linarith, by linarith⟩
    have key : Real.sqrt D * (-T / (2 * Real.sqrt (P 0 0))) + (1 / 2 : ℝ) * d k 0 0
        = ((Real.sqrt (P 0 0) - Real.sqrt D) * d k 0 0 - Real.sqrt D * (T - d k 0 0))
          / (2 * Real.sqrt (P 0 0)) := by
      field_simp
      ring
    have h2p : 0 < 2 * Real.sqrt (P 0 0) := by linarith
    rw [key, abs_div, abs_of_pos h2p, div_le_iff₀ h2p]
    have a1 : |(Real.sqrt (P 0 0) - Real.sqrt D) * d k 0 0| ≤ 17 * ε * δ := by
      rw [abs_mul]; exact mul_le_mul hps hu (abs_nonneg _) (by linarith)
    have a2 : |Real.sqrt D * (T - d k 0 0)| ≤ 2 * (9477 * ε * δ) := by
      rw [abs_mul, abs_of_nonneg hs0]
      exact mul_le_mul (by linarith) hT (abs_nonneg _) (by norm_num)
    have hN := abs_sub ((Real.sqrt (P 0 0) - Real.sqrt D) * d k 0 0) (Real.sqrt D * (T - d k 0 0))
    have hN2 : 0 ≤ 20000 * ε * δ * (2 * Real.sqrt (P 0 0) - 1) := by
      have : 0 ≤ 2 * Real.sqrt (P 0 0) - 1 := by linarith
      have h3 : 0 ≤ 20000 * ε * δ := by linarith
      exact mul_nonneg h3 this
    linarith
  
  have hq : ∀ l : Fin 3,
      |(∑ a : Fin 3, ∑ b : Fin 3, P 0 a * d l a b * P b 0) - d l 0 0| ≤ 702 * ε * δ ∧
      |∑ a : Fin 3, ∑ b : Fin 3, P 0 a * d l a b * P b 0| ≤ 225 * δ :=
    fun l => quad (d l) (hd l)
  have hT : |∑ l : Fin 3, P k l * (∑ a : Fin 3, ∑ b : Fin 3, P 0 a * d l a b * P b 0)
      - d k 0 0| ≤ 9477 * ε * δ :=
    row (fun l => ∑ a : Fin 3, ∑ b : Fin 3, P 0 a * d l a b * P b 0)
      (fun l => (hq l).1) (fun l => (hq l).2)
  have hsum : ∑ l : Fin 3, P k l *
        ((-∑ a : Fin 3, ∑ b : Fin 3, P 0 a * d l a b * P b 0) / (2 * Real.sqrt (P 0 0)))
      = -(∑ l : Fin 3, P k l * (∑ a : Fin 3, ∑ b : Fin 3, P 0 a * d l a b * P b 0))
          / (2 * Real.sqrt (P 0 0)) := by
    simp only [Fin.sum_univ_three]
    ring
  rw [hsum]
  exact fin _ hT

theorem gauge_trace_linear_bound (P : Matrix (Fin 3) (Fin 3) ℝ) (d : Fin 3 → Fin 3 → Fin 3 → ℝ)
    (ε δ : ℝ) (hε0 : 0 ≤ ε) (hδ : 0 ≤ δ)
    (hPb : ∀ k l : Fin 3, |P k l| ≤ 5)
    (hPe : ∀ k l : Fin 3, |P k l - (if k = l then (1 : ℝ) else 0)| ≤ 13 * ε)
    (hd : ∀ m a b : Fin 3, |d m a b| ≤ δ) :
    |∑ i : Fin 3, ∑ j : Fin 3, P i j *
        ((1 / 2 : ℝ) * ∑ l : Fin 3, P 0 l * (d i j l + d j i l - d l i j))
      - (∑ i : Fin 3, d i i 0 - (1 / 2 : ℝ) * ∑ i : Fin 3, d 0 i i)| ≤ 4000 * ε * δ :=
by
  have hT : ∀ i j l : Fin 3, |d i j l + d j i l - d l i j| ≤ 3 * δ := by
    intro i j l
    have h1 := abs_le.mp (hd i j l)
    have h2 := abs_le.mp (hd j i l)
    have h3 := abs_le.mp (hd l i j)
    rw [abs_le]
    constructor <;> linarith [h1.1, h1.2, h2.1, h2.2, h3.1, h3.2]
  have hI1 : ∀ i j : Fin 3, |(if i = j then (1 : ℝ) else 0)| ≤ 1 := by
    intro i j
    split_ifs <;> simp
  have hc : ∀ i j l : Fin 3, |P i j * P 0 l - (if i = j then (1 : ℝ) else 0) *
      (if (0 : Fin 3) = l then (1 : ℝ) else 0)| ≤ 78 * ε := by
    intro i j l
    have e : P i j * P 0 l - (if i = j then (1 : ℝ) else 0) *
        (if (0 : Fin 3) = l then (1 : ℝ) else 0) =
        (P i j - (if i = j then (1 : ℝ) else 0)) * P 0 l +
          (if i = j then (1 : ℝ) else 0) * (P 0 l - (if (0 : Fin 3) = l then (1 : ℝ) else 0)) := by
      ring
    rw [e]
    calc _ ≤ |(P i j - (if i = j then (1 : ℝ) else 0)) * P 0 l| +
          |(if i = j then (1 : ℝ) else 0) * (P 0 l - (if (0 : Fin 3) = l then (1 : ℝ) else 0))| :=
          abs_add_le _ _
      _ = |P i j - (if i = j then (1 : ℝ) else 0)| * |P 0 l| +
          |(if i = j then (1 : ℝ) else 0)| * |P 0 l - (if (0 : Fin 3) = l then (1 : ℝ) else 0)| := by
          rw [abs_mul, abs_mul]
      _ ≤ (13 * ε) * 5 + 1 * (13 * ε) :=
          add_le_add (mul_le_mul (hPe i j) (hPb 0 l) (abs_nonneg _) (by linarith))
            (mul_le_mul (hI1 i j) (hPe 0 l) (abs_nonneg _) zero_le_one)
      _ = 78 * ε := by ring
  have hF : ∀ i j l : Fin 3, |(1 / 2 : ℝ) * (P i j * P 0 l - (if i = j then (1 : ℝ) else 0) *
      (if (0 : Fin 3) = l then (1 : ℝ) else 0)) * (d i j l + d j i l - d l i j)| ≤
      117 * ε * δ := by
    intro i j l
    rw [abs_mul, abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 1 / 2)]
    calc _ ≤ (1 / 2 : ℝ) * (78 * ε) * (3 * δ) :=
          mul_le_mul (mul_le_mul_of_nonneg_left (hc i j l) (by norm_num)) (hT i j l)
            (abs_nonneg _) (by positivity)
      _ = 117 * ε * δ := by ring
  have key : ∑ i : Fin 3, ∑ j : Fin 3, P i j *
        ((1 / 2 : ℝ) * ∑ l : Fin 3, P 0 l * (d i j l + d j i l - d l i j))
      - (∑ i : Fin 3, d i i 0 - (1 / 2 : ℝ) * ∑ i : Fin 3, d 0 i i) =
      ∑ i : Fin 3, ∑ j : Fin 3, ∑ l : Fin 3,
        (1 / 2 : ℝ) * (P i j * P 0 l - (if i = j then (1 : ℝ) else 0) *
          (if (0 : Fin 3) = l then (1 : ℝ) else 0)) * (d i j l + d j i l - d l i j) := by
    simp only [Fin.sum_univ_three, Fin.isValue, Fin.reduceEq, if_true, if_false]
    ring
  rw [key]
  calc _ ≤ ∑ i : Fin 3, |∑ j : Fin 3, ∑ l : Fin 3,
        (1 / 2 : ℝ) * (P i j * P 0 l - (if i = j then (1 : ℝ) else 0) *
          (if (0 : Fin 3) = l then (1 : ℝ) else 0)) * (d i j l + d j i l - d l i j)| :=
        Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ i : Fin 3, ∑ j : Fin 3, ∑ l : Fin 3,
        |(1 / 2 : ℝ) * (P i j * P 0 l - (if i = j then (1 : ℝ) else 0) *
          (if (0 : Fin 3) = l then (1 : ℝ) else 0)) * (d i j l + d j i l - d l i j)| := by
        gcongr with i _
        refine (Finset.abs_sum_le_sum_abs _ _).trans ?_
        gcongr with j _
        exact Finset.abs_sum_le_sum_abs _ _
    _ ≤ ∑ i : Fin 3, ∑ j : Fin 3, ∑ l : Fin 3, 117 * ε * δ := by
        gcongr with i _ j _ l _
        exact hF i j l
    _ = 3159 * ε * δ := by
        simp only [Fin.sum_univ_three]
        ring
    _ ≤ 4000 * ε * δ := by nlinarith [mul_nonneg hε0 hδ]

theorem gradVec_continuousOn (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (R R' : ℝ) (hRR' : R ≤ R')
    (hsmooth : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => G x a b) {x : E3 | R < ‖x‖})
    (hpos : ∀ x : E3, R' < ‖x‖ → (G x).det ≠ 0 ∧ 0 < (G x)⁻¹ 0 0) :
    (∀ a b k : Fin 3,
      ContinuousOn (fun x => partialDeriv k (fun z => G z a b) x) {x : E3 | R < ‖x‖}) ∧
    (∀ k : Fin 3, ContinuousOn (fun x => gradVec G x k) {x : E3 | R' < ‖x‖}) :=
by
  have h1inf : (1 : WithTop ℕ∞) ≤ ∞ := by
    exact_mod_cast le_top
  
  have hpd : ∀ (f : E3 → ℝ) (s : Set E3), IsOpen s → ContDiffOn ℝ ∞ f s →
      ∀ k : Fin 3, ContinuousOn (fun x => partialDeriv k f x) s := by
    intro f s hs hf k
    have hc : ContinuousOn (fderiv ℝ f) s := hf.continuousOn_fderiv_of_isOpen hs h1inf
    exact hc.clm_apply continuousOn_const
  have hU : IsOpen {x : E3 | R < ‖x‖} := isOpen_lt continuous_const continuous_norm
  have hV : IsOpen {x : E3 | R' < ‖x‖} := isOpen_lt continuous_const continuous_norm
  have hVU : {x : E3 | R' < ‖x‖} ⊆ {x : E3 | R < ‖x‖} := fun x hx =>
    lt_of_le_of_lt hRR' hx
  refine ⟨fun a b k => hpd _ _ hU (hsmooth a b) k, ?_⟩
  have hGV : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => G x a b) {x : E3 | R' < ‖x‖} :=
    fun a b => (hsmooth a b).mono hVU
  have h00 := hGV 0 0
  have h01 := hGV 0 1
  have h02 := hGV 0 2
  have h10 := hGV 1 0
  have h11 := hGV 1 1
  have h12 := hGV 1 2
  have h20 := hGV 2 0
  have h21 := hGV 2 1
  have h22 := hGV 2 2
  have hdetS : ContDiffOn ℝ ∞ (fun x => (G x).det) {x : E3 | R' < ‖x‖} := by
    simp only [Matrix.det_fin_three]
    fun_prop
  have hdetinv : ContDiffOn ℝ ∞ (fun x => ((G x).det)⁻¹) {x : E3 | R' < ‖x‖} :=
    hdetS.inv (fun x hx => (hpos x hx).1)
  have hadj : ∀ k l : Fin 3,
      ContDiffOn ℝ ∞ (fun x => (G x).adjugate k l) {x : E3 | R' < ‖x‖} := by
    intro k l
    fin_cases k <;> fin_cases l <;> simp [Matrix.adjugate_fin_three] <;> fun_prop
  have hPS : ∀ k l : Fin 3,
      ContDiffOn ℝ ∞ (fun x => (G x)⁻¹ k l) {x : E3 | R' < ‖x‖} := by
    intro k l
    refine ((hdetinv).mul (hadj k l)).congr ?_
    intro x _
    rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv']
  have hhS : ContDiffOn ℝ ∞ (fun z => Real.sqrt ((G z)⁻¹ 0 0)) {x : E3 | R' < ‖x‖} :=
    (hPS 0 0).sqrt (fun x hx => (hpos x hx).2.ne')
  have c1 : ContinuousOn (fun x => Real.sqrt (G x).det) {x : E3 | R' < ‖x‖} :=
    hdetS.continuousOn.sqrt
  have c3 : ∀ l : Fin 3, ContinuousOn
      (fun x => partialDeriv l (fun z => Real.sqrt ((G z)⁻¹ 0 0)) x) {x : E3 | R' < ‖x‖} :=
    fun l => hpd _ _ hV hhS l
  intro k
  show ContinuousOn (fun x => Real.sqrt (G x).det *
    ∑ l : Fin 3, (G x)⁻¹ k l * partialDeriv l (fun z => Real.sqrt ((G z)⁻¹ 0 0)) x) _
  exact c1.mul (continuousOn_finset_sum Finset.univ
    (fun l _ => ((hPS k l).continuousOn).mul (c3 l)))

theorem cyl_cap_side_identity (a b : E3 → ℝ) (R L : ℝ) (hR : 0 ≤ R) (hRL : R < L)
    (ha : ContDiffOn ℝ ∞ a {x : E3 | R < ‖x‖}) (hb : ContDiffOn ℝ ∞ b {x : E3 | R < ‖x‖}) :
    capFlux (fun x => ![partialDeriv 1 a x + partialDeriv 2 b x, 0, 0]) L =
      sideFlux (fun x => ![0, partialDeriv 0 a x, partialDeriv 0 b x]) L :=
by
  
  have t_norm : ∀ t y z : ℝ, ‖cylPt t y z‖ = Real.sqrt (t ^ 2 + y ^ 2 + z ^ 2) := by
    intro t y z
    rw [EuclideanSpace.norm_eq, Fin.sum_univ_three]
    simp [cylPt, EuclideanSpace.single_apply, Real.norm_eq_abs, sq_abs]
  
  have t_swap : ∀ (f : ℝ → ℝ → ℝ), Continuous (Function.uncurry f) → ∀ a₀ b₀ c₀ d₀ : ℝ,
      ∫ x in a₀..b₀, ∫ y in c₀..d₀, f x y = ∫ y in c₀..d₀, ∫ x in a₀..b₀, f x y := by
    intro f hf a₀ b₀ c₀ d₀
    have hint : Integrable (Function.uncurry f)
        ((volume.restrict (Set.uIoc a₀ b₀)).prod (volume.restrict (Set.uIoc c₀ d₀))) := by
      rw [Measure.prod_restrict, ← Measure.volume_eq_prod]
      exact (hf.continuousOn.integrableOn_compact (isCompact_uIcc.prod isCompact_uIcc)).mono_set
        (Set.prod_mono Set.uIoc_subset_uIcc Set.uIoc_subset_uIcc)
    have h1 : ∀ x, ∫ y in c₀..d₀, f x y =
        (if c₀ ≤ d₀ then (1:ℝ) else -1) • ∫ y in Set.uIoc c₀ d₀, f x y :=
      fun x => intervalIntegral.intervalIntegral_eq_integral_uIoc _ _ _ _
    simp only [h1]
    rw [intervalIntegral.integral_smul, MeasureTheory.intervalIntegral_integral_swap hint]
    conv_rhs => rw [intervalIntegral.intervalIntegral_eq_integral_uIoc]
  
  have t_shell : ∀ f : E3 → ℝ, ContDiffOn ℝ ∞ f {x : E3 | R < ‖x‖} →
      ContinuousOn f {x : E3 | R < ‖x‖} ∧
      (∀ x : E3, R < ‖x‖ → HasFDerivAt f (fderiv ℝ f x) x) ∧
      (∀ i : Fin 3, ContinuousOn (fun x => partialDeriv i f x) {x : E3 | R < ‖x‖}) := by
    intro f hf
    have hU : IsOpen {x : E3 | R < ‖x‖} := isOpen_lt continuous_const continuous_norm
    refine ⟨hf.continuousOn, fun x hx => ?_, fun i => ?_⟩
    · exact ((hf.differentiableOn (by simp)).differentiableAt (hU.mem_nhds hx)).hasFDerivAt
    · exact (hf.continuousOn_fderiv_of_isOpen hU (by simp)).clm_apply continuousOn_const
  
  have t_cont : ∀ {α : Type} [TopologicalSpace α] (f : E3 → ℝ),
      ContinuousOn f {x : E3 | R < ‖x‖} → ∀ (T Y Z : α → ℝ),
      Continuous T → Continuous Y → Continuous Z →
      (∀ p : α, R < ‖cylPt (T p) (Y p) (Z p)‖) →
      Continuous (fun p => f (cylPt (T p) (Y p) (Z p))) := by
    intro α _ f hf T Y Z hT hY hZ hmem
    have hc : Continuous (fun p => cylPt (T p) (Y p) (Z p)) := by
      unfold cylPt
      fun_prop
    exact hf.comp_continuous hc hmem
  
  have t_chain : ∀ (f : E3 → ℝ) (T Y Z : ℝ → ℝ) (T' Y' Z' u : ℝ),
      HasDerivAt T T' u → HasDerivAt Y Y' u → HasDerivAt Z Z' u →
      HasFDerivAt f (fderiv ℝ f (cylPt (T u) (Y u) (Z u))) (cylPt (T u) (Y u) (Z u)) →
      HasDerivAt (fun v => f (cylPt (T v) (Y v) (Z v)))
        (T' * partialDeriv 0 f (cylPt (T u) (Y u) (Z u))
          + Y' * partialDeriv 1 f (cylPt (T u) (Y u) (Z u))
          + Z' * partialDeriv 2 f (cylPt (T u) (Y u) (Z u))) u := by
    intro f T Y Z T' Y' Z' u hT hY hZ hf
    have hγ : HasDerivAt (fun v => cylPt (T v) (Y v) (Z v))
        (T' • e 0 + Y' • e 1 + Z' • e 2) u := by
      unfold cylPt
      exact ((hT.smul_const (e 0)).add (hY.smul_const (e 1))).add (hZ.smul_const (e 2))
    have h := hf.comp_hasDerivAt u hγ
    convert h using 1
    simp only [partialDeriv, map_add, map_smul, smul_eq_mul]
  
  have t_cap : ∀ c M : ℝ, R < |c| →
      ∫ ρ in (0 : ℝ)..M, ∫ s in (0 : ℝ)..(2 * Real.pi),
          (partialDeriv 1 a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))
            + partialDeriv 2 b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))) * ρ =
        ∫ s in (0 : ℝ)..(2 * Real.pi),
          (a (cylPt c (M * Real.cos s) (M * Real.sin s)) * Real.cos s
            + b (cylPt c (M * Real.cos s) (M * Real.sin s)) * Real.sin s) * M := by
    intro c M hc
    obtain ⟨haC, haD, haP⟩ := t_shell a ha
    obtain ⟨hbC, hbD, hbP⟩ := t_shell b hb
    have hc2 : R ^ 2 < c ^ 2 := by
      rw [← sq_abs c]; exact pow_lt_pow_left₀ hc hR (by norm_num)
    have hmem : ∀ y z : ℝ, R < ‖cylPt c y z‖ := by
      intro y z
      rw [t_norm]
      exact (Real.lt_sqrt hR).mpr (by nlinarith [sq_nonneg y, sq_nonneg z])
    have cq : ∀ f : E3 → ℝ, ContinuousOn f {x : E3 | R < ‖x‖} →
        Continuous (fun q : ℝ × ℝ => f (cylPt c (q.1 * Real.cos q.2) (q.1 * Real.sin q.2))) :=
      fun f hf => t_cont f hf (fun _ => c) (fun q : ℝ × ℝ => q.1 * Real.cos q.2)
        (fun q : ℝ × ℝ => q.1 * Real.sin q.2) continuous_const (by fun_prop) (by fun_prop)
        (fun q => hmem _ _)
    have cA := cq a haC
    have cB := cq b hbC
    have cA1 := cq _ (haP 1)
    have cA2 := cq _ (haP 2)
    have cB1 := cq _ (hbP 1)
    have cB2 := cq _ (hbP 2)
    have cC : Continuous (fun q : ℝ × ℝ => Real.cos q.2) := by fun_prop
    have cS : Continuous (fun q : ℝ × ℝ => Real.sin q.2) := by fun_prop
    have cR : Continuous (fun q : ℝ × ℝ => q.1) := continuous_fst
    obtain ⟨Φ, hΦ⟩ : ∃ F : ℝ → ℝ → ℝ, F = fun ρ s =>
        ρ * (a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s)) * Real.cos s
          + b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s)) * Real.sin s) := ⟨_, rfl⟩
    obtain ⟨Ψ, hΨ⟩ : ∃ F : ℝ → ℝ → ℝ, F = fun ρ s =>
        b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s)) * Real.cos s
          - a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s)) * Real.sin s := ⟨_, rfl⟩
    obtain ⟨DΦ, hDΦ⟩ : ∃ F : ℝ → ℝ → ℝ, F = fun ρ s =>
        (a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s)) * Real.cos s
          + b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s)) * Real.sin s)
        + ρ * (Real.cos s * (Real.cos s * partialDeriv 1 a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))
            + Real.sin s * partialDeriv 2 a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s)))
          + Real.sin s * (Real.cos s * partialDeriv 1 b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))
            + Real.sin s * partialDeriv 2 b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s)))) :=
      ⟨_, rfl⟩
    obtain ⟨DΨ, hDΨ⟩ : ∃ F : ℝ → ℝ → ℝ, F = fun ρ s =>
        (-(ρ * Real.sin s) * partialDeriv 1 b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))
            + ρ * Real.cos s * partialDeriv 2 b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s)))
            * Real.cos s
          - b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s)) * Real.sin s
          - ((-(ρ * Real.sin s) * partialDeriv 1 a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))
            + ρ * Real.cos s * partialDeriv 2 a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s)))
            * Real.sin s
          + a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s)) * Real.cos s) := ⟨_, rfl⟩
    have cDΦ : Continuous (fun q : ℝ × ℝ => DΦ q.1 q.2) := by
      subst hDΦ
      exact ((cA.mul cC).add (cB.mul cS)).add (cR.mul ((cC.mul ((cC.mul cA1).add
        (cS.mul cA2))).add (cS.mul ((cC.mul cB1).add (cS.mul cB2)))))
    have cDΨ : Continuous (fun q : ℝ × ℝ => DΨ q.1 q.2) := by
      subst hDΨ
      exact (((((cR.mul cS).neg.mul cB1).add ((cR.mul cC).mul cB2)).mul cC).sub
        (cB.mul cS)).sub
        (((((cR.mul cS).neg.mul cA1).add ((cR.mul cC).mul cA2)).mul cS).add (cA.mul cC))
    have hΦd : ∀ ρ s, HasDerivAt (fun r => Φ r s) (DΦ ρ s) ρ := by
      intro ρ s
      have hTa := t_chain a (fun _ => c) (fun r => r * Real.cos s) (fun r => r * Real.sin s)
        0 (Real.cos s) (Real.sin s) ρ (hasDerivAt_const _ _) (hasDerivAt_mul_const _)
        (hasDerivAt_mul_const _) (haD _ (hmem _ _))
      have hTb := t_chain b (fun _ => c) (fun r => r * Real.cos s) (fun r => r * Real.sin s)
        0 (Real.cos s) (Real.sin s) ρ (hasDerivAt_const _ _) (hasDerivAt_mul_const _)
        (hasDerivAt_mul_const _) (hbD _ (hmem _ _))
      beta_reduce at hTa hTb
      have h := (hasDerivAt_id ρ).mul
        ((hTa.mul_const (Real.cos s)).add (hTb.mul_const (Real.sin s)))
      subst hΦ hDΦ
      refine h.congr_deriv ?_
      simp only [id, Pi.add_apply]
      ring
    have hΨd : ∀ ρ s, HasDerivAt (fun u => Ψ ρ u) (DΨ ρ s) s := by
      intro ρ s
      have hY : HasDerivAt (fun u => ρ * Real.cos u) (ρ * -Real.sin s) s :=
        (Real.hasDerivAt_cos s).const_mul ρ
      have hZ : HasDerivAt (fun u => ρ * Real.sin u) (ρ * Real.cos s) s :=
        (Real.hasDerivAt_sin s).const_mul ρ
      have hTa := t_chain a (fun _ => c) (fun u => ρ * Real.cos u) (fun u => ρ * Real.sin u)
        0 _ _ s (hasDerivAt_const _ _) hY hZ (haD _ (hmem _ _))
      have hTb := t_chain b (fun _ => c) (fun u => ρ * Real.cos u) (fun u => ρ * Real.sin u)
        0 _ _ s (hasDerivAt_const _ _) hY hZ (hbD _ (hmem _ _))
      beta_reduce at hTa hTb
      have h := (hTb.mul (Real.hasDerivAt_cos s)).sub (hTa.mul (Real.hasDerivAt_sin s))
      subst hΨ hDΨ
      refine h.congr_deriv ?_
      ring
    
    have key : ∀ ρ s,
        (partialDeriv 1 a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))
            + partialDeriv 2 b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))) * ρ
          = DΦ ρ s + DΨ ρ s := by
      intro ρ s
      subst hDΦ hDΨ
      linear_combination (-(ρ * (partialDeriv 1 a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))
            + partialDeriv 2 b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))))) *
        Real.sin_sq_add_cos_sq s
    have hΨper : ∀ ρ, Ψ ρ (2 * Real.pi) - Ψ ρ 0 = 0 := by
      intro ρ
      subst hΨ
      simp [Real.cos_two_pi, Real.sin_two_pi]
    have sl1 : ∀ ρ, Continuous (fun s => DΦ ρ s) := fun ρ =>
      cDΦ.comp (continuous_const.prodMk continuous_id)
    have sl2 : ∀ ρ, Continuous (fun s => DΨ ρ s) := fun ρ =>
      cDΨ.comp (continuous_const.prodMk continuous_id)
    have sl3 : ∀ s, Continuous (fun ρ => DΦ ρ s) := fun s =>
      cDΦ.comp (continuous_id.prodMk continuous_const)
    calc ∫ ρ in (0 : ℝ)..M, ∫ s in (0 : ℝ)..(2 * Real.pi),
          (partialDeriv 1 a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))
            + partialDeriv 2 b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))) * ρ
        = ∫ ρ in (0 : ℝ)..M, ∫ s in (0 : ℝ)..(2 * Real.pi), (DΦ ρ s + DΨ ρ s) := by
          congr 1; funext ρ; congr 1; funext s; exact key ρ s
      _ = ∫ ρ in (0 : ℝ)..M, ∫ s in (0 : ℝ)..(2 * Real.pi), DΦ ρ s := by
          congr 1; funext ρ
          rw [intervalIntegral.integral_add ((sl1 ρ).intervalIntegrable _ _)
            ((sl2 ρ).intervalIntegrable _ _),
            intervalIntegral.integral_eq_sub_of_hasDerivAt (fun s _ => hΨd ρ s)
              ((sl2 ρ).intervalIntegrable _ _), hΨper ρ, add_zero]
      _ = ∫ s in (0 : ℝ)..(2 * Real.pi), ∫ ρ in (0 : ℝ)..M, DΦ ρ s := t_swap DΦ cDΦ _ _ _ _
      _ = _ := by
          congr 1; funext s
          rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun ρ _ => hΦd ρ s)
              ((sl3 s).intervalIntegrable _ _)]
          subst hΦ
          ring
  
  have t_side : ∫ t in (-L)..L, ∫ s in (0 : ℝ)..(2 * Real.pi),
          (partialDeriv 0 a (cylPt t (L * Real.cos s) (L * Real.sin s)) * Real.cos s
            + partialDeriv 0 b (cylPt t (L * Real.cos s) (L * Real.sin s)) * Real.sin s) * L =
        ∫ s in (0 : ℝ)..(2 * Real.pi),
          ((a (cylPt L (L * Real.cos s) (L * Real.sin s)) * Real.cos s
              + b (cylPt L (L * Real.cos s) (L * Real.sin s)) * Real.sin s) * L
            - (a (cylPt (-L) (L * Real.cos s) (L * Real.sin s)) * Real.cos s
              + b (cylPt (-L) (L * Real.cos s) (L * Real.sin s)) * Real.sin s) * L) := by
    obtain ⟨haC, haD, haP⟩ := t_shell a ha
    obtain ⟨hbC, hbD, hbP⟩ := t_shell b hb
    have hL2 : R ^ 2 < L ^ 2 := pow_lt_pow_left₀ hRL hR (by norm_num)
    have hmem : ∀ t s : ℝ, R < ‖cylPt t (L * Real.cos s) (L * Real.sin s)‖ := by
      intro t s
      rw [t_norm]
      refine (Real.lt_sqrt hR).mpr ?_
      have h1 : (L * Real.cos s) ^ 2 + (L * Real.sin s) ^ 2 = L ^ 2 := by
        have := Real.sin_sq_add_cos_sq s
        linear_combination L ^ 2 * this
      nlinarith [sq_nonneg t]
    have cq : ∀ f : E3 → ℝ, ContinuousOn f {x : E3 | R < ‖x‖} →
        Continuous (fun q : ℝ × ℝ => f (cylPt q.1 (L * Real.cos q.2) (L * Real.sin q.2))) :=
      fun f hf => t_cont f hf (fun q : ℝ × ℝ => q.1) (fun q : ℝ × ℝ => L * Real.cos q.2)
        (fun q : ℝ × ℝ => L * Real.sin q.2) continuous_fst (by fun_prop) (by fun_prop)
        (fun q => hmem _ _)
    have cA0 := cq _ (haP 0)
    have cB0 := cq _ (hbP 0)
    have cC : Continuous (fun q : ℝ × ℝ => Real.cos q.2) := by fun_prop
    have cS : Continuous (fun q : ℝ × ℝ => Real.sin q.2) := by fun_prop
    obtain ⟨D, hD⟩ : ∃ F : ℝ → ℝ → ℝ, F = fun t s =>
        (partialDeriv 0 a (cylPt t (L * Real.cos s) (L * Real.sin s)) * Real.cos s
            + partialDeriv 0 b (cylPt t (L * Real.cos s) (L * Real.sin s)) * Real.sin s) * L :=
      ⟨_, rfl⟩
    have cD : Continuous (fun q : ℝ × ℝ => D q.1 q.2) := by
      subst hD
      exact ((cA0.mul cC).add (cB0.mul cS)).mul continuous_const
    have hΘ : ∀ t s, HasDerivAt
        (fun u => (a (cylPt u (L * Real.cos s) (L * Real.sin s)) * Real.cos s
            + b (cylPt u (L * Real.cos s) (L * Real.sin s)) * Real.sin s) * L) (D t s) t := by
      intro t s
      have hTa := t_chain a (fun u => u) (fun _ => L * Real.cos s) (fun _ => L * Real.sin s)
        1 0 0 t (hasDerivAt_id' t) (hasDerivAt_const _ _) (hasDerivAt_const _ _)
        (haD _ (hmem _ _))
      have hTb := t_chain b (fun u => u) (fun _ => L * Real.cos s) (fun _ => L * Real.sin s)
        1 0 0 t (hasDerivAt_id' t) (hasDerivAt_const _ _) (hasDerivAt_const _ _)
        (hbD _ (hmem _ _))
      beta_reduce at hTa hTb
      have h := ((hTa.mul_const (Real.cos s)).add (hTb.mul_const (Real.sin s))).mul_const L
      subst hD
      refine h.congr_deriv ?_
      ring
    have sl : ∀ s, Continuous (fun t => D t s) := fun s =>
      cD.comp (continuous_id.prodMk continuous_const)
    calc _ = ∫ t in (-L)..L, ∫ s in (0 : ℝ)..(2 * Real.pi), D t s := by
          subst hD; rfl
      _ = ∫ s in (0 : ℝ)..(2 * Real.pi), ∫ t in (-L)..L, D t s := t_swap D cD _ _ _ _
      _ = _ := by
          congr 1; funext s
          rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun t _ => hΘ t s)
              ((sl s).intervalIntegrable _ _)]
  
  obtain ⟨haC, haD, haP⟩ := t_shell a ha
  obtain ⟨hbC, hbD, hbP⟩ := t_shell b hb
  have hL0 : 0 < L := lt_of_le_of_lt hR hRL
  have hcL : R < |L| := by rw [abs_of_pos hL0]; exact hRL
  have hcmL : R < |-L| := by rw [abs_neg, abs_of_pos hL0]; exact hRL
  have hmemc : ∀ c : ℝ, R < |c| → ∀ y z : ℝ, R < ‖cylPt c y z‖ := by
    intro c hc y z
    have hc2 : R ^ 2 < c ^ 2 := by
      rw [← sq_abs c]; exact pow_lt_pow_left₀ hc hR (by norm_num)
    rw [t_norm]
    exact (Real.lt_sqrt hR).mpr (by nlinarith [sq_nonneg y, sq_nonneg z])
  have cX : ∀ c : ℝ, R < |c| → Continuous (fun q : ℝ × ℝ =>
      (partialDeriv 1 a (cylPt c (q.1 * Real.cos q.2) (q.1 * Real.sin q.2))
        + partialDeriv 2 b (cylPt c (q.1 * Real.cos q.2) (q.1 * Real.sin q.2))) * q.1) := by
    intro c hc
    have h1 := t_cont _ (haP 1) (fun _ => c) (fun q : ℝ × ℝ => q.1 * Real.cos q.2)
      (fun q : ℝ × ℝ => q.1 * Real.sin q.2) continuous_const (by fun_prop) (by fun_prop)
      (fun q => hmemc c hc _ _)
    have h2 := t_cont _ (hbP 2) (fun _ => c) (fun q : ℝ × ℝ => q.1 * Real.cos q.2)
      (fun q : ℝ × ℝ => q.1 * Real.sin q.2) continuous_const (by fun_prop) (by fun_prop)
      (fun q => hmemc c hc _ _)
    exact (h1.add h2).mul continuous_fst
  have cG : ∀ c : ℝ, R < |c| → Continuous (fun s : ℝ =>
      (a (cylPt c (L * Real.cos s) (L * Real.sin s)) * Real.cos s
        + b (cylPt c (L * Real.cos s) (L * Real.sin s)) * Real.sin s) * L) := by
    intro c hc
    have h1 := t_cont a haC (fun _ => c) (fun s : ℝ => L * Real.cos s)
      (fun s : ℝ => L * Real.sin s) continuous_const (by fun_prop) (by fun_prop)
      (fun q => hmemc c hc _ _)
    have h2 := t_cont b hbC (fun _ => c) (fun s : ℝ => L * Real.cos s)
      (fun s : ℝ => L * Real.sin s) continuous_const (by fun_prop) (by fun_prop)
      (fun q => hmemc c hc _ _)
    exact ((h1.mul Real.continuous_cos).add (h2.mul Real.continuous_sin)).mul continuous_const
  have cF : ∀ c : ℝ, R < |c| → Continuous (fun ρ : ℝ => ∫ s in (0 : ℝ)..(2 * Real.pi),
      (partialDeriv 1 a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))
        + partialDeriv 2 b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))) * ρ) := fun c hc =>
    intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' (cX c hc) _ _
  have sX : ∀ c : ℝ, R < |c| → ∀ ρ : ℝ, Continuous (fun s : ℝ =>
      (partialDeriv 1 a (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))
        + partialDeriv 2 b (cylPt c (ρ * Real.cos s) (ρ * Real.sin s))) * ρ) := by
    intro c hc ρ
    have h := (cX c hc).comp (continuous_const.prodMk continuous_id :
      Continuous fun s : ℝ => ((ρ, s) : ℝ × ℝ))
    exact h
  unfold capFlux sideFlux
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_two,
    Matrix.tail_cons]
  rw [t_side]
  calc _ = (∫ ρ in (0 : ℝ)..L, ∫ s in (0 : ℝ)..(2 * Real.pi),
          (partialDeriv 1 a (cylPt L (ρ * Real.cos s) (ρ * Real.sin s))
            + partialDeriv 2 b (cylPt L (ρ * Real.cos s) (ρ * Real.sin s))) * ρ)
        - ∫ ρ in (0 : ℝ)..L, ∫ s in (0 : ℝ)..(2 * Real.pi),
          (partialDeriv 1 a (cylPt (-L) (ρ * Real.cos s) (ρ * Real.sin s))
            + partialDeriv 2 b (cylPt (-L) (ρ * Real.cos s) (ρ * Real.sin s))) * ρ := by
        rw [← intervalIntegral.integral_sub ((cF L hcL).intervalIntegrable _ _)
          ((cF (-L) hcmL).intervalIntegrable _ _)]
        refine intervalIntegral.integral_congr (fun ρ _ => ?_)
        try simp only
        rw [← intervalIntegral.integral_sub ((sX L hcL ρ).intervalIntegrable _ _)
          ((sX (-L) hcmL ρ).intervalIntegrable _ _)]
        refine intervalIntegral.integral_congr (fun s _ => ?_)
        try simp only
        ring
    _ = (∫ s in (0 : ℝ)..(2 * Real.pi),
          (a (cylPt L (L * Real.cos s) (L * Real.sin s)) * Real.cos s
            + b (cylPt L (L * Real.cos s) (L * Real.sin s)) * Real.sin s) * L)
        - ∫ s in (0 : ℝ)..(2 * Real.pi),
          (a (cylPt (-L) (L * Real.cos s) (L * Real.sin s)) * Real.cos s
            + b (cylPt (-L) (L * Real.cos s) (L * Real.sin s)) * Real.sin s) * L := by
        rw [t_cap L L hcL, t_cap (-L) L hcmL]
    _ = _ := (intervalIntegral.integral_sub ((cG L hcL).intervalIntegrable _ _)
          ((cG (-L) hcmL).intervalIntegrable _ _)).symm

theorem cyl_grad_term_asymptotics (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (q R C : ℝ)
    (hq : 1 / 2 < q) (hR : 1 ≤ R) (hC : 0 < C)
    (hsmooth : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => G x a b) {x : E3 | R < ‖x‖})
    (hsymm : ∀ (x : E3) (a b : Fin 3), G x a b = G x b a)
    (hdec : Dec1 G q R C)
    (hgauge : ∀ x : E3, R < ‖x‖ →
      ∑ i : Fin 3, ∑ j : Fin 3, (G x)⁻¹ i j * christoffel G 0 i j x = 0) :
    Tendsto (fun L : ℝ => cylFlux (gradVec G) L - P1 G L) atTop (𝓝 0) :=
by
  have hq0 : 0 < q := by linarith
  have hFin : ∀ k : Fin 3, k = 0 ∨ k = 1 ∨ k = 2 := by decide
  
  have hlim : Tendsto (fun r : ℝ => C * r ^ (-q)) atTop (𝓝 (C * 0)) :=
    (tendsto_rpow_neg_atTop hq0).const_mul C
  rw [mul_zero] at hlim
  obtain ⟨R₃, hR₃⟩ := Filter.eventually_atTop.mp
    (hlim.eventually (Iic_mem_nhds (by norm_num : (0 : ℝ) < 1 / 100)))
  obtain ⟨R₁, hR₁⟩ : ∃ R₁ : ℝ, R₁ = max R R₃ := ⟨_, rfl⟩
  have hRR₁ : R ≤ R₁ := hR₁ ▸ le_max_left _ _
  have hR₃R₁ : R₃ ≤ R₁ := hR₁ ▸ le_max_right _ _
  have hR₁pos : 0 < R₁ := by linarith
  
  obtain ⟨W1, hW1⟩ : ∃ W : E3 → Fin 3 → ℝ, W = fun x => ![(1 / 2 : ℝ) * admVec G x 0,
      (1 / 2 : ℝ) * (partialDeriv 0 (fun z => G z 1 0) x - partialDeriv 1 (fun z => G z 0 0) x),
      (1 / 2 : ℝ) * (partialDeriv 0 (fun z => G z 2 0) x - partialDeriv 2 (fun z => G z 0 0) x)] :=
    ⟨_, rfl⟩
  obtain ⟨W2, hW2⟩ : ∃ W : E3 → Fin 3 → ℝ, W = fun x => ![(1 / 2 : ℝ) *
        (partialDeriv 1 (fun z => G z 1 0) x + partialDeriv 2 (fun z => G z 2 0) x),
      -(1 / 2 : ℝ) * partialDeriv 0 (fun z => G z 1 0) x,
      -(1 / 2 : ℝ) * partialDeriv 0 (fun z => G z 2 0) x] := ⟨_, rfl⟩
  have hW10 : ∀ x, W1 x 0 = (1 / 2 : ℝ) * admVec G x 0 := by intro x; subst hW1; rfl
  have hW11 : ∀ x, W1 x 1 = (1 / 2 : ℝ) *
      (partialDeriv 0 (fun z => G z 1 0) x - partialDeriv 1 (fun z => G z 0 0) x) := by
    intro x; subst hW1; rfl
  have hW12 : ∀ x, W1 x 2 = (1 / 2 : ℝ) *
      (partialDeriv 0 (fun z => G z 2 0) x - partialDeriv 2 (fun z => G z 0 0) x) := by
    intro x; subst hW1; rfl
  have hW20 : ∀ x, W2 x 0 = (1 / 2 : ℝ) *
      (partialDeriv 1 (fun z => G z 1 0) x + partialDeriv 2 (fun z => G z 2 0) x) := by
    intro x; subst hW2; rfl
  have hW21 : ∀ x, W2 x 1 = -(1 / 2 : ℝ) * partialDeriv 0 (fun z => G z 1 0) x := by
    intro x; subst hW2; rfl
  have hW22 : ∀ x, W2 x 2 = -(1 / 2 : ℝ) * partialDeriv 0 (fun z => G z 2 0) x := by
    intro x; subst hW2; rfl
  have hU : IsOpen {y : E3 | R < ‖y‖} := isOpen_lt continuous_const continuous_norm
  
  have hpt : ∀ x : E3, R₁ < ‖x‖ →
      ((G x).det ≠ 0 ∧ 0 < (G x)⁻¹ 0 0) ∧
      ∀ k : Fin 3, |gradVec G x k - W1 x k - W2 x k| ≤
        24000 * ((C * ‖x‖ ^ (-q)) * (C * ‖x‖ ^ (-q - 1))) := by
    intro x hx
    have hxR : R < ‖x‖ := lt_of_le_of_lt hRR₁ hx
    have hx3 : R₃ ≤ ‖x‖ := by linarith
    have hn0 : 0 ≤ ‖x‖ := norm_nonneg x
    have hε0 : 0 ≤ C * ‖x‖ ^ (-q) := mul_nonneg hC.le (Real.rpow_nonneg hn0 _)
    have hδ0 : 0 ≤ C * ‖x‖ ^ (-q - 1) := mul_nonneg hC.le (Real.rpow_nonneg hn0 _)
    have hε1 : C * ‖x‖ ^ (-q) ≤ 1 / 100 := hR₃ ‖x‖ hx3
    have hA : ∀ i j : Fin 3, |G x i j - (if i = j then (1 : ℝ) else 0)| ≤ C * ‖x‖ ^ (-q) :=
      fun i j => (hdec x hxR i j).1
    have hd : ∀ m a b : Fin 3, |partialDeriv m (fun y => G y a b) x| ≤ C * ‖x‖ ^ (-q - 1) :=
      fun m a b => (hdec x hxR a b).2 m
    have hdet1 := det3_near_id_bound (G x) (C * ‖x‖ ^ (-q)) hε0 hε1 hA
    have hdet : (1 / 2 : ℝ) ≤ (G x).det := by
      have := (abs_le.mp hdet1).1; linarith
    have hdetne : (G x).det ≠ 0 := (by linarith : (0 : ℝ) < (G x).det).ne'
    have hB : ∀ i j : Fin 3, |G x i j| ≤ 1 + C * ‖x‖ ^ (-q) := by
      intro i j
      have h1 := abs_sub_abs_le_abs_sub (G x i j) (if i = j then (1 : ℝ) else 0)
      have h2 : |(if i = j then (1 : ℝ) else 0)| ≤ 1 := by split_ifs <;> simp
      linarith [hA i j]
    have hinv := inv3_entry_bounds (G x) (1 + C * ‖x‖ ^ (-q)) (C * ‖x‖ ^ (-q)) hdet hB hA
    have hsq : (1 + C * ‖x‖ ^ (-q)) ^ 2 ≤ 1.0201 := by nlinarith
    have hPb : ∀ k l : Fin 3, |(G x)⁻¹ k l| ≤ 5 := by
      intro k l; have := (hinv k l).1; linarith
    have hPe : ∀ k l : Fin 3,
        |(G x)⁻¹ k l - (if k = l then (1 : ℝ) else 0)| ≤ 13 * (C * ‖x‖ ^ (-q)) := by
      intro k l
      have h1 := (hinv k l).2
      have h2 : 12 * (1 + C * ‖x‖ ^ (-q)) ^ 2 * (C * ‖x‖ ^ (-q)) ≤ 13 * (C * ‖x‖ ^ (-q)) := by
        nlinarith
      linarith
    have hP00 : 0 < (G x)⁻¹ 0 0 := by
      have h := hPe 0 0
      rw [if_pos rfl] at h
      have := (abs_le.mp h).1
      linarith
    have hdiff : ∀ a b : Fin 3, DifferentiableAt ℝ (fun y => G y a b) x := fun a b =>
      ((hsmooth a b).differentiableOn (by simp)).differentiableAt (hU.mem_nhds hxR)
    have hg : ∀ k : Fin 3, |gradVec G x k + (1 / 2 : ℝ) * partialDeriv k (fun y => G y 0 0) x|
        ≤ 20000 * (C * ‖x‖ ^ (-q)) * (C * ‖x‖ ^ (-q - 1)) := by
      intro k
      rw [gradVec_eq_formula G x hdiff hdetne hP00 k]
      exact gradVec_formula_bound (G x)⁻¹ (fun m a b => partialDeriv m (fun y => G y a b) x)
        (G x).det (C * ‖x‖ ^ (-q)) (C * ‖x‖ ^ (-q - 1)) hε0 hε1 hδ0 hPb hPe hdet1 hd k
    have hT : |∑ i : Fin 3, partialDeriv i (fun y => G y i 0) x
        - (1 / 2 : ℝ) * ∑ i : Fin 3, partialDeriv 0 (fun y => G y i i) x|
          ≤ 4000 * (C * ‖x‖ ^ (-q)) * (C * ‖x‖ ^ (-q - 1)) := by
      have h4 : |(∑ i : Fin 3, ∑ j : Fin 3, (G x)⁻¹ i j * christoffel G 0 i j x)
          - (∑ i : Fin 3, partialDeriv i (fun y => G y i 0) x
            - (1 / 2 : ℝ) * ∑ i : Fin 3, partialDeriv 0 (fun y => G y i i) x)|
            ≤ 4000 * (C * ‖x‖ ^ (-q)) * (C * ‖x‖ ^ (-q - 1)) :=
        gauge_trace_linear_bound (G x)⁻¹ (fun m a b => partialDeriv m (fun y => G y a b) x)
          (C * ‖x‖ ^ (-q)) (C * ‖x‖ ^ (-q - 1)) hε0 hδ0 hPb hPe hd
      rw [hgauge x hxR, zero_sub, abs_neg] at h4
      exact h4
    refine ⟨⟨hdetne, hP00⟩, ?_⟩
    intro k
    rcases hFin k with rfl | rfl | rfl
    · have e0 : gradVec G x 0 - W1 x 0 - W2 x 0 =
          (gradVec G x 0 + (1 / 2 : ℝ) * partialDeriv 0 (fun y => G y 0 0) x)
          - (∑ i : Fin 3, partialDeriv i (fun y => G y i 0) x
            - (1 / 2 : ℝ) * ∑ i : Fin 3, partialDeriv 0 (fun y => G y i i) x) := by
        rw [hW10, hW20]
        simp only [admVec, Fin.sum_univ_three]
        ring
      rw [e0]
      have := abs_sub (gradVec G x 0 + (1 / 2 : ℝ) * partialDeriv 0 (fun y => G y 0 0) x)
        (∑ i : Fin 3, partialDeriv i (fun y => G y i 0) x
            - (1 / 2 : ℝ) * ∑ i : Fin 3, partialDeriv 0 (fun y => G y i i) x)
      have := hg 0
      nlinarith
    · have e1 : gradVec G x 1 - W1 x 1 - W2 x 1 =
          gradVec G x 1 + (1 / 2 : ℝ) * partialDeriv 1 (fun y => G y 0 0) x := by
        rw [hW11, hW21]; ring
      rw [e1]
      have := hg 1
      have : 0 ≤ (C * ‖x‖ ^ (-q)) * (C * ‖x‖ ^ (-q - 1)) := mul_nonneg hε0 hδ0
      nlinarith
    · have e2 : gradVec G x 2 - W1 x 2 - W2 x 2 =
          gradVec G x 2 + (1 / 2 : ℝ) * partialDeriv 2 (fun y => G y 0 0) x := by
        rw [hW12, hW22]; ring
      rw [e2]
      have := hg 2
      have : 0 ≤ (C * ‖x‖ ^ (-q)) * (C * ‖x‖ ^ (-q - 1)) := mul_nonneg hε0 hδ0
      nlinarith
  
  have hpos : ∀ x : E3, R₁ < ‖x‖ → (G x).det ≠ 0 ∧ 0 < (G x)⁻¹ 0 0 :=
    fun x hx => (hpt x hx).1
  obtain ⟨hpd, hgc⟩ := gradVec_continuousOn G R R₁ hRR₁ hsmooth hpos
  have hpd' : ∀ a b k : Fin 3,
      ContinuousOn (fun x => partialDeriv k (fun z => G z a b) x) {x : E3 | R₁ < ‖x‖} :=
    fun a b k => (hpd a b k).mono (fun x hx => lt_of_le_of_lt hRR₁ hx)
  have hW1cont : ∀ k : Fin 3, ContinuousOn (fun x => W1 x k) {x : E3 | R₁ < ‖x‖} := by
    intro k
    rcases hFin k with rfl | rfl | rfl
    · simp only [hW10, admVec, Fin.sum_univ_three]
      exact continuousOn_const.mul ((((hpd' 0 0 0).sub (hpd' 0 0 0)).add
        ((hpd' 1 0 1).sub (hpd' 1 1 0))).add ((hpd' 2 0 2).sub (hpd' 2 2 0)))
    · simp only [hW11]
      exact continuousOn_const.mul ((hpd' 1 0 0).sub (hpd' 0 0 1))
    · simp only [hW12]
      exact continuousOn_const.mul ((hpd' 2 0 0).sub (hpd' 0 0 2))
  have hW2cont : ∀ k : Fin 3, ContinuousOn (fun x => W2 x k) {x : E3 | R₁ < ‖x‖} := by
    intro k
    rcases hFin k with rfl | rfl | rfl
    · simp only [hW20]
      exact continuousOn_const.mul ((hpd' 1 0 1).add (hpd' 2 0 2))
    · simp only [hW21]
      exact continuousOn_const.mul (hpd' 1 0 0)
    · simp only [hW22]
      exact continuousOn_const.mul (hpd' 2 0 0)
  have hD1cont : ∀ k : Fin 3,
      ContinuousOn (fun x => (gradVec G x - W1 x) k) {x : E3 | R₁ < ‖x‖} :=
    fun k => (hgc k).sub (hW1cont k)
  
  have hbound : ∀ᶠ L in atTop, ‖cylFlux (gradVec G) L - P1 G L‖ ≤
      288000 * Real.pi * C ^ 2 * L ^ (-(2 * q - 1)) := by
    filter_upwards [eventually_gt_atTop R₁] with L hL
    have hL0 : 0 < L := by linarith
    have hR0 : 0 ≤ R := by linarith
    have hRL : R < L := by linarith
    have hcap1 : capFlux W1 L = (1 / 2 : ℝ) * capFlux (admVec G) L := by
      unfold capFlux
      rw [← intervalIntegral.integral_const_mul]
      congr 1; funext ρ
      rw [← intervalIntegral.integral_const_mul]
      congr 1; funext s
      simp only [hW10]
      ring
    have hside1 : sideFlux W1 L = (1 / 2 : ℝ) *
        ∫ t in (-L)..L, ∫ s in (0 : ℝ)..(2 * Real.pi),
          (Real.cos s * (partialDeriv 0 (fun z => G z 1 0) (cylPt t (L * Real.cos s) (L * Real.sin s))
              - partialDeriv 1 (fun z => G z 0 0) (cylPt t (L * Real.cos s) (L * Real.sin s)))
            + Real.sin s * (partialDeriv 0 (fun z => G z 2 0) (cylPt t (L * Real.cos s) (L * Real.sin s))
              - partialDeriv 2 (fun z => G z 0 0) (cylPt t (L * Real.cos s) (L * Real.sin s)))) * L := by
      unfold sideFlux
      rw [← intervalIntegral.integral_const_mul]
      congr 1; funext t
      rw [← intervalIntegral.integral_const_mul]
      congr 1; funext s
      simp only [hW11, hW12]
      ring
    have hW1flux : cylFlux W1 L = P1 G L := by
      unfold cylFlux P1
      rw [hcap1, hside1]
    have hcs := cyl_cap_side_identity (fun z => G z 1 0) (fun z => G z 2 0) R L hR0 hRL
      (hsmooth 1 0) (hsmooth 2 0)
    have hcap2 : capFlux W2 L = (1 / 2 : ℝ) * capFlux (fun x =>
        ![partialDeriv 1 (fun z => G z 1 0) x + partialDeriv 2 (fun z => G z 2 0) x, 0, 0]) L := by
      unfold capFlux
      rw [← intervalIntegral.integral_const_mul]
      congr 1; funext ρ
      rw [← intervalIntegral.integral_const_mul]
      congr 1; funext s
      simp only [hW20, Matrix.cons_val_zero]
      ring
    have hside2 : sideFlux W2 L = -(1 / 2 : ℝ) * sideFlux (fun x =>
        ![0, partialDeriv 0 (fun z => G z 1 0) x, partialDeriv 0 (fun z => G z 2 0) x]) L := by
      unfold sideFlux
      rw [← intervalIntegral.integral_const_mul]
      congr 1; funext t
      rw [← intervalIntegral.integral_const_mul]
      congr 1; funext s
      simp only [hW21, hW22, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_two,
        Matrix.tail_cons, Matrix.cons_val_zero]
      ring
    have hW2flux : cylFlux W2 L = 0 := by
      unfold cylFlux
      rw [hcap2, hside2, hcs]
      ring
    have hsub1 : cylFlux (fun x => gradVec G x - W1 x - W2 x) L =
        cylFlux (fun x => gradVec G x - W1 x) L - cylFlux W2 L :=
      cylFlux_sub_of_continuousOn (fun x => gradVec G x - W1 x) W2 R₁ L hR₁pos.le hL
        hD1cont hW2cont
    have hsub2 : cylFlux (fun x => gradVec G x - W1 x) L = cylFlux (gradVec G) L - cylFlux W1 L :=
      cylFlux_sub_of_continuousOn (gradVec G) W1 R₁ L hR₁pos.le hL hgc hW1cont
    have heq : cylFlux (fun x => gradVec G x - W1 x - W2 x) L = cylFlux (gradVec G) L - P1 G L := by
      rw [hsub1, hsub2, hW1flux, hW2flux]; ring
    have hM : ∀ x : E3, L ≤ ‖x‖ → ∀ k : Fin 3,
        |(fun x => gradVec G x - W1 x - W2 x) x k| ≤
          24000 * ((C * L ^ (-q)) * (C * L ^ (-q - 1))) := by
      intro x hx k
      have hx1 : R₁ < ‖x‖ := by linarith
      have h := (hpt x hx1).2 k
      have a1 : ‖x‖ ^ (-q) ≤ L ^ (-q) := Real.rpow_le_rpow_of_nonpos hL0 hx (by linarith)
      have a2 : ‖x‖ ^ (-q - 1) ≤ L ^ (-q - 1) := Real.rpow_le_rpow_of_nonpos hL0 hx (by linarith)
      have b1 : 0 ≤ C * ‖x‖ ^ (-q) := mul_nonneg hC.le (Real.rpow_nonneg (norm_nonneg _) _)
      have b2 : 0 ≤ C * ‖x‖ ^ (-q - 1) := mul_nonneg hC.le (Real.rpow_nonneg (norm_nonneg _) _)
      have c1 : C * ‖x‖ ^ (-q) ≤ C * L ^ (-q) := mul_le_mul_of_nonneg_left a1 hC.le
      have c2 : C * ‖x‖ ^ (-q - 1) ≤ C * L ^ (-q - 1) := mul_le_mul_of_nonneg_left a2 hC.le
      have c3 : (C * ‖x‖ ^ (-q)) * (C * ‖x‖ ^ (-q - 1)) ≤ (C * L ^ (-q)) * (C * L ^ (-q - 1)) :=
        mul_le_mul c1 c2 b2 (le_trans b1 c1)
      show |gradVec G x k - W1 x k - W2 x k| ≤ _
      linarith
    have hMnn : 0 ≤ 24000 * ((C * L ^ (-q)) * (C * L ^ (-q - 1))) := by positivity
    have h9 := cylFlux_abs_le (fun x => gradVec G x - W1 x - W2 x) L _ hL0.le hMnn hM
    have hpow : L ^ 2 * (L ^ (-q) * L ^ (-q - 1)) = L ^ (-(2 * q - 1)) := by
      rw [← Real.rpow_add hL0, ← Real.rpow_two, ← Real.rpow_add hL0]
      congr 1; ring
    rw [Real.norm_eq_abs, ← heq]
    calc |cylFlux (fun x => gradVec G x - W1 x - W2 x) L|
        ≤ 12 * Real.pi * L ^ 2 * (24000 * ((C * L ^ (-q)) * (C * L ^ (-q - 1)))) := h9
      _ = 288000 * Real.pi * C ^ 2 * (L ^ 2 * (L ^ (-q) * L ^ (-q - 1))) := by ring
      _ = 288000 * Real.pi * C ^ 2 * L ^ (-(2 * q - 1)) := by rw [hpow]
  have hlim2 : Tendsto (fun L : ℝ => 288000 * Real.pi * C ^ 2 * L ^ (-(2 * q - 1))) atTop (𝓝 0) := by
    have := (tendsto_rpow_neg_atTop (by linarith : (0 : ℝ) < 2 * q - 1)).const_mul
      (288000 * Real.pi * C ^ 2)
    rwa [mul_zero] at this
  exact squeeze_zero_norm' hbound hlim2

theorem curv_pointwise_expansion (γ γi : Matrix (Fin 2) (Fin 2) ℝ)
    (d : Fin 2 → Fin 2 → Fin 2 → ℝ) (L s ε η : ℝ) (hL : 0 < L) (hε0 : 0 ≤ ε) (hε : ε ≤ 1 / 20)
    (hη : 0 ≤ η)
    (hγ : ∀ a b : Fin 2, |γ a b - (if a = b then (1 : ℝ) else 0)| ≤ ε)
    (hγi : ∀ a b : Fin 2, |γi a b - (if a = b then (1 : ℝ) else 0)| ≤ 2 * ε)
    (hγi2 : ∀ a b : Fin 2,
      |γi a b - (if a = b then (1 : ℝ) else 0) + (γ a b - (if a = b then (1 : ℝ) else 0))|
        ≤ 7 * ε ^ 2)
    (hd : ∀ c a b : Fin 2, L * |d c a b| ≤ η) :
    |curvKappa γ γi d L s - 1 - curvLinAlg γ d L s| ≤ 200 * (ε ^ 2 + ε * η) :=
by
  have sqrt_aux : ∀ x : ℝ, 0 ≤ x → 16 / 25 ≤ x ^ 2 → 4 / 5 ≤ x := by
    intro x hx h; nlinarith
  have prod_aux : ∀ a b : ℝ, 4 / 5 ≤ a → 4 / 5 ≤ b → 16 / 25 ≤ a * b := by
    intro a b ha hb; nlinarith
  have hε2 : ε ^ 2 ≤ ε / 20 := by nlinarith
  have hcs : Real.cos s ^ 2 + Real.sin s ^ 2 = 1 := Real.cos_sq_add_sin_sq s
  have hC1 : |Real.cos s| ≤ 1 := Real.abs_cos_le_one s
  have hS1 : |Real.sin s| ≤ 1 := Real.abs_sin_le_one s
  have hnS1 : |-Real.sin s| ≤ 1 := by rw [abs_neg]; exact hS1
  have c00 : (if (0 : Fin 2) = 0 then (1 : ℝ) else 0) = 1 := if_pos rfl
  have c11 : (if (1 : Fin 2) = 1 then (1 : ℝ) else 0) = 1 := if_pos rfl
  have c01 : (if (0 : Fin 2) = 1 then (1 : ℝ) else 0) = 0 := if_neg (by decide)
  have c10 : (if (1 : Fin 2) = 0 then (1 : ℝ) else 0) = 0 := if_neg (by decide)
  
  have k00 : |γ 0 0 - 1| ≤ ε := by have h := hγ 0 0; rwa [c00] at h
  have k11 : |γ 1 1 - 1| ≤ ε := by have h := hγ 1 1; rwa [c11] at h
  have k01 : |γ 0 1| ≤ ε := by have h := hγ 0 1; rwa [c01, sub_zero] at h
  have k10 : |γ 1 0| ≤ ε := by have h := hγ 1 0; rwa [c10, sub_zero] at h
  have i00 : |γi 0 0 - 1| ≤ 2 * ε := by have h := hγi 0 0; rwa [c00] at h
  have i11 : |γi 1 1 - 1| ≤ 2 * ε := by have h := hγi 1 1; rwa [c11] at h
  have i01 : |γi 0 1| ≤ 2 * ε := by have h := hγi 0 1; rwa [c01, sub_zero] at h
  have i10 : |γi 1 0| ≤ 2 * ε := by have h := hγi 1 0; rwa [c10, sub_zero] at h
  have p00 : |γi 0 0 - 1 + (γ 0 0 - 1)| ≤ 7 * ε ^ 2 := by have h := hγi2 0 0; rwa [c00] at h
  have p11 : |γi 1 1 - 1 + (γ 1 1 - 1)| ≤ 7 * ε ^ 2 := by have h := hγi2 1 1; rwa [c11] at h
  have p01 : |γi 0 1 + γ 0 1| ≤ 7 * ε ^ 2 := by
    have h := hγi2 0 1; rwa [c01, sub_zero, sub_zero] at h
  have p10 : |γi 1 0 + γ 1 0| ≤ 7 * ε ^ 2 := by
    have h := hγi2 1 0; rwa [c10, sub_zero, sub_zero] at h
  have hd' : ∀ c a b : Fin 2, |L * d c a b| ≤ η := by
    intro c a b; rw [abs_mul, abs_of_pos hL]; exact hd c a b
  
  have abs4 : ∀ a b c f : ℝ, |a + b + c + f| ≤ |a| + |b| + |c| + |f| := by
    intro a b c f
    have h1 := abs_add_le (a + b + c) f
    have h2 := abs_add_le (a + b) c
    have h3 := abs_add_le a b
    linarith
  have abs8 : ∀ a b c f g h i j : ℝ, |a + b + c + f + g + h + i + j|
      ≤ |a| + |b| + |c| + |f| + |g| + |h| + |i| + |j| := by
    intro a b c f g h i j
    have h1 := abs_add_le (a + b + c + f + g + h + i) j
    have h2 := abs_add_le (a + b + c + f + g + h) i
    have h3 := abs_add_le (a + b + c + f + g) h
    have h4 := abs_add_le (a + b + c + f) g
    have h5 := abs4 a b c f
    linarith
  have t1 : ∀ x m μ : ℝ, |x| ≤ 1 → |m| ≤ μ → |x * m| ≤ μ := by
    intro x m μ hx hm
    rw [abs_mul]
    calc |x| * |m| ≤ 1 * μ := mul_le_mul hx hm (abs_nonneg _) zero_le_one
      _ = μ := one_mul μ
  have t2 : ∀ x y m μ : ℝ, |x| ≤ 1 → |y| ≤ 1 → |m| ≤ μ → |x * y * m| ≤ μ := by
    intro x y m μ hx hy hm
    rw [abs_mul (x * y), abs_mul]
    have hxy : |x| * |y| ≤ 1 := mul_le_one₀ hx (abs_nonneg _) hy
    calc |x| * |y| * |m| ≤ 1 * μ := mul_le_mul hxy hm (abs_nonneg _) zero_le_one
      _ = μ := one_mul μ
  have t3 : ∀ x y z m μ : ℝ, |x| ≤ 1 → |y| ≤ 1 → |z| ≤ 1 → |m| ≤ μ → |x * y * z * m| ≤ μ := by
    intro x y z m μ hx hy hz hm
    rw [abs_mul (x * y * z), abs_mul (x * y), abs_mul]
    have hxy : |x| * |y| ≤ 1 := mul_le_one₀ hx (abs_nonneg _) hy
    have hxyz : |x| * |y| * |z| ≤ 1 := mul_le_one₀ hxy (abs_nonneg _) hz
    calc |x| * |y| * |z| * |m| ≤ 1 * μ := mul_le_mul hxyz hm (abs_nonneg _) zero_le_one
      _ = μ := one_mul μ
  have quad : ∀ m00 m01 m10 m11 x0 x1 μ : ℝ, |m00| ≤ μ → |m01| ≤ μ → |m10| ≤ μ → |m11| ≤ μ →
      |m00 * x0 * x0 + m01 * x0 * x1 + m10 * x1 * x0 + m11 * x1 * x1|
        ≤ μ * (|x0| + |x1|) ^ 2 := by
    intro m00 m01 m10 m11 x0 x1 μ h00 h01 h10 h11
    have tt : ∀ m x y : ℝ, |m| ≤ μ → |m * x * y| ≤ μ * (|x| * |y|) := by
      intro m x y hm
      rw [abs_mul, abs_mul, mul_assoc]
      exact mul_le_mul_of_nonneg_right hm (mul_nonneg (abs_nonneg _) (abs_nonneg _))
    have a1 := tt m00 x0 x0 h00
    have a2 := tt m01 x0 x1 h01
    have a3 := tt m10 x1 x0 h10
    have a4 := tt m11 x1 x1 h11
    have e : μ * (|x0| + |x1|) ^ 2 = μ * (|x0| * |x0|) + μ * (|x0| * |x1|)
        + μ * (|x1| * |x0|) + μ * (|x1| * |x1|) := by ring
    rw [e]
    exact (abs4 _ _ _ _).trans (by linarith)
  have hSS : (|Real.cos s| + |Real.sin s|) ^ 2 ≤ 2 := by
    have h1 := sq_nonneg (|Real.cos s| - |Real.sin s|)
    have h2 := sq_abs (Real.cos s)
    have h3 := sq_abs (Real.sin s)
    linarith
  
  obtain ⟨kn, hkn⟩ : ∃ x : ℝ, x = (γ 0 0 - 1) * Real.cos s * Real.cos s
      + γ 0 1 * Real.cos s * Real.sin s + γ 1 0 * Real.sin s * Real.cos s
      + (γ 1 1 - 1) * Real.sin s * Real.sin s := ⟨_, rfl⟩
  obtain ⟨be, hbe⟩ : ∃ x : ℝ, x = (γ 0 0 - 1) * (-Real.sin s) * (-Real.sin s)
      + γ 0 1 * (-Real.sin s) * Real.cos s + γ 1 0 * Real.cos s * (-Real.sin s)
      + (γ 1 1 - 1) * Real.cos s * Real.cos s := ⟨_, rfl⟩
  obtain ⟨al, hal⟩ : ∃ x : ℝ, x = (γi 0 0 - 1) * Real.cos s * Real.cos s
      + γi 0 1 * Real.cos s * Real.sin s + γi 1 0 * Real.sin s * Real.cos s
      + (γi 1 1 - 1) * Real.sin s * Real.sin s := ⟨_, rfl⟩
  obtain ⟨rho, hrho⟩ : ∃ x : ℝ, x = (γi 0 0 - 1 + (γ 0 0 - 1)) * Real.cos s * Real.cos s
      + (γi 0 1 + γ 0 1) * Real.cos s * Real.sin s + (γi 1 0 + γ 1 0) * Real.sin s * Real.cos s
      + (γi 1 1 - 1 + (γ 1 1 - 1)) * Real.sin s * Real.sin s := ⟨_, rfl⟩
  have hknb : |kn| ≤ 2 * ε := by
    rw [hkn]
    refine (quad _ _ _ _ _ _ _ k00 k01 k10 k11).trans ?_
    calc ε * (|Real.cos s| + |Real.sin s|) ^ 2 ≤ ε * 2 := mul_le_mul_of_nonneg_left hSS hε0
      _ = 2 * ε := by ring
  have hbeb : |be| ≤ 2 * ε := by
    rw [hbe]
    refine (quad _ _ _ _ _ _ _ k00 k01 k10 k11).trans ?_
    rw [abs_neg, add_comm (|Real.sin s|)]
    calc ε * (|Real.cos s| + |Real.sin s|) ^ 2 ≤ ε * 2 := mul_le_mul_of_nonneg_left hSS hε0
      _ = 2 * ε := by ring
  have hrhob : |rho| ≤ 14 * ε ^ 2 := by
    rw [hrho]
    refine (quad _ _ _ _ _ _ _ p00 p01 p10 p11).trans ?_
    calc 7 * ε ^ 2 * (|Real.cos s| + |Real.sin s|) ^ 2 ≤ 7 * ε ^ 2 * 2 :=
          mul_le_mul_of_nonneg_left hSS (by positivity)
      _ = 14 * ε ^ 2 := by ring
  have halr : al = rho - kn := by rw [hal, hrho, hkn]; ring
  
  obtain ⟨T1, hT1⟩ : ∃ x : ℝ, x =
      (-Real.sin s) * (-Real.sin s) * Real.cos s * (L * d 0 0 0)
      + (-Real.sin s) * (-Real.sin s) * Real.sin s * (L * d 0 0 1)
      + (-Real.sin s) * Real.cos s * Real.cos s * (L * d 0 1 0)
      + (-Real.sin s) * Real.cos s * Real.sin s * (L * d 0 1 1)
      + Real.cos s * (-Real.sin s) * Real.cos s * (L * d 1 0 0)
      + Real.cos s * (-Real.sin s) * Real.sin s * (L * d 1 0 1)
      + Real.cos s * Real.cos s * Real.cos s * (L * d 1 1 0)
      + Real.cos s * Real.cos s * Real.sin s * (L * d 1 1 1) := ⟨_, rfl⟩
  obtain ⟨T2, hT2⟩ : ∃ x : ℝ, x =
      Real.cos s * (-Real.sin s) * (-Real.sin s) * (L * d 0 0 0)
      + Real.cos s * (-Real.sin s) * Real.cos s * (L * d 0 0 1)
      + Real.cos s * Real.cos s * (-Real.sin s) * (L * d 0 1 0)
      + Real.cos s * Real.cos s * Real.cos s * (L * d 0 1 1)
      + Real.sin s * (-Real.sin s) * (-Real.sin s) * (L * d 1 0 0)
      + Real.sin s * (-Real.sin s) * Real.cos s * (L * d 1 0 1)
      + Real.sin s * Real.cos s * (-Real.sin s) * (L * d 1 1 0)
      + Real.sin s * Real.cos s * Real.cos s * (L * d 1 1 1) := ⟨_, rfl⟩
  obtain ⟨A0, hA0⟩ : ∃ x : ℝ, x =
      (-Real.sin s) * (-Real.sin s) * (L * d 0 0 0) + (-Real.sin s) * Real.cos s * (L * d 0 1 0)
      + Real.cos s * (-Real.sin s) * (L * d 1 0 0) + Real.cos s * Real.cos s * (L * d 1 1 0) :=
    ⟨_, rfl⟩
  obtain ⟨B0, hB0⟩ : ∃ x : ℝ, x =
      (-Real.sin s) * (-Real.sin s) * (L * d 0 0 0) + (-Real.sin s) * Real.cos s * (L * d 0 0 1)
      + Real.cos s * (-Real.sin s) * (L * d 0 1 0) + Real.cos s * Real.cos s * (L * d 0 1 1) :=
    ⟨_, rfl⟩
  obtain ⟨A1, hA1⟩ : ∃ x : ℝ, x =
      (-Real.sin s) * (-Real.sin s) * (L * d 0 0 1) + (-Real.sin s) * Real.cos s * (L * d 0 1 1)
      + Real.cos s * (-Real.sin s) * (L * d 1 0 1) + Real.cos s * Real.cos s * (L * d 1 1 1) :=
    ⟨_, rfl⟩
  obtain ⟨B1, hB1⟩ : ∃ x : ℝ, x =
      (-Real.sin s) * (-Real.sin s) * (L * d 1 0 0) + (-Real.sin s) * Real.cos s * (L * d 1 0 1)
      + Real.cos s * (-Real.sin s) * (L * d 1 1 0) + Real.cos s * Real.cos s * (L * d 1 1 1) :=
    ⟨_, rfl⟩
  obtain ⟨m0, hm0⟩ : ∃ x : ℝ, x = Real.cos s * (γi 0 0 - 1) + Real.sin s * γi 1 0 := ⟨_, rfl⟩
  obtain ⟨m1, hm1⟩ : ∃ x : ℝ, x = Real.cos s * γi 0 1 + Real.sin s * (γi 1 1 - 1) := ⟨_, rfl⟩
  obtain ⟨Dd, hDd⟩ : ∃ x : ℝ, x = -T1 + T2 / 2 := ⟨_, rfl⟩
  obtain ⟨Ee, hEe⟩ : ∃ x : ℝ, x = -(m0 * (A0 - 1 / 2 * B0) + m1 * (A1 - 1 / 2 * B1)) :=
    ⟨_, rfl⟩
  have hT1b : |T1| ≤ 8 * η := by
    rw [hT1]
    refine (abs8 _ _ _ _ _ _ _ _).trans ?_
    linarith [t3 _ _ _ _ _ hnS1 hnS1 hC1 (hd' 0 0 0), t3 _ _ _ _ _ hnS1 hnS1 hS1 (hd' 0 0 1),
      t3 _ _ _ _ _ hnS1 hC1 hC1 (hd' 0 1 0), t3 _ _ _ _ _ hnS1 hC1 hS1 (hd' 0 1 1),
      t3 _ _ _ _ _ hC1 hnS1 hC1 (hd' 1 0 0), t3 _ _ _ _ _ hC1 hnS1 hS1 (hd' 1 0 1),
      t3 _ _ _ _ _ hC1 hC1 hC1 (hd' 1 1 0), t3 _ _ _ _ _ hC1 hC1 hS1 (hd' 1 1 1)]
  have hT2b : |T2| ≤ 8 * η := by
    rw [hT2]
    refine (abs8 _ _ _ _ _ _ _ _).trans ?_
    linarith [t3 _ _ _ _ _ hC1 hnS1 hnS1 (hd' 0 0 0), t3 _ _ _ _ _ hC1 hnS1 hC1 (hd' 0 0 1),
      t3 _ _ _ _ _ hC1 hC1 hnS1 (hd' 0 1 0), t3 _ _ _ _ _ hC1 hC1 hC1 (hd' 0 1 1),
      t3 _ _ _ _ _ hS1 hnS1 hnS1 (hd' 1 0 0), t3 _ _ _ _ _ hS1 hnS1 hC1 (hd' 1 0 1),
      t3 _ _ _ _ _ hS1 hC1 hnS1 (hd' 1 1 0), t3 _ _ _ _ _ hS1 hC1 hC1 (hd' 1 1 1)]
  have hDb : |Dd| ≤ 12 * η := by
    obtain ⟨l1, u1⟩ := abs_le.mp hT1b
    obtain ⟨l2, u2⟩ := abs_le.mp hT2b
    rw [hDd, abs_le]; constructor <;> linarith
  have hA0b : |A0| ≤ 4 * η := by
    rw [hA0]
    refine (abs4 _ _ _ _).trans ?_
    linarith [t2 _ _ _ _ hnS1 hnS1 (hd' 0 0 0), t2 _ _ _ _ hnS1 hC1 (hd' 0 1 0),
      t2 _ _ _ _ hC1 hnS1 (hd' 1 0 0), t2 _ _ _ _ hC1 hC1 (hd' 1 1 0)]
  have hB0b : |B0| ≤ 4 * η := by
    rw [hB0]
    refine (abs4 _ _ _ _).trans ?_
    linarith [t2 _ _ _ _ hnS1 hnS1 (hd' 0 0 0), t2 _ _ _ _ hnS1 hC1 (hd' 0 0 1),
      t2 _ _ _ _ hC1 hnS1 (hd' 0 1 0), t2 _ _ _ _ hC1 hC1 (hd' 0 1 1)]
  have hA1b : |A1| ≤ 4 * η := by
    rw [hA1]
    refine (abs4 _ _ _ _).trans ?_
    linarith [t2 _ _ _ _ hnS1 hnS1 (hd' 0 0 1), t2 _ _ _ _ hnS1 hC1 (hd' 0 1 1),
      t2 _ _ _ _ hC1 hnS1 (hd' 1 0 1), t2 _ _ _ _ hC1 hC1 (hd' 1 1 1)]
  have hB1b : |B1| ≤ 4 * η := by
    rw [hB1]
    refine (abs4 _ _ _ _).trans ?_
    linarith [t2 _ _ _ _ hnS1 hnS1 (hd' 1 0 0), t2 _ _ _ _ hnS1 hC1 (hd' 1 0 1),
      t2 _ _ _ _ hC1 hnS1 (hd' 1 1 0), t2 _ _ _ _ hC1 hC1 (hd' 1 1 1)]
  have hm0b : |m0| ≤ 4 * ε := by
    rw [hm0]
    refine (abs_add_le _ _).trans ?_
    linarith [t1 _ _ _ hC1 i00, t1 _ _ _ hS1 i10]
  have hm1b : |m1| ≤ 4 * ε := by
    rw [hm1]
    refine (abs_add_le _ _).trans ?_
    linarith [t1 _ _ _ hC1 i01, t1 _ _ _ hS1 i11]
  have hY0b : |A0 - 1 / 2 * B0| ≤ 6 * η := by
    obtain ⟨l1, u1⟩ := abs_le.mp hA0b
    obtain ⟨l2, u2⟩ := abs_le.mp hB0b
    rw [abs_le]; constructor <;> linarith
  have hY1b : |A1 - 1 / 2 * B1| ≤ 6 * η := by
    obtain ⟨l1, u1⟩ := abs_le.mp hA1b
    obtain ⟨l2, u2⟩ := abs_le.mp hB1b
    rw [abs_le]; constructor <;> linarith
  have hEb : |Ee| ≤ 48 * ε * η := by
    have q0 : |m0 * (A0 - 1 / 2 * B0)| ≤ 4 * ε * (6 * η) := by
      rw [abs_mul]; exact mul_le_mul hm0b hY0b (abs_nonneg _) (by linarith)
    have q1 : |m1 * (A1 - 1 / 2 * B1)| ≤ 4 * ε * (6 * η) := by
      rw [abs_mul]; exact mul_le_mul hm1b hY1b (abs_nonneg _) (by linarith)
    rw [hEe, abs_neg]
    refine (abs_add_le _ _).trans ?_
    linarith
  
  have red : ∀ N A B : ℝ, N = L * (1 + Dd + Ee) → A = 1 + al → B = L ^ 2 * (1 + be) →
      N / (Real.sqrt A * Real.sqrt B)
        = (1 + Dd + Ee) / (Real.sqrt (1 + al) * Real.sqrt (1 + be)) := by
    intro N A B hN hA hB
    rw [hN, hA, hB, Real.sqrt_mul (sq_nonneg L), Real.sqrt_sq hL.le,
      show Real.sqrt (1 + al) * (L * Real.sqrt (1 + be))
        = L * (Real.sqrt (1 + al) * Real.sqrt (1 + be)) by ring]
    exact mul_div_mul_left _ _ hL.ne'
  have hK : curvKappa γ γi d L s
      = (1 + Dd + Ee) / (Real.sqrt (1 + al) * Real.sqrt (1 + be)) := by
    simp only [curvKappa]
    apply red
    · simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
      rw [hDd, hEe, hT1, hT2, hm0, hm1, hA0, hB0, hA1, hB1]
      ring
    · simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
      rw [hal]
      linear_combination hcs
    · simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
      rw [hbe]
      linear_combination L ^ 2 * hcs
  have hLin : curvLinAlg γ d L s = 1 / 2 * (kn - be) + Dd := by
    simp only [curvLinAlg, Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.head_cons, c00, c01, c10, c11]
    rw [hkn, hbe, hDd, hT1, hT2]
    ring
  
  have hε2η : ε ^ 2 * η ≤ ε / 20 * η := mul_le_mul_of_nonneg_right hε2 hη
  have hεη : 0 ≤ ε * η := mul_nonneg hε0 hη
  obtain ⟨lkn, ukn⟩ := abs_le.mp hknb
  obtain ⟨lbe, ube⟩ := abs_le.mp hbeb
  obtain ⟨lrho, urho⟩ := abs_le.mp hrhob
  obtain ⟨lD, uD⟩ := abs_le.mp hDb
  obtain ⟨lE, uE⟩ := abs_le.mp hEb
  have h1a : 0 ≤ 1 + al := by linarith
  have h1b : 0 ≤ 1 + be := by linarith
  obtain ⟨σ, hσ⟩ : ∃ x : ℝ, x = Real.sqrt (1 + al) * Real.sqrt (1 + be) := ⟨_, rfl⟩
  have hσ0 : 0 ≤ σ := by rw [hσ]; positivity
  have hσsq : σ ^ 2 = (1 + al) * (1 + be) := by
    rw [hσ, mul_pow, Real.sq_sqrt h1a, Real.sq_sqrt h1b]
  have hσsq' : 16 / 25 ≤ σ ^ 2 := by
    rw [hσsq]
    exact prod_aux _ _ (by linarith) (by linarith)
  have hσl : 4 / 5 ≤ σ := sqrt_aux σ hσ0 hσsq'
  have hσpos : 0 < σ := by linarith
  have hσne : σ ≠ 0 := hσpos.ne'
  have hprod : (1 + (al + be) / 2 - σ) * (1 + (al + be) / 2 + σ) = (al - be) ^ 2 / 4 := by
    have e : (1 + (al + be) / 2 - σ) * (1 + (al + be) / 2 + σ)
        = (1 + (al + be) / 2) ^ 2 - σ ^ 2 := by ring
    rw [e, hσsq]; ring
  have hws0 : 0 ≤ 1 + (al + be) / 2 - σ := by
    by_contra h
    push_neg at h
    have h2 := mul_neg_of_neg_of_pos h (show 0 < 1 + (al + be) / 2 + σ by linarith)
    rw [hprod] at h2
    have h3 := sq_nonneg (al - be)
    linarith
  have hws1 : 1 + (al + be) / 2 - σ ≤ 5 / 32 * (al - be) ^ 2 := by
    have := mul_le_mul_of_nonneg_left (show 8 / 5 ≤ 1 + (al + be) / 2 + σ by linarith) hws0
    linarith
  have hab2 : (al - be) ^ 2 ≤ 25 * ε ^ 2 := by
    have h := sq_le_sq' (show -(5 * ε) ≤ al - be by linarith) (show al - be ≤ 5 * ε by linarith)
    calc (al - be) ^ 2 ≤ (5 * ε) ^ 2 := h
      _ = 25 * ε ^ 2 := by ring
  rw [hK, ← hσ, hLin]
  obtain ⟨Z, hZ⟩ : ∃ x : ℝ, x = (1 + Dd + Ee) / σ - 1 - (1 / 2 * (kn - be) + Dd) := ⟨_, rfl⟩
  rw [← hZ]
  have hZσ : Z * σ = Ee - rho / 2 - (al + be) / 2 * (1 / 2 * (kn - be) + Dd)
      + (1 + (al + be) / 2 - σ) * (1 + 1 / 2 * (kn - be) + Dd) := by
    rw [hZ, sub_mul, sub_mul, div_mul_cancel₀ _ hσne]
    linear_combination (-1 / 2 : ℝ) * halr
  have hq1 : |(al + be) / 2 * (1 / 2 * (kn - be) + Dd)| ≤ (5 / 2 * ε) * (2 * ε + 12 * η) := by
    rw [abs_mul]
    refine mul_le_mul ?_ ?_ (abs_nonneg _) (by linarith)
    · rw [abs_le]; constructor <;> linarith
    · rw [abs_le]; constructor <;> linarith
  have hq2 : |(1 + (al + be) / 2 - σ) * (1 + 1 / 2 * (kn - be) + Dd)|
      ≤ (4 * ε ^ 2) * (11 / 10 + 12 * η) := by
    rw [abs_mul]
    refine mul_le_mul ?_ ?_ (abs_nonneg _) (by positivity)
    · rw [abs_of_nonneg hws0]; linarith
    · rw [abs_le]; constructor <;> linarith
  obtain ⟨lq1, uq1⟩ := abs_le.mp hq1
  obtain ⟨lq2, uq2⟩ := abs_le.mp hq2
  have hZs : |Z| * σ ≤ 160 * (ε ^ 2 + ε * η) := by
    have e : |Z| * σ = |Z * σ| := by rw [abs_mul, abs_of_pos hσpos]
    rw [e, hZσ, abs_le]
    constructor <;> linarith
  have hZ45 : |Z| * (4 / 5) ≤ |Z| * σ := mul_le_mul_of_nonneg_left hσl (abs_nonneg Z)
  linarith

theorem curv_exact_part_integral_zero (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (R L t : ℝ)
    (hL : 0 < L) (hRL : R < L)
    (hsmooth : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => G x a b) {x : E3 | R < ‖x‖}) :
    IntervalIntegrable (fun s => curvWAlg (cylGam G t L s) (cylDG G t L s) L s) volume
      0 (2 * Real.pi) ∧
    ∫ s in (0 : ℝ)..(2 * Real.pi), curvWAlg (cylGam G t L s) (cylDG G t L s) L s = 0 :=
by
  have hU : IsOpen {x : E3 | R < ‖x‖} := isOpen_lt continuous_const continuous_norm
  
  have hmem : ∀ s : ℝ, R < ‖cylPt t (L * Real.cos s) (L * Real.sin s)‖ := by
    intro s
    have hsq : ‖cylPt t (L * Real.cos s) (L * Real.sin s)‖ ^ 2 = t ^ 2 + L ^ 2 := by
      rw [EuclideanSpace.norm_eq, Real.sq_sqrt (by positivity)]
      simp [cylPt, Fin.sum_univ_three, EuclideanSpace.single_apply]
      linear_combination L ^ 2 * Real.sin_sq_add_cos_sq s
    have h0 := norm_nonneg (cylPt t (L * Real.cos s) (L * Real.sin s))
    by_contra h
    push_neg at h
    have hlt : ‖cylPt t (L * Real.cos s) (L * Real.sin s)‖ < L := lt_of_le_of_lt h hRL
    nlinarith [sq_nonneg t]
  
  have hφd : ∀ s : ℝ, HasDerivAt (fun s => cylPt t (L * Real.cos s) (L * Real.sin s))
      ((L * -Real.sin s) • e 1 + (L * Real.cos s) • e 2) s := by
    intro s
    have h1 := ((Real.hasDerivAt_cos s).const_mul L).smul_const (e 1)
    have h2 := ((Real.hasDerivAt_sin s).const_mul L).smul_const (e 2)
    have h0 := hasDerivAt_const s (t • e 0)
    have h := (h0.add h1).add h2
    rw [zero_add] at h
    exact h
  
  have hgam : ∀ (s : ℝ) (a b : Fin 2), HasDerivAt (fun s => cylGam G t L s a b)
      (L * (-(Real.sin s) * cylDG G t L s 0 a b + Real.cos s * cylDG G t L s 1 a b)) s := by
    intro s a b
    have hdiff : DifferentiableAt ℝ (fun z => G z a.succ b.succ)
        (cylPt t (L * Real.cos s) (L * Real.sin s)) :=
      ((hsmooth a.succ b.succ).differentiableOn (by simp)).differentiableAt
        (hU.mem_nhds (hmem s))
    have hc0 := hdiff.hasFDerivAt.comp_hasDerivAt s (hφd s)
    have hc : HasDerivAt (fun s => cylGam G t L s a b)
        (fderiv ℝ (fun z => G z a.succ b.succ) (cylPt t (L * Real.cos s) (L * Real.sin s))
          ((L * -Real.sin s) • e 1 + (L * Real.cos s) • e 2)) s := hc0
    refine hc.congr_deriv ?_
    have e0 : cylDG G t L s 0 a b = fderiv ℝ (fun z => G z a.succ b.succ)
        (cylPt t (L * Real.cos s) (L * Real.sin s)) (e 1) := rfl
    have e1 : cylDG G t L s 1 a b = fderiv ℝ (fun z => G z a.succ b.succ)
        (cylPt t (L * Real.cos s) (L * Real.sin s)) (e 2) := rfl
    rw [e0, e1, map_add, map_smul, map_smul, smul_eq_mul, smul_eq_mul]
    ring
  
  have hφc : Continuous (fun s : ℝ => cylPt t (L * Real.cos s) (L * Real.sin s)) := by
    unfold cylPt
    fun_prop
  have hGc : ∀ a b : Fin 3,
      Continuous (fun s => G (cylPt t (L * Real.cos s) (L * Real.sin s)) a b) :=
    fun a b => (hsmooth a b).continuousOn.comp_continuous hφc hmem
  have hdGc : ∀ i a b : Fin 3, Continuous (fun s =>
      partialDeriv i (fun z => G z a b) (cylPt t (L * Real.cos s) (L * Real.sin s))) := by
    intro i a b
    have h1 : ContinuousOn (fun x => fderiv ℝ (fun z => G z a b) x) {x : E3 | R < ‖x‖} :=
      (hsmooth a b).continuousOn_fderiv_of_isOpen hU (by simp)
    have h2 : ContinuousOn (fun x => partialDeriv i (fun z => G z a b) x) {x : E3 | R < ‖x‖} :=
      h1.clm_apply continuousOn_const
    exact h2.comp_continuous hφc hmem
  have hΓc : Continuous (fun s => cylGam G t L s) :=
    continuous_pi fun a => continuous_pi fun b => hGc a.succ b.succ
  have hDc : Continuous (fun s => cylDG G t L s) :=
    continuous_pi fun c => continuous_pi fun a => continuous_pi fun b => hdGc c.succ a.succ b.succ
  have hWc : Continuous (fun s => curvWAlg (cylGam G t L s) (cylDG G t L s) L s) := by
    simp only [curvWAlg, Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.head_cons]
    fun_prop
  
  have hder : ∀ s : ℝ, HasDerivAt (fun s => -(1 / 2 : ℝ) *
      ((-Real.sin s) * (cylGam G t L s 0 0 - 1) * Real.cos s
        + (-Real.sin s) * cylGam G t L s 0 1 * Real.sin s
        + Real.cos s * cylGam G t L s 1 0 * Real.cos s
        + Real.cos s * (cylGam G t L s 1 1 - 1) * Real.sin s))
      (curvWAlg (cylGam G t L s) (cylDG G t L s) L s) s := by
    intro s
    have hs := Real.hasDerivAt_sin s
    have hc := Real.hasDerivAt_cos s
    have h00 := (hgam s 0 0).sub_const 1
    have h01 := hgam s 0 1
    have h10 := hgam s 1 0
    have h11 := (hgam s 1 1).sub_const 1
    have h := (((((hs.neg.mul h00).mul hc).add ((hs.neg.mul h01).mul hs)).add
      ((hc.mul h10).mul hc)).add ((hc.mul h11).mul hs)).const_mul (-(1 / 2 : ℝ))
    refine h.congr_deriv ?_
    simp only [curvWAlg, Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one,
      Matrix.head_cons]
    simp only [Fin.isValue, if_pos rfl, Fin.zero_eq_one_iff, Fin.one_eq_zero_iff,
      OfNat.ofNat_ne_one, one_ne_zero, zero_ne_one, if_false, if_true, sub_zero,
      Pi.mul_apply, Pi.neg_apply]
    ring
  
  have hWi := hWc.intervalIntegrable (μ := volume) 0 (2 * Real.pi)
  refine ⟨hWi, ?_⟩
  rw [intervalIntegral.integral_eq_sub_of_hasDerivAt (fun s _ => hder s) hWi]
  simp only [cylGam, Real.cos_two_pi, Real.sin_two_pi, Real.cos_zero, Real.sin_zero, sub_self]

theorem cyl_curv_term_asymptotics (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (q R C : ℝ)
    (hq : 1 / 2 < q) (hR : 1 ≤ R) (hC : 0 < C)
    (hsmooth : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => G x a b) {x : E3 | R < ‖x‖})
    (hsymm : ∀ (x : E3) (a b : Fin 3), G x a b = G x b a)
    (hdec : Dec1 G q R C) :
    Tendsto (fun L : ℝ => curvTerm G L - P2 G L) atTop (𝓝 0) :=
by
  
  have inv2 : ∀ (γ : Matrix (Fin 2) (Fin 2) ℝ) (ε : ℝ), 0 ≤ ε → ε ≤ 1 / 20 →
      (∀ a b : Fin 2, |γ a b - (if a = b then (1 : ℝ) else 0)| ≤ ε) →
      ∀ a b : Fin 2, |γ⁻¹ a b - (if a = b then (1 : ℝ) else 0)| ≤ 2 * ε ∧
        |γ⁻¹ a b - (if a = b then (1 : ℝ) else 0) + (γ a b - (if a = b then (1 : ℝ) else 0))|
          ≤ 7 * ε ^ 2 := by
    intro γ ε hε0 hε hγ
    have c00 : (if (0 : Fin 2) = 0 then (1 : ℝ) else 0) = 1 := if_pos rfl
    have c11 : (if (1 : Fin 2) = 1 then (1 : ℝ) else 0) = 1 := if_pos rfl
    have c01 : (if (0 : Fin 2) = 1 then (1 : ℝ) else 0) = 0 := if_neg (by decide)
    have c10 : (if (1 : Fin 2) = 0 then (1 : ℝ) else 0) = 0 := if_neg (by decide)
    obtain ⟨x, e00⟩ : ∃ x, γ 0 0 = 1 + x := ⟨γ 0 0 - 1, by ring⟩
    obtain ⟨w, e11⟩ : ∃ w, γ 1 1 = 1 + w := ⟨γ 1 1 - 1, by ring⟩
    have hx : |x| ≤ ε := by
      have h := hγ 0 0
      rw [c00, e00, add_sub_cancel_left] at h
      exact h
    have hw : |w| ≤ ε := by
      have h := hγ 1 1
      rw [c11, e11, add_sub_cancel_left] at h
      exact h
    have hy : |γ 0 1| ≤ ε := by
      have h := hγ 0 1
      rwa [c01, sub_zero] at h
    have hz : |γ 1 0| ≤ ε := by
      have h := hγ 1 0
      rwa [c10, sub_zero] at h
    have lo : ∀ {a b : ℝ}, |a| ≤ b → -b ≤ a := fun h => (abs_le.mp h).1
    have up : ∀ {a b : ℝ}, |a| ≤ b → a ≤ b := fun h => (abs_le.mp h).2
    have pm : ∀ a b : ℝ, |a| ≤ ε → |b| ≤ ε → |a * b| ≤ ε ^ 2 := by
      intro a b ha hb
      rw [abs_mul, sq]
      exact mul_le_mul ha hb (abs_nonneg _) hε0
    have pm3 : ∀ a b c : ℝ, |a| ≤ ε → |b| ≤ ε → |c| ≤ ε → |a * b * c| ≤ ε ^ 2 / 20 := by
      intro a b c ha hb hc
      have h2 := pm a b ha hb
      rw [abs_mul]
      calc |a * b| * |c| ≤ ε ^ 2 * ε := mul_le_mul h2 hc (abs_nonneg _) (sq_nonneg _)
        _ ≤ ε ^ 2 * (1 / 20) := mul_le_mul_of_nonneg_left hε (sq_nonneg _)
        _ = ε ^ 2 / 20 := by ring
    have hε2 : ε ^ 2 ≤ ε / 20 := by nlinarith
    have hε2' : 0 ≤ ε ^ 2 := sq_nonneg ε
    have hdet : γ.det = (1 + x) * (1 + w) - γ 0 1 * γ 1 0 := by
      rw [Matrix.det_fin_two, e00, e11]
    have hinv : γ⁻¹ = (γ.det)⁻¹ • !![γ 1 1, -γ 0 1; -γ 1 0, γ 0 0] := by
      rw [Matrix.inv_def, Matrix.adjugate_fin_two, Ring.inverse_eq_inv']
    have hΔl : 7 / 8 ≤ γ.det := by
      rw [hdet]
      linarith [lo hx, lo hw, lo (pm x w hx hw), up (pm (γ 0 1) (γ 1 0) hy hz)]
    have hD : 0 < γ.det := by linarith
    have hD' : γ.det ≠ 0 := hD.ne'
    have key : ∀ N M : ℝ, |N| ≤ M → |N / γ.det| ≤ 8 / 7 * M := by
      intro N M h
      rw [abs_div, abs_of_pos hD, div_le_iff₀ hD]
      nlinarith [abs_nonneg N]
    have hi00 : γ⁻¹ 0 0 = (1 + w) / γ.det := by
      rw [hinv]; simp [div_eq_inv_mul, e11]
    have hi01 : γ⁻¹ 0 1 = -γ 0 1 / γ.det := by
      rw [hinv]; simp [div_eq_inv_mul]
    have hi10 : γ⁻¹ 1 0 = -γ 1 0 / γ.det := by
      rw [hinv]; simp [div_eq_inv_mul]
    have hi11 : γ⁻¹ 1 1 = (1 + x) / γ.det := by
      rw [hinv]; simp [div_eq_inv_mul, e00]
    simp only [Fin.forall_fin_two]
    refine ⟨⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩, ⟨?_, ?_⟩, ⟨?_, ?_⟩⟩
    · 
      rw [if_pos trivial, hi00]
      have e : (1 + w) / γ.det - 1 = (1 + w - γ.det) / γ.det := by
        rw [sub_div, div_self hD']
      rw [e]
      refine (key _ (ε + 2 * ε ^ 2) ?_).trans (by linarith)
      rw [hdet, abs_le]
      constructor <;>
        linarith [lo hx, up hx, lo (pm x w hx hw), up (pm x w hx hw),
          lo (pm (γ 0 1) (γ 1 0) hy hz), up (pm (γ 0 1) (γ 1 0) hy hz)]
    · 
      rw [if_pos trivial, hi00, e00]
      have e : (1 + w) / γ.det - 1 + (1 + x - 1) = (1 + w - γ.det + x * γ.det) / γ.det := by
        rw [eq_div_iff hD', add_mul, sub_mul, div_mul_cancel₀ _ hD']
        ring
      rw [e]
      refine (key _ (2 * ε ^ 2 + ε ^ 2 / 10) ?_).trans (by linarith)
      rw [hdet, abs_le]
      constructor <;>
        linarith [lo (pm x x hx hx), up (pm x x hx hx), lo (pm3 x x w hx hx hw),
          up (pm3 x x w hx hx hw), lo (pm (γ 0 1) (γ 1 0) hy hz), up (pm (γ 0 1) (γ 1 0) hy hz),
          lo (pm3 x (γ 0 1) (γ 1 0) hx hy hz), up (pm3 x (γ 0 1) (γ 1 0) hx hy hz)]
    · 
      rw [c01, hi01, sub_zero]
      refine (key _ ε (by rwa [abs_neg])).trans (by linarith)
    · 
      rw [c01, hi01, sub_zero, sub_zero]
      have e : -γ 0 1 / γ.det + γ 0 1 = (-γ 0 1 + γ 0 1 * γ.det) / γ.det := by
        rw [eq_div_iff hD', add_mul, div_mul_cancel₀ _ hD']
      rw [e]
      refine (key _ (2 * ε ^ 2 + ε ^ 2 / 10) ?_).trans (by linarith)
      rw [hdet, abs_le]
      constructor <;>
        linarith [lo (pm x (γ 0 1) hx hy), up (pm x (γ 0 1) hx hy),
          lo (pm w (γ 0 1) hw hy), up (pm w (γ 0 1) hw hy),
          lo (pm3 x w (γ 0 1) hx hw hy), up (pm3 x w (γ 0 1) hx hw hy),
          lo (pm3 (γ 0 1) (γ 0 1) (γ 1 0) hy hy hz), up (pm3 (γ 0 1) (γ 0 1) (γ 1 0) hy hy hz)]
    · 
      rw [c10, hi10, sub_zero]
      refine (key _ ε (by rwa [abs_neg])).trans (by linarith)
    · 
      rw [c10, hi10, sub_zero, sub_zero]
      have e : -γ 1 0 / γ.det + γ 1 0 = (-γ 1 0 + γ 1 0 * γ.det) / γ.det := by
        rw [eq_div_iff hD', add_mul, div_mul_cancel₀ _ hD']
      rw [e]
      refine (key _ (2 * ε ^ 2 + ε ^ 2 / 10) ?_).trans (by linarith)
      rw [hdet, abs_le]
      constructor <;>
        linarith [lo (pm x (γ 1 0) hx hz), up (pm x (γ 1 0) hx hz),
          lo (pm w (γ 1 0) hw hz), up (pm w (γ 1 0) hw hz),
          lo (pm3 x w (γ 1 0) hx hw hz), up (pm3 x w (γ 1 0) hx hw hz),
          lo (pm3 (γ 0 1) (γ 1 0) (γ 1 0) hy hz hz), up (pm3 (γ 0 1) (γ 1 0) (γ 1 0) hy hz hz)]
    · 
      rw [if_pos trivial, hi11]
      have e : (1 + x) / γ.det - 1 = (1 + x - γ.det) / γ.det := by
        rw [sub_div, div_self hD']
      rw [e]
      refine (key _ (ε + 2 * ε ^ 2) ?_).trans (by linarith)
      rw [hdet, abs_le]
      constructor <;>
        linarith [lo hw, up hw, lo (pm x w hx hw), up (pm x w hx hw),
          lo (pm (γ 0 1) (γ 1 0) hy hz), up (pm (γ 0 1) (γ 1 0) hy hz)]
    · 
      rw [if_pos trivial, hi11, e11]
      have e : (1 + x) / γ.det - 1 + (1 + w - 1) = (1 + x - γ.det + w * γ.det) / γ.det := by
        rw [eq_div_iff hD', add_mul, sub_mul, div_mul_cancel₀ _ hD']
        ring
      rw [e]
      refine (key _ (2 * ε ^ 2 + ε ^ 2 / 10) ?_).trans (by linarith)
      rw [hdet, abs_le]
      constructor <;>
        linarith [lo (pm w w hw hw), up (pm w w hw hw), lo (pm3 x w w hx hw hw),
          up (pm3 x w w hx hw hw), lo (pm (γ 0 1) (γ 1 0) hy hz), up (pm (γ 0 1) (γ 1 0) hy hz),
          lo (pm3 w (γ 0 1) (γ 1 0) hw hy hz), up (pm3 w (γ 0 1) (γ 1 0) hw hy hz)]
  have hq0 : 0 < q := by linarith
  
  have hεt : Tendsto (fun L : ℝ => C * L ^ (-q)) atTop (𝓝 0) := by
    have h := (tendsto_rpow_neg_atTop hq0).const_mul C
    rwa [mul_zero] at h
  have hev1 : ∀ᶠ L : ℝ in atTop, C * L ^ (-q) < 1 / 20 :=
    hεt.eventually_lt_const (by norm_num)
  have hev2 : ∀ᶠ L : ℝ in atTop, R < L := eventually_gt_atTop R
  have ha : Tendsto (fun L : ℝ => 1600 * Real.pi * C ^ 2 * L ^ (-(2 * q - 1))) atTop (𝓝 0) := by
    have h := (tendsto_rpow_neg_atTop (by linarith : (0 : ℝ) < 2 * q - 1)).const_mul
      (1600 * Real.pi * C ^ 2)
    rwa [mul_zero] at h
  refine squeeze_zero_norm' ?_ ha
  filter_upwards [hev1, hev2] with L hLε hRL
  have hL0 : 0 < L := by linarith
  have hε0 : 0 ≤ C * L ^ (-q) := mul_nonneg hC.le (Real.rpow_nonneg hL0.le _)
  
  have hnorm : ∀ t s : ℝ, L ≤ ‖cylPt t (L * Real.cos s) (L * Real.sin s)‖ := by
    intro t s
    have hsq : ‖cylPt t (L * Real.cos s) (L * Real.sin s)‖ ^ 2 = t ^ 2 + L ^ 2 := by
      rw [EuclideanSpace.norm_eq, Real.sq_sqrt (by positivity)]
      simp [cylPt, Fin.sum_univ_three, EuclideanSpace.single_apply]
      linear_combination L ^ 2 * Real.sin_sq_add_cos_sq s
    by_contra h
    push_neg at h
    have h0 := norm_nonneg (cylPt t (L * Real.cos s) (L * Real.sin s))
    nlinarith [sq_nonneg t]
  have hφ : Continuous (fun p : ℝ × ℝ => cylPt p.1 (L * Real.cos p.2) (L * Real.sin p.2)) := by
    unfold cylPt
    fun_prop
  have hU : IsOpen {x : E3 | R < ‖x‖} := isOpen_lt continuous_const continuous_norm
  have hmem : ∀ p : ℝ × ℝ,
      cylPt p.1 (L * Real.cos p.2) (L * Real.sin p.2) ∈ {x : E3 | R < ‖x‖} :=
    fun p => lt_of_lt_of_le hRL (hnorm p.1 p.2)
  have hGc : ∀ a b : Fin 3, Continuous
      (fun p : ℝ × ℝ => G (cylPt p.1 (L * Real.cos p.2) (L * Real.sin p.2)) a b) :=
    fun a b => (hsmooth a b).continuousOn.comp_continuous hφ hmem
  have hdGc : ∀ i a b : Fin 3, Continuous (fun p : ℝ × ℝ =>
      partialDeriv i (fun z => G z a b) (cylPt p.1 (L * Real.cos p.2) (L * Real.sin p.2))) := by
    intro i a b
    have h1 : ContinuousOn (fun x => fderiv ℝ (fun z => G z a b) x) {x : E3 | R < ‖x‖} :=
      (hsmooth a b).continuousOn_fderiv_of_isOpen hU (by simp)
    have h2 : ContinuousOn (fun x => partialDeriv i (fun z => G z a b) x) {x : E3 | R < ‖x‖} :=
      h1.clm_apply continuousOn_const
    exact h2.comp_continuous hφ hmem
  
  have hbd : ∀ t s : ℝ, ∀ i j : Fin 3,
      |G (cylPt t (L * Real.cos s) (L * Real.sin s)) i j - (if i = j then (1 : ℝ) else 0)|
        ≤ C * L ^ (-q) ∧
      ∀ k : Fin 3, L * |partialDeriv k (fun y => G y i j)
        (cylPt t (L * Real.cos s) (L * Real.sin s))| ≤ C * L ^ (-q) := by
    intro t s i j
    have hP := hnorm t s
    have hPR : R < ‖cylPt t (L * Real.cos s) (L * Real.sin s)‖ := lt_of_lt_of_le hRL hP
    obtain ⟨h0, h1⟩ := hdec _ hPR i j
    constructor
    · refine h0.trans ?_
      exact mul_le_mul_of_nonneg_left (Real.rpow_le_rpow_of_nonpos hL0 hP (by linarith)) hC.le
    · intro k
      have hpow : ‖cylPt t (L * Real.cos s) (L * Real.sin s)‖ ^ (-q - 1) ≤ L ^ (-q - 1) :=
        Real.rpow_le_rpow_of_nonpos hL0 hP (by linarith)
      have hLL : L * L ^ (-q - 1) = L ^ (-q) := by
        rw [Real.rpow_sub_one hL0.ne']
        field_simp
      calc L * |partialDeriv k (fun y => G y i j) (cylPt t (L * Real.cos s) (L * Real.sin s))|
          ≤ L * (C * L ^ (-q - 1)) :=
            mul_le_mul_of_nonneg_left ((h1 k).trans (mul_le_mul_of_nonneg_left hpow hC.le))
              hL0.le
        _ = C * (L * L ^ (-q - 1)) := by ring
        _ = C * L ^ (-q) := by rw [hLL]
  
  have hκ : ∀ t s : ℝ,
      |curvIntegrand G t L s - 1 - curvLinAlg (cylGam G t L s) (cylDG G t L s) L s|
        ≤ 400 * (C * L ^ (-q)) ^ 2 := by
    intro t s
    have hγ : ∀ a b : Fin 2,
        |cylGam G t L s a b - (if a = b then (1 : ℝ) else 0)| ≤ C * L ^ (-q) := by
      intro a b
      have h := (hbd t s a.succ b.succ).1
      simp only [Fin.succ_inj] at h
      exact h
    have hinv := inv2 (cylGam G t L s) (C * L ^ (-q)) hε0 hLε.le hγ
    have hd : ∀ c a b : Fin 2, L * |cylDG G t L s c a b| ≤ C * L ^ (-q) :=
      fun c a b => (hbd t s a.succ b.succ).2 c.succ
    have h := curv_pointwise_expansion (cylGam G t L s) (cylGam G t L s)⁻¹ (cylDG G t L s) L s
      (C * L ^ (-q)) (C * L ^ (-q)) hL0 hε0 hLε.le hε0 hγ (fun a b => (hinv a b).1)
      (fun a b => (hinv a b).2) hd
    have e : curvIntegrand G t L s
        = curvKappa (cylGam G t L s) (cylGam G t L s)⁻¹ (cylDG G t L s) L s := rfl
    rw [e]
    calc _ ≤ 200 * ((C * L ^ (-q)) ^ 2 + C * L ^ (-q) * (C * L ^ (-q))) := h
      _ = 400 * (C * L ^ (-q)) ^ 2 := by ring
  
  have hD : ∀ t s : ℝ, curvLinAlg (cylGam G t L s) (cylDG G t L s) L s
      = curvWAlg (cylGam G t L s) (cylDG G t L s) L s + L / 2 * cylQ G t L s := by
    intro t s
    have hs12 : (fun z => G z 1 2) = (fun z => G z 2 1) := funext fun z => hsymm z 1 2
    simp only [curvLinAlg, curvWAlg, cylQ, cylDG, cylGam, Fin.sum_univ_two, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.head_cons, Fin.succ_zero_eq_one, Fin.succ_one_eq_two, hs12]
    generalize cylPt t (L * Real.cos s) (L * Real.sin s) = P
    linear_combination (L / 2 * (Real.cos s * partialDeriv 1 (fun z => G z 2 2) P
      - Real.cos s * partialDeriv 2 (fun z => G z 2 1) P
      + Real.sin s * partialDeriv 2 (fun z => G z 1 1) P
      - Real.sin s * partialDeriv 1 (fun z => G z 2 1) P)) * Real.sin_sq_add_cos_sq s
  
  have hsmall : ∀ t s : ℝ, ∀ a b : Fin 3,
      |G (cylPt t (L * Real.cos s) (L * Real.sin s)) a b - (if a = b then (1 : ℝ) else 0)|
        ≤ 1 / 20 := fun t s a b => ((hbd t s a b).1).trans hLε.le
  have hKc : Continuous (fun p : ℝ × ℝ => curvIntegrand G p.1 L p.2) := by
    have hΓc : Continuous (fun p : ℝ × ℝ => cylGam G p.1 L p.2) :=
      continuous_pi fun a => continuous_pi fun b => hGc a.succ b.succ
    have hDc : Continuous (fun p : ℝ × ℝ => cylDG G p.1 L p.2) :=
      continuous_pi fun c => continuous_pi fun a => continuous_pi fun b =>
        hdGc c.succ a.succ b.succ
    have hγ20 : ∀ p : ℝ × ℝ, ∀ a b : Fin 2,
        |cylGam G p.1 L p.2 a b - (if a = b then (1 : ℝ) else 0)| ≤ 1 / 20 := by
      intro p a b
      have h := hsmall p.1 p.2 a.succ b.succ
      simp only [Fin.succ_inj] at h
      exact h
    have hinvb := fun p : ℝ × ℝ =>
      inv2 (cylGam G p.1 L p.2) (1 / 20) (by norm_num) le_rfl (hγ20 p)
    have hdet : ∀ p : ℝ × ℝ, (cylGam G p.1 L p.2).det ≠ 0 := by
      intro p h0
      have h1 := (hinvb p 0 0).1
      rw [Matrix.nonsing_inv_apply_not_isUnit _ (by rw [h0]; exact not_isUnit_zero)] at h1
      norm_num at h1
    have hinvc : Continuous (fun p : ℝ × ℝ => (cylGam G p.1 L p.2)⁻¹) := by
      have e : (fun p : ℝ × ℝ => (cylGam G p.1 L p.2)⁻¹)
          = fun p => ((cylGam G p.1 L p.2).det)⁻¹ • (cylGam G p.1 L p.2).adjugate := by
        funext p
        rw [Matrix.inv_def, Ring.inverse_eq_inv']
      rw [e]
      exact (hΓc.matrix_det.inv₀ hdet).smul hΓc.matrix_adjugate
    have hX : ∀ p : ℝ × ℝ, 0 < ∑ a : Fin 2, ∑ b : Fin 2, (cylGam G p.1 L p.2)⁻¹ a b
        * ![Real.cos p.2, Real.sin p.2] a * ![Real.cos p.2, Real.sin p.2] b := by
      intro p
      have b00 : |(cylGam G p.1 L p.2)⁻¹ 0 0 - 1| ≤ 2 * (1 / 20) := by
        have h := (hinvb p 0 0).1
        rwa [if_pos rfl] at h
      have b11 : |(cylGam G p.1 L p.2)⁻¹ 1 1 - 1| ≤ 2 * (1 / 20) := by
        have h := (hinvb p 1 1).1
        rwa [if_pos rfl] at h
      have b01 : |(cylGam G p.1 L p.2)⁻¹ 0 1| ≤ 2 * (1 / 20) := by
        have h := (hinvb p 0 1).1
        rwa [if_neg (by decide), sub_zero] at h
      have b10 : |(cylGam G p.1 L p.2)⁻¹ 1 0| ≤ 2 * (1 / 20) := by
        have h := (hinvb p 1 0).1
        rwa [if_neg (by decide), sub_zero] at h
      obtain ⟨l00, u00⟩ := abs_le.mp b00
      obtain ⟨l11, u11⟩ := abs_le.mp b11
      obtain ⟨l01, u01⟩ := abs_le.mp b01
      obtain ⟨l10, u10⟩ := abs_le.mp b10
      have hcs := Real.sin_sq_add_cos_sq p.2
      simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
      nlinarith [mul_nonneg (by linarith : (0 : ℝ) ≤ (cylGam G p.1 L p.2)⁻¹ 0 0 - 1 + 1 / 10)
          (sq_nonneg (Real.cos p.2)),
        mul_nonneg (by linarith : (0 : ℝ) ≤ (cylGam G p.1 L p.2)⁻¹ 1 1 - 1 + 1 / 10)
          (sq_nonneg (Real.sin p.2)),
        mul_nonneg (by linarith : (0 : ℝ) ≤ 1 / 5 + ((cylGam G p.1 L p.2)⁻¹ 0 1
          + (cylGam G p.1 L p.2)⁻¹ 1 0)) (sq_nonneg (Real.cos p.2 + Real.sin p.2)),
        mul_nonneg (by linarith : (0 : ℝ) ≤ 1 / 5 - ((cylGam G p.1 L p.2)⁻¹ 0 1
          + (cylGam G p.1 L p.2)⁻¹ 1 0)) (sq_nonneg (Real.cos p.2 - Real.sin p.2))]
    have hY : ∀ p : ℝ × ℝ, 0 < ∑ a : Fin 2, ∑ b : Fin 2, cylGam G p.1 L p.2 a b
        * ![-(L * Real.sin p.2), L * Real.cos p.2] a
        * ![-(L * Real.sin p.2), L * Real.cos p.2] b := by
      intro p
      have g00 : |cylGam G p.1 L p.2 0 0 - 1| ≤ 1 / 20 := by
        have h := hγ20 p 0 0
        rwa [if_pos rfl] at h
      have g11 : |cylGam G p.1 L p.2 1 1 - 1| ≤ 1 / 20 := by
        have h := hγ20 p 1 1
        rwa [if_pos rfl] at h
      have g01 : |cylGam G p.1 L p.2 0 1| ≤ 1 / 20 := by
        have h := hγ20 p 0 1
        rwa [if_neg (by decide), sub_zero] at h
      have g10 : |cylGam G p.1 L p.2 1 0| ≤ 1 / 20 := by
        have h := hγ20 p 1 0
        rwa [if_neg (by decide), sub_zero] at h
      obtain ⟨l00, u00⟩ := abs_le.mp g00
      obtain ⟨l11, u11⟩ := abs_le.mp g11
      obtain ⟨l01, u01⟩ := abs_le.mp g01
      obtain ⟨l10, u10⟩ := abs_le.mp g10
      have hcs := Real.sin_sq_add_cos_sq p.2
      have hY' : 0 < cylGam G p.1 L p.2 0 0 * Real.sin p.2 ^ 2
          - (cylGam G p.1 L p.2 0 1 + cylGam G p.1 L p.2 1 0) * Real.sin p.2 * Real.cos p.2
          + cylGam G p.1 L p.2 1 1 * Real.cos p.2 ^ 2 := by
        nlinarith [mul_nonneg (by linarith : (0 : ℝ) ≤ cylGam G p.1 L p.2 0 0 - 1 + 1 / 20)
            (sq_nonneg (Real.sin p.2)),
          mul_nonneg (by linarith : (0 : ℝ) ≤ cylGam G p.1 L p.2 1 1 - 1 + 1 / 20)
            (sq_nonneg (Real.cos p.2)),
          mul_nonneg (by linarith : (0 : ℝ) ≤ 1 / 10 - (cylGam G p.1 L p.2 0 1
            + cylGam G p.1 L p.2 1 0)) (sq_nonneg (Real.sin p.2 + Real.cos p.2)),
          mul_nonneg (by linarith : (0 : ℝ) ≤ 1 / 10 + (cylGam G p.1 L p.2 0 1
            + cylGam G p.1 L p.2 1 0)) (sq_nonneg (Real.sin p.2 - Real.cos p.2))]
      have heq : ∑ a : Fin 2, ∑ b : Fin 2, cylGam G p.1 L p.2 a b
          * ![-(L * Real.sin p.2), L * Real.cos p.2] a
          * ![-(L * Real.sin p.2), L * Real.cos p.2] b
          = L ^ 2 * (cylGam G p.1 L p.2 0 0 * Real.sin p.2 ^ 2
            - (cylGam G p.1 L p.2 0 1 + cylGam G p.1 L p.2 1 0) * Real.sin p.2 * Real.cos p.2
            + cylGam G p.1 L p.2 1 1 * Real.cos p.2 ^ 2) := by
        simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one,
          Matrix.head_cons]
        ring
      rw [heq]
      exact mul_pos (pow_pos hL0 2) hY'
    show Continuous (fun p : ℝ × ℝ =>
      curvKappa (cylGam G p.1 L p.2) (cylGam G p.1 L p.2)⁻¹ (cylDG G p.1 L p.2) L p.2)
    simp only [curvKappa, div_eq_mul_inv]
    refine Continuous.mul ?_ (Continuous.inv₀ ?_ ?_)
    · simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
      fun_prop
    · simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons]
      fun_prop
    · intro p
      exact mul_ne_zero (Real.sqrt_ne_zero'.mpr (hX p)) (Real.sqrt_ne_zero'.mpr (hY p))
  have hQc : Continuous (fun p : ℝ × ℝ => cylQ G p.1 L p.2) :=
    ((Real.continuous_cos.comp continuous_snd).mul ((hdGc 1 2 2).sub (hdGc 2 1 2))).add
      ((Real.continuous_sin.comp continuous_snd).mul ((hdGc 2 1 1).sub (hdGc 1 2 1)))
  
  have hinner : ∀ t : ℝ,
      |(∫ s in (0 : ℝ)..(2 * Real.pi), curvIntegrand G t L s) - 2 * Real.pi
        - 1 / 2 * ∫ s in (0 : ℝ)..(2 * Real.pi), cylQ G t L s * L|
        ≤ 400 * (C * L ^ (-q)) ^ 2 * (2 * Real.pi) := by
    intro t
    have hc : Continuous fun s : ℝ => (t, s) := continuous_const.prodMk continuous_id
    have hKi : IntervalIntegrable (fun s => curvIntegrand G t L s) volume 0 (2 * Real.pi) :=
      (hKc.comp hc).intervalIntegrable _ _
    have hQi : IntervalIntegrable (fun s => cylQ G t L s * L) volume 0 (2 * Real.pi) :=
      ((hQc.comp hc).mul continuous_const).intervalIntegrable _ _
    obtain ⟨hWi, hW0⟩ := curv_exact_part_integral_zero G R L t hL0 hRL hsmooth
    have h1 : IntervalIntegrable (fun s => curvIntegrand G t L s - 1) volume 0 (2 * Real.pi) :=
      hKi.sub intervalIntegrable_const
    have h2 : IntervalIntegrable
        (fun s => curvIntegrand G t L s - 1 - 1 / 2 * (cylQ G t L s * L)) volume
        0 (2 * Real.pi) := h1.sub (hQi.const_mul _)
    have key : (∫ s in (0 : ℝ)..(2 * Real.pi), curvIntegrand G t L s) - 2 * Real.pi
          - 1 / 2 * ∫ s in (0 : ℝ)..(2 * Real.pi), cylQ G t L s * L
        = ∫ s in (0 : ℝ)..(2 * Real.pi), (curvIntegrand G t L s - 1 - 1 / 2 * (cylQ G t L s * L)
            - curvWAlg (cylGam G t L s) (cylDG G t L s) L s) := by
      rw [intervalIntegral.integral_sub h2 hWi, hW0, sub_zero,
        intervalIntegral.integral_sub h1 (hQi.const_mul _),
        intervalIntegral.integral_sub hKi intervalIntegrable_const,
        intervalIntegral.integral_const_mul, intervalIntegral.integral_const]
      simp
    rw [key]
    have hb := intervalIntegral.norm_integral_le_of_norm_le_const (a := 0) (b := 2 * Real.pi)
      (C := 400 * (C * L ^ (-q)) ^ 2)
      (f := fun s => curvIntegrand G t L s - 1 - 1 / 2 * (cylQ G t L s * L)
            - curvWAlg (cylGam G t L s) (cylDG G t L s) L s) (by
        intro s _
        rw [Real.norm_eq_abs]
        dsimp only
        have e2 : curvIntegrand G t L s - 1 - 1 / 2 * (cylQ G t L s * L)
            - curvWAlg (cylGam G t L s) (cylDG G t L s) L s
            = curvIntegrand G t L s - 1 - curvLinAlg (cylGam G t L s) (cylDG G t L s) L s := by
          rw [hD t s]; ring
        rw [e2]
        exact hκ t s)
    rw [Real.norm_eq_abs, sub_zero, abs_of_pos Real.two_pi_pos] at hb
    exact hb
  
  have hFc : Continuous (fun t => ∫ s in (0 : ℝ)..(2 * Real.pi), curvIntegrand G t L s) :=
    intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
      (f := fun t s => curvIntegrand G t L s) hKc 0 (2 * Real.pi)
  have hHc : Continuous (fun t => ∫ s in (0 : ℝ)..(2 * Real.pi), cylQ G t L s * L) :=
    intervalIntegral.continuous_parametric_intervalIntegral_of_continuous'
      (f := fun t s => cylQ G t L s * L) (hQc.mul continuous_const) 0 (2 * Real.pi)
  have hout : curvTerm G L - P2 G L
      = ∫ t in (-L)..L, ((∫ s in (0 : ℝ)..(2 * Real.pi), curvIntegrand G t L s) - 2 * Real.pi
          - 1 / 2 * ∫ s in (0 : ℝ)..(2 * Real.pi), cylQ G t L s * L) := by
    have hP2 : P2 G L = 4 * Real.pi * L + 1 / 2 *
        ∫ t in (-L)..L, ∫ s in (0 : ℝ)..(2 * Real.pi), cylQ G t L s * L := rfl
    have hCT : curvTerm G L
        = ∫ t in (-L)..L, ∫ s in (0 : ℝ)..(2 * Real.pi), curvIntegrand G t L s := rfl
    have i1 : ∫ t in (-L)..L, ((∫ s in (0 : ℝ)..(2 * Real.pi), curvIntegrand G t L s) - 2 * Real.pi
          - 1 / 2 * ∫ s in (0 : ℝ)..(2 * Real.pi), cylQ G t L s * L)
        = (∫ t in (-L)..L, ((∫ s in (0 : ℝ)..(2 * Real.pi), curvIntegrand G t L s) - 2 * Real.pi))
          - ∫ t in (-L)..L, (1 / 2 * ∫ s in (0 : ℝ)..(2 * Real.pi), cylQ G t L s * L) :=
      intervalIntegral.integral_sub ((hFc.intervalIntegrable _ _).sub intervalIntegrable_const)
        ((hHc.intervalIntegrable _ _).const_mul _)
    have i2 : ∫ t in (-L)..L, ((∫ s in (0 : ℝ)..(2 * Real.pi), curvIntegrand G t L s) - 2 * Real.pi)
        = (∫ t in (-L)..L, ∫ s in (0 : ℝ)..(2 * Real.pi), curvIntegrand G t L s)
          - ∫ t in (-L)..L, (2 * Real.pi) :=
      intervalIntegral.integral_sub (hFc.intervalIntegrable _ _) intervalIntegrable_const
    have i3 : ∫ t in (-L)..L, (1 / 2 * ∫ s in (0 : ℝ)..(2 * Real.pi), cylQ G t L s * L)
        = 1 / 2 * ∫ t in (-L)..L, ∫ s in (0 : ℝ)..(2 * Real.pi), cylQ G t L s * L :=
      intervalIntegral.integral_const_mul _ _
    have i4 : ∫ t in (-L)..L, (2 * Real.pi) = (L - -L) * (2 * Real.pi) := by
      rw [intervalIntegral.integral_const, smul_eq_mul]
    rw [hP2, hCT, i1, i2, i3, i4]
    ring
  rw [hout, Real.norm_eq_abs]
  have hb := intervalIntegral.norm_integral_le_of_norm_le_const (a := -L) (b := L)
    (C := 400 * (C * L ^ (-q)) ^ 2 * (2 * Real.pi))
    (f := fun t => (∫ s in (0 : ℝ)..(2 * Real.pi), curvIntegrand G t L s) - 2 * Real.pi
          - 1 / 2 * ∫ s in (0 : ℝ)..(2 * Real.pi), cylQ G t L s * L)
    (fun t _ => by rw [Real.norm_eq_abs]; exact hinner t)
  rw [Real.norm_eq_abs] at hb
  refine hb.trans (le_of_eq ?_)
  have habs : |L - -L| = 2 * L := by
    rw [sub_neg_eq_add, abs_of_pos (by linarith)]
    ring
  have hpow : L * (L ^ (-q)) ^ 2 = L ^ (-(2 * q - 1)) := by
    rw [← Real.rpow_natCast, ← Real.rpow_mul hL0.le,
      show -(2 * q - 1) = 1 + (-q * ((2 : ℕ) : ℝ)) by push_cast; ring,
      Real.rpow_add hL0, Real.rpow_one]
  rw [habs]
  calc 400 * (C * L ^ (-q)) ^ 2 * (2 * Real.pi) * (2 * L)
      = 1600 * Real.pi * C ^ 2 * (L * (L ^ (-q)) ^ 2) := by ring
    _ = _ := by rw [hpow]

theorem cyl_adm_flux_split (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (R L : ℝ) (hRL : R < L)
    (hsmooth : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun x => G x a b) {x : E3 | R < ‖x‖})
    (hsymm : ∀ (x : E3) (a b : Fin 3), G x a b = G x b a) :
    P1 G L - P2 G L + 4 * Real.pi * L = (1 / 2 : ℝ) * cylFlux (admVec G) L :=
by
  
  have hP : ∀ t s : ℝ, R < ‖cylPt t (L * Real.cos s) (L * Real.sin s)‖ := by
    intro t s
    have hnorm : ‖cylPt t (L * Real.cos s) (L * Real.sin s)‖ ^ 2 = t ^ 2 + L ^ 2 := by
      rw [EuclideanSpace.norm_sq_eq]
      simp [cylPt, Fin.sum_univ_three, EuclideanSpace.single_apply]
      nlinarith [Real.cos_sq_add_sin_sq s]
    have h0 := norm_nonneg (cylPt t (L * Real.cos s) (L * Real.sin s))
    by_contra hcon
    push_neg at hcon
    nlinarith [sq_nonneg t]
  
  have hU : IsOpen {x : E3 | R < ‖x‖} := isOpen_lt continuous_const continuous_norm
  have hφ : Continuous (fun p : ℝ × ℝ => cylPt p.1 (L * Real.cos p.2) (L * Real.sin p.2)) := by
    unfold cylPt
    fun_prop
  have hcont : ∀ k a b : Fin 3, Continuous (fun p : ℝ × ℝ =>
      partialDeriv k (fun z => G z a b) (cylPt p.1 (L * Real.cos p.2) (L * Real.sin p.2))) := by
    intro k a b
    have h1 : ContinuousOn (fderiv ℝ (fun z => G z a b)) {x : E3 | R < ‖x‖} :=
      (hsmooth a b).continuousOn_fderiv_of_isOpen hU (by simp)
    have h2 : ContinuousOn (fun y => fderiv ℝ (fun z => G z a b) y (e k)) {x : E3 | R < ‖x‖} :=
      h1.clm_apply continuousOn_const
    exact h2.comp_continuous hφ (fun p => hP p.1 p.2)
  
  have iter : ∀ (F H : ℝ → ℝ → ℝ), Continuous (Function.uncurry F) →
      Continuous (Function.uncurry H) → ∀ a b c d : ℝ,
      (∫ t in a..b, ∫ s in c..d, F t s) - (∫ t in a..b, ∫ s in c..d, H t s)
        = ∫ t in a..b, ∫ s in c..d, (F t s - H t s) := by
    intro F H hF hH a b c d
    have hFt : ∀ t, Continuous (F t) := fun t => hF.uncurry_left t
    have hHt : ∀ t, Continuous (H t) := fun t => hH.uncurry_left t
    have hcF : Continuous (fun t => ∫ s in c..d, F t s) :=
      intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' hF c d
    have hcH : Continuous (fun t => ∫ s in c..d, H t s) :=
      intervalIntegral.continuous_parametric_intervalIntegral_of_continuous' hH c d
    rw [← intervalIntegral.integral_sub (hcF.intervalIntegrable a b) (hcH.intervalIntegrable a b)]
    congr 1
    funext t
    rw [intervalIntegral.integral_sub ((hFt t).intervalIntegrable _ _)
      ((hHt t).intervalIntegrable _ _)]
  
  have h10 : (fun z => G z 1 0) = (fun z => G z 0 1) := funext fun z => hsymm z _ _
  have h20 : (fun z => G z 2 0) = (fun z => G z 0 2) := funext fun z => hsymm z _ _
  have h21 : (fun z => G z 2 1) = (fun z => G z 1 2) := funext fun z => hsymm z _ _
  have ident : ∀ (P : E3) (s : ℝ),
      (admVec G P 1 * Real.cos s + admVec G P 2 * Real.sin s) * L =
        (Real.cos s * (partialDeriv 0 (fun z => G z 1 0) P - partialDeriv 1 (fun z => G z 0 0) P)
          + Real.sin s * (partialDeriv 0 (fun z => G z 2 0) P
            - partialDeriv 2 (fun z => G z 0 0) P)) * L
        - (Real.cos s * (partialDeriv 1 (fun z => G z 2 2) P - partialDeriv 2 (fun z => G z 1 2) P)
          + Real.sin s * (partialDeriv 2 (fun z => G z 1 1) P
            - partialDeriv 1 (fun z => G z 2 1) P)) * L := by
    intro P s
    simp only [admVec, Fin.sum_univ_three, h10, h20, h21]
    ring
  
  have hcA : Continuous (Function.uncurry (fun t s : ℝ =>
      (Real.cos s * (partialDeriv 0 (fun z => G z 1 0) (cylPt t (L * Real.cos s) (L * Real.sin s))
          - partialDeriv 1 (fun z => G z 0 0) (cylPt t (L * Real.cos s) (L * Real.sin s)))
        + Real.sin s * (partialDeriv 0 (fun z => G z 2 0) (cylPt t (L * Real.cos s) (L * Real.sin s))
          - partialDeriv 2 (fun z => G z 0 0) (cylPt t (L * Real.cos s) (L * Real.sin s)))) * L)) := by
    show Continuous (fun p : ℝ × ℝ =>
      (Real.cos p.2 * (partialDeriv 0 (fun z => G z 1 0) (cylPt p.1 (L * Real.cos p.2) (L * Real.sin p.2))
          - partialDeriv 1 (fun z => G z 0 0) (cylPt p.1 (L * Real.cos p.2) (L * Real.sin p.2)))
        + Real.sin p.2 * (partialDeriv 0 (fun z => G z 2 0) (cylPt p.1 (L * Real.cos p.2) (L * Real.sin p.2))
          - partialDeriv 2 (fun z => G z 0 0) (cylPt p.1 (L * Real.cos p.2) (L * Real.sin p.2)))) * L)
    exact ((((Real.continuous_cos.comp continuous_snd).mul ((hcont 0 1 0).sub (hcont 1 0 0))).add
      ((Real.continuous_sin.comp continuous_snd).mul ((hcont 0 2 0).sub (hcont 2 0 0)))).mul
      continuous_const)
  have hcB : Continuous (Function.uncurry (fun t s : ℝ =>
      (Real.cos s * (partialDeriv 1 (fun z => G z 2 2) (cylPt t (L * Real.cos s) (L * Real.sin s))
          - partialDeriv 2 (fun z => G z 1 2) (cylPt t (L * Real.cos s) (L * Real.sin s)))
        + Real.sin s * (partialDeriv 2 (fun z => G z 1 1) (cylPt t (L * Real.cos s) (L * Real.sin s))
          - partialDeriv 1 (fun z => G z 2 1) (cylPt t (L * Real.cos s) (L * Real.sin s)))) * L)) := by
    show Continuous (fun p : ℝ × ℝ =>
      (Real.cos p.2 * (partialDeriv 1 (fun z => G z 2 2) (cylPt p.1 (L * Real.cos p.2) (L * Real.sin p.2))
          - partialDeriv 2 (fun z => G z 1 2) (cylPt p.1 (L * Real.cos p.2) (L * Real.sin p.2)))
        + Real.sin p.2 * (partialDeriv 2 (fun z => G z 1 1) (cylPt p.1 (L * Real.cos p.2) (L * Real.sin p.2))
          - partialDeriv 1 (fun z => G z 2 1) (cylPt p.1 (L * Real.cos p.2) (L * Real.sin p.2)))) * L)
    exact ((((Real.continuous_cos.comp continuous_snd).mul ((hcont 1 2 2).sub (hcont 2 1 2))).add
      ((Real.continuous_sin.comp continuous_snd).mul ((hcont 2 1 1).sub (hcont 1 2 1)))).mul
      continuous_const)
  have key := iter _ _ hcA hcB (-L) L 0 (2 * Real.pi)
  beta_reduce at key
  have hside : sideFlux (admVec G) L =
      ∫ t in (-L)..L, ∫ s in (0 : ℝ)..(2 * Real.pi),
        ((Real.cos s * (partialDeriv 0 (fun z => G z 1 0) (cylPt t (L * Real.cos s) (L * Real.sin s))
          - partialDeriv 1 (fun z => G z 0 0) (cylPt t (L * Real.cos s) (L * Real.sin s)))
        + Real.sin s * (partialDeriv 0 (fun z => G z 2 0) (cylPt t (L * Real.cos s) (L * Real.sin s))
          - partialDeriv 2 (fun z => G z 0 0) (cylPt t (L * Real.cos s) (L * Real.sin s)))) * L
        - (Real.cos s * (partialDeriv 1 (fun z => G z 2 2) (cylPt t (L * Real.cos s) (L * Real.sin s))
          - partialDeriv 2 (fun z => G z 1 2) (cylPt t (L * Real.cos s) (L * Real.sin s)))
        + Real.sin s * (partialDeriv 2 (fun z => G z 1 1) (cylPt t (L * Real.cos s) (L * Real.sin s))
          - partialDeriv 1 (fun z => G z 2 1) (cylPt t (L * Real.cos s) (L * Real.sin s)))) * L) := by
    unfold sideFlux
    congr 1
    funext t
    congr 1
    funext s
    exact ident _ s
  unfold P1 P2 cylFlux
  rw [hside]
  linarith

theorem coordChange_inverse_bounds (X Y : E3 → E3) (q R₀ R₁ C : ℝ) (hq0 : 0 < q) (hq1 : q < 1)
    (hXY : CoordChange X Y q R₀ R₁ C) :
    ∃ R₃ K : ℝ, R₁ ≤ R₃ ∧ 0 ≤ K ∧ ∀ x : E3, R₃ < ‖x‖ →
      ‖x‖ / 2 ≤ ‖Y x‖ ∧ (1 / 2 : ℝ) ≤ (jacMat Y x).det ∧
      (∀ i a : Fin 3,
        |(fderiv ℝ Y x (e a)) i - (if i = a then (1 : ℝ) else 0)| ≤ K * ‖x‖ ^ (-q)) ∧
      (∀ c i a : Fin 3,
        |partialDeriv c (fun z => (fderiv ℝ Y z (e a)) i) x| ≤ K * ‖x‖ ^ (-q - 1)) :=
by
  have hXY' := hXY
  unfold CoordChange at hXY'
  obtain ⟨hR0, hR01, hC, hXs, hYs, hinv, hinj, hbd⟩ := hXY'
  have hreg := coordChange_regularity (fun _ => (1 : Matrix (Fin 3) (Fin 3) ℝ))
    (fun i j => contDiffOn_const) X Y q R₀ R₁ C hXY
  
  have sum3 : ∀ (f : Fin 3 → ℝ) (b : ℝ), (∀ i, |f i| ≤ b) → |∑ i, f i| ≤ 3 * b := by
    intro f b hf
    rw [Fin.sum_univ_three]
    have h0 := abs_le.mp (hf 0)
    have h1 := abs_le.mp (hf 1)
    have h2 := abs_le.mp (hf 2)
    exact abs_le.mpr ⟨by linarith, by linarith⟩
  have mulb : ∀ (u v A B : ℝ), |u| ≤ A → |v| ≤ B → |u * v| ≤ A * B := by
    intro u v A B hu hv
    rw [abs_mul]
    exact mul_le_mul hu hv (abs_nonneg _) (le_trans (abs_nonneg _) hu)
  
  obtain ⟨κ, hκ⟩ : ∃ κ : ℝ, κ = 1 + C := ⟨_, rfl⟩
  have hκ1 : 1 ≤ κ := by rw [hκ]; linarith
  have hκ0 : 0 < κ := by linarith
  have hCκ : 0 ≤ C * κ := mul_nonneg hC.le hκ0.le
  obtain ⟨T, hT⟩ : ∃ T : ℝ, T = 600 * C * κ + 1 := ⟨_, rfl⟩
  have hT0 : 0 < T := by rw [hT]; nlinarith
  have h600 : 600 * C * κ ≤ T := by rw [hT]; linarith
  refine ⟨max R₁ (T ^ (1 / q)), 72 * C * κ ^ 2, le_max_left _ _, by positivity, ?_⟩
  intro x hx
  have hxR1 : R₁ < ‖x‖ := lt_of_le_of_lt (le_max_left _ _) hx
  have hxT : T ^ (1 / q) < ‖x‖ := lt_of_le_of_lt (le_max_right _ _) hx
  have hTq0 : 0 < T ^ (1 / q) := Real.rpow_pos_of_pos hT0 _
  have hx0 : 0 < ‖x‖ := lt_trans hTq0 hxT
  have hu_le : ‖x‖ ^ (-q) ≤ T⁻¹ := by
    have h1 : ‖x‖ ^ (-q) ≤ (T ^ (1 / q)) ^ (-q) :=
      Real.rpow_le_rpow_of_nonpos hTq0 hxT.le (by linarith)
    have h2 : (T ^ (1 / q)) ^ (-q) = T⁻¹ := by
      rw [← Real.rpow_mul hT0.le]
      have : 1 / q * -q = -1 := by field_simp
      rw [this, Real.rpow_neg_one]
    rw [h2] at h1
    exact h1
  have hu0 : 0 ≤ ‖x‖ ^ (-q) := Real.rpow_nonneg hx0.le _
  have hv0 : 0 ≤ ‖x‖ ^ (-q - 1) := Real.rpow_nonneg hx0.le _
  have huT : ‖x‖ ^ (-q) * T ≤ 1 := by
    calc ‖x‖ ^ (-q) * T ≤ T⁻¹ * T := mul_le_mul_of_nonneg_right hu_le hT0.le
      _ = 1 := inv_mul_cancel₀ hT0.ne'
  obtain ⟨hs0, hxs, hsq, hsq1⟩ := coordChange_norm_compare X Y q R₀ R₁ C hq0 hq1 hXY x hxR1
  rw [← hκ] at hxs hsq hsq1
  have hs0' : 0 < ‖Y x‖ := by linarith
  have hw0 : 0 ≤ ‖Y x‖ ^ (-q) := Real.rpow_nonneg hs0'.le _
  have hw10 : 0 ≤ ‖Y x‖ ^ (-q - 1) := Real.rpow_nonneg hs0'.le _
  
  have hε600 : C * ‖Y x‖ ^ (-q) ≤ 1 / 600 := by
    have h1 : C * ‖Y x‖ ^ (-q) ≤ C * (κ * ‖x‖ ^ (-q)) := mul_le_mul_of_nonneg_left hsq hC.le
    have h3 : 600 * C * κ * ‖x‖ ^ (-q) ≤ T * ‖x‖ ^ (-q) := mul_le_mul_of_nonneg_right h600 hu0
    linarith
  have hε0 : 0 ≤ C * ‖Y x‖ ^ (-q) := mul_nonneg hC.le hw0
  have hε : C * ‖Y x‖ ^ (-q) ≤ 1 / 6 := by linarith
  
  have hpart1 : ‖x‖ / 2 ≤ ‖Y x‖ := by
    have hXYx := (hinv x hxR1).2
    have hXb := (hbd (Y x) hs0).1
    have hpow : ‖Y x‖ ^ (1 - q) = ‖Y x‖ * ‖Y x‖ ^ (-q) := by
      rw [sub_eq_add_neg, Real.rpow_add hs0', Real.rpow_one]
    rw [hpow] at hXb
    have htri : ‖X (Y x)‖ ≤ ‖Y x‖ + ‖X (Y x) - Y x‖ := by
      simpa using norm_add_le (Y x) (X (Y x) - Y x)
    rw [hXYx] at htri hXb
    have hm : ‖Y x‖ * (C * ‖Y x‖ ^ (-q)) ≤ ‖Y x‖ * (1 / 600) :=
      mul_le_mul_of_nonneg_left hε600 hs0'.le
    nlinarith
  
  obtain ⟨hYd, hXd, hBd, hAd, -⟩ := hreg.2 x hxR1
  obtain ⟨hI, hII⟩ := inverse_jacobian_identities X Y {z : E3 | R₁ < ‖z‖}
    (isOpen_lt continuous_const continuous_norm) (fun z hz => (hinv z hz).2)
    (fun z hz => (hreg.2 z hz).1) (fun z hz => (hreg.2 z hz).2.1) x hxR1 hAd hBd
  obtain ⟨-, hA1, hA2⟩ := hbd (Y x) hs0
  
  have hBb : ∀ i a : Fin 3, |(fderiv ℝ Y x (e a)) i| ≤ 2 * 1 ∧
      |(fderiv ℝ Y x (e a)) i - (if i = a then (1 : ℝ) else 0)|
        ≤ 6 * (C * ‖Y x‖ ^ (-q)) * 1 := by
    intro i a
    refine lin3_solve_bound
      (fun d k => partialDeriv k (fun w => X w d) (Y x) - (if k = d then (1 : ℝ) else 0))
      (fun k => (fderiv ℝ Y x (e a)) k) (fun d => if d = a then (1 : ℝ) else 0)
      (C * ‖Y x‖ ^ (-q)) 1 hε ?_ ?_ ?_ i
    · intro d k
      exact hA1 k d
    · intro d
      show |(if d = a then (1 : ℝ) else 0)| ≤ 1
      split_ifs <;> simp
    · intro d
      have h := hI d a
      have hδ : ∑ k : Fin 3, (if k = d then (1 : ℝ) else 0) * (fderiv ℝ Y x (e a)) k
          = (fderiv ℝ Y x (e a)) d := by simp
      simp only [sub_mul, Finset.sum_sub_distrib, hδ, h]
      ring
  have hB2 : ∀ i a : Fin 3, |(fderiv ℝ Y x (e a)) i| ≤ 2 :=
    fun i a => (hBb i a).1.trans (le_of_eq (mul_one _))
  have hBφ : ∀ i a : Fin 3,
      |(fderiv ℝ Y x (e a)) i - (if i = a then (1 : ℝ) else 0)| ≤ 6 * (C * ‖Y x‖ ^ (-q)) :=
    fun i a => (hBb i a).2.trans (le_of_eq (mul_one _))
  
  have hMb : ∀ c i a : Fin 3, |partialDeriv c (fun z => (fderiv ℝ Y z (e a)) i) x| ≤
      2 * (36 * (C * ‖Y x‖ ^ (-q - 1))) := by
    intro c i a
    refine (lin3_solve_bound
      (fun d k => partialDeriv k (fun w => X w d) (Y x) - (if k = d then (1 : ℝ) else 0))
      (fun k => partialDeriv c (fun z => (fderiv ℝ Y z (e a)) k) x)
      (fun d => -∑ k : Fin 3, (∑ l : Fin 3, (fderiv ℝ Y x (e c)) l *
          partialDeriv l (fun z => partialDeriv k (fun w => X w d) z) (Y x)) *
          (fderiv ℝ Y x (e a)) k)
      (C * ‖Y x‖ ^ (-q)) (36 * (C * ‖Y x‖ ^ (-q - 1))) hε ?_ ?_ ?_ i).1
    · intro d k
      exact hA1 k d
    · intro d
      show |-∑ k : Fin 3, (∑ l : Fin 3, (fderiv ℝ Y x (e c)) l *
          partialDeriv l (fun z => partialDeriv k (fun w => X w d) z) (Y x)) *
          (fderiv ℝ Y x (e a)) k| ≤ 36 * (C * ‖Y x‖ ^ (-q - 1))
      rw [abs_neg]
      have h36 : (36 : ℝ) * (C * ‖Y x‖ ^ (-q - 1))
          = 3 * (3 * (2 * (C * ‖Y x‖ ^ (-q - 1))) * 2) := by ring
      rw [h36]
      apply sum3
      intro k
      apply mulb _ _ _ _ _ (hB2 k a)
      apply sum3
      intro l
      exact mulb _ _ _ _ (hB2 l c) (hA2 l k d)
    · intro d
      have h := hII c d a
      have hδ : ∑ k : Fin 3, (if k = d then (1 : ℝ) else 0) *
            partialDeriv c (fun z => (fderiv ℝ Y z (e a)) k) x
          = partialDeriv c (fun z => (fderiv ℝ Y z (e a)) d) x := by simp
      simp only [sub_mul, Finset.sum_sub_distrib, hδ]
      rw [Finset.sum_add_distrib] at h
      linarith
  
  have hdet : |(jacMat Y x).det - 1| ≤ 4 * (6 * (C * ‖Y x‖ ^ (-q))) :=
    det3_near_id_bound (jacMat Y x) (6 * (C * ‖Y x‖ ^ (-q))) (by linarith) (by linarith)
      (fun i j => by simp only [jacMat, Matrix.of_apply]; exact hBφ i j)
  refine ⟨hpart1, ?_, ?_, ?_⟩
  · have := (abs_le.mp hdet).1
    linarith
  · intro i a
    refine le_trans (hBφ i a) ?_
    have h1 := mul_le_mul_of_nonneg_left hsq (by linarith : (0 : ℝ) ≤ 6 * C)
    have h2 : 6 * C * κ ≤ 72 * C * κ ^ 2 := by nlinarith
    have h3 := mul_le_mul_of_nonneg_right h2 hu0
    nlinarith
  · intro c i a
    refine le_trans (hMb c i a) ?_
    have h1 := mul_le_mul_of_nonneg_left hsq1 (by linarith : (0 : ℝ) ≤ 72 * C)
    nlinarith

theorem adm_pullback_piola_decomp (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (q R C : ℝ)
    (hq : 0 < q) (hR : 1 ≤ R) (hC : 0 ≤ C)
    (hsmooth : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) {y : E3 | 1 < ‖y‖})
    (hb : ∀ y : E3, R < ‖y‖ → ∀ i j : Fin 3,
      |G y i j - (if i = j then (1 : ℝ) else 0)| ≤ C * ‖y‖ ^ (-q) ∧
      ‖fderiv ℝ (fun z => G z i j) y‖ ≤ C * ‖y‖ ^ (-q - 1))
    (Y : E3 → E3) (R₃ K : ℝ) (hK : 0 ≤ K)
    (hY : ContDiffOn ℝ ∞ Y {x : E3 | R₃ < ‖x‖})
    (hYb : ∀ x : E3, R₃ < ‖x‖ → ‖x‖ / 2 ≤ ‖Y x‖ ∧
      (∀ i a : Fin 3,
        |(fderiv ℝ Y x (e a)) i - (if i = a then (1 : ℝ) else 0)| ≤ K * ‖x‖ ^ (-q)) ∧
      (∀ c i a : Fin 3,
        |partialDeriv c (fun z => (fderiv ℝ Y z (e a)) i) x| ≤ K * ‖x‖ ^ (-q - 1))) :
    ∃ R₄ K₄ : ℝ, R₃ ≤ R₄ ∧ 0 ≤ K₄ ∧ ∀ x : E3, R₄ < ‖x‖ → ∀ b : Fin 3,
      |admVec (pullbackMetric G Y) x b - piolaVec Y (admVec G) x b - jacCurlVec Y x b|
        ≤ K₄ * ‖x‖ ^ (-2 * q - 1) :=
by
  
  
  
  have t_sum3 : ∀ (f g : Fin 3 → ℝ) (A B : ℝ), (∀ i, |f i| ≤ A) → (∀ i, |g i| ≤ B) →
      |∑ i, f i * g i| ≤ 3 * (A * B) := by
    intro f g A B hf hg
    have hA : 0 ≤ A := (abs_nonneg _).trans (hf 0)
    have hfg : ∀ i, |f i * g i| ≤ A * B := fun i => by
      rw [abs_mul]; exact mul_le_mul (hf i) (hg i) (abs_nonneg _) hA
    calc |∑ i, f i * g i| ≤ ∑ i, |f i * g i| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _i : Fin 3, A * B := Finset.sum_le_sum (fun i _ => hfg i)
      _ = 3 * (A * B) := by simp
  have t_sum3' : ∀ (f : Fin 3 → ℝ) (B : ℝ), (∀ i, |f i| ≤ B) → |∑ i, f i| ≤ 3 * B := by
    intro f B hf
    calc |∑ i, f i| ≤ ∑ i, |f i| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ _i : Fin 3, B := Finset.sum_le_sum (fun i _ => hf i)
      _ = 3 * B := by simp
  have t_lin1 : ∀ (d : Fin 3 → ℝ) (H J : Fin 3 → Fin 3 → ℝ) (b : Fin 3),
      ∑ i : Fin 3, ∑ j : Fin 3, d i * H i j * J j b - d b =
        ∑ i : Fin 3, d i * (∑ j : Fin 3, (H i j - if i = j then (1:ℝ) else 0) * J j b
          + (J i b - if i = b then (1:ℝ) else 0)) := by
    intro d H J b
    fin_cases b <;> simp [Fin.sum_univ_three] <;> ring
  have t_lin2 : ∀ (d : Fin 3 → ℝ) (H J : Fin 3 → Fin 3 → ℝ) (a : Fin 3),
      ∑ i : Fin 3, ∑ j : Fin 3, J i a * H i j * d j - d a =
        ∑ j : Fin 3, (∑ i : Fin 3, J i a * (H i j - if i = j then (1:ℝ) else 0)
          + (J j a - if j = a then (1:ℝ) else 0)) * d j := by
    intro d H J a
    fin_cases a <;> simp [Fin.sum_univ_three] <;> ring
  have t_quad : ∀ (J M : Fin 3 → Fin 3 → ℝ) (a b : Fin 3),
      ∑ i : Fin 3, ∑ j : Fin 3, J i a * M i j * J j b - M a b =
        ∑ i : Fin 3, (J i a - if i = a then (1:ℝ) else 0) * (∑ j : Fin 3, M i j * J j b)
          + ∑ j : Fin 3, M a j * (J j b - if j = b then (1:ℝ) else 0) := by
    intro J M a b
    fin_cases a <;> fin_cases b <;> simp [Fin.sum_univ_three] <;> ring
  have t_contr : ∀ (J : Fin 3 → Fin 3 → ℝ) (dH : Fin 3 → Fin 3 → Fin 3 → ℝ) (c a b : Fin 3),
      ∑ k : Fin 3, J k c * dH k a b - dH c a b =
        ∑ k : Fin 3, (J k c - if k = c then (1:ℝ) else 0) * dH k a b := by
    intro J dH c a b
    fin_cases c <;> simp [Fin.sum_univ_three] <;> ring
  
  have t_canc : ∀ (D dH P : Fin 3 → Fin 3 → Fin 3 → ℝ) (Adj : Fin 3 → Fin 3 → ℝ) (b : Fin 3),
      (∀ c i a, D c i a = D a i c) →
      ∑ a : Fin 3, (P a a b - P b a a) - ∑ i : Fin 3, Adj b i * ∑ a : Fin 3, (dH a a i - dH i a a)
          - ∑ a : Fin 3, (D a b a - D a a b)
        = ∑ a : Fin 3, ((P a a b - (D a b a + D a a b + dH a a b))
            - (P b a a - (D b a a + D b a a + dH b a a)))
          - ∑ i : Fin 3, (Adj b i - if b = i then (1:ℝ) else 0) *
              ∑ a : Fin 3, (dH a a i - dH i a a) := by
    intro D dH P Adj b hsym
    have h0 := hsym 0 0 b
    have h1 := hsym 1 1 b
