      _ = 2 * γ * t := by linear_combination (2 * γ * t) * hst
  have huM : ∀ c : Fin 2, |u c| ≤ M * t := by
    intro c
    have h1 : 2 * γ * t ≤ M * t := mul_le_mul_of_nonneg_right (by linarith) ht0.le
    linarith [huB c]
  have hAr : ∀ c a : Fin 2, |A₀ c a * r| ≤ γ * t ^ 2 := by
