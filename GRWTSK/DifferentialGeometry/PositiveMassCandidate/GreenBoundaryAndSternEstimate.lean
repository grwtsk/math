  have hM56 : M ^ 5 ≤ M ^ 6 := pow_le_pow_right₀ hM1 (by norm_num)
  have hM26 : M ^ 2 ≤ M ^ 6 := pow_le_pow_right₀ hM1 (by norm_num)
  refine ⟨hGpos, ?_, ?_, ?_⟩
  · intro c
    have e : (∑ a : Fin 2, ∑ b : Fin 2, B a b * H c a * p b) + u c * G =
