      sum2 _ _ (fun a => sum2 _ _ (fun b => hNt c a b))
    linarith
  have hHSt : ∀ a b c d : Fin 2, |B a c * B b d * H a b * H c d| ≤ 16 * M ^ 4 * t ^ 4 := by
    intro a b c d
    have k := prod4 _ _ _ _ _ _ _ _ (hBb a c) (hBb b d) (hHb a b) (hHb c d)
    have e : 2 * M * (2 * M) * (2 * M * t ^ 2) * (2 * M * t ^ 2) = 16 * M ^ 4 * t ^ 4 := by ring
    linarith
  have hHS : |∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
