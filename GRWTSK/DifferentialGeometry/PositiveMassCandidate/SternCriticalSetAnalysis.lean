      rw [hτx]; exact (chartAt E3 z).left_inv hx0O.2
    have hgq : g.g ((chartAt E3 z).symm (τ (chartAt E3 q q))) =
        g.g ((chartAt E3 q).symm (chartAt E3 q q)) := congrArg g.g hq'
    obtain ⟨D, hD⟩ : ∃ D : E3 →L[ℝ] E3,
        D = mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 z).symm (τ (chartAt E3 q q)) := ⟨_, rfl⟩
    have hΦD : ∀ v : E3, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm (chartAt E3 q q) v =
        D (fderiv ℝ τ (chartAt E3 q q) v) := by
      intro v
      rw [hM1, hD]
      rfl
    have hcD : ∀ a b : Fin 3, g.coeff (chartAt E3 z).symm (τ (chartAt E3 q q)) a b
        = g.g ((chartAt E3 q).symm (chartAt E3 q q)) (D (e a)) (D (e b)) := by
      intro a b
      rw [← hgq, hD]
      rfl
    have hJ : ∀ k : Fin 3, fderiv ℝ τ (chartAt E3 q q) (e k)
        = ∑ d : Fin 3, partialDeriv k (fun w' => τ w' d) (chartAt E3 q q) • e d := by
      intro k
      rw [hbasis (fderiv ℝ τ (chartAt E3 q q) (e k))]
      simp only [hcompo _ (chartAt E3 q q) hτd]
    simp only [hcD]
    show g.g ((chartAt E3 q).symm (chartAt E3 q q))
      (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm (chartAt E3 q q) (e i))
      (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q).symm (chartAt E3 q q) (e j)) = _
    rw [hΦD, hΦD, hJ i, hJ j]
    simp only [map_sum, map_smul, ContinuousLinearMap.sum_apply, ContinuousLinearMap.smul_apply,
      smul_eq_mul]
    simp only [Fin.sum_univ_three]
    ring
  rw [hτy] at s1
  
  have s3 : (Matrix.of fun a i : Fin 3 =>
      partialDeriv i (fun w' => τ w' a) (chartAt E3 q q)).det ≠ 0 := by
    intro hdet
    obtain ⟨v, hv0, hJv⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr hdet
    have hw0 : fderiv ℝ τ (chartAt E3 q q) (∑ i : Fin 3, v i • e i) = 0 := by
      ext a
      rw [map_sum]
      simp only [map_smul]
      have := congrFun hJv a
      simp only [Matrix.mulVec, dotProduct, Matrix.of_apply, Pi.zero_apply,
        hcompo _ (chartAt E3 q q) hτd] at this
      simp only [WithLp.ofLp_sum, WithLp.ofLp_smul, Finset.sum_apply, Pi.smul_apply, smul_eq_mul,
        WithLp.ofLp_zero, Pi.zero_apply]
      rw [← this]
      apply Finset.sum_congr rfl
      intro i _
      ring
    have h0 : (∑ i : Fin 3, v i • e i) = 0 := by
      calc (∑ i : Fin 3, v i • e i)
          = fderiv ℝ σ (τ (chartAt E3 q q))
              (fderiv ℝ τ (chartAt E3 q q) (∑ i : Fin 3, v i • e i)) := (hid _).symm
        _ = 0 := by rw [hw0, map_zero]
    apply hv0
    funext a
    rw [← hcomp_e v a, h0]
    rfl
  
  have chain : ∀ f : M → ℝ, DifferentiableAt ℝ (fun y' => f ((chartAt E3 z).symm y')) y →
      ∀ i : Fin 3,
      partialDeriv i (fun y' => f ((chartAt E3 q).symm y')) (chartAt E3 q q) = ∑ a : Fin 3,
        partialDeriv a (fun y' => f ((chartAt E3 z).symm y')) y *
          (Matrix.of fun a i : Fin 3 =>
            partialDeriv i (fun w' => τ w' a) (chartAt E3 q q)) a i := by
    intro f hf i
    have hequ : (fun y' => f ((chartAt E3 q).symm y')) =ᶠ[𝓝 (chartAt E3 q q)]
        (fun y' => f ((chartAt E3 z).symm (τ y'))) := by
      filter_upwards [hev] with y' hy'
      exact congrArg f hy'
    have e1 : partialDeriv i (fun y' => f ((chartAt E3 q).symm y')) (chartAt E3 q q) =
        partialDeriv i (fun y' => f ((chartAt E3 z).symm (τ y'))) (chartAt E3 q q) := by
      unfold partialDeriv
      rw [hequ.fderiv_eq]
    have hf' : DifferentiableAt ℝ (fun y' => f ((chartAt E3 z).symm y')) (τ (chartAt E3 q q)) := by
      rw [hτy]; exact hf
    rw [e1, pd_comp (fun y' => f ((chartAt E3 z).symm y')) τ (chartAt E3 q q) hτd hf' i, hτy]
    rfl
  
  have hL : g.gradInner u w q = ∑ i : Fin 3, ∑ j : Fin 3,
      (g.coeff (chartAt E3 q).symm (chartAt E3 q q))⁻¹ i j *
        partialDeriv i (fun y' => u ((chartAt E3 q).symm y')) (chartAt E3 q q) *
        partialDeriv j (fun y' => w ((chartAt E3 q).symm y')) (chartAt E3 q q) := rfl
  have hR : gradInnerLoc (g.coeff (chartAt E3 z).symm) (fun y' => u ((chartAt E3 z).symm y'))
      (fun y' => w ((chartAt E3 z).symm y')) y = ∑ i : Fin 3, ∑ j : Fin 3,
      (g.coeff (chartAt E3 z).symm y)⁻¹ i j *
        partialDeriv i (fun y' => u ((chartAt E3 z).symm y')) y *
        partialDeriv j (fun y' => w ((chartAt E3 z).symm y')) y := rfl
  rw [hL, hR]
  exact grad_alg (Matrix.of fun a i : Fin 3 => partialDeriv i (fun w' => τ w' a) (chartAt E3 q q))
    (g.coeff (chartAt E3 z).symm y) (g.coeff (chartAt E3 q).symm (chartAt E3 q q))
    (fun a => partialDeriv a (fun y' => u ((chartAt E3 z).symm y')) y)
    (fun i => partialDeriv i (fun y' => u ((chartAt E3 q).symm y')) (chartAt E3 q q))
    (fun a => partialDeriv a (fun y' => w ((chartAt E3 z).symm y')) y)
    (fun i => partialDeriv i (fun y' => w ((chartAt E3 q).symm y')) (chartAt E3 q q))
    s3 (fun i j => s1 i j) (chain u hu) (chain w hw)

theorem edge_lmc_chart [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (β : M → ℝ) (hβ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ β) (z : M) (y : E3) (hy : y ∈ (chartAt E3 z).target) : g.levelMeanCurv β ((chartAt E3 z).symm y) = levelMeanCurvCoord (g.coeff (chartAt E3 z).symm) (fun y' => β ((chartAt E3 z).symm y')) y :=
by
  
  have hlmc : ∀ (G₁ G₂ : E3 → Matrix (Fin 3) (Fin 3) ℝ) (f : E3 → ℝ), G₁ =ᶠ[𝓝 y] G₂ →
      levelMeanCurvCoord G₁ f y = levelMeanCurvCoord G₂ f y := by
    intro G₁ G₂ f h
    have h0 : G₁ y = G₂ y := h.eq_of_nhds
    have hpd : ∀ a b c : Fin 3,
        partialDeriv c (fun w => G₁ w a b) y = partialDeriv c (fun w => G₂ w a b) y := by
      intro a b c
      have hev : (fun w => G₁ w a b) =ᶠ[𝓝 y] (fun w => G₂ w a b) :=
        h.mono (fun w hw => by simp only [hw])
      unfold partialDeriv
      rw [hev.fderiv_eq]
    have hchr : ∀ k i j : Fin 3, christoffel G₁ k i j y = christoffel G₂ k i j y := by
      intro k i j
      simp only [christoffel, h0, hpd]
    have hhess : ∀ i j : Fin 3, hessLoc G₁ f i j y = hessLoc G₂ f i j y := by
      intro i j
      simp only [hessLoc, hchr]
    have hlap : lapLoc G₁ f y = lapLoc G₂ f y := by
      simp only [lapLoc, h0, hhess]
    simp only [levelMeanCurvCoord, h0, hlap, hhess]
  
  have hΩ : IsOpen (chartAt E3 z).target := (chartAt E3 z).open_target
  obtain ⟨Φ, hsrc, hΦ⟩ := partialDiffeomorph_of_injOn z (chartAt E3 z).target hΩ id
    contDiffOn_id (Set.injOn_id _) (fun w hw => hw)
    (fun w _ => by rw [fderiv_id]; exact fun a b hab => by simpa using hab)
  have hΦ' : ∀ w ∈ (chartAt E3 z).target, Φ w = (chartAt E3 z).symm w := fun w hw => hΦ w hw
  
  have hcoeff : g.coeff Φ =ᶠ[𝓝 y] g.coeff (chartAt E3 z).symm := by
    filter_upwards [hΩ.mem_nhds hy] with y' hy'
    have hev : (⇑Φ) =ᶠ[𝓝 y'] (chartAt E3 z).symm := by
      filter_upwards [hΩ.mem_nhds hy'] with w hw
      exact hΦ' w hw
    have hmf := hev.mfderiv_eq (I := 𝓘(ℝ, E3)) (I' := 𝓘(ℝ, E3))
    have hval : Φ y' = (chartAt E3 z).symm y' := hΦ' y' hy'
    funext i j
    simp only [RiemannianMetric3.coeff, coeffMatrix]
    rw [hmf, hval]
  
  have hx : y ∈ Φ.source := hsrc ▸ hy
  have hfh : ∀ᶠ w in 𝓝 y, β (Φ w) = (fun y' => β ((chartAt E3 z).symm y')) w := by
    filter_upwards [hΩ.mem_nhds hy] with w hw
    show β (Φ w) = β ((chartAt E3 z).symm w)
    rw [hΦ' w hw]
  have h2 := levelMeanCurv_eq_coord g Φ β (fun y' => β ((chartAt E3 z).symm y')) hβ y hx hfh
  rw [hΦ' y hy] at h2
  rw [h2]
  exact hlmc _ _ _ hcoeff

theorem edge_curv2_formula (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (O : Set E2) (hO : IsOpen O) (hh : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun y => h y a b) O) (hsym : ∀ y ∈ O, ∀ a b : Fin 2, h y a b = h y b a) (hpd : ∀ y ∈ O, (h y).PosDef) (w : E2 → ℝ) (hw : ContDiffOn ℝ ∞ w O) (x : E2) (hx : x ∈ O) (hQ : 0 < sgbGradSq2 h w x) : sgbLevelCurv2 h w x = -((∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * gsCovD1 h (fun j y => pd2 j w y) a c x - (∑ a : Fin 2, ∑ c : Fin 2, (∑ d : Fin 2, (h x)⁻¹ a d * pd2 d w x) * (∑ d : Fin 2, (h x)⁻¹ c d * pd2 d w x) * gsCovD1 h (fun j y => pd2 j w y) a c x) / sgbGradSq2 h w x) / Real.sqrt (sgbGradSq2 h w x)) :=
by
  have hxU : O ∈ 𝓝 x := hO.mem_nhds hx
  have hw2 : ContDiffOn ℝ 2 w O := hw.of_le (WithTop.coe_le_coe.mpr le_top)
  have hdh : ∀ a b : Fin 2, DifferentiableAt ℝ (fun z => h z a b) x := fun a b =>
    ((hh a b).differentiableOn (by simp)).differentiableAt hxU
  
  have pmul : ∀ (f g : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
      pd2 k (fun z => f z * g z) x = pd2 k f x * g x + f x * pd2 k g x := by
    intro f g k hf hg
    unfold pd2
    rw [fderiv_fun_mul hf hg]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have padd : ∀ (f g : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
      pd2 k (fun z => f z + g z) x = pd2 k f x + pd2 k g x := by
    intro f g k hf hg
    unfold pd2
    rw [fderiv_fun_add hf hg]
    rfl
  have psub : ∀ (f g : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
      pd2 k (fun z => f z - g z) x = pd2 k f x - pd2 k g x := by
    intro f g k hf hg
    unfold pd2
    rw [fderiv_fun_sub hf hg]
    rfl
  have pneg : ∀ (f : E2 → ℝ) (k : Fin 2), pd2 k (fun z => -f z) x = -pd2 k f x := by
    intro f k
    unfold pd2
    rw [show (fun z => -f z) = -f from rfl, fderiv_neg]
    rfl
  have pinv : ∀ (f : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → f x ≠ 0 →
      pd2 k (fun z => (f z)⁻¹) x = -pd2 k f x / (f x) ^ 2 := by
    intro f k hf hf0
    unfold pd2
    have H := (hasDerivAt_inv hf0).comp_hasFDerivAt x hf.hasFDerivAt
    rw [show (fun z => (f z)⁻¹) = (fun y : ℝ => y⁻¹) ∘ f from rfl, H.fderiv]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    field_simp
  have psqrt : ∀ (f : E2 → ℝ) (k : Fin 2), DifferentiableAt ℝ f x → f x ≠ 0 →
      pd2 k (fun z => Real.sqrt (f z)) x = pd2 k f x / (2 * Real.sqrt (f x)) := by
    intro f k hf hf0
    unfold pd2
    rw [fderiv_sqrt hf hf0]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  
  have pdivsqrt : ∀ (P R : E2 → ℝ) (i : Fin 2), DifferentiableAt ℝ P x →
      DifferentiableAt ℝ R x → 0 < R x →
      pd2 i (fun y => P y / Real.sqrt (R y)) x =
        pd2 i P x / Real.sqrt (R x) - P x * pd2 i R x / (2 * R x * Real.sqrt (R x)) := by
    intro P R i hP hR hpos
    have hR0 : R x ≠ 0 := hpos.ne'
    have hS : DifferentiableAt ℝ (fun y => Real.sqrt (R y)) x := hR.sqrt hR0
    have hs0 : Real.sqrt (R x) ≠ 0 := (Real.sqrt_pos.mpr hpos).ne'
    have hss : Real.sqrt (R x) ^ 2 = R x := Real.sq_sqrt hpos.le
    have e : (fun y => P y / Real.sqrt (R y)) = fun y => P y * (Real.sqrt (R y))⁻¹ := by
      funext y; rw [div_eq_mul_inv]
    rw [e, pmul _ _ i hP (hS.fun_inv hs0), pinv _ i hS hs0, psqrt _ i hR hR0]
    beta_reduce
    rw [hss]
    field_simp
    ring
  
  have hinvE : ∀ (A : Matrix (Fin 2) (Fin 2) ℝ) (i j : Fin 2),
      A⁻¹ i j = A.det⁻¹ * A.adjugate i j := by
    intro A i j
    rw [Matrix.inv_def, Ring.inverse_eq_inv']
    rfl
  have hadj00 : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.adjugate 0 0 = A 1 1 := by
    intro A; simp [Matrix.adjugate_fin_two]
  have hadj01 : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.adjugate 0 1 = -A 0 1 := by
    intro A; simp [Matrix.adjugate_fin_two]
  have hadj10 : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.adjugate 1 0 = -A 1 0 := by
    intro A; simp [Matrix.adjugate_fin_two]
  have hadj11 : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.adjugate 1 1 = A 0 0 := by
    intro A; simp [Matrix.adjugate_fin_two]
  have hdetE : ∀ A : Matrix (Fin 2) (Fin 2) ℝ, A.det = A 0 0 * A 1 1 - A 0 1 * A 1 0 :=
    fun A => Matrix.det_fin_two A
  have hDpos : 0 < (h x).det := (hpd x hx).det_pos
  have hD0 : (h x).det ≠ 0 := hDpos.ne'
  have hx10 : h x 1 0 = h x 0 1 := hsym x hx 1 0
  have hd10 : ∀ l : Fin 2, pd2 l (fun z => h z 1 0) x = pd2 l (fun z => h z 0 1) x := by
    intro l
    have hev : (fun z => h z 1 0) =ᶠ[𝓝 x] (fun z => h z 0 1) :=
      Filter.eventually_of_mem hxU (fun z hz => hsym z hz 1 0)
    unfold pd2
    rw [Filter.EventuallyEq.fderiv_eq hev]
  
  have hdetfun : (fun z => (h z).det) = fun z => h z 0 0 * h z 1 1 - h z 0 1 * h z 1 0 := by
    funext z; exact hdetE (h z)
  have hdD : DifferentiableAt ℝ (fun z => (h z).det) x := by
    rw [hdetfun]; exact ((hdh 0 0).mul (hdh 1 1)).sub ((hdh 0 1).mul (hdh 1 0))
  have hdS : DifferentiableAt ℝ (fun z => Real.sqrt (h z).det) x := hdD.sqrt hD0
  have hdw : ∀ j : Fin 2, DifferentiableAt ℝ (pd2 j w) x := by
    intro j
    have h1 : ContDiffOn ℝ 1 (fun y => fderiv ℝ w y) O := hw2.fderiv_of_isOpen hO (by norm_num)
    have h2 : ContDiffOn ℝ 1 (pd2 j w) O := h1.clm_apply contDiffOn_const
    exact (h2.differentiableOn (by norm_num)).differentiableAt hxU
  have hdI : ∀ i j : Fin 2, DifferentiableAt ℝ (fun z => (h z)⁻¹ i j) x := by
    intro i j
    have e : (fun z => (h z)⁻¹ i j) = fun z => ((h z).det)⁻¹ * (h z).adjugate i j :=
      funext fun z => hinvE (h z) i j
    rw [e]
    refine (hdD.inv hD0).mul ?_
    fin_cases i <;> fin_cases j
    · simp only [Fin.zero_eta, hadj00]; exact hdh 1 1
    · simp only [Fin.zero_eta, Fin.mk_one, hadj01]; exact (hdh 0 1).neg
    · simp only [Fin.zero_eta, Fin.mk_one, hadj10]; exact (hdh 1 0).neg
    · simp only [Fin.mk_one, hadj11]; exact hdh 0 0
  
  have pD : ∀ k : Fin 2, pd2 k (fun z => (h z).det) x =
      pd2 k (fun z => h z 0 0) x * h x 1 1 + h x 0 0 * pd2 k (fun z => h z 1 1) x -
        (pd2 k (fun z => h z 0 1) x * h x 1 0 + h x 0 1 * pd2 k (fun z => h z 1 0) x) := by
    intro k
    rw [hdetfun, psub _ _ k ((hdh 0 0).fun_mul (hdh 1 1)) ((hdh 0 1).fun_mul (hdh 1 0)),
      pmul _ _ k (hdh 0 0) (hdh 1 1), pmul _ _ k (hdh 0 1) (hdh 1 0)]
  have pS : ∀ k : Fin 2, pd2 k (fun z => Real.sqrt (h z).det) x =
      Real.sqrt (h x).det * pd2 k (fun z => (h z).det) x / (2 * (h x).det) := by
    intro k
    rw [psqrt _ k hdD hD0]
    have hs0 : 0 < Real.sqrt (h x).det := Real.sqrt_pos.mpr hDpos
    have hss : Real.sqrt (h x).det * Real.sqrt (h x).det = (h x).det :=
      Real.mul_self_sqrt hDpos.le
    generalize Real.sqrt (h x).det = s at hs0 hss ⊢
    rw [← hss]
    field_simp
  have pI00 : ∀ k : Fin 2, pd2 k (fun z => (h z)⁻¹ 0 0) x =
      -pd2 k (fun z => (h z).det) x / (h x).det ^ 2 * h x 1 1 +
        (h x).det⁻¹ * pd2 k (fun z => h z 1 1) x := by
    intro k
    simp only [hinvE, hadj00]
    rw [pmul _ _ k (hdD.fun_inv hD0) (hdh 1 1), pinv _ k hdD hD0]
  have pI01 : ∀ k : Fin 2, pd2 k (fun z => (h z)⁻¹ 0 1) x =
      -pd2 k (fun z => (h z).det) x / (h x).det ^ 2 * (-h x 0 1) +
        (h x).det⁻¹ * (-pd2 k (fun z => h z 0 1) x) := by
    intro k
    simp only [hinvE, hadj01]
    rw [pmul _ _ k (hdD.fun_inv hD0) (hdh 0 1).fun_neg, pinv _ k hdD hD0, pneg]
  have pI10 : ∀ k : Fin 2, pd2 k (fun z => (h z)⁻¹ 1 0) x =
      -pd2 k (fun z => (h z).det) x / (h x).det ^ 2 * (-h x 1 0) +
        (h x).det⁻¹ * (-pd2 k (fun z => h z 1 0) x) := by
    intro k
    simp only [hinvE, hadj10]
    rw [pmul _ _ k (hdD.fun_inv hD0) (hdh 1 0).fun_neg, pinv _ k hdD hD0, pneg]
  have pI11 : ∀ k : Fin 2, pd2 k (fun z => (h z)⁻¹ 1 1) x =
      -pd2 k (fun z => (h z).det) x / (h x).det ^ 2 * h x 0 0 +
        (h x).det⁻¹ * pd2 k (fun z => h z 0 0) x := by
    intro k
    simp only [hinvE, hadj11]
    rw [pmul _ _ k (hdD.fun_inv hD0) (hdh 0 0), pinv _ k hdD hD0]
  
  have hdiv : pd2 0 (fun z => Real.sqrt (h z).det * ∑ j : Fin 2, (h z)⁻¹ 0 j * pd2 j w z) x +
      pd2 1 (fun z => Real.sqrt (h z).det * ∑ j : Fin 2, (h z)⁻¹ 1 j * pd2 j w z) x =
      Real.sqrt (h x).det * lap2 h w x := by
    simp only [Fin.sum_univ_two]
    have hdA : ∀ i : Fin 2, DifferentiableAt ℝ
        (fun z => (h z)⁻¹ i 0 * pd2 0 w z + (h z)⁻¹ i 1 * pd2 1 w z) x :=
      fun i => ((hdI i 0).fun_mul (hdw 0)).fun_add ((hdI i 1).fun_mul (hdw 1))
    rw [pmul _ _ 0 hdS (hdA 0), pmul _ _ 1 hdS (hdA 1),
      padd _ _ 0 ((hdI 0 0).fun_mul (hdw 0)) ((hdI 0 1).fun_mul (hdw 1)),
      padd _ _ 1 ((hdI 1 0).fun_mul (hdw 0)) ((hdI 1 1).fun_mul (hdw 1)),
      pmul _ _ 0 (hdI 0 0) (hdw 0), pmul _ _ 0 (hdI 0 1) (hdw 1),
      pmul _ _ 1 (hdI 1 0) (hdw 0), pmul _ _ 1 (hdI 1 1) (hdw 1),
      pS 0, pS 1, pI00 0, pI01 0, pI10 1, pI11 1, pD 0, pD 1]
    simp only [lap2, christoffel2, Fin.sum_univ_two, hinvE (h x), hadj00, hadj01, hadj10, hadj11]
    generalize Real.sqrt (h x).det = s
    simp only [hx10, hd10]
    field_simp
    simp only [hdetE (h x), hx10]
    ring
  have hlap : lap2 h w x =
      ∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * gsCovD1 h (fun j y => pd2 j w y) a c x := by
    simp only [lap2, gsCovD1]
  
  have hQfun : sgbGradSq2 h w = fun y =>
      ((h y)⁻¹ 0 0 * pd2 0 w y * pd2 0 w y + (h y)⁻¹ 0 1 * pd2 0 w y * pd2 1 w y) +
      ((h y)⁻¹ 1 0 * pd2 1 w y * pd2 0 w y + (h y)⁻¹ 1 1 * pd2 1 w y * pd2 1 w y) := by
    funext y; simp only [sgbGradSq2, Fin.sum_univ_two]
  have dt : ∀ a c : Fin 2, DifferentiableAt ℝ (fun z => (h z)⁻¹ a c * pd2 a w z * pd2 c w z) x :=
    fun a c => ((hdI a c).fun_mul (hdw a)).fun_mul (hdw c)
  have hdQ : DifferentiableAt ℝ (sgbGradSq2 h w) x := by
    rw [hQfun]
    exact ((dt 0 0).fun_add (dt 0 1)).fun_add ((dt 1 0).fun_add (dt 1 1))
  have pt : ∀ a c k : Fin 2, pd2 k (fun z => (h z)⁻¹ a c * pd2 a w z * pd2 c w z) x =
      pd2 k (fun z => (h z)⁻¹ a c) x * pd2 a w x * pd2 c w x +
        (h x)⁻¹ a c * pd2 k (pd2 a w) x * pd2 c w x +
        (h x)⁻¹ a c * pd2 a w x * pd2 k (pd2 c w) x := by
    intro a c k
    rw [pmul _ _ k ((hdI a c).fun_mul (hdw a)) (hdw c), pmul _ _ k (hdI a c) (hdw a)]
    ring
  have pQ : ∀ k : Fin 2, pd2 k (sgbGradSq2 h w) x =
      2 * ∑ m : Fin 2, (∑ d : Fin 2, (h x)⁻¹ m d * pd2 d w x) *
        gsCovD1 h (fun j y => pd2 j w y) k m x := by
    intro k
    rw [hQfun, padd _ _ k ((dt 0 0).fun_add (dt 0 1)) ((dt 1 0).fun_add (dt 1 1)),
      padd _ _ k (dt 0 0) (dt 0 1), padd _ _ k (dt 1 0) (dt 1 1), pt, pt, pt, pt]
    rw [pI00, pI01, pI10, pI11, pD]
    obtain rfl | rfl : k = 0 ∨ k = 1 := by fin_cases k <;> simp
    all_goals
      simp only [gsCovD1, christoffel2, Fin.sum_univ_two, hinvE (h x), hadj00, hadj01, hadj10,
        hadj11]
      simp only [hx10, hd10]
      field_simp
      simp only [hdetE (h x), hx10]
      ring
  
  have hP : ∀ i : Fin 2, DifferentiableAt ℝ
      (fun y => Real.sqrt (h y).det * ∑ a : Fin 2, (h y)⁻¹ i a * pd2 a w y) x := by
    intro i
    simp only [Fin.sum_univ_two]
    exact hdS.fun_mul (((hdI i 0).fun_mul (hdw 0)).fun_add ((hdI i 1).fun_mul (hdw 1)))
  have hs0 : Real.sqrt (h x).det ≠ 0 := (Real.sqrt_pos.mpr hDpos).ne'
  have hr0 : Real.sqrt (sgbGradSq2 h w x) ≠ 0 := (Real.sqrt_pos.mpr hQ).ne'
  have hq0 : sgbGradSq2 h w x ≠ 0 := hQ.ne'
  rw [hlap] at hdiv
  unfold sgbLevelCurv2
  rw [Fin.sum_univ_two, pdivsqrt _ _ 0 (hP 0) hdQ hQ, pdivsqrt _ _ 1 (hP 1) hdQ hQ, pQ 0, pQ 1]
  linear_combination (norm := skip)
    (-((Real.sqrt (h x).det)⁻¹ / Real.sqrt (sgbGradSq2 h w x))) * hdiv
  simp only [Fin.sum_univ_two]
  field_simp
  ring

theorem edge_sqrt_neumann (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (V : Set E3) (hV : IsOpen V) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) V) (hsymm : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i) (hpd : ∀ y ∈ V, (G y).PosDef) (f b : E3 → ℝ) (hf : ContDiffOn ℝ ∞ f V) (hb : ContDiffOn ℝ ∞ b V) (hneuV : ∀ z ∈ V, b z = 0 → gradInnerLoc G f b z = 0) (y : E3) (hy : y ∈ V) (hby : b y = 0) (hdb : 0 < gradSqLoc G b y) (hdf : 0 < gradSqLoc G f y) : DifferentiableAt ℝ (fun z => Real.sqrt (gradSqLoc G f z)) y ∧ gradInnerLoc G b (fun z => Real.sqrt (gradSqLoc G f z)) y / Real.sqrt (gradSqLoc G f y) = -(hessGGLoc G b f y / gradSqLoc G f y) :=
by
  have hVy : V ∈ 𝓝 y := hV.mem_nhds hy
  have hinf0 : (∞ : WithTop ℕ∞) ≠ 0 := by simp
  have h1inf : (1 : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast (le_top : (1 : ℕ∞) ≤ ⊤)
  have hGT : ∀ z, Matrix.transpose (G z) = G z := fun z => Matrix.ext fun i j => by
    rw [Matrix.transpose_apply]; exact hsymm z j i
  have hAsymG : ∀ z (i j : Fin 3), (G z)⁻¹ i j = (G z)⁻¹ j i := by
    intro z i j
    have h : Matrix.transpose ((G z)⁻¹) j i = (Matrix.transpose (G z))⁻¹ j i := by
      rw [Matrix.transpose_nonsing_inv]
    rw [Matrix.transpose_apply, hGT z] at h
    exact h
  have hdet : ∀ z ∈ V, (G z).det ≠ 0 := fun z hz => ((hpd z hz).det_pos).ne'
  have hinvC : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => (G z)⁻¹ i j) V := by
    have h00 := hG 0 0
    have h01 := hG 0 1
    have h02 := hG 0 2
    have h10 := hG 1 0
    have h11 := hG 1 1
    have h12 := hG 1 2
    have h20 := hG 2 0
    have h21 := hG 2 1
    have h22 := hG 2 2
    have hdC : ContDiffOn ℝ ∞ (fun z => (G z).det) V := by
      simp only [Matrix.det_fin_three]
      fun_prop
    have hdi : ContDiffOn ℝ ∞ (fun z => ((G z).det)⁻¹) V := hdC.inv hdet
    have key : ∀ z (i j : Fin 3), (G z)⁻¹ i j = ((G z).det)⁻¹ * (G z).adjugate i j := by
      intro z i j
      rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
    intro i j
    have hadj : ContDiffOn ℝ ∞ (fun z => (G z).adjugate i j) V := by
      fin_cases i <;> fin_cases j <;> simp [Matrix.adjugate_fin_three] <;> fun_prop
    exact (hdi.mul hadj).congr (fun z _ => key z i j)
  have hGd : ∀ i j : Fin 3, DifferentiableAt ℝ (fun z => G z i j) y := fun i j =>
    ((hG i j).contDiffAt hVy).differentiableAt hinf0
  have hAd : ∀ i j : Fin 3, DifferentiableAt ℝ (fun z => (G z)⁻¹ i j) y := fun i j =>
    ((hinvC i j).contDiffAt hVy).differentiableAt hinf0
  have hdA : ∀ k i l : Fin 3, partialDeriv k (fun z => (G z)⁻¹ i l) y =
      -∑ a : Fin 3, ∑ c : Fin 3,
        (G y)⁻¹ i a * partialDeriv k (fun z => G z a c) y * (G y)⁻¹ c l := by
    intro k i l
    have hstar : ∀ j : Fin 3, ∑ c : Fin 3, (partialDeriv k (fun z => (G z)⁻¹ i c) y * G y c j
        + (G y)⁻¹ i c * partialDeriv k (fun z => G z c j) y) = 0 := by
      intro j
      have hev : (fun z => ∑ c : Fin 3, (G z)⁻¹ i c * G z c j) =ᶠ[𝓝 y]
          (fun _ => if i = j then (1 : ℝ) else 0) := by
        filter_upwards [hVy] with z hz
        have h1 : (G z)⁻¹ * G z = 1 :=
          Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr (hdet z hz))
        have h2 := congrArg (fun M => M i j) h1
        simpa [Matrix.mul_apply, Matrix.one_apply] using h2
      have hD : HasFDerivAt (fun z => ∑ c : Fin 3, (G z)⁻¹ i c * G z c j)
          (∑ c : Fin 3, ((G y)⁻¹ i c • fderiv ℝ (fun z => G z c j) y
            + G y c j • fderiv ℝ (fun z => (G z)⁻¹ i c) y)) y := by
        apply HasFDerivAt.fun_sum
        intro c _
        exact (hAd i c).hasFDerivAt.mul (hGd c j).hasFDerivAt
      have hD0 : HasFDerivAt (fun z => ∑ c : Fin 3, (G z)⁻¹ i c * G z c j)
          (0 : E3 →L[ℝ] ℝ) y :=
        (hasFDerivAt_const _ y).congr_of_eventuallyEq hev
      have h3 := congrArg (fun L => L (e k)) (hD.unique hD0)
      simp only [ContinuousLinearMap.sum_apply, ContinuousLinearMap.add_apply,
        ContinuousLinearMap.smul_apply, smul_eq_mul, ContinuousLinearMap.zero_apply] at h3
      refine Eq.trans (Finset.sum_congr rfl (fun c _ => ?_)) h3
      simp only [partialDeriv]
      ring
    have hGA : ∀ c : Fin 3, ∑ j : Fin 3, G y c j * (G y)⁻¹ j l = if c = l then 1 else 0 := by
      intro c
      have h1 : G y * (G y)⁻¹ = 1 :=
        Matrix.mul_nonsing_inv _ (isUnit_iff_ne_zero.mpr (hdet y hy))
      have h2 := congrArg (fun M => M c l) h1
      simpa [Matrix.mul_apply, Matrix.one_apply] using h2
    have e1 : partialDeriv k (fun z => (G z)⁻¹ i l) y = ∑ c : Fin 3,
        partialDeriv k (fun z => (G z)⁻¹ i c) y * ∑ j : Fin 3, G y c j * (G y)⁻¹ j l := by
      simp only [hGA, mul_ite, mul_one, mul_zero, Finset.sum_ite_eq', Finset.mem_univ, if_true]
    rw [e1]
    have e2 : ∀ j : Fin 3, ∑ c : Fin 3, partialDeriv k (fun z => (G z)⁻¹ i c) y * G y c j =
        -∑ c : Fin 3, (G y)⁻¹ i c * partialDeriv k (fun z => G z c j) y := by
      intro j
      have := hstar j
      rw [Finset.sum_add_distrib] at this
      linarith
    have e20 := e2 0
    have e21 := e2 1
    have e22 := e2 2
    simp only [Fin.sum_univ_three] at e20 e21 e22 ⊢
    linear_combination (G y)⁻¹ 0 l * e20 + (G y)⁻¹ 1 l * e21 + (G y)⁻¹ 2 l * e22
  have hpartC : ∀ (u : E3 → ℝ), ContDiffOn ℝ ∞ u V → ∀ i : Fin 3,
      ContDiffOn ℝ ∞ (partialDeriv i u) V := by
    intro u hu i
    have h1 : ContDiffOn ℝ ∞ (fderiv ℝ u) V := hu.fderiv_of_isOpen hV (le_of_eq rfl)
    exact h1.clm_apply contDiffOn_const
  have hgiC : ∀ u w : E3 → ℝ, ContDiffOn ℝ ∞ u V → ContDiffOn ℝ ∞ w V →
      ContDiffOn ℝ ∞ (gradInnerLoc G u w) V := by
    intro u w hu hw
    show ContDiffOn ℝ ∞ (fun z => ∑ i : Fin 3, ∑ j : Fin 3,
      (G z)⁻¹ i j * partialDeriv i u z * partialDeriv j w z) V
    apply ContDiffOn.sum
    intro i _
    apply ContDiffOn.sum
    intro j _
    exact ((hinvC i j).mul (hpartC u hu i)).mul (hpartC w hw j)
  have hlag : ∀ (F : E3 → ℝ), ContDiffAt ℝ 1 b y → ContDiffAt ℝ 1 F y →
      (∀ z ∈ V, b z = b y → F z = F y) → fderiv ℝ b y ≠ 0 →
      ∀ w : E3, fderiv ℝ b y w = 0 → fderiv ℝ F y w = 0 := by
    intro F hb1 hF1 hloc hne w hw
    have hext : IsLocalExtrOn F {z | b z = b y} y := by
      refine Or.inl ?_
      show ∀ᶠ z in 𝓝[{z | b z = b y}] y, F y ≤ F z
      filter_upwards [mem_nhdsWithin_of_mem_nhds hVy, self_mem_nhdsWithin] with z hz1 hz2
      exact le_of_eq (hloc z hz1 hz2).symm
    obtain ⟨a, c, hac, hsum⟩ := hext.exists_multipliers_of_hasStrictFDerivAt_1d
      (hb1.hasStrictFDerivAt one_ne_zero) (hF1.hasStrictFDerivAt one_ne_zero)
    have h := congrArg (fun L => L w) hsum
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul, hw,
      mul_zero, zero_add, ContinuousLinearMap.zero_apply] at h
    rcases mul_eq_zero.mp h with hc | hc
    · exfalso
      have ha : a ≠ 0 := by
        intro ha
        exact hac (by simp [ha, hc])
      apply hne
      have h5 : a • fderiv ℝ b y = 0 := by simpa [hc] using hsum
      exact (smul_eq_zero.mp h5).resolve_left ha
    · exact hc
  have hgiP : ∀ u w : E3 → ℝ, (∀ i : Fin 3, DifferentiableAt ℝ (partialDeriv i u) y) →
      (∀ j : Fin 3, DifferentiableAt ℝ (partialDeriv j w) y) → ∀ k : Fin 3,
      partialDeriv k (gradInnerLoc G u w) y = ∑ i : Fin 3, ∑ j : Fin 3,
        (partialDeriv k (fun z => (G z)⁻¹ i j) y * partialDeriv i u y * partialDeriv j w y
          + (G y)⁻¹ i j * partialDeriv k (partialDeriv i u) y * partialDeriv j w y
          + (G y)⁻¹ i j * partialDeriv i u y * partialDeriv k (partialDeriv j w) y) := by
    intro u w hu hw k
    have hD : HasFDerivAt (gradInnerLoc G u w) (∑ i : Fin 3, ∑ j : Fin 3,
        (((G y)⁻¹ i j * partialDeriv i u y) • fderiv ℝ (partialDeriv j w) y
          + partialDeriv j w y • ((G y)⁻¹ i j • fderiv ℝ (partialDeriv i u) y
            + partialDeriv i u y • fderiv ℝ (fun z => (G z)⁻¹ i j) y))) y := by
      have hfun : gradInnerLoc G u w = fun z => ∑ i : Fin 3, ∑ j : Fin 3,
          (G z)⁻¹ i j * partialDeriv i u z * partialDeriv j w z := rfl
      rw [hfun]
      apply HasFDerivAt.fun_sum
      intro i _
      apply HasFDerivAt.fun_sum
      intro j _
      exact ((hAd i j).hasFDerivAt.mul (hu i).hasFDerivAt).mul (hw j).hasFDerivAt
    rw [show partialDeriv k (gradInnerLoc G u w) y = fderiv ℝ (gradInnerLoc G u w) y (e k)
      from rfl, hD.fderiv]
    simp only [ContinuousLinearMap.sum_apply, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul]
    apply Finset.sum_congr rfl
    intro i _
    apply Finset.sum_congr rfl
    intro j _
    simp only [partialDeriv]
    ring
  have hfy : ContDiffAt ℝ ∞ f y := hf.contDiffAt hVy
  have hsch : ∀ i k : Fin 3,
      partialDeriv k (partialDeriv i f) y = partialDeriv i (partialDeriv k f) y := by
    have h2 : ContDiffAt ℝ 1 (fderiv ℝ f) y :=
      (hfy.fderiv_right (m := ∞) (le_of_eq rfl)).of_le h1inf
    have hd : DifferentiableAt ℝ (fderiv ℝ f) y := h2.differentiableAt one_ne_zero
    have hsym := hfy.isSymmSndFDerivAt (by
      rw [minSmoothness_of_isRCLikeNormedField]; exact WithTop.coe_le_coe.mpr le_top)
    have hpp : ∀ i k : Fin 3,
        partialDeriv k (partialDeriv i f) y = fderiv ℝ (fderiv ℝ f) y (e k) (e i) := by
      intro i k
      show fderiv ℝ (fun z => fderiv ℝ f z (e i)) y (e k) = _
      rw [fderiv_clm_apply hd (differentiableAt_const (e i))]
      simp
    intro i k
    rw [hpp, hpp]
    exact hsym _ _
  have hSd : DifferentiableAt ℝ (gradSqLoc G f) y :=
    ((hgiC f f hf hf).contDiffAt hVy).differentiableAt hinf0
  have halg : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ) (dA D : Fin 3 → Fin 3 → Fin 3 → ℝ)
      (f1 b1 : Fin 3 → ℝ) (f2 b2 : Fin 3 → Fin 3 → ℝ) (P Q : Fin 3 → ℝ),
      (∀ i j, A i j = A j i) →
      (∀ k i j, dA k i j = -∑ a : Fin 3, ∑ c : Fin 3, A i a * D k a c * A c j) →
      (∀ k i, f2 k i = f2 i k) →
      (∀ k, P k = ∑ i : Fin 3, ∑ j : Fin 3, (dA k i j * f1 i * b1 j + A i j * f2 k i * b1 j
        + A i j * f1 i * b2 k j)) →
      (∀ k, Q k = ∑ i : Fin 3, ∑ j : Fin 3, (dA k i j * f1 i * f1 j + A i j * f2 k i * f1 j
        + A i j * f1 i * f2 k j)) →
      ∑ k : Fin 3, (∑ a : Fin 3, A k a * f1 a) * P k =
        (1 / 2 : ℝ) * ∑ k : Fin 3, ∑ l : Fin 3, A k l * Q k * b1 l +
        ∑ i : Fin 3, ∑ j : Fin 3, (∑ a : Fin 3, A i a * f1 a) * (∑ a : Fin 3, A j a * f1 a) *
          (b2 i j - ∑ m : Fin 3,
            ((1 / 2 : ℝ) * ∑ l : Fin 3, A m l * (D i j l + D j i l - D l i j)) * b1 m) := by
    intro A dA D f1 b1 f2 b2 P Q hA hdA' hf2 hP hQ
    simp only [hP, hQ, hdA']
    simp only [Fin.sum_univ_three]
    rw [hA 1 0, hA 2 0, hA 2 1, hf2 1 0, hf2 2 0, hf2 2 1]
    ring
  have hpfd : ∀ i : Fin 3, DifferentiableAt ℝ (partialDeriv i f) y := fun i =>
    ((hpartC f hf i).contDiffAt hVy).differentiableAt hinf0
  have hpbd : ∀ i : Fin 3, DifferentiableAt ℝ (partialDeriv i b) y := fun i =>
    ((hpartC b hb i).contDiffAt hVy).differentiableAt hinf0
  have hb1 : ContDiffAt ℝ 1 b y := (hb.contDiffAt hVy).of_le h1inf
  have hFd1 : ContDiffAt ℝ 1 (gradInnerLoc G f b) y :=
    ((hgiC f b hf hb).contDiffAt hVy).of_le h1inf
  have hbne : fderiv ℝ b y ≠ 0 := by
    intro h0
    have h4 : gradSqLoc G b y = 0 := by
      simp only [gradSqLoc, gradInnerLoc, partialDeriv, h0, ContinuousLinearMap.zero_apply,
        mul_zero, Finset.sum_const_zero]
    linarith
  have hFnz : gradInnerLoc G f b y = 0 := hneuV y hy hby
  have hlin : ∀ (L : E3 →L[ℝ] ℝ), L (∑ i : Fin 3, gradUpLoc G f y i • e i) =
      ∑ i : Fin 3, gradUpLoc G f y i * L (e i) := by
    intro L
    simp only [map_sum, map_smul, smul_eq_mul]
  have hbw : fderiv ℝ b y (∑ i : Fin 3, gradUpLoc G f y i • e i) = 0 := by
    rw [hlin]
    have h4 : gradInnerLoc G f b y = ∑ i : Fin 3, gradUpLoc G f y i * fderiv ℝ b y (e i) := by
      simp only [gradInnerLoc, gradUpLoc, partialDeriv, Fin.sum_univ_three]
      rw [hAsymG y 1 0, hAsymG y 2 0, hAsymG y 2 1]
      ring
    rw [← h4, hFnz]
  have hFw := hlag (gradInnerLoc G f b) hb1 hFd1
    (fun z hz hbz => by rw [hneuV z hz (hbz.trans hby), hFnz]) hbne _ hbw
  rw [hlin] at hFw
  have hsum0 : ∑ k : Fin 3, gradUpLoc G f y k * partialDeriv k (gradInnerLoc G f b) y = 0 := hFw
  have hmain : ∑ k : Fin 3, gradUpLoc G f y k * partialDeriv k (gradInnerLoc G f b) y =
      (1 / 2 : ℝ) * ∑ k : Fin 3, ∑ l : Fin 3,
        (G y)⁻¹ k l * partialDeriv k (gradSqLoc G f) y * partialDeriv l b y +
      hessGGLoc G b f y :=
    halg (G y)⁻¹ (fun k i j => partialDeriv k (fun z => (G z)⁻¹ i j) y)
      (fun k a c => partialDeriv k (fun z => G z a c) y)
      (fun i => partialDeriv i f y) (fun j => partialDeriv j b y)
      (fun k i => partialDeriv k (partialDeriv i f) y)
      (fun k j => partialDeriv k (partialDeriv j b) y)
      (fun k => partialDeriv k (gradInnerLoc G f b) y)
      (fun k => partialDeriv k (gradSqLoc G f) y)
      (hAsymG y) hdA (fun k i => hsch i k)
      (hgiP f b hpfd hpbd) (hgiP f f hpfd hpfd)
  have hS : (1 / 2 : ℝ) * ∑ k : Fin 3, ∑ l : Fin 3,
      (G y)⁻¹ k l * partialDeriv k (gradSqLoc G f) y * partialDeriv l b y =
        -hessGGLoc G b f y := by linarith [hmain, hsum0]
  
  have hD0 : HasFDerivAt (fun z => Real.sqrt (gradSqLoc G f z))
      ((1 / (2 * Real.sqrt (gradSqLoc G f y))) • fderiv ℝ (gradSqLoc G f) y) y :=
    hSd.hasFDerivAt.sqrt hdf.ne'
  refine ⟨hD0.differentiableAt, ?_⟩
  have hΦP : ∀ k : Fin 3, partialDeriv k (fun z => Real.sqrt (gradSqLoc G f z)) y =
      partialDeriv k (gradSqLoc G f) y / (2 * Real.sqrt (gradSqLoc G f y)) := by
    intro k
    show fderiv ℝ (fun z => Real.sqrt (gradSqLoc G f z)) y (e k) =
      fderiv ℝ (gradSqLoc G f) y (e k) / (2 * Real.sqrt (gradSqLoc G f y))
    rw [hD0.fderiv, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  have hgi : gradInnerLoc G b (fun z => Real.sqrt (gradSqLoc G f z)) y =
      ((1 / 2 : ℝ) * ∑ k : Fin 3, ∑ l : Fin 3,
        (G y)⁻¹ k l * partialDeriv k (gradSqLoc G f) y * partialDeriv l b y) /
        Real.sqrt (gradSqLoc G f y) := by
    simp only [gradInnerLoc, hΦP, Fin.sum_univ_three]
    rw [hAsymG y 1 0, hAsymG y 2 0, hAsymG y 2 1]
    ring
  have hsq : Real.sqrt (gradSqLoc G f y) * Real.sqrt (gradSqLoc G f y) = gradSqLoc G f y :=
    Real.mul_self_sqrt hdf.le
  rw [hgi, hS, div_div, hsq, neg_div]

theorem edge_hess2_chain (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (V : Set E3) (hV : IsOpen V) (b : E3 → ℝ) (hb : ContDiffOn ℝ ∞ b V) (F : E2 → E3) (W : Set E2) (hW : IsOpen W) (hF : ContDiffOn ℝ ∞ F W) (hFV : ∀ x ∈ W, F x ∈ V) (x : E2) (hx : x ∈ W) : (∀ x' ∈ W, ∀ c : Fin 2, pd2 c (fun y => b (F y)) x' = ∑ k : Fin 3, partialDeriv k b (F x') * gsTan F c x' k) ∧ (∀ a c : Fin 2, pd2 a (fun x' => pd2 c (fun y => b (F y)) x') x = ∑ k : Fin 3, ∑ l : Fin 3, gsTan F a x k * gsTan F c x l * hessLoc G b k l (F x) + ∑ k : Fin 3, partialDeriv k b (F x) * gsCovHess G F a c x k) :=
by
  have hbasis : ∀ v : E3, v = ∑ d : Fin 3, v d • e d := by
    intro v
    conv_lhs => rw [← (EuclideanSpace.basisFun (Fin 3) ℝ).sum_repr v]
    simp [EuclideanSpace.basisFun_apply]
  
  have s1 : ∀ (φ : E3 → ℝ) (x' : E2), DifferentiableAt ℝ φ (F x') → DifferentiableAt ℝ F x' →
      ∀ c : Fin 2, pd2 c (fun y => φ (F y)) x' =
        ∑ k : Fin 3, partialDeriv k φ (F x') * gsTan F c x' k := by
    intro φ x' hφ hFd c
    have h1 : pd2 c (fun y => φ (F y)) x' = fderiv ℝ φ (F x') (gsTan F c x') := by
      show fderiv ℝ (φ ∘ F) x' (e2 c) = _
      rw [fderiv_comp x' hφ hFd]
      rfl
    rw [h1]
    conv_lhs => rw [hbasis (gsTan F c x')]
    rw [map_sum]
    simp only [map_smul, smul_eq_mul]
    apply Finset.sum_congr rfl
    intro d _
    rw [mul_comm]
    rfl
  have hFd : ∀ x' ∈ W, DifferentiableAt ℝ F x' := fun x' hx' =>
    (hF.contDiffAt (hW.mem_nhds hx')).differentiableAt (by simp)
  have hbd : ∀ x' ∈ W, DifferentiableAt ℝ b (F x') := fun x' hx' =>
    (hb.contDiffAt (hV.mem_nhds (hFV x' hx'))).differentiableAt (by simp)
  have C1 : ∀ x' ∈ W, ∀ c : Fin 2, pd2 c (fun y => b (F y)) x' =
      ∑ k : Fin 3, partialDeriv k b (F x') * gsTan F c x' k :=
    fun x' hx' c => s1 b x' (hbd x' hx') (hFd x' hx') c
  
  have hbfd : ContDiffOn ℝ ∞ (fderiv ℝ b) V :=
    ((contDiffOn_infty_iff_fderiv_of_isOpen hV).mp hb).2
  have s2 : ∀ l : Fin 3, ContDiffOn ℝ ∞ (partialDeriv l b) V := by
    intro l
    have h : ContDiffOn ℝ ∞ (fun y => fderiv ℝ b y (e l)) V := hbfd.clm_apply contDiffOn_const
    exact h
  
  have hFfd : ContDiffOn ℝ ∞ (fderiv ℝ F) W :=
    ((contDiffOn_infty_iff_fderiv_of_isOpen hW).mp hF).2
  have hTd : ∀ c : Fin 2, DifferentiableAt ℝ (fun y => fderiv ℝ F y (e2 c)) x := fun c =>
    ((hFfd.clm_apply contDiffOn_const).contDiffAt (hW.mem_nhds hx)).differentiableAt (by simp)
  have hcomp3 : ∀ (c : Fin 2) (l : Fin 3), (fun x' => gsTan F c x' l) =
      (EuclideanSpace.proj l : E3 →L[ℝ] ℝ) ∘ (fun y => fderiv ℝ F y (e2 c)) := by
    intro c l
    funext y
    simp [gsTan]
  have s3d : ∀ (c : Fin 2) (l : Fin 3), DifferentiableAt ℝ (fun x' => gsTan F c x' l) x := by
    intro c l
    rw [hcomp3 c l]
    exact (EuclideanSpace.proj l : E3 →L[ℝ] ℝ).differentiableAt.comp x (hTd c)
  have s3e : ∀ (a c : Fin 2) (l : Fin 3),
      fderiv ℝ (fun x' => gsTan F c x' l) x (e2 a) = gsHessF F a c x l := by
    intro a c l
    rw [hcomp3 c l, fderiv_comp x (EuclideanSpace.proj l : E3 →L[ℝ] ℝ).differentiableAt (hTd c),
      ContinuousLinearMap.fderiv]
    simp [gsHessF]
  refine ⟨C1, fun a c => ?_⟩
  have hev : (fun x' => pd2 c (fun y => b (F y)) x') =ᶠ[𝓝 x]
      (fun x' => ∑ l : Fin 3, partialDeriv l b (F x') * gsTan F c x' l) :=
    Filter.eventually_of_mem (hW.mem_nhds hx) (fun x' hx' => C1 x' hx' c)
  have hpbd : ∀ l : Fin 3, DifferentiableAt ℝ (partialDeriv l b) (F x) := fun l =>
    ((s2 l).contDiffAt (hV.mem_nhds (hFV x hx))).differentiableAt (by simp)
  have hAd : ∀ l : Fin 3, DifferentiableAt ℝ (fun x' => partialDeriv l b (F x')) x := fun l =>
    (hpbd l).comp x (hFd x hx)
  have hAe : ∀ l : Fin 3, fderiv ℝ (fun x' => partialDeriv l b (F x')) x (e2 a) =
      ∑ k : Fin 3, partialDeriv k (partialDeriv l b) (F x) * gsTan F a x k := fun l =>
    s1 (partialDeriv l b) x (hpbd l) (hFd x hx) a
  have hL : pd2 a (fun x' => pd2 c (fun y => b (F y)) x') x =
      fderiv ℝ (fun x' => ∑ l : Fin 3, partialDeriv l b (F x') * gsTan F c x' l) x (e2 a) := by
    show fderiv ℝ (fun x' => pd2 c (fun y => b (F y)) x') x (e2 a) = _
    rw [hev.fderiv_eq]
  have hprod : fderiv ℝ (fun x' => ∑ l : Fin 3, partialDeriv l b (F x') * gsTan F c x' l) x (e2 a)
      = ∑ l : Fin 3, (partialDeriv l b (F x) * gsHessF F a c x l +
          gsTan F c x l * ∑ k : Fin 3, partialDeriv k (partialDeriv l b) (F x) * gsTan F a x k) := by
    rw [fderiv_fun_sum (u := Finset.univ)
      (A := fun l x' => partialDeriv l b (F x') * gsTan F c x' l)
      (fun l _ => (hAd l).mul (s3d c l))]
    rw [ContinuousLinearMap.sum_apply]
    apply Finset.sum_congr rfl
    intro l _
    rw [fderiv_fun_mul (hAd l) (s3d c l)]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    rw [s3e a c l, hAe l]
  rw [hL, hprod]
  simp only [hessLoc, gsCovHess, Fin.sum_univ_three]
  ring

theorem edge_tangential_proj (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F : E2 → E3) (x : E2) (hdet : (G (F x)).det ≠ 0) (α γ : Fin 3 → ℝ) (a c : Fin 2) (hkos : ∀ m : Fin 2, ggeGam1 (pullMetric2 G F) m a c x = ∑ a' : Fin 3, ∑ b' : Fin 3, gsTan F m x a' * G (F x) a' b' * gsCovHess G F a c x b') (hsplit : ∀ p q : Fin 3 → ℝ, ∑ i : Fin 3, ∑ j : Fin 3, (G (F x))⁻¹ i j * p i * q j = ∑ a₁ : Fin 2, ∑ c₁ : Fin 2, (pullMetric2 G F x)⁻¹ a₁ c₁ * (∑ k : Fin 3, p k * gsTan F a₁ x k) * (∑ k : Fin 3, q k * gsTan F c₁ x k) + (∑ i : Fin 3, ∑ j : Fin 3, (G (F x))⁻¹ i j * α i * p j) * (∑ i : Fin 3, ∑ j : Fin 3, (G (F x))⁻¹ i j * α i * q j) / (∑ i : Fin 3, ∑ j : Fin 3, (G (F x))⁻¹ i j * α i * α j)) (hαγ : ∑ i : Fin 3, ∑ j : Fin 3, (G (F x))⁻¹ i j * α i * γ j = 0) : ∑ k : Fin 3, γ k * gsCovHess G F a c x k = ∑ m : Fin 2, christoffel2 (pullMetric2 G F) m a c x * ∑ k : Fin 3, γ k * gsTan F m x k :=
by
  have hinv : (G (F x))⁻¹ * G (F x) = 1 := Matrix.nonsing_inv_mul _ (Ne.isUnit hdet)
  have hent : ∀ i l : Fin 3, ∑ j : Fin 3, (G (F x))⁻¹ i j * G (F x) j l =
      if i = l then (1 : ℝ) else 0 := by
    intro i l
    have h1 := congrFun (congrFun hinv i) l
    rw [Matrix.mul_apply, Matrix.one_apply] at h1
    exact h1
  have hchr : ∀ m : Fin 2, christoffel2 (pullMetric2 G F) m a c x =
      ∑ l : Fin 2, (pullMetric2 G F x)⁻¹ m l * ggeGam1 (pullMetric2 G F) l a c x := by
    intro m
    simp only [christoffel2, ggeGam1, Finset.mul_sum]
    exact Finset.sum_congr rfl (fun l _ => by ring)
  have htan : ∀ c₁ : Fin 2, ∑ k : Fin 3,
      (∑ l : Fin 3, G (F x) k l * gsCovHess G F a c x l) * gsTan F c₁ x k =
        ggeGam1 (pullMetric2 G F) c₁ a c x := by
    intro c₁
    rw [hkos c₁]
    simp only [Finset.sum_mul]
    exact Finset.sum_congr rfl (fun k _ => Finset.sum_congr rfl (fun l _ => by ring))
  have hlhs : ∑ i : Fin 3, ∑ j : Fin 3, (G (F x))⁻¹ i j * γ i *
      (∑ l : Fin 3, G (F x) j l * gsCovHess G F a c x l) =
        ∑ k : Fin 3, γ k * gsCovHess G F a c x k := by
    calc _ = ∑ i : Fin 3, ∑ l : Fin 3, γ i * (∑ j : Fin 3, (G (F x))⁻¹ i j * G (F x) j l) *
          gsCovHess G F a c x l := by
          refine Finset.sum_congr rfl (fun i _ => ?_)
          simp only [Finset.mul_sum, Finset.sum_mul, Fin.sum_univ_three]
          ring
      _ = _ := by
          simp only [hent, mul_ite, mul_one, mul_zero, ite_mul, zero_mul, Finset.sum_ite_eq,
            Finset.mem_univ, if_true]
  have e := hsplit γ (fun j => ∑ l : Fin 3, G (F x) j l * gsCovHess G F a c x l)
  beta_reduce at e
  rw [hαγ, zero_mul, zero_div, add_zero, hlhs] at e
  simp only [htan] at e
  rw [e]
  simp only [hchr, Finset.sum_mul]
  exact Finset.sum_congr rfl (fun m _ => Finset.sum_congr rfl (fun l _ => by ring))

theorem edge_trace_linalg (A : Matrix (Fin 3) (Fin 3) ℝ) (hAinv : ∀ i j : Fin 3, A⁻¹ i j = A⁻¹ j i) (hm : Matrix (Fin 2) (Fin 2) ℝ) (T : Fin 2 → Fin 3 → ℝ) (α γ : Fin 3 → ℝ) (H : Fin 3 → Fin 3 → ℝ) (hsplit : ∀ p q : Fin 3 → ℝ, ∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * p i * q j = ∑ a : Fin 2, ∑ c : Fin 2, hm⁻¹ a c * (∑ k : Fin 3, p k * T a k) * (∑ k : Fin 3, q k * T c k) + (∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * α i * p j) * (∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * α i * q j) / (∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * α i * α j)) (hαγ : ∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * α i * γ j = 0) : (∑ a : Fin 2, ∑ c : Fin 2, hm⁻¹ a c * (∑ k : Fin 3, γ k * T a k) * (∑ k : Fin 3, γ k * T c k) = ∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * γ i * γ j) ∧ (∑ a : Fin 2, ∑ c : Fin 2, hm⁻¹ a c * (∑ k : Fin 3, ∑ l : Fin 3, T a k * T c l * H k l) - (∑ a : Fin 2, ∑ c : Fin 2, (∑ d : Fin 2, hm⁻¹ a d * ∑ k : Fin 3, γ k * T d k) * (∑ d : Fin 2, hm⁻¹ c d * ∑ k : Fin 3, γ k * T d k) * (∑ k : Fin 3, ∑ l : Fin 3, T a k * T c l * H k l)) / (∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * γ i * γ j) = ∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * H i j - (∑ i : Fin 3, ∑ j : Fin 3, (∑ m : Fin 3, A⁻¹ i m * γ m) * (∑ m : Fin 3, A⁻¹ j m * γ m) * H i j) / (∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * γ i * γ j) - (∑ i : Fin 3, ∑ j : Fin 3, (∑ m : Fin 3, A⁻¹ i m * α m) * (∑ m : Fin 3, A⁻¹ j m * α m) * H i j) / (∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * α i * α j)) :=
by
  have s1 : ∑ a : Fin 2, ∑ c : Fin 2, hm⁻¹ a c * (∑ k : Fin 3, γ k * T a k) *
      (∑ k : Fin 3, γ k * T c k) = ∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * γ i * γ j := by
    have h := hsplit γ γ
    rw [hαγ, zero_mul, zero_div, add_zero] at h
    exact h.symm
  have s2 : ∀ k : Fin 3, ∑ m : Fin 3, A⁻¹ k m * γ m =
      ∑ a : Fin 2, (∑ d : Fin 2, hm⁻¹ a d * ∑ l : Fin 3, γ l * T d l) * T a k := by
    intro k
    have h := hsplit (Pi.single k 1) γ
    rw [hαγ, mul_zero, zero_div, add_zero] at h
    simp only [Pi.single_apply, mul_ite, ite_mul, mul_one, mul_zero, zero_mul, one_mul,
      Finset.sum_ite_irrel, Finset.sum_const_zero, Finset.sum_ite_eq', Finset.sum_ite_eq,
      Finset.mem_univ, if_true] at h
    rw [h]
    simp only [Finset.sum_mul]
    refine Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun c _ => ?_))
    ring
  have s3 : ∀ i j : Fin 3, A⁻¹ i j = ∑ a : Fin 2, ∑ c : Fin 2, hm⁻¹ a c * T a i * T c j +
      (∑ m : Fin 3, A⁻¹ m i * α m) * (∑ m : Fin 3, A⁻¹ m j * α m) /
        (∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * α i * α j) := by
    intro i j
    have h := hsplit (Pi.single i 1) (Pi.single j 1)
    simp only [Pi.single_apply, mul_ite, ite_mul, mul_one, mul_zero, zero_mul, one_mul,
      Finset.sum_ite_irrel, Finset.sum_const_zero, Finset.sum_ite_eq', Finset.sum_ite_eq,
      Finset.mem_univ, if_true] at h
    rw [h]
  have hw : ∀ i : Fin 3, ∑ m : Fin 3, A⁻¹ i m * α m = ∑ m : Fin 3, A⁻¹ m i * α m := by
    intro i
    exact Finset.sum_congr rfl (fun m _ => by rw [hAinv i m])
  have s4 : ∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * H i j -
      (∑ i : Fin 3, ∑ j : Fin 3, (∑ m : Fin 3, A⁻¹ i m * α m) * (∑ m : Fin 3, A⁻¹ j m * α m) *
        H i j) / (∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * α i * α j) =
      ∑ a : Fin 2, ∑ c : Fin 2, hm⁻¹ a c * (∑ k : Fin 3, ∑ l : Fin 3, T a k * T c l * H k l) := by
    simp only [hw]
    have e : ∀ i j : Fin 3, A⁻¹ i j * H i j =
        (∑ a : Fin 2, ∑ c : Fin 2, hm⁻¹ a c * T a i * T c j) * H i j +
        (∑ m : Fin 3, A⁻¹ m i * α m) * (∑ m : Fin 3, A⁻¹ m j * α m) * H i j /
          (∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * α i * α j) := by
      intro i j
      rw [s3 i j]
      ring
    simp only [e]
    simp only [Fin.sum_univ_three, Fin.sum_univ_two]
    ring
  have s5 : ∑ a : Fin 2, ∑ c : Fin 2, (∑ d : Fin 2, hm⁻¹ a d * ∑ k : Fin 3, γ k * T d k) *
      (∑ d : Fin 2, hm⁻¹ c d * ∑ k : Fin 3, γ k * T d k) *
      (∑ k : Fin 3, ∑ l : Fin 3, T a k * T c l * H k l) =
      ∑ i : Fin 3, ∑ j : Fin 3, (∑ m : Fin 3, A⁻¹ i m * γ m) * (∑ m : Fin 3, A⁻¹ j m * γ m) *
        H i j := by
    simp only [s2]
    simp only [Fin.sum_univ_three, Fin.sum_univ_two]
    ring
  refine ⟨s1, ?_⟩
  rw [s5]
  linarith [s4]

theorem edge_dual_split (A : Matrix (Fin 3) (Fin 3) ℝ) (hAs : ∀ i j : Fin 3, A i j = A j i) (hA : A.PosDef) (T : Fin 2 → Fin 3 → ℝ) (hT : ∀ c : Fin 2 → ℝ, (∀ k : Fin 3, ∑ a : Fin 2, c a * T a k = 0) → c = 0) (α : Fin 3 → ℝ) (hαT : ∀ a : Fin 2, ∑ k : Fin 3, α k * T a k = 0) (hα : α ≠ 0) : ∀ p q : Fin 3 → ℝ, ∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * p i * q j = ∑ a : Fin 2, ∑ c : Fin 2, (Matrix.of fun a' c' : Fin 2 => ∑ k : Fin 3, ∑ l : Fin 3, T a' k * A k l * T c' l)⁻¹ a c * (∑ k : Fin 3, p k * T a k) * (∑ k : Fin 3, q k * T c k) + (∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * α i * p j) * (∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * α i * q j) / (∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * α i * α j) :=
by
  classical
  intro p q
  
  have hAu : IsUnit A.det := (Matrix.isUnit_iff_isUnit_det A).mp hA.isUnit
  have hAB : A * A⁻¹ = 1 := Matrix.mul_nonsing_inv A hAu
  have hBA : A⁻¹ * A = 1 := Matrix.nonsing_inv_mul A hAu
  have hAT : Matrix.transpose A = A := by
    ext i j
    exact hAs j i
  have hBT : Matrix.transpose (A⁻¹) = A⁻¹ := by rw [Matrix.transpose_nonsing_inv, hAT]
  have hBs : ∀ i j : Fin 3, A⁻¹ i j = A⁻¹ j i := fun i j => congrFun (congrFun hBT j) i
  
  have hκpos : 0 < ∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * α i * α j := by
    have h := hA.inv.dotProduct_mulVec_pos hα
    convert h using 1
    simp only [star_trivial, dotProduct, Matrix.mulVec, Fin.sum_univ_three]
    ring
  
  generalize hH : (Matrix.of fun a' c' : Fin 2 => ∑ k : Fin 3, ∑ l : Fin 3, T a' k * A k l * T c' l) = H
  have hHe : ∀ a c : Fin 2, H a c = ∑ k : Fin 3, ∑ l : Fin 3, T a k * A k l * T c l := by
    intro a c
    rw [← hH]
    rfl
  have hHdet : H.det ≠ 0 := by
    intro h0
    obtain ⟨c, hc0, hc⟩ := Matrix.exists_mulVec_eq_zero_iff.mpr h0
    have hc' : ∀ a : Fin 2, ∑ b : Fin 2, H a b * c b = 0 := fun a => congrFun hc a
    by_cases hv0 : (fun k : Fin 3 => ∑ a : Fin 2, c a * T a k) = 0
    · exact hc0 (hT c (fun k => congrFun hv0 k))
    · have hpos := hA.dotProduct_mulVec_pos hv0
      have hlt : (0 : ℝ) < c 0 * (∑ b : Fin 2, H 0 b * c b) + c 1 * (∑ b : Fin 2, H 1 b * c b) := by
        convert hpos using 1
        simp only [hHe, star_trivial, dotProduct, Matrix.mulVec, Fin.sum_univ_two,
          Fin.sum_univ_three]
        ring
      rw [hc' 0, hc' 1] at hlt
      simp at hlt
  have hHM : H * H⁻¹ = 1 := Matrix.mul_nonsing_inv H (isUnit_iff_ne_zero.mpr hHdet)
  have hHMe : ∀ b c : Fin 2, ∑ a : Fin 2, H b a * H⁻¹ a c = (1 : Matrix (Fin 2) (Fin 2) ℝ) b c := by
    intro b c
    rw [← Matrix.mul_apply, hHM]
  
  obtain ⟨ν, hν⟩ : ∃ ν : Fin 3 → ℝ, ∀ j, ν j = ∑ i : Fin 3, A⁻¹ i j * α i :=
    ⟨fun j => ∑ i : Fin 3, A⁻¹ i j * α i, fun j => rfl⟩
  have hνv : ν = A⁻¹.mulVec α := by
    funext j
    rw [hν j]
    simp only [Matrix.mulVec, dotProduct, Fin.sum_univ_three]
    rw [hBs 0 j, hBs 1 j, hBs 2 j]
  have hAν : ∀ k : Fin 3, ∑ l : Fin 3, A k l * ν l = α k := by
    intro k
    have h1 : A.mulVec (A⁻¹.mulVec α) = α := by
      rw [Matrix.mulVec_mulVec, hAB, Matrix.one_mulVec]
    rw [hνv]
    exact congrFun h1 k
  have hAν' : ∀ l : Fin 3, ∑ k : Fin 3, A k l * ν k = α l := by
    intro l
    rw [← hAν l]
    exact Finset.sum_congr rfl (fun k _ => by rw [hAs k l])
  have hxν : ∀ x : Fin 3 → ℝ, ∑ i : Fin 3, ∑ j : Fin 3, A⁻¹ i j * α i * x j = ∑ j : Fin 3, ν j * x j := by
    intro x
    simp only [hν, Fin.sum_univ_three]
    ring
  have hκν0 : ∑ k : Fin 3, ν k * α k ≠ 0 := by
    rw [← hxν α]
    exact ne_of_gt hκpos
  
  have hind : ∀ d : Fin 3 → ℝ, (∀ a : Fin 2, ∑ k : Fin 3, d k * T a k = 0) →
      ∑ k : Fin 3, d k * ν k = 0 → d = 0 := by
    intro d hdT hdν
    have hN : (Matrix.of ![T 0, T 1, ν]).det ≠ 0 := by
      intro h0
      obtain ⟨c, hc0, hc⟩ := Matrix.exists_vecMul_eq_zero_iff.mpr h0
      have hk : ∀ k : Fin 3, c 0 * T 0 k + c 1 * T 1 k + c 2 * ν k = 0 := by
        intro k
        have := congrFun hc k
        simpa [Matrix.vecMul, dotProduct, Fin.sum_univ_three] using this
      have h2 : c 2 = 0 := by
        have hαT0 := hαT 0
        have hαT1 := hαT 1
        have hk0 := hk 0
        have hk1 := hk 1
        have hk2 := hk 2
        have hκ := hκν0
        simp only [Fin.sum_univ_three] at hαT0 hαT1 hκ
        have : c 2 * (ν 0 * α 0 + ν 1 * α 1 + ν 2 * α 2) = 0 := by
          linear_combination α 0 * hk0 + α 1 * hk1 + α 2 * hk2 - c 0 * hαT0 - c 1 * hαT1
        exact (mul_eq_zero.mp this).resolve_right hκ
      have h01 : ![c 0, c 1] = 0 := hT _ (by
        intro k
        have := hk k
        rw [h2, zero_mul, add_zero] at this
        simpa [Fin.sum_univ_two] using this)
      apply hc0
      funext i
      fin_cases i
      · simpa using congrFun h01 0
      · simpa using congrFun h01 1
      · simpa using h2
    by_contra hd
    apply hN
    apply Matrix.exists_mulVec_eq_zero_iff.mp
    refine ⟨d, hd, ?_⟩
    have h0 := hdT 0
    have h1 := hdT 1
    have h2 := hdν
    simp only [Fin.sum_univ_three] at h0 h1 h2
    funext i
    fin_cases i
    · simp [Matrix.mulVec, dotProduct, Fin.sum_univ_three]
      linear_combination h0
    · simp [Matrix.mulVec, dotProduct, Fin.sum_univ_three]
      linear_combination h1
    · simp [Matrix.mulVec, dotProduct, Fin.sum_univ_three]
      linear_combination h2
  
  rw [hxν p, hxν q, hxν α]
  obtain ⟨w, hw⟩ : ∃ w : ℝ, w = ∑ j : Fin 3, ν j * q j := ⟨_, rfl⟩
  obtain ⟨κ, hk⟩ : ∃ κ : ℝ, κ = ∑ j : Fin 3, ν j * α j := ⟨_, rfl⟩
  rw [← hw, ← hk]
  have hκ0 : κ ≠ 0 := by
    rw [hk]
    exact hκν0
  have hwk : w / κ * κ = w := div_mul_cancel₀ w hκ0
  obtain ⟨P, hP⟩ : ∃ P : Fin 3 → ℝ, ∀ i, P i = ∑ a : Fin 2, ∑ c : Fin 2,
      H⁻¹ a c * (∑ k : Fin 3, q k * T c k) * T a i + w / κ * ν i := ⟨_, fun i => rfl⟩
  have hP0 := hP 0
  have hP1 := hP 1
  have hP2 := hP 2
  simp only [Fin.sum_univ_two, Fin.sum_univ_three] at hP0 hP1 hP2 hw hk
  
  have hAP : A.mulVec P = q := by
    have hd := hind (A.mulVec P - q) ?_ ?_
    · exact sub_eq_zero.mp hd
    · intro b
      have h0 := hHMe b 0
      have h1 := hHMe b 1
      have hA0 := hAν 0
      have hA1 := hAν 1
      have hA2 := hAν 2
      have hαb := hαT b
      simp only [hHe, Fin.sum_univ_two, Fin.sum_univ_three] at h0 h1 hA0 hA1 hA2 hαb
      have hs : (q 0 * T 0 0 + q 1 * T 0 1 + q 2 * T 0 2) * (1 : Matrix (Fin 2) (Fin 2) ℝ) b 0 +
          (q 0 * T 1 0 + q 1 * T 1 1 + q 2 * T 1 2) * (1 : Matrix (Fin 2) (Fin 2) ℝ) b 1 =
          q 0 * T b 0 + q 1 * T b 1 + q 2 * T b 2 := by
        fin_cases b <;> simp [Matrix.one_apply]
      simp only [Pi.sub_apply, Matrix.mulVec, dotProduct, Fin.sum_univ_three]
      linear_combination (T b 0 * A 0 0 + T b 1 * A 1 0 + T b 2 * A 2 0) * hP0 +
        (T b 0 * A 0 1 + T b 1 * A 1 1 + T b 2 * A 2 1) * hP1 +
        (T b 0 * A 0 2 + T b 1 * A 1 2 + T b 2 * A 2 2) * hP2 +
        (q 0 * T 0 0 + q 1 * T 0 1 + q 2 * T 0 2) * h0 +
        (q 0 * T 1 0 + q 1 * T 1 1 + q 2 * T 1 2) * h1 +
        w / κ * (T b 0 * hA0 + T b 1 * hA1 + T b 2 * hA2) + w / κ * hαb + hs
    · have hB0 := hAν' 0
      have hB1 := hAν' 1
      have hB2 := hAν' 2
      have hα0 := hαT 0
      have hα1 := hαT 1
      simp only [Fin.sum_univ_three] at hB0 hB1 hB2 hα0 hα1
      simp only [Pi.sub_apply, Matrix.mulVec, dotProduct, Fin.sum_univ_three]
      linear_combination P 0 * hB0 + P 1 * hB1 + P 2 * hB2 + α 0 * hP0 + α 1 * hP1 + α 2 * hP2 +
        (H⁻¹ 0 0 * (q 0 * T 0 0 + q 1 * T 0 1 + q 2 * T 0 2) +
          H⁻¹ 0 1 * (q 0 * T 1 0 + q 1 * T 1 1 + q 2 * T 1 2)) * hα0 +
        (H⁻¹ 1 0 * (q 0 * T 0 0 + q 1 * T 0 1 + q 2 * T 0 2) +
          H⁻¹ 1 1 * (q 0 * T 1 0 + q 1 * T 1 1 + q 2 * T 1 2)) * hα1 -
        w / κ * hk + hwk + hw
  
  have hBq' : A⁻¹.mulVec q = P := by
    rw [← hAP, Matrix.mulVec_mulVec, hBA, Matrix.one_mulVec]
  have hBq : ∀ i, ∑ j : Fin 3, A⁻¹ i j * q j = P i := fun i => congrFun hBq' i
  have hq0 := hBq 0
  have hq1 := hBq 1
  have hq2 := hBq 2
  simp only [Fin.sum_univ_three] at hq0 hq1 hq2
  simp only [Fin.sum_univ_two, Fin.sum_univ_three]
  linear_combination p 0 * hq0 + p 1 * hq1 + p 2 * hq2 + p 0 * hP0 + p 1 * hP1 + p 2 * hP2

theorem stern_edge_curvature_pointwise [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (β u : M → ℝ) (hβ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ β)
    (hβr : ∀ p : M, β p = 0 → mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) β p ≠ 0)
    (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u)
    (hneu : ∀ p : M, β p = 0 → g.gradInner u β p = 0)
    (hmin : ∀ p : M, β p = 0 → g.levelMeanCurv β p = 0)
    (z : M) (W : Set E2) (F : E2 → E3) (hW : IsOpen W) (hF : ContDiffOn ℝ ∞ F W)
    (hFt : ∀ x ∈ W, F x ∈ (chartAt E3 z).target)
    (hinj : ∀ x ∈ W, Function.Injective (fderiv ℝ F x))
    (c : ℝ) (hlev : ∀ x ∈ W, u ((chartAt E3 z).symm (F x)) = c)
    (hreg : ∀ x ∈ W, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u ((chartAt E3 z).symm (F x)) ≠ 0)
    (x : E2) (hx : x ∈ W) (hβx : β ((chartAt E3 z).symm (F x)) = 0) :
    g.gradInner β (fun y => Real.sqrt (g.gradInner u u y)) ((chartAt E3 z).symm (F x)) /
        Real.sqrt (g.gradInner u u ((chartAt E3 z).symm (F x))) =
      -(Real.sqrt (sgbGradSq2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F)
            (fun y => β ((chartAt E3 z).symm (F y))) x) *
        sgbLevelCurv2 (pullMetric2 (g.coeff (chartAt E3 z).symm) F)
            (fun y => β ((chartAt E3 z).symm (F y))) x) :=
by
  have hΩo : IsOpen (chartAt E3 z).target := (chartAt E3 z).open_target
  have hy0 : F x ∈ (chartAt E3 z).target := hFt x hx
  obtain ⟨hfs, hfgrad, -⟩ := chart_pullback_gradInner g u hu z
  obtain ⟨hbs, -, -⟩ := chart_pullback_gradInner g β hβ z
  have hSf0 := chart_Nsq_pos g u hu z (F x) hy0 (hreg x hx)
  have hSb0 := chart_Nsq_pos g β hβ z (F x) hy0 (hβr _ hβx)
  set G : E3 → Matrix (Fin 3) (Fin 3) ℝ := g.coeff (chartAt E3 z).symm with hGdef
  set f : E3 → ℝ := fun y => u ((chartAt E3 z).symm y) with hfdef
  set b : E3 → ℝ := fun y => β ((chartAt E3 z).symm y) with hbdef
  have hGs : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) (chartAt E3 z).target :=
    fun i j => g.smooth z i j
  have hGsym : ∀ (y : E3) (i j : Fin 3), G y i j = G y j i := fun y i j => g.symm _ _ _
  have hGpd : ∀ y ∈ (chartAt E3 z).target, (G y).PosDef :=
    fun y hy => coeff_chart_symm_posDef g z y hy
  have hfd : ∀ y ∈ (chartAt E3 z).target, DifferentiableAt ℝ f y := fun y hy =>
    (hfs.contDiffAt (hΩo.mem_nhds hy)).differentiableAt (by simp)
  have hbd : ∀ y ∈ (chartAt E3 z).target, DifferentiableAt ℝ b y := fun y hy =>
    (hbs.contDiffAt (hΩo.mem_nhds hy)).differentiableAt (by simp)
  have hSf : 0 < gradSqLoc G f (F x) := hSf0
  have hSb : 0 < gradSqLoc G b (F x) := hSb0
  
  have hneuV : ∀ y ∈ (chartAt E3 z).target, b y = 0 → gradInnerLoc G f b y = 0 := by
    intro y hy hby
    have h1 : g.gradInner u β ((chartAt E3 z).symm y) = gradInnerLoc G f b y :=
      edge_gradInner_chart g u β z y hy (hfd y hy) (hbd y hy)
    rw [← h1]
    exact hneu _ hby
  have hαγ : gradInnerLoc G f b (F x) = 0 := hneuV (F x) hy0 hβx
  
  have hlmc : levelMeanCurvCoord G b (F x) = 0 :=
    (edge_lmc_chart g β hβ z (F x) hy0).symm.trans (hmin _ hβx)
  have hQ4 : (∑ i : Fin 3, ∑ j : Fin 3, ∑ a : Fin 3, ∑ b' : Fin 3,
      (G (F x))⁻¹ i a * partialDeriv a b (F x) * ((G (F x))⁻¹ j b' * partialDeriv b' b (F x)) *
        hessLoc G b i j (F x)) = hessGGLoc G b b (F x) := by
    simp only [hessGGLoc, gradUpLoc, Fin.sum_univ_three]
    ring
  have h1 : lapLoc G b (F x) / Real.sqrt (gradSqLoc G b (F x)) -
      hessGGLoc G b b (F x) / Real.sqrt (gradSqLoc G b (F x)) ^ 3 = 0 := by
    rw [← hQ4]
    exact hlmc
  have hr : 0 < Real.sqrt (gradSqLoc G b (F x)) := Real.sqrt_pos.2 hSb
  have hr2 : Real.sqrt (gradSqLoc G b (F x)) ^ 2 = gradSqLoc G b (F x) := Real.sq_sqrt hSb.le
  have hA4 : lapLoc G b (F x) = hessGGLoc G b b (F x) / gradSqLoc G b (F x) := by
    rw [sub_eq_zero, div_eq_div_iff hr.ne' (pow_ne_zero 3 hr.ne')] at h1
    rw [eq_div_iff hSb.ne']
    have h3 : (lapLoc G b (F x) * Real.sqrt (gradSqLoc G b (F x)) ^ 2 - hessGGLoc G b b (F x)) *
        Real.sqrt (gradSqLoc G b (F x)) = 0 := by linear_combination h1
    rcases mul_eq_zero.1 h3 with h | h
    · rw [hr2] at h; linarith
    · exact absurd h hr.ne'
  
  have h5 := edge_sqrt_neumann G (chartAt E3 z).target hΩo hGs hGsym hGpd f b hfs hbs hneuV (F x)
    hy0 hβx hSb hSf
  have hev : (fun y' => Real.sqrt (g.gradInner u u ((chartAt E3 z).symm y'))) =ᶠ[𝓝 (F x)]
      (fun y' => Real.sqrt (gradSqLoc G f y')) := by
    filter_upwards [hΩo.mem_nhds hy0] with y hy
    exact congrArg Real.sqrt (hfgrad y hy)
  have hW'd : DifferentiableAt ℝ
      (fun y' => Real.sqrt (g.gradInner u u ((chartAt E3 z).symm y'))) (F x) :=
    h5.1.congr_of_eventuallyEq hev
  have hs1 : g.gradInner β (fun y => Real.sqrt (g.gradInner u u y)) ((chartAt E3 z).symm (F x)) =
      gradInnerLoc G b (fun y' => Real.sqrt (g.gradInner u u ((chartAt E3 z).symm y'))) (F x) :=
    edge_gradInner_chart g β (fun y => Real.sqrt (g.gradInner u u y)) z (F x) hy0 (hbd _ hy0) hW'd
  have hgieq : gradInnerLoc G b (fun y' => Real.sqrt (g.gradInner u u ((chartAt E3 z).symm y')))
      (F x) = gradInnerLoc G b (fun y' => Real.sqrt (gradSqLoc G f y')) (F x) := by
    unfold gradInnerLoc partialDeriv
    rw [hev.fderiv_eq]
  have hden : g.gradInner u u ((chartAt E3 z).symm (F x)) = gradSqLoc G f (F x) := hfgrad _ hy0
  have hL : g.gradInner β (fun y => Real.sqrt (g.gradInner u u y)) ((chartAt E3 z).symm (F x)) /
      Real.sqrt (g.gradInner u u ((chartAt E3 z).symm (F x))) =
      -(hessGGLoc G b f (F x) / gradSqLoc G f (F x)) := by
    rw [hs1, hgieq, hden]
    exact h5.2
  
  have hT : ∀ cc : Fin 2 → ℝ, (∀ k : Fin 3, ∑ a : Fin 2, cc a * gsTan F a x k = 0) → cc = 0 := by
    intro cc hc
    have hv : fderiv ℝ F x (∑ a : Fin 2, cc a • e2 a) = 0 := by
      ext k
      have h1 := hc k
      simp only [Fin.sum_univ_two, gsTan] at h1
      simpa [Fin.sum_univ_two] using h1
    have hv0 : (∑ a : Fin 2, cc a • e2 a) = 0 := hinj x hx (by rw [hv, map_zero])
    funext a
    have h2 := congrArg (fun v : E2 => v a) hv0
    fin_cases a <;> simpa [Fin.sum_univ_two, e2, EuclideanSpace.single_apply] using h2
  have hconst : (fun y => u ((chartAt E3 z).symm (F y))) =ᶠ[𝓝 x] (fun _ => c) :=
    Filter.eventually_of_mem (hW.mem_nhds hx) (fun y hy => hlev y hy)
  have h6f := edge_hess2_chain G (chartAt E3 z).target hΩo f hfs F W hW hF hFt x hx
  have hαT : ∀ a : Fin 2, ∑ k : Fin 3, partialDeriv k f (F x) * gsTan F a x k = 0 := by
    intro a
    have e : pd2 a (fun y => u ((chartAt E3 z).symm (F y))) x =
        ∑ k : Fin 3, partialDeriv k f (F x) * gsTan F a x k := h6f.1 x hx a
    rw [← e]
    unfold pd2
    rw [hconst.fderiv_eq]
    simp
  have hα : (fun k : Fin 3 => partialDeriv k f (F x)) ≠ 0 := by
    intro h0
    have h' : ∀ k : Fin 3, partialDeriv k f (F x) = 0 := fun k => congrFun h0 k
    have : gradSqLoc G f (F x) = 0 := by
      simp only [gradSqLoc, gradInnerLoc, h', mul_zero, Finset.sum_const_zero]
    linarith
  have hsplit : ∀ p q : Fin 3 → ℝ, ∑ i : Fin 3, ∑ j : Fin 3, (G (F x))⁻¹ i j * p i * q j =
      ∑ a₁ : Fin 2, ∑ c₁ : Fin 2, (pullMetric2 G F x)⁻¹ a₁ c₁ *
          (∑ k : Fin 3, p k * gsTan F a₁ x k) * (∑ k : Fin 3, q k * gsTan F c₁ x k) +
        (∑ i : Fin 3, ∑ j : Fin 3, (G (F x))⁻¹ i j * partialDeriv i f (F x) * p j) *
          (∑ i : Fin 3, ∑ j : Fin 3, (G (F x))⁻¹ i j * partialDeriv i f (F x) * q j) /
          (∑ i : Fin 3, ∑ j : Fin 3,
            (G (F x))⁻¹ i j * partialDeriv i f (F x) * partialDeriv j f (F x)) :=
    edge_dual_split (G (F x)) (hGsym (F x)) (hGpd (F x) hy0) (fun a k => gsTan F a x k) hT
      (fun k => partialDeriv k f (F x)) hαT hα
  
  have hdet : (G (F x)).det ≠ 0 := (hGpd _ hy0).det_pos.ne'
  have hK := gge_koszul_tangent G (chartAt E3 z).target hΩo hGs hGsym hGpd F W hW hF hFt x hx
  have h6b := edge_hess2_chain G (chartAt E3 z).target hΩo b hbs F W hW hF hFt x hx
  have e1 : ∀ m : Fin 2, pd2 m (fun y => β ((chartAt E3 z).symm (F y))) x =
      ∑ k : Fin 3, partialDeriv k b (F x) * gsTan F m x k := fun m => h6b.1 x hx m
  have hD : ∀ a c' : Fin 2, gsCovD1 (pullMetric2 G F)
      (fun j y => pd2 j (fun y' => β ((chartAt E3 z).symm (F y'))) y) a c' x =
      ∑ k : Fin 3, ∑ l : Fin 3, gsTan F a x k * gsTan F c' x l * hessLoc G b k l (F x) := by
    intro a c'
    have e2' : pd2 a (fun x' => pd2 c' (fun y => β ((chartAt E3 z).symm (F y))) x') x =
        ∑ k : Fin 3, ∑ l : Fin 3, gsTan F a x k * gsTan F c' x l * hessLoc G b k l (F x) +
          ∑ k : Fin 3, partialDeriv k b (F x) * gsCovHess G F a c' x k := h6b.2 a c'
    have e7 : ∑ k : Fin 3, partialDeriv k b (F x) * gsCovHess G F a c' x k =
        ∑ m : Fin 2, christoffel2 (pullMetric2 G F) m a c' x *
          ∑ k : Fin 3, partialDeriv k b (F x) * gsTan F m x k :=
      edge_tangential_proj G F x hdet (fun k => partialDeriv k f (F x))
        (fun k => partialDeriv k b (F x)) a c' (fun m => hK m a c') hsplit hαγ
    show pd2 a (fun x' => pd2 c' (fun y => β ((chartAt E3 z).symm (F y))) x') x -
      ∑ m : Fin 2, christoffel2 (pullMetric2 G F) m a c' x *
        pd2 m (fun y => β ((chartAt E3 z).symm (F y))) x = _
    rw [e2', e7]
    simp only [e1]
    ring
  
  have hreg2 := gs_regularity G (chartAt E3 z).target hΩo hGs hGsym hGpd F W hW hF hFt hinj
  have hw : ContDiffOn ℝ ∞ (fun y => β ((chartAt E3 z).symm (F y))) W :=
    hbs.comp hF (fun y hy => hFt y hy)
  have hAinv : ∀ i j : Fin 3, (G (F x))⁻¹ i j = (G (F x))⁻¹ j i := by
    intro i j
    have hT' : Matrix.transpose (G (F x)) = G (F x) := by
      ext i' j'
      exact hGsym _ j' i'
    rw [← Matrix.transpose_apply ((G (F x))⁻¹) i j, Matrix.transpose_nonsing_inv, hT']
  have h8 := edge_trace_linalg (G (F x)) hAinv (pullMetric2 G F x) (fun a k => gsTan F a x k)
    (fun k => partialDeriv k f (F x)) (fun k => partialDeriv k b (F x))
    (fun k l => hessLoc G b k l (F x)) hsplit hαγ
  have h8a : ∑ a : Fin 2, ∑ c' : Fin 2, (pullMetric2 G F x)⁻¹ a c' *
      (∑ k : Fin 3, partialDeriv k b (F x) * gsTan F a x k) *
      (∑ k : Fin 3, partialDeriv k b (F x) * gsTan F c' x k) = gradSqLoc G b (F x) := h8.1
  have h8b : ∑ a : Fin 2, ∑ c' : Fin 2, (pullMetric2 G F x)⁻¹ a c' *
        (∑ k : Fin 3, ∑ l : Fin 3, gsTan F a x k * gsTan F c' x l * hessLoc G b k l (F x)) -
      (∑ a : Fin 2, ∑ c' : Fin 2,
        (∑ d : Fin 2, (pullMetric2 G F x)⁻¹ a d *
          ∑ k : Fin 3, partialDeriv k b (F x) * gsTan F d x k) *
        (∑ d : Fin 2, (pullMetric2 G F x)⁻¹ c' d *
          ∑ k : Fin 3, partialDeriv k b (F x) * gsTan F d x k) *
        (∑ k : Fin 3, ∑ l : Fin 3, gsTan F a x k * gsTan F c' x l * hessLoc G b k l (F x))) /
        gradSqLoc G b (F x) =
      lapLoc G b (F x) - hessGGLoc G b b (F x) / gradSqLoc G b (F x) -
        hessGGLoc G b f (F x) / gradSqLoc G f (F x) := h8.2
  have hgs2 : sgbGradSq2 (pullMetric2 G F) (fun y => β ((chartAt E3 z).symm (F y))) x =
      gradSqLoc G b (F x) := by
    unfold sgbGradSq2
    simp only [e1]
    exact h8a
  have hQ : 0 < sgbGradSq2 (pullMetric2 G F) (fun y => β ((chartAt E3 z).symm (F y))) x := by
    rw [hgs2]; exact hSb
  have h3 := edge_curv2_formula (pullMetric2 G F) W hW hreg2.1 hreg2.2.1 hreg2.2.2.1
    (fun y => β ((chartAt E3 z).symm (F y))) hw x hx hQ
  have hcancel : Real.sqrt (gradSqLoc G b (F x)) *
      (hessGGLoc G b f (F x) / gradSqLoc G f (F x) / Real.sqrt (gradSqLoc G b (F x))) =
      hessGGLoc G b f (F x) / gradSqLoc G f (F x) := by
    rw [mul_comm]; exact div_mul_cancel₀ _ hr.ne'
  rw [hL, h3, hgs2]
  simp only [hD]
  simp only [e1]
  rw [h8b, hA4, sub_self, zero_sub, neg_div, neg_neg, hcancel]

theorem side_metric_props (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (R t : ℝ)
    (hG : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => G y a b) {y : E3 | R < ‖y‖})
    (hsymm : ∀ (y : E3) (a b : Fin 3), G y a b = G y b a)
    (hpd : ∀ y : E3, R < ‖y‖ → (G y).PosDef) :
    IsOpen {y : E2 | R < ‖cylPt t (y 0) (y 1)‖} ∧
    (∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun y => sgbSideMetric G t y a b)
      {y : E2 | R < ‖cylPt t (y 0) (y 1)‖}) ∧
    (∀ (y : E2) (a b : Fin 2), sgbSideMetric G t y a b = sgbSideMetric G t y b a) ∧
    (∀ y ∈ {y : E2 | R < ‖cylPt t (y 0) (y 1)‖}, (sgbSideMetric G t y).PosDef) ∧
    (∀ y ∈ {y : E2 | R < ‖cylPt t (y 0) (y 1)‖}, ∀ c a b : Fin 2,
      pd2 c (fun z => sgbSideMetric G t z a b) y =
        partialDeriv c.succ (fun z => G z a.succ b.succ) (cylPt t (y 0) (y 1))) :=
by
  have hV : IsOpen {y : E3 | R < ‖y‖} := isOpen_lt continuous_const continuous_norm
  let Λ : E2 →L[ℝ] E3 := (EuclideanSpace.proj (0 : Fin 2) : E2 →L[ℝ] ℝ).smulRight (e 1) +
    (EuclideanSpace.proj (1 : Fin 2) : E2 →L[ℝ] ℝ).smulRight (e 2)
  have hΛ : ∀ v : E2, Λ v = v 0 • e 1 + v 1 • e 2 := fun v => rfl
  have hιeq : (fun y : E2 => cylPt t (y 0) (y 1)) = fun y => t • e 0 + Λ y := by
    funext y
    rw [hΛ, cylPt, add_assoc]
  have hιd : ∀ y : E2, HasFDerivAt (fun y : E2 => cylPt t (y 0) (y 1)) Λ y := by
    intro y
    rw [hιeq]
    exact Λ.hasFDerivAt.const_add _
  have hιs : ContDiff ℝ ∞ (fun y : E2 => cylPt t (y 0) (y 1)) := by
    rw [hιeq]
    exact contDiff_const.add Λ.contDiff
  have hΛe : ∀ c : Fin 2, Λ (e2 c) = e c.succ := by
    intro c
    rw [hΛ]
    fin_cases c <;> ext k <;> fin_cases k <;> simp [e, e2, EuclideanSpace.single_apply]
  refine ⟨hV.preimage hιs.continuous, ?_, ?_, ?_, ?_⟩
  · intro a b
    have h := (hG a.succ b.succ).comp hιs.contDiffOn (fun y hy => hy)
    exact h
  · intro y a b
    exact hsymm _ _ _
  · intro y hy
    have hP := hpd _ hy
    apply Matrix.PosDef.of_dotProduct_mulVec_pos
    · apply Matrix.IsHermitian.ext
      intro i j
      simp only [star_trivial]
      exact hsymm _ _ _
    · intro w hw0
      set v : Fin 3 → ℝ := ![0, w 0, w 1] with hvdef
      have hv0 : v ≠ 0 := by
        intro h0
        apply hw0
        have h1 := congrFun h0 1
        have h2 := congrFun h0 2
        simp [v] at h1 h2
        funext k
        fin_cases k
        · simpa using h1
        · simpa using h2
      have hpos := hP.dotProduct_mulVec_pos hv0
      have key : star w ⬝ᵥ (sgbSideMetric G t y).mulVec w =
          star v ⬝ᵥ (G (cylPt t (y 0) (y 1))).mulVec v := by
        simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_two, Fin.sum_univ_three, Pi.star_apply,
          star_trivial, hvdef, sgbSideMetric, Fin.succ_zero_eq_one, Fin.succ_one_eq_two,
          Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.cons_val_two, Matrix.head_cons,
          Matrix.tail_cons]
        ring
      rw [key]
      exact hpos
  · intro y hy c a b
    have hfd : DifferentiableAt ℝ (fun z : E3 => G z a.succ b.succ) (cylPt t (y 0) (y 1)) :=
      ((hG a.succ b.succ).contDiffAt (hV.mem_nhds hy)).differentiableAt (by simp)
    have hcomp := hfd.hasFDerivAt.comp y (hιd y)
    have hfun : (fun z => sgbSideMetric G t z a b) =
        (fun z : E3 => G z a.succ b.succ) ∘ (fun y : E2 => cylPt t (y 0) (y 1)) := rfl
    unfold pd2 partialDeriv
    rw [hfun, hcomp.fderiv, ContinuousLinearMap.comp_apply, hΛe]

theorem side_density_formula (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (O : Set E2) (hO : IsOpen O)
    (hh : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun y => h y a b) O)
    (hsym : ∀ (y : E2) (a b : Fin 2), h y a b = h y b a)
    (hpd : ∀ y ∈ O, (h y).PosDef) (L : ℝ) (x : E2) (hx : x ∈ O) (hx0 : x ≠ 0) :
    Real.sqrt (sgbGradSq2 h (sgbSideDef L) x) * sgbLevelCurv2 h (sgbSideDef L) x *
        Real.sqrt (h x).det =
      sgbSideF (h x) (fun c a b => pd2 c (fun y => h y a b) x) (x 0) (x 1) :=
by
  
  have hcoord : ∀ (k : Fin 2) (z : E2),
      HasFDerivAt (fun y : E2 => y k) (PiLp.proj 2 (fun _ : Fin 2 => ℝ) k : E2 →L[ℝ] ℝ) z :=
    fun k z => PiLp.hasFDerivAt_apply (𝕜 := ℝ) (E := fun _ : Fin 2 => ℝ) 2 z k
  
  have hb : ∀ (z : E2) (a : Fin 2), pd2 a (sgbSideDef L) z = -2 * z a := by
    intro z a
    have h0 := (hcoord 0 z).pow 2
    have h1 := (hcoord 1 z).pow 2
    have hd := (h0.const_sub (L ^ 2)).fun_sub h1
    have hd' : HasFDerivAt (sgbSideDef L) _ z := hd
    unfold pd2
    rw [hd'.fderiv]
    fin_cases a <;> simp [EuclideanSpace.single_apply] <;> ring
  
  obtain ⟨A0, hA0⟩ : ∃ A0 : E2 → ℝ, A0 = fun y => h y 1 1 * y 0 - h y 0 1 * y 1 := ⟨_, rfl⟩
  obtain ⟨A1, hA1⟩ : ∃ A1 : E2 → ℝ, A1 = fun y => h y 0 0 * y 1 - h y 0 1 * y 0 := ⟨_, rfl⟩
  obtain ⟨Q, hQ⟩ : ∃ Q : E2 → ℝ, Q = fun y =>
      h y 1 1 * y 0 ^ 2 - 2 * h y 0 1 * y 0 * y 1 + h y 0 0 * y 1 ^ 2 := ⟨_, rfl⟩
  
  have halg : ∀ y ∈ O, y ≠ 0 →
      0 < (h y).det ∧ 0 < Q y ∧ sgbGradSq2 h (sgbSideDef L) y = 4 * Q y / (h y).det ∧
      Real.sqrt (h y).det * (∑ a : Fin 2, (h y)⁻¹ 0 a * pd2 a (sgbSideDef L) y) /
          Real.sqrt (sgbGradSq2 h (sgbSideDef L) y) = -(A0 y / Real.sqrt (Q y)) ∧
      Real.sqrt (h y).det * (∑ a : Fin 2, (h y)⁻¹ 1 a * pd2 a (sgbSideDef L) y) /
          Real.sqrt (sgbGradSq2 h (sgbSideDef L) y) = -(A1 y / Real.sqrt (Q y)) := by
    intro y hyO hy0
    have hP := hpd y hyO
    have hD : 0 < (h y).det := hP.det_pos
    have hDne : (h y).det ≠ 0 := hD.ne'
    have h10 : h y 1 0 = h y 0 1 := hsym y 1 0
    have hyne : (![-(y 1), y 0] : Fin 2 → ℝ) ≠ 0 := by
      intro hc
      apply hy0
      have e0 : y 1 = 0 := by have := congrFun hc 0; simpa using this
      have e1 : y 0 = 0 := by have := congrFun hc 1; simpa using this
      ext k; fin_cases k <;> simp [e0, e1]
    have hq := hP.dotProduct_mulVec_pos hyne
    have hqe : star (![-(y 1), y 0] : Fin 2 → ℝ) ⬝ᵥ (h y).mulVec ![-(y 1), y 0] =
        h y 1 1 * y 0 ^ 2 - 2 * h y 0 1 * y 0 * y 1 + h y 0 0 * y 1 ^ 2 := by
      simp [dotProduct, Matrix.mulVec, Fin.sum_univ_two, h10] <;> ring
    have hQy : 0 < Q y := by
      rw [hQ]
      rw [hqe] at hq
      exact hq
    have hinv : (h y)⁻¹ = (h y).det⁻¹ • !![h y 1 1, -h y 0 1; -h y 1 0, h y 0 0] := by
      rw [Matrix.inv_def, Matrix.adjugate_fin_two, Ring.inverse_eq_inv']
    have i00 : (h y)⁻¹ 0 0 = h y 1 1 / (h y).det := by
      rw [hinv]; simp [div_eq_inv_mul]
    have i01 : (h y)⁻¹ 0 1 = -h y 0 1 / (h y).det := by
      rw [hinv]; simp [div_eq_inv_mul]
    have i10 : (h y)⁻¹ 1 0 = -h y 0 1 / (h y).det := by
      rw [hinv]; simp [div_eq_inv_mul, h10]
    have i11 : (h y)⁻¹ 1 1 = h y 0 0 / (h y).det := by
      rw [hinv]; simp [div_eq_inv_mul]
    have hS0 : ∑ a : Fin 2, (h y)⁻¹ 0 a * pd2 a (sgbSideDef L) y = -2 * A0 y / (h y).det := by
      simp only [Fin.sum_univ_two, i00, i01, hb, hA0]
      field_simp <;> ring
    have hS1 : ∑ a : Fin 2, (h y)⁻¹ 1 a * pd2 a (sgbSideDef L) y = -2 * A1 y / (h y).det := by
      simp only [Fin.sum_univ_two, i10, i11, hb, hA1]
      field_simp <;> ring
    have hG : sgbGradSq2 h (sgbSideDef L) y = 4 * Q y / (h y).det := by
      unfold sgbGradSq2
      simp only [Fin.sum_univ_two, i00, i01, i10, i11, hb, hQ]
      field_simp <;> ring
    obtain ⟨s, hs0, hsD⟩ : ∃ s : ℝ, 0 < s ∧ (h y).det = s ^ 2 :=
      ⟨Real.sqrt (h y).det, Real.sqrt_pos.mpr hD, (Real.sq_sqrt hD.le).symm⟩
    obtain ⟨t, ht0, htQ⟩ : ∃ t : ℝ, 0 < t ∧ Q y = t ^ 2 :=
      ⟨Real.sqrt (Q y), Real.sqrt_pos.mpr hQy, (Real.sq_sqrt hQy.le).symm⟩
    have hsq : Real.sqrt (4 * Q y / (h y).det) = 2 * t / s := by
      rw [htQ, hsD, show 4 * t ^ 2 / s ^ 2 = (2 * t / s) ^ 2 by ring]
      exact Real.sqrt_sq (by positivity)
    refine ⟨hD, hQy, hG, ?_, ?_⟩
    · rw [hS0, hG, hsq, htQ, Real.sqrt_sq ht0.le, hsD, Real.sqrt_sq hs0.le]
      field_simp <;> ring
    · rw [hS1, hG, hsq, htQ, Real.sqrt_sq ht0.le, hsD, Real.sqrt_sq hs0.le]
      field_simp <;> ring
  
  have hdivsqrt : ∀ (A P : E2 → ℝ) (A' P' : E2 →L[ℝ] ℝ) (z : E2),
      HasFDerivAt A A' z → HasFDerivAt P P' z → 0 < P z → ∀ (i : Fin 2) (a q : ℝ),
      A' (e2 i) = a → P' (e2 i) = q →
      pd2 i (fun y => -(A y / Real.sqrt (P y))) z =
        -(a / Real.sqrt (P z) - A z * q / (2 * P z * Real.sqrt (P z))) := by
    intro A P A' P' z hA hP hpos i a q ha hq
    have hs0 : Real.sqrt (P z) ≠ 0 := (Real.sqrt_pos.mpr hpos).ne'
    have hPne : P z ≠ 0 := hpos.ne'
    have hS := hP.sqrt hPne
    have hI := (hasDerivAt_inv hs0).comp_hasFDerivAt z hS
    have hM := (hA.fun_mul hI).neg
    have hN : HasFDerivAt (fun y => -(A y / Real.sqrt (P y))) _ z :=
      hM.congr_of_eventuallyEq (Filter.Eventually.of_forall fun y => by
        simp [div_eq_mul_inv])
    unfold pd2
    rw [hN.fderiv]
    simp only [ContinuousLinearMap.neg_apply, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul, Function.comp_apply, ha, hq,
      Real.sq_sqrt hpos.le]
    field_simp <;> ring
  
  have hd : ∀ a b : Fin 2, HasFDerivAt (fun y => h y a b) (fderiv ℝ (fun y => h y a b) x) x :=
    fun a b => (((hh a b).contDiffAt (hO.mem_nhds hx)).differentiableAt (by simp)).hasFDerivAt
  
  have hA0d := HasFDerivAt.congr_of_eventuallyEq
    (((hd 1 1).fun_mul (hcoord 0 x)).fun_sub ((hd 0 1).fun_mul (hcoord 1 x)))
    (show A0 =ᶠ[𝓝 x] _ from Filter.Eventually.of_forall fun y => congrFun hA0 y)
  have hA1d := HasFDerivAt.congr_of_eventuallyEq
    (((hd 0 0).fun_mul (hcoord 1 x)).fun_sub ((hd 0 1).fun_mul (hcoord 0 x)))
    (show A1 =ᶠ[𝓝 x] _ from Filter.Eventually.of_forall fun y => congrFun hA1 y)
  have hQd := HasFDerivAt.congr_of_eventuallyEq
    ((((hd 1 1).fun_mul ((hcoord 0 x).pow 2)).fun_sub
      ((((hd 0 1).const_mul 2).fun_mul (hcoord 0 x)).fun_mul (hcoord 1 x))).fun_add
      ((hd 0 0).fun_mul ((hcoord 1 x).pow 2)))
    (show Q =ᶠ[𝓝 x] _ from Filter.Eventually.of_forall fun y => congrFun hQ y)
  
  obtain ⟨hDx, hQx, hGx, -, -⟩ := halg x hx hx0
  have hxU : x ∈ O ∩ {z : E2 | z ≠ 0} := ⟨hx, hx0⟩
  have hUo : IsOpen (O ∩ {z : E2 | z ≠ 0}) := hO.inter isOpen_ne
  have hev0 : (fun y => Real.sqrt (h y).det *
      (∑ a : Fin 2, (h y)⁻¹ 0 a * pd2 a (sgbSideDef L) y) /
        Real.sqrt (sgbGradSq2 h (sgbSideDef L) y)) =ᶠ[𝓝 x]
      (fun y => -(A0 y / Real.sqrt (Q y))) :=
    Filter.eventually_of_mem (hUo.mem_nhds hxU) (fun y hy => (halg y hy.1 hy.2).2.2.2.1)
  have hev1 : (fun y => Real.sqrt (h y).det *
      (∑ a : Fin 2, (h y)⁻¹ 1 a * pd2 a (sgbSideDef L) y) /
        Real.sqrt (sgbGradSq2 h (sgbSideDef L) y)) =ᶠ[𝓝 x]
      (fun y => -(A1 y / Real.sqrt (Q y))) :=
    Filter.eventually_of_mem (hUo.mem_nhds hxU) (fun y hy => (halg y hy.1 hy.2).2.2.2.2)
  have hpd_congr : ∀ (i : Fin 2) (f g : E2 → ℝ), f =ᶠ[𝓝 x] g → pd2 i f x = pd2 i g x := by
    intro i f g hfg
    unfold pd2
    rw [hfg.fderiv_eq]
  have hT0 := hdivsqrt A0 Q _ _ x hA0d hQd hQx 0
    (pd2 0 (fun y => h y 1 1) x * x 0 + h x 1 1 - pd2 0 (fun y => h y 0 1) x * x 1)
    ((pd2 0 (fun y => h y 1 1) x * x 0 ^ 2 - 2 * pd2 0 (fun y => h y 0 1) x * x 0 * x 1 +
      pd2 0 (fun y => h y 0 0) x * x 1 ^ 2) + 2 * (h x 1 1 * x 0 - h x 0 1 * x 1))
    (by simp [pd2, EuclideanSpace.single_apply] <;> ring)
    (by simp [pd2, EuclideanSpace.single_apply] <;> ring)
  have hT1 := hdivsqrt A1 Q _ _ x hA1d hQd hQx 1
    (pd2 1 (fun y => h y 0 0) x * x 1 + h x 0 0 - pd2 1 (fun y => h y 0 1) x * x 0)
    ((pd2 1 (fun y => h y 1 1) x * x 0 ^ 2 - 2 * pd2 1 (fun y => h y 0 1) x * x 0 * x 1 +
      pd2 1 (fun y => h y 0 0) x * x 1 ^ 2) + 2 * (h x 0 0 * x 1 - h x 0 1 * x 0))
    (by simp [pd2, EuclideanSpace.single_apply] <;> ring)
    (by simp [pd2, EuclideanSpace.single_apply] <;> ring)
  
  obtain ⟨s, hs0, hss, hsD⟩ : ∃ s : ℝ, 0 < s ∧ Real.sqrt (h x).det = s ∧ (h x).det = s ^ 2 :=
    ⟨_, Real.sqrt_pos.mpr hDx, rfl, (Real.sq_sqrt hDx.le).symm⟩
  obtain ⟨t, ht0, hts, htQ⟩ : ∃ t : ℝ, 0 < t ∧ Real.sqrt (Q x) = t ∧ Q x = t ^ 2 :=
    ⟨_, Real.sqrt_pos.mpr hQx, rfl, (Real.sq_sqrt hQx.le).symm⟩
  have hsq : Real.sqrt (4 * Q x / (h x).det) = 2 * t / s := by
    rw [htQ, hsD, show 4 * t ^ 2 / s ^ 2 = (2 * t / s) ^ 2 by ring]
    exact Real.sqrt_sq (by positivity)
  have hpoly : h x 1 1 * x 0 ^ 2 - 2 * h x 0 1 * x 0 * x 1 + h x 0 0 * x 1 ^ 2 = t ^ 2 := by
    rw [← htQ, hQ]
  
  unfold sgbLevelCurv2
  rw [Fin.sum_univ_two, hpd_congr 0 _ _ hev0, hpd_congr 1 _ _ hev1, hT0, hT1, hGx, hsq,
    hts, htQ, hss]
  simp only [sgbSideF, hA0, hA1]
  rw [hpoly, hss]
  have hsne : s ≠ 0 := hs0.ne'
  have htne : t ≠ 0 := ht0.ne'
  field_simp
  ring

theorem side_circle_identity (g : Matrix (Fin 2) (Fin 2) ℝ) (hg : g.PosDef)
    (d : Fin 2 → Fin 2 → Fin 2 → ℝ) (hd : ∀ c a b, d c a b = d c b a) (L φ : ℝ) (hL : 0 < L) :
    (1 / 2 : ℝ) * sgbSideF g d (L * Real.cos φ) (L * Real.sin φ) = curvKappa g g⁻¹ d L φ :=
by
  have hsym : g 1 0 = g 0 1 := by
    have h := hg.isHermitian.apply 0 1
    simpa using h
  have hdet : g.det = g 0 0 * g 1 1 - g 0 1 ^ 2 := by
    rw [Matrix.det_fin_two, hsym]; ring
  have hD : 0 < g 0 0 * g 1 1 - g 0 1 ^ 2 := by
    have := hg.det_pos
    rwa [hdet] at this
  have ha : 0 < g 0 0 := hg.diag_pos
  have he : 0 < g 1 1 := hg.diag_pos
  have hcs : Real.cos φ ^ 2 + Real.sin φ ^ 2 = 1 := Real.cos_sq_add_sin_sq φ
  have hinv : g⁻¹ = (g.det)⁻¹ • !![g 1 1, -g 0 1; -g 1 0, g 0 0] := by
    rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.adjugate_fin_two]
  have hi00 : g⁻¹ 0 0 = (g 0 0 * g 1 1 - g 0 1 ^ 2)⁻¹ * g 1 1 := by
    rw [hinv, hdet]; simp
  have hi01 : g⁻¹ 0 1 = (g 0 0 * g 1 1 - g 0 1 ^ 2)⁻¹ * (-g 0 1) := by
    rw [hinv, hdet]; simp
  have hi10 : g⁻¹ 1 0 = (g 0 0 * g 1 1 - g 0 1 ^ 2)⁻¹ * (-g 0 1) := by
    rw [hinv, hdet]; simp [hsym]
  have hi11 : g⁻¹ 1 1 = (g 0 0 * g 1 1 - g 0 1 ^ 2)⁻¹ * g 0 0 := by
    rw [hinv, hdet]; simp
  have hqn : 0 < g 1 1 * Real.cos φ ^ 2 - 2 * g 0 1 * Real.cos φ * Real.sin φ +
      g 0 0 * Real.sin φ ^ 2 := by
    have h1 : (g 0 0 + g 1 1) * (g 1 1 * Real.cos φ ^ 2 - 2 * g 0 1 * Real.cos φ * Real.sin φ +
        g 0 0 * Real.sin φ ^ 2) = (g 1 1 * Real.cos φ - g 0 1 * Real.sin φ) ^ 2 +
        (g 0 0 * Real.sin φ - g 0 1 * Real.cos φ) ^ 2 + (g 0 0 * g 1 1 - g 0 1 ^ 2) := by
      linear_combination (g 0 0 * g 1 1 - g 0 1 ^ 2) * hcs
    nlinarith [sq_nonneg (g 1 1 * Real.cos φ - g 0 1 * Real.sin φ),
      sq_nonneg (g 0 0 * Real.sin φ - g 0 1 * Real.cos φ)]
  have key : ∀ (S T q N Q1 Q2 Nd D qn : ℝ), 0 < D → 0 < qn →
      q = L ^ 2 * qn → T = 2 * q * S - 2 * L * (L * D - Nd) →
      Q1 = D⁻¹ * qn → Q2 = L ^ 2 * qn → N = D⁻¹ * Nd →
      (1 / 2 : ℝ) * ((2 * S - T / q) / Real.sqrt D) =
        (L - N) / (Real.sqrt Q1 * Real.sqrt Q2) := by
    intro S T q N Q1 Q2 Nd D qn hD hqn hq hT hQ1 hQ2 hN
    subst hq hT hQ1 hQ2 hN
    obtain ⟨r, hr0, rfl⟩ : ∃ r, 0 < r ∧ D = r ^ 2 :=
      ⟨Real.sqrt D, Real.sqrt_pos.2 hD, (Real.sq_sqrt hD.le).symm⟩
    have hL' := hL.ne'
    have hq' := hqn.ne'
    have hr' := hr0.ne'
    have hden : Real.sqrt ((r ^ 2)⁻¹ * qn) * Real.sqrt (L ^ 2 * qn) = L * qn / r := by
      rw [← Real.sqrt_mul (mul_nonneg (inv_nonneg.2 (sq_nonneg r)) hqn.le) (L ^ 2 * qn)]
      rw [show (r ^ 2)⁻¹ * qn * (L ^ 2 * qn) = (L * qn / r) ^ 2 by field_simp]
      exact Real.sqrt_sq (div_pos (mul_pos hL hqn) hr0).le
    rw [hden, Real.sqrt_sq hr0.le]
    field_simp
    ring
  simp only [sgbSideF, curvKappa]
  rw [hdet]
  refine key _ _ _ _ _ _
    ((g 1 1 * Real.cos φ - g 0 1 * Real.sin φ) *
        ((1 / 2 : ℝ) * d 0 0 0 * (L * Real.sin φ) ^ 2 - d 1 0 0 * (L * Real.sin φ) * (L * Real.cos φ) +
          (d 1 0 1 - (1 / 2 : ℝ) * d 0 1 1) * (L * Real.cos φ) ^ 2) +
      (g 0 0 * Real.sin φ - g 0 1 * Real.cos φ) *
        ((d 0 0 1 - (1 / 2 : ℝ) * d 1 0 0) * (L * Real.sin φ) ^ 2 -
          d 0 1 1 * (L * Real.sin φ) * (L * Real.cos φ) + (1 / 2 : ℝ) * d 1 1 1 * (L * Real.cos φ) ^ 2))
    (g 0 0 * g 1 1 - g 0 1 ^ 2)
    (g 1 1 * Real.cos φ ^ 2 - 2 * g 0 1 * Real.cos φ * Real.sin φ + g 0 0 * Real.sin φ ^ 2)
    hD hqn ?_ ?_ ?_ ?_ ?_
  · ring
  · linear_combination (-2 * L ^ 2 * (g 0 0 * g 1 1 - g 0 1 ^ 2)) * hcs
  · simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
      hi00, hi01, hi10, hi11]
    ring
  · simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
      hsym]
    ring
  · simp only [Fin.sum_univ_two, Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons,
      hi00, hi01, hi10, hi11, hd 0 1 0, hd 1 1 0]
    ring

theorem annulus_collar_limit (F : E2 → ℝ) (L ρ : ℝ) (hρ : 0 < ρ) (hρL : ρ < L)
    (hF : ContinuousOn F {x : E2 | ρ ^ 2 < x 0 ^ 2 + x 1 ^ 2}) :
    Tendsto (fun s : ℝ => ∫ x : E2, s⁻¹ * deriv Real.smoothTransition (sgbSideDef L x / s) * F x)
      (𝓝[>] (0 : ℝ))
      (𝓝 ((1 / 2 : ℝ) * ∫ θ in (-Real.pi)..Real.pi,
        F ((EuclideanSpace.equiv (Fin 2) ℝ).symm ![L * Real.cos θ, L * Real.sin θ]))) :=
by
  
  have hC : ContDiff ℝ 1 Real.smoothTransition := Real.smoothTransition.contDiff
  have hcont : Continuous (deriv Real.smoothTransition) := hC.continuous_deriv le_rfl
  have hnn : ∀ σ : ℝ, 0 ≤ deriv Real.smoothTransition σ :=
    fun σ => Real.smoothTransition.monotone.deriv_nonneg
  have h0 : ∀ σ : ℝ, σ ≤ 0 → deriv Real.smoothTransition σ = 0 := by
    intro σ hσ
    apply IsLocalMin.deriv_eq_zero
    apply IsMinOn.isLocalMin _ Filter.univ_mem
    rw [isMinOn_univ_iff]
    intro x
    rw [Real.smoothTransition.zero_of_nonpos hσ]
    exact Real.smoothTransition.nonneg x
  have h1 : ∀ σ : ℝ, 1 ≤ σ → deriv Real.smoothTransition σ = 0 := by
    intro σ hσ
    apply IsLocalMax.deriv_eq_zero
    apply IsMaxOn.isLocalMax _ Filter.univ_mem
    rw [isMaxOn_univ_iff]
    intro x
    rw [Real.smoothTransition.one_of_one_le hσ]
    exact Real.smoothTransition.le_one x
  have hder : ∀ σ : ℝ, HasDerivAt Real.smoothTransition (deriv Real.smoothTransition σ) σ :=
    fun σ => ((hC.differentiable one_ne_zero) σ).hasDerivAt
  
  obtain ⟨a, ha⟩ : ∃ a : ℝ, a = (ρ + L) / 2 := ⟨_, rfl⟩
  have hρa : ρ < a := by rw [ha]; linarith
  have haL : a < L := by rw [ha]; linarith
  have ha0 : 0 < a := by linarith
  have hL0 : 0 < L := by linarith
  have hgap : 0 < L ^ 2 - a ^ 2 := by nlinarith
  have hpi : -Real.pi ≤ Real.pi := by linarith [Real.pi_pos]
  
  obtain ⟨w, hw⟩ : ∃ w : ℝ → ℝ → ℝ,
      w = fun s r => r * s⁻¹ * deriv Real.smoothTransition ((L ^ 2 - r ^ 2) / s) := ⟨_, rfl⟩
  have hwc : ∀ s : ℝ, Continuous (w s) := by
    intro s
    rw [hw]
    exact (continuous_id.mul continuous_const).mul
      (hcont.comp ((continuous_const.sub (continuous_pow 2)).div_const s))
  
  have hmass : ∀ s : ℝ, 0 < s → s < L ^ 2 - a ^ 2 → ∫ r in a..L, w s r = 1 / 2 := by
    intro s hs hsa
    have hderiv : ∀ r ∈ Set.uIcc a L,
        HasDerivAt (fun r : ℝ => -(1 / 2 : ℝ) * Real.smoothTransition ((L ^ 2 - r ^ 2) / s))
          (r * s⁻¹ * deriv Real.smoothTransition ((L ^ 2 - r ^ 2) / s)) r := by
      intro r _
      have hu : HasDerivAt (fun r : ℝ => (L ^ 2 - r ^ 2) / s) (-(2 * r) / s) r := by
        have := ((hasDerivAt_pow 2 r).const_sub (L ^ 2)).div_const s
        convert this using 1
        norm_num
      have := ((hder ((L ^ 2 - r ^ 2) / s)).comp r hu).const_mul (-(1 / 2 : ℝ))
      convert this using 1
      ring
    simp only [hw]
    rw [intervalIntegral.integral_eq_sub_of_hasDerivAt hderiv
      ((by simpa [hw] using hwc s : Continuous fun r : ℝ =>
        r * s⁻¹ * deriv Real.smoothTransition ((L ^ 2 - r ^ 2) / s)).intervalIntegrable _ _)]
    have e1 : (L ^ 2 - L ^ 2) / s = 0 := by simp
    have e2 : 1 ≤ (L ^ 2 - a ^ 2) / s := by rw [le_div_iff₀ hs]; linarith
    simp only [e1, Real.smoothTransition.zero, Real.smoothTransition.one_of_one_le e2]
    norm_num
  
  have hside : ∀ r θ : ℝ, sgbSideDef L
      ((EuclideanSpace.equiv (Fin 2) ℝ).symm ![r * Real.cos θ, r * Real.sin θ]) = L ^ 2 - r ^ 2 := by
    intro r θ
    show L ^ 2 - (r * Real.cos θ) ^ 2 - (r * Real.sin θ) ^ 2 = L ^ 2 - r ^ 2
    linear_combination (-r ^ 2) * Real.cos_sq_add_sin_sq θ
  have hann : ∀ r θ : ℝ, a ≤ r →
      ((EuclideanSpace.equiv (Fin 2) ℝ).symm ![r * Real.cos θ, r * Real.sin θ] : E2) ∈
        {x : E2 | ρ ^ 2 < x 0 ^ 2 + x 1 ^ 2} := by
    intro r θ hr
    show ρ ^ 2 < (r * Real.cos θ) ^ 2 + (r * Real.sin θ) ^ 2
    have hcs : (r * Real.cos θ) ^ 2 + (r * Real.sin θ) ^ 2 = r ^ 2 := by
      linear_combination r ^ 2 * Real.cos_sq_add_sin_sq θ
    rw [hcs]
    nlinarith [mul_self_lt_mul_self hρ.le (lt_of_lt_of_le hρa hr)]
  have hvec : Continuous (fun p : ℝ × ℝ => (![p.1 * Real.cos p.2, p.1 * Real.sin p.2] : Fin 2 → ℝ)) := by
    refine continuous_pi (fun i => ?_)
    fin_cases i
    · show Continuous fun p : ℝ × ℝ => p.1 * Real.cos p.2
      fun_prop
    · show Continuous fun p : ℝ × ℝ => p.1 * Real.sin p.2
      fun_prop
  have hQc : Continuous (fun p : ℝ × ℝ =>
      ((EuclideanSpace.equiv (Fin 2) ℝ).symm ![p.1 * Real.cos p.2, p.1 * Real.sin p.2] : E2)) :=
    (EuclideanSpace.equiv (Fin 2) ℝ).symm.continuous.comp hvec
  
  have hpolar : ∀ s : ℝ, 0 < s → s < L ^ 2 - a ^ 2 →
      ∫ x : E2, s⁻¹ * deriv Real.smoothTransition (sgbSideDef L x / s) * F x =
      ∫ r in a..L, w s r * ∫ θ in (-Real.pi)..Real.pi,
        F ((EuclideanSpace.equiv (Fin 2) ℝ).symm ![r * Real.cos θ, r * Real.sin θ]) := by
    intro s hs hsa
    obtain ⟨H, hH⟩ : ∃ H : E2 → ℝ,
        H = fun x => s⁻¹ * deriv Real.smoothTransition (sgbSideDef L x / s) * F x := ⟨_, rfl⟩
    obtain ⟨hf, hhf⟩ : ∃ hf : ℝ × ℝ → ℝ, hf = fun p => p.1 *
        (s⁻¹ * deriv Real.smoothTransition ((L ^ 2 - p.1 ^ 2) / s)) *
        F ((EuclideanSpace.equiv (Fin 2) ℝ).symm ![p.1 * Real.cos p.2, p.1 * Real.sin p.2]) :=
      ⟨_, rfl⟩
    obtain ⟨e, he⟩ : ∃ e : E2 ≃ᵐ ℝ × ℝ,
        e = (MeasurableEquiv.toLp 2 (Fin 2 → ℝ)).symm.trans MeasurableEquiv.finTwoArrow := ⟨_, rfl⟩
    have hmp : MeasurePreserving e volume volume := by
      rw [he]
      exact (volume_preserving_finTwoArrow ℝ).comp
        (EuclideanSpace.volume_preserving_symm_measurableEquiv_toLp (Fin 2))
    have hes : ∀ u v : ℝ, e.symm (u, v) = (EuclideanSpace.equiv (Fin 2) ℝ).symm ![u, v] := by
      intro u v
      rw [he]
      ext i
      fin_cases i <;> rfl
    have hgoal : (∫ x : E2, s⁻¹ * deriv Real.smoothTransition (sgbSideDef L x / s) * F x) =
        ∫ x, H x := by rw [hH]
    have step1 : ∫ x, H x = ∫ p : ℝ × ℝ, H (e.symm p) := by
      have := hmp.integral_comp' (fun p => H (e.symm p))
      simp only [MeasurableEquiv.symm_apply_apply] at this
      exact this
    have step2 : ∫ p : ℝ × ℝ, H (e.symm p) =
        ∫ p in polarCoord.target, p.1 • H (e.symm (polarCoord.symm p)) :=
      (integral_comp_polarCoord_symm (fun p => H (e.symm p))).symm
    have step3 : ∫ p in polarCoord.target, p.1 • H (e.symm (polarCoord.symm p)) =
        ∫ p in polarCoord.target, hf p := by
      congr 1
      funext p
      rw [polarCoord_symm_apply, hes, smul_eq_mul, hH, hhf]
      simp only [hside]
      ring
    have htm : MeasurableSet polarCoord.target := by
      rw [polarCoord_target]; exact measurableSet_Ioi.prod measurableSet_Ioo
    have hS : Set.Icc a L ×ˢ Set.Ioo (-Real.pi) Real.pi ⊆ polarCoord.target := by
      rw [polarCoord_target]
      exact Set.prod_mono (fun r hr => lt_of_lt_of_le ha0 hr.1) subset_rfl
    have step4 : ∫ p in polarCoord.target, hf p =
        ∫ p in Set.Icc a L ×ˢ Set.Ioo (-Real.pi) Real.pi, hf p := by
      apply setIntegral_eq_of_subset_of_forall_diff_eq_zero htm hS
      rintro p ⟨hpt, hpS⟩
      rw [polarCoord_target] at hpt
      obtain ⟨hp1, hp2⟩ := hpt
      have hp1' : 0 < p.1 := hp1
      have hr : p.1 < a ∨ L < p.1 := by
        by_contra hcon
        push_neg at hcon
        exact hpS ⟨⟨hcon.1, hcon.2⟩, hp2⟩
      have hz : deriv Real.smoothTransition ((L ^ 2 - p.1 ^ 2) / s) = 0 := by
        rcases hr with hr | hr
        · apply h1
          rw [le_div_iff₀ hs]
          have : p.1 ^ 2 < a ^ 2 := by nlinarith
          linarith
        · apply h0
          apply div_nonpos_of_nonpos_of_nonneg _ hs.le
          nlinarith
      rw [hhf]
      simp [hz]
    have hK : IsCompact (Set.Icc a L ×ˢ Set.Icc (-Real.pi) Real.pi) :=
      isCompact_Icc.prod isCompact_Icc
    have hFQ : ContinuousOn (fun p : ℝ × ℝ =>
        F ((EuclideanSpace.equiv (Fin 2) ℝ).symm ![p.1 * Real.cos p.2, p.1 * Real.sin p.2]))
        (Set.Icc a L ×ˢ Set.Icc (-Real.pi) Real.pi) :=
      hF.comp hQc.continuousOn (fun p hp => hann p.1 p.2 hp.1.1)
    have hhK : ContinuousOn hf (Set.Icc a L ×ˢ Set.Icc (-Real.pi) Real.pi) := by
      rw [hhf]
      exact ((continuous_fst.mul (continuous_const.mul (hcont.comp
        ((continuous_const.sub (continuous_fst.pow 2)).div_const s)))).continuousOn).mul hFQ
    have hint : IntegrableOn hf (Set.Icc a L ×ˢ Set.Ioo (-Real.pi) Real.pi) volume :=
      (hhK.integrableOn_compact hK).mono_set (Set.prod_mono subset_rfl Set.Ioo_subset_Icc_self)
    have step5 : ∫ p in Set.Icc a L ×ˢ Set.Ioo (-Real.pi) Real.pi, hf p =
        ∫ r in Set.Icc a L, ∫ θ in Set.Ioo (-Real.pi) Real.pi, hf (r, θ) := by
      rw [Measure.volume_eq_prod] at hint ⊢
      exact setIntegral_prod hf hint
    rw [hgoal, step1, step2, step3, step4, step5, intervalIntegral.integral_of_le haL.le,
      ← integral_Icc_eq_integral_Ioc]
    congr 1
    funext r
    rw [hhf, hw]
    dsimp only
    rw [integral_const_mul, intervalIntegral.integral_of_le hpi, integral_Ioc_eq_integral_Ioo]
    ring
  
  obtain ⟨Φ, hΦc, hΦeq⟩ : ∃ Φ : ℝ → ℝ, Continuous Φ ∧ ∀ r ∈ Set.Icc a L,
      Φ r = ∫ θ in (-Real.pi)..Real.pi,
        F ((EuclideanSpace.equiv (Fin 2) ℝ).symm ![r * Real.cos θ, r * Real.sin θ]) := by
    have hκ : Continuous (fun r : ℝ => (Set.projIcc a L haL.le r : ℝ)) :=
      continuous_subtype_val.comp continuous_projIcc
    have hQ' : Continuous (fun p : ℝ × ℝ =>
        ((EuclideanSpace.equiv (Fin 2) ℝ).symm
          ![(Set.projIcc a L haL.le p.1 : ℝ) * Real.cos p.2,
            (Set.projIcc a L haL.le p.1 : ℝ) * Real.sin p.2] : E2)) :=
      hQc.comp ((hκ.comp continuous_fst).prodMk continuous_snd)
    have hcu : Continuous (Function.uncurry fun (r θ : ℝ) =>
        F ((EuclideanSpace.equiv (Fin 2) ℝ).symm
          ![(Set.projIcc a L haL.le r : ℝ) * Real.cos θ,
            (Set.projIcc a L haL.le r : ℝ) * Real.sin θ])) :=
      hF.comp_continuous hQ' (fun p => hann _ p.2 (Set.projIcc a L haL.le p.1).2.1)
    refine ⟨fun r => ∫ θ in (-Real.pi)..Real.pi,
        F ((EuclideanSpace.equiv (Fin 2) ℝ).symm
          ![(Set.projIcc a L haL.le r : ℝ) * Real.cos θ,
            (Set.projIcc a L haL.le r : ℝ) * Real.sin θ]), ?_, ?_⟩
    · exact intervalIntegral.continuous_parametric_intervalIntegral_of_continuous
        (a₀ := -Real.pi) hcu continuous_const
    · intro r hr
      simp only [Set.projIcc_of_mem haL.le hr]
  
  have hlimJ : Tendsto (fun s : ℝ => ∫ r in a..L, w s r * Φ r) (𝓝[>] 0)
      (𝓝 ((1 / 2 : ℝ) * Φ L)) := by
    rw [Metric.tendsto_nhdsWithin_nhds]
    intro ε hε
    obtain ⟨δ, hδ, hδΦ⟩ := Metric.continuous_iff.mp hΦc L ε hε
    refine ⟨min (L ^ 2 - a ^ 2) (L * δ), lt_min hgap (mul_pos hL0 hδ), ?_⟩
    intro s hs hsd
    have hs0 : 0 < s := hs
    rw [Real.dist_eq, sub_zero, abs_of_pos hs0] at hsd
    have hsa : s < L ^ 2 - a ^ 2 := lt_of_lt_of_le hsd (min_le_left _ _)
    have hsδ : s < L * δ := lt_of_lt_of_le hsd (min_le_right _ _)
    have hint1 : IntervalIntegrable (fun r => w s r * Φ r) volume a L :=
      ((hwc s).mul hΦc).intervalIntegrable _ _
    have hint2 : IntervalIntegrable (fun r => w s r * Φ L) volume a L :=
      ((hwc s).mul continuous_const).intervalIntegrable _ _
    have hdiff : (∫ r in a..L, w s r * Φ r) - 1 / 2 * Φ L =
        ∫ r in a..L, w s r * (Φ r - Φ L) := by
      have hc : ∫ r in a..L, w s r * Φ L = 1 / 2 * Φ L := by
        rw [intervalIntegral.integral_mul_const, hmass s hs0 hsa]
      rw [← hc, ← intervalIntegral.integral_sub hint1 hint2]
      congr 1
      funext r
      ring
    have hbound : ‖∫ r in a..L, w s r * (Φ r - Φ L)‖ ≤ ∫ r in a..L, w s r * ε := by
      apply intervalIntegral.norm_integral_le_of_norm_le haL.le
      · refine ae_of_all _ (fun r hr => ?_)
        have hr0 : 0 < r := lt_trans ha0 hr.1
        have hw0 : 0 ≤ w s r := by
          rw [hw]
          exact mul_nonneg (mul_nonneg hr0.le (inv_nonneg.mpr hs0.le)) (hnn _)
        by_cases hd : (L ^ 2 - r ^ 2) / s < 1
        · have hlt : L ^ 2 - r ^ 2 < s := by rwa [div_lt_one hs0] at hd
          have hLr : L * (L - r) < L * δ := by
            nlinarith [mul_nonneg hr0.le (sub_nonneg.mpr hr.2)]
          have hLr' : L - r < δ := lt_of_mul_lt_mul_left hLr hL0.le
          have hdist : dist r L < δ := by
            rw [Real.dist_eq, abs_sub_lt_iff]
            constructor <;> linarith [hr.2]
          have hΦ : |Φ r - Φ L| < ε := by
            have := hδΦ r hdist
            rwa [Real.dist_eq] at this
          rw [Real.norm_eq_abs, abs_mul, abs_of_nonneg hw0]
          exact mul_le_mul_of_nonneg_left hΦ.le hw0
        · push_neg at hd
          have hw00 : w s r = 0 := by
            rw [hw]
            simp only [h1 _ hd, mul_zero]
          rw [hw00]
          simp
      · exact ((hwc s).mul continuous_const).intervalIntegrable _ _
    have hval : ∫ r in a..L, w s r * ε = 1 / 2 * ε := by
      rw [intervalIntegral.integral_mul_const, hmass s hs0 hsa]
    rw [Real.dist_eq, hdiff]
    rw [Real.norm_eq_abs] at hbound
    linarith
  
  have hlim2 : Tendsto (fun s : ℝ =>
      ∫ x : E2, s⁻¹ * deriv Real.smoothTransition (sgbSideDef L x / s) * F x)
      (𝓝[>] (0 : ℝ)) (𝓝 ((1 / 2 : ℝ) * Φ L)) := by
    refine Tendsto.congr' ?_ hlimJ
    filter_upwards [Ioo_mem_nhdsGT hgap] with s hs
    show (∫ r in a..L, w s r * Φ r) =
      ∫ x : E2, s⁻¹ * deriv Real.smoothTransition (sgbSideDef L x / s) * F x
    rw [hpolar s hs.1 hs.2]
    apply intervalIntegral.integral_congr
    intro r hr
    rw [Set.uIcc_of_le haL.le] at hr
    simp only [hΦeq r hr]
  rw [hΦeq L ⟨haL.le, le_rfl⟩] at hlim2
  exact hlim2

theorem side_density_continuous (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (O : Set E2) (hO : IsOpen O)
    (hh : ∀ a b : Fin 2, ContDiffOn ℝ ∞ (fun y => h y a b) O)
    (hsym : ∀ (y : E2) (a b : Fin 2), h y a b = h y b a)
    (hpd : ∀ y ∈ O, (h y).PosDef) :
    ContinuousOn
      (fun x : E2 => sgbSideF (h x) (fun c a b => pd2 c (fun y => h y a b) x) (x 0) (x 1))
      {x : E2 | x ∈ O ∧ x ≠ 0} :=
by
  have hSO : {x : E2 | x ∈ O ∧ x ≠ 0} ⊆ O := fun x hx => hx.1
  have hg : ∀ a b : Fin 2, ContinuousOn (fun x => h x a b) {x : E2 | x ∈ O ∧ x ≠ 0} :=
    fun a b => ((hh a b).continuousOn).mono hSO
  have hd : ∀ c a b : Fin 2,
      ContinuousOn (fun x => pd2 c (fun y => h y a b) x) {x : E2 | x ∈ O ∧ x ≠ 0} := by
    intro c a b
    have h1 : ContinuousOn (fderiv ℝ (fun y => h y a b)) O :=
      (hh a b).continuousOn_fderiv_of_isOpen hO (by simp)
    exact (h1.clm_apply continuousOn_const).mono hSO
  have hx0 : ContinuousOn (fun x : E2 => x 0) {x : E2 | x ∈ O ∧ x ≠ 0} :=
    (PiLp.continuous_apply 2 _ 0).continuousOn
  have hx1 : ContinuousOn (fun x : E2 => x 1) {x : E2 | x ∈ O ∧ x ≠ 0} :=
    (PiLp.continuous_apply 2 _ 1).continuousOn
  have hdet : ∀ x ∈ {x : E2 | x ∈ O ∧ x ≠ 0}, Real.sqrt (h x).det ≠ 0 := fun x hx =>
    (Real.sqrt_pos.mpr (hpd x hx.1).det_pos).ne'
  have hdetc : ContinuousOn (fun x => Real.sqrt (h x).det) {x : E2 | x ∈ O ∧ x ≠ 0} := by
    have e : (fun x => (h x).det) = fun x => h x 0 0 * h x 1 1 - h x 0 1 * h x 1 0 := by
      funext x; exact Matrix.det_fin_two _
    have : ContinuousOn (fun x => (h x).det) {x : E2 | x ∈ O ∧ x ≠ 0} := by
      rw [e]
      exact ((hg 0 0).mul (hg 1 1)).sub ((hg 0 1).mul (hg 1 0))
    exact this.sqrt
  have hq : ∀ x ∈ {x : E2 | x ∈ O ∧ x ≠ 0},
      h x 1 1 * x 0 ^ 2 - 2 * h x 0 1 * x 0 * x 1 + h x 0 0 * x 1 ^ 2 ≠ 0 := by
    intro x hx
    have hv : (![-(x 1), x 0] : Fin 2 → ℝ) ≠ 0 := by
      intro hv0
      apply hx.2
      have e0 : x 1 = 0 := by
        have := congrFun hv0 0
        simpa using this
      have e1 : x 0 = 0 := by
        have := congrFun hv0 1
        simpa using this
      ext i
      fin_cases i
      · simpa using e1
      · simpa using e0
    have hpos := (hpd x hx.1).dotProduct_mulVec_pos hv
    simp only [star_trivial, dotProduct, Matrix.mulVec, Fin.sum_univ_two, Matrix.cons_val_zero,
      Matrix.cons_val_one, Matrix.head_cons] at hpos
    rw [hsym x 1 0] at hpos
    have : 0 < h x 1 1 * x 0 ^ 2 - 2 * h x 0 1 * x 0 * x 1 + h x 0 0 * x 1 ^ 2 := by
      nlinarith
    exact this.ne'
  simp only [sgbSideF]
  refine ContinuousOn.div ?_ hdetc hdet
  refine ContinuousOn.sub ?_ (ContinuousOn.div ?_ ?_ hq)
  · apply_rules (config := { maxDepth := 500 }) [ContinuousOn.add, ContinuousOn.sub,
      ContinuousOn.mul, ContinuousOn.pow, ContinuousOn.neg, continuousOn_const, hg, hd, hx0, hx1]
  · apply_rules (config := { maxDepth := 500 }) [ContinuousOn.add, ContinuousOn.sub,
      ContinuousOn.mul, ContinuousOn.pow, ContinuousOn.neg, continuousOn_const, hg, hd, hx0, hx1]
  · apply_rules (config := { maxDepth := 500 }) [ContinuousOn.add, ContinuousOn.sub,
      ContinuousOn.mul, ContinuousOn.pow, ContinuousOn.neg, continuousOn_const, hg, hd, hx0, hx1]

theorem stern_side_collar_limit (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (R L t : ℝ)
    (hR : 0 ≤ R) (hRL : R < L) (ht : |t| < L)
    (hG : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => G y a b) {y : E3 | R < ‖y‖})
    (hsymm : ∀ (y : E3) (a b : Fin 3), G y a b = G y b a)
    (hpd : ∀ y : E3, R < ‖y‖ → (G y).PosDef) :
    Tendsto (fun s : ℝ => ∫ x : E2, s⁻¹ * deriv Real.smoothTransition (sgbSideDef L x / s) *
        Real.sqrt (sgbGradSq2 (sgbSideMetric G t) (sgbSideDef L) x) *
        sgbLevelCurv2 (sgbSideMetric G t) (sgbSideDef L) x *
        Real.sqrt (sgbSideMetric G t x).det)
      (𝓝[>] (0 : ℝ)) (𝓝 (sternKappa G L t)) :=
by
  have hL0 : 0 < L := lt_of_le_of_lt (abs_nonneg t) ht
  
  obtain ⟨hUo, hhs, hhsym, hhpd, hchain⟩ := side_metric_props G R t hG hsymm hpd
  obtain ⟨F, hF⟩ : ∃ F : E2 → ℝ, F = fun x =>
      Real.sqrt (sgbGradSq2 (sgbSideMetric G t) (sgbSideDef L) x) *
        sgbLevelCurv2 (sgbSideMetric G t) (sgbSideDef L) x *
        Real.sqrt (sgbSideMetric G t x).det := ⟨_, rfl⟩
  
  have hFeq : ∀ x ∈ {x : E2 | x ∈ {y : E2 | R < ‖cylPt t (y 0) (y 1)‖} ∧ x ≠ 0},
      F x = sgbSideF (sgbSideMetric G t x)
        (fun c a b => pd2 c (fun y => sgbSideMetric G t y a b) x) (x 0) (x 1) := by
    intro x hx
    rw [hF]
    exact side_density_formula (sgbSideMetric G t) _ hUo hhs hhsym hhpd L x hx.1 hx.2
  have hFc : ContinuousOn F
      {x : E2 | x ∈ {y : E2 | R < ‖cylPt t (y 0) (y 1)‖} ∧ x ≠ 0} :=
    (side_density_continuous (sgbSideMetric G t) _ hUo hhs hhsym hhpd).congr
      (fun x hx => hFeq x hx)
  
  have hnormsq : ∀ a b : ℝ, ‖cylPt t a b‖ ^ 2 = t ^ 2 + a ^ 2 + b ^ 2 := by
    intro a b
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)),
      Fin.sum_univ_three]
    simp [cylPt, e, EuclideanSpace.single_apply]
  obtain ⟨ρ, hρ⟩ : ∃ ρ : ℝ, ρ = (R + L) / 2 := ⟨_, rfl⟩
  have hρ0 : 0 < ρ := by rw [hρ]; linarith
  have hρL : ρ < L := by rw [hρ]; linarith
  have hRρ : R < ρ := by rw [hρ]; linarith
  have hann : {x : E2 | ρ ^ 2 < x 0 ^ 2 + x 1 ^ 2} ⊆
      {x : E2 | x ∈ {y : E2 | R < ‖cylPt t (y 0) (y 1)‖} ∧ x ≠ 0} := by
    intro x hx
    have hx' : ρ ^ 2 < x 0 ^ 2 + x 1 ^ 2 := hx
    refine ⟨?_, ?_⟩
    · show R < ‖cylPt t (x 0) (x 1)‖
      have h1 := hnormsq (x 0) (x 1)
      have h2 := norm_nonneg (cylPt t (x 0) (x 1))
      by_contra hcon
      push_neg at hcon
      have h3 := mul_self_le_mul_self h2 hcon
      have h4 := mul_self_lt_mul_self hR hRρ
      nlinarith [sq_nonneg t]
    · intro hx0
      have h0 : x 0 = 0 ∧ x 1 = 0 := by rw [hx0]; simp
      rw [h0.1, h0.2] at hx'
      nlinarith [sq_nonneg ρ]
  have hFann : ContinuousOn F {x : E2 | ρ ^ 2 < x 0 ^ 2 + x 1 ^ 2} := hFc.mono hann
  
  have hlim := annulus_collar_limit F L ρ hρ0 hρL hFann
  
  have key : ∀ (θ : ℝ) (x : E2), x 0 = L * Real.cos θ → x 1 = L * Real.sin θ →
      (1 / 2 : ℝ) * F x = curvIntegrand G t L θ := by
    intro θ x hx0 hx1
    have hcs : (L * Real.cos θ) ^ 2 + (L * Real.sin θ) ^ 2 = L ^ 2 := by
      rw [mul_pow, mul_pow, ← mul_add, Real.cos_sq_add_sin_sq, mul_one]
    have hxann : ρ ^ 2 < x 0 ^ 2 + x 1 ^ 2 := by
      rw [hx0, hx1, hcs]
      nlinarith [mul_self_lt_mul_self hρ0.le hρL]
    have hxU := hann hxann
    have hmat : sgbSideMetric G t x = cylGam G t L θ := by
      funext a b
      simp only [sgbSideMetric, cylGam, hx0, hx1]
    have hd : (fun c a b => pd2 c (fun y => sgbSideMetric G t y a b) x) = cylDG G t L θ := by
      funext c a b
      rw [hchain x hxU.1 c a b]
      simp only [cylDG, hx0, hx1]
    have hdsym : ∀ c a b, cylDG G t L θ c a b = cylDG G t L θ c b a := by
      intro c a b
      show partialDeriv c.succ (fun z => G z a.succ b.succ) _ =
        partialDeriv c.succ (fun z => G z b.succ a.succ) _
      rw [show (fun z => G z a.succ b.succ) = (fun z => G z b.succ a.succ) from
        funext fun z => hsymm z _ _]
    have hpdθ : (cylGam G t L θ).PosDef := by
      rw [← hmat]
      exact hhpd x hxU.1
    rw [hFeq x hxU, hd, hmat, hx0, hx1, side_circle_identity _ hpdθ _ hdsym L θ hL0]
    rfl
  have hpt : ∀ θ : ℝ, (1 / 2 : ℝ) *
      F ((EuclideanSpace.equiv (Fin 2) ℝ).symm ![L * Real.cos θ, L * Real.sin θ]) =
        curvIntegrand G t L θ :=
    fun θ => key θ _ rfl rfl
  
  have hval : (1 / 2 : ℝ) * ∫ θ in (-Real.pi)..Real.pi,
      F ((EuclideanSpace.equiv (Fin 2) ℝ).symm ![L * Real.cos θ, L * Real.sin θ]) =
        sternKappa G L t := by
    rw [← intervalIntegral.integral_const_mul]
    rw [intervalIntegral.integral_congr (fun θ _ => hpt θ)]
    have hper : Function.Periodic (curvIntegrand G t L) (2 * Real.pi) := by
      intro θ
      simp only [curvIntegrand, Real.cos_add_two_pi, Real.sin_add_two_pi]
    have h2 := hper.intervalIntegral_add_eq (-Real.pi) 0
    rw [show -Real.pi + 2 * Real.pi = Real.pi by ring, zero_add] at h2
    rw [h2]
    rfl
  rw [hval] at hlim
  refine Tendsto.congr (fun s => ?_) hlim
  congr 1
  funext x
  rw [hF]
  dsimp only
  ring

theorem pcgb_interior_ball {X : Type*} [TopologicalSpace X] (S : Set X) (P : EigPatchedSurface X S)
    (b : X → ℝ) (hb : ∀ j, ContDiffOn ℝ ∞ (fun x => b (P.param j x)) (P.W j))
    (hreg : ∀ j, ∀ x ∈ P.W j, b (P.param j x) = 0 →
      fderiv ℝ (fun y => b (P.param j y)) x ≠ 0)
    (hbd : ∃ q ∈ S, b q = 0) :
    ∃ (j₀ : Fin P.n) (x₀ : E2) (r : ℝ), 0 < r ∧ Metric.closedBall x₀ r ⊆ P.W j₀ ∧
      ∀ x ∈ Metric.closedBall x₀ r, 2 * r ≤ b (P.param j₀ x) :=
by
  obtain ⟨q, hq, hq0⟩ := hbd
  obtain ⟨j, hj⟩ := Set.mem_iUnion.mp (P.cover hq)
  have hq' : q ∈ P.param j '' P.W j := by rw [P.image_eq]; exact ⟨hj, hq⟩
  obtain ⟨x, hx, hxq⟩ := hq'
  set f : E2 → ℝ := fun y => b (P.param j y) with hfdef
  have hfx : f x = 0 := by simp only [hfdef, hxq, hq0]
  have hnmax : ¬ IsLocalMax f x := fun hmax =>
    hreg j x hx (by simpa [hfdef] using hfx) hmax.fderiv_eq_zero
  have hfreq : ∃ᶠ y in 𝓝 x, ¬ (f y ≤ f x) := Filter.not_eventually.mp hnmax
  obtain ⟨x₁, hx₁f, hx₁W⟩ :=
    (hfreq.and_eventually ((P.W_open j).mem_nhds hx)).exists
  have hβ : 0 < f x₁ := by rw [hfx] at hx₁f; exact not_le.mp hx₁f
  obtain ⟨δ₁, hδ₁, hball⟩ := Metric.isOpen_iff.mp (P.W_open j) x₁ hx₁W
  have hcont : ContinuousAt f x₁ :=
    (hb j).continuousOn.continuousAt ((P.W_open j).mem_nhds hx₁W)
  obtain ⟨δ₂, hδ₂, hδ₂f⟩ := Metric.continuousAt_iff.mp hcont (f x₁ / 2) (by linarith)
  refine ⟨j, x₁, min (min (δ₁ / 2) (δ₂ / 2)) (f x₁ / 4), ?_, ?_, ?_⟩
  · exact lt_min (lt_min (by linarith) (by linarith)) (by linarith)
  · intro y hy
    apply hball
    rw [Metric.mem_closedBall] at hy
    rw [Metric.mem_ball]
    have h1 := min_le_left (min (δ₁ / 2) (δ₂ / 2)) (f x₁ / 4)
    have h2 := min_le_left (δ₁ / 2) (δ₂ / 2)
    linarith
  · intro y hy
    rw [Metric.mem_closedBall] at hy
    have h1 := min_le_left (min (δ₁ / 2) (δ₂ / 2)) (f x₁ / 4)
    have h2 := min_le_right (δ₁ / 2) (δ₂ / 2)
    have h3 := min_le_right (min (δ₁ / 2) (δ₂ / 2)) (f x₁ / 4)
    have hd : dist y x₁ < δ₂ := by linarith
    have h4 := hδ₂f hd
    rw [Real.dist_eq] at h4
    have h5 := (abs_lt.mp h4).1
    show 2 * min (min (δ₁ / 2) (δ₂ / 2)) (f x₁ / 4) ≤ f y
    linarith

theorem pcgb_taylor2_remainder (V : Set E2) (hV : IsOpen V) (φ : E2 → ℝ)
    (hφ : ContDiffOn ℝ ∞ φ V) (x₀ : E2) (R : ℝ) (hR : 0 < R)
    (hball : Metric.closedBall x₀ R ⊆ V) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ x ∈ Metric.closedBall x₀ R,
      |pcgbTay2 φ x₀ x| ≤ K * dist x x₀ ^ 3 ∧
      ‖fderiv ℝ (pcgbTay2 φ x₀) x‖ ≤ K * dist x x₀ ^ 2 ∧
      ‖fderiv ℝ (fderiv ℝ (pcgbTay2 φ x₀)) x‖ ≤ K * dist x x₀ :=
by
  classical
  have hx₀V : x₀ ∈ V := hball (Metric.mem_closedBall_self hR.le)
  have hφa : ContDiffAt ℝ ∞ φ x₀ := hφ.contDiffAt (hV.mem_nhds hx₀V)
  have hφ' : ContDiffOn ℝ ∞ (fderiv ℝ φ) V := hφ.fderiv_of_isOpen hV le_rfl
  have hdφ' : DifferentiableAt ℝ (fderiv ℝ φ) x₀ :=
    (hφ'.contDiffAt (hV.mem_nhds hx₀V)).differentiableAt (by simp)
  obtain ⟨L, hLdef⟩ : ∃ L : E2 →L[ℝ] ℝ, L = fderiv ℝ φ x₀ := ⟨_, rfl⟩
  obtain ⟨B, hBdef⟩ : ∃ B : E2 →L[ℝ] E2 →L[ℝ] ℝ, B = fderiv ℝ (fderiv ℝ φ) x₀ := ⟨_, rfl⟩
  
  have hsymm : ∀ v w : E2, B v w = B w v := by
    intro v w
    rw [hBdef]
    exact hφa.isSymmSndFDerivAt (by
      simp [minSmoothness_of_isRCLikeNormedField]
      first
        | exact_mod_cast (le_top : (2 : ℕ∞) ≤ ⊤)
        | exact WithTop.coe_le_coe.mpr le_top
        | decide) v w
  
  have hX : ∀ k l : Fin 2, pd2 k (pd2 l φ) x₀ = B (e2 k) (e2 l) := by
    intro k l
    have h := fderiv_clm_apply hdφ' (differentiableAt_const (e2 l))
    show fderiv ℝ (fun y => fderiv ℝ φ y (e2 l)) x₀ (e2 k) = _
    rw [h]
    simp [hBdef]
  
  have hrep : ∀ y, pcgbTay2 φ x₀ y =
      φ y - (φ x₀ + L (y - x₀) + (1 / 2 : ℝ) * B (y - x₀) (y - x₀)) := by
    intro y
    have hu : y - x₀ = (y - x₀) 0 • e2 0 + (y - x₀) 1 • e2 1 := by
      ext i; fin_cases i <;> simp [EuclideanSpace.single_apply]
    have hLu : L (y - x₀) = (y - x₀) 0 * L (e2 0) + (y - x₀) 1 * L (e2 1) := by
      conv_lhs => rw [hu]
      simp
    have hBu : B (y - x₀) (y - x₀) =
        (y - x₀) 0 * (y - x₀) 0 * B (e2 0) (e2 0) + (y - x₀) 0 * (y - x₀) 1 * B (e2 0) (e2 1) +
        (y - x₀) 1 * (y - x₀) 0 * B (e2 1) (e2 0) + (y - x₀) 1 * (y - x₀) 1 * B (e2 1) (e2 1) := by
      conv_lhs => rw [hu]
      simp
      ring
    unfold pcgbTay2
    simp only [hX, Fin.sum_univ_two]
    rw [hLu, hBu]
    simp only [pd2, ← hLdef]
    ring
  set τ := pcgbTay2 φ x₀ with hτdef
  have hτfun : τ = fun y => φ y - (φ x₀ + L (y - x₀) + (1 / 2 : ℝ) * B (y - x₀) (y - x₀)) :=
    funext hrep
  have hlin : ∀ y, HasFDerivAt (fun y : E2 => y - x₀) (ContinuousLinearMap.id ℝ E2) y :=
    fun y => (hasFDerivAt_id y).sub_const x₀
  have hBlin : ∀ y, HasFDerivAt (fun y : E2 => B (y - x₀)) B y := fun y =>
    (B.hasFDerivAt.comp y (hlin y)).congr_fderiv (by simp)
  have hτd : ∀ y ∈ V, HasFDerivAt τ (fderiv ℝ φ y - L - B (y - x₀)) y := by
    intro y hy
    have hφd : DifferentiableAt ℝ φ y :=
      (hφ.contDiffAt (hV.mem_nhds hy)).differentiableAt (by simp)
    have h1 := hφd.hasFDerivAt
    have h2 := L.hasFDerivAt.comp y (hlin y)
    have h3 := (hBlin y).clm_apply (hlin y)
    have h4 := h1.sub (((hasFDerivAt_const (φ x₀) y).add h2).add (h3.const_mul (1 / 2 : ℝ)))
    rw [hτfun]
    refine h4.congr_fderiv ?_
    ext v
    have hs := hsymm v (y - x₀)
    simp at hs ⊢
    linarith
  have hfτ : ∀ z ∈ V, fderiv ℝ τ z = fderiv ℝ φ z - L - B (z - x₀) :=
    fun z hz => (hτd z hz).fderiv
  have hD1s : ContDiffOn ℝ ∞ (fun z => fderiv ℝ φ z - L - B (z - x₀)) V :=
    (hφ'.sub contDiffOn_const).sub
      ((B.contDiff.comp (contDiff_id.sub contDiff_const)).contDiffOn)
  have hτ' : ContDiffOn ℝ ∞ (fderiv ℝ τ) V := hD1s.congr hfτ
  have hτ'' : ContDiffOn ℝ ∞ (fderiv ℝ (fderiv ℝ τ)) V := hτ'.fderiv_of_isOpen hV le_rfl
  have hcont : ContinuousOn (fderiv ℝ (fderiv ℝ (fderiv ℝ τ))) V :=
    hτ''.continuousOn_fderiv_of_isOpen hV (by simp)
  have hd0 : ∀ z ∈ V, DifferentiableAt ℝ τ z := fun z hz => (hτd z hz).differentiableAt
  have hd1 : ∀ z ∈ V, DifferentiableAt ℝ (fderiv ℝ τ) z := fun z hz =>
    (hτ'.contDiffAt (hV.mem_nhds hz)).differentiableAt (by simp)
  have hd2 : ∀ z ∈ V, DifferentiableAt ℝ (fderiv ℝ (fderiv ℝ τ)) z := fun z hz =>
    (hτ''.contDiffAt (hV.mem_nhds hz)).differentiableAt (by simp)
  
  have h0 : τ x₀ = 0 := by rw [hrep]; simp
  have h1 : fderiv ℝ τ x₀ = 0 := by rw [hfτ x₀ hx₀V, hLdef]; simp
  have h2 : fderiv ℝ (fderiv ℝ τ) x₀ = 0 := by
    have hev : fderiv ℝ τ =ᶠ[𝓝 x₀] (fun z => fderiv ℝ φ z - L - B (z - x₀)) :=
      Filter.eventually_of_mem (hV.mem_nhds hx₀V) hfτ
    rw [hev.fderiv_eq]
    have hD : HasFDerivAt (fun z => fderiv ℝ φ z - L - B (z - x₀))
        (fderiv ℝ (fderiv ℝ φ) x₀ - 0 - B) x₀ :=
      (hdφ'.hasFDerivAt.sub (hasFDerivAt_const L x₀)).sub (hBlin x₀)
    rw [hD.fderiv, hBdef]
    simp
  
  obtain ⟨B₀, hB₀⟩ := (isCompact_closedBall x₀ R).exists_bound_of_continuousOn
    ((hτ''.continuousOn_fderiv_of_isOpen hV (by simp)).mono hball)
  refine ⟨max B₀ 0, le_max_right _ _, ?_⟩
  have hK0 : 0 ≤ max B₀ 0 := le_max_right _ _
  have hL2 : ∀ y ∈ Metric.closedBall x₀ R,
      ‖fderiv ℝ (fderiv ℝ τ) y‖ ≤ max B₀ 0 * dist y x₀ := by
    intro y hy
    have := (convex_closedBall x₀ R).norm_image_sub_le_of_norm_fderiv_le
      (fun z hz => hd2 z (hball hz)) (fun z hz => (hB₀ z hz).trans (le_max_left B₀ 0))
      (Metric.mem_closedBall_self hR.le) hy
    rwa [h2, sub_zero, ← dist_eq_norm] at this
  intro x hx
  have hs0 : 0 ≤ dist x x₀ := dist_nonneg
  have hsR : dist x x₀ ≤ R := Metric.mem_closedBall.mp hx
  have hSB : Metric.closedBall x₀ (dist x x₀) ⊆ Metric.closedBall x₀ R :=
    Metric.closedBall_subset_closedBall hsR
  have hxS : x ∈ Metric.closedBall x₀ (dist x x₀) := Metric.mem_closedBall.mpr le_rfl
  have hx₀S : x₀ ∈ Metric.closedBall x₀ (dist x x₀) := Metric.mem_closedBall_self hs0
  have hL1 : ∀ y ∈ Metric.closedBall x₀ (dist x x₀),
      ‖fderiv ℝ τ y‖ ≤ max B₀ 0 * dist x x₀ * dist x x₀ := by
    intro y hy
    have hb : ∀ z ∈ Metric.closedBall x₀ (dist x x₀),
        ‖fderiv ℝ (fderiv ℝ τ) z‖ ≤ max B₀ 0 * dist x x₀ := fun z hz =>
      (hL2 z (hSB hz)).trans (mul_le_mul_of_nonneg_left (Metric.mem_closedBall.mp hz) hK0)
    have := (convex_closedBall x₀ (dist x x₀)).norm_image_sub_le_of_norm_fderiv_le
      (fun z hz => hd1 z (hball (hSB hz))) hb hx₀S hy
    rw [h1, sub_zero, ← dist_eq_norm] at this
    exact this.trans
      (mul_le_mul_of_nonneg_left (Metric.mem_closedBall.mp hy) (mul_nonneg hK0 hs0))
  have h0b := (convex_closedBall x₀ (dist x x₀)).norm_image_sub_le_of_norm_fderiv_le
    (fun z hz => hd0 z (hball (hSB hz))) hL1 hx₀S hxS
  rw [h0, sub_zero, ← dist_eq_norm, Real.norm_eq_abs] at h0b
  refine ⟨?_, ?_, hL2 x hx⟩
  · calc |τ x| ≤ max B₀ 0 * dist x x₀ * dist x x₀ * dist x x₀ := h0b
      _ = max B₀ 0 * dist x x₀ ^ 3 := by ring
  · calc ‖fderiv ℝ τ x‖ ≤ max B₀ 0 * dist x x₀ * dist x x₀ := hL1 x hxS
      _ = max B₀ 0 * dist x x₀ ^ 2 := by ring

theorem pcgb_form_pd2 (x₀ x : E2) (p : Fin 2) (L : Fin 2 → ℝ) (B : Fin 2 → Fin 2 → ℝ)
    (T : Fin 2 → Fin 2 → Fin 2 → ℝ) (U : Fin 2 → Fin 2 → Fin 2 → Fin 2 → ℝ) :
    pd2 p (fun y => ∑ a : Fin 2, L a * (y - x₀) a) x = L p ∧
    pd2 p (fun y => ∑ a : Fin 2, ∑ b : Fin 2, B a b * (y - x₀) a * (y - x₀) b) x =
      ∑ b : Fin 2, (B p b + B b p) * (x - x₀) b ∧
    pd2 p (fun y => ∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2,
        T a b c * (y - x₀) a * (y - x₀) b * (y - x₀) c) x =
      ∑ b : Fin 2, ∑ c : Fin 2, (T p b c + T b p c + T b c p) * (x - x₀) b * (x - x₀) c ∧
    pd2 p (fun y => ∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
        U a b c d * (y - x₀) a * (y - x₀) b * (y - x₀) c * (y - x₀) d) x =
      ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
        (U p b c d + U b p c d + U b c p d + U b c d p) * (x - x₀) b * (x - x₀) c * (x - x₀) d ∧
    ContDiff ℝ ∞ (fun y => ∑ a : Fin 2, L a * (y - x₀) a) ∧
    ContDiff ℝ ∞ (fun y => ∑ a : Fin 2, ∑ b : Fin 2, B a b * (y - x₀) a * (y - x₀) b) ∧
    ContDiff ℝ ∞ (fun y => ∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2,
        T a b c * (y - x₀) a * (y - x₀) b * (y - x₀) c) ∧
    ContDiff ℝ ∞ (fun y => ∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
        U a b c d * (y - x₀) a * (y - x₀) b * (y - x₀) c * (y - x₀) d) :=
by
  have hz : ∀ a : Fin 2, pd2 p (fun y : E2 => (y - x₀) a) x = if a = p then 1 else 0 := by
    intro a
    have h := (PiLp.hasFDerivAt_apply (𝕜 := ℝ) 2 (x - x₀) a).comp x
      ((hasFDerivAt_id x).sub_const x₀)
    unfold pd2
    rw [show (fun y : E2 => (y - x₀) a) = ((fun f : E2 => f.ofLp a) ∘ fun y : E2 => id y - x₀)
      from rfl, h.fderiv]
    simp [EuclideanSpace.single_apply]
  have hK : ∀ c : ℝ, pd2 p (fun _ : E2 => c) x = 0 := by
    intro c; unfold pd2; simp
  have hP : ∀ f g : E2 → ℝ, DifferentiableAt ℝ f x → DifferentiableAt ℝ g x →
      pd2 p (fun y => f y * g y) x = f x * pd2 p g x + g x * pd2 p f x := by
    intro f g hf hg; unfold pd2; rw [fderiv_fun_mul hf hg]; simp
  have hS : ∀ F : Fin 2 → E2 → ℝ, (∀ i, DifferentiableAt ℝ (F i) x) →
      pd2 p (fun y => ∑ i : Fin 2, F i y) x = ∑ i : Fin 2, pd2 p (F i) x := by
    intro F hF; unfold pd2
    rw [fderiv_fun_sum (fun i _ => hF i)]
    simp
  refine ⟨?_, ?_, ?_, ?_, by fun_prop, by fun_prop, by fun_prop, by fun_prop⟩
  · simp (disch := fun_prop) only [hS, hP, hK, hz]
    fin_cases p <;> simp [Fin.sum_univ_two]
  · simp (disch := fun_prop) only [hS, hP, hK, hz]
    fin_cases p <;> simp [Fin.sum_univ_two] <;> ring
  · simp (disch := fun_prop) only [hS, hP, hK, hz]
    fin_cases p <;> simp [Fin.sum_univ_two] <;> ring
  · simp (disch := fun_prop) only [hS, hP, hK, hz]
    fin_cases p <;> simp [Fin.sum_univ_two] <;> ring

theorem pcgb_px_coeff_bounds (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a c) W)
    (hpd : ∀ x ∈ W, (h x).PosDef) (x₀ : E2) (σ : ℝ) (hσ : 0 < σ)
    (hball : Metric.closedBall x₀ σ ⊆ W) :
    (∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y)⁻¹ i j) W) ∧
    (∀ k : Fin 2, ContDiffOn ℝ ∞
      (fun y => ∑ a : Fin 2, ∑ c : Fin 2, (h y)⁻¹ a c * christoffel2 h k a c y) W) ∧
    ∃ B : ℝ, 0 ≤ B ∧ ∀ y ∈ Metric.closedBall x₀ σ, ∀ i j k : Fin 2,
      |(h y)⁻¹ i j - (h x₀)⁻¹ i j| ≤ B * dist y x₀ ∧
      ‖fderiv ℝ (fun z => (h z)⁻¹ i j) y‖ ≤ B ∧
      |∑ a : Fin 2, ∑ c : Fin 2, (h y)⁻¹ a c * christoffel2 h k a c y| ≤ B ∧
      ‖fderiv ℝ (fun z => ∑ a : Fin 2, ∑ c : Fin 2, (h z)⁻¹ a c * christoffel2 h k a c z) y‖ ≤ B :=
by
  have hinf : ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f W → ∀ c : Fin 2, ContDiffOn ℝ ∞ (pd2 c f) W := by
    intro f hf c
    have hfd : ContDiffOn ℝ ∞ (fun y => fderiv ℝ f y) W :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hW).1 hf).2
    exact hfd.clm_apply contDiffOn_const
  have hdet : ∀ y ∈ W, (h y).det ≠ 0 := fun y hy => (hpd y hy).det_pos.ne'
  have hdetS : ContDiffOn ℝ ∞ (fun y => (h y).det) W := by
    have heq : (fun y => (h y).det) = fun y => h y 0 0 * h y 1 1 - h y 0 1 * h y 1 0 := by
      funext y
      exact Matrix.det_fin_two (h y)
    rw [heq]
    exact ((hh 0 0).mul (hh 1 1)).sub ((hh 0 1).mul (hh 1 0))
  have hadj : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y).adjugate i j) W := by
    intro i j
    fin_cases i <;> fin_cases j <;> simp [Matrix.adjugate_fin_two] <;>
      first | exact hh _ _ | exact (hh _ _).neg
  have hinv : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y)⁻¹ i j) W := by
    intro i j
    have heq : (fun y => (h y)⁻¹ i j) = fun y => ((h y).det)⁻¹ * (h y).adjugate i j := by
      funext y
      rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
    rw [heq]
    exact (hdetS.inv hdet).mul (hadj i j)
  have hchr : ∀ k i j : Fin 2, ContDiffOn ℝ ∞ (christoffel2 h k i j) W := by
    intro k i j
    show ContDiffOn ℝ ∞ (fun x => (1 / 2 : ℝ) * ∑ l : Fin 2, (h x)⁻¹ k l *
      (pd2 i (fun z => h z j l) x + pd2 j (fun z => h z i l) x - pd2 l (fun z => h z i j) x)) W
    exact contDiffOn_const.mul (ContDiffOn.sum fun l _ => (hinv k l).mul
      (((hinf _ (hh j l) i).add (hinf _ (hh i l) j)).sub (hinf _ (hh i j) l)))
  have hgam : ∀ k : Fin 2, ContDiffOn ℝ ∞
      (fun y => ∑ a : Fin 2, ∑ c : Fin 2, (h y)⁻¹ a c * christoffel2 h k a c y) W :=
    fun k => ContDiffOn.sum fun a _ => ContDiffOn.sum fun c _ => (hinv a c).mul (hchr k a c)
  
  have hC1 : ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f W → ∃ B : ℝ, 0 ≤ B ∧
      ∀ y ∈ Metric.closedBall x₀ σ,
        |f y - f x₀| ≤ B * dist y x₀ ∧ |f y| ≤ B ∧ ‖fderiv ℝ f y‖ ≤ B := by
    intro f hf
    have hK := isCompact_closedBall x₀ σ
    have hfc : ContinuousOn f (Metric.closedBall x₀ σ) := hf.continuousOn.mono hball
    have hdc : ContinuousOn (fderiv ℝ f) (Metric.closedBall x₀ σ) :=
      (hf.continuousOn_fderiv_of_isOpen hW (by simp)).mono hball
    obtain ⟨C₀, hC₀⟩ := hK.exists_bound_of_continuousOn hfc
    obtain ⟨C₁, hC₁⟩ := hK.exists_bound_of_continuousOn hdc
    have hdiff : ∀ z ∈ Metric.closedBall x₀ σ, DifferentiableAt ℝ f z := fun z hz =>
      (hf.contDiffAt (hW.mem_nhds (hball hz))).differentiableAt (by simp)
    refine ⟨|C₀| + |C₁|, by positivity, fun y hy => ?_⟩
    have hx₀ : x₀ ∈ Metric.closedBall x₀ σ :=
      Metric.mem_closedBall_self (dist_nonneg.trans (Metric.mem_closedBall.mp hy))
    have hd' : ∀ z ∈ Metric.closedBall x₀ σ, ‖fderiv ℝ f z‖ ≤ |C₀| + |C₁| := fun z hz =>
      (hC₁ z hz).trans ((le_abs_self C₁).trans (le_add_of_nonneg_left (abs_nonneg _)))
    have hmv := (convex_closedBall x₀ σ).norm_image_sub_le_of_norm_fderiv_le hdiff hd' hx₀ hy
    refine ⟨?_, ?_, hd' y hy⟩
    · rw [← Real.norm_eq_abs, dist_eq_norm]
      exact hmv
    · rw [← Real.norm_eq_abs]
      exact (hC₀ y hy).trans ((le_abs_self C₀).trans (le_add_of_nonneg_right (abs_nonneg _)))
  refine ⟨hinv, hgam, ?_⟩
  choose BG hBG0 hBG using fun i j => hC1 _ (hinv i j)
  choose Bγ hBγ0 hBγ using fun k => hC1 _ (hgam k)
  have h00 := hBG0 0 0
  have h01 := hBG0 0 1
  have h10 := hBG0 1 0
  have h11 := hBG0 1 1
  have hg0 := hBγ0 0
  have hg1 := hBγ0 1
  have hBGle : ∀ i j : Fin 2, BG i j ≤ BG 0 0 + BG 0 1 + BG 1 0 + BG 1 1 + Bγ 0 + Bγ 1 := by
    simp only [Fin.forall_fin_two]
    refine ⟨⟨?_, ?_⟩, ?_, ?_⟩ <;> linarith
  have hγle : ∀ k : Fin 2, Bγ k ≤ BG 0 0 + BG 0 1 + BG 1 0 + BG 1 1 + Bγ 0 + Bγ 1 := by
    simp only [Fin.forall_fin_two]
    refine ⟨?_, ?_⟩ <;> linarith
  refine ⟨BG 0 0 + BG 0 1 + BG 1 0 + BG 1 1 + Bγ 0 + Bγ 1, by linarith, ?_⟩
  intro y hy i j k
  obtain ⟨g1, -, g3⟩ := hBG i j y hy
  obtain ⟨-, c2, c3⟩ := hBγ k y hy
  refine ⟨?_, ?_, ?_, ?_⟩
  · exact g1.trans (mul_le_mul_of_nonneg_right (hBGle i j) dist_nonneg)
  · exact g3.trans (hBGle i j)
  · exact c2.trans (hγle k)
  · exact c3.trans (hγle k)

theorem pcgb_jet_eikonal_bound (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a c) W)
    (hpd : ∀ x ∈ W, (h x).PosDef) (x₀ : E2) (R₀ : ℝ) (hR₀ : 0 < R₀)
    (hball : Metric.closedBall x₀ R₀ ⊆ W) :
    ∃ K : ℝ, 0 ≤ K ∧ ∀ x : E2, dist x x₀ < min R₀ 1 →
      |pcgbPxEik h (pcgbJetD h x₀) x| ≤ K * dist x x₀ ^ 5 ∧
      ‖fderiv ℝ (pcgbPxEik h (pcgbJetD h x₀)) x‖ ≤ K * dist x x₀ ^ 4 :=
by
  classical
  have hx₀W : x₀ ∈ W := hball (Metric.mem_closedBall_self hR₀.le)
  have hH : (h x₀).PosDef := hpd x₀ hx₀W
  have hHs : ∀ a c : Fin 2, h x₀ a c = h x₀ c a := by
    intro a c
    have := hH.isHermitian.apply a c
    rw [star_trivial] at this
    exact this.symm
  have hdet : (h x₀).det ≠ 0 := hH.det_pos.ne'
  obtain ⟨σ, hσdef⟩ : ∃ σ : ℝ, σ = min R₀ 1 := ⟨_, rfl⟩
  have hσR : σ ≤ R₀ := by rw [hσdef]; exact min_le_left _ _
  have hσ1 : σ ≤ 1 := by rw [hσdef]; exact min_le_right _ _
  
  have ord_congr : ∀ (n : ℕ) (u v : E2 → ℝ), (∀ y, u y = v y) → pcgbOrd x₀ σ n v →
      pcgbOrd x₀ σ n u := by
    intro n u v huv hv
    rw [show u = v from funext huv]
    exact hv
  have ord_coord : ∀ k : Fin 2, pcgbOrd x₀ σ 1 (fun y => (y - x₀) k) := by
    intro k
    have hfun : (fun y : E2 => (y - x₀) k) = fun y =>
        (EuclideanSpace.proj k : E2 →L[ℝ] ℝ) y - (EuclideanSpace.proj k : E2 →L[ℝ] ℝ) x₀ := by
      funext y; simp
    have hD : ∀ x : E2, HasFDerivAt (fun y : E2 => (y - x₀) k)
        (EuclideanSpace.proj k : E2 →L[ℝ] ℝ) x := by
      intro x
      rw [hfun]
      exact (EuclideanSpace.proj k : E2 →L[ℝ] ℝ).hasFDerivAt.sub_const _
    refine ⟨1, zero_le_one, fun x _ => ⟨(hD x).differentiableAt, ?_, ?_⟩⟩
    · show |(x - x₀) k| ≤ 1 * dist x x₀ ^ 1
      rw [pow_one, one_mul, dist_eq_norm]
      calc |(x - x₀) k| = ‖(x - x₀) k‖ := (Real.norm_eq_abs _).symm
        _ ≤ ‖x - x₀‖ := PiLp.norm_apply_le _ k
    · rw [(hD x).fderiv]
      simp only [Nat.sub_self, pow_zero, one_mul]
      refine ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun v => ?_)
      rw [one_mul]
      exact PiLp.norm_apply_le v k
  have ord_add : ∀ (n : ℕ) (u v : E2 → ℝ), pcgbOrd x₀ σ n u → pcgbOrd x₀ σ n v →
      pcgbOrd x₀ σ n (fun y => u y + v y) := by
    rintro n u v ⟨c1, hc1, h1⟩ ⟨c2, hc2, h2⟩
    refine ⟨c1 + c2, add_nonneg hc1 hc2, fun x hx => ?_⟩
    obtain ⟨d1, a1, b1⟩ := h1 x hx
    obtain ⟨d2, a2, b2⟩ := h2 x hx
    show DifferentiableAt ℝ (fun y => u y + v y) x ∧ |u x + v x| ≤ (c1 + c2) * dist x x₀ ^ n ∧
      ‖fderiv ℝ (fun y => u y + v y) x‖ ≤ (c1 + c2) * dist x x₀ ^ (n - 1)
    refine ⟨d1.add d2, ?_, ?_⟩
    · calc |u x + v x| ≤ |u x| + |v x| := abs_add_le _ _
        _ ≤ c1 * dist x x₀ ^ n + c2 * dist x x₀ ^ n := add_le_add a1 a2
        _ = (c1 + c2) * dist x x₀ ^ n := by ring
    · rw [fderiv_fun_add d1 d2]
      calc ‖fderiv ℝ u x + fderiv ℝ v x‖ ≤ ‖fderiv ℝ u x‖ + ‖fderiv ℝ v x‖ := norm_add_le _ _
        _ ≤ c1 * dist x x₀ ^ (n - 1) + c2 * dist x x₀ ^ (n - 1) := add_le_add b1 b2
        _ = (c1 + c2) * dist x x₀ ^ (n - 1) := by ring
  have ord_smul : ∀ (n : ℕ) (a : ℝ) (u : E2 → ℝ), pcgbOrd x₀ σ n u →
      pcgbOrd x₀ σ n (fun y => a * u y) := by
    rintro n a u ⟨c, hc, hu⟩
    refine ⟨|a| * c, mul_nonneg (abs_nonneg a) hc, fun x hx => ?_⟩
    obtain ⟨d, h1, h2⟩ := hu x hx
    show DifferentiableAt ℝ (fun y => a * u y) x ∧ |a * u x| ≤ |a| * c * dist x x₀ ^ n ∧
      ‖fderiv ℝ (fun y => a * u y) x‖ ≤ |a| * c * dist x x₀ ^ (n - 1)
    refine ⟨d.const_mul a, ?_, ?_⟩
    · rw [abs_mul, mul_assoc]
      exact mul_le_mul_of_nonneg_left h1 (abs_nonneg a)
    · rw [fderiv_const_mul d a, norm_smul, Real.norm_eq_abs, mul_assoc]
      exact mul_le_mul_of_nonneg_left h2 (abs_nonneg a)
  have ord_sum : ∀ (n : ℕ) (w : Fin 2 → E2 → ℝ), (∀ i, pcgbOrd x₀ σ n (w i)) →
      pcgbOrd x₀ σ n (fun y => ∑ i : Fin 2, w i y) := by
    intro n w hw
    have hfun : (fun y => ∑ i : Fin 2, w i y) = fun y => w 0 y + w 1 y := by
      funext y; exact Fin.sum_univ_two _
    rw [hfun]
    exact ord_add n _ _ (hw 0) (hw 1)
  have ord_mul : ∀ (m n k : ℕ) (u v : E2 → ℝ), m + n = k → pcgbOrd x₀ σ m u →
      pcgbOrd x₀ σ n v → pcgbOrd x₀ σ k (fun y => u y * v y) := by
    rintro m n k u v rfl ⟨c1, hc1, h1⟩ ⟨c2, hc2, h2⟩
    refine ⟨2 * c1 * c2, mul_nonneg (mul_nonneg zero_le_two hc1) hc2, fun x hx => ?_⟩
    obtain ⟨d1, a1, b1⟩ := h1 x hx
    obtain ⟨d2, a2, b2⟩ := h2 x hx
    have hs0 : 0 ≤ dist x x₀ := dist_nonneg
    have hs1 : dist x x₀ ≤ 1 := (hx.trans_le hσ1).le
    have hc12 : 0 ≤ c1 * c2 := mul_nonneg hc1 hc2
    show DifferentiableAt ℝ (fun y => u y * v y) x ∧
      |u x * v x| ≤ 2 * c1 * c2 * dist x x₀ ^ (m + n) ∧
      ‖fderiv ℝ (fun y => u y * v y) x‖ ≤ 2 * c1 * c2 * dist x x₀ ^ (m + n - 1)
    refine ⟨d1.mul d2, ?_, ?_⟩
    · rw [abs_mul]
      have hp : 0 ≤ dist x x₀ ^ (m + n) := pow_nonneg hs0 _
      calc |u x| * |v x| ≤ (c1 * dist x x₀ ^ m) * (c2 * dist x x₀ ^ n) :=
            mul_le_mul a1 a2 (abs_nonneg _) (mul_nonneg hc1 (pow_nonneg hs0 _))
        _ = c1 * c2 * dist x x₀ ^ (m + n) := by rw [pow_add]; ring
        _ ≤ 2 * c1 * c2 * dist x x₀ ^ (m + n) := by nlinarith [mul_nonneg hc12 hp]
    · rw [fderiv_fun_mul d1 d2]
      have e1 : dist x x₀ ^ m * dist x x₀ ^ (n - 1) ≤ dist x x₀ ^ (m + n - 1) := by
        rw [← pow_add]; exact pow_le_pow_of_le_one hs0 hs1 (by omega)
      have e2 : dist x x₀ ^ n * dist x x₀ ^ (m - 1) ≤ dist x x₀ ^ (m + n - 1) := by
        rw [← pow_add]; exact pow_le_pow_of_le_one hs0 hs1 (by omega)
      have t1 : ‖u x • fderiv ℝ v x‖ ≤ (c1 * dist x x₀ ^ m) * (c2 * dist x x₀ ^ (n - 1)) := by
        rw [norm_smul, Real.norm_eq_abs]
        exact mul_le_mul a1 b2 (norm_nonneg _) (mul_nonneg hc1 (pow_nonneg hs0 _))
      have t2 : ‖v x • fderiv ℝ u x‖ ≤ (c2 * dist x x₀ ^ n) * (c1 * dist x x₀ ^ (m - 1)) := by
        rw [norm_smul, Real.norm_eq_abs]
        exact mul_le_mul a2 b1 (norm_nonneg _) (mul_nonneg hc2 (pow_nonneg hs0 _))
      calc ‖u x • fderiv ℝ v x + v x • fderiv ℝ u x‖
          ≤ ‖u x • fderiv ℝ v x‖ + ‖v x • fderiv ℝ u x‖ := norm_add_le _ _
        _ ≤ (c1 * dist x x₀ ^ m) * (c2 * dist x x₀ ^ (n - 1)) +
              (c2 * dist x x₀ ^ n) * (c1 * dist x x₀ ^ (m - 1)) := add_le_add t1 t2
        _ = c1 * c2 * (dist x x₀ ^ m * dist x x₀ ^ (n - 1)) +
              c1 * c2 * (dist x x₀ ^ n * dist x x₀ ^ (m - 1)) := by ring
        _ ≤ c1 * c2 * dist x x₀ ^ (m + n - 1) + c1 * c2 * dist x x₀ ^ (m + n - 1) :=
            add_le_add (mul_le_mul_of_nonneg_left e1 hc12) (mul_le_mul_of_nonneg_left e2 hc12)
        _ = 2 * c1 * c2 * dist x x₀ ^ (m + n - 1) := by ring
  have ord_mono : ∀ (m n : ℕ) (u : E2 → ℝ), m ≤ n → pcgbOrd x₀ σ n u → pcgbOrd x₀ σ m u := by
    rintro m n u hmn ⟨c, hc, hu⟩
    refine ⟨c, hc, fun x hx => ?_⟩
    obtain ⟨d, h1, h2⟩ := hu x hx
    have hs0 : 0 ≤ dist x x₀ := dist_nonneg
    have hs1 : dist x x₀ ≤ 1 := (hx.trans_le hσ1).le
    exact ⟨d, h1.trans (mul_le_mul_of_nonneg_left (pow_le_pow_of_le_one hs0 hs1 hmn) hc),
      h2.trans (mul_le_mul_of_nonneg_left (pow_le_pow_of_le_one hs0 hs1 (by omega)) hc)⟩
  have ord_mm : ∀ (m n k : ℕ) (u v : E2 → ℝ), k ≤ m + n → pcgbOrd x₀ σ m u →
      pcgbOrd x₀ σ n v → pcgbOrd x₀ σ k (fun y => u y * v y) := fun m n k u v hk hu hv =>
    ord_mono k (m + n) _ hk (ord_mul m n (m + n) u v rfl hu hv)
  
  have hv1 : ∀ (H : Matrix (Fin 2) (Fin 2) ℝ) (p : Fin 2),
      pcgbOrd x₀ σ 1 (fun y => pcgbJv1 H x₀ y p) := by
    intro H p
    show pcgbOrd x₀ σ 1 (fun y => ∑ b : Fin 2, (H p b + H b p) * (y - x₀) b)
    exact ord_sum 1 _ (fun b => ord_smul 1 _ _ (ord_coord b))
  have hv2 : ∀ (T : Fin 2 → Fin 2 → Fin 2 → ℝ) (p : Fin 2),
      pcgbOrd x₀ σ 2 (fun y => pcgbJv2 T x₀ y p) := by
    intro T p
    show pcgbOrd x₀ σ 2 (fun y => ∑ b : Fin 2, ∑ c : Fin 2,
      (T p b c + T b p c + T b c p) * (y - x₀) b * (y - x₀) c)
    exact ord_sum 2 _ (fun b => ord_sum 2 _ (fun c =>
      ord_mm 1 1 2 _ _ (by norm_num) (ord_smul 1 _ _ (ord_coord b)) (ord_coord c)))
  have hv3 : ∀ (U : Fin 2 → Fin 2 → Fin 2 → Fin 2 → ℝ) (p : Fin 2),
      pcgbOrd x₀ σ 3 (fun y => pcgbJv3 U x₀ y p) := by
    intro U p
    show pcgbOrd x₀ σ 3 (fun y => ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
      (U p b c d + U b p c d + U b c p d + U b c d p) * (y - x₀) b * (y - x₀) c * (y - x₀) d)
    exact ord_sum 3 _ (fun b => ord_sum 3 _ (fun c => ord_sum 3 _ (fun d =>
      ord_mm 2 1 3 _ _ (by norm_num)
        (ord_mm 1 1 2 _ _ (by norm_num) (ord_smul 1 _ _ (ord_coord b)) (ord_coord c))
        (ord_coord d))))
  have hA1 : ∀ (g1 : Fin 2 → Matrix (Fin 2) (Fin 2) ℝ) (p q : Fin 2),
      pcgbOrd x₀ σ 1 (fun y => pcgbJA1 g1 x₀ y p q) := by
    intro g1 p q
    show pcgbOrd x₀ σ 1 (fun y => ∑ k : Fin 2, g1 k p q * (y - x₀) k)
    exact ord_sum 1 _ (fun k => ord_smul 1 _ _ (ord_coord k))
  have hA2 : ∀ (g2 : Fin 2 → Fin 2 → Matrix (Fin 2) (Fin 2) ℝ) (p q : Fin 2),
      pcgbOrd x₀ σ 2 (fun y => pcgbJA2 g2 x₀ y p q) := by
    intro g2 p q
    show pcgbOrd x₀ σ 2 (fun y => (1 / 2 : ℝ) *
      ∑ k : Fin 2, ∑ l : Fin 2, g2 k l p q * (y - x₀) k * (y - x₀) l)
    exact ord_smul 2 _ _ (ord_sum 2 _ (fun k => ord_sum 2 _ (fun l =>
      ord_mm 1 1 2 _ _ (by norm_num) (ord_smul 1 _ _ (ord_coord k)) (ord_coord l))))
  have hw : ∀ (H : Matrix (Fin 2) (Fin 2) ℝ) (T : Fin 2 → Fin 2 → Fin 2 → ℝ)
      (U : Fin 2 → Fin 2 → Fin 2 → Fin 2 → ℝ) (p : Fin 2),
      pcgbOrd x₀ σ 1 (fun y => pcgbJv1 H x₀ y p + pcgbJv2 T x₀ y p + pcgbJv3 U x₀ y p) :=
    fun H T U p => ord_add 1 _ _ (ord_add 1 _ _ (hv1 H p) (ord_mono 1 2 _ (by norm_num) (hv2 T p)))
      (ord_mono 1 3 _ (by norm_num) (hv3 U p))
  have hE5gen : ∀ (Hi : Matrix (Fin 2) (Fin 2) ℝ) (A1 A2 : E2 → Fin 2 → Fin 2 → ℝ)
      (v1 v2 v3 : E2 → Fin 2 → ℝ),
      (∀ p q, pcgbOrd x₀ σ 1 (fun y => A1 y p q)) → (∀ p q, pcgbOrd x₀ σ 2 (fun y => A2 y p q)) →
      (∀ p, pcgbOrd x₀ σ 1 (fun y => v1 y p)) → (∀ p, pcgbOrd x₀ σ 2 (fun y => v2 y p)) →
      (∀ p, pcgbOrd x₀ σ 3 (fun y => v3 y p)) →
      pcgbOrd x₀ σ 5 (fun y => pcgbJE5 Hi (A1 y) (A2 y) (v1 y) (v2 y) (v3 y)) := by
    intro Hi A1 A2 v1 v2 v3 hB1 hB2 h1 h2 h3
    show pcgbOrd x₀ σ 5 (fun y => ∑ p : Fin 2, ∑ q : Fin 2,
      (Hi p q * (v2 y p * v3 y q + v3 y p * v2 y q + v3 y p * v3 y q)
        + A1 y p q * (v1 y p * v3 y q + v3 y p * v1 y q + v2 y p * v2 y q + v2 y p * v3 y q
            + v3 y p * v2 y q + v3 y p * v3 y q)
        + A2 y p q * (v1 y p * v2 y q + v2 y p * v1 y q + v1 y p * v3 y q + v3 y p * v1 y q
            + v2 y p * v2 y q + v2 y p * v3 y q + v3 y p * v2 y q + v3 y p * v3 y q)))
    refine ord_sum 5 _ (fun p => ord_sum 5 _ (fun q => ?_))
    refine ord_add 5 _ _ (ord_add 5 _ _ ?_ ?_) ?_
    · exact ord_smul 5 (Hi p q) _ (ord_add 5 _ _ (ord_add 5 _ _
        (ord_mm 2 3 5 _ _ (by norm_num) (h2 p) (h3 q))
        (ord_mm 3 2 5 _ _ (by norm_num) (h3 p) (h2 q)))
        (ord_mm 3 3 5 _ _ (by norm_num) (h3 p) (h3 q)))
    · exact ord_mm 1 4 5 _ _ (by norm_num) (hB1 p q)
        (ord_add 4 _ _ (ord_add 4 _ _ (ord_add 4 _ _ (ord_add 4 _ _ (ord_add 4 _ _
          (ord_mm 1 3 4 _ _ (by norm_num) (h1 p) (h3 q))
          (ord_mm 3 1 4 _ _ (by norm_num) (h3 p) (h1 q)))
          (ord_mm 2 2 4 _ _ (by norm_num) (h2 p) (h2 q)))
          (ord_mm 2 3 4 _ _ (by norm_num) (h2 p) (h3 q)))
          (ord_mm 3 2 4 _ _ (by norm_num) (h3 p) (h2 q)))
          (ord_mm 3 3 4 _ _ (by norm_num) (h3 p) (h3 q)))
    · exact ord_mm 2 3 5 _ _ (by norm_num) (hB2 p q)
        (ord_add 3 _ _ (ord_add 3 _ _ (ord_add 3 _ _ (ord_add 3 _ _ (ord_add 3 _ _
          (ord_add 3 _ _ (ord_add 3 _ _
          (ord_mm 1 2 3 _ _ (by norm_num) (h1 p) (h2 q))
          (ord_mm 2 1 3 _ _ (by norm_num) (h2 p) (h1 q)))
          (ord_mm 1 3 3 _ _ (by norm_num) (h1 p) (h3 q)))
          (ord_mm 3 1 3 _ _ (by norm_num) (h3 p) (h1 q)))
          (ord_mm 2 2 3 _ _ (by norm_num) (h2 p) (h2 q)))
          (ord_mm 2 3 3 _ _ (by norm_num) (h2 p) (h3 q)))
          (ord_mm 3 2 3 _ _ (by norm_num) (h3 p) (h2 q)))
          (ord_mm 3 3 3 _ _ (by norm_num) (h3 p) (h3 q)))
  
  obtain ⟨hinvS, -, -⟩ := pcgb_px_coeff_bounds W hW h hh hpd x₀ R₀ hR₀ hball
  have hτ : ∀ p q : Fin 2, pcgbOrd x₀ σ 3 (pcgbTay2 (fun y => (h y)⁻¹ p q) x₀) := by
    intro p q
    obtain ⟨K, hK, hb⟩ := pcgb_taylor2_remainder W hW _ (hinvS p q) x₀ R₀ hR₀ hball
    refine ⟨K, hK, fun x hx => ?_⟩
    have hxR : x ∈ Metric.closedBall x₀ R₀ :=
      Metric.mem_closedBall.mpr ((hx.trans_le hσR).le)
    have hxW : x ∈ W := hball hxR
    obtain ⟨e0, e1, -⟩ := hb x hxR
    refine ⟨?_, e0, e1⟩
    have hφd : DifferentiableAt ℝ (fun y => (h y)⁻¹ p q) x :=
      ((hinvS p q).contDiffAt (hW.mem_nhds hxW)).differentiableAt (by simp)
    obtain ⟨-, -, -, -, hLs, hBs, -, -⟩ := pcgb_form_pd2 x₀ x p
      (fun k => pd2 k (fun y => (h y)⁻¹ p q) x₀)
      (fun k l => pd2 k (pd2 l (fun y => (h y)⁻¹ p q)) x₀)
      (fun _ _ _ => 0) (fun _ _ _ _ => 0)
    have hd1 := (hLs.differentiable (by simp)) x
    have hd2 := (hBs.differentiable (by simp)) x
    show DifferentiableAt ℝ (fun y => (h y)⁻¹ p q - (h x₀)⁻¹ p q
      - ∑ k : Fin 2, pd2 k (fun y => (h y)⁻¹ p q) x₀ * (y - x₀) k
      - (1 / 2 : ℝ) * ∑ k : Fin 2, ∑ l : Fin 2,
          pd2 k (pd2 l (fun y => (h y)⁻¹ p q)) x₀ * (y - x₀) k * (y - x₀) l) x
    exact ((hφd.sub_const _).sub hd1).sub (hd2.const_mul (1 / 2 : ℝ))
  
  have hgrad : ∀ (a : Fin 2) (y : E2), pd2 a (pcgbJetD h x₀) y =
      pcgbJv1 (h x₀) x₀ y a + pcgbJv2 (pcgbJT (h x₀) (pcgbJg1 h x₀)) x₀ y a +
        pcgbJv3 (pcgbJU (h x₀) (pcgbJg1 h x₀) (pcgbJg2 h x₀)) x₀ y a := by
    intro a y
    obtain ⟨-, h2, h3, h4, -, hQs, hTs, hUs⟩ := pcgb_form_pd2 x₀ y a (fun _ => 0) (h x₀)
      (pcgbJT (h x₀) (pcgbJg1 h x₀)) (pcgbJU (h x₀) (pcgbJg1 h x₀) (pcgbJg2 h x₀))
    have hd1 := (hQs.differentiable (by simp)) y
    have hd2 := (hTs.differentiable (by simp)) y
    have hd3 := (hUs.differentiable (by simp)) y
    have hDdef : pcgbJetD h x₀ = fun y =>
        (∑ a : Fin 2, ∑ b : Fin 2, h x₀ a b * (y - x₀) a * (y - x₀) b) +
        (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2,
          pcgbJT (h x₀) (pcgbJg1 h x₀) a b c * (y - x₀) a * (y - x₀) b * (y - x₀) c) +
        (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
          pcgbJU (h x₀) (pcgbJg1 h x₀) (pcgbJg2 h x₀) a b c d *
            (y - x₀) a * (y - x₀) b * (y - x₀) c * (y - x₀) d) := rfl
    rw [hDdef]
    unfold pd2 at h2 h3 h4 ⊢
    have hd12 : DifferentiableAt ℝ (fun y =>
        (∑ a : Fin 2, ∑ b : Fin 2, h x₀ a b * (y - x₀) a * (y - x₀) b) +
        (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2,
          pcgbJT (h x₀) (pcgbJg1 h x₀) a b c * (y - x₀) a * (y - x₀) b * (y - x₀) c)) y :=
      hd1.add hd2
    rw [fderiv_fun_add hd12 hd3, fderiv_fun_add hd1 hd2, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.add_apply, h2, h3, h4]
    rfl
  have hsplit : ∀ (y : E2) (p q : Fin 2), (h y)⁻¹ p q = (h x₀)⁻¹ p q +
      pcgbJA1 (pcgbJg1 h x₀) x₀ y p q + pcgbJA2 (pcgbJg2 h x₀) x₀ y p q +
        pcgbTay2 (fun y => (h y)⁻¹ p q) x₀ y := by
    intro y p q
    simp only [pcgbTay2, pcgbJA1, pcgbJA2, pcgbJg1, pcgbJg2]
    ring
  
  have halg : ∀ (H : Matrix (Fin 2) (Fin 2) ℝ), (∀ a c : Fin 2, H a c = H c a) → H.det ≠ 0 →
      ∀ (g1 : Fin 2 → Matrix (Fin 2) (Fin 2) ℝ) (g2 : Fin 2 → Fin 2 → Matrix (Fin 2) (Fin 2) ℝ)
        (x : E2),
      ∑ p : Fin 2, ∑ q : Fin 2,
          (H⁻¹ p q + pcgbJA1 g1 x₀ x p q + pcgbJA2 g2 x₀ x p q) *
          (pcgbJv1 H x₀ x p + pcgbJv2 (pcgbJT H g1) x₀ x p + pcgbJv3 (pcgbJU H g1 g2) x₀ x p) *
          (pcgbJv1 H x₀ x q + pcgbJv2 (pcgbJT H g1) x₀ x q + pcgbJv3 (pcgbJU H g1 g2) x₀ x q)
        - 4 * pcgbJD H g1 g2 x₀ x =
      pcgbJE5 H⁻¹ (pcgbJA1 g1 x₀ x) (pcgbJA2 g2 x₀ x) (pcgbJv1 H x₀ x)
        (pcgbJv2 (pcgbJT H g1) x₀ x) (pcgbJv3 (pcgbJU H g1 g2) x₀ x) := by
    intro H hHs' hdet' g1 g2 x
    have hsym : H 1 0 = H 0 1 := hHs' 1 0
    have hu : IsUnit H.det := Ne.isUnit hdet'
    have hR1 := Matrix.mul_nonsing_inv H hu
    have hR2 := Matrix.nonsing_inv_mul H hu
    have n01 : (1 : Matrix (Fin 2) (Fin 2) ℝ) 0 1 = 0 :=
      Matrix.one_apply_ne (show (0 : Fin 2) ≠ 1 by decide)
    have n10 : (1 : Matrix (Fin 2) (Fin 2) ℝ) 1 0 = 0 :=
      Matrix.one_apply_ne (show (1 : Fin 2) ≠ 0 by decide)
    have r00 : H 0 0 * H⁻¹ 0 0 + H 0 1 * H⁻¹ 1 0 = 1 := by
      have := congrFun (congrFun hR1 0) 0
      rw [Matrix.mul_apply, Fin.sum_univ_two, Matrix.one_apply_eq] at this; exact this
    have r01 : H 0 0 * H⁻¹ 0 1 + H 0 1 * H⁻¹ 1 1 = 0 := by
      have := congrFun (congrFun hR1 0) 1
      rw [Matrix.mul_apply, Fin.sum_univ_two, n01] at this; exact this
    have r10 : H 0 1 * H⁻¹ 0 0 + H 1 1 * H⁻¹ 1 0 = 0 := by
      have := congrFun (congrFun hR1 1) 0
      rw [Matrix.mul_apply, Fin.sum_univ_two, n10, hsym] at this
      exact this
    have r11 : H 0 1 * H⁻¹ 0 1 + H 1 1 * H⁻¹ 1 1 = 1 := by
      have := congrFun (congrFun hR1 1) 1
      rw [Matrix.mul_apply, Fin.sum_univ_two, Matrix.one_apply_eq, hsym] at this; exact this
    have s00 : H⁻¹ 0 0 * H 0 0 + H⁻¹ 0 1 * H 0 1 = 1 := by
      have := congrFun (congrFun hR2 0) 0
      rw [Matrix.mul_apply, Fin.sum_univ_two, Matrix.one_apply_eq, hsym] at this; exact this
    have s01 : H⁻¹ 0 0 * H 0 1 + H⁻¹ 0 1 * H 1 1 = 0 := by
      have := congrFun (congrFun hR2 0) 1
      rw [Matrix.mul_apply, Fin.sum_univ_two, n01] at this; exact this
    have s10 : H⁻¹ 1 0 * H 0 0 + H⁻¹ 1 1 * H 0 1 = 0 := by
      have := congrFun (congrFun hR2 1) 0
      rw [Matrix.mul_apply, Fin.sum_univ_two, n10, hsym] at this
      exact this
    have s11 : H⁻¹ 1 0 * H 0 1 + H⁻¹ 1 1 * H 1 1 = 1 := by
      have := congrFun (congrFun hR2 1) 1
      rw [Matrix.mul_apply, Fin.sum_univ_two, Matrix.one_apply_eq] at this; exact this
    have F1L0 : pcgbJv1 H x₀ x 0 * H⁻¹ 0 0 + pcgbJv1 H x₀ x 1 * H⁻¹ 1 0 = 2 * (x - x₀) 0 := by
      simp only [pcgbJv1, Fin.sum_univ_two, hsym]
      linear_combination (2 * (x - x₀) 0) * r00 + (2 * (x - x₀) 1) * r10
    have F1L1 : pcgbJv1 H x₀ x 0 * H⁻¹ 0 1 + pcgbJv1 H x₀ x 1 * H⁻¹ 1 1 = 2 * (x - x₀) 1 := by
      simp only [pcgbJv1, Fin.sum_univ_two, hsym]
      linear_combination (2 * (x - x₀) 0) * r01 + (2 * (x - x₀) 1) * r11
    have F1R0 : H⁻¹ 0 0 * pcgbJv1 H x₀ x 0 + H⁻¹ 0 1 * pcgbJv1 H x₀ x 1 = 2 * (x - x₀) 0 := by
      simp only [pcgbJv1, Fin.sum_univ_two, hsym]
      linear_combination (2 * (x - x₀) 0) * s00 + (2 * (x - x₀) 1) * s01
    have F1R1 : H⁻¹ 1 0 * pcgbJv1 H x₀ x 0 + H⁻¹ 1 1 * pcgbJv1 H x₀ x 1 = 2 * (x - x₀) 1 := by
      simp only [pcgbJv1, Fin.sum_univ_two, hsym]
      linear_combination (2 * (x - x₀) 0) * s10 + (2 * (x - x₀) 1) * s11
    have Eu1 : (x - x₀) 0 * pcgbJv1 H x₀ x 0 + (x - x₀) 1 * pcgbJv1 H x₀ x 1 =
        2 * pcgbPxQuad H x₀ x := by
      simp only [pcgbJv1, pcgbPxQuad, Fin.sum_univ_two]; ring
    have Eu2 : (x - x₀) 0 * pcgbJv2 (pcgbJT H g1) x₀ x 0 +
        (x - x₀) 1 * pcgbJv2 (pcgbJT H g1) x₀ x 1 =
        3 * ∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2,
          pcgbJT H g1 a b c * (x - x₀) a * (x - x₀) b * (x - x₀) c := by
      simp only [pcgbJv2, Fin.sum_univ_two]; ring
    have Eu3 : (x - x₀) 0 * pcgbJv3 (pcgbJU H g1 g2) x₀ x 0 +
        (x - x₀) 1 * pcgbJv3 (pcgbJU H g1 g2) x₀ x 1 =
        4 * ∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
          pcgbJU H g1 g2 a b c d * (x - x₀) a * (x - x₀) b * (x - x₀) c * (x - x₀) d := by
      simp only [pcgbJv3, Fin.sum_univ_two]; ring
    have F3 : ∑ p : Fin 2, ∑ q : Fin 2,
        pcgbJA1 g1 x₀ x p q * pcgbJv1 H x₀ x p * pcgbJv1 H x₀ x q =
        -8 * ∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2,
          pcgbJT H g1 a b c * (x - x₀) a * (x - x₀) b * (x - x₀) c := by
      simp only [pcgbJA1, pcgbJv1, pcgbJT, Fin.sum_univ_two, hsym]; ring
    have hv2W : ∀ p : Fin 2, pcgbJv2 (pcgbJT H g1) x₀ x p =
        ∑ b : Fin 2, ∑ c : Fin 2, pcgbJW (pcgbJT H g1) p b c * (x - x₀) b * (x - x₀) c :=
      fun p => rfl
    have F4 : ∑ p : Fin 2, ∑ q : Fin 2,
        (H⁻¹ p q * pcgbJv2 (pcgbJT H g1) x₀ x p * pcgbJv2 (pcgbJT H g1) x₀ x q
          + pcgbJA1 g1 x₀ x p q * (pcgbJv1 H x₀ x p * pcgbJv2 (pcgbJT H g1) x₀ x q
              + pcgbJv2 (pcgbJT H g1) x₀ x p * pcgbJv1 H x₀ x q)
          + pcgbJA2 g2 x₀ x p q * pcgbJv1 H x₀ x p * pcgbJv1 H x₀ x q) =
        -12 * ∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
          pcgbJU H g1 g2 a b c d * (x - x₀) a * (x - x₀) b * (x - x₀) c * (x - x₀) d := by
      simp only [hv2W]
      simp only [pcgbJA1, pcgbJA2, pcgbJv1, pcgbJU, Fin.sum_univ_two, hsym]
      ring
    simp only [pcgbJE5, pcgbJD]
    simp only [Fin.sum_univ_two] at F3 F4 Eu2 Eu3 ⊢
    linear_combination
      (pcgbJv1 H x₀ x 0 + pcgbJv2 (pcgbJT H g1) x₀ x 0 + pcgbJv3 (pcgbJU H g1 g2) x₀ x 0) * F1L0 +
      (pcgbJv1 H x₀ x 1 + pcgbJv2 (pcgbJT H g1) x₀ x 1 + pcgbJv3 (pcgbJU H g1 g2) x₀ x 1) * F1L1 +
      (pcgbJv2 (pcgbJT H g1) x₀ x 0 + pcgbJv3 (pcgbJU H g1 g2) x₀ x 0) * F1R0 +
      (pcgbJv2 (pcgbJT H g1) x₀ x 1 + pcgbJv3 (pcgbJU H g1 g2) x₀ x 1) * F1R1 +
      2 * Eu1 + 4 * Eu2 + 4 * Eu3 + F3 + F4
  
  have hid : ∀ y : E2, pcgbPxEik h (pcgbJetD h x₀) y =
      pcgbJE5 (h x₀)⁻¹ (pcgbJA1 (pcgbJg1 h x₀) x₀ y) (pcgbJA2 (pcgbJg2 h x₀) x₀ y)
        (pcgbJv1 (h x₀) x₀ y) (pcgbJv2 (pcgbJT (h x₀) (pcgbJg1 h x₀)) x₀ y)
        (pcgbJv3 (pcgbJU (h x₀) (pcgbJg1 h x₀) (pcgbJg2 h x₀)) x₀ y) +
      ∑ p : Fin 2, ∑ q : Fin 2, pcgbTay2 (fun y => (h y)⁻¹ p q) x₀ y *
        (pcgbJv1 (h x₀) x₀ y p + pcgbJv2 (pcgbJT (h x₀) (pcgbJg1 h x₀)) x₀ y p +
          pcgbJv3 (pcgbJU (h x₀) (pcgbJg1 h x₀) (pcgbJg2 h x₀)) x₀ y p) *
        (pcgbJv1 (h x₀) x₀ y q + pcgbJv2 (pcgbJT (h x₀) (pcgbJg1 h x₀)) x₀ y q +
          pcgbJv3 (pcgbJU (h x₀) (pcgbJg1 h x₀) (pcgbJg2 h x₀)) x₀ y q) := by
    intro y
    have hal := halg (h x₀) hHs hdet (pcgbJg1 h x₀) (pcgbJg2 h x₀) y
    have t00 := hsplit y 0 0
    have t01 := hsplit y 0 1
    have t10 := hsplit y 1 0
    have t11 := hsplit y 1 1
    have hDy : pcgbJetD h x₀ y = pcgbJD (h x₀) (pcgbJg1 h x₀) (pcgbJg2 h x₀) x₀ y := rfl
    unfold pcgbPxEik
    simp only [Fin.sum_univ_two] at hal ⊢
    rw [← hgrad 0 y, ← hgrad 1 y] at hal
    rw [← hgrad 0 y, ← hgrad 1 y, hDy]
    linear_combination hal +
      pd2 0 (pcgbJetD h x₀) y * pd2 0 (pcgbJetD h x₀) y * t00 +
      pd2 0 (pcgbJetD h x₀) y * pd2 1 (pcgbJetD h x₀) y * t01 +
      pd2 1 (pcgbJetD h x₀) y * pd2 0 (pcgbJetD h x₀) y * t10 +
      pd2 1 (pcgbJetD h x₀) y * pd2 1 (pcgbJetD h x₀) y * t11
  
  have hfinal : pcgbOrd x₀ σ 5 (pcgbPxEik h (pcgbJetD h x₀)) := by
    refine ord_congr 5 _ _ hid ?_
    exact ord_add 5 _ _ (hE5gen _ _ _ _ _ _ (hA1 _) (hA2 _) (hv1 _) (hv2 _) (hv3 _))
      (ord_sum 5 _ fun p => ord_sum 5 _ fun q =>
        ord_mm 4 1 5 _ _ (by norm_num)
          (ord_mm 3 1 4 _ _ (by norm_num) (hτ p q) (hw _ _ _ p)) (hw _ _ _ q))
  obtain ⟨c, hc, hb⟩ := hfinal
  refine ⟨c, hc, fun x hx => ?_⟩
  obtain ⟨-, e1, e2⟩ := hb x (by rw [hσdef]; exact hx)
  exact ⟨e1, e2⟩

theorem pcgb_lap2_contDiffOn (V : Set E2) (hV : IsOpen V) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a c) V) (hpd : ∀ x ∈ V, (h x).PosDef)
    (u : E2 → ℝ) (hu : ContDiffOn ℝ ∞ u V) : ContDiffOn ℝ ∞ (lap2 h u) V :=
by
  have hinf : ∀ f : E2 → ℝ, ContDiffOn ℝ ∞ f V → ∀ c : Fin 2, ContDiffOn ℝ ∞ (pd2 c f) V := by
    intro f hf c
    have hfd : ContDiffOn ℝ ∞ (fun y => fderiv ℝ f y) V :=
      ((contDiffOn_infty_iff_fderiv_of_isOpen hV).1 hf).2
    exact hfd.clm_apply contDiffOn_const
  have hdet : ∀ y ∈ V, (h y).det ≠ 0 := fun y hy => (hpd y hy).det_pos.ne'
  have hdetS : ContDiffOn ℝ ∞ (fun y => (h y).det) V := by
    have heq : (fun y => (h y).det) = fun y => h y 0 0 * h y 1 1 - h y 0 1 * h y 1 0 := by
      funext y
      exact Matrix.det_fin_two (h y)
    rw [heq]
    exact ((hh 0 0).mul (hh 1 1)).sub ((hh 0 1).mul (hh 1 0))
  have hadj : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y).adjugate i j) V := by
    intro i j
    fin_cases i <;> fin_cases j <;> simp [Matrix.adjugate_fin_two] <;>
      first | exact hh _ _ | exact (hh _ _).neg
  have hinv : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y)⁻¹ i j) V := by
    intro i j
    have heq : (fun y => (h y)⁻¹ i j) = fun y => ((h y).det)⁻¹ * (h y).adjugate i j := by
      funext y
      rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
    rw [heq]
    exact (hdetS.inv hdet).mul (hadj i j)
  have hchr : ∀ k i j : Fin 2, ContDiffOn ℝ ∞ (christoffel2 h k i j) V := by
    intro k i j
    show ContDiffOn ℝ ∞ (fun x => (1 / 2 : ℝ) * ∑ l : Fin 2, (h x)⁻¹ k l *
      (pd2 i (fun z => h z j l) x + pd2 j (fun z => h z i l) x - pd2 l (fun z => h z i j) x)) V
    exact contDiffOn_const.mul (ContDiffOn.sum fun l _ => (hinv k l).mul
      (((hinf _ (hh j l) i).add (hinf _ (hh i l) j)).sub (hinf _ (hh i j) l)))
  have hpu : ∀ k : Fin 2, ContDiffOn ℝ ∞ (pd2 k u) V := fun k => hinf u hu k
  have hppu : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (pd2 i (pd2 j u)) V :=
    fun i j => hinf _ (hpu j) i
  show ContDiffOn ℝ ∞ (fun x => ∑ i : Fin 2, ∑ j : Fin 2, (h x)⁻¹ i j *
    (pd2 i (pd2 j u) x - ∑ k : Fin 2, christoffel2 h k i j x * pd2 k u x)) V
  exact ContDiffOn.sum fun i _ => ContDiffOn.sum fun j _ => (hinv i j).mul ((hppu i j).sub
    (ContDiffOn.sum fun k _ => (hchr k i j).mul (hpu k)))

theorem pcgb_jet_lap_bound (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a c) W)
    (hpd : ∀ x ∈ W, (h x).PosDef) (x₀ : E2) (R₀ : ℝ) (hR₀ : 0 < R₀)
    (hball : Metric.closedBall x₀ R₀ ⊆ W) :
    ∃ (M : Matrix (Fin 2) (Fin 2) ℝ) (K : ℝ), (∀ a c : Fin 2, M a c = M c a) ∧ 0 ≤ K ∧
      ∀ x : E2, dist x x₀ < min R₀ 1 →
        |lap2 h (pcgbJetD h x₀) x - 4 - pcgbPxQuad M x₀ x| ≤ K * dist x x₀ ^ 3 ∧
        ‖fderiv ℝ (fun y => lap2 h (pcgbJetD h x₀) y - 4 - pcgbPxQuad M x₀ y) x‖ ≤
          K * dist x x₀ ^ 2 :=
by
  
  have s3 : ∀ (H : Matrix (Fin 2) (Fin 2) ℝ) (g1 : Fin 2 → Matrix (Fin 2) (Fin 2) ℝ)
      (g2 : Fin 2 → Fin 2 → Matrix (Fin 2) (Fin 2) ℝ),
      ContDiff ℝ ∞ (pcgbJD H g1 g2 x₀) ∧ (∀ k : Fin 2, pd2 k (pcgbJD H g1 g2 x₀) x₀ = 0) ∧
      (∀ i j : Fin 2, pd2 i (pd2 j (pcgbJD H g1 g2 x₀)) x₀ = H j i + H i j) ∧
      (∀ m i j : Fin 2, pd2 m (pd2 i (pd2 j (pcgbJD H g1 g2 x₀))) x₀ =
        pcgbJW (pcgbJT H g1) j i m + pcgbJW (pcgbJT H g1) j m i) := by
    intro H g1 g2
    obtain ⟨-, -, -, -, -, hQs, hTs, hUs⟩ :=
      pcgb_form_pd2 x₀ x₀ 0 (fun _ => 0) H (pcgbJT H g1) (pcgbJU H g1 g2)
    have hDe : pcgbJD H g1 g2 x₀ = fun y =>
        (∑ a : Fin 2, ∑ b : Fin 2, H a b * (y - x₀) a * (y - x₀) b) +
        (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2,
          pcgbJT H g1 a b c * (y - x₀) a * (y - x₀) b * (y - x₀) c) +
        (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
          pcgbJU H g1 g2 a b c d * (y - x₀) a * (y - x₀) b * (y - x₀) c * (y - x₀) d) := rfl
    have hDs : ContDiff ℝ ∞ (pcgbJD H g1 g2 x₀) := by rw [hDe]; exact (hQs.add hTs).add hUs
    have h1 : ∀ j : Fin 2, pd2 j (pcgbJD H g1 g2 x₀) = fun y =>
        (∑ b : Fin 2, (H j b + H b j) * (y - x₀) b) +
        (∑ b : Fin 2, ∑ c : Fin 2, pcgbJW (pcgbJT H g1) j b c * (y - x₀) b * (y - x₀) c) +
        (∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
          pcgbJV (pcgbJU H g1 g2) j b c d * (y - x₀) b * (y - x₀) c * (y - x₀) d) := by
      intro j
      funext y
      obtain ⟨-, e2, e3, e4, -, -, -, -⟩ :=
        pcgb_form_pd2 x₀ y j (fun _ => 0) H (pcgbJT H g1) (pcgbJU H g1 g2)
      rw [hDe]
      unfold pd2 at e2 e3 e4 ⊢
      rw [fderiv_fun_add ((hQs.add hTs).differentiable (by simp) y)
          (hUs.differentiable (by simp) y),
        ContinuousLinearMap.add_apply,
        fderiv_fun_add (hQs.differentiable (by simp) y) (hTs.differentiable (by simp) y),
        ContinuousLinearMap.add_apply, e2, e3, e4]
      simp only [pcgbJW, pcgbJV]
    have h2 : ∀ i j : Fin 2, pd2 i (pd2 j (pcgbJD H g1 g2 x₀)) = fun y =>
        (H j i + H i j) +
        (∑ c : Fin 2, (pcgbJW (pcgbJT H g1) j i c + pcgbJW (pcgbJT H g1) j c i) * (y - x₀) c) +
        (∑ c : Fin 2, ∑ d : Fin 2, (pcgbJV (pcgbJU H g1 g2) j i c d +
          pcgbJV (pcgbJU H g1 g2) j c i d + pcgbJV (pcgbJU H g1 g2) j c d i) *
            (y - x₀) c * (y - x₀) d) := by
      intro i j
      rw [h1 j]
      funext y
      obtain ⟨e1, e2, e3, -, hLs, hBs, hTs', -⟩ :=
        pcgb_form_pd2 x₀ y i (fun b => H j b + H b j) (pcgbJW (pcgbJT H g1) j)
          (pcgbJV (pcgbJU H g1 g2) j) (fun _ _ _ _ => 0)
      unfold pd2 at e1 e2 e3 ⊢
      rw [fderiv_fun_add ((hLs.add hBs).differentiable (by simp) y)
          (hTs'.differentiable (by simp) y),
        ContinuousLinearMap.add_apply,
        fderiv_fun_add (hLs.differentiable (by simp) y) (hBs.differentiable (by simp) y),
        ContinuousLinearMap.add_apply, e1, e2, e3]
    have h3 : ∀ m i j : Fin 2, pd2 m (pd2 i (pd2 j (pcgbJD H g1 g2 x₀))) x₀ =
        pcgbJW (pcgbJT H g1) j i m + pcgbJW (pcgbJT H g1) j m i := by
      intro m i j
      rw [h2 i j]
      obtain ⟨e1, e2, -, -, hLs, hBs, -, -⟩ :=
        pcgb_form_pd2 x₀ x₀ m
          (fun c => pcgbJW (pcgbJT H g1) j i c + pcgbJW (pcgbJT H g1) j c i)
          (fun c d => pcgbJV (pcgbJU H g1 g2) j i c d + pcgbJV (pcgbJU H g1 g2) j c i d +
            pcgbJV (pcgbJU H g1 g2) j c d i) (fun _ _ _ => 0) (fun _ _ _ _ => 0)
      unfold pd2 at e1 e2 ⊢
      have hc : ContDiff ℝ ∞ (fun _ : E2 => H j i + H i j) := contDiff_const
      rw [fderiv_fun_add ((hc.add hLs).differentiable (by simp) x₀)
          (hBs.differentiable (by simp) x₀),
        ContinuousLinearMap.add_apply,
        fderiv_fun_add (differentiableAt_const _) (hLs.differentiable (by simp) x₀),
        ContinuousLinearMap.add_apply, e1, e2]
      simp
    refine ⟨hDs, fun k => ?_, fun i j => ?_, h3⟩
    · rw [h1 k]; simp
    · rw [h2 i j]; simp
  
  have hx₀ : x₀ ∈ W := hball (Metric.mem_closedBall_self hR₀.le)
  have hH : (h x₀).PosDef := hpd x₀ hx₀
  have hsymy : ∀ y ∈ W, ∀ r s : Fin 2, h y r s = h y s r := by
    intro y hy r s
    have := (hpd y hy).isHermitian.apply s r
    simpa using this
  have hsym10 : h x₀ 1 0 = h x₀ 0 1 := hsymy x₀ hx₀ 1 0
  have hdet2 : (h x₀).det = h x₀ 0 0 * h x₀ 1 1 - h x₀ 0 1 * h x₀ 0 1 := by
    rw [Matrix.det_fin_two, hsym10]
  have hdetne : h x₀ 0 0 * h x₀ 1 1 - h x₀ 0 1 * h x₀ 0 1 ≠ 0 := by
    rw [← hdet2]; exact hH.det_pos.ne'
  have hI00 : (h x₀)⁻¹ 0 0 = h x₀ 1 1 / (h x₀ 0 0 * h x₀ 1 1 - h x₀ 0 1 * h x₀ 0 1) := by
    rw [Matrix.inv_def, hdet2]; simp [Matrix.adjugate_fin_two, Ring.inverse_eq_inv, div_eq_inv_mul, hsym10]
  have hI01 : (h x₀)⁻¹ 0 1 = -h x₀ 0 1 / (h x₀ 0 0 * h x₀ 1 1 - h x₀ 0 1 * h x₀ 0 1) := by
    rw [Matrix.inv_def, hdet2]; simp [Matrix.adjugate_fin_two, Ring.inverse_eq_inv, div_eq_inv_mul, hsym10]
  have hI10 : (h x₀)⁻¹ 1 0 = -h x₀ 0 1 / (h x₀ 0 0 * h x₀ 1 1 - h x₀ 0 1 * h x₀ 0 1) := by
    rw [Matrix.inv_def, hdet2]; simp [Matrix.adjugate_fin_two, Ring.inverse_eq_inv, div_eq_inv_mul, hsym10]
  have hI11 : (h x₀)⁻¹ 1 1 = h x₀ 0 0 / (h x₀ 0 0 * h x₀ 1 1 - h x₀ 0 1 * h x₀ 0 1) := by
    rw [Matrix.inv_def, hdet2]; simp [Matrix.adjugate_fin_two, Ring.inverse_eq_inv, div_eq_inv_mul, hsym10]
  generalize hΔdef : h x₀ 0 0 * h x₀ 1 1 - h x₀ 0 1 * h x₀ 0 1 = Δ at hI00 hI01 hI10 hI11 hdetne
  have hHiH : ∀ p s : Fin 2, ∑ r : Fin 2, (h x₀)⁻¹ p r * h x₀ r s = if p = s then 1 else 0 := by
    intro p s
    have hm := Matrix.nonsing_inv_mul (h x₀) (isUnit_iff_ne_zero.mpr hH.det_pos.ne')
    have := congrFun (congrFun hm p) s
    rwa [Matrix.mul_apply, Matrix.one_apply] at this
  
  have hGs : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun y => (h y)⁻¹ i j) W :=
    (pcgb_px_coeff_bounds W hW h hh hpd x₀ R₀ hR₀ hball).1
  have dA : ∀ u : E2 → ℝ, ContDiffOn ℝ ∞ u W → DifferentiableAt ℝ u x₀ := fun u hu =>
    (hu.contDiffAt (hW.mem_nhds hx₀)).differentiableAt (by simp)
  have pdS : ∀ (j : Fin 2) (u : E2 → ℝ), ContDiffOn ℝ ∞ u W → ContDiffOn ℝ ∞ (pd2 j u) W := by
    intro j u hu
    show ContDiffOn ℝ ∞ (fun x => fderiv ℝ u x (e2 j)) W
    exact (hu.fderiv_of_isOpen hW le_rfl).clm_apply contDiffOn_const
  have pSub : ∀ (k : Fin 2) (u v : E2 → ℝ), DifferentiableAt ℝ u x₀ → DifferentiableAt ℝ v x₀ →
      pd2 k (fun y => u y - v y) x₀ = pd2 k u x₀ - pd2 k v x₀ := by
    intro k u v hu hv
    unfold pd2
    rw [fderiv_fun_sub hu hv, ContinuousLinearMap.sub_apply]
  have pMul : ∀ (k : Fin 2) (u v : E2 → ℝ), DifferentiableAt ℝ u x₀ → DifferentiableAt ℝ v x₀ →
      pd2 k (fun y => u y * v y) x₀ = u x₀ * pd2 k v x₀ + v x₀ * pd2 k u x₀ := by
    intro k u v hu hv
    unfold pd2
    rw [fderiv_fun_mul hu hv, ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul, smul_eq_mul]
  have pSum : ∀ (k : Fin 2) (F : Fin 2 → E2 → ℝ), (∀ i, DifferentiableAt ℝ (F i) x₀) →
      pd2 k (fun y => ∑ i : Fin 2, F i y) x₀ = ∑ i : Fin 2, pd2 k (F i) x₀ := by
    intro k F hF
    unfold pd2
    rw [fderiv_fun_sum (fun i _ => hF i), ContinuousLinearMap.sum_apply]
  have hΓs : ∀ k i j : Fin 2, ContDiffOn ℝ ∞ (christoffel2 h k i j) W := by
    intro k i j
    show ContDiffOn ℝ ∞ (fun x => (1 / 2 : ℝ) * ∑ l : Fin 2, (h x)⁻¹ k l *
      (pd2 i (fun z => h z j l) x + pd2 j (fun z => h z i l) x - pd2 l (fun z => h z i j) x)) W
    exact contDiffOn_const.mul (ContDiffOn.sum fun l _ => (hGs k l).mul
      (((pdS i _ (hh j l)).add (pdS j _ (hh i l))).sub (pdS l _ (hh i j))))
  
  have hAsym : ∀ k r s : Fin 2, pd2 k (fun y => h y r s) x₀ = pd2 k (fun y => h y s r) x₀ := by
    intro k r s
    have ev : (fun y => h y r s) =ᶠ[𝓝 x₀] (fun y => h y s r) :=
      Filter.eventually_of_mem (hW.mem_nhds hx₀) (fun y hy => hsymy y hy r s)
    unfold pd2
    rw [ev.fderiv_eq]
  have hE : ∀ k r q : Fin 2, ∑ s : Fin 2, (h x₀ r s * pd2 k (fun y => (h y)⁻¹ s q) x₀ +
      (h x₀)⁻¹ s q * pd2 k (fun y => h y r s) x₀) = 0 := by
    intro k r q
    have ev : (fun y => ∑ s : Fin 2, h y r s * (h y)⁻¹ s q) =ᶠ[𝓝 x₀]
        (fun _ => if r = q then (1 : ℝ) else 0) := by
      filter_upwards [hW.mem_nhds hx₀] with y hy
      have hm := Matrix.mul_nonsing_inv (h y) (isUnit_iff_ne_zero.mpr (hpd y hy).det_pos.ne')
      have := congrFun (congrFun hm r) q
      rwa [Matrix.mul_apply, Matrix.one_apply] at this
    have h0 : pd2 k (fun y => ∑ s : Fin 2, h y r s * (h y)⁻¹ s q) x₀ = 0 := by
      unfold pd2; rw [ev.fderiv_eq]; simp
    rw [pSum k (fun s y => h y r s * (h y)⁻¹ s q)
      (fun s => dA _ ((hh r s).mul (hGs s q)))] at h0
    refine (Finset.sum_congr rfl fun s _ => ?_).trans h0
    rw [pMul k (fun y => h y r s) (fun y => (h y)⁻¹ s q) (dA _ (hh r s)) (dA _ (hGs s q))]
  have hg1 : ∀ k p q : Fin 2, pd2 k (fun y => (h y)⁻¹ p q) x₀ =
      -∑ r : Fin 2, ∑ s : Fin 2,
        (h x₀)⁻¹ p r * pd2 k (fun y => h y r s) x₀ * (h x₀)⁻¹ s q := by
    intro k p q
    have e2 : ∑ s : Fin 2, (∑ r : Fin 2, (h x₀)⁻¹ p r * h x₀ r s) *
        pd2 k (fun y => (h y)⁻¹ s q) x₀ = pd2 k (fun y => (h y)⁻¹ p q) x₀ := by
      simp only [hHiH]; simp
    have e3 : ∑ r : Fin 2, (h x₀)⁻¹ p r * ∑ s : Fin 2, (h x₀ r s *
        pd2 k (fun y => (h y)⁻¹ s q) x₀ + (h x₀)⁻¹ s q * pd2 k (fun y => h y r s) x₀) = 0 := by
      simp only [hE, mul_zero, Finset.sum_const_zero]
    simp only [Fin.sum_univ_two] at e2 e3 ⊢
    linear_combination e3 - e2
  
  have hT : ∀ a b c : Fin 2, pcgbJT (h x₀) (pcgbJg1 h x₀) a b c =
      1 / 2 * pd2 c (fun y => h y a b) x₀ := by
    intro a b c
    simp only [pcgbJT, pcgbJg1, hg1, Fin.sum_univ_two]
    revert a b
    simp only [Fin.forall_fin_two]
    simp only [hI00, hI01, hI10, hI11, hsym10, hAsym c 1 0]
    refine ⟨⟨?_, ?_⟩, ⟨?_, ?_⟩⟩ <;> (field_simp; rw [← hΔdef]; ring)
  
  obtain ⟨hDs, hd1, hd2, hd3⟩ := s3 (h x₀) (pcgbJg1 h x₀) (pcgbJg2 h x₀)
  change ContDiff ℝ ∞ (pcgbJetD h x₀) at hDs
  change ∀ k : Fin 2, pd2 k (pcgbJetD h x₀) x₀ = 0 at hd1
  change ∀ i j : Fin 2, pd2 i (pd2 j (pcgbJetD h x₀)) x₀ = h x₀ j i + h x₀ i j at hd2
  change ∀ m i j : Fin 2, pd2 m (pd2 i (pd2 j (pcgbJetD h x₀))) x₀ =
    pcgbJW (pcgbJT (h x₀) (pcgbJg1 h x₀)) j i m +
      pcgbJW (pcgbJT (h x₀) (pcgbJg1 h x₀)) j m i at hd3
  generalize pcgbJetD h x₀ = D at hDs hd1 hd2 hd3 ⊢
  have hDW : ContDiffOn ℝ ∞ D W := hDs.contDiffOn
  
  have hpm : ∀ m : Fin 2, pd2 m (lap2 h D) x₀ =
      ∑ i : Fin 2, ∑ j : Fin 2,
        ((h x₀)⁻¹ i j * (pd2 m (pd2 i (pd2 j D)) x₀ -
            ∑ k : Fin 2, (christoffel2 h k i j x₀ * pd2 m (pd2 k D) x₀ +
              pd2 k D x₀ * pd2 m (christoffel2 h k i j) x₀)) +
          (pd2 i (pd2 j D) x₀ - ∑ k : Fin 2, christoffel2 h k i j x₀ * pd2 k D x₀) *
            pd2 m (fun y => (h y)⁻¹ i j) x₀) := by
    intro m
    have hl : lap2 h D = fun x => ∑ i : Fin 2, ∑ j : Fin 2, (h x)⁻¹ i j *
        (pd2 i (pd2 j D) x - ∑ k : Fin 2, christoffel2 h k i j x * pd2 k D x) := rfl
    have sK : ∀ i j : Fin 2, ContDiffOn ℝ ∞
        (fun x => ∑ k : Fin 2, christoffel2 h k i j x * pd2 k D x) W :=
      fun i j => ContDiffOn.sum fun k _ => (hΓs k i j).mul (pdS k _ hDW)
    have sI : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => pd2 i (pd2 j D) x -
        ∑ k : Fin 2, christoffel2 h k i j x * pd2 k D x) W :=
      fun i j => (pdS i _ (pdS j _ hDW)).sub (sK i j)
    have sS : ∀ i j : Fin 2, ContDiffOn ℝ ∞ (fun x => (h x)⁻¹ i j * (pd2 i (pd2 j D) x -
        ∑ k : Fin 2, christoffel2 h k i j x * pd2 k D x)) W :=
      fun i j => (hGs i j).mul (sI i j)
    rw [hl, pSum m (fun i x => ∑ j : Fin 2, (h x)⁻¹ i j * (pd2 i (pd2 j D) x -
        ∑ k : Fin 2, christoffel2 h k i j x * pd2 k D x))
      (fun i => dA _ (ContDiffOn.sum fun j _ => sS i j))]
    refine Finset.sum_congr rfl (fun i _ => ?_)
    rw [pSum m (fun j x => (h x)⁻¹ i j * (pd2 i (pd2 j D) x -
        ∑ k : Fin 2, christoffel2 h k i j x * pd2 k D x)) (fun j => dA _ (sS i j))]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    have hk : ∀ k : Fin 2, pd2 m (fun x => christoffel2 h k i j x * pd2 k D x) x₀ =
        christoffel2 h k i j x₀ * pd2 m (pd2 k D) x₀ +
          pd2 k D x₀ * pd2 m (christoffel2 h k i j) x₀ :=
      fun k => pMul m _ _ (dA _ (hΓs k i j)) (dA _ (pdS k _ hDW))
    rw [pMul m (fun y => (h y)⁻¹ i j) _ (dA _ (hGs i j)) (dA _ (sI i j)),
      pSub m _ _ (dA _ (pdS i _ (pdS j _ hDW))) (dA _ (sK i j)),
      pSum m (fun k x => christoffel2 h k i j x * pd2 k D x)
        (fun k => dA _ ((hΓs k i j).mul (pdS k _ hDW)))]
    simp only [hk]
  
  have hpm0 : ∀ m : Fin 2, pd2 m (lap2 h D) x₀ = 0 := by
    intro m
    rw [hpm m]
    simp only [hd1, hd2, hd3, mul_zero, zero_mul, add_zero, sub_zero, Finset.sum_const_zero]
    simp only [pcgbJW, hT, christoffel2, hg1, Fin.sum_univ_two]
    revert m
    simp only [Fin.forall_fin_two]
    simp only [hI00, hI01, hI10, hI11, hsym10, hAsym 0 1 0, hAsym 1 1 0]
    constructor <;> (field_simp; rw [← hΔdef]; ring)
  
  have hfs : ContDiffOn ℝ ∞ (fun y => lap2 h D y - 4) W :=
    (pcgb_lap2_contDiffOn W hW h hh hpd D hDW).sub contDiffOn_const
  have hf0 : lap2 h D x₀ - 4 = 0 := by
    simp only [lap2, hd1, mul_zero, Finset.sum_const_zero, sub_zero, hd2]
    simp only [Fin.sum_univ_two, hI00, hI01, hI10, hI11, hsym10]
    field_simp
    rw [← hΔdef]
    ring
  have hf1 : ∀ k : Fin 2, pd2 k (fun y => lap2 h D y - 4) x₀ = 0 := by
    intro k
    have : pd2 k (fun y => lap2 h D y - 4) x₀ = pd2 k (lap2 h D) x₀ := by
      unfold pd2; rw [fderiv_sub_const]
    rw [this, hpm0 k]
  
  obtain ⟨K, hK, hb⟩ :=
    pcgb_taylor2_remainder W hW (fun y => lap2 h D y - 4) hfs x₀ R₀ hR₀ hball
  refine ⟨Matrix.of fun a c => (1 / 4 : ℝ) *
      (pd2 a (pd2 c (fun y => lap2 h D y - 4)) x₀ + pd2 c (pd2 a (fun y => lap2 h D y - 4)) x₀),
    K, ?_, hK, ?_⟩
  · intro a c
    simp only [Matrix.of_apply]
    ring
  · intro x hx
    have hTay : pcgbTay2 (fun y => lap2 h D y - 4) x₀ = fun y => lap2 h D y - 4 -
        pcgbPxQuad (Matrix.of fun a c => (1 / 4 : ℝ) *
          (pd2 a (pd2 c (fun y => lap2 h D y - 4)) x₀ +
            pd2 c (pd2 a (fun y => lap2 h D y - 4)) x₀)) x₀ y := by
      funext y
      simp only [pcgbTay2, pcgbPxQuad, hf0, hf1, zero_mul, Finset.sum_const_zero, sub_zero,
        Matrix.of_apply, Fin.sum_univ_two]
      ring
    have hxb : x ∈ Metric.closedBall x₀ R₀ :=
      Metric.mem_closedBall.mpr (le_trans hx.le (min_le_left _ _))
    obtain ⟨e0, e1, -⟩ := hb x hxb
    rw [hTay] at e0 e1
    exact ⟨e0, e1⟩

theorem pcgb_parametrix_jet (W : Set E2) (hW : IsOpen W) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a c) W)
    (hpd : ∀ x ∈ W, (h x).PosDef) (x₀ : E2) (R₀ : ℝ) (hR₀ : 0 < R₀)
    (hball : Metric.closedBall x₀ R₀ ⊆ W) :
    ∃ (D : E2 → ℝ) (M : Matrix (Fin 2) (Fin 2) ℝ) (σ c₀ K : ℝ),
      0 < σ ∧ σ ≤ R₀ ∧ σ ≤ 1 ∧ 0 < c₀ ∧ 0 ≤ K ∧ (∀ a c : Fin 2, M a c = M c a) ∧
      ContDiff ℝ ∞ D ∧
      ∀ x : E2, 0 < dist x x₀ → dist x x₀ < σ → pcgbPxJet h D M x₀ c₀ K x :=
by
  have hx₀W : x₀ ∈ W := hball (Metric.mem_closedBall_self hR₀.le)
  have hH : (h x₀).PosDef := hpd x₀ hx₀W
  have hsym : h x₀ 1 0 = h x₀ 0 1 := by
    have := hH.isHermitian.apply 0 1
    simpa using this
  have h00 : 0 < h x₀ 0 0 := hH.diag_pos
  have h11 : 0 < h x₀ 1 1 := hH.diag_pos
  have hdet : 0 < (h x₀).det := hH.det_pos
  have hdet2 : (h x₀).det = h x₀ 0 0 * h x₀ 1 1 - h x₀ 0 1 * h x₀ 1 0 := Matrix.det_fin_two _
  obtain ⟨tr, htrdef⟩ : ∃ tr : ℝ, tr = h x₀ 0 0 + h x₀ 1 1 := ⟨_, rfl⟩
  have htr : 0 < tr := by rw [htrdef]; linarith
  obtain ⟨lam, hlamdef⟩ : ∃ lam : ℝ, lam = (h x₀).det / tr := ⟨_, rfl⟩
  have hlam : 0 < lam := by rw [hlamdef]; exact div_pos hdet htr
  have hs2 : ∀ x : E2, dist x x₀ ^ 2 = (x - x₀) 0 ^ 2 + (x - x₀) 1 ^ 2 := by
    intro x
    rw [EuclideanSpace.dist_eq, Real.sq_sqrt (Finset.sum_nonneg (fun i _ => sq_nonneg _)),
      Fin.sum_univ_two]
    simp [Real.dist_eq, sq_abs]
  
  have hQlow : ∀ x : E2, lam * dist x x₀ ^ 2 ≤ pcgbPxQuad (h x₀) x₀ x := by
    intro x
    have hQ : pcgbPxQuad (h x₀) x₀ x =
        h x₀ 0 0 * (x - x₀) 0 * (x - x₀) 0 + h x₀ 0 1 * (x - x₀) 0 * (x - x₀) 1 +
          (h x₀ 1 0 * (x - x₀) 1 * (x - x₀) 0 + h x₀ 1 1 * (x - x₀) 1 * (x - x₀) 1) := by
      simp only [pcgbPxQuad, Fin.sum_univ_two]
    have key : tr * pcgbPxQuad (h x₀) x₀ x - (h x₀).det * dist x x₀ ^ 2 =
        (h x₀ 0 0 * (x - x₀) 0 + h x₀ 0 1 * (x - x₀) 1) ^ 2 +
          (h x₀ 1 0 * (x - x₀) 0 + h x₀ 1 1 * (x - x₀) 1) ^ 2 := by
      rw [hQ, hs2, hdet2, htrdef, hsym]; ring
    rw [hlamdef, div_mul_eq_mul_div, div_le_iff₀ htr]
    nlinarith [sq_nonneg (h x₀ 0 0 * (x - x₀) 0 + h x₀ 0 1 * (x - x₀) 1),
      sq_nonneg (h x₀ 1 0 * (x - x₀) 0 + h x₀ 1 1 * (x - x₀) 1)]
  
  obtain ⟨T, hTdef⟩ : ∃ T : Fin 2 → Fin 2 → Fin 2 → ℝ, T = pcgbJT (h x₀) (pcgbJg1 h x₀) :=
    ⟨_, rfl⟩
  obtain ⟨U, hUdef⟩ : ∃ U : Fin 2 → Fin 2 → Fin 2 → Fin 2 → ℝ,
      U = pcgbJU (h x₀) (pcgbJg1 h x₀) (pcgbJg2 h x₀) := ⟨_, rfl⟩
  have hDdef : pcgbJetD h x₀ = fun y => pcgbPxQuad (h x₀) x₀ y +
      (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, T a b c * (y - x₀) a * (y - x₀) b * (y - x₀) c) +
      (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
        U a b c d * (y - x₀) a * (y - x₀) b * (y - x₀) c * (y - x₀) d) := by
    rw [hTdef, hUdef]; rfl
  obtain ⟨-, -, -, -, -, hQs, hTs, hUs⟩ := pcgb_form_pd2 x₀ x₀ 0 (fun _ => 0) (h x₀) T U
  have hDs : ContDiff ℝ ∞ (pcgbJetD h x₀) := by
    rw [hDdef]; exact (hQs.add hTs).add hUs
  
  obtain ⟨φ, hφdef⟩ : ∃ φ : E2 → ℝ, φ = fun y => pcgbJetD h x₀ y - pcgbPxQuad (h x₀) x₀ y :=
    ⟨_, rfl⟩
  have hφeq : φ = fun y =>
      (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, T a b c * (y - x₀) a * (y - x₀) b * (y - x₀) c) +
      (∑ a : Fin 2, ∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
        U a b c d * (y - x₀) a * (y - x₀) b * (y - x₀) c * (y - x₀) d) := by
    rw [hφdef, hDdef]; funext y; ring
  have hφs : ContDiff ℝ ∞ φ := by rw [hφeq]; exact hTs.add hUs
  have hpdφ : ∀ l : Fin 2, pd2 l φ = fun y =>
      (∑ b : Fin 2, ∑ c : Fin 2, pcgbJW T l b c * (y - x₀) b * (y - x₀) c) +
      (∑ b : Fin 2, ∑ c : Fin 2, ∑ d : Fin 2,
        pcgbJV U l b c d * (y - x₀) b * (y - x₀) c * (y - x₀) d) := by
    intro l
    funext y
    obtain ⟨-, -, h3, h4, -⟩ := pcgb_form_pd2 x₀ y l (fun _ => 0) (fun _ _ => 0) T U
    have hd1 := (hTs.differentiable (by simp)) y
    have hd2 := (hUs.differentiable (by simp)) y
    rw [hφeq]
    unfold pd2 at h3 h4 ⊢
    rw [fderiv_fun_add hd1 hd2, ContinuousLinearMap.add_apply, h3, h4]
    simp only [pcgbJW, pcgbJV]
  have hφx₀ : φ x₀ = 0 := by rw [hφeq]; simp
  have hpd1 : ∀ k : Fin 2, pd2 k φ x₀ = 0 := by
    intro k; rw [hpdφ k]; simp
  have hpd2 : ∀ k l : Fin 2, pd2 k (pd2 l φ) x₀ = 0 := by
    intro k l
    rw [hpdφ l]
    obtain ⟨-, h2, h3, -, -, hBs', hTs', -⟩ :=
      pcgb_form_pd2 x₀ x₀ k (fun _ => 0) (pcgbJW T l) (pcgbJV U l) (fun _ _ _ _ => 0)
    have hd1 := (hBs'.differentiable (by simp)) x₀
    have hd2 := (hTs'.differentiable (by simp)) x₀
    unfold pd2 at h2 h3 ⊢
    rw [fderiv_fun_add hd1 hd2, ContinuousLinearMap.add_apply, h2, h3]
    simp
  have hTay : pcgbTay2 φ x₀ = φ := by
    funext y
    unfold pcgbTay2
    rw [hφx₀]
    simp only [hpd1, hpd2]
    simp
  obtain ⟨K₂, hK₂, hb2⟩ := pcgb_taylor2_remainder Set.univ isOpen_univ φ hφs.contDiffOn x₀ R₀
    hR₀ (Set.subset_univ _)
  rw [hTay] at hb2
  
  obtain ⟨K₃, hK₃, hb3⟩ := pcgb_jet_eikonal_bound W hW h hh hpd x₀ R₀ hR₀ hball
  obtain ⟨M, K₄, hMs, hK₄, hb4⟩ := pcgb_jet_lap_bound W hW h hh hpd x₀ R₀ hR₀ hball
  have hK2p : 0 < 2 * (K₂ + 1) := by linarith
  refine ⟨pcgbJetD h x₀, M, min (min R₀ 1) (lam / (2 * (K₂ + 1))), lam / 2, K₂ + K₃ + K₄,
    ?_, ?_, ?_, ?_, ?_, hMs, hDs, ?_⟩
  · exact lt_min (lt_min hR₀ one_pos) (div_pos hlam hK2p)
  · exact le_trans (min_le_left _ _) (min_le_left _ _)
  · exact le_trans (min_le_left _ _) (min_le_right _ _)
  · linarith
  · linarith
  · intro x hx0 hxσ
    have hσ1 : dist x x₀ < min R₀ 1 := lt_of_lt_of_le hxσ (min_le_left _ _)
    have hσ2 : dist x x₀ < lam / (2 * (K₂ + 1)) := lt_of_lt_of_le hxσ (min_le_right _ _)
    have hxR : x ∈ Metric.closedBall x₀ R₀ :=
      Metric.mem_closedBall.mpr (le_of_lt (lt_of_lt_of_le hσ1 (min_le_left _ _)))
    obtain ⟨e0, e1, e2⟩ := hb2 x hxR
    obtain ⟨e3, e4⟩ := hb3 x hσ1
    obtain ⟨e5, e6⟩ := hb4 x hσ1
    have hs0 : 0 ≤ dist x x₀ := le_of_lt hx0
    have hφx : φ x = pcgbJetD h x₀ x - pcgbPxQuad (h x₀) x₀ x := by rw [hφdef]
    have hKK2 : K₂ ≤ K₂ + K₃ + K₄ := by linarith
    have hKK3 : K₃ ≤ K₂ + K₃ + K₄ := by linarith
    have hKK4 : K₄ ≤ K₂ + K₃ + K₄ := by linarith
    refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩
    · have hQ := hQlow x
      have habs := (abs_le.mp e0).1
      rw [hφx] at habs
      have h1 : dist x x₀ * (2 * (K₂ + 1)) < lam := (lt_div_iff₀ hK2p).mp hσ2
      have hK2s : K₂ * dist x x₀ ≤ lam / 2 := by nlinarith
      have h3 : K₂ * dist x x₀ ^ 3 ≤ lam / 2 * dist x x₀ ^ 2 := by
        have e : K₂ * dist x x₀ ^ 3 = (K₂ * dist x x₀) * dist x x₀ ^ 2 := by ring
        rw [e]
        exact mul_le_mul_of_nonneg_right hK2s (pow_nonneg hs0 2)
      linarith
    · rw [hφx] at e0
      exact e0.trans (mul_le_mul_of_nonneg_right hKK2 (pow_nonneg hs0 3))
    · rw [hφdef] at e1
      exact e1.trans (mul_le_mul_of_nonneg_right hKK2 (pow_nonneg hs0 2))
    · rw [hφdef] at e2
      exact e2.trans (mul_le_mul_of_nonneg_right hKK2 hs0)
    · exact e3.trans (mul_le_mul_of_nonneg_right hKK3 (pow_nonneg hs0 5))
    · exact e4.trans (mul_le_mul_of_nonneg_right hKK3 (pow_nonneg hs0 4))
    · exact e5.trans (mul_le_mul_of_nonneg_right hKK4 (pow_nonneg hs0 3))
    · exact e6.trans (mul_le_mul_of_nonneg_right hKK4 (pow_nonneg hs0 2))

theorem pcgb_log_quad_correction (H M : Matrix (Fin 2) (Fin 2) ℝ) (hH : H.PosDef)
    (hM : ∀ a c : Fin 2, M a c = M c a) (x₀ : E2) :
    ContDiffOn ℝ ∞ (pcgbPxPsi H M x₀) {x | x ≠ x₀} ∧
      ∃ K : ℝ, 0 ≤ K ∧ ∀ x : E2, 0 < dist x x₀ → dist x x₀ < 1 → pcgbPxPsiEst H M x₀ K x :=
by
  
  have t_hasQ : ∀ (A : Matrix (Fin 2) (Fin 2) ℝ) (x₀ y : E2),
      HasFDerivAt (pcgbPxQuad A x₀)
        (∑ a : Fin 2, ∑ c : Fin 2, A a c •
          ((y - x₀) a • (EuclideanSpace.proj c : E2 →L[ℝ] ℝ) +
            (y - x₀) c • (EuclideanSpace.proj a : E2 →L[ℝ] ℝ))) y := by
    intro A x₀ y
    have hl : ∀ a : Fin 2, HasFDerivAt (fun y : E2 => (y - x₀) a)
        (EuclideanSpace.proj a : E2 →L[ℝ] ℝ) y := by
      intro a
      have h1 := ((EuclideanSpace.proj a : E2 →L[ℝ] ℝ).hasFDerivAt (x := y)).sub_const (x₀ a)
      convert h1 using 1
    have hterm : ∀ a c : Fin 2, HasFDerivAt (fun y : E2 => A a c * (y - x₀) a * (y - x₀) c)
        (A a c • ((y - x₀) a • (EuclideanSpace.proj c : E2 →L[ℝ] ℝ) +
            (y - x₀) c • (EuclideanSpace.proj a : E2 →L[ℝ] ℝ))) y := by
      intro a c
      have := ((hl a).const_mul (A a c)).mul (hl c)
      convert this using 1
      ext w
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
      ring
    have hs := HasFDerivAt.sum (u := Finset.univ) (fun a _ =>
      HasFDerivAt.sum (u := Finset.univ) (fun c _ => hterm a c))
    convert hs using 1
  have t_evalQ : ∀ (A : Matrix (Fin 2) (Fin 2) ℝ) (x₀ y : E2) (j : Fin 2),
      (∑ a : Fin 2, ∑ c : Fin 2, A a c •
          ((y - x₀) a • (EuclideanSpace.proj c : E2 →L[ℝ] ℝ) +
            (y - x₀) c • (EuclideanSpace.proj a : E2 →L[ℝ] ℝ))) (e2 j) =
        ∑ c : Fin 2, (A j c + A c j) * (y - x₀) c := by
    intro A x₀ y j
    fin_cases j <;> simp [Fin.sum_univ_two, EuclideanSpace.single_apply] <;> ring
  
  have t_iter3 : ∀ (A : Matrix (Fin 2) (Fin 2) ℝ) (x₀ : E2),
      ContDiff ℝ ∞ (pcgbPxQuad A x₀) ∧ ∀ y : E2, iteratedFDeriv ℝ 3 (pcgbPxQuad A x₀) y = 0 := by
    intro A x₀
    have hcoord : ∀ a : Fin 2, ContDiff ℝ ∞ (fun y : E2 => (y - x₀) a) := fun a =>
      (EuclideanSpace.proj a : E2 →L[ℝ] ℝ).contDiff.comp (contDiff_id.sub contDiff_const)
    refine ⟨?_, ?_⟩
    · exact ContDiff.sum fun a _ => ContDiff.sum fun c _ =>
        (contDiff_const.mul (hcoord a)).mul (hcoord c)
    intro y
    set L : E2 →L[ℝ] E2 →L[ℝ] ℝ := ∑ a : Fin 2, ∑ c : Fin 2, A a c •
      ((EuclideanSpace.proj a : E2 →L[ℝ] ℝ).smulRight (EuclideanSpace.proj c : E2 →L[ℝ] ℝ) +
       (EuclideanSpace.proj c : E2 →L[ℝ] ℝ).smulRight (EuclideanSpace.proj a : E2 →L[ℝ] ℝ))
      with hL
    have h1 : fderiv ℝ (pcgbPxQuad A x₀) = fun y => L (y - x₀) := by
      funext z
      rw [(t_hasQ A x₀ z).fderiv]
      ext w
      simp [hL, Fin.sum_univ_two]
    have h2 : fderiv ℝ (fderiv ℝ (pcgbPxQuad A x₀)) = fun _ => L := by
      funext z
      rw [h1]
      have := (L.hasFDerivAt (x := z - x₀)).comp z ((hasFDerivAt_id z).sub_const x₀)
      have e : (fun y => L (y - x₀)) = (⇑L ∘ fun x => id x - x₀) := rfl
      rw [e, this.fderiv]
      ext w
      simp
    have h3 : fderiv ℝ (fderiv ℝ (fderiv ℝ (pcgbPxQuad A x₀))) y = 0 := by
      rw [h2]
      exact fderiv_const_apply (𝕜 := ℝ) (x := y) L
    rw [← norm_eq_zero, ← norm_iteratedFDeriv_fderiv (n := 2),
      ← norm_iteratedFDeriv_fderiv (n := 1), norm_iteratedFDeriv_one, h3, norm_zero]
  
  have t_scaling : ∀ (φ n₀ : E2 → ℝ), ContDiffOn ℝ ∞ φ {z | z ≠ 0} → ContDiff ℝ ∞ n₀ →
      (∀ t : ℝ, 0 < t → ∀ z : E2, φ (t • z) = t ^ 2 * φ z + t ^ 2 * Real.log t * n₀ z) →
      ∀ (k : ℕ) (t : ℝ), 0 < t → ∀ z : E2, z ≠ 0 →
        t ^ k • iteratedFDeriv ℝ k φ (t • z) =
          t ^ 2 • iteratedFDeriv ℝ k φ z + (t ^ 2 * Real.log t) • iteratedFDeriv ℝ k n₀ z := by
    intro φ n₀ hφ hn hs k t ht z hz
    set g : E2 ≃L[ℝ] E2 :=
      (LinearEquiv.smulOfNeZero ℝ E2 t ht.ne').toContinuousLinearEquiv with hg
    have hgw : ∀ w : E2, g w = t • w := fun w => rfl
    have hk : ((k : ℕ∞) : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
    have h1 := ContinuousLinearEquiv.iteratedFDerivWithin_comp_right g φ uniqueDiffOn_univ
      (x := z) (Set.mem_univ _) k
    rw [Set.preimage_univ, iteratedFDerivWithin_univ, iteratedFDerivWithin_univ] at h1
    have hfun : (φ ∘ ⇑g) = fun w => t ^ 2 • φ w + (t ^ 2 * Real.log t) • n₀ w := by
      funext w
      simp only [Function.comp_apply, hgw, smul_eq_mul]
      rw [hs t ht w]
    have hφz : ContDiffAt ℝ ∞ φ z := hφ.contDiffAt (isOpen_ne.mem_nhds hz)
    have hA : ContDiffAt ℝ k (fun w => t ^ 2 • φ w) z := (hφz.of_le hk).const_smul _
    have hB : ContDiffAt ℝ k (fun w => (t ^ 2 * Real.log t) • n₀ w) z :=
      ((hn.contDiffAt).of_le hk).const_smul _
    have h2 : iteratedFDeriv ℝ k (φ ∘ ⇑g) z =
        t ^ 2 • iteratedFDeriv ℝ k φ z + (t ^ 2 * Real.log t) • iteratedFDeriv ℝ k n₀ z := by
      rw [hfun, iteratedFDeriv_add_apply' hA hB, iteratedFDeriv_const_smul_apply' (hφz.of_le hk),
        iteratedFDeriv_const_smul_apply' ((hn.contDiffAt).of_le hk)]
    rw [← h2, h1]
    ext m
    simp only [ContinuousMultilinearMap.smul_apply,
      ContinuousMultilinearMap.compContinuousLinearMap_apply]
    have h3 : (fun i => ((g : E2 →L[ℝ] E2)) (m i)) = fun i => t • m i := by
      funext i
      exact hgw (m i)
    rw [h3, ContinuousMultilinearMap.map_smul_univ, Finset.prod_const, Finset.card_univ,
      Fintype.card_fin, hgw]
  
  have t_bounds : ∀ (φ n₀ : E2 → ℝ), ContDiffOn ℝ ∞ φ {z | z ≠ 0} → ContDiff ℝ ∞ n₀ →
      (∀ z : E2, iteratedFDeriv ℝ 3 n₀ z = 0) →
      (∀ (k : ℕ) (t : ℝ), 0 < t → ∀ z : E2, z ≠ 0 →
        t ^ k • iteratedFDeriv ℝ k φ (t • z) =
          t ^ 2 • iteratedFDeriv ℝ k φ z + (t ^ 2 * Real.log t) • iteratedFDeriv ℝ k n₀ z) →
      ∃ B : ℝ, 0 ≤ B ∧ ∀ z : E2, z ≠ 0 →
        ‖φ z‖ ≤ B * ‖z‖ ^ 2 * (1 + |Real.log ‖z‖|) ∧
        ‖fderiv ℝ φ z‖ ≤ B * ‖z‖ * (1 + |Real.log ‖z‖|) ∧
        ‖iteratedFDeriv ℝ 2 φ z‖ ≤ B * (1 + |Real.log ‖z‖|) ∧
        ‖iteratedFDeriv ℝ 3 φ z‖ ≤ B / ‖z‖ := by
    intro φ n₀ hφ hn hn3 hsc
    have hU : IsOpen {z : E2 | z ≠ 0} := isOpen_ne
    have hSU : Metric.sphere (0 : E2) 1 ⊆ {z : E2 | z ≠ 0} := by
      intro u hu
      have h1 : ‖u‖ = 1 := mem_sphere_zero_iff_norm.mp hu
      intro h0
      rw [h0, norm_zero] at h1
      exact zero_ne_one h1
    have hbd : ∀ k : ℕ, ∃ C : ℝ, 0 ≤ C ∧ ∀ u ∈ Metric.sphere (0 : E2) 1,
        ‖iteratedFDeriv ℝ k φ u‖ ≤ C ∧ ‖iteratedFDeriv ℝ k n₀ u‖ ≤ C := by
      intro k
      have hk : ((k : ℕ∞) : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
      have hc1 : ContinuousOn (iteratedFDeriv ℝ k φ) (Metric.sphere (0 : E2) 1) :=
        ((hφ.continuousOn_iteratedFDerivWithin (m := k) hk hU.uniqueDiffOn).congr
          (fun z hz => (iteratedFDerivWithin_of_isOpen k hU hz).symm)).mono hSU
      have hc2 : ContinuousOn (iteratedFDeriv ℝ k n₀) (Metric.sphere (0 : E2) 1) :=
        (hn.continuous_iteratedFDeriv (m := k) hk).continuousOn
      obtain ⟨C1, hC1⟩ := (isCompact_sphere (0 : E2) 1).exists_bound_of_continuousOn hc1
      obtain ⟨C2, hC2⟩ := (isCompact_sphere (0 : E2) 1).exists_bound_of_continuousOn hc2
      refine ⟨|C1| + |C2|, by positivity, fun u hu => ⟨?_, ?_⟩⟩
      · exact (hC1 u hu).trans ((le_abs_self _).trans (le_add_of_nonneg_right (abs_nonneg _)))
      · exact (hC2 u hu).trans ((le_abs_self _).trans (le_add_of_nonneg_left (abs_nonneg _)))
    have hgen : ∀ (k : ℕ) (C : ℝ), 0 ≤ C → (∀ u ∈ Metric.sphere (0 : E2) 1,
        ‖iteratedFDeriv ℝ k φ u‖ ≤ C ∧ ‖iteratedFDeriv ℝ k n₀ u‖ ≤ C) →
        ∀ z : E2, z ≠ 0 →
          ‖z‖ ^ k * ‖iteratedFDeriv ℝ k φ z‖ ≤ ‖z‖ ^ 2 * C * (1 + |Real.log ‖z‖|) ∧
          ‖z‖ ^ k * ‖iteratedFDeriv ℝ k φ z‖ ≤
            ‖z‖ ^ 2 * C + ‖z‖ ^ 2 * |Real.log ‖z‖| * ‖iteratedFDeriv ℝ k n₀ (‖z‖⁻¹ • z)‖ := by
      intro k C hC hb z hz
      have hs : 0 < ‖z‖ := norm_pos_iff.mpr hz
      set s := ‖z‖ with hsdef
      have hu : s⁻¹ • z ∈ Metric.sphere (0 : E2) 1 := by
        rw [mem_sphere_zero_iff_norm, norm_smul, Real.norm_eq_abs, abs_inv, abs_of_pos hs,
          inv_mul_cancel₀ hs.ne']
      have hu0 : s⁻¹ • z ≠ 0 := hSU hu
      have hsu : s • (s⁻¹ • z) = z := by rw [smul_smul, mul_inv_cancel₀ hs.ne', one_smul]
      have hid := hsc k s hs (s⁻¹ • z) hu0
      rw [hsu] at hid
      have hn1 := congrArg norm hid
      rw [norm_smul, Real.norm_eq_abs, abs_of_pos (pow_pos hs k)] at hn1
      have htri := norm_add_le (s ^ 2 • iteratedFDeriv ℝ k φ (s⁻¹ • z))
        ((s ^ 2 * Real.log s) • iteratedFDeriv ℝ k n₀ (s⁻¹ • z))
      rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_pos (pow_pos hs 2),
        abs_mul, abs_of_pos (pow_pos hs 2)] at htri
      obtain ⟨b1, b2⟩ := hb _ hu
      have hs2 : 0 ≤ s ^ 2 := by positivity
      have hL : 0 ≤ |Real.log s| := abs_nonneg _
      have e1 : s ^ 2 * ‖iteratedFDeriv ℝ k φ (s⁻¹ • z)‖ ≤ s ^ 2 * C :=
        mul_le_mul_of_nonneg_left b1 hs2
      have e2 : s ^ 2 * |Real.log s| * ‖iteratedFDeriv ℝ k n₀ (s⁻¹ • z)‖ ≤
          s ^ 2 * |Real.log s| * C :=
        mul_le_mul_of_nonneg_left b2 (mul_nonneg hs2 hL)
      constructor
      · nlinarith
      · linarith
    obtain ⟨C0, hC0, hb0⟩ := hbd 0
    obtain ⟨C1, hC1, hb1⟩ := hbd 1
    obtain ⟨C2, hC2, hb2⟩ := hbd 2
    obtain ⟨C3, hC3, hb3⟩ := hbd 3
    refine ⟨C0 + C1 + C2 + C3, by positivity, fun z hz => ?_⟩
    have hs : 0 < ‖z‖ := norm_pos_iff.mpr hz
    have g0 := (hgen 0 C0 hC0 hb0 z hz).1
    have g1 := (hgen 1 C1 hC1 hb1 z hz).1
    have g2 := (hgen 2 C2 hC2 hb2 z hz).1
    have g3 := (hgen 3 C3 hC3 hb3 z hz).2
    rw [hn3, norm_zero, mul_zero, add_zero] at g3
    rw [norm_iteratedFDeriv_zero, pow_zero, one_mul] at g0
    rw [norm_iteratedFDeriv_one, pow_one] at g1
    set s := ‖z‖
    set L := 1 + |Real.log s|
    have hL1 : 0 ≤ L := by positivity
    refine ⟨?_, ?_, ?_, ?_⟩
    · have : C0 ≤ C0 + C1 + C2 + C3 := by linarith
      have h' : 0 ≤ s ^ 2 * L := by positivity
      nlinarith
    · apply le_of_mul_le_mul_left _ hs
      have : C1 ≤ C0 + C1 + C2 + C3 := by linarith
      have h' : 0 ≤ s ^ 2 * L := by positivity
      calc s * ‖fderiv ℝ φ z‖ ≤ s ^ 2 * C1 * L := g1
        _ ≤ s * ((C0 + C1 + C2 + C3) * s * L) := by nlinarith
    · apply le_of_mul_le_mul_left _ (pow_pos hs 2)
      have : C2 ≤ C0 + C1 + C2 + C3 := by linarith
      have h' : 0 ≤ s ^ 2 * L := by positivity
      calc s ^ 2 * ‖iteratedFDeriv ℝ 2 φ z‖ ≤ s ^ 2 * C2 * L := g2
        _ ≤ s ^ 2 * ((C0 + C1 + C2 + C3) * L) := by nlinarith
    · rw [le_div_iff₀ hs]
      apply le_of_mul_le_mul_left _ (pow_pos hs 2)
      have : C3 ≤ C0 + C1 + C2 + C3 := by linarith
      calc s ^ 2 * (‖iteratedFDeriv ℝ 3 φ z‖ * s) = s ^ 3 * ‖iteratedFDeriv ℝ 3 φ z‖ := by ring
        _ ≤ s ^ 2 * C3 := g3
        _ ≤ s ^ 2 * (C0 + C1 + C2 + C3) := mul_le_mul_of_nonneg_left this (by positivity)
  have t_lin : ∀ (A : Matrix (Fin 2) (Fin 2) ℝ) (x₀ y : E2) (j : Fin 2),
      HasFDerivAt (fun y : E2 => ∑ c : Fin 2, A j c * (y - x₀) c)
        (∑ c : Fin 2, A j c • (EuclideanSpace.proj c : E2 →L[ℝ] ℝ)) y := by
    intro A x₀ y j
    have hl : ∀ a : Fin 2, HasFDerivAt (fun y : E2 => (y - x₀) a)
        (EuclideanSpace.proj a : E2 →L[ℝ] ℝ) y := by
      intro a
      have h1 := ((EuclideanSpace.proj a : E2 →L[ℝ] ℝ).hasFDerivAt (x := y)).sub_const (x₀ a)
      convert h1 using 1
    have hs := HasFDerivAt.sum (u := Finset.univ) (fun c _ => (hl c).const_mul (A j c))
    convert hs using 1
  have t_evalL : ∀ (A : Matrix (Fin 2) (Fin 2) ℝ) (i j : Fin 2),
      (∑ c : Fin 2, A j c • (EuclideanSpace.proj c : E2 →L[ℝ] ℝ)) (e2 i) = A j i := by
    intro A i j
    fin_cases i <;> simp [Fin.sum_univ_two, EuclideanSpace.single_apply]
  have hQpos : ∀ y : E2, y ≠ x₀ → 0 < pcgbPxQuad H x₀ y := by
    intro y hy
    show 0 < ∑ a : Fin 2, ∑ c : Fin 2, H a c * (y - x₀) a * (y - x₀) c
    have hv0 : (fun a => (y - x₀) a : Fin 2 → ℝ) ≠ 0 := by
      intro h0
      apply hy
      rw [← sub_eq_zero]
      ext a
      simpa using congrFun h0 a
    have hpd' := hH.dotProduct_mulVec_pos hv0
    have hform : star (fun a => (y - x₀) a : Fin 2 → ℝ) ⬝ᵥ
        H.mulVec (fun a => (y - x₀) a) =
        ∑ a : Fin 2, ∑ c : Fin 2, H a c * (y - x₀) a * (y - x₀) c := by
      simp only [dotProduct, Matrix.mulVec, Fin.sum_univ_two, star_trivial, Pi.star_apply]
      ring
    rw [← hform]
    exact hpd'
  have hsH : H 1 0 = H 0 1 := by
    have := hH.isHermitian.apply 1 0
    simpa using this.symm
  have hsM : M 1 0 = M 0 1 := hM 1 0
  
  have t_trace : ∀ x : E2, x ≠ x₀ →
      ∑ i : Fin 2, ∑ j : Fin 2, H⁻¹ i j * pcgbPsiG2 H M x₀ i j x =
        (pcgbPxQuad M x₀ x - pcgbPxMu H M * pcgbPxQuad H x₀ x) / (2 * pcgbPxQuad H x₀ x) := by
    intro x hx
    have hQ := hQpos x hx
    have hinv : H⁻¹ = (H.det)⁻¹ • !![H 1 1, -H 0 1; -H 1 0, H 0 0] := by
      rw [Matrix.inv_def, Matrix.adjugate_fin_two, Ring.inverse_eq_inv']
    have hdet : H.det = H 0 0 * H 1 1 - H 0 1 * H 1 0 := Matrix.det_fin_two H
    have hd : H.det ≠ 0 := hH.det_pos.ne'
    have hQe : pcgbPxQuad H x₀ x =
        H 0 0 * (x - x₀) 0 * (x - x₀) 0 + H 0 1 * (x - x₀) 0 * (x - x₀) 1 +
        (H 1 0 * (x - x₀) 1 * (x - x₀) 0 + H 1 1 * (x - x₀) 1 * (x - x₀) 1) := by
      simp [pcgbPxQuad, Fin.sum_univ_two]
    have hQme : pcgbPxQuad M x₀ x =
        M 0 0 * (x - x₀) 0 * (x - x₀) 0 + M 0 1 * (x - x₀) 0 * (x - x₀) 1 +
        (M 1 0 * (x - x₀) 1 * (x - x₀) 0 + M 1 1 * (x - x₀) 1 * (x - x₀) 1) := by
      simp [pcgbPxQuad, Fin.sum_univ_two]
    unfold pcgbPsiG2 pcgbPxMu
    rw [hQme]
    generalize hq : pcgbPxQuad H x₀ x = q at hQ hQe ⊢
    rw [hinv]
    simp only [Fin.sum_univ_two, Matrix.smul_apply, Matrix.of_apply, Matrix.cons_val',
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.empty_val',
      Matrix.cons_val_fin_one, smul_eq_mul]
    simp only [hsH, hsM] at hQe hdet ⊢
    generalize H.det = d at hd hdet ⊢
    generalize Real.log q = lg
    generalize (x - x₀) 0 = w0 at hQe ⊢
    generalize (x - x₀) 1 = w1 at hQe ⊢
    have hq0 : q ≠ 0 := hQ.ne'
    field_simp
    subst hQe hdet
    ring
  
  have t_first : ∀ y : E2, y ≠ x₀ → ∀ j : Fin 2,
      pd2 j (pcgbPxPsi H M x₀) y = pcgbPsiG1 H M x₀ j y := by
    intro y hy j
    have hQ := hQpos y hy
    have hd := (((t_hasQ M x₀ y).sub ((t_hasQ H x₀ y).const_mul (pcgbPxMu H M))).mul
      ((t_hasQ H x₀ y).log hQ.ne')).mul_const ((16 : ℝ)⁻¹)
    have hd' := hd.congr_of_eventuallyEq (f₁ := pcgbPxPsi H M x₀)
      (Filter.Eventually.of_forall fun z => by
        simp only [pcgbPxPsi, Pi.mul_apply, Pi.sub_apply, div_eq_mul_inv])
    unfold pd2
    rw [hd'.fderiv]
    simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.sub_apply, smul_eq_mul, t_evalQ, Pi.sub_apply]
    unfold pcgbPsiG1
    generalize Real.log (pcgbPxQuad H x₀ y) = lg
    generalize pcgbPxQuad M x₀ y = qm
    generalize hq : pcgbPxQuad H x₀ y = q at hQ ⊢
    have hq0 : q ≠ 0 := hQ.ne'
    fin_cases j <;> simp only [Fin.sum_univ_two, Fin.zero_eta, Fin.mk_one, Fin.isValue] <;>
      rw [hsH, hsM] <;> field_simp <;> ring
  
  have t_second : ∀ x : E2, x ≠ x₀ → ∀ i j : Fin 2,
      pd2 i (pcgbPsiG1 H M x₀ j) x = pcgbPsiG2 H M x₀ i j x := by
    intro x hx i j
    have hQ := hQpos x hx
    set N : Matrix (Fin 2) (Fin 2) ℝ := M - pcgbPxMu H M • H with hN
    have hNe : ∀ a c : Fin 2, N a c = M a c - pcgbPxMu H M * H a c := fun a c => by
      simp [hN]
    have hn := (t_hasQ M x₀ x).sub ((t_hasQ H x₀ x).const_mul (pcgbPxMu H M))
    have hinv := (hasDerivAt_inv hQ.ne').comp_hasFDerivAt x (t_hasQ H x₀ x)
    have hd := ((((t_lin N x₀ x j).mul ((t_hasQ H x₀ x).log hQ.ne')).mul_const ((8 : ℝ)⁻¹)).add
      (((hn.mul (t_lin H x₀ x j)).mul hinv).mul_const ((8 : ℝ)⁻¹)))
    have hd' := hd.congr_of_eventuallyEq (f₁ := pcgbPsiG1 H M x₀ j)
      (Filter.Eventually.of_forall fun z => by
        simp only [pcgbPsiG1, hNe, Function.comp_apply, Pi.add_apply, Pi.mul_apply, Pi.sub_apply]
        ring)
    unfold pd2
    rw [hd'.fderiv]
    simp only [ContinuousLinearMap.smul_apply, ContinuousLinearMap.add_apply,
      ContinuousLinearMap.sub_apply, smul_eq_mul, t_evalQ, t_evalL,
      Function.comp_apply, Pi.sub_apply, Pi.mul_apply]
    unfold pcgbPsiG2
    simp only [hNe]
    generalize Real.log (pcgbPxQuad H x₀ x) = lg
    generalize pcgbPxQuad M x₀ x = qm
    generalize hq : pcgbPxQuad H x₀ x = q at hQ ⊢
    have hq0 : q ≠ 0 := hQ.ne'
    fin_cases i <;> fin_cases j <;>
      simp only [Fin.sum_univ_two, Fin.zero_eta, Fin.mk_one, Fin.isValue] <;>
      rw [hsH, hsM] <;> field_simp <;> ring
  obtain ⟨hQs, -⟩ := t_iter3 H x₀
  obtain ⟨hQms, -⟩ := t_iter3 M x₀
  have hψ : ContDiffOn ℝ ∞ (pcgbPxPsi H M x₀) {x | x ≠ x₀} := by
    show ContDiffOn ℝ ∞ (fun x => (pcgbPxQuad M x₀ x - pcgbPxMu H M * pcgbPxQuad H x₀ x) *
      Real.log (pcgbPxQuad H x₀ x) / 16) {x | x ≠ x₀}
    exact ((hQms.contDiffOn.sub (contDiffOn_const.mul hQs.contDiffOn)).mul
      (hQs.contDiffOn.log fun y hy => (hQpos y hy).ne')).div_const 16
  obtain ⟨φ, hφdef⟩ : ∃ φ : E2 → ℝ, φ = fun z => pcgbPxPsi H M x₀ (x₀ + z) := ⟨_, rfl⟩
  obtain ⟨A₈, hA₈⟩ : ∃ A₈ : Matrix (Fin 2) (Fin 2) ℝ,
      A₈ = (1 / 8 : ℝ) • (M - pcgbPxMu H M • H) := ⟨_, rfl⟩
  obtain ⟨n₀, hn₀def⟩ : ∃ n₀ : E2 → ℝ, n₀ = fun z => pcgbPxQuad A₈ x₀ (x₀ + z) := ⟨_, rfl⟩
  obtain ⟨hA₈s, hA₈3⟩ := t_iter3 A₈ x₀
  have hshift : ContDiff ℝ ∞ (fun z : E2 => x₀ + z) := contDiff_const.add contDiff_id
  have hφs : ContDiffOn ℝ ∞ φ {z | z ≠ 0} := by
    rw [hφdef]
    refine hψ.comp hshift.contDiffOn ?_
    intro z hz
    simpa using hz
  have hn₀s : ContDiff ℝ ∞ n₀ := by
    rw [hn₀def]
    exact hA₈s.comp hshift
  have hn₀3 : ∀ z : E2, iteratedFDeriv ℝ 3 n₀ z = 0 := by
    intro z
    rw [hn₀def, iteratedFDeriv_comp_add_left]
    exact hA₈3 _
  have hn₀v : ∀ z : E2, n₀ z =
      (pcgbPxQuad M x₀ (x₀ + z) - pcgbPxMu H M * pcgbPxQuad H x₀ (x₀ + z)) / 8 := by
    intro z
    rw [hn₀def, hA₈]
    simp only [pcgbPxQuad, Matrix.smul_apply, Matrix.sub_apply, smul_eq_mul, Fin.sum_univ_two]
    ring
  have hQsc : ∀ (A : Matrix (Fin 2) (Fin 2) ℝ) (t : ℝ) (z : E2),
      pcgbPxQuad A x₀ (x₀ + t • z) = t ^ 2 * pcgbPxQuad A x₀ (x₀ + z) := by
    intro A t z
    simp only [pcgbPxQuad, add_sub_cancel_left, PiLp.smul_apply, smul_eq_mul, Fin.sum_univ_two]
    ring
  have hscale : ∀ t : ℝ, 0 < t → ∀ z : E2,
      φ (t • z) = t ^ 2 * φ z + t ^ 2 * Real.log t * n₀ z := by
    intro t ht z
    rw [hn₀v z, hφdef]
    show pcgbPxPsi H M x₀ (x₀ + t • z) =
      t ^ 2 * pcgbPxPsi H M x₀ (x₀ + z) + t ^ 2 * Real.log t *
        ((pcgbPxQuad M x₀ (x₀ + z) - pcgbPxMu H M * pcgbPxQuad H x₀ (x₀ + z)) / 8)
    unfold pcgbPxPsi
    rw [hQsc H, hQsc M]
    by_cases hz : z = 0
    · subst hz
      have h1 : pcgbPxQuad H x₀ (x₀ + 0) = 0 := by simp [pcgbPxQuad]
      have h2 : pcgbPxQuad M x₀ (x₀ + 0) = 0 := by simp [pcgbPxQuad]
      rw [h1, h2]
      simp
    · have ha := hQpos (x₀ + z) (by simpa using hz)
      have ht2 : t ^ 2 ≠ 0 := by positivity
      rw [Real.log_mul ht2 ha.ne', Real.log_pow]
      push_cast
      ring
  obtain ⟨B, hB0, hBb⟩ := t_bounds φ n₀ hφs hn₀s hn₀3
    (t_scaling φ n₀ hφs hn₀s hscale)
  have hpdcongr : ∀ (i : Fin 2) (x : E2) (f g : E2 → ℝ), f =ᶠ[𝓝 x] g → pd2 i f x = pd2 i g x := by
    intro i x f g h
    unfold pd2
    rw [h.fderiv_eq]
  refine ⟨hψ, B, hB0, fun x h0 _ => ?_⟩
  have hne : x ≠ x₀ := dist_pos.mp h0
  have hz : x - x₀ ≠ 0 := sub_ne_zero.mpr hne
  have hnz : ‖x - x₀‖ = dist x x₀ := (dist_eq_norm x x₀).symm
  have hxz : x₀ + (x - x₀) = x := by abel
  have hiter : ∀ k : ℕ, iteratedFDeriv ℝ k φ (x - x₀) =
      iteratedFDeriv ℝ k (pcgbPxPsi H M x₀) x := by
    intro k
    rw [hφdef, iteratedFDeriv_comp_add_left, hxz]
  obtain ⟨b0, b1, b2, b3⟩ := hBb (x - x₀) hz
  rw [hnz] at b0 b1 b2 b3
  refine ⟨?_, ?_, ?_, ?_, ?_⟩
  · have hpd : ∀ i j : Fin 2, pd2 i (pd2 j (pcgbPxPsi H M x₀)) x = pcgbPsiG2 H M x₀ i j x := by
      intro i j
      rw [← t_second x hne i j]
      apply hpdcongr
      filter_upwards [isOpen_ne.mem_nhds hne] with y hy
      exact t_first y hy j
    rw [← t_trace x hne]
    simp only [hpd]
  · have e : φ (x - x₀) = pcgbPxPsi H M x₀ x := by rw [hφdef]; simp only [hxz]
    rw [e, Real.norm_eq_abs] at b0
    exact b0
  · rw [← norm_iteratedFDeriv_one, hiter 1, norm_iteratedFDeriv_one] at b1
    exact b1
  · rw [← norm_iteratedFDeriv_one, norm_iteratedFDeriv_fderiv]
    rw [hiter 2] at b2
    exact b2
  · rw [hiter 3] at b3
    exact b3

theorem pcgb_lap2_half_log (V : Set E2) (hV : IsOpen V) (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (D : E2 → ℝ) (hD : ContDiffOn ℝ 2 D V) (hpos : ∀ x ∈ V, 0 < D x) :
    ∀ x ∈ V, lap2 h (fun y => (1 / 2 : ℝ) * Real.log (D y)) x =
      lap2 h D x / (2 * D x) -
        (∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a D x * pd2 c D x) / (2 * D x ^ 2) :=
by
  intro x hx
  have hVx : V ∈ 𝓝 x := hV.mem_nhds hx
  have hdiff : ∀ y ∈ V, DifferentiableAt ℝ D y := fun y hy =>
    (hD.contDiffAt (hV.mem_nhds hy)).differentiableAt (by norm_num)
  
  have hfirst : ∀ y ∈ V, ∀ j : Fin 2,
      pd2 j (fun y => (1 / 2 : ℝ) * Real.log (D y)) y = pd2 j D y * (2 * D y)⁻¹ := by
    intro y hy j
    have hDy : D y ≠ 0 := (hpos y hy).ne'
    have h1 := ((hdiff y hy).hasFDerivAt.log hDy).const_mul (1 / 2 : ℝ)
    show fderiv ℝ (fun y => (1 / 2 : ℝ) * Real.log (D y)) y (e2 j) = fderiv ℝ D y (e2 j) * _
    rw [h1.fderiv]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    rw [mul_inv]
    ring
  have hev : ∀ j : Fin 2, pd2 j (fun y => (1 / 2 : ℝ) * Real.log (D y)) =ᶠ[𝓝 x]
      (fun y => pd2 j D y * (2 * D y)⁻¹) :=
    fun j => Filter.eventually_of_mem hVx (fun y hy => hfirst y hy j)
  
  have hC2 : ContDiffAt ℝ 2 D x := hD.contDiffAt hVx
  have hfd : DifferentiableAt ℝ (fderiv ℝ D) x :=
    (hC2.fderiv_right (m := 1) (by norm_num)).differentiableAt (by norm_num)
  have hpdj : ∀ j : Fin 2, DifferentiableAt ℝ (pd2 j D) x := fun j => by
    show DifferentiableAt ℝ (fun y => fderiv ℝ D y (e2 j)) x
    exact hfd.clm_apply (differentiableAt_const _)
  have hDx : D x ≠ 0 := (hpos x hx).ne'
  have hq0 : (2 * D x) ≠ 0 := mul_ne_zero two_ne_zero hDx
  have hq : HasFDerivAt (fun y => 2 * D y) ((2 : ℝ) • fderiv ℝ D x) x :=
    (hdiff x hx).hasFDerivAt.const_mul 2
  have hr : HasFDerivAt (fun y => (2 * D y)⁻¹)
      ((-((2 * D x) ^ 2)⁻¹) • ((2 : ℝ) • fderiv ℝ D x)) x :=
    (hasDerivAt_inv hq0).comp_hasFDerivAt x hq
  
  have hsecond : ∀ i j : Fin 2, pd2 i (pd2 j (fun y => (1 / 2 : ℝ) * Real.log (D y))) x =
      pd2 i (pd2 j D) x * (2 * D x)⁻¹ - pd2 j D x * pd2 i D x * (2 * D x ^ 2)⁻¹ := by
    intro i j
    have hprod : HasFDerivAt (fun y => pd2 j D y * (2 * D y)⁻¹)
        (pd2 j D x • ((-((2 * D x) ^ 2)⁻¹) • ((2 : ℝ) • fderiv ℝ D x)) +
          (2 * D x)⁻¹ • fderiv ℝ (pd2 j D) x) x :=
      (hpdj j).hasFDerivAt.mul hr
    have e1 : pd2 i (pd2 j (fun y => (1 / 2 : ℝ) * Real.log (D y))) x =
        fderiv ℝ (fun y => pd2 j D y * (2 * D y)⁻¹) x (e2 i) := by
      show fderiv ℝ (pd2 j (fun y => (1 / 2 : ℝ) * Real.log (D y))) x (e2 i) = _
      rw [(hev j).fderiv_eq]
    rw [e1, hprod.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    rw [show fderiv ℝ D x (e2 i) = pd2 i D x from rfl,
      show fderiv ℝ (pd2 j D) x (e2 i) = pd2 i (pd2 j D) x from rfl]
    field_simp
    ring
  unfold lap2
  simp only [hsecond]
  simp only [hfirst x hx]
  simp only [Fin.sum_univ_two]
  field_simp
  ring

theorem pcgb_holder_half_of_grad (F : E2 → ℝ) (x₀ : E2) (K : ℝ) (hK : 0 ≤ K)
    (hd : ∀ x : E2, x ≠ x₀ → DifferentiableAt ℝ F x)
    (hg : ∀ x : E2, x ≠ x₀ → ‖fderiv ℝ F x‖ ≤ K / Real.sqrt (dist x x₀))
    (hv : ∀ x : E2, |F x - F x₀| ≤ K * Real.sqrt (dist x x₀)) :
    ∀ x y : E2, |F x - F y| ≤ 3 * K * dist x y ^ (1 / 2 : ℝ) :=
by
  intro x y
  wlog hxy : dist y x₀ ≤ dist x x₀ generalizing x y
  · have h := this y x (le_of_lt (not_le.mp hxy))
    rw [abs_sub_comm, dist_comm]
    exact h
  rw [← Real.sqrt_eq_rpow]
  have hr0 : 0 ≤ dist x x₀ := dist_nonneg
  have hd0 : 0 ≤ dist x y := dist_nonneg
  have hs0 : 0 ≤ dist y x₀ := dist_nonneg
  have ha0 := Real.sqrt_nonneg (dist x x₀)
  have hb0 := Real.sqrt_nonneg (dist x y)
  have ha := Real.sq_sqrt hr0
  have hb := Real.sq_sqrt hd0
  rcases le_or_gt (4 * dist x x₀) (9 * dist x y) with hA | hB
  · 
    have h1 : |F x - F y| ≤ |F x - F x₀| + |F y - F x₀| := by
      have := abs_sub_le (F x) (F x₀) (F y)
      rwa [abs_sub_comm (F x₀) (F y)] at this
    have h2 := hv x
    have h3 := hv y
    have h4 : Real.sqrt (dist y x₀) ≤ Real.sqrt (dist x x₀) := Real.sqrt_le_sqrt hxy
    have h5 : 2 * Real.sqrt (dist x x₀) ≤ 3 * Real.sqrt (dist x y) := by
      nlinarith [sq_nonneg (2 * Real.sqrt (dist x x₀) - 3 * Real.sqrt (dist x y)),
        mul_nonneg ha0 hb0]
    have h6 : K * (2 * Real.sqrt (dist x x₀)) ≤ K * (3 * Real.sqrt (dist x y)) :=
      mul_le_mul_of_nonneg_left h5 hK
    have h7 : K * Real.sqrt (dist y x₀) ≤ K * Real.sqrt (dist x x₀) :=
      mul_le_mul_of_nonneg_left h4 hK
    nlinarith
  · 
    have hrpos : 0 < dist x x₀ := by linarith
    have hball : ∀ z ∈ Metric.closedBall x (dist x y),
        z ≠ x₀ ∧ dist x x₀ ≤ 4 * dist z x₀ := by
      intro z hz
      rw [Metric.mem_closedBall] at hz
      have ht := dist_triangle x z x₀
      rw [dist_comm x z] at ht
      have h4 : dist x x₀ ≤ 4 * dist z x₀ := by linarith
      refine ⟨?_, h4⟩
      intro hzx
      rw [hzx, dist_self] at h4
      linarith
    have hsr : 0 < Real.sqrt (dist x x₀) := Real.sqrt_pos.mpr hrpos
    have hder : ∀ z ∈ Metric.closedBall x (dist x y), DifferentiableAt ℝ F z :=
      fun z hz => hd z (hball z hz).1
    have hbound : ∀ z ∈ Metric.closedBall x (dist x y),
        ‖fderiv ℝ F z‖ ≤ 2 * K / Real.sqrt (dist x x₀) := by
      intro z hz
      obtain ⟨hz0, hz4⟩ := hball z hz
      have ht : 0 < dist z x₀ := dist_pos.mpr hz0
      have hst : 0 < Real.sqrt (dist z x₀) := Real.sqrt_pos.mpr ht
      have hc := Real.sq_sqrt ht.le
      have h1 : Real.sqrt (dist x x₀) ≤ 2 * Real.sqrt (dist z x₀) := by
        nlinarith [sq_nonneg (Real.sqrt (dist x x₀) - 2 * Real.sqrt (dist z x₀)),
          mul_nonneg ha0 hst.le]
      calc ‖fderiv ℝ F z‖ ≤ K / Real.sqrt (dist z x₀) := hg z hz0
        _ ≤ 2 * K / Real.sqrt (dist x x₀) := by
          rw [div_le_div_iff₀ hst hsr]
          have := mul_le_mul_of_nonneg_left h1 hK
          linarith
    have hyB : y ∈ Metric.closedBall x (dist x y) := by
      rw [Metric.mem_closedBall, dist_comm]
    have hmvt := Convex.norm_image_sub_le_of_norm_fderiv_le hder hbound
      (convex_closedBall x (dist x y)) (Metric.mem_closedBall_self hd0) hyB
    rw [Real.norm_eq_abs, ← dist_eq_norm, dist_comm y x] at hmvt
    have hdr : dist x y ≤ dist x x₀ := by linarith
    have hsq : dist x y ≤ Real.sqrt (dist x y) * Real.sqrt (dist x x₀) := by
      have e1 := Real.mul_self_sqrt hd0
      have e2 := Real.sqrt_le_sqrt hdr
      nlinarith
    have hfin : 2 * K / Real.sqrt (dist x x₀) * dist x y ≤ 2 * K * Real.sqrt (dist x y) := by
      rw [div_mul_eq_mul_div, div_le_iff₀ hsr]
      have := mul_le_mul_of_nonneg_left hsq (by linarith : (0 : ℝ) ≤ 2 * K)
      linarith
    rw [abs_sub_comm]
    have hKb : 0 ≤ K * Real.sqrt (dist x y) := mul_nonneg hK hb0
    linarith

theorem pcgb_px_quad_bounds (A : Matrix (Fin 2) (Fin 2) ℝ) (x₀ : E2) :
    ContDiff ℝ ∞ (pcgbPxQuad A x₀) ∧ ∀ y : E2,
      |pcgbPxQuad A x₀ y| ≤ (∑ a : Fin 2, ∑ c : Fin 2, |A a c|) * dist y x₀ ^ 2 ∧
      ‖fderiv ℝ (pcgbPxQuad A x₀) y‖ ≤ 2 * (∑ a : Fin 2, ∑ c : Fin 2, |A a c|) * dist y x₀ ∧
      ‖fderiv ℝ (fderiv ℝ (pcgbPxQuad A x₀)) y‖ ≤ 2 * (∑ a : Fin 2, ∑ c : Fin 2, |A a c|) :=
by
  set ℓ : Fin 2 → (E2 →L[ℝ] ℝ) := fun a => EuclideanSpace.proj a with hℓdef
  have hℓv : ∀ (a : Fin 2) (v : E2), ℓ a v = v a := fun a v => rfl
  have hℓn : ∀ a, ‖ℓ a‖ ≤ 1 := fun a =>
    ContinuousLinearMap.opNorm_le_bound _ zero_le_one (fun v => by
      rw [hℓv, one_mul]; exact PiLp.norm_apply_le v a)
  have hz : ∀ (a : Fin 2) (y : E2), |(y - x₀) a| ≤ dist y x₀ := fun a y => by
    rw [dist_eq_norm, ← Real.norm_eq_abs]; exact PiLp.norm_apply_le _ _
  have hzd : ∀ (a : Fin 2) (y : E2), HasFDerivAt (fun y : E2 => (y - x₀) a) (ℓ a) y := by
    intro a y
    have e : (fun y : E2 => (y - x₀) a) = fun y => ℓ a y - ℓ a x₀ := by
      funext w; exact (ℓ a).map_sub w x₀
    rw [e]; exact ((ℓ a).hasFDerivAt).sub_const _
  have hzc : ∀ a : Fin 2, ContDiff ℝ ∞ (fun y : E2 => (y - x₀) a) := fun a =>
    ((EuclideanSpace.proj a : E2 →L[ℝ] ℝ).contDiff).comp (contDiff_id.sub contDiff_const)
  have eQ : pcgbPxQuad A x₀ =
      fun y => ∑ a : Fin 2, ∑ c : Fin 2, A a c * ((y - x₀) a * (y - x₀) c) := by
    funext w; simp only [pcgbPxQuad, mul_assoc]
  have hQd : ∀ y, HasFDerivAt (pcgbPxQuad A x₀)
      (∑ a : Fin 2, ∑ c : Fin 2, A a c • ((y - x₀) a • ℓ c + (y - x₀) c • ℓ a)) y := by
    intro y
    rw [eQ]
    refine HasFDerivAt.fun_sum (fun a _ => HasFDerivAt.fun_sum (fun c _ => ?_))
    exact ((hzd a y).fun_mul (hzd c y)).const_mul (A a c)
  set H : E2 →L[ℝ] (E2 →L[ℝ] ℝ) := ∑ a : Fin 2, ∑ c : Fin 2,
    A a c • ((ℓ a).smulRight (ℓ c) + (ℓ c).smulRight (ℓ a)) with hHdef
  have hfQ : fderiv ℝ (pcgbPxQuad A x₀) =
      fun y => ∑ a : Fin 2, ∑ c : Fin 2, A a c • ((y - x₀) a • ℓ c + (y - x₀) c • ℓ a) :=
    funext fun y => (hQd y).fderiv
  have hPd : ∀ y, HasFDerivAt
      (fun y => ∑ a : Fin 2, ∑ c : Fin 2, A a c • ((y - x₀) a • ℓ c + (y - x₀) c • ℓ a)) H y := by
    intro y
    refine HasFDerivAt.fun_sum (fun a _ => HasFDerivAt.fun_sum (fun c _ => ?_))
    have h1 : HasFDerivAt (fun y : E2 => (y - x₀) a • ℓ c + (y - x₀) c • ℓ a)
        ((ℓ a).smulRight (ℓ c) + (ℓ c).smulRight (ℓ a)) y :=
      ((hzd a y).smul_const (ℓ c)).add ((hzd c y).smul_const (ℓ a))
    exact h1.const_smul (A a c)
  refine ⟨?_, fun y => ⟨?_, ?_, ?_⟩⟩
  · rw [eQ]
    exact ContDiff.sum (fun a _ => ContDiff.sum (fun c _ =>
      contDiff_const.mul ((hzc a).mul (hzc c))))
  · have key : |pcgbPxQuad A x₀ y| ≤ ∑ a : Fin 2, ∑ c : Fin 2, |A a c| * dist y x₀ ^ 2 := by
      rw [eQ]
      refine (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun a _ =>
        (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun c _ => ?_))
      rw [abs_mul, abs_mul]
      have h1 := hz a y
      have h2 := hz c y
      have h3 := mul_le_mul h1 h2 (abs_nonneg _) dist_nonneg
      exact mul_le_mul_of_nonneg_left (by nlinarith) (abs_nonneg _)
    refine key.trans (le_of_eq ?_)
    simp only [Fin.sum_univ_two]
    ring
  · rw [hfQ]
    have key : ‖∑ a : Fin 2, ∑ c : Fin 2, A a c • ((y - x₀) a • ℓ c + (y - x₀) c • ℓ a)‖ ≤
        ∑ a : Fin 2, ∑ c : Fin 2, |A a c| * (2 * dist y x₀) := by
      refine (norm_sum_le _ _).trans (Finset.sum_le_sum fun a _ =>
        (norm_sum_le _ _).trans (Finset.sum_le_sum fun c _ => ?_))
      have t : ‖(y - x₀) a • ℓ c + (y - x₀) c • ℓ a‖ ≤ 2 * dist y x₀ := by
        refine (norm_add_le _ _).trans ?_
        rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs]
        have k1 := mul_le_mul (hz a y) (hℓn c) (norm_nonneg _) dist_nonneg
        have k2 := mul_le_mul (hz c y) (hℓn a) (norm_nonneg _) dist_nonneg
        linarith
      rw [norm_smul, Real.norm_eq_abs]
      exact mul_le_mul_of_nonneg_left t (abs_nonneg _)
    refine key.trans (le_of_eq ?_)
    simp only [Fin.sum_univ_two]
    ring
  · rw [hfQ, (hPd y).fderiv, hHdef]
    have key : ‖∑ a : Fin 2, ∑ c : Fin 2,
        A a c • ((ℓ a).smulRight (ℓ c) + (ℓ c).smulRight (ℓ a))‖ ≤
        ∑ a : Fin 2, ∑ c : Fin 2, |A a c| * 2 := by
      have hs1 := norm_sum_le (Finset.univ : Finset (Fin 2))
        (fun a : Fin 2 => (∑ c : Fin 2,
          A a c • ((ℓ a).smulRight (ℓ c) + (ℓ c).smulRight (ℓ a)) : E2 →L[ℝ] (E2 →L[ℝ] ℝ)))
      refine le_trans hs1 ?_
      refine Finset.sum_le_sum fun a _ => ?_
      have hs2 := norm_sum_le (Finset.univ : Finset (Fin 2))
        (fun c : Fin 2 =>
          (A a c • ((ℓ a).smulRight (ℓ c) + (ℓ c).smulRight (ℓ a)) : E2 →L[ℝ] (E2 →L[ℝ] ℝ)))
      refine le_trans hs2 ?_
      refine Finset.sum_le_sum fun c _ => ?_
      have t : ‖(ℓ a).smulRight (ℓ c) + (ℓ c).smulRight (ℓ a)‖ ≤ 2 := by
        have hadd := norm_add_le ((ℓ a).smulRight (ℓ c)) ((ℓ c).smulRight (ℓ a))
        rw [ContinuousLinearMap.norm_smulRight_apply,
          ContinuousLinearMap.norm_smulRight_apply] at hadd
        have k1 := mul_le_one₀ (hℓn a) (norm_nonneg _) (hℓn c)
        have k2 := mul_le_one₀ (hℓn c) (norm_nonneg _) (hℓn a)
        linarith
      have hsm := ContinuousLinearMap.opNorm_smul_le (A a c)
        ((ℓ a).smulRight (ℓ c) + (ℓ c).smulRight (ℓ a))
      rw [Real.norm_eq_abs] at hsm
      exact hsm.trans (mul_le_mul_of_nonneg_left t (abs_nonneg _))
    refine key.trans (le_of_eq ?_)
    simp only [Fin.sum_univ_two]
    ring

theorem pcgb_px_pole_bounds (x₀ : E2) (σ : ℝ) (hσ : 0 < σ) (hσ1 : σ ≤ 1) (D Q : E2 → ℝ)
    (hD : ContDiff ℝ ∞ D) (hQ : ContDiff ℝ ∞ Q) (c₀ l Λ K : ℝ) (hc₀ : 0 < c₀) (hl : 0 < l)
    (hΛ : 0 ≤ Λ) (hK : 0 ≤ K)
    (hyp : ∀ x : E2, 0 < dist x x₀ → dist x x₀ < σ →
      c₀ * dist x x₀ ^ 2 ≤ D x ∧ l * dist x x₀ ^ 2 ≤ Q x ∧ Q x ≤ Λ * dist x x₀ ^ 2 ∧
      ‖fderiv ℝ Q x‖ ≤ Λ * dist x x₀ ∧ ‖fderiv ℝ (fderiv ℝ Q) x‖ ≤ Λ ∧
      |D x - Q x| ≤ K * dist x x₀ ^ 3 ∧
      ‖fderiv ℝ (fun y => D y - Q y) x‖ ≤ K * dist x x₀ ^ 2 ∧
      ‖fderiv ℝ (fderiv ℝ (fun y => D y - Q y)) x‖ ≤ K * dist x x₀) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : E2, 0 < dist x x₀ → dist x x₀ < σ →
      |(1 / 2 : ℝ) * Real.log (D x) - Real.log (Real.sqrt (Q x))| ≤ C ∧
      ‖fderiv ℝ (fun y => (1 / 2 : ℝ) * Real.log (D y) - Real.log (Real.sqrt (Q y))) x‖ ≤ C ∧
      ‖fderiv ℝ (fderiv ℝ (fun y => (1 / 2 : ℝ) * Real.log (D y) - Real.log (Real.sqrt (Q y)))) x‖ ≤
        C / dist x x₀ :=
by
  
  have hDd : Differentiable ℝ D := hD.differentiable (by simp)
  have hQd : Differentiable ℝ Q := hQ.differentiable (by simp)
  have hE : ContDiff ℝ ∞ (fun y => D y - Q y) := hD.sub hQ
  have hP1 : Differentiable ℝ (fderiv ℝ Q) :=
    (hQ.fderiv_right (m := ∞) (by simp)).differentiable (by simp)
  have hR1 : Differentiable ℝ (fderiv ℝ (fun y => D y - Q y)) :=
    (hE.fderiv_right (m := ∞) (by simp)).differentiable (by simp)
  have hDD : ∀ y, fderiv ℝ D y = fderiv ℝ Q y + fderiv ℝ (fun z => D z - Q z) y := by
    intro y
    rw [fderiv_fun_sub (hDd y) (hQd y)]
    abel
  
  have hgrad : ∀ y, 0 < D y → 0 < Q y →
      HasFDerivAt (fun z => (1 / 2 : ℝ) * Real.log (D z) - (1 / 2 : ℝ) * Real.log (Q z))
        (((2 * D y)⁻¹ - (2 * Q y)⁻¹) • fderiv ℝ Q y +
          (2 * D y)⁻¹ • fderiv ℝ (fun z => D z - Q z) y) y := by
    intro y hDy hQy
    have h1 := ((hDd y).hasFDerivAt.log hDy.ne').const_mul (1 / 2 : ℝ)
    have h2 := ((hQd y).hasFDerivAt.log hQy.ne').const_mul (1 / 2 : ℝ)
    have h3 : HasFDerivAt (fun z => (1 / 2 : ℝ) * Real.log (D z) - (1 / 2 : ℝ) * Real.log (Q z))
        ((1 / 2 : ℝ) • ((D y)⁻¹ • fderiv ℝ D y) - (1 / 2 : ℝ) • ((Q y)⁻¹ • fderiv ℝ Q y)) y :=
      h1.sub h2
    refine h3.congr_fderiv ?_
    rw [hDD y]
    module
  have hVo : IsOpen ({y : E2 | 0 < D y} ∩ {y : E2 | 0 < Q y}) :=
    (isOpen_lt continuous_const hD.continuous).inter (isOpen_lt continuous_const hQ.continuous)
  have hFgrad : ∀ y ∈ ({y : E2 | 0 < D y} ∩ {y : E2 | 0 < Q y}),
      HasFDerivAt (fun y => (1 / 2 : ℝ) * Real.log (D y) - Real.log (Real.sqrt (Q y)))
        (((2 * D y)⁻¹ - (2 * Q y)⁻¹) • fderiv ℝ Q y +
          (2 * D y)⁻¹ • fderiv ℝ (fun z => D z - Q z) y) y := by
    intro y hy
    refine (hgrad y hy.1 hy.2).congr_of_eventuallyEq ?_
    filter_upwards [hVo.mem_nhds hy] with z hz
    have hz2 : 0 < Q z := hz.2
    show (1 / 2 : ℝ) * Real.log (D z) - Real.log (Real.sqrt (Q z)) =
      (1 / 2 : ℝ) * Real.log (D z) - (1 / 2 : ℝ) * Real.log (Q z)
    rw [Real.log_sqrt hz2.le]
    ring
  
  obtain ⟨A, hA⟩ : ∃ A : ℝ, A = K / (2 * c₀ * l) := ⟨_, rfl⟩
  obtain ⟨B, hB⟩ : ∃ B : ℝ, B = 1 / (2 * c₀) := ⟨_, rfl⟩
  obtain ⟨G, hG⟩ : ∃ G : ℝ, G = K * (2 * Λ + K) / (2 * c₀ ^ 2 * l ^ 2) := ⟨_, rfl⟩
  obtain ⟨Bt, hBt⟩ : ∃ Bt : ℝ, Bt = 1 / (2 * c₀ ^ 2) := ⟨_, rfl⟩
  have hA0 : 0 ≤ A := by rw [hA]; positivity
  have hB0 : 0 ≤ B := by rw [hB]; positivity
  have hG0 : 0 ≤ G := by rw [hG]; positivity
  have hBt0 : 0 ≤ Bt := by rw [hBt]; positivity
  
  have key : ∀ s d q : ℝ, 0 < s → s ≤ 1 → c₀ * s ^ 2 ≤ d → l * s ^ 2 ≤ q → q ≤ Λ * s ^ 2 →
      |d - q| ≤ K * s ^ 3 →
      |(1 / 2 : ℝ) * Real.log d - Real.log (Real.sqrt q)| ≤ (K / l + Λ / c₀) / 2 ∧
      s * |(2 * d)⁻¹ - (2 * q)⁻¹| ≤ A ∧ s ^ 2 * (2 * d)⁻¹ ≤ B ∧
      s ^ 3 * |2 * ((2 * q) ^ 2)⁻¹ - 2 * ((2 * d) ^ 2)⁻¹| ≤ G ∧
      s ^ 4 * (2 * ((2 * d) ^ 2)⁻¹) ≤ Bt := by
    intro s d q hs hs1 hd hq1 hq2 hdq
    have hs2 : 0 < s ^ 2 := by positivity
    have hd0 : 0 < d := lt_of_lt_of_le (by positivity) hd
    have hq0 : 0 < q := lt_of_lt_of_le (by positivity) hq1
    have hd0' : d ≠ 0 := hd0.ne'
    have hq0' : q ≠ 0 := hq0.ne'
    have hs32 : s ^ 3 ≤ s ^ 2 := by
      calc s ^ 3 = s ^ 2 * s := by ring
        _ ≤ s ^ 2 := mul_le_of_le_one_right hs2.le hs1
    have hdq' : d - q ≤ K * s ^ 3 := le_trans (le_abs_self _) hdq
    have hqd : |q - d| ≤ K * s ^ 3 := by rw [abs_sub_comm]; exact hdq
    have hdqprod : c₀ * s ^ 2 * (l * s ^ 2) ≤ d * q := mul_le_mul hd hq1 (by positivity) hd0.le
    refine ⟨?_, ?_, ?_, ?_, ?_⟩
    · rw [Real.log_sqrt hq0.le]
      have hup : Real.log d - Real.log q ≤ K / l := by
        rw [← Real.log_div hd0' hq0']
        refine le_trans (Real.log_le_sub_one_of_pos (div_pos hd0 hq0)) ?_
        rw [div_sub_one hq0', div_le_div_iff₀ hq0 hl]
        have e1 : (d - q) * l ≤ K * s ^ 3 * l := mul_le_mul_of_nonneg_right hdq' hl.le
        have e2 : K * l * s ^ 3 ≤ K * l * s ^ 2 := mul_le_mul_of_nonneg_left hs32 (by positivity)
        have e3 : K * (l * s ^ 2) ≤ K * q := mul_le_mul_of_nonneg_left hq1 hK
        linarith
      have hlo : Real.log q - Real.log d ≤ Λ / c₀ := by
        rw [← Real.log_div hq0' hd0']
        refine le_trans (Real.log_le_sub_one_of_pos (div_pos hq0 hd0)) ?_
        have : q / d ≤ Λ / c₀ := by
          rw [div_le_div_iff₀ hd0 hc₀]
          have e1 : q * c₀ ≤ Λ * s ^ 2 * c₀ := mul_le_mul_of_nonneg_right hq2 hc₀.le
          have e2 : Λ * (c₀ * s ^ 2) ≤ Λ * d := mul_le_mul_of_nonneg_left hd hΛ
          linarith
        linarith
      have hKl : 0 ≤ K / l := by positivity
      have hΛc : 0 ≤ Λ / c₀ := by positivity
      rw [abs_le]
      constructor <;> linarith
    · rw [show (2 * d)⁻¹ - (2 * q)⁻¹ = (q - d) / (2 * d * q) by field_simp, abs_div,
        abs_of_pos (by positivity : (0:ℝ) < 2 * d * q), hA, ← mul_div_assoc,
        div_le_div_iff₀ (by positivity) (by positivity)]
      have e1 : s * |q - d| ≤ s * (K * s ^ 3) := mul_le_mul_of_nonneg_left hqd hs.le
      have e2 := mul_le_mul_of_nonneg_right e1 (by positivity : (0:ℝ) ≤ 2 * c₀ * l)
      have e3 := mul_le_mul_of_nonneg_left hdqprod (by positivity : (0:ℝ) ≤ 2 * K)
      linarith
    · rw [hB, show s ^ 2 * (2 * d)⁻¹ = s ^ 2 / (2 * d) by ring,
        div_le_div_iff₀ (by positivity) (by positivity)]
      linarith
    · have e0 : K * s ^ 3 ≤ K * s ^ 2 := mul_le_mul_of_nonneg_left hs32 hK
      have hsum : d + q ≤ (2 * Λ + K) * s ^ 2 := by linarith
      have hsum0 : 0 < d + q := by positivity
      rw [show 2 * ((2 * q) ^ 2)⁻¹ - 2 * ((2 * d) ^ 2)⁻¹ = (d - q) * (d + q) / (2 * d ^ 2 * q ^ 2) by
          field_simp; ring,
        abs_div, abs_mul, abs_of_pos hsum0, abs_of_pos (by positivity : (0:ℝ) < 2 * d ^ 2 * q ^ 2),
        hG, ← mul_div_assoc, div_le_div_iff₀ (by positivity) (by positivity)]
      have e1 : s ^ 3 * |d - q| ≤ s ^ 3 * (K * s ^ 3) := mul_le_mul_of_nonneg_left hdq (by positivity)
      have e2 : s ^ 3 * |d - q| * (d + q) ≤ s ^ 3 * (K * s ^ 3) * ((2 * Λ + K) * s ^ 2) :=
        mul_le_mul e1 hsum hsum0.le (by positivity)
      have e3 : (c₀ * s ^ 2 * (l * s ^ 2)) ^ 2 ≤ (d * q) ^ 2 :=
        pow_le_pow_left₀ (by positivity) hdqprod 2
      have e4 := mul_le_mul_of_nonneg_left e3 (by positivity : (0:ℝ) ≤ 2 * K * (2 * Λ + K))
      have e5 := mul_le_mul_of_nonneg_right e2 (by positivity : (0:ℝ) ≤ 2 * c₀ ^ 2 * l ^ 2)
      linarith
    · rw [hBt, show s ^ 4 * (2 * ((2 * d) ^ 2)⁻¹) = s ^ 4 / (2 * d ^ 2) by ring,
        div_le_div_iff₀ (by positivity) (by positivity)]
      have e := pow_le_pow_left₀ (by positivity) hd 2
      linarith
  
  have hfin : ∀ s ua b ual β nQ nE mQ mE nA nB N : ℝ, 0 < s → s ≤ 1 →
      s * ua ≤ A → s ^ 2 * b ≤ B → s ^ 3 * ual ≤ G → s ^ 4 * β ≤ Bt →
      0 ≤ ua → 0 ≤ b → 0 ≤ ual → 0 ≤ β →
      0 ≤ nQ → nQ ≤ Λ * s → 0 ≤ nE → nE ≤ K * s ^ 2 → 0 ≤ mQ → mQ ≤ Λ → 0 ≤ mE → mE ≤ K * s →
      0 ≤ nA → nA ≤ ual * nQ + β * nE → 0 ≤ nB → nB ≤ β * (nQ + nE) →
      N ≤ ua * mQ + nA * nQ + (b * mE + nB * nE) →
      N * s ≤ A * Λ + G * Λ ^ 2 + 2 * Bt * K * Λ + B * K + Bt * K ^ 2 := by
    intro s ua b ual β nQ nE mQ mE nA nB N hs hs1 hua hb hual hβ hua0 hb0 hual0 hβ0
      hnQ0 hnQ hnE0 hnE hmQ0 hmQ hmE0 hmE hnA0 hnA hnB0 hnB hN
    have q0 := mul_le_mul_of_nonneg_right hN hs.le
    have q1 : ua * mQ * s ≤ ua * Λ * s :=
      mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hmQ hua0) hs.le
    have q1' : s * ua * Λ ≤ A * Λ := mul_le_mul_of_nonneg_right hua hΛ
    have q2 : nA * (nQ * s) ≤ (ual * nQ + β * nE) * (nQ * s) :=
      mul_le_mul_of_nonneg_right hnA (by positivity)
    have q3 : nQ * nQ ≤ (Λ * s) * (Λ * s) := mul_self_le_mul_self hnQ0 hnQ
    have q3' : ual * s * (nQ * nQ) ≤ ual * s * ((Λ * s) * (Λ * s)) :=
      mul_le_mul_of_nonneg_left q3 (by positivity)
    have q3'' : s ^ 3 * ual * Λ ^ 2 ≤ G * Λ ^ 2 := mul_le_mul_of_nonneg_right hual (sq_nonneg _)
    have q4 : nE * nQ ≤ (K * s ^ 2) * (Λ * s) := mul_le_mul hnE hnQ hnQ0 (by positivity)
    have q4' : β * s * (nE * nQ) ≤ β * s * ((K * s ^ 2) * (Λ * s)) :=
      mul_le_mul_of_nonneg_left q4 (by positivity)
    have q4'' : s ^ 4 * β * (K * Λ) ≤ Bt * (K * Λ) := mul_le_mul_of_nonneg_right hβ (by positivity)
    have q5 : b * s * mE ≤ b * s * (K * s) := mul_le_mul_of_nonneg_left hmE (by positivity)
    have q5' : s ^ 2 * b * K ≤ B * K := mul_le_mul_of_nonneg_right hb hK
    have q6 : nB * (nE * s) ≤ β * (nQ + nE) * (nE * s) :=
      mul_le_mul_of_nonneg_right hnB (by positivity)
    have q7 : (nQ + nE) * nE ≤ (Λ * s + K * s ^ 2) * (K * s ^ 2) :=
      mul_le_mul (add_le_add hnQ hnE) hnE hnE0 (by positivity)
    have q7' : β * s * ((nQ + nE) * nE) ≤ β * s * ((Λ * s + K * s ^ 2) * (K * s ^ 2)) :=
      mul_le_mul_of_nonneg_left q7 (by positivity)
    have q9 : s ^ 4 * β * K ^ 2 * s ≤ s ^ 4 * β * K ^ 2 * 1 :=
      mul_le_mul_of_nonneg_left hs1 (by positivity)
    have q9' : s ^ 4 * β * K ^ 2 ≤ Bt * K ^ 2 := mul_le_mul_of_nonneg_right hβ (sq_nonneg _)
    linarith
  
  have hnorm : ∀ (ax bx : ℝ) (a' b' P R : E2 →L[ℝ] ℝ) (P' R' : E2 →L[ℝ] E2 →L[ℝ] ℝ),
      ‖ax • P' + a'.smulRight P + (bx • R' + b'.smulRight R)‖ ≤
        |ax| * ‖P'‖ + ‖a'‖ * ‖P‖ + (|bx| * ‖R'‖ + ‖b'‖ * ‖R‖) := by
    intro ax bx a' b' P R P' R'
    calc ‖ax • P' + a'.smulRight P + (bx • R' + b'.smulRight R)‖
        ≤ ‖ax • P' + a'.smulRight P‖ + ‖bx • R' + b'.smulRight R‖ :=
          ContinuousLinearMap.opNorm_add_le _ _
      _ ≤ (‖ax • P'‖ + ‖a'.smulRight P‖) + (‖bx • R'‖ + ‖b'.smulRight R‖) :=
          add_le_add (ContinuousLinearMap.opNorm_add_le _ _)
            (ContinuousLinearMap.opNorm_add_le _ _)
      _ ≤ |ax| * ‖P'‖ + ‖a'‖ * ‖P‖ + (|bx| * ‖R'‖ + ‖b'‖ * ‖R‖) := by
          have k1 := ContinuousLinearMap.opNorm_smul_le ax P'
          have k2 := ContinuousLinearMap.opNorm_smul_le bx R'
          rw [Real.norm_eq_abs] at k1 k2
          rw [ContinuousLinearMap.norm_smulRight_apply, ContinuousLinearMap.norm_smulRight_apply]
          linarith
  have hCv : 0 ≤ (K / l + Λ / c₀) / 2 := by positivity
  have hC1 : 0 ≤ A * Λ + B * K := by positivity
  have hC2 : 0 ≤ A * Λ + G * Λ ^ 2 + 2 * Bt * K * Λ + B * K + Bt * K ^ 2 := by positivity
  refine ⟨(K / l + Λ / c₀) / 2 + (A * Λ + B * K) +
      (A * Λ + G * Λ ^ 2 + 2 * Bt * K * Λ + B * K + Bt * K ^ 2), by positivity, ?_⟩
  intro x h1 h2
  obtain ⟨hdx, hqx1, hqx2, hnQ, hmQ, hdq, hnE, hmE⟩ := hyp x h1 h2
  have hs1 : dist x x₀ ≤ 1 := by linarith
  obtain ⟨kv, ka, kb, kα, kβ⟩ := key (dist x x₀) (D x) (Q x) h1 hs1 hdx hqx1 hqx2 hdq
  have hDx : 0 < D x := lt_of_lt_of_le (by positivity) hdx
  have hQx : 0 < Q x := lt_of_lt_of_le (by positivity) hqx1
  have hxV : x ∈ ({y : E2 | 0 < D y} ∩ {y : E2 | 0 < Q y}) := ⟨hDx, hQx⟩
  have hFx := hFgrad x hxV
  have hbx : 0 < (2 * D x)⁻¹ := by positivity
  refine ⟨?_, ?_, ?_⟩
  · linarith
  · rw [hFx.fderiv]
    have hN : ‖((2 * D x)⁻¹ - (2 * Q x)⁻¹) • fderiv ℝ Q x +
        (2 * D x)⁻¹ • fderiv ℝ (fun z => D z - Q z) x‖ ≤
        |(2 * D x)⁻¹ - (2 * Q x)⁻¹| * ‖fderiv ℝ Q x‖ +
          (2 * D x)⁻¹ * ‖fderiv ℝ (fun z => D z - Q z) x‖ := by
      refine (norm_add_le _ _).trans (le_of_eq ?_)
      rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_pos hbx]
    have e1 : |(2 * D x)⁻¹ - (2 * Q x)⁻¹| * ‖fderiv ℝ Q x‖ ≤
        |(2 * D x)⁻¹ - (2 * Q x)⁻¹| * (Λ * dist x x₀) :=
      mul_le_mul_of_nonneg_left hnQ (abs_nonneg _)
    have e2 : dist x x₀ * |(2 * D x)⁻¹ - (2 * Q x)⁻¹| * Λ ≤ A * Λ :=
      mul_le_mul_of_nonneg_right ka hΛ
    have e3 : (2 * D x)⁻¹ * ‖fderiv ℝ (fun z => D z - Q z) x‖ ≤
        (2 * D x)⁻¹ * (K * dist x x₀ ^ 2) :=
      mul_le_mul_of_nonneg_left hnE hbx.le
    have e4 : dist x x₀ ^ 2 * (2 * D x)⁻¹ * K ≤ B * K := mul_le_mul_of_nonneg_right kb hK
    linarith
  · have hev : fderiv ℝ (fun y => (1 / 2 : ℝ) * Real.log (D y) - Real.log (Real.sqrt (Q y)))
        =ᶠ[𝓝 x] (fun y => ((2 * D y)⁻¹ - (2 * Q y)⁻¹) • fderiv ℝ Q y +
          (2 * D y)⁻¹ • fderiv ℝ (fun z => D z - Q z) y) := by
      filter_upwards [hVo.mem_nhds hxV] with y hy
      exact (hFgrad y hy).fderiv
    rw [hev.fderiv_eq]
    have hb : HasFDerivAt (fun y => (2 * D y)⁻¹)
        ((-((2 * D x) ^ 2)⁻¹) • ((2 : ℝ) • fderiv ℝ D x)) x :=
      (hasDerivAt_inv (by positivity : 2 * D x ≠ 0)).comp_hasFDerivAt x
        ((hDd x).hasFDerivAt.const_mul (2 : ℝ))
    have hc : HasFDerivAt (fun y => (2 * Q y)⁻¹)
        ((-((2 * Q x) ^ 2)⁻¹) • ((2 : ℝ) • fderiv ℝ Q x)) x :=
      (hasDerivAt_inv (by positivity : 2 * Q x ≠ 0)).comp_hasFDerivAt x
        ((hQd x).hasFDerivAt.const_mul (2 : ℝ))
    have ha := hb.sub hc
    have hT1 := ha.smul (hP1 x).hasFDerivAt
    have hT2 := hb.smul (hR1 x).hasFDerivAt
    have hΓ : HasFDerivAt (fun y => ((2 * D y)⁻¹ - (2 * Q y)⁻¹) • fderiv ℝ Q y +
          (2 * D y)⁻¹ • fderiv ℝ (fun z => D z - Q z) y)
        (((2 * D x)⁻¹ - (2 * Q x)⁻¹) • fderiv ℝ (fderiv ℝ Q) x +
          ((-((2 * D x) ^ 2)⁻¹) • ((2 : ℝ) • fderiv ℝ D x) -
            (-((2 * Q x) ^ 2)⁻¹) • ((2 : ℝ) • fderiv ℝ Q x)).smulRight (fderiv ℝ Q x) +
          ((2 * D x)⁻¹ • fderiv ℝ (fderiv ℝ (fun z => D z - Q z)) x +
            ((-((2 * D x) ^ 2)⁻¹) • ((2 : ℝ) • fderiv ℝ D x)).smulRight
              (fderiv ℝ (fun z => D z - Q z) x))) x :=
      hT1.add hT2
    rw [hΓ.fderiv, le_div_iff₀ h1]
    have hβ0 : 0 < 2 * ((2 * D x) ^ 2)⁻¹ := by positivity
    have ha'eq : (-((2 * D x) ^ 2)⁻¹) • ((2 : ℝ) • fderiv ℝ D x) -
        (-((2 * Q x) ^ 2)⁻¹) • ((2 : ℝ) • fderiv ℝ Q x) =
        (2 * ((2 * Q x) ^ 2)⁻¹ - 2 * ((2 * D x) ^ 2)⁻¹) • fderiv ℝ Q x -
          (2 * ((2 * D x) ^ 2)⁻¹) • fderiv ℝ (fun z => D z - Q z) x := by
      rw [hDD x]; module
    have hb'eq : (-((2 * D x) ^ 2)⁻¹) • ((2 : ℝ) • fderiv ℝ D x) =
        -((2 * ((2 * D x) ^ 2)⁻¹) • (fderiv ℝ Q x + fderiv ℝ (fun z => D z - Q z) x)) := by
      rw [hDD x]; module
    have hA' : ‖(-((2 * D x) ^ 2)⁻¹) • ((2 : ℝ) • fderiv ℝ D x) -
        (-((2 * Q x) ^ 2)⁻¹) • ((2 : ℝ) • fderiv ℝ Q x)‖ ≤
        |2 * ((2 * Q x) ^ 2)⁻¹ - 2 * ((2 * D x) ^ 2)⁻¹| * ‖fderiv ℝ Q x‖ +
          (2 * ((2 * D x) ^ 2)⁻¹) * ‖fderiv ℝ (fun z => D z - Q z) x‖ := by
      rw [ha'eq]
      refine (norm_sub_le _ _).trans (le_of_eq ?_)
      rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs, abs_of_pos hβ0]
    have hB' : ‖(-((2 * D x) ^ 2)⁻¹) • ((2 : ℝ) • fderiv ℝ D x)‖ ≤
        (2 * ((2 * D x) ^ 2)⁻¹) * (‖fderiv ℝ Q x‖ + ‖fderiv ℝ (fun z => D z - Q z) x‖) := by
      rw [hb'eq, norm_neg, norm_smul, Real.norm_eq_abs, abs_of_pos hβ0]
      exact mul_le_mul_of_nonneg_left (norm_add_le _ _) hβ0.le
    have hN := hnorm ((2 * D x)⁻¹ - (2 * Q x)⁻¹) (2 * D x)⁻¹
      ((-((2 * D x) ^ 2)⁻¹) • ((2 : ℝ) • fderiv ℝ D x) -
        (-((2 * Q x) ^ 2)⁻¹) • ((2 : ℝ) • fderiv ℝ Q x))
      ((-((2 * D x) ^ 2)⁻¹) • ((2 : ℝ) • fderiv ℝ D x))
      (fderiv ℝ Q x) (fderiv ℝ (fun z => D z - Q z) x)
      (fderiv ℝ (fderiv ℝ Q) x) (fderiv ℝ (fderiv ℝ (fun z => D z - Q z)) x)
    rw [abs_of_pos hbx] at hN
    have hfin' := hfin (dist x x₀) _ _ _ _ _ _ ‖fderiv ℝ (fderiv ℝ Q) x‖
      ‖fderiv ℝ (fderiv ℝ (fun z => D z - Q z)) x‖ _ _ _ h1 hs1 ka kb kα kβ (abs_nonneg _) hbx.le
      (abs_nonneg _) hβ0.le (norm_nonneg _) hnQ (norm_nonneg _) hnE
      (ContinuousLinearMap.opNorm_nonneg _) hmQ
      (ContinuousLinearMap.opNorm_nonneg _) hmE (norm_nonneg _) hA' (norm_nonneg _) hB' hN
    linarith

theorem pcgb_px_T_bounds (h : E2 → Matrix (Fin 2) (Fin 2) ℝ) (x₀ x : E2) (V : Set E2)
    (hV : IsOpen V) (hxV : x ∈ V) (ψ : E2 → ℝ) (hψ : ContDiffOn ℝ ∞ ψ V) (B a₁ a₂ a₃ : ℝ)
    (hGd : ∀ i j : Fin 2, DifferentiableAt ℝ (fun z => (h z)⁻¹ i j) x)
    (hγd : ∀ k : Fin 2, DifferentiableAt ℝ
      (fun z => ∑ a : Fin 2, ∑ c : Fin 2, (h z)⁻¹ a c * christoffel2 h k a c z) x)
    (hB : ∀ i j k : Fin 2,
      |(h x)⁻¹ i j - (h x₀)⁻¹ i j| ≤ B * dist x x₀ ∧
      ‖fderiv ℝ (fun z => (h z)⁻¹ i j) x‖ ≤ B ∧
      |∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * christoffel2 h k a c x| ≤ B ∧
      ‖fderiv ℝ (fun z => ∑ a : Fin 2, ∑ c : Fin 2, (h z)⁻¹ a c * christoffel2 h k a c z) x‖ ≤ B)
    (h1 : ‖fderiv ℝ ψ x‖ ≤ a₁) (h2 : ‖fderiv ℝ (fderiv ℝ ψ) x‖ ≤ a₂)
    (h3 : ‖iteratedFDeriv ℝ 3 ψ x‖ ≤ a₃) :
    DifferentiableAt ℝ (fun y => lap2 h ψ y -
      ∑ i : Fin 2, ∑ j : Fin 2, (h x₀)⁻¹ i j * pd2 i (pd2 j ψ) y) x ∧
    |lap2 h ψ x - ∑ i : Fin 2, ∑ j : Fin 2, (h x₀)⁻¹ i j * pd2 i (pd2 j ψ) x| ≤
      4 * B * dist x x₀ * a₂ + 2 * B * a₁ ∧
    ‖fderiv ℝ (fun y => lap2 h ψ y -
      ∑ i : Fin 2, ∑ j : Fin 2, (h x₀)⁻¹ i j * pd2 i (pd2 j ψ) y) x‖ ≤
      4 * B * (a₂ + dist x x₀ * a₃) + 2 * B * (a₁ + a₂) :=
by
  
  have hid : (fun y => lap2 h ψ y -
      ∑ i : Fin 2, ∑ j : Fin 2, (h x₀)⁻¹ i j * pd2 i (pd2 j ψ) y) =
      fun y => ∑ i : Fin 2, ∑ j : Fin 2, ((h y)⁻¹ i j - (h x₀)⁻¹ i j) * pd2 i (pd2 j ψ) y -
        ∑ k : Fin 2, (∑ a : Fin 2, ∑ c : Fin 2, (h y)⁻¹ a c * christoffel2 h k a c y) *
          pd2 k ψ y := by
    funext y
    simp only [lap2, Fin.sum_univ_two]
    ring
  have hidx : lap2 h ψ x - ∑ i : Fin 2, ∑ j : Fin 2, (h x₀)⁻¹ i j * pd2 i (pd2 j ψ) x =
      ∑ i : Fin 2, ∑ j : Fin 2, ((h x)⁻¹ i j - (h x₀)⁻¹ i j) * pd2 i (pd2 j ψ) x -
        ∑ k : Fin 2, (∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * christoffel2 h k a c x) *
          pd2 k ψ x := congrFun hid x
  
  have hB0 : 0 ≤ B := (norm_nonneg _).trans (hB 0 0 0).2.1
  have hs0 : 0 ≤ dist x x₀ := dist_nonneg
  have he : ∀ k : Fin 2, ‖e2 k‖ = 1 := fun k => by simp [e2, EuclideanSpace.norm_single]
  
  have hψ1 : ContDiffOn ℝ ∞ (fderiv ℝ ψ) V := hψ.fderiv_of_isOpen hV le_rfl
  have d1 : ∀ y ∈ V, DifferentiableAt ℝ (fderiv ℝ ψ) y := fun y hy =>
    (hψ1.contDiffAt (hV.mem_nhds hy)).differentiableAt (by simp)
  have d2 : DifferentiableAt ℝ (iteratedFDeriv ℝ 2 ψ) x :=
    (hψ.contDiffAt (hV.mem_nhds hxV)).differentiableAt_iteratedFDeriv
      (WithTop.coe_lt_coe.mpr (ENat.coe_lt_top 2))
  have hQf : ∀ k : Fin 2, ∀ y ∈ V,
      HasFDerivAt (pd2 k ψ) ((fderiv ℝ (fderiv ℝ ψ) y).flip (e2 k)) y := by
    intro k y hy
    have h0 := (d1 y hy).hasFDerivAt.clm_apply (hasFDerivAt_const (e2 k) y)
    convert h0 using 1
    ext v
    simp
  have hp_eq : ∀ i j : Fin 2, pd2 i (pd2 j ψ) =ᶠ[𝓝 x]
      fun y => iteratedFDeriv ℝ 2 ψ y ![e2 i, e2 j] := by
    intro i j
    filter_upwards [hV.mem_nhds hxV] with y hy
    show fderiv ℝ (pd2 j ψ) y (e2 i) = _
    rw [(hQf j y hy).fderiv, ContinuousLinearMap.flip_apply, iteratedFDeriv_two_apply]
    simp
  have hPf : ∀ i j : Fin 2, HasFDerivAt (pd2 i (pd2 j ψ))
      (fderiv ℝ (fun y => iteratedFDeriv ℝ 2 ψ y ![e2 i, e2 j]) x) x :=
    fun i j => ((d2.continuousMultilinear_apply_const ![e2 i, e2 j]).hasFDerivAt).congr_of_eventuallyEq
      (hp_eq i j)
  have h3' : ‖fderiv ℝ (iteratedFDeriv ℝ 2 ψ) x‖ = ‖iteratedFDeriv ℝ 3 ψ x‖ :=
    norm_fderiv_iteratedFDeriv
  have hPn : ∀ i j : Fin 2,
      ‖fderiv ℝ (fun y => iteratedFDeriv ℝ 2 ψ y ![e2 i, e2 j]) x‖ ≤ a₃ := by
    intro i j
    refine ContinuousLinearMap.opNorm_le_bound _ ((norm_nonneg _).trans h3) (fun v => ?_)
    rw [fderiv_continuousMultilinear_apply_const_apply d2]
    calc ‖fderiv ℝ (iteratedFDeriv ℝ 2 ψ) x v ![e2 i, e2 j]‖
        ≤ ‖fderiv ℝ (iteratedFDeriv ℝ 2 ψ) x v‖ * ∏ k : Fin 2, ‖(![e2 i, e2 j] : Fin 2 → E2) k‖ :=
          ContinuousMultilinearMap.le_opNorm _ _
      _ = ‖fderiv ℝ (iteratedFDeriv ℝ 2 ψ) x v‖ := by
          simp [Fin.prod_univ_two, he]
      _ ≤ ‖fderiv ℝ (iteratedFDeriv ℝ 2 ψ) x‖ * ‖v‖ := ContinuousLinearMap.le_opNorm _ _
      _ ≤ a₃ * ‖v‖ := mul_le_mul_of_nonneg_right (h3'.le.trans h3) (norm_nonneg _)
  have hPv : ∀ i j : Fin 2, |pd2 i (pd2 j ψ) x| ≤ a₂ := by
    intro i j
    have hx : pd2 i (pd2 j ψ) x = fderiv ℝ (fderiv ℝ ψ) x (e2 i) (e2 j) := by
      show fderiv ℝ (pd2 j ψ) x (e2 i) = _
      rw [(hQf j x hxV).fderiv, ContinuousLinearMap.flip_apply]
    rw [hx]
    calc |fderiv ℝ (fderiv ℝ ψ) x (e2 i) (e2 j)|
        = ‖fderiv ℝ (fderiv ℝ ψ) x (e2 i) (e2 j)‖ := (Real.norm_eq_abs _).symm
      _ ≤ ‖fderiv ℝ (fderiv ℝ ψ) x‖ * ‖e2 i‖ * ‖e2 j‖ :=
          ContinuousLinearMap.le_opNorm₂ _ _ _
      _ = ‖fderiv ℝ (fderiv ℝ ψ) x‖ := by rw [he, he, mul_one, mul_one]
      _ ≤ a₂ := h2
  have hQv : ∀ k : Fin 2, |pd2 k ψ x| ≤ a₁ := by
    intro k
    calc |pd2 k ψ x| = ‖fderiv ℝ ψ x (e2 k)‖ := (Real.norm_eq_abs _).symm
      _ ≤ ‖fderiv ℝ ψ x‖ * ‖e2 k‖ := ContinuousLinearMap.le_opNorm _ _
      _ = ‖fderiv ℝ ψ x‖ := by rw [he, mul_one]
      _ ≤ a₁ := h1
  have hQn : ∀ k : Fin 2, ‖(fderiv ℝ (fderiv ℝ ψ) x).flip (e2 k)‖ ≤ a₂ := by
    intro k
    have e1 := (fderiv ℝ (fderiv ℝ ψ) x).flip.le_opNorm (e2 k)
    rw [ContinuousLinearMap.opNorm_flip, he, mul_one] at e1
    linarith
  
  have hGf : ∀ i j : Fin 2, HasFDerivAt (fun z => (h z)⁻¹ i j - (h x₀)⁻¹ i j)
      (fderiv ℝ (fun z => (h z)⁻¹ i j) x) x :=
    fun i j => (hGd i j).hasFDerivAt.sub_const _
  have hT : HasFDerivAt (fun y => ∑ i : Fin 2, ∑ j : Fin 2,
        ((h y)⁻¹ i j - (h x₀)⁻¹ i j) * pd2 i (pd2 j ψ) y -
        ∑ k : Fin 2, (∑ a : Fin 2, ∑ c : Fin 2, (h y)⁻¹ a c * christoffel2 h k a c y) *
          pd2 k ψ y)
      (∑ i : Fin 2, ∑ j : Fin 2,
        (((h x)⁻¹ i j - (h x₀)⁻¹ i j) •
            (fderiv ℝ (fun y => iteratedFDeriv ℝ 2 ψ y ![e2 i, e2 j]) x) +
          pd2 i (pd2 j ψ) x • fderiv ℝ (fun z => (h z)⁻¹ i j) x) -
        ∑ k : Fin 2, ((∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * christoffel2 h k a c x) •
            (fderiv ℝ (fderiv ℝ ψ) x).flip (e2 k) +
          pd2 k ψ x • fderiv ℝ
            (fun z => ∑ a : Fin 2, ∑ c : Fin 2, (h z)⁻¹ a c * christoffel2 h k a c z) x)) x := by
    have hsum : ∀ (F : Fin 2 → E2 → ℝ) (F' : Fin 2 → E2 →L[ℝ] ℝ),
        (∀ k, HasFDerivAt (F k) (F' k) x) →
        HasFDerivAt (fun y => ∑ k : Fin 2, F k y) (∑ k : Fin 2, F' k) x := by
      intro F F' hF
      have h0 := HasFDerivAt.sum (u := Finset.univ) (fun k _ => hF k)
      convert h0 using 1
    apply HasFDerivAt.sub
    · refine hsum _ _ (fun i => ?_)
      refine hsum _ _ (fun j => ?_)
      exact (hGf i j).mul (hPf i j)
    · refine hsum _ _ (fun k => ?_)
      exact (hγd k).hasFDerivAt.mul (hQf k x hxV)
  
  have key : ∀ (a b : ℝ) (u w : E2 →L[ℝ] ℝ) (A1 A2 A3 A4 : ℝ), |a| ≤ A1 → ‖u‖ ≤ A2 →
      |b| ≤ A3 → ‖w‖ ≤ A4 → ‖a • u + b • w‖ ≤ A1 * A2 + A3 * A4 := by
    intro a b u w A1 A2 A3 A4 ha hu hb hw
    calc ‖a • u + b • w‖ ≤ ‖a • u‖ + ‖b • w‖ := norm_add_le _ _
      _ = |a| * ‖u‖ + |b| * ‖w‖ := by rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs]
      _ ≤ A1 * A2 + A3 * A4 :=
          add_le_add (mul_le_mul ha hu (norm_nonneg _) ((abs_nonneg _).trans ha))
            (mul_le_mul hb hw (norm_nonneg _) ((abs_nonneg _).trans hb))
  have sum4 : ∀ (F : Fin 2 → Fin 2 → ℝ) (C : ℝ), (∀ i j, |F i j| ≤ C) →
      |∑ i : Fin 2, ∑ j : Fin 2, F i j| ≤ 4 * C := by
    intro F C hF
    calc |∑ i : Fin 2, ∑ j : Fin 2, F i j| ≤ ∑ i : Fin 2, |∑ j : Fin 2, F i j| :=
          Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ i : Fin 2, ∑ j : Fin 2, C := Finset.sum_le_sum fun i _ =>
          (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun j _ => hF i j)
      _ = 4 * C := by simp only [Fin.sum_univ_two]; ring
  have sum2 : ∀ (F : Fin 2 → ℝ) (C : ℝ), (∀ k, |F k| ≤ C) →
      |∑ k : Fin 2, F k| ≤ 2 * C := by
    intro F C hF
    calc |∑ k : Fin 2, F k| ≤ ∑ k : Fin 2, |F k| := Finset.abs_sum_le_sum_abs _ _
      _ ≤ ∑ k : Fin 2, C := Finset.sum_le_sum fun k _ => hF k
      _ = 2 * C := by simp only [Fin.sum_univ_two]; ring
  have nsum4 : ∀ (F : Fin 2 → Fin 2 → (E2 →L[ℝ] ℝ)) (C : ℝ), (∀ i j, ‖F i j‖ ≤ C) →
      ‖∑ i : Fin 2, ∑ j : Fin 2, F i j‖ ≤ 4 * C := by
    intro F C hF
    calc ‖∑ i : Fin 2, ∑ j : Fin 2, F i j‖ ≤ ∑ i : Fin 2, ‖∑ j : Fin 2, F i j‖ :=
          norm_sum_le _ _
      _ ≤ ∑ i : Fin 2, ∑ j : Fin 2, C := Finset.sum_le_sum fun i _ =>
          (norm_sum_le _ _).trans (Finset.sum_le_sum fun j _ => hF i j)
      _ = 4 * C := by simp only [Fin.sum_univ_two]; ring
  have nsum2 : ∀ (F : Fin 2 → (E2 →L[ℝ] ℝ)) (C : ℝ), (∀ k, ‖F k‖ ≤ C) →
      ‖∑ k : Fin 2, F k‖ ≤ 2 * C := by
    intro F C hF
    calc ‖∑ k : Fin 2, F k‖ ≤ ∑ k : Fin 2, ‖F k‖ := norm_sum_le _ _
      _ ≤ ∑ k : Fin 2, C := Finset.sum_le_sum fun k _ => hF k
      _ = 2 * C := by simp only [Fin.sum_univ_two]; ring
  
  have hgp : ∀ i j : Fin 2, |((h x)⁻¹ i j - (h x₀)⁻¹ i j) * pd2 i (pd2 j ψ) x| ≤
      B * dist x x₀ * a₂ := by
    intro i j
    rw [abs_mul]
    exact mul_le_mul (hB i j 0).1 (hPv i j) (abs_nonneg _) (mul_nonneg hB0 hs0)
  have hcq : ∀ k : Fin 2,
      |(∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * christoffel2 h k a c x) * pd2 k ψ x| ≤
        B * a₁ := by
    intro k
    rw [abs_mul]
    exact mul_le_mul (hB 0 0 k).2.2.1 (hQv k) (abs_nonneg _) hB0
  have hX : ∀ i j : Fin 2,
      ‖((h x)⁻¹ i j - (h x₀)⁻¹ i j) •
          (fderiv ℝ (fun y => iteratedFDeriv ℝ 2 ψ y ![e2 i, e2 j]) x) +
        pd2 i (pd2 j ψ) x • fderiv ℝ (fun z => (h z)⁻¹ i j) x‖ ≤
      B * dist x x₀ * a₃ + a₂ * B :=
    fun i j => key _ _ _ _ _ _ _ _ (hB i j 0).1 (hPn i j) (hPv i j) (hB i j 0).2.1
  have hY : ∀ k : Fin 2,
      ‖(∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * christoffel2 h k a c x) •
            (fderiv ℝ (fderiv ℝ ψ) x).flip (e2 k) +
          pd2 k ψ x • fderiv ℝ
            (fun z => ∑ a : Fin 2, ∑ c : Fin 2, (h z)⁻¹ a c * christoffel2 h k a c z) x‖ ≤
      B * a₂ + a₁ * B :=
    fun k => key _ _ _ _ _ _ _ _ (hB 0 0 k).2.2.1 (hQn k) (hQv k) (hB 0 0 k).2.2.2
  refine ⟨?_, ?_, ?_⟩
  · rw [hid]
    exact hT.differentiableAt
  · rw [hidx]
    refine (abs_sub _ _).trans ?_
    have t1 := sum4 _ _ hgp
    have t2 := sum2 _ _ hcq
    linarith
  · rw [hid, hT.fderiv]
    refine (norm_sub_le _ _).trans ?_
    have t1 := nsum4 _ _ hX
    have t2 := nsum2 _ _ hY
    linarith

theorem pcgb_px_quotient_bounds (x₀ : E2) (σ : ℝ) (hσ : 0 < σ) (hσ1 : σ ≤ 1)
    (D Q m f ε : E2 → ℝ) (c₀ l Λ K : ℝ) (hc₀ : 0 < c₀) (hl : 0 < l) (hΛ : 0 ≤ Λ) (hK : 0 ≤ K)
    (hyp : ∀ x : E2, 0 < dist x x₀ → dist x x₀ < σ →
      DifferentiableAt ℝ D x ∧ DifferentiableAt ℝ Q x ∧ DifferentiableAt ℝ m x ∧
      DifferentiableAt ℝ f x ∧ DifferentiableAt ℝ ε x ∧
      c₀ * dist x x₀ ^ 2 ≤ D x ∧ l * dist x x₀ ^ 2 ≤ Q x ∧ Q x ≤ Λ * dist x x₀ ^ 2 ∧
      ‖fderiv ℝ Q x‖ ≤ Λ * dist x x₀ ∧ |m x| ≤ Λ * dist x x₀ ^ 2 ∧
      ‖fderiv ℝ m x‖ ≤ Λ * dist x x₀ ∧
      |D x - Q x| ≤ K * dist x x₀ ^ 3 ∧ ‖fderiv ℝ (fun y => D y - Q y) x‖ ≤ K * dist x x₀ ^ 2 ∧
      |ε x| ≤ K * dist x x₀ ^ 5 ∧ ‖fderiv ℝ ε x‖ ≤ K * dist x x₀ ^ 4 ∧
      |f x| ≤ K * dist x x₀ ^ 3 ∧ ‖fderiv ℝ f x‖ ≤ K * dist x x₀ ^ 2) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ x : E2, 0 < dist x x₀ → dist x x₀ < σ →
      DifferentiableAt ℝ (fun y => f y / (2 * D y) - m y * (D y - Q y) / (2 * D y * Q y) -
        ε y / (2 * D y ^ 2)) x ∧
      |f x / (2 * D x) - m x * (D x - Q x) / (2 * D x * Q x) - ε x / (2 * D x ^ 2)| ≤
        C * dist x x₀ ∧
      ‖fderiv ℝ (fun y => f y / (2 * D y) - m y * (D y - Q y) / (2 * D y * Q y) -
        ε y / (2 * D y ^ 2)) x‖ ≤ C :=
by
  have hquot : ∀ (u v : E2 → ℝ) (u' v' : E2 →L[ℝ] ℝ) (x : E2) (s t a b c : ℝ),
      0 < s → 0 < t → 0 < b → HasFDerivAt u u' x → HasFDerivAt v v' x →
      |u x| ≤ a * s * t → ‖u'‖ ≤ a * t → b * t ≤ |v x| → s * ‖v'‖ ≤ c * t →
      ∃ w : E2 →L[ℝ] ℝ, HasFDerivAt (fun y => u y / v y) w x ∧
        |u x / v x| ≤ a / b * s ∧ ‖w‖ ≤ a / b + a * c / b ^ 2 := by
    intro u v u' v' x s t a b c hs ht hb hu hv hu0 hu1 hv0 hv1
    have ha : 0 ≤ a := by
      by_contra h
      push_neg at h
      have := mul_neg_of_neg_of_pos h ht
      linarith [norm_nonneg u']
    have hc : 0 ≤ c := by
      by_contra h
      push_neg at h
      have := mul_neg_of_neg_of_pos h ht
      have := mul_nonneg hs.le (norm_nonneg v')
      linarith
    have hbt : 0 < b * t := mul_pos hb ht
    have hvpos : 0 < |v x| := lt_of_lt_of_le hbt hv0
    have hvx : v x ≠ 0 := abs_pos.mp hvpos
    have hinv : HasFDerivAt (fun y => (v y)⁻¹) (-(v x ^ 2)⁻¹ • v') x :=
      (hasDerivAt_inv hvx).comp_hasFDerivAt x hv
    have hmul := hu.mul hinv
    refine ⟨u x • (-(v x ^ 2)⁻¹ • v') + (v x)⁻¹ • u', ?_, ?_, ?_⟩
    · have e : (fun y => u y / v y) = fun y => u y * (v y)⁻¹ := by
        funext y; rw [div_eq_mul_inv]
      rw [e]; exact hmul
    · rw [abs_div, div_le_iff₀ hvpos]
      have e : a / b * s * (b * t) = a * s * t := by field_simp
      calc |u x| ≤ a * s * t := hu0
        _ = a / b * s * (b * t) := e.symm
        _ ≤ a / b * s * |v x| :=
          mul_le_mul_of_nonneg_left hv0 (mul_nonneg (div_nonneg ha hb.le) hs.le)
    · have e1 : ‖u x • (-(v x ^ 2)⁻¹ • v')‖ = |u x| * ‖v'‖ / |v x| ^ 2 := by
        rw [norm_smul, norm_smul, norm_neg, norm_inv, norm_pow, Real.norm_eq_abs,
          Real.norm_eq_abs]
        ring
      have e2 : ‖(v x)⁻¹ • u'‖ = ‖u'‖ / |v x| := by
        rw [norm_smul, norm_inv, Real.norm_eq_abs]
        ring
      have b1 : |u x| * ‖v'‖ / |v x| ^ 2 ≤ a * c / b ^ 2 := by
        rw [div_le_iff₀ (pow_pos hvpos 2)]
        have hsq : (b * t) ^ 2 ≤ |v x| ^ 2 := pow_le_pow_left₀ hbt.le hv0 2
        have eq : a * t * (c * t) = a * c / b ^ 2 * (b * t) ^ 2 := by field_simp
        calc |u x| * ‖v'‖ ≤ a * s * t * ‖v'‖ := mul_le_mul_of_nonneg_right hu0 (norm_nonneg _)
          _ = a * t * (s * ‖v'‖) := by ring
          _ ≤ a * t * (c * t) := mul_le_mul_of_nonneg_left hv1 (mul_nonneg ha ht.le)
          _ = a * c / b ^ 2 * (b * t) ^ 2 := eq
          _ ≤ a * c / b ^ 2 * |v x| ^ 2 :=
            mul_le_mul_of_nonneg_left hsq (div_nonneg (mul_nonneg ha hc) (sq_nonneg b))
      have b2 : ‖u'‖ / |v x| ≤ a / b := by
        rw [div_le_iff₀ hvpos]
        have eq : a * t = a / b * (b * t) := by field_simp
        calc ‖u'‖ ≤ a * t := hu1
          _ = a / b * (b * t) := eq
          _ ≤ a / b * |v x| := mul_le_mul_of_nonneg_left hv0 (div_nonneg ha hb.le)
      calc ‖u x • (-(v x ^ 2)⁻¹ • v') + (v x)⁻¹ • u'‖
          ≤ ‖u x • (-(v x ^ 2)⁻¹ • v')‖ + ‖(v x)⁻¹ • u'‖ := norm_add_le _ _
        _ ≤ a * c / b ^ 2 + a / b := by rw [e1, e2]; exact add_le_add b1 b2
        _ = a / b + a * c / b ^ 2 := by ring
  have hP0 : 0 ≤ Λ + K := add_nonneg hΛ hK
  have hn2 : ∀ w : E2 →L[ℝ] ℝ, ‖(2 : ℝ) • w‖ = 2 * ‖w‖ := by
    intro w; rw [norm_smul, Real.norm_eq_abs, abs_two]
  refine ⟨(K / (2 * c₀) + K * (2 * (Λ + K)) / (2 * c₀) ^ 2) +
      (2 * Λ * K / (2 * c₀ * l) + 2 * Λ * K * (4 * Λ * (Λ + K)) / (2 * c₀ * l) ^ 2) +
      (K / (2 * c₀ ^ 2) + K * (4 * (Λ + K) ^ 2) / (2 * c₀ ^ 2) ^ 2), ?_, ?_⟩
  · have hc1 : 0 < 2 * c₀ := by positivity
    have hc2 : 0 < 2 * c₀ * l := by positivity
    have hc3 : 0 < 2 * c₀ ^ 2 := by positivity
    have hΛK : 0 ≤ 2 * Λ * K := by positivity
    refine add_nonneg (add_nonneg (add_nonneg ?_ ?_) (add_nonneg ?_ ?_)) (add_nonneg ?_ ?_)
    · exact div_nonneg hK hc1.le
    · exact div_nonneg (mul_nonneg hK (by positivity)) (sq_nonneg _)
    · exact div_nonneg hΛK hc2.le
    · exact div_nonneg (mul_nonneg hΛK (by positivity)) (sq_nonneg _)
    · exact div_nonneg hK hc3.le
    · exact div_nonneg (mul_nonneg hK (by positivity)) (sq_nonneg _)
  intro x hx0 hxσ
  obtain ⟨hD, hQ, hm, hf, hε, hDlo, hQlo, hQhi, hDQ, hmv, hDm, hE, hDE, hεv, hDε, hfv, hDf⟩ :=
    hyp x hx0 hxσ
  set s := dist x x₀ with hs
  have hs1 : s ≤ 1 := by linarith
  have hs2 : 0 < s ^ 2 := by positivity
  have hDpos : 0 < D x := lt_of_lt_of_le (by positivity) hDlo
  have hQpos : 0 < Q x := lt_of_lt_of_le (by positivity) hQlo
  have hss2 : s ^ 2 ≤ s := by nlinarith
  have hss3 : s ^ 3 ≤ s ^ 2 := by nlinarith
  have hDhi : D x ≤ (Λ + K) * s ^ 2 := by
    have := (abs_le.mp hE).2
    nlinarith [mul_le_mul_of_nonneg_left hss3 hK]
  have hdsub : fderiv ℝ (fun y => D y - Q y) x = fderiv ℝ D x - fderiv ℝ Q x :=
    fderiv_fun_sub hD hQ
  have hDD : ‖fderiv ℝ D x‖ ≤ (Λ + K) * s := by
    have e : fderiv ℝ D x = fderiv ℝ (fun y => D y - Q y) x + fderiv ℝ Q x := by
      rw [hdsub]; abel
    rw [e]
    calc _ ≤ ‖fderiv ℝ (fun y => D y - Q y) x‖ + ‖fderiv ℝ Q x‖ := norm_add_le _ _
      _ ≤ K * s ^ 2 + Λ * s := add_le_add hDE hDQ
      _ ≤ (Λ + K) * s := by nlinarith [mul_le_mul_of_nonneg_left hss2 hK]
  have hDDn : 0 ≤ ‖fderiv ℝ D x‖ := norm_nonneg _
  
  have hv1 : HasFDerivAt (fun y => 2 * D y) ((2 : ℝ) • fderiv ℝ D x) x :=
    hD.hasFDerivAt.const_mul 2
  obtain ⟨w1, h1, hT1v, hT1n⟩ := hquot f (fun y => 2 * D y) (fderiv ℝ f x)
    ((2 : ℝ) • fderiv ℝ D x) x s (s ^ 2) K (2 * c₀) (2 * (Λ + K)) hx0 hs2 (by positivity)
    hf.hasFDerivAt hv1
    (by rw [show K * s * s ^ 2 = K * s ^ 3 by ring]; exact hfv) hDf
    (by
      show 2 * c₀ * s ^ 2 ≤ |2 * D x|
      rw [abs_of_pos (by positivity)]; linarith)
    (by rw [hn2]; nlinarith [mul_le_mul_of_nonneg_left hDD hx0.le])
  
  have hEd : HasFDerivAt (fun y => D y - Q y) (fderiv ℝ (fun y => D y - Q y) x) x :=
    (hD.sub hQ).hasFDerivAt
  have hu2 := hm.hasFDerivAt.mul hEd
  have hv2 := hv1.mul hQ.hasFDerivAt
  have hmv0 : 0 ≤ Λ * s ^ 2 := mul_nonneg hΛ hs2.le
  have hEv0 : 0 ≤ K * s ^ 3 := mul_nonneg hK (by positivity)
  obtain ⟨w2, h2, hT2v, hT2n⟩ := hquot (fun y => m y * (D y - Q y)) (fun y => 2 * D y * Q y)
    (m x • fderiv ℝ (fun y => D y - Q y) x + (D x - Q x) • fderiv ℝ m x)
    ((2 * D x) • fderiv ℝ Q x + Q x • ((2 : ℝ) • fderiv ℝ D x)) x s (s ^ 4)
    (2 * Λ * K) (2 * c₀ * l) (4 * Λ * (Λ + K)) hx0 (by positivity) (by positivity) hu2 hv2
    (by
      show |m x * (D x - Q x)| ≤ 2 * Λ * K * s * s ^ 4
      rw [abs_mul]
      have := mul_le_mul hmv hE (abs_nonneg _) hmv0
      have h5 : 0 ≤ Λ * K * s ^ 5 := by positivity
      nlinarith)
    (by
      calc _ ≤ ‖m x • fderiv ℝ (fun y => D y - Q y) x‖ + ‖(D x - Q x) • fderiv ℝ m x‖ :=
            norm_add_le _ _
        _ = |m x| * ‖fderiv ℝ (fun y => D y - Q y) x‖ + |D x - Q x| * ‖fderiv ℝ m x‖ := by
            rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs]
        _ ≤ Λ * s ^ 2 * (K * s ^ 2) + K * s ^ 3 * (Λ * s) :=
            add_le_add (mul_le_mul hmv hDE (norm_nonneg _) hmv0)
              (mul_le_mul hE hDm (norm_nonneg _) hEv0)
        _ = 2 * Λ * K * s ^ 4 := by ring)
    (by
      show 2 * c₀ * l * s ^ 4 ≤ |2 * D x * Q x|
      rw [abs_of_pos (by positivity)]
      have := mul_le_mul (mul_le_mul_of_nonneg_left hDlo (by norm_num : (0 : ℝ) ≤ 2)) hQlo
        (by positivity) (by positivity)
      nlinarith)
    (by
      have hb : ‖(2 * D x) • fderiv ℝ Q x + Q x • ((2 : ℝ) • fderiv ℝ D x)‖ ≤
          2 * D x * ‖fderiv ℝ Q x‖ + Q x * (2 * ‖fderiv ℝ D x‖) := by
        calc _ ≤ ‖(2 * D x) • fderiv ℝ Q x‖ + ‖Q x • ((2 : ℝ) • fderiv ℝ D x)‖ :=
              norm_add_le _ _
          _ = 2 * D x * ‖fderiv ℝ Q x‖ + Q x * (2 * ‖fderiv ℝ D x‖) := by
              rw [norm_smul, norm_smul, hn2, Real.norm_eq_abs, Real.norm_eq_abs,
                abs_of_pos (by positivity : (0 : ℝ) < 2 * D x), abs_of_pos hQpos]
      have k1 : 2 * D x * ‖fderiv ℝ Q x‖ ≤ 2 * ((Λ + K) * s ^ 2) * (Λ * s) :=
        mul_le_mul (by linarith) hDQ (norm_nonneg _) (by positivity)
      have k2 : Q x * (2 * ‖fderiv ℝ D x‖) ≤ Λ * s ^ 2 * (2 * ((Λ + K) * s)) :=
        mul_le_mul hQhi (by linarith) (by positivity) hmv0
      have e : s * (2 * ((Λ + K) * s ^ 2) * (Λ * s) + Λ * s ^ 2 * (2 * ((Λ + K) * s))) =
          4 * Λ * (Λ + K) * s ^ 4 := by ring
      calc s * ‖(2 * D x) • fderiv ℝ Q x + Q x • ((2 : ℝ) • fderiv ℝ D x)‖
          ≤ s * (2 * ((Λ + K) * s ^ 2) * (Λ * s) + Λ * s ^ 2 * (2 * ((Λ + K) * s))) :=
            mul_le_mul_of_nonneg_left (hb.trans (add_le_add k1 k2)) hx0.le
        _ = 4 * Λ * (Λ + K) * s ^ 4 := e)
  
  have hv3 : HasFDerivAt (fun y => 2 * D y ^ 2)
      ((2 : ℝ) • (D x • fderiv ℝ D x + D x • fderiv ℝ D x)) x := by
    have h := (hD.hasFDerivAt.mul hD.hasFDerivAt).const_mul (2 : ℝ)
    have e : (fun y => 2 * D y ^ 2) = fun y => 2 * (D y * D y) := by funext y; ring
    rw [e]; exact h
  obtain ⟨w3, h3, hT3v, hT3n⟩ := hquot ε (fun y => 2 * D y ^ 2) (fderiv ℝ ε x)
    ((2 : ℝ) • (D x • fderiv ℝ D x + D x • fderiv ℝ D x)) x s (s ^ 4) K (2 * c₀ ^ 2)
    (4 * (Λ + K) ^ 2) hx0 (by positivity) (by positivity) hε.hasFDerivAt hv3
    (by rw [show K * s * s ^ 4 = K * s ^ 5 by ring]; exact hεv) hDε
    (by
      show 2 * c₀ ^ 2 * s ^ 4 ≤ |2 * D x ^ 2|
      rw [abs_of_pos (by positivity)]
      have := pow_le_pow_left₀ (by positivity) hDlo 2
      nlinarith)
    (by
      have hb : ‖(2 : ℝ) • (D x • fderiv ℝ D x + D x • fderiv ℝ D x)‖ =
          4 * (D x * ‖fderiv ℝ D x‖) := by
        rw [hn2, ← two_smul ℝ (D x • fderiv ℝ D x), hn2, norm_smul, Real.norm_eq_abs,
          abs_of_pos hDpos]
        ring
      rw [hb]
      have k : D x * ‖fderiv ℝ D x‖ ≤ (Λ + K) * s ^ 2 * ((Λ + K) * s) :=
        mul_le_mul hDhi hDD hDDn (by positivity)
      have e : s * (4 * ((Λ + K) * s ^ 2 * ((Λ + K) * s))) = 4 * (Λ + K) ^ 2 * s ^ 4 := by
        ring
      calc s * (4 * (D x * ‖fderiv ℝ D x‖))
          ≤ s * (4 * ((Λ + K) * s ^ 2 * ((Λ + K) * s))) := by gcongr
        _ = _ := e)
  
  have h1' : HasFDerivAt (fun y => f y / (2 * D y)) w1 x := h1
  have h2' : HasFDerivAt (fun y => m y * (D y - Q y) / (2 * D y * Q y)) w2 x := h2
  have h3' : HasFDerivAt (fun y => ε y / (2 * D y ^ 2)) w3 x := h3
  have hR : HasFDerivAt (fun y => f y / (2 * D y) - m y * (D y - Q y) / (2 * D y * Q y) -
      ε y / (2 * D y ^ 2)) (w1 - w2 - w3) x := (h1'.sub h2').sub h3'
  have hT1v' : |f x / (2 * D x)| ≤ K / (2 * c₀) * s := hT1v
  have hT2v' : |m x * (D x - Q x) / (2 * D x * Q x)| ≤ 2 * Λ * K / (2 * c₀ * l) * s := hT2v
  have hT3v' : |ε x / (2 * D x ^ 2)| ≤ K / (2 * c₀ ^ 2) * s := hT3v
  have hc1 : 0 < 2 * c₀ := by positivity
  have hc2 : 0 < 2 * c₀ * l := by positivity
  have hc3 : 0 < 2 * c₀ ^ 2 := by positivity
  have hΛK : 0 ≤ 2 * Λ * K := by positivity
  have x1 : 0 ≤ K * (2 * (Λ + K)) / (2 * c₀) ^ 2 :=
    div_nonneg (mul_nonneg hK (by positivity)) (sq_nonneg _)
  have x2 : 0 ≤ 2 * Λ * K * (4 * Λ * (Λ + K)) / (2 * c₀ * l) ^ 2 :=
    div_nonneg (mul_nonneg hΛK (by positivity)) (sq_nonneg _)
  have x3 : 0 ≤ K * (4 * (Λ + K) ^ 2) / (2 * c₀ ^ 2) ^ 2 :=
    div_nonneg (mul_nonneg hK (by positivity)) (sq_nonneg _)
  refine ⟨hR.differentiableAt, ?_, ?_⟩
  · have habs1 := abs_sub (f x / (2 * D x) - m x * (D x - Q x) / (2 * D x * Q x))
        (ε x / (2 * D x ^ 2))
    have habs2 := abs_sub (f x / (2 * D x)) (m x * (D x - Q x) / (2 * D x * Q x))
    have hextra : 0 ≤ (K * (2 * (Λ + K)) / (2 * c₀) ^ 2 +
        2 * Λ * K * (4 * Λ * (Λ + K)) / (2 * c₀ * l) ^ 2 +
        K * (4 * (Λ + K) ^ 2) / (2 * c₀ ^ 2) ^ 2) * s :=
      mul_nonneg (by linarith) hx0.le
    nlinarith
  · rw [hR.fderiv]
    calc ‖w1 - w2 - w3‖ ≤ ‖w1 - w2‖ + ‖w3‖ := norm_sub_le _ _
      _ ≤ ‖w1‖ + ‖w2‖ + ‖w3‖ := by linarith [norm_sub_le w1 w2]
      _ ≤ _ := by linarith

theorem pcgb_parametrix_estimate_core (W : Set E2) (hW : IsOpen W)
    (h : E2 → Matrix (Fin 2) (Fin 2) ℝ)
    (hh : ∀ a c : Fin 2, ContDiffOn ℝ ∞ (fun x => h x a c) W)
    (hpd : ∀ x ∈ W, (h x).PosDef) (x₀ : E2) (σ : ℝ) (hσ : 0 < σ) (hσ1 : σ ≤ 1)
    (hball : Metric.closedBall x₀ σ ⊆ W) (D : E2 → ℝ) (M : Matrix (Fin 2) (Fin 2) ℝ)
    (hM : ∀ a c : Fin 2, M a c = M c a) (c₀ K Kψ : ℝ) (hc₀ : 0 < c₀) (hK : 0 ≤ K)
    (hKψ : 0 ≤ Kψ)
    (hlap : ∀ (u : E2 → ℝ) (V : Set E2), IsOpen V → V ⊆ W → ContDiffOn ℝ ∞ u V →
      ContDiffOn ℝ ∞ (lap2 h u) V)
    (hD : ContDiff ℝ ∞ D)
    (hψs : ContDiffOn ℝ ∞ (pcgbPxPsi (h x₀) M x₀) {x | x ≠ x₀})
    (hjet : ∀ x : E2, 0 < dist x x₀ → dist x x₀ < σ → pcgbPxJet h D M x₀ c₀ K x)
    (hψ : ∀ x : E2, 0 < dist x x₀ → dist x x₀ < 1 → pcgbPxPsiEst (h x₀) M x₀ Kψ x)
    (hid : ∀ x : E2, 0 < dist x x₀ → dist x x₀ < σ →
      lap2 h (fun y => (1 / 2 : ℝ) * Real.log (D y)) x =
        lap2 h D x / (2 * D x) -
          (∑ a : Fin 2, ∑ c : Fin 2, (h x)⁻¹ a c * pd2 a D x * pd2 c D x) / (2 * D x ^ 2))
    (Λ₀ : E2 → ℝ)
    (hΛ₀ : ∀ y : E2, Λ₀ y = (1 / 2 : ℝ) * Real.log (D y) - pcgbPxPsi (h x₀) M x₀ y) :
    ∃ c K' : ℝ, 0 ≤ K' ∧ ∀ x : E2, 0 < dist x x₀ → dist x x₀ < σ →
      |lap2 h Λ₀ x - c| ≤ K' * Real.sqrt (dist x x₀) ∧
      ‖fderiv ℝ (lap2 h Λ₀) x‖ ≤ K' / Real.sqrt (dist x x₀) ∧
      |Λ₀ x - Real.log (Real.sqrt (pcgbPxQuad (h x₀) x₀ x))| ≤ K' ∧
      ‖fderiv ℝ (fun y => Λ₀ y - Real.log (Real.sqrt (pcgbPxQuad (h x₀) x₀ y))) x‖ ≤ K' ∧
      ‖fderiv ℝ (fderiv ℝ (fun y => Λ₀ y - Real.log (Real.sqrt (pcgbPxQuad (h x₀) x₀ y)))) x‖ ≤
        K' / Real.sqrt (pcgbPxQuad (h x₀) x₀ x) :=
by
  classical
  
  have hx₀W : x₀ ∈ W := hball (Metric.mem_closedBall_self hσ.le)
  have hH : (h x₀).PosDef := hpd x₀ hx₀W
  obtain ⟨hQs, hQb⟩ := pcgb_px_quad_bounds (h x₀) x₀
  obtain ⟨hms, hmb⟩ := pcgb_px_quad_bounds M x₀
  obtain ⟨SH, hSH⟩ : ∃ S : ℝ, S = ∑ a : Fin 2, ∑ c : Fin 2, |h x₀ a c| := ⟨_, rfl⟩
  obtain ⟨SM, hSM⟩ : ∃ S : ℝ, S = ∑ a : Fin 2, ∑ c : Fin 2, |M a c| := ⟨_, rfl⟩
  rw [← hSH] at hQb
  rw [← hSM] at hmb
  have hSH0 : 0 ≤ SH := by
    rw [hSH]; exact Finset.sum_nonneg (fun a _ => Finset.sum_nonneg (fun c _ => abs_nonneg _))
  have hSM0 : 0 ≤ SM := by
    rw [hSM]; exact Finset.sum_nonneg (fun a _ => Finset.sum_nonneg (fun c _ => abs_nonneg _))
  obtain ⟨Lam, hLam⟩ : ∃ L : ℝ, L = 2 * (SH + SM) := ⟨_, rfl⟩
  have hLam0 : 0 ≤ Lam := by rw [hLam]; linarith
  have hSHL : SH ≤ Lam := by rw [hLam]; linarith
  have hSML : SM ≤ Lam := by rw [hLam]; linarith
  have h2SHL : 2 * SH ≤ Lam := by rw [hLam]; linarith
  have h2SML : 2 * SM ≤ Lam := by rw [hLam]; linarith
  have hQle : ∀ y : E2, pcgbPxQuad (h x₀) x₀ y ≤ Lam * dist y x₀ ^ 2 := fun y =>
    (le_abs_self _).trans ((hQb y).1.trans (mul_le_mul_of_nonneg_right hSHL (sq_nonneg _)))
  have hDQ : ∀ y : E2, ‖fderiv ℝ (pcgbPxQuad (h x₀) x₀) y‖ ≤ Lam * dist y x₀ := fun y =>
    (hQb y).2.1.trans (mul_le_mul_of_nonneg_right h2SHL dist_nonneg)
  have hD2Q : ∀ y : E2, ‖fderiv ℝ (fderiv ℝ (pcgbPxQuad (h x₀) x₀)) y‖ ≤ Lam := fun y =>
    (hQb y).2.2.trans h2SHL
  have hmle : ∀ y : E2, |pcgbPxQuad M x₀ y| ≤ Lam * dist y x₀ ^ 2 := fun y =>
    (hmb y).1.trans (mul_le_mul_of_nonneg_right hSML (sq_nonneg _))
  have hDm : ∀ y : E2, ‖fderiv ℝ (pcgbPxQuad M x₀) y‖ ≤ Lam * dist y x₀ := fun y =>
    (hmb y).2.1.trans (mul_le_mul_of_nonneg_right h2SML dist_nonneg)
  
  obtain ⟨l, hldef⟩ : ∃ l : ℝ, l = (h x₀).det / (h x₀ 0 0 + h x₀ 1 1) := ⟨_, rfl⟩
  have hsym : h x₀ 1 0 = h x₀ 0 1 := by
    have := hH.isHermitian.apply 0 1
    simpa using this
  have ha0 : 0 < h x₀ 0 0 := hH.diag_pos
  have hc0 : 0 < h x₀ 1 1 := hH.diag_pos
  have hdet : 0 < (h x₀).det := hH.det_pos
  rw [Matrix.det_fin_two, hsym] at hdet
  have hl0 : 0 < l := by
    rw [hldef, Matrix.det_fin_two, hsym]
    exact div_pos hdet (by linarith)
  have hlQ : ∀ y : E2, l * dist y x₀ ^ 2 ≤ pcgbPxQuad (h x₀) x₀ y := by
    intro y
    have hdist : dist y x₀ ^ 2 = (y - x₀) 0 ^ 2 + (y - x₀) 1 ^ 2 := by
      rw [dist_eq_norm, EuclideanSpace.norm_eq,
        Real.sq_sqrt (Finset.sum_nonneg (fun i _ => by positivity)), Fin.sum_univ_two]
      simp [Real.norm_eq_abs, sq_abs]
    have hQ : pcgbPxQuad (h x₀) x₀ y = h x₀ 0 0 * (y - x₀) 0 ^ 2 +
        2 * h x₀ 0 1 * (y - x₀) 0 * (y - x₀) 1 + h x₀ 1 1 * (y - x₀) 1 ^ 2 := by
      simp only [pcgbPxQuad, Fin.sum_univ_two, hsym]
      ring
    rw [hldef, Matrix.det_fin_two, hsym, hdist, hQ, div_mul_eq_mul_div,
      div_le_iff₀ (by linarith)]
    nlinarith [sq_nonneg (h x₀ 0 0 * (y - x₀) 0 + h x₀ 0 1 * (y - x₀) 1),
