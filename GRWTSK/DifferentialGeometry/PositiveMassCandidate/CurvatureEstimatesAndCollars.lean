          (c x • ((-(Real.sqrt (Dt x) ^ 2)⁻¹) • ((1 / (2 * Real.sqrt (Dt x))) • D'))
            + (Real.sqrt (Dt x))⁻¹ • c') x := hc.mul hTi
      unfold pd2
      rw [hev.fderiv_eq, hmul.fderiv]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
      ring
    have k00 := key 0 0 (fun y => h y 1 1) _ (hdiff 1 1) (fun y hy => (hadj y hy).1)
    have k01 := key 0 1 (fun y => -h y 0 1) _ (hdiff 0 1).neg (fun y hy => (hadj y hy).2.1)
    have k10 := key 1 0 (fun y => -h y 0 1) _ (hdiff 0 1).neg (fun y hy => (hadj y hy).2.2.1)
    have k11 := key 1 1 (fun y => h y 0 0) _ (hdiff 0 0) (fun y hy => (hadj y hy).2.2.2)
    have h10 : ∀ k : Fin 2, pd2 k (fun z => h z 1 0) x = pd2 k (fun z => h z 0 1) x := by
      intro k
      have hev : (fun z => h z 1 0) =ᶠ[𝓝 x] (fun z => h z 0 1) := by
        filter_upwards [hnx] with y hy
        exact hsym y hy
      unfold pd2
      rw [hev.fderiv_eq]
    have hinvx : ∀ a b : Fin 2, (h x)⁻¹ a b = (Dt x)⁻¹ * (h x).adjugate a b := by
      intro a b
      rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul, hdetE x hx]
    obtain ⟨ha00, ha01, ha10, ha11⟩ := hadj x hx
    have hT2 : Real.sqrt (Dt x) ^ 2 = Dt x := Real.sq_sqrt hD0.le
    have hDtx : Dt x = h x 0 0 * h x 1 1 - h x 0 1 * h x 0 1 := by rw [hDt]
    have hS : 0 < h x 1 1 := (hpd x hx).diag_pos
    rw [hdetE x hx]
    fin_cases j
    · simp only [Fin.sum_univ_two, christoffel2, hinvx, ha00, ha01, ha10, ha11, h10,
