      intro y hy; rw [← hdetE y hy]; exact (hpd y hy).det_pos
    have hrel : ∀ d c : ℝ, 0 < d → Real.sqrt d * (d⁻¹ * c) = c * (Real.sqrt d)⁻¹ := by
      intro d c hd
      have h2 := (Real.sqrt_pos.2 hd).ne'
      have e : d⁻¹ = (Real.sqrt d)⁻¹ * (Real.sqrt d)⁻¹ := by
        rw [← mul_inv, Real.mul_self_sqrt hd.le]
      rw [e, ← mul_assoc, ← mul_assoc, mul_inv_cancel₀ h2, one_mul, mul_comm]
    have hinvE : ∀ y ∈ Metric.ball (0 : E2) ρ, ∀ a b : Fin 2,
