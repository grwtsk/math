  have gti : ∀ (x : E3) (r : ℝ), 0 < r → ∀ F : E3 → ℝ, DifferentiableAt ℝ F x →
      (∀ y ∈ Metric.ball x r, y ∈ S → F y = 0) → ∀ (b : Fin 3) (w : E3 → ℝ),
