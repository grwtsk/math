      intro y hy
      simp [Matrix.adjugate_fin_two, hsym y hy]
    have hdiff : ∀ a b : Fin 2,
        HasFDerivAt (fun z => h z a b) (fderiv ℝ (fun z => h z a b) x) x :=
      fun a b => (((hh a b).differentiableOn (by simp)).differentiableAt hnx).hasFDerivAt
    obtain ⟨D', hD'⟩ : ∃ D' : E2 →L[ℝ] ℝ,
        D' = h x 0 0 • fderiv ℝ (fun z => h z 1 1) x + h x 1 1 • fderiv ℝ (fun z => h z 0 0) x
          - (h x 0 1 • fderiv ℝ (fun z => h z 0 1) x
            + h x 0 1 • fderiv ℝ (fun z => h z 0 1) x) :=
      ⟨_, rfl⟩
    have hDtd : HasFDerivAt Dt D' x := by
      rw [hDt, hD']
      exact ((hdiff 0 0).mul (hdiff 1 1)).sub ((hdiff 0 1).mul (hdiff 0 1))
    have hD0 := hdpos x hx
    have hT0 : 0 < Real.sqrt (Dt x) := Real.sqrt_pos.2 hD0
    have hTd : HasFDerivAt (fun y => Real.sqrt (Dt y)) ((1 / (2 * Real.sqrt (Dt x))) • D') x :=
      (Real.hasDerivAt_sqrt hD0.ne').comp_hasFDerivAt x hDtd
    have hTi : HasFDerivAt (fun y => (Real.sqrt (Dt y))⁻¹)
        ((-(Real.sqrt (Dt x) ^ 2)⁻¹) • ((1 / (2 * Real.sqrt (Dt x))) • D')) x :=
      (hasDerivAt_inv hT0.ne').comp_hasFDerivAt x hTd
    have key : ∀ (a b : Fin 2) (c : E2 → ℝ) (c' : E2 →L[ℝ] ℝ), HasFDerivAt c c' x →
        (∀ y ∈ Metric.ball (0 : E2) ρ, (h y).adjugate a b = c y) → ∀ k : Fin 2,
        pd2 k (fun y => Real.sqrt (h y).det * (h y)⁻¹ a b) x =
          c' (e2 k) * (Real.sqrt (Dt x))⁻¹ + c x * ((-(Real.sqrt (Dt x) ^ 2)⁻¹) *
            ((1 / (2 * Real.sqrt (Dt x))) * D' (e2 k))) := by
      intro a b c c' hc hcE k
      have hev : (fun y => Real.sqrt (h y).det * (h y)⁻¹ a b) =ᶠ[𝓝 x]
