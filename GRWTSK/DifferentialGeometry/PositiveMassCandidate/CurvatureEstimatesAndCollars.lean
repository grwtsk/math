      subst hT2
      generalize h x 0 0 = p at hDtx ⊢
      generalize h x 0 1 = q at hDtx ⊢
      generalize h x 1 1 = s at hDtx hS ⊢
      have hp : p = (t ^ 2 + q * q) / s := by
        field_simp
        linarith
      subst hp
      field_simp
      ring
    · simp only [Fin.sum_univ_two, christoffel2, hinvx, ha00, ha01, ha10, ha11, h10,
