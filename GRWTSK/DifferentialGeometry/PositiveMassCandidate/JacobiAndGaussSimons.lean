            ((β - α)⁻¹ • fderiv ℝ (fun z => w ((chartAt E3 q).symm z)) y))) y := by
        have h2 := HasDerivAt.comp_hasFDerivAt (h₂ := Real.smoothTransition) y hst hin
        exact h2.const_sub 1
      have hev : (fun z => O.indicator (fun x => 1 - Real.smoothTransition ((w x - α) / (β - α)))
            ((chartAt E3 q).symm z)) =ᶠ[𝓝 y]
          fun z => 1 - Real.smoothTransition ((w ((chartAt E3 q).symm z) - α) / (β - α)) := by
        filter_upwards [hTo.mem_nhds hyT] with z hz
        rw [hTdef] at hz
        exact Set.indicator_of_mem hz.2.1 _
      have hcder : fderiv ℝ (fun z => O.indicator
            (fun x => 1 - Real.smoothTransition ((w x - α) / (β - α))) ((chartAt E3 q).symm z)) y =
          -(deriv Real.smoothTransition σ •
            ((β - α)⁻¹ • fderiv ℝ (fun z => w ((chartAt E3 q).symm z)) y)) :=
        (hF.congr_of_eventuallyEq hev).fderiv
      have hpc : ∀ k : Fin 3, partialDeriv k (fun z => O.indicator
            (fun x => 1 - Real.smoothTransition ((w x - α) / (β - α))) ((chartAt E3 q).symm z)) y =
          -lam * partialDeriv k (fun z => w ((chartAt E3 q).symm z)) y := by
        intro k
        unfold partialDeriv
        rw [hcder, hlam]
        simp only [ContinuousLinearMap.neg_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
        ring
      have hgr := gradInner_eq_coord g
        { toPartialEquiv := (chartAt E3 q).symm.toPartialEquiv,
          open_source := (chartAt E3 q).open_target,
          open_target := (chartAt E3 q).open_source,
          contMDiffOn_toFun := contMDiffOn_chart_symm,
          contMDiffOn_invFun := contMDiffOn_chart }
        (O.indicator (fun x => 1 - Real.smoothTransition ((w x - α) / (β - α))))
        (fun z => O.indicator (fun x => 1 - Real.smoothTransition ((w x - α) / (β - α)))
          ((chartAt E3 q).symm z)) hcs y hyt (Filter.Eventually.of_forall fun _ => rfl)
      have hgr' : g.gradInner
            (O.indicator (fun x => 1 - Real.smoothTransition ((w x - α) / (β - α))))
            (O.indicator (fun x => 1 - Real.smoothTransition ((w x - α) / (β - α))))
            ((chartAt E3 q).symm y) = ∑ i : Fin 3, ∑ j : Fin 3,
          (g.coeff (chartAt E3 q).symm y)⁻¹ i j *
            partialDeriv i (fun z => O.indicator
              (fun x => 1 - Real.smoothTransition ((w x - α) / (β - α))) ((chartAt E3 q).symm z)) y *
            partialDeriv j (fun z => O.indicator
              (fun x => 1 - Real.smoothTransition ((w x - α) / (β - α))) ((chartAt E3 q).symm z)) y :=
        hgr
      have hgv : g.gradInner
            (O.indicator (fun x => 1 - Real.smoothTransition ((w x - α) / (β - α))))
            (O.indicator (fun x => 1 - Real.smoothTransition ((w x - α) / (β - α))))
            ((chartAt E3 q).symm y) = lam ^ 2 * Qv := by
        rw [hgr']
        simp only [hpc]
        rw [hQv]
        simp only [Fin.sum_univ_three]
        ring
      rw [hgv, Real.sqrt_mul' _ hQ'.le, Real.sqrt_sq hlam0, hcder]
      simp only [ContinuousLinearMap.neg_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
      rw [hLN, hlam]
      ring
    have hcζ := hcut a b hab hζs
    have hcχ := hcut c d hcd hχs
    
    have hRy : (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)
          (Z ((chartAt E3 q).symm y)) : E3) =
        (O.indicator (fun x => 1 - Real.smoothTransition ((w x - c) / (d - c)))
              ((chartAt E3 q).symm y) -
            O.indicator (fun x => 1 - Real.smoothTransition ((w x - a) / (b - a)))
              ((chartAt E3 q).symm y)) • N y := by
      refine PiLp.ext fun i => ?_
      rw [PiLp.smul_apply, smul_eq_mul, hNi]
      exact hZq y hyt (by rw [hsy]; exact hxE) (by rw [hsy]; exact hxO) (by rw [hsy]; exact hxS) i
    have hH' : g.levelMeanCurv w ((chartAt E3 q).symm y) =
        levelMeanCurvCoord (g.coeff (chartAt E3 q).symm) (fun z => w ((chartAt E3 q).symm z)) y := by
      rw [hsy]; exact hH
    
    rw [hdiv, hdivN, hleib, hcζ, hcχ, hRy, map_smul, smul_eq_mul, hH']
    ring
  · 
    have hxK : x ∉ {x | x ∈ O ∧ w x ≤ t₀} := fun h => hxO h.1
    have hZ0' : ∀ x', x' ∉ {x | x ∈ O ∧ w x ≤ t₀} → Z x' = 0 := by
      intro x' hx'
      by_contra hne
      obtain ⟨-, h1, -, h2⟩ := hZ0 x' hne
      exact hx' ⟨h1, h2⟩
    have hP : ∀ᶠ z in 𝓝 y, calPiece q ψ Z z = 0 := by
      have hVo := (chartAt E3 q).isOpen_inter_preimage_symm hK0.isOpen_compl
      have hyV : y ∈ (chartAt E3 q).target ∩
          (chartAt E3 q).symm ⁻¹' {x | x ∈ O ∧ w x ≤ t₀}ᶜ :=
        ⟨hyt, by rw [Set.mem_preimage, hsy]; exact hxK⟩
      filter_upwards [hVo.mem_nhds hyV] with z hz
      have hZz : Z ((chartAt E3 q).symm z) = 0 := hZ0' _ hz.2
      simp only [calPiece, Set.indicator_of_mem hz.1, hZz, map_zero, smul_zero]
    have hL : sepDensDiv (g.coeff (chartAt E3 q).symm) (calPiece q ψ Z) y = 0 := by
      unfold sepDensDiv partialDeriv
      refine Finset.sum_eq_zero fun i _ => ?_
      have hev : (fun z => Real.sqrt (g.coeff (chartAt E3 q).symm z).det * calPiece q ψ Z z i)
          =ᶠ[𝓝 y] fun _ => (0 : ℝ) := hP.mono fun z hz => by simp [hz]
      rw [hev.fderiv_eq]
      simp
    have hgz : ∀ u : M → ℝ, (∀ x', x' ∉ {x | x ∈ O ∧ w x ≤ t₀} → u x' = 0) →
        g.gradInner u u x = 0 := by
      intro u hu
      have hu' : ∀ᶠ x' in 𝓝 x, u x' = 0 :=
        Filter.eventually_of_mem (hK0.isOpen_compl.mem_nhds hxK) fun x' hx' => hu x' hx'
      have hc' := (chartAt E3 x).continuousAt_symm (mem_chart_target E3 x)
      have hlx : (chartAt E3 x).symm (chartAt E3 x x) = x :=
        (chartAt E3 x).left_inv (mem_chart_source E3 x)
      have hu'' : ∀ᶠ x' in 𝓝 ((chartAt E3 x).symm (chartAt E3 x x)), u x' = 0 := by
        rw [hlx]; exact hu'
      have h2 : (fun y' => u ((chartAt E3 x).symm y')) =ᶠ[𝓝 (chartAt E3 x x)]
          fun _ => (0 : ℝ) := hc'.tendsto.eventually hu''
      have hpd0 : ∀ i, partialDeriv i (fun y' => u ((chartAt E3 x).symm y'))
          (chartAt E3 x x) = 0 := by
        intro i
        unfold partialDeriv
        rw [h2.fderiv_eq]
        simp
      simp only [RiemannianMetric3.gradInner, hpd0, mul_zero, Finset.sum_const_zero]
    have hζx : O.indicator (fun x => 1 - Real.smoothTransition ((w x - a) / (b - a))) x = 0 :=
      Set.indicator_of_notMem hxO _
    have hχx : O.indicator (fun x => 1 - Real.smoothTransition ((w x - c) / (d - c))) x = 0 :=
      Set.indicator_of_notMem hxO _
    have hgζ := hgz (O.indicator (fun x => 1 - Real.smoothTransition ((w x - a) / (b - a))))
      (fun x' hx' => by
        by_contra hne
        obtain ⟨h1, h2⟩ := hζ0 x' hne
        exact hx' ⟨h1, by linarith⟩)
    have hgχ := hgz (O.indicator (fun x => 1 - Real.smoothTransition ((w x - c) / (d - c))))
      (fun x' hx' => by
        by_contra hne
        obtain ⟨h1, h2⟩ := hχ0 x' hne
        exact hx' ⟨h1, by linarith⟩)
    have hZx : Z x = 0 := hZ0' x hxK
    rw [hL, hsy, hζx, hχx, hgζ, hgχ, hZx]
    simp

theorem chart_flux_zero_of_vanishing [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (E : Set M) (hE : IsOpen E) (Z : M → E3) (hZ : calSmoothField Z) (hZfr : ∀ x ∈ frontier E, ∀ᶠ x' in 𝓝 x, Z x' = 0) (q : M) (ψ : M → ℝ) (hψ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ψ) (hψc : IsCompact (tsupport ψ)) (hψs : tsupport ψ ⊆ (chartAt E3 q).source) : ∫ y in chartAt E3 q '' (E ∩ (chartAt E3 q).source), sepDensDiv (g.coeff (chartAt E3 q).symm) (calPiece q ψ Z) y = 0 ∧ MeasureTheory.IntegrableOn (fun y => Real.sqrt (g.coeff (chartAt E3 q).symm y).det * fderiv ℝ (fun z => ψ ((chartAt E3 q).symm z)) y (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y) (Z ((chartAt E3 q).symm y)) : E3)) (chartAt E3 q '' (E ∩ (chartAt E3 q).source)) ∧ MeasureTheory.Integrable (sepDensDiv (g.coeff (chartAt E3 q).symm) (calPiece q ψ Z)) :=
by
  have h1inf : (1 : WithTop ℕ∞) ≤ ∞ := by exact_mod_cast le_top
  have hSo : IsOpen (chartAt E3 q '' (E ∩ (chartAt E3 q).source)) :=
    (chartAt E3 q).isOpen_image_of_subset_source (hE.inter (chartAt E3 q).open_source)
      Set.inter_subset_right
  have hST : chartAt E3 q '' (E ∩ (chartAt E3 q).source) ⊆ (chartAt E3 q).target := by
    rintro _ ⟨x, ⟨-, hx⟩, rfl⟩
    exact (chartAt E3 q).map_source hx
  obtain ⟨hF, hInt⟩ := calPiece_regular g q ψ hψ hψc hψs Z hZ
  have hKc : IsCompact (chartAt E3 q '' tsupport ψ) :=
    hψc.image_of_continuousOn ((chartAt E3 q).continuousOn.mono hψs)
  have hKcl : IsClosed (chartAt E3 q '' tsupport ψ) := hKc.isClosed
  have hKT : chartAt E3 q '' tsupport ψ ⊆ (chartAt E3 q).target := by
    rintro _ ⟨x, hx, rfl⟩
    exact (chartAt E3 q).map_source (hψs hx)
  have hψoff : ∀ z ∈ (chartAt E3 q).target, z ∉ chartAt E3 q '' tsupport ψ →
      ψ ((chartAt E3 q).symm z) = 0 := by
    intro z hz hzK
    apply image_eq_zero_of_notMem_tsupport
    intro hx
    exact hzK ⟨(chartAt E3 q).symm z, hx, (chartAt E3 q).right_inv hz⟩
  have hoff : ∀ z, z ∉ chartAt E3 q '' tsupport ψ → calPiece q ψ Z z = 0 := by
    intro z hzK
    by_cases hz : z ∈ (chartAt E3 q).target
    · simp [calPiece, hz, hψoff z hz hzK]
    · simp [calPiece, hz]
  have hfr : ∀ y ∈ frontier (chartAt E3 q '' (E ∩ (chartAt E3 q).source)),
      ∀ᶠ z in 𝓝 y, calPiece q ψ Z z = 0 := by
    intro y hy
    rw [hSo.frontier_eq] at hy
    obtain ⟨hycl, hyS⟩ := hy
    by_cases hyK : y ∈ chartAt E3 q '' tsupport ψ
    · obtain ⟨x, hxK, rfl⟩ := hyK
      have hxU : x ∈ (chartAt E3 q).source := hψs hxK
      have hyT : chartAt E3 q x ∈ (chartAt E3 q).target := (chartAt E3 q).map_source hxU
      have hxE : x ∉ E := fun h => hyS ⟨x, ⟨h, hxU⟩, rfl⟩
      have hcont : ContinuousAt (chartAt E3 q).symm (chartAt E3 q x) :=
        (chartAt E3 q).continuousAt_symm hyT
      have hxcl : x ∈ closure E := by
        have h1 := mem_closure_image hcont hycl
        rw [(chartAt E3 q).left_inv hxU] at h1
        refine closure_mono ?_ h1
        rintro _ ⟨_, ⟨x', ⟨hx'E, hx'U⟩, rfl⟩, rfl⟩
        rw [(chartAt E3 q).left_inv hx'U]
        exact hx'E
      have hxfr : x ∈ frontier E := by
        rw [hE.frontier_eq]
        exact ⟨hxcl, hxE⟩
      have hZev := hZfr x hxfr
      have htend : Tendsto (chartAt E3 q).symm (𝓝 (chartAt E3 q x)) (𝓝 x) := by
        have := hcont.tendsto
        rwa [(chartAt E3 q).left_inv hxU] at this
      filter_upwards [htend.eventually hZev, (chartAt E3 q).open_target.mem_nhds hyT] with z hz hzT
      simp [calPiece, hzT, hz]
    · exact Filter.eventually_of_mem (hKcl.isOpen_compl.mem_nhds hyK) (fun z hz => hoff z hz)
  have hPc : ∀ i : Fin 3, HasCompactSupport
      (fun z => Real.sqrt (g.coeff (chartAt E3 q).symm z).det * calPiece q ψ Z z i) := by
    intro i
    refine HasCompactSupport.intro hKc (fun z hz => ?_)
    simp [hoff z hz]
  have hflux := ccs_flux_zero (g.coeff (chartAt E3 q).symm) (calPiece q ψ Z) _ hSo
    (fun i => (hF i).of_le h1inf) hPc hfr
  
  have hΨ : ContDiffOn ℝ ∞ (fun z => ψ ((chartAt E3 q).symm z)) (chartAt E3 q).target := by
    have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (ψ ∘ (chartAt E3 q).symm) (chartAt E3 q).target :=
      hψ.comp_contMDiffOn contMDiffOn_chart_symm
    exact contMDiffOn_iff_contDiffOn.mp h1
  have hG : ContinuousOn (fun y => g.coeff (chartAt E3 q).symm y) (chartAt E3 q).target := by
    apply continuousOn_pi.2
    intro i
    apply continuousOn_pi.2
    intro j
    exact (g.smooth q i j).continuousOn
  have hdet : ContinuousOn (fun y => Real.sqrt (g.coeff (chartAt E3 q).symm y).det)
      (chartAt E3 q).target :=
    Real.continuous_sqrt.comp_continuousOn ((continuous_id.matrix_det).comp_continuousOn hG)
  have hfd : ContinuousOn (fderiv ℝ (fun z => ψ ((chartAt E3 q).symm z))) (chartAt E3 q).target :=
    hΨ.continuousOn_fderiv_of_isOpen (chartAt E3 q).open_target h1inf
  have hcont : ContinuousOn (fun y => Real.sqrt (g.coeff (chartAt E3 q).symm y).det *
      fderiv ℝ (fun z => ψ ((chartAt E3 q).symm z)) y
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)
          (Z ((chartAt E3 q).symm y)) : E3)) (chartAt E3 q).target :=
    hdet.mul (hfd.clm_apply (hZ q).continuousOn)
  have hzero : ∀ y ∈ (chartAt E3 q).target, y ∉ chartAt E3 q '' tsupport ψ →
      Real.sqrt (g.coeff (chartAt E3 q).symm y).det *
        fderiv ℝ (fun z => ψ ((chartAt E3 q).symm z)) y
          (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)
            (Z ((chartAt E3 q).symm y)) : E3) = 0 := by
    intro y hyT hyK
    have hev : (fun z => ψ ((chartAt E3 q).symm z)) =ᶠ[𝓝 y] fun _ => (0 : ℝ) := by
      filter_upwards [((chartAt E3 q).open_target.inter hKcl.isOpen_compl).mem_nhds
        ⟨hyT, hyK⟩] with z hz
      exact hψoff z hz.1 hz.2
    rw [hev.fderiv_eq]
    simp
  have hI2 : MeasureTheory.IntegrableOn (fun y => Real.sqrt (g.coeff (chartAt E3 q).symm y).det *
      fderiv ℝ (fun z => ψ ((chartAt E3 q).symm z)) y
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 q) ((chartAt E3 q).symm y)
          (Z ((chartAt E3 q).symm y)) : E3)) (chartAt E3 q '' (E ∩ (chartAt E3 q).source)) := by
    refine IntegrableOn.of_forall_diff_eq_zero
      (ContinuousOn.integrableOn_compact hKc (hcont.mono hKT)) hSo.measurableSet ?_
    rintro y ⟨hyS, hyK⟩
    exact hzero y (hST hyS) hyK
  exact ⟨hflux, hI2, hInt⟩

theorem collar_flux_conservation [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (Sig E O Ω O'' : Set M) (w : M → ℝ) (t₀ a b c d : ℝ) (hE : IsOpen E) (hfr : frontier E = Sig)
    (hO : IsOpen O) (hcpt : IsCompact {x | x ∈ O ∧ w x ≤ t₀}) (hwc : ContinuousOn w O)
    (hw0 : ∀ x ∈ O, x ∈ Sig → w x = 0) (hwpos : ∀ x ∈ O, x ∉ Sig → 0 < w x)
    (hws : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w (O \ Sig))
    (hdw : ∀ x ∈ O \ Sig, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x ≠ 0)
    (hbd : ∃ C : ℝ, ∀ x ∈ O \ Sig, w x ≤ t₀ → g.gradInner w w x ≤ C ∧ |g.levelMeanCurv w x| ≤ C)
    (ha : 0 < a) (hab : a < b) (hb : b ≤ t₀) (hc : 0 < c) (hcd : c < d) (hd : d ≤ t₀)
    {n : ℕ} (q : Fin n → M) (φ : Fin n → M → ℝ) (hφ : calPartition q φ Ω) (hO'' : IsOpen O'')
    (hsub : {x | x ∈ O ∧ w x ≤ t₀} ⊆ O'') (h1 : ∀ x ∈ O'', ∑ j, φ j x = 1) :
    calVolSum g q φ E (fun x => Real.sqrt (g.gradInner
        (O.indicator (fun x => 1 - Real.smoothTransition ((w x - a) / (b - a))))
        (O.indicator (fun x => 1 - Real.smoothTransition ((w x - a) / (b - a)))) x)) -
      calVolSum g q φ E (fun x =>
        O.indicator (fun x => 1 - Real.smoothTransition ((w x - a) / (b - a))) x *
          g.levelMeanCurv w x) =
    calVolSum g q φ E (fun x => Real.sqrt (g.gradInner
        (O.indicator (fun x => 1 - Real.smoothTransition ((w x - c) / (d - c))))
        (O.indicator (fun x => 1 - Real.smoothTransition ((w x - c) / (d - c)))) x)) -
      calVolSum g q φ E (fun x =>
        O.indicator (fun x => 1 - Real.smoothTransition ((w x - c) / (d - c))) x *
          g.levelMeanCurv w x) :=
by
  have hSigc : IsClosed Sig := hfr ▸ isClosed_frontier
  obtain ⟨Z, hZs, hZ0, hZfr, hZrep⟩ := collar_flux_field g Sig E O w t₀ a b c d hE hfr hO hcpt
    hwc hw0 hws hdw ha hab hb hc hcd hd
  obtain ⟨ζ, hζ⟩ : ∃ f : M → ℝ,
      f = O.indicator (fun x => 1 - Real.smoothTransition ((w x - a) / (b - a))) := ⟨_, rfl⟩
  obtain ⟨χ, hχ⟩ : ∃ f : M → ℝ,
      f = O.indicator (fun x => 1 - Real.smoothTransition ((w x - c) / (d - c))) := ⟨_, rfl⟩
  have hζs := (collar_cutoff_props Sig O w t₀ a b hSigc hO hcpt hwc hw0 hws ha hab hb).1
  have hχs := (collar_cutoff_props Sig O w t₀ c d hSigc hO hcpt hwc hw0 hws hc hcd hd).1
  rw [← hζ] at hζs
  rw [← hχ] at hχs
  rw [← hζ, ← hχ]
  
  have abstr : ∀ (Q : Set E3) (A B C D V I : E3 → ℝ), MeasurableSet Q →
      IntegrableOn A Q → IntegrableOn B Q → IntegrableOn C Q → IntegrableOn D Q →
      IntegrableOn V Q → IntegrableOn I Q →
      (∀ y ∈ Q, (C y - B y) - (D y - A y) = V y - I y) → ∫ y in Q, V y = 0 →
      (∫ y in Q, C y) - (∫ y in Q, B y) - ((∫ y in Q, D y) - (∫ y in Q, A y)) =
        -(∫ y in Q, I y) := by
    intro Q A B C D V I hQ hA hB hC hD hV hI hpt hV0
    have e1 : ∫ y in Q, ((C y - B y) - (D y - A y)) = ∫ y in Q, (V y - I y) :=
      setIntegral_congr_fun hQ hpt
    have e2 : ∫ y in Q, (C y - B y) = (∫ y in Q, C y) - ∫ y in Q, B y := integral_sub hC hB
    have e3 : ∫ y in Q, (D y - A y) = (∫ y in Q, D y) - ∫ y in Q, A y := integral_sub hD hA
    have e4 : ∫ y in Q, ((C y - B y) - (D y - A y)) =
        (∫ y in Q, (C y - B y)) - ∫ y in Q, (D y - A y) := integral_sub (hC.sub hB) (hD.sub hA)
    have e5 : ∫ y in Q, (V y - I y) = (∫ y in Q, V y) - ∫ y in Q, I y := integral_sub hV hI
    linarith
  
  have key : ∀ j : Fin n,
      (∫ y in chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source),
          φ j ((chartAt E3 (q j)).symm y) * Real.sqrt (g.gradInner ζ ζ ((chartAt E3 (q j)).symm y)) *
            Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det) -
        (∫ y in chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source),
          φ j ((chartAt E3 (q j)).symm y) * (ζ ((chartAt E3 (q j)).symm y) *
            g.levelMeanCurv w ((chartAt E3 (q j)).symm y)) *
            Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det) -
        ((∫ y in chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source),
          φ j ((chartAt E3 (q j)).symm y) * Real.sqrt (g.gradInner χ χ ((chartAt E3 (q j)).symm y)) *
            Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det) -
        (∫ y in chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source),
          φ j ((chartAt E3 (q j)).symm y) * (χ ((chartAt E3 (q j)).symm y) *
            g.levelMeanCurv w ((chartAt E3 (q j)).symm y)) *
            Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det)) =
      -(∫ y in chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source),
          Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det *
            fderiv ℝ (fun z => φ j ((chartAt E3 (q j)).symm z)) y
              (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (q j)) ((chartAt E3 (q j)).symm y)
                (Z ((chartAt E3 (q j)).symm y)) : E3)) := by
    intro j
    have hφj := hφ.1 j
    obtain ⟨hφc, hφsub⟩ := hφ.2.2.2 j
    have hφs : tsupport (φ j) ⊆ (chartAt E3 (q j)).source := hφsub.trans Set.inter_subset_right
    have hQm : MeasurableSet (chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source)) :=
      ((chartAt E3 (q j)).isOpen_image_of_subset_source (hE.inter (chartAt E3 (q j)).open_source)
        Set.inter_subset_right).measurableSet
    obtain ⟨hflux, hI2, hdiv⟩ :=
      chart_flux_zero_of_vanishing g E hE Z hZs hZfr (q j) (φ j) hφj hφc hφs
    have hC := chart_gradNorm_integrableOn g E hE ζ (φ j) hζs hφj (q j) hφc hφs
    have hD := chart_gradNorm_integrableOn g E hE χ (φ j) hχs hφj (q j) hφc hφs
    have hB := collar_curv_integrableOn g Sig E O w t₀ a b hE hfr hO hcpt hwc hw0 hws hdw hbd
      ha hab hb (φ j) hφj (q j) hφc hφs
    have hA := collar_curv_integrableOn g Sig E O w t₀ c d hE hfr hO hcpt hwc hw0 hws hdw hbd
      hc hcd hd (φ j) hφj (q j) hφc hφs
    rw [← hζ] at hB
    rw [← hχ] at hA
    refine abstr _ _ _ _ _ _ _ hQm hA hB hC hD hdiv.integrableOn hI2 ?_ hflux
    intro y hy
    have h6 := collar_flux_div_pointwise g Sig E O w t₀ a b c d hE hfr hO hcpt hwc hw0 hws hdw
      ha hab hb hc hcd hd Z hZ0 (q j) (hZrep (q j)) (φ j) hφj y hy
    rw [← hζ, ← hχ] at h6
    beta_reduce
    rw [h6]
    ring
  
  have hE'm : sepChartMeas (E ∩ O'') := by
    intro p
    exact ((chartAt E3 p).isOpen_image_of_subset_source ((hE.inter hO'').inter
      (chartAt E3 p).open_source) Set.inter_subset_right).measurableSet
  have h8 := cal_partition_div_cancel g Ω q φ hφ O'' hO'' h1 Z hZs (E ∩ O'') hE'm
    Set.inter_subset_right
  have hI2sum : ∑ j, (∫ y in chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source),
          Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det *
            fderiv ℝ (fun z => φ j ((chartAt E3 (q j)).symm z)) y
              (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 (q j)) ((chartAt E3 (q j)).symm y)
                (Z ((chartAt E3 (q j)).symm y)) : E3)) = 0 := by
    rw [← h8]
    refine Finset.sum_congr rfl (fun j _ => ?_)
    have hQm : MeasurableSet (chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source)) :=
      ((chartAt E3 (q j)).isOpen_image_of_subset_source (hE.inter (chartAt E3 (q j)).open_source)
        Set.inter_subset_right).measurableSet
    refine setIntegral_eq_of_subset_of_forall_diff_eq_zero hQm
      (Set.image_mono (Set.inter_subset_inter_left _ Set.inter_subset_left)) ?_
    rintro y ⟨⟨x, ⟨hxE, hxs⟩, rfl⟩, hy⟩
    have hxO : x ∉ O'' := fun hxO => hy ⟨x, ⟨⟨hxE, hxO⟩, hxs⟩, rfl⟩
    have hZx : Z x = 0 := by
      by_contra hne
      obtain ⟨-, hxO', -, hwx⟩ := hZ0 x hne
      exact hxO (hsub ⟨hxO', hwx⟩)
    simp [(chartAt E3 (q j)).left_inv hxs, hZx]
  have hfinal := Finset.sum_congr (s₁ := (Finset.univ : Finset (Fin n))) rfl
    (fun j (_ : j ∈ Finset.univ) => key j)
  rw [Finset.sum_neg_distrib, hI2sum, neg_zero, Finset.sum_sub_distrib, Finset.sum_sub_distrib,
    Finset.sum_sub_distrib] at hfinal
  simp only [calVolSum]
  linarith

theorem chart_volume_family_le [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (Ω O'' E Kf : Set M) (hE : sepChartMeas E) {n : ℕ} (q : Fin n → M) (φ : Fin n → M → ℝ)
    (hφ : calPartition q φ Ω) (hO'' : IsOpen O'') (h1 : ∀ x ∈ O'', ∑ j, φ j x = 1)
    (u : M → ℝ) (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u) (hKf : IsCompact Kf) (hKfO : Kf ⊆ O'')
    (hus : ∀ x, x ∉ Kf → mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u x = 0) {m : ℕ} (pp : Fin m → M)
    (W : Fin m → Set M) (T : Fin m → Set E3)
    (hW : ∀ k, IsOpen (W k) ∧ W k ⊆ (chartAt E3 (pp k)).source)
    (hWd : Pairwise (fun k l => Disjoint (W k) (W l)))
    (hT : ∀ k, IsCompact (T k) ∧ T k ⊆ chartAt E3 (pp k) '' W k) :
    ∑ k, ∫ y in chartAt E3 (pp k) '' (E ∩ (chartAt E3 (pp k)).source) ∩ T k,
        Real.sqrt (g.coeff (chartAt E3 (pp k)).symm y).det *
          Real.sqrt (g.gradInner u u ((chartAt E3 (pp k)).symm y)) ≤
      calVolSum g q φ E (fun x => Real.sqrt (g.gradInner u u x)) :=
by
  classical
  
  
  have intK : ∀ (h : E3 → ℝ) (K S : Set E3), IsCompact K → ContinuousOn h K → MeasurableSet S →
      (∀ y ∈ S, y ∉ K → h y = 0) → IntegrableOn h S volume := by
    intro h K S hK hh hS h0
    have hInd := (hh.integrableOn_compact (μ := volume) hK).integrable_indicator hK.measurableSet
    refine (hInd.integrableOn (s := S)).congr_fun (fun y hy => ?_) hS
    by_cases hyK : y ∈ K
    · simp [Set.indicator, hyK]
    · simp [Set.indicator, hyK, h0 y hy hyK]
  
  have famle : ∀ (U : Fin m → Set E3) (S : Set E3) (F : E3 → ℝ), (∀ k, MeasurableSet (U k)) →
      (∀ k, U k ⊆ S) → Pairwise (fun k l => Disjoint (U k) (U l)) → MeasurableSet S →
      (∀ z ∈ S, 0 ≤ F z) → IntegrableOn F S volume →
      ∑ k, ∫ z in U k, F z ≤ ∫ z in S, F z := by
    intro U S F hU hUS hd hS hF hI
    rw [← integral_finset_biUnion Finset.univ (fun k _ => hU k)
      (fun k _ l _ hkl => hd hkl) (fun k _ => hI.mono_set (hUS k))]
    exact setIntegral_mono_set hI (ae_restrict_of_forall_mem hS hF)
      (Set.iUnion₂_subset fun k _ => hUS k).eventuallyLE
  
  have hgz : ∀ x, x ∉ Kf → g.gradInner u u x = 0 := by
    intro x hx
    have hxx : (chartAt E3 x).symm (chartAt E3 x x) = x :=
      (chartAt E3 x).left_inv (mem_chart_source E3 x)
    have hA : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) (chartAt E3 x).symm (chartAt E3 x x) :=
      mdifferentiableAt_atlas_symm (I := 𝓘(ℝ, E3)) (chart_mem_atlas E3 x) (mem_chart_target E3 x)
    have hux : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u ((chartAt E3 x).symm (chartAt E3 x x)) :=
      hu.mdifferentiableAt (by simp)
    have hcomp := mfderiv_comp (chartAt E3 x x) hux hA
    have hz : mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) u ((chartAt E3 x).symm (chartAt E3 x x)) = 0 :=
      hus _ (by rw [hxx]; exact hx)
    have h0 : fderiv ℝ (fun y => u ((chartAt E3 x).symm y)) (chartAt E3 x x) = 0 := by
      rw [← mfderiv_eq_fderiv]
      show mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) (u ∘ (chartAt E3 x).symm) (chartAt E3 x x) = 0
      rw [hcomp, hz]
      exact ContinuousLinearMap.zero_comp _
    simp only [RiemannianMetric3.gradInner, partialDeriv, h0, ContinuousLinearMap.zero_apply,
      mul_zero, Finset.sum_const_zero]
  
  
  have hG : ∀ p : M, ContinuousOn (g.coeff (chartAt E3 p).symm) (chartAt E3 p).target := by
    intro p
    exact continuousOn_pi.2 fun i => continuousOn_pi.2 fun j => (g.smooth p i j).continuousOn
  have hdetc : Continuous (fun A : Matrix (Fin 3) (Fin 3) ℝ => A.det) := continuous_id.matrix_det
  have hsqdet : ∀ p : M, ContinuousOn (fun y => Real.sqrt (g.coeff (chartAt E3 p).symm y).det)
      (chartAt E3 p).target :=
    fun p => Real.continuous_sqrt.comp_continuousOn (hdetc.comp_continuousOn (hG p))
  have hinvc : ∀ p : M, ∀ i j : Fin 3,
      ContinuousOn (fun y => (g.coeff (chartAt E3 p).symm y)⁻¹ i j) (chartAt E3 p).target := by
    intro p i j
    have hadj : Continuous (fun A : Matrix (Fin 3) (Fin 3) ℝ => A.adjugate i j) :=
      (continuous_id.matrix_adjugate).matrix_elem i j
    have h1 : ContinuousOn (fun y => ((g.coeff (chartAt E3 p).symm y).det)⁻¹ *
        (g.coeff (chartAt E3 p).symm y).adjugate i j) (chartAt E3 p).target :=
      ((hdetc.comp_continuousOn (hG p)).inv₀
        fun y hy => (coeff_chart_symm_posDef g p y hy).det_pos.ne').mul
        (hadj.comp_continuousOn (hG p))
    refine h1.congr fun y _ => ?_
    simp only [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
  have hgradc : ∀ p : M, ContinuousOn (fun y => g.gradInner u u ((chartAt E3 p).symm y))
      (chartAt E3 p).target := by
    intro p
    let Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
      { toPartialEquiv := (chartAt E3 p).symm.toPartialEquiv
        open_source := (chartAt E3 p).open_target
        open_target := (chartAt E3 p).open_source
        contMDiffOn_toFun := contMDiffOn_chart_symm
        contMDiffOn_invFun := contMDiffOn_chart }
    have hup : ContDiffOn ℝ ∞ (fun z => u ((chartAt E3 p).symm z)) (chartAt E3 p).target :=
      contMDiffOn_iff_contDiffOn.mp (hu.comp_contMDiffOn contMDiffOn_chart_symm)
    have hpd : ∀ i : Fin 3, ContinuousOn
        (fun y => partialDeriv i (fun z => u ((chartAt E3 p).symm z)) y) (chartAt E3 p).target := by
      intro i
      exact (hup.continuousOn_fderiv_of_isOpen (chartAt E3 p).open_target (by simp)).clm_apply
        continuousOn_const
    have hR : ContinuousOn (fun y => ∑ i : Fin 3, ∑ j : Fin 3,
        (g.coeff (chartAt E3 p).symm y)⁻¹ i j *
          partialDeriv i (fun z => u ((chartAt E3 p).symm z)) y *
          partialDeriv j (fun z => u ((chartAt E3 p).symm z)) y) (chartAt E3 p).target := by
      refine continuousOn_finset_sum _ fun i _ => continuousOn_finset_sum _ fun j _ => ?_
      exact ((hinvc p i j).mul (hpd i)).mul (hpd j)
    refine hR.congr fun y hy => ?_
    exact gradInner_eq_coord g Φ u (fun z => u ((chartAt E3 p).symm z)) hu y hy
      (Filter.Eventually.of_forall fun _ => rfl)
  
  
  have pairEq : ∀ (p₁ p₂ : M) (S : Set E3), MeasurableSet S → S ⊆ (chartAt E3 p₁).target →
      (∀ y ∈ S, (chartAt E3 p₁).symm y ∈ (chartAt E3 p₂).source) → ∀ (F : M → ℝ),
      (∀ x, 0 ≤ F x) →
      IntegrableOn (fun y => Real.sqrt (g.coeff (chartAt E3 p₁).symm y).det *
        F ((chartAt E3 p₁).symm y)) S volume →
      IntegrableOn (fun z => Real.sqrt (g.coeff (chartAt E3 p₂).symm z).det *
        F ((chartAt E3 p₂).symm z)) ((fun y => chartAt E3 p₂ ((chartAt E3 p₁).symm y)) '' S)
        volume →
      MeasurableSet ((fun y => chartAt E3 p₂ ((chartAt E3 p₁).symm y)) '' S) ∧
      ∫ y in S, Real.sqrt (g.coeff (chartAt E3 p₁).symm y).det * F ((chartAt E3 p₁).symm y) =
        ∫ z in (fun y => chartAt E3 p₂ ((chartAt E3 p₁).symm y)) '' S,
          Real.sqrt (g.coeff (chartAt E3 p₂).symm z).det * F ((chartAt E3 p₂).symm z) := by
    intro p₁ p₂ S hS hSt hSs F hF hI₁ hI₂
    have hdiff : ∀ y ∈ S, DifferentiableAt ℝ (fun y => chartAt E3 p₂ ((chartAt E3 p₁).symm y)) y :=
      fun y hy => (sep_chart_transition g p₁ p₂ y (hSt hy) (hSs y hy)).1
    have hinj : Set.InjOn (fun y => chartAt E3 p₂ ((chartAt E3 p₁).symm y)) S := by
      intro y hy y' hy' hyy
      have h1 : (chartAt E3 p₁).symm y = (chartAt E3 p₁).symm y' :=
        (chartAt E3 p₂).injOn (hSs y hy) (hSs y' hy') hyy
      exact (chartAt E3 p₁).symm.injOn (hSt hy) (hSt hy') h1
    have hmeas := measurable_image_of_fderivWithin hS
      (fun y hy => (hdiff y hy).hasFDerivAt.hasFDerivWithinAt) hinj
    refine ⟨hmeas, ?_⟩
    have hpos : ∀ y ∈ S,
        0 ≤ (g.coeff (chartAt E3 p₂).symm (chartAt E3 p₂ ((chartAt E3 p₁).symm y))).det :=
      fun y hy => (coeff_chart_symm_posDef g p₂ _
        ((chartAt E3 p₂).map_source (hSs y hy))).det_pos.le
    have hcv := sep_density_change S hS _ hdiff hinj _ _
      (fun y hy => (sep_chart_transition g p₁ p₂ y (hSt hy) (hSs y hy)).2.1) hpos
      (fun z => ENNReal.ofReal (F ((chartAt E3 p₂).symm z)))
    rw [integral_eq_lintegral_of_nonneg_ae
        (ae_of_all _ fun y => mul_nonneg (Real.sqrt_nonneg _) (hF _)) hI₁.aestronglyMeasurable,
      integral_eq_lintegral_of_nonneg_ae
        (ae_of_all _ fun y => mul_nonneg (Real.sqrt_nonneg _) (hF _)) hI₂.aestronglyMeasurable]
    congr 1
    have e1 : ∫⁻ z in (fun y => chartAt E3 p₂ ((chartAt E3 p₁).symm y)) '' S,
        ENNReal.ofReal (Real.sqrt (g.coeff (chartAt E3 p₂).symm z).det *
          F ((chartAt E3 p₂).symm z)) =
        ∫⁻ z in (fun y => chartAt E3 p₂ ((chartAt E3 p₁).symm y)) '' S,
          ENNReal.ofReal (F ((chartAt E3 p₂).symm z)) *
            ENNReal.ofReal (Real.sqrt (g.coeff (chartAt E3 p₂).symm z).det) := by
      refine lintegral_congr fun z => ?_
      rw [ENNReal.ofReal_mul (Real.sqrt_nonneg _), mul_comm]
    have e2 : ∫⁻ y in S, ENNReal.ofReal (Real.sqrt (g.coeff (chartAt E3 p₁).symm y).det *
          F ((chartAt E3 p₁).symm y)) =
        ∫⁻ y in S, ENNReal.ofReal (F ((chartAt E3 p₂).symm
            (chartAt E3 p₂ ((chartAt E3 p₁).symm y)))) *
          ENNReal.ofReal (Real.sqrt (g.coeff (chartAt E3 p₁).symm y).det) := by
      refine setLIntegral_congr_fun hS fun y hy => ?_
      rw [(chartAt E3 p₂).left_inv (hSs y hy), ENNReal.ofReal_mul (Real.sqrt_nonneg _), mul_comm]
    rw [e1, e2]
    exact hcv.symm
  
  
  have key : ∀ F0 : M → ℝ, F0 = (fun x => Real.sqrt (g.gradInner u u x)) →
      ∑ k, ∫ y in chartAt E3 (pp k) '' (E ∩ (chartAt E3 (pp k)).source) ∩ T k,
        Real.sqrt (g.coeff (chartAt E3 (pp k)).symm y).det * F0 ((chartAt E3 (pp k)).symm y) ≤
      calVolSum g q φ E F0 := by
    intro F0 hF0
    have hF0nn : ∀ x, 0 ≤ F0 x := fun x => by rw [hF0]; exact Real.sqrt_nonneg _
    have hF0z : ∀ x, x ∉ Kf → F0 x = 0 := fun x hx => by
      rw [hF0]; show Real.sqrt _ = 0; rw [hgz x hx, Real.sqrt_zero]
    have hF0c : ∀ p : M, ContinuousOn (fun y => F0 ((chartAt E3 p).symm y)) (chartAt E3 p).target := by
      intro p
      rw [hF0]
      exact Real.continuous_sqrt.comp_continuousOn (hgradc p)
    have hφc : ∀ (p : M) (j : Fin n),
        ContinuousOn (fun y => φ j ((chartAt E3 p).symm y)) (chartAt E3 p).target :=
      fun p j => (hφ.1 j).continuous.comp_continuousOn (chartAt E3 p).continuousOn_symm
    
    have hTt : ∀ k, T k ⊆ (chartAt E3 (pp k)).target := by
      intro k y hy
      obtain ⟨w, hw, rfl⟩ := (hT k).2 hy
      exact (chartAt E3 (pp k)).map_source ((hW k).2 hw)
    have hAinv : ∀ k, ∀ y ∈ chartAt E3 (pp k) '' (E ∩ (chartAt E3 (pp k)).source) ∩ T k,
        (chartAt E3 (pp k)).symm y ∈ E ∧ (chartAt E3 (pp k)).symm y ∈ W k := by
      intro k y hy
      obtain ⟨⟨x, hx, rfl⟩, hyT⟩ := hy
      refine ⟨by rw [(chartAt E3 (pp k)).left_inv hx.2]; exact hx.1, ?_⟩
      obtain ⟨w, hw, hwx⟩ := (hT k).2 hyT
      rw [← hwx, (chartAt E3 (pp k)).left_inv ((hW k).2 hw)]
      exact hw
    have hAm : ∀ k, MeasurableSet (chartAt E3 (pp k) '' (E ∩ (chartAt E3 (pp k)).source) ∩ T k) :=
      fun k => (hE (pp k)).inter (hT k).1.measurableSet
    
    have hIakj : ∀ k j, IntegrableOn (fun y => Real.sqrt (g.coeff (chartAt E3 (pp k)).symm y).det *
        (φ j ((chartAt E3 (pp k)).symm y) * F0 ((chartAt E3 (pp k)).symm y)))
        (chartAt E3 (pp k) '' (E ∩ (chartAt E3 (pp k)).source) ∩ T k) volume := by
      intro k j
      refine intK _ (T k) _ (hT k).1 ?_ (hAm k) (fun y hy hyT => absurd hy.2 hyT)
      exact ((hsqdet (pp k)).mul ((hφc (pp k) j).mul (hF0c (pp k)))).mono (hTt k)
    
    have hIF : ∀ j, IntegrableOn (fun z => Real.sqrt (g.coeff (chartAt E3 (q j)).symm z).det *
        (φ j ((chartAt E3 (q j)).symm z) * F0 ((chartAt E3 (q j)).symm z)))
        (chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source)) volume := by
      intro j
      have hsub : tsupport (φ j) ⊆ (chartAt E3 (q j)).source :=
        fun x hx => ((hφ.2.2.2 j).2 hx).2
      have hKc : IsCompact (chartAt E3 (q j) '' tsupport (φ j)) :=
        (hφ.2.2.2 j).1.image_of_continuousOn ((chartAt E3 (q j)).continuousOn.mono hsub)
      have hKt : chartAt E3 (q j) '' tsupport (φ j) ⊆ (chartAt E3 (q j)).target := by
        rintro _ ⟨x, hx, rfl⟩
        exact (chartAt E3 (q j)).map_source (hsub hx)
      refine intK _ _ _ hKc ?_ (hE (q j)) ?_
      · exact ((hsqdet (q j)).mul ((hφc (q j) j).mul (hF0c (q j)))).mono hKt
      · rintro _ ⟨x, hx, rfl⟩ hz
        have hx0 : φ j x = 0 := by
          by_contra hne
          exact hz ⟨x, subset_tsupport _ hne, rfl⟩
        simp only [(chartAt E3 (q j)).left_inv hx.2, hx0, zero_mul, mul_zero]
    
    obtain ⟨U, hU⟩ : ∃ U : Fin m → Fin n → Set E3, U = fun k j =>
        (fun y => chartAt E3 (q j) ((chartAt E3 (pp k)).symm y)) ''
          ((chartAt E3 (pp k) '' (E ∩ (chartAt E3 (pp k)).source) ∩ T k) ∩
            (chartAt E3 (pp k)).symm ⁻¹' (chartAt E3 (q j)).source) := ⟨_, rfl⟩
    have hkj : ∀ k j, MeasurableSet (U k j) ∧
        U k j ⊆ chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source) ∧
        ∫ y in chartAt E3 (pp k) '' (E ∩ (chartAt E3 (pp k)).source) ∩ T k,
          Real.sqrt (g.coeff (chartAt E3 (pp k)).symm y).det *
            (φ j ((chartAt E3 (pp k)).symm y) * F0 ((chartAt E3 (pp k)).symm y)) =
        ∫ z in U k j, Real.sqrt (g.coeff (chartAt E3 (q j)).symm z).det *
          (φ j ((chartAt E3 (q j)).symm z) * F0 ((chartAt E3 (q j)).symm z)) := by
      intro k j
      have ho : IsOpen ((chartAt E3 (pp k)).target ∩
          (chartAt E3 (pp k)).symm ⁻¹' (chartAt E3 (q j)).source) :=
        (chartAt E3 (pp k)).continuousOn_symm.isOpen_inter_preimage
          (chartAt E3 (pp k)).open_target (chartAt E3 (q j)).open_source
      have hSeq : (chartAt E3 (pp k) '' (E ∩ (chartAt E3 (pp k)).source) ∩ T k) ∩
            (chartAt E3 (pp k)).symm ⁻¹' (chartAt E3 (q j)).source =
          (chartAt E3 (pp k) '' (E ∩ (chartAt E3 (pp k)).source) ∩ T k) ∩
            ((chartAt E3 (pp k)).target ∩
              (chartAt E3 (pp k)).symm ⁻¹' (chartAt E3 (q j)).source) := by
        ext y
        constructor
        · rintro ⟨hyA, hy⟩
          exact ⟨hyA, hTt k hyA.2, hy⟩
        · rintro ⟨hyA, -, hy⟩
          exact ⟨hyA, hy⟩
      have hSm : MeasurableSet ((chartAt E3 (pp k) '' (E ∩ (chartAt E3 (pp k)).source) ∩ T k) ∩
          (chartAt E3 (pp k)).symm ⁻¹' (chartAt E3 (q j)).source) := by
        rw [hSeq]
        exact (hAm k).inter ho.measurableSet
      have hUR : (fun y => chartAt E3 (q j) ((chartAt E3 (pp k)).symm y)) ''
          ((chartAt E3 (pp k) '' (E ∩ (chartAt E3 (pp k)).source) ∩ T k) ∩
            (chartAt E3 (pp k)).symm ⁻¹' (chartAt E3 (q j)).source) ⊆
          chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source) := by
        rintro _ ⟨y, ⟨hyA, hys⟩, rfl⟩
        exact ⟨_, ⟨(hAinv k y hyA).1, hys⟩, rfl⟩
      obtain ⟨hmU, hEq⟩ := pairEq (pp k) (q j) _ hSm
        (fun y hy => hTt k hy.1.2) (fun y hy => hy.2) (fun x => φ j x * F0 x)
        (fun x => mul_nonneg (hφ.2.1 j x) (hF0nn x))
        ((hIakj k j).mono_set Set.inter_subset_left) ((hIF j).mono_set hUR)
      have hrestr := setIntegral_eq_of_subset_of_forall_diff_eq_zero (μ := volume)
        (f := fun y => Real.sqrt (g.coeff (chartAt E3 (pp k)).symm y).det *
            (φ j ((chartAt E3 (pp k)).symm y) * F0 ((chartAt E3 (pp k)).symm y)))
        (hAm k) (Set.inter_subset_left (t := (chartAt E3 (pp k)).symm ⁻¹' (chartAt E3 (q j)).source))
        (by
          intro y hy
          have hx0 : φ j ((chartAt E3 (pp k)).symm y) = 0 := by
            by_contra hne
            exact hy.2 ⟨hy.1, ((hφ.2.2.2 j).2 (subset_tsupport _ hne)).2⟩
          simp only [hx0, zero_mul, mul_zero])
      refine ⟨by rw [hU]; exact hmU, by rw [hU]; exact hUR, ?_⟩
      rw [hrestr, hU]
      exact hEq
    have hUd : ∀ j, Pairwise (fun k l => Disjoint (U k j) (U l j)) := by
      intro j k l hkl
      simp only [hU]
      rw [Set.disjoint_left]
      rintro _ ⟨y, ⟨hyA, hys⟩, rfl⟩ ⟨y', ⟨hyA', hys'⟩, hyy⟩
      have hxx : (chartAt E3 (pp l)).symm y' = (chartAt E3 (pp k)).symm y :=
        (chartAt E3 (q j)).injOn hys' hys hyy
      have hl := (hAinv l y' hyA').2
      rw [hxx] at hl
      exact Set.disjoint_left.1 (hWd hkl) (hAinv k y hyA).2 hl
    
    have hk : ∀ k, ∫ y in chartAt E3 (pp k) '' (E ∩ (chartAt E3 (pp k)).source) ∩ T k,
        Real.sqrt (g.coeff (chartAt E3 (pp k)).symm y).det * F0 ((chartAt E3 (pp k)).symm y) =
        ∑ j, ∫ y in chartAt E3 (pp k) '' (E ∩ (chartAt E3 (pp k)).source) ∩ T k,
          Real.sqrt (g.coeff (chartAt E3 (pp k)).symm y).det *
            (φ j ((chartAt E3 (pp k)).symm y) * F0 ((chartAt E3 (pp k)).symm y)) := by
      intro k
      rw [← integral_finset_sum _ (fun j _ => hIakj k j)]
      refine setIntegral_congr_fun (hAm k) fun y _ => ?_
      rw [← Finset.mul_sum, ← Finset.sum_mul]
      by_cases hx : (chartAt E3 (pp k)).symm y ∈ Kf
      · rw [h1 _ (hKfO hx), one_mul]
      · rw [hF0z _ hx, mul_zero, mul_zero, mul_zero]
    calc ∑ k, ∫ y in chartAt E3 (pp k) '' (E ∩ (chartAt E3 (pp k)).source) ∩ T k,
          Real.sqrt (g.coeff (chartAt E3 (pp k)).symm y).det * F0 ((chartAt E3 (pp k)).symm y)
        = ∑ k, ∑ j, ∫ z in U k j, Real.sqrt (g.coeff (chartAt E3 (q j)).symm z).det *
            (φ j ((chartAt E3 (q j)).symm z) * F0 ((chartAt E3 (q j)).symm z)) := by
          refine Finset.sum_congr rfl fun k _ => ?_
          rw [hk k]
          exact Finset.sum_congr rfl fun j _ => (hkj k j).2.2
      _ = ∑ j, ∑ k, ∫ z in U k j, Real.sqrt (g.coeff (chartAt E3 (q j)).symm z).det *
            (φ j ((chartAt E3 (q j)).symm z) * F0 ((chartAt E3 (q j)).symm z)) :=
          Finset.sum_comm
      _ ≤ ∑ j, ∫ z in chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source),
            Real.sqrt (g.coeff (chartAt E3 (q j)).symm z).det *
              (φ j ((chartAt E3 (q j)).symm z) * F0 ((chartAt E3 (q j)).symm z)) := by
          refine Finset.sum_le_sum fun j _ => ?_
          exact famle (fun k => U k j) _ _ (fun k => (hkj k j).1) (fun k => (hkj k j).2.1)
            (hUd j) (hE (q j))
            (fun z _ => mul_nonneg (Real.sqrt_nonneg _) (mul_nonneg (hφ.2.1 j _) (hF0nn _)))
            (hIF j)
      _ = calVolSum g q φ E F0 := by
          unfold calVolSum
          refine Finset.sum_congr rfl fun j _ => ?_
          congr 1
          funext z
          ring
  exact key _ rfl

theorem chart_pullback_gradInner [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (u : M → ℝ) (hu : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ u) (p : M) :
    ContDiffOn ℝ ∞ (fun y => u ((chartAt E3 p).symm y)) (chartAt E3 p).target ∧
      (∀ y ∈ (chartAt E3 p).target, g.gradInner u u ((chartAt E3 p).symm y) =
        ∑ i : Fin 3, ∑ j : Fin 3, (g.coeff (chartAt E3 p).symm y)⁻¹ i j *
          partialDeriv i (fun z => u ((chartAt E3 p).symm z)) y *
          partialDeriv j (fun z => u ((chartAt E3 p).symm z)) y) ∧
      ContinuousOn (fun y => Real.sqrt (g.coeff (chartAt E3 p).symm y).det *
        Real.sqrt (g.gradInner u u ((chartAt E3 p).symm y))) (chartAt E3 p).target :=
by
  classical
  have hG : ContinuousOn (g.coeff (chartAt E3 p).symm) (chartAt E3 p).target :=
    continuousOn_pi.2 fun i => continuousOn_pi.2 fun j => (g.smooth p i j).continuousOn
  have hdetc : Continuous (fun A : Matrix (Fin 3) (Fin 3) ℝ => A.det) := continuous_id.matrix_det
  have hsqdet : ContinuousOn (fun y => Real.sqrt (g.coeff (chartAt E3 p).symm y).det)
      (chartAt E3 p).target :=
    Real.continuous_sqrt.comp_continuousOn (hdetc.comp_continuousOn hG)
  have hinvc : ∀ i j : Fin 3,
      ContinuousOn (fun y => (g.coeff (chartAt E3 p).symm y)⁻¹ i j) (chartAt E3 p).target := by
    intro i j
    have hadj : Continuous (fun A : Matrix (Fin 3) (Fin 3) ℝ => A.adjugate i j) :=
      (continuous_id.matrix_adjugate).matrix_elem i j
    have h1 : ContinuousOn (fun y => ((g.coeff (chartAt E3 p).symm y).det)⁻¹ *
        (g.coeff (chartAt E3 p).symm y).adjugate i j) (chartAt E3 p).target :=
      ((hdetc.comp_continuousOn hG).inv₀
        fun y hy => (coeff_chart_symm_posDef g p y hy).det_pos.ne').mul
        (hadj.comp_continuousOn hG)
    refine h1.congr fun y _ => ?_
    simp only [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
  let Φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
    { toPartialEquiv := (chartAt E3 p).symm.toPartialEquiv
      open_source := (chartAt E3 p).open_target
      open_target := (chartAt E3 p).open_source
      contMDiffOn_toFun := contMDiffOn_chart_symm
      contMDiffOn_invFun := contMDiffOn_chart }
  have hup : ContDiffOn ℝ ∞ (fun z => u ((chartAt E3 p).symm z)) (chartAt E3 p).target :=
    contMDiffOn_iff_contDiffOn.mp (hu.comp_contMDiffOn contMDiffOn_chart_symm)
  have hpd : ∀ i : Fin 3, ContinuousOn
      (fun y => partialDeriv i (fun z => u ((chartAt E3 p).symm z)) y) (chartAt E3 p).target := by
    intro i
    exact (hup.continuousOn_fderiv_of_isOpen (chartAt E3 p).open_target (by simp)).clm_apply
      continuousOn_const
  have hR : ContinuousOn (fun y => ∑ i : Fin 3, ∑ j : Fin 3,
      (g.coeff (chartAt E3 p).symm y)⁻¹ i j *
        partialDeriv i (fun z => u ((chartAt E3 p).symm z)) y *
        partialDeriv j (fun z => u ((chartAt E3 p).symm z)) y) (chartAt E3 p).target := by
    refine continuousOn_finset_sum _ fun i _ => continuousOn_finset_sum _ fun j _ => ?_
    exact ((hinvc i j).mul (hpd i)).mul (hpd j)
  have hgrad : ∀ y ∈ (chartAt E3 p).target, g.gradInner u u ((chartAt E3 p).symm y) =
      ∑ i : Fin 3, ∑ j : Fin 3, (g.coeff (chartAt E3 p).symm y)⁻¹ i j *
        partialDeriv i (fun z => u ((chartAt E3 p).symm z)) y *
        partialDeriv j (fun z => u ((chartAt E3 p).symm z)) y := by
    intro y hy
    exact gradInner_eq_coord g Φ u (fun z => u ((chartAt E3 p).symm z)) hu y hy
      (Filter.Eventually.of_forall fun _ => rfl)
  have hgradc : ContinuousOn (fun y => g.gradInner u u ((chartAt E3 p).symm y))
      (chartAt E3 p).target :=
    hR.congr fun y hy => hgrad y hy
  exact ⟨hup, hgrad, hsqdet.mul (Real.continuous_sqrt.comp_continuousOn hgradc)⟩

theorem chart_field_comp_bound [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) (p : M)
    (Y : E3 → E3) (hYc : HasCompactSupport Y) (hYt : tsupport Y ⊆ (chartAt E3 p).target)
    (hYn : ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, g.coeff (chartAt E3 p).symm y i j * Y y i * Y y j ≤ 1) :
    ∃ B : ℝ, 0 ≤ B ∧ ∀ (z : E3) (i : Fin 3),
      |Real.sqrt (g.coeff (chartAt E3 p).symm z).det * Y z i| ≤ B :=
by
  classical
  set G := g.coeff (chartAt E3 p).symm with hGdef
  have hGs : ∀ i j : Fin 3, ContinuousOn (fun z => G z i j) (chartAt E3 p).target :=
    fun i j => (g.smooth p i j).continuousOn
  have hGc : ContinuousOn G (chartAt E3 p).target :=
    continuousOn_pi.2 fun i => continuousOn_pi.2 fun j => hGs i j
  have hadj : ∀ i : Fin 3,
      ContinuousOn (fun z => Real.sqrt ((G z).adjugate i i)) (chartAt E3 p).target := by
    intro i
    have h1 : ContinuousOn (fun z => (G z).adjugate) (chartAt E3 p).target :=
      (Continuous.matrix_adjugate continuous_id).comp_continuousOn hGc
    have h2 : ContinuousOn (fun z => (G z).adjugate i i) (chartAt E3 p).target :=
      continuousOn_pi.1 (continuousOn_pi.1 h1 i) i
    exact Real.continuous_sqrt.comp_continuousOn h2
  have hH : ContinuousOn (fun z => ∑ i : Fin 3, Real.sqrt ((G z).adjugate i i)) (tsupport Y) :=
    (continuousOn_finset_sum Finset.univ fun i _ => hadj i).mono hYt
  obtain ⟨b, hb⟩ := hYc.exists_bound_of_continuousOn hH
  refine ⟨max b 0, le_max_right _ _, fun z i => ?_⟩
  by_cases hz : z ∈ tsupport Y
  · have hzt := hYt hz
    have hA : (G z).PosDef := coeff_chart_symm_posDef g p z hzt
    have hdet : 0 < (G z).det := hA.det_pos
    have hinvpos : 0 < (G z)⁻¹ i i := hA.inv.diag_pos
    have hCS := smth_quad_cauchySchwarz (G z) hA (fun j => Y z j) (Pi.single i 1)
    beta_reduce at hCS
    have e1 : ∑ k : Fin 3, Y z k * (Pi.single i (1:ℝ) : Fin 3 → ℝ) k = Y z i := by
      simp [Pi.single_apply]
    have e2 : ∑ k : Fin 3, ∑ l : Fin 3, (G z)⁻¹ k l * (Pi.single i (1:ℝ) : Fin 3 → ℝ) k *
        (Pi.single i (1:ℝ) : Fin 3 → ℝ) l = (G z)⁻¹ i i := by
      simp [Pi.single_apply]
    rw [e1, e2] at hCS
    have hsq : (Y z i) ^ 2 ≤ (G z)⁻¹ i i :=
      hCS.trans (mul_le_of_le_one_left hinvpos.le (hYn z))
    have hinvadj : (G z).det * (G z)⁻¹ i i = (G z).adjugate i i := by
      rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv', ← mul_assoc,
        mul_inv_cancel₀ hdet.ne', one_mul]
    have hkey : (Real.sqrt (G z).det * Y z i) ^ 2 ≤ (G z).adjugate i i := by
      rw [mul_pow, Real.sq_sqrt hdet.le, ← hinvadj]
      exact mul_le_mul_of_nonneg_left hsq hdet.le
    have h3 : |Real.sqrt (G z).det * Y z i| ≤ Real.sqrt ((G z).adjugate i i) :=
      Real.abs_le_sqrt hkey
    have h4 : Real.sqrt ((G z).adjugate i i) ≤ ∑ j : Fin 3, Real.sqrt ((G z).adjugate j j) :=
      Finset.single_le_sum (f := fun j => Real.sqrt ((G z).adjugate j j))
        (fun j _ => Real.sqrt_nonneg _) (Finset.mem_univ i)
    have h5 := hb z hz
    rw [Real.norm_eq_abs] at h5
    calc |Real.sqrt (G z).det * Y z i| ≤ Real.sqrt ((G z).adjugate i i) := h3
      _ ≤ ∑ j : Fin 3, Real.sqrt ((G z).adjugate j j) := h4
      _ ≤ |∑ j : Fin 3, Real.sqrt ((G z).adjugate j j)| := le_abs_self _
      _ ≤ b := h5
      _ ≤ max b 0 := le_max_left _ _
  · rw [image_eq_zero_of_notMem_tsupport hz]
    simp

theorem sepDensDiv_smul_eq (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (s : E3 → ℝ) (Y : E3 → E3)
    (y : E3) (hs : DifferentiableAt ℝ s y)
    (hF : ∀ i : Fin 3, DifferentiableAt ℝ (fun z => Real.sqrt (G z).det * Y z i) y) :
    sepDensDiv G (fun z => s z • Y z) y =
      s y * sepDensDiv G Y y + Real.sqrt (G y).det * ∑ i : Fin 3, partialDeriv i s y * Y y i :=
by
  have key : ∀ i : Fin 3,
      partialDeriv i (fun z => Real.sqrt (G z).det * (s z • Y z) i) y =
        s y * partialDeriv i (fun z => Real.sqrt (G z).det * Y z i) y +
          Real.sqrt (G y).det * (partialDeriv i s y * Y y i) := by
    intro i
    have h1 : (fun z => Real.sqrt (G z).det * (s z • Y z) i) =
        (fun z => s z * (Real.sqrt (G z).det * Y z i)) := by
      funext z
      simp only [PiLp.smul_apply, smul_eq_mul]
      ring
    unfold partialDeriv
    rw [h1, fderiv_fun_mul hs (hF i)]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  unfold sepDensDiv
  dsimp only
  simp only [key]
  rw [Finset.sum_add_distrib, Finset.mul_sum, Finset.mul_sum]

theorem sepDensDiv_smul_dev_le (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (s : E3 → ℝ) (Y : E3 → E3)
    (y : E3) (hs : DifferentiableAt ℝ s y) (hs0 : ∀ z, 0 ≤ s z) (B : ℝ)
    (hB : ∀ (z : E3) (i : Fin 3), |Real.sqrt (G z).det * Y z i| ≤ B) :
    |sepDensDiv G (fun z => s z • Y z) y - s y * sepDensDiv G Y y| ≤
      ∑ i : Fin 3, |partialDeriv i s y| * B :=
by
  have hB0 : 0 ≤ B := (abs_nonneg _).trans (hB y 0)
  
  have s1 : ∀ f : E3 → ℝ, (∀ z, |f z| ≤ B) → s y = 0 →
      HasFDerivAt (fun z => s z * f z) (0 : E3 →L[ℝ] ℝ) y := by
    intro f hf hsy
    have hmin : IsLocalMin s y :=
      Filter.Eventually.of_forall (fun z => by rw [hsy]; exact hs0 z)
    have hd : HasFDerivAt s (0 : E3 →L[ℝ] ℝ) y := by
      have h := hs.hasFDerivAt
      rwa [hmin.fderiv_eq_zero] at h
    have hso := hasFDerivAt_iff_isLittleO_nhds_zero.mp hd
    simp only [hsy, sub_zero, ContinuousLinearMap.zero_apply] at hso
    rw [hasFDerivAt_iff_isLittleO_nhds_zero]
    simp only [hsy, zero_mul, sub_zero, ContinuousLinearMap.zero_apply]
    have hO : (fun h : E3 => s (y + h) * f (y + h)) =O[𝓝 0] (fun h => s (y + h)) := by
      refine Asymptotics.IsBigO.of_bound B (Filter.Eventually.of_forall fun h => ?_)
      rw [norm_mul, Real.norm_eq_abs, Real.norm_eq_abs, mul_comm]
      exact mul_le_mul_of_nonneg_right (hf _) (abs_nonneg _)
    exact hO.trans_isLittleO hso
  
  have s2 : ∀ f : E3 → ℝ, s y ≠ 0 → ¬ DifferentiableAt ℝ f y →
      ¬ DifferentiableAt ℝ (fun z => s z * f z) y := by
    intro f hsy hf h
    apply hf
    have hne : ∀ᶠ z in 𝓝 y, s z ≠ 0 := hs.continuousAt.eventually_ne hsy
    have hinv : DifferentiableAt ℝ (fun z => (s z)⁻¹) y := hs.inv hsy
    have hq : DifferentiableAt ℝ (fun z => s z * f z * (s z)⁻¹) y := h.mul hinv
    refine hq.congr_of_eventuallyEq ?_
    filter_upwards [hne] with z hz
    field_simp
  
  have s3 : ∀ i : Fin 3,
      |fderiv ℝ (fun z => s z * (Real.sqrt (G z).det * Y z i)) y (e i) -
        s y * fderiv ℝ (fun z => Real.sqrt (G z).det * Y z i) y (e i)| ≤
        |fderiv ℝ s y (e i)| * B := by
    intro i
    by_cases hF : DifferentiableAt ℝ (fun z => Real.sqrt (G z).det * Y z i) y
    · have hm : HasFDerivAt (fun z => s z * (Real.sqrt (G z).det * Y z i))
          (s y • fderiv ℝ (fun z => Real.sqrt (G z).det * Y z i) y +
            (Real.sqrt (G y).det * Y y i) • fderiv ℝ s y) y :=
        hs.hasFDerivAt.mul hF.hasFDerivAt
      rw [hm.fderiv]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
      rw [show s y * fderiv ℝ (fun z => Real.sqrt (G z).det * Y z i) y (e i) +
          Real.sqrt (G y).det * Y y i * fderiv ℝ s y (e i) -
          s y * fderiv ℝ (fun z => Real.sqrt (G z).det * Y z i) y (e i) =
          Real.sqrt (G y).det * Y y i * fderiv ℝ s y (e i) by ring]
      rw [abs_mul, mul_comm]
      exact mul_le_mul_of_nonneg_left (hB y i) (abs_nonneg _)
    · by_cases hsy : s y = 0
      · rw [(s1 _ (fun z => hB z i) hsy).fderiv, hsy]
        simp only [ContinuousLinearMap.zero_apply, zero_mul, sub_zero, abs_zero]
        exact mul_nonneg (abs_nonneg _) hB0
      · rw [fderiv_zero_of_not_differentiableAt (s2 _ hsy hF),
          fderiv_zero_of_not_differentiableAt hF]
        simp only [ContinuousLinearMap.zero_apply, mul_zero, sub_zero, abs_zero]
        exact mul_nonneg (abs_nonneg _) hB0
  
  have s4 : ∀ i : Fin 3, (fun z => Real.sqrt (G z).det * (s z • Y z) i) =
      fun z => s z * (Real.sqrt (G z).det * Y z i) := by
    intro i
    funext z
    simp only [PiLp.smul_apply, smul_eq_mul]
    ring
  
  unfold sepDensDiv partialDeriv
  simp_rw [s4]
  rw [Finset.mul_sum, ← Finset.sum_sub_distrib]
  exact (Finset.abs_sum_le_sum_abs _ _).trans (Finset.sum_le_sum fun i _ => s3 i)

theorem sepDensDiv_support_integrable (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (X : E3 → E3) :
    (∀ y, y ∉ tsupport X → sepDensDiv G X y = 0) ∧
      (HasCompactSupport X → ∀ C : ℝ, (∀ y, |sepDensDiv G X y| ≤ C) →
        MeasureTheory.Integrable (sepDensDiv G X) MeasureTheory.volume) :=
by
  have hA : ∀ y, y ∉ tsupport X → sepDensDiv G X y = 0 := by
    intro y hy
    have hev : X =ᶠ[𝓝 y] 0 := notMem_tsupport_iff_eventuallyEq.mp hy
    unfold sepDensDiv
    refine Finset.sum_eq_zero (fun i _ => ?_)
    have h2 : (fun z => Real.sqrt (G z).det * X z i) =ᶠ[𝓝 y] (fun _ => (0 : ℝ)) := by
      filter_upwards [hev] with z hz
      rw [hz]
      simp
    unfold partialDeriv
    rw [h2.fderiv_eq, fderiv_const_apply, ContinuousLinearMap.zero_apply]
  refine ⟨hA, fun hX C hC => ?_⟩
  have hmeas : Measurable (sepDensDiv G X) := by
    unfold sepDensDiv partialDeriv
    exact Finset.measurable_sum _
      (fun i _ => measurable_fderiv_apply_const ℝ (fun z => Real.sqrt (G z).det * X z i) (e i))
  have hK : IsCompact (tsupport X) := hX.isCompact
  have hon : MeasureTheory.IntegrableOn (sepDensDiv G X) (tsupport X) MeasureTheory.volume :=
    MeasureTheory.Measure.integrableOn_of_bounded (M := C) hK.measure_lt_top.ne
      hmeas.aestronglyMeasurable
      (MeasureTheory.ae_of_all _ (fun a => by rw [Real.norm_eq_abs]; exact hC a))
  exact hon.integrable_of_forall_notMem_eq_zero hA

theorem setIntegral_split_le (T A S K : Set E3) (D Dt J : E3 → ℝ) (C : ℝ)
    (hT : MeasurableSet T) (hA : MeasurableSet A) (hS : MeasurableSet S) (hK : MeasurableSet K)
    (hTA : T ⊆ A) (hSfin : MeasureTheory.volume S ≠ ⊤) (hC : 0 ≤ C)
    (hD : MeasureTheory.Integrable D MeasureTheory.volume)
    (hDt : MeasureTheory.Integrable Dt MeasureTheory.volume)
    (hJ : MeasureTheory.IntegrableOn J (A ∩ K) MeasureTheory.volume)
    (hJ0 : ∀ y ∈ A ∩ K, 0 ≤ J y)
    (hpt : ∀ y ∈ T, D y ≤ Dt y + C * S.indicator (fun _ => (1 : ℝ)) y + K.indicator J y)
    (hzero : ∀ y ∈ A \ T, Dt y = 0) :
    ∫ y in T, D y ≤ (∫ y in A, Dt y) + C * (MeasureTheory.volume S).toReal +
      ∫ y in A ∩ K, J y :=
by
  have hS1 : MeasureTheory.Integrable (S.indicator (fun _ => (1 : ℝ))) MeasureTheory.volume :=
    (MeasureTheory.integrable_indicator_iff hS).2 (MeasureTheory.integrableOn_const hSfin)
  have I1 : MeasureTheory.IntegrableOn Dt T MeasureTheory.volume := hDt.integrableOn
  have I2 : MeasureTheory.IntegrableOn (fun y => C * S.indicator (fun _ => (1 : ℝ)) y) T
      MeasureTheory.volume := (hS1.const_mul C).integrableOn
  have hAK1 : MeasureTheory.Integrable ((A ∩ K).indicator J) MeasureTheory.volume :=
    hJ.integrable_indicator (hA.inter hK)
  have I3 : MeasureTheory.IntegrableOn (K.indicator J) T MeasureTheory.volume := by
    refine hAK1.integrableOn.congr_fun ?_ hT
    intro y hy
    by_cases hyK : y ∈ K
    · have hyAK : y ∈ A ∩ K := ⟨hTA hy, hyK⟩
      simp [Set.indicator_of_mem hyAK, Set.indicator_of_mem hyK]
    · have hyAK : y ∉ A ∩ K := fun h => hyK h.2
      simp [Set.indicator_of_notMem hyAK, Set.indicator_of_notMem hyK]
  have E1 : ∫ y in T, D y ≤ ∫ y in T,
      (Dt y + C * S.indicator (fun _ => (1 : ℝ)) y + K.indicator J y) :=
    MeasureTheory.setIntegral_mono_on hD.integrableOn ((I1.add I2).add I3) hT hpt
  have E2 : ∫ y in T, (Dt y + C * S.indicator (fun _ => (1 : ℝ)) y + K.indicator J y) =
      (∫ y in T, Dt y) + C * (∫ y in T, S.indicator (fun _ => (1 : ℝ)) y) +
        ∫ y in T, K.indicator J y := by
    have I12 : MeasureTheory.IntegrableOn
        (fun y => Dt y + C * S.indicator (fun _ => (1 : ℝ)) y) T MeasureTheory.volume :=
      I1.add I2
    have h1 : ∫ y in T, (Dt y + C * S.indicator (fun _ => (1 : ℝ)) y + K.indicator J y) =
        (∫ y in T, (Dt y + C * S.indicator (fun _ => (1 : ℝ)) y)) +
          ∫ y in T, K.indicator J y := MeasureTheory.integral_add I12 I3
    have h2 : ∫ y in T, (Dt y + C * S.indicator (fun _ => (1 : ℝ)) y) =
        (∫ y in T, Dt y) + ∫ y in T, C * S.indicator (fun _ => (1 : ℝ)) y :=
      MeasureTheory.integral_add I1 I2
    have h3 : ∫ y in T, C * S.indicator (fun _ => (1 : ℝ)) y =
        C * ∫ y in T, S.indicator (fun _ => (1 : ℝ)) y :=
      MeasureTheory.integral_const_mul C _
    rw [h1, h2, h3]
  have E3 : ∫ y in A, Dt y = ∫ y in T, Dt y :=
    MeasureTheory.setIntegral_eq_of_subset_of_forall_diff_eq_zero hA hTA hzero
  have E4 : ∫ y in T, S.indicator (fun _ => (1 : ℝ)) y ≤ (MeasureTheory.volume S).toReal := by
    rw [MeasureTheory.setIntegral_indicator hS, MeasureTheory.setIntegral_const, smul_eq_mul,
      mul_one, MeasureTheory.measureReal_def]
    exact ENNReal.toReal_mono hSfin (MeasureTheory.measure_mono Set.inter_subset_right)
  have E4' := mul_le_mul_of_nonneg_left E4 hC
  have E5 : ∫ y in T, K.indicator J y ≤ ∫ y in A ∩ K, J y := by
    rw [MeasureTheory.setIntegral_indicator hK]
    exact MeasureTheory.setIntegral_mono_set hJ
      (MeasureTheory.ae_restrict_of_forall_mem (hA.inter hK) hJ0)
      (Set.inter_subset_inter_left K hTA).eventuallyLE
  linarith

theorem collar_member_split [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (Sig E O W : Set M) (w χ : M → ℝ) (p : M) (t ε c C : ℝ) (hE : IsOpen E)
    (hfr : frontier E = Sig) (hO : IsOpen O) (hwc : ContinuousOn w O) (hW : IsOpen W)
    (hWs : W ⊆ (chartAt E3 p).source) (hct : c < t) (hC₁ : IsClosed {x | x ∈ O ∧ w x ≤ c})
    (hCt : IsClosed {x | x ∈ O ∧ w x ≤ t + ε}) (hχ : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ χ)
    (hχ01 : ∀ x, 0 ≤ χ x ∧ χ x ≤ 1)
    (hχ1 : ∀ x ∈ O, w x ≤ t → χ x = 1 ∧ mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) χ x = 0)
    (hχ0 : ∀ x, χ x ≠ 0 → x ∈ O ∧ w x < t + ε) (Y : E3 → E3)
    (hY : (∀ y, y ∉ chartAt E3 p '' (Sig ∩ (chartAt E3 p).source) → ContDiffAt ℝ ∞ Y y) ∧
      HasCompactSupport Y ∧ tsupport Y ⊆ chartAt E3 p '' W ∧
      (∀ y, ∑ i : Fin 3, ∑ j : Fin 3, g.coeff (chartAt E3 p).symm y i j * Y y i * Y y j ≤ 1))
    (hYC : ∀ y, |sepDensDiv (g.coeff (chartAt E3 p).symm) Y y| ≤ C) :
    ((∀ y, y ∉ chartAt E3 p '' (Sig ∩ (chartAt E3 p).source) →
        ContDiffAt ℝ ∞ (fun z => (1 - χ ((chartAt E3 p).symm z)) • Y z) y) ∧
      HasCompactSupport (fun z => (1 - χ ((chartAt E3 p).symm z)) • Y z) ∧
      tsupport (fun z => (1 - χ ((chartAt E3 p).symm z)) • Y z) ⊆
        chartAt E3 p '' (W \ {x | x ∈ O ∧ w x ≤ c}) ∧
      (∀ y, ∑ i : Fin 3, ∑ j : Fin 3, g.coeff (chartAt E3 p).symm y i j *
        ((1 - χ ((chartAt E3 p).symm y)) • Y y) i *
        ((1 - χ ((chartAt E3 p).symm y)) • Y y) j ≤ 1) ∧
      ∃ C' : ℝ, ∀ y, |sepDensDiv (g.coeff (chartAt E3 p).symm)
        (fun z => (1 - χ ((chartAt E3 p).symm z)) • Y z) y| ≤ C') ∧
    ∫ y in chartAt E3 p '' ((E \ {x | x ∈ O ∧ w x ≤ t}) ∩ (chartAt E3 p).source),
        sepDensDiv (g.coeff (chartAt E3 p).symm) Y y ≤
      (∫ y in chartAt E3 p '' (E ∩ (chartAt E3 p).source),
        sepDensDiv (g.coeff (chartAt E3 p).symm)
          (fun z => (1 - χ ((chartAt E3 p).symm z)) • Y z) y) +
      C * (volume (chartAt E3 p '' (E ∩ {x | x ∈ O ∧ t < w x ∧ w x < t + ε} ∩
        (chartAt E3 p).source) ∩ tsupport Y)).toReal +
      ∫ y in chartAt E3 p '' (E ∩ (chartAt E3 p).source) ∩ tsupport Y,
        Real.sqrt (g.coeff (chartAt E3 p).symm y).det *
          Real.sqrt (g.gradInner χ χ ((chartAt E3 p).symm y)) :=
by
  
  have hsrc : IsOpen (chartAt E3 p).source := (chartAt E3 p).open_source
  have htgt : IsOpen (chartAt E3 p).target := (chartAt E3 p).open_target
  have hKt : tsupport Y ⊆ (chartAt E3 p).target := by
    intro y hy
    obtain ⟨x, hxW, rfl⟩ := hY.2.2.1 hy
    exact (chartAt E3 p).map_source (hWs hxW)
  have hKc : IsCompact (tsupport Y) := hY.2.1
  have hESig : ∀ x ∈ E, x ∉ Sig := by
    intro x hx hxS
    rw [← hfr, hE.frontier_eq] at hxS
    exact hxS.2 hx
  have hGs : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => g.coeff (chartAt E3 p).symm y i j)
      (chartAt E3 p).target := fun i j => g.smooth p i j
  have hGpd : ∀ y ∈ (chartAt E3 p).target, (g.coeff (chartAt E3 p).symm y).PosDef :=
    fun y hy => coeff_chart_symm_posDef g p y hy
  have hsqrt : ContDiffOn ℝ ∞ (fun z => Real.sqrt (g.coeff (chartAt E3 p).symm z).det)
      (chartAt E3 p).target :=
    ccs_sqrtdet_smooth _ _ hGs (fun y hy => (hGpd y hy).det_pos)
  obtain ⟨hχp, hgradχ, hJcont⟩ := chart_pullback_gradInner g χ hχ p
  have hsC : ContDiffOn ℝ ∞ (fun z => 1 - χ ((chartAt E3 p).symm z)) (chartAt E3 p).target :=
    contDiffOn_const.sub hχp
  have hsD : ∀ y ∈ (chartAt E3 p).target,
      DifferentiableAt ℝ (fun z => 1 - χ ((chartAt E3 p).symm z)) y :=
    fun y hy => (hsC.differentiableOn (by simp)).differentiableAt (htgt.mem_nhds hy)
  have hs0 : ∀ z, 0 ≤ 1 - χ ((chartAt E3 p).symm z) :=
    fun z => by linarith [(hχ01 ((chartAt E3 p).symm z)).2]
  have hs1 : ∀ z, 1 - χ ((chartAt E3 p).symm z) ≤ 1 :=
    fun z => by linarith [(hχ01 ((chartAt E3 p).symm z)).1]
  have hC0 : 0 ≤ C := (abs_nonneg _).trans (hYC 0)
  have hFd : ∀ y ∈ (chartAt E3 p).target, DifferentiableAt ℝ Y y → ∀ i : Fin 3,
      DifferentiableAt ℝ (fun z => Real.sqrt (g.coeff (chartAt E3 p).symm z).det * Y z i) y := by
    intro y hy hYd i
    have h1 : DifferentiableAt ℝ (fun z => Real.sqrt (g.coeff (chartAt E3 p).symm z).det) y :=
      (hsqrt.differentiableOn (by simp)).differentiableAt (htgt.mem_nhds hy)
    have h2 : DifferentiableAt ℝ (fun z => Y z i) y := by
      have h3 := (EuclideanSpace.proj (𝕜 := ℝ) (ι := Fin 3) i).differentiableAt.comp y hYd
      exact h3
    exact h1.mul h2
  have hAd : ∀ x ∈ E ∩ (chartAt E3 p).source, DifferentiableAt ℝ Y (chartAt E3 p x) := by
    rintro x ⟨hxE, hxs⟩
    refine (hY.1 _ ?_).differentiableAt (by simp)
    rintro ⟨x', ⟨hx'S, hx's⟩, hxx'⟩
    have h := (chartAt E3 p).injOn hx's hxs hxx'
    rw [h] at hx'S
    exact hESig x hxE hx'S
  obtain ⟨B, hB0, hB⟩ := chart_field_comp_bound g p Y hY.2.1 hKt hY.2.2.2
  have hStC : IsClosed {x | x ∈ O ∧ w x ≤ t} := by
    have heq : {x | x ∈ O ∧ w x ≤ t} = {x | x ∈ O ∧ w x ≤ t + ε} ∩ w ⁻¹' Set.Iic t := by
      ext x
      constructor
      · rintro ⟨hxO, hxt⟩
        have h1 := (hχ1 x hxO hxt).1
        have h2 := hχ0 x (by rw [h1]; exact one_ne_zero)
        exact ⟨⟨hxO, h2.2.le⟩, hxt⟩
      · rintro ⟨⟨hxO, -⟩, hxt⟩
        exact ⟨hxO, hxt⟩
    rw [heq]
    exact ContinuousOn.preimage_isClosed_of_isClosed (hwc.mono fun x hx => hx.1) hCt isClosed_Iic
  
  have hA1 : ∀ y, y ∉ chartAt E3 p '' (Sig ∩ (chartAt E3 p).source) →
      ContDiffAt ℝ ∞ (fun z => (1 - χ ((chartAt E3 p).symm z)) • Y z) y := by
    intro y hy
    by_cases hyt : y ∈ (chartAt E3 p).target
    · exact (hsC.contDiffAt (htgt.mem_nhds hyt)).smul (hY.1 y hy)
    · have hyK : y ∉ tsupport Y := fun h => hyt (hKt h)
      have hev : (fun z => (1 - χ ((chartAt E3 p).symm z)) • Y z) =ᶠ[𝓝 y]
          fun _ => (0 : E3) := by
        filter_upwards [(isClosed_tsupport Y).isOpen_compl.mem_nhds hyK] with z hz
        rw [image_eq_zero_of_notMem_tsupport hz, smul_zero]
      exact contDiffAt_const.congr_of_eventuallyEq hev
  
  have hA2 : HasCompactSupport (fun z => (1 - χ ((chartAt E3 p).symm z)) • Y z) :=
    hY.2.1.smul_left (f := fun z => 1 - χ ((chartAt E3 p).symm z))
  
  have hA3 : tsupport (fun z => (1 - χ ((chartAt E3 p).symm z)) • Y z) ⊆
      chartAt E3 p '' (W \ {x | x ∈ O ∧ w x ≤ c}) := by
    intro y hy
    have hyK := tsupport_smul_subset_right (fun z => 1 - χ ((chartAt E3 p).symm z)) Y hy
    obtain ⟨x, hxW, rfl⟩ := hY.2.2.1 hyK
    refine ⟨x, ⟨hxW, ?_⟩, rfl⟩
    rintro ⟨hxO, hxc⟩
    have hUo : IsOpen (chartAt E3 p '' (O ∩ w ⁻¹' Set.Iio t ∩ (chartAt E3 p).source)) :=
      (chartAt E3 p).isOpen_image_of_subset_source
        ((hwc.isOpen_inter_preimage hO isOpen_Iio).inter hsrc) Set.inter_subset_right
    have hyU : chartAt E3 p x ∈ chartAt E3 p '' (O ∩ w ⁻¹' Set.Iio t ∩ (chartAt E3 p).source) :=
      ⟨x, ⟨⟨hxO, show w x < t from lt_of_le_of_lt hxc hct⟩, hWs hxW⟩, rfl⟩
    obtain ⟨z, hzU, hzS⟩ := mem_closure_iff.1 hy _ hUo hyU
    obtain ⟨x', ⟨⟨hx'O, hx't⟩, hx's⟩, rfl⟩ := hzU
    rw [Function.mem_support] at hzS
    apply hzS
    have hχx' := (hχ1 x' hx'O (show w x' < t from hx't).le).1
    simp only [(chartAt E3 p).left_inv hx's, hχx', sub_self, zero_smul]
  
  have hA4 : ∀ y, ∑ i : Fin 3, ∑ j : Fin 3, g.coeff (chartAt E3 p).symm y i j *
      ((1 - χ ((chartAt E3 p).symm y)) • Y y) i *
      ((1 - χ ((chartAt E3 p).symm y)) • Y y) j ≤ 1 := by
    intro y
    have heq : ∑ i : Fin 3, ∑ j : Fin 3, g.coeff (chartAt E3 p).symm y i j *
        ((1 - χ ((chartAt E3 p).symm y)) • Y y) i *
        ((1 - χ ((chartAt E3 p).symm y)) • Y y) j =
        (1 - χ ((chartAt E3 p).symm y)) ^ 2 *
          ∑ i : Fin 3, ∑ j : Fin 3, g.coeff (chartAt E3 p).symm y i j * Y y i * Y y j := by
      simp only [PiLp.smul_apply, smul_eq_mul, Finset.mul_sum]
      refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
      ring
    rw [heq]
    have h0 := hs0 y
    have h1 := hs1 y
    have hsq : (1 - χ ((chartAt E3 p).symm y)) ^ 2 ≤ 1 := by nlinarith
    rcases le_or_gt 0 (∑ i : Fin 3, ∑ j : Fin 3,
        g.coeff (chartAt E3 p).symm y i j * Y y i * Y y j) with hQ0 | hQ0
    · exact (mul_le_of_le_one_left hQ0 hsq).trans (hY.2.2.2 y)
    · nlinarith [sq_nonneg (1 - χ ((chartAt E3 p).symm y))]
  
  have hσ : ContinuousOn (fun z => ∑ i : Fin 3,
      |partialDeriv i (fun z => 1 - χ ((chartAt E3 p).symm z)) z|) (chartAt E3 p).target := by
    have hfd := hsC.continuousOn_fderiv_of_isOpen htgt (by simp)
    refine continuousOn_finset_sum _ fun i _ => ?_
    simp only [partialDeriv]
    exact (hfd.clm_apply continuousOn_const).abs
  obtain ⟨b, hb⟩ := hKc.exists_bound_of_continuousOn (hσ.mono hKt)
  have hA5 : ∀ y, |sepDensDiv (g.coeff (chartAt E3 p).symm)
      (fun z => (1 - χ ((chartAt E3 p).symm z)) • Y z) y| ≤ C + max b 0 * B := by
    intro y
    by_cases hyK : y ∈ tsupport Y
    · have hdev := sepDensDiv_smul_dev_le (g.coeff (chartAt E3 p).symm)
        (fun z => 1 - χ ((chartAt E3 p).symm z)) Y y (hsD y (hKt hyK)) hs0 B hB
      beta_reduce at hdev
      have hσy : ∑ i : Fin 3, |partialDeriv i (fun z => 1 - χ ((chartAt E3 p).symm z)) y| * B ≤
          max b 0 * B := by
        rw [← Finset.sum_mul]
        refine mul_le_mul_of_nonneg_right ?_ hB0
        have h := hb y hyK
        rw [Real.norm_eq_abs, abs_of_nonneg (Finset.sum_nonneg fun i _ => abs_nonneg _)] at h
        exact h.trans (le_max_left _ _)
      have hsDy : |(1 - χ ((chartAt E3 p).symm y)) *
          sepDensDiv (g.coeff (chartAt E3 p).symm) Y y| ≤ C := by
        rw [abs_mul, abs_of_nonneg (hs0 y)]
        calc (1 - χ ((chartAt E3 p).symm y)) * |sepDensDiv (g.coeff (chartAt E3 p).symm) Y y|
            ≤ 1 * C := mul_le_mul (hs1 y) (hYC y) (abs_nonneg _) zero_le_one
          _ = C := one_mul C
      have htri := abs_sub_abs_le_abs_sub
        (sepDensDiv (g.coeff (chartAt E3 p).symm)
          (fun z => (1 - χ ((chartAt E3 p).symm z)) • Y z) y)
        ((1 - χ ((chartAt E3 p).symm y)) * sepDensDiv (g.coeff (chartAt E3 p).symm) Y y)
      linarith
    · have h0 := (sepDensDiv_support_integrable (g.coeff (chartAt E3 p).symm)
        (fun z => (1 - χ ((chartAt E3 p).symm z)) • Y z)).1 y
        (fun h => hyK (tsupport_smul_subset_right _ _ h))
      rw [h0, abs_zero]
      have : 0 ≤ max b 0 * B := mul_nonneg (le_max_right _ _) hB0
      linarith
  
  have hpt : ∀ y ∈ chartAt E3 p '' ((E \ {x | x ∈ O ∧ w x ≤ t}) ∩ (chartAt E3 p).source),
      sepDensDiv (g.coeff (chartAt E3 p).symm) Y y ≤
        sepDensDiv (g.coeff (chartAt E3 p).symm)
          (fun z => (1 - χ ((chartAt E3 p).symm z)) • Y z) y +
        C * (chartAt E3 p '' (E ∩ {x | x ∈ O ∧ t < w x ∧ w x < t + ε} ∩
          (chartAt E3 p).source) ∩ tsupport Y).indicator (fun _ => (1 : ℝ)) y +
        (tsupport Y).indicator (fun y => Real.sqrt (g.coeff (chartAt E3 p).symm y).det *
          Real.sqrt (g.gradInner χ χ ((chartAt E3 p).symm y))) y := by
    rintro y ⟨x, ⟨⟨hxE, hxSt⟩, hxs⟩, rfl⟩
    have hyt : chartAt E3 p x ∈ (chartAt E3 p).target := (chartAt E3 p).map_source hxs
    have hinv : (chartAt E3 p).symm (chartAt E3 p x) = x := (chartAt E3 p).left_inv hxs
    have hleib := sepDensDiv_smul_eq (g.coeff (chartAt E3 p).symm)
      (fun z => 1 - χ ((chartAt E3 p).symm z)) Y (chartAt E3 p x) (hsD _ hyt)
      (hFd _ hyt (hAd x ⟨hxE, hxs⟩))
    have hpd : ∀ i : Fin 3,
        partialDeriv i (fun z => 1 - χ ((chartAt E3 p).symm z)) (chartAt E3 p x) =
          -partialDeriv i (fun z => χ ((chartAt E3 p).symm z)) (chartAt E3 p x) := by
      intro i
      simp only [partialDeriv]
      rw [fderiv_const_sub, ContinuousLinearMap.neg_apply]
    simp only [hpd, hinv, neg_mul, Finset.sum_neg_distrib] at hleib
    have hrel : sepDensDiv (g.coeff (chartAt E3 p).symm) Y (chartAt E3 p x) =
        sepDensDiv (g.coeff (chartAt E3 p).symm)
          (fun z => (1 - χ ((chartAt E3 p).symm z)) • Y z) (chartAt E3 p x) +
        χ x * sepDensDiv (g.coeff (chartAt E3 p).symm) Y (chartAt E3 p x) +
        Real.sqrt (g.coeff (chartAt E3 p).symm (chartAt E3 p x)).det *
          ∑ i : Fin 3, partialDeriv i (fun z => χ ((chartAt E3 p).symm z)) (chartAt E3 p x) *
            Y (chartAt E3 p x) i := by
      rw [hleib]
      ring
    have hT1 : χ x * sepDensDiv (g.coeff (chartAt E3 p).symm) Y (chartAt E3 p x) ≤
        C * (chartAt E3 p '' (E ∩ {x | x ∈ O ∧ t < w x ∧ w x < t + ε} ∩
          (chartAt E3 p).source) ∩ tsupport Y).indicator (fun _ => (1 : ℝ)) (chartAt E3 p x) := by
      have hind0 : 0 ≤ C * (chartAt E3 p '' (E ∩ {x | x ∈ O ∧ t < w x ∧ w x < t + ε} ∩
          (chartAt E3 p).source) ∩ tsupport Y).indicator (fun _ => (1 : ℝ)) (chartAt E3 p x) :=
        mul_nonneg hC0 (Set.indicator_nonneg (fun _ _ => zero_le_one) _)
      by_cases hχx : χ x = 0
      · rw [hχx, zero_mul]
        exact hind0
      · obtain ⟨hxO, hxlt⟩ := hχ0 x hχx
        have htw : t < w x := by
          by_contra h
          push_neg at h
          exact hxSt ⟨hxO, h⟩
        by_cases hyK : chartAt E3 p x ∈ tsupport Y
        · have hyS : chartAt E3 p x ∈ chartAt E3 p '' (E ∩ {x | x ∈ O ∧ t < w x ∧ w x < t + ε} ∩
              (chartAt E3 p).source) ∩ tsupport Y :=
            ⟨⟨x, ⟨⟨hxE, hxO, htw, hxlt⟩, hxs⟩, rfl⟩, hyK⟩
          rw [Set.indicator_of_mem hyS, mul_one]
          calc χ x * sepDensDiv (g.coeff (chartAt E3 p).symm) Y (chartAt E3 p x)
              ≤ |χ x * sepDensDiv (g.coeff (chartAt E3 p).symm) Y (chartAt E3 p x)| :=
                le_abs_self _
            _ = χ x * |sepDensDiv (g.coeff (chartAt E3 p).symm) Y (chartAt E3 p x)| := by
                rw [abs_mul, abs_of_nonneg (hχ01 x).1]
            _ ≤ 1 * C := mul_le_mul (hχ01 x).2 (hYC _) (abs_nonneg _) zero_le_one
            _ = C := one_mul C
        · rw [(sepDensDiv_support_integrable (g.coeff (chartAt E3 p).symm) Y).1 _ hyK, mul_zero]
          exact hind0
    have hT2 : Real.sqrt (g.coeff (chartAt E3 p).symm (chartAt E3 p x)).det *
        ∑ i : Fin 3, partialDeriv i (fun z => χ ((chartAt E3 p).symm z)) (chartAt E3 p x) *
          Y (chartAt E3 p x) i ≤
        (tsupport Y).indicator (fun y => Real.sqrt (g.coeff (chartAt E3 p).symm y).det *
          Real.sqrt (g.gradInner χ χ ((chartAt E3 p).symm y))) (chartAt E3 p x) := by
      by_cases hyK : chartAt E3 p x ∈ tsupport Y
      · rw [Set.indicator_of_mem hyK]
        beta_reduce
        refine mul_le_mul_of_nonneg_left ?_ (Real.sqrt_nonneg _)
        rw [hgradχ _ hyt]
        have hCS := smth_quad_cauchySchwarz (g.coeff (chartAt E3 p).symm (chartAt E3 p x))
          (hGpd _ hyt) (fun i => Y (chartAt E3 p x) i)
          (fun i => partialDeriv i (fun z => χ ((chartAt E3 p).symm z)) (chartAt E3 p x))
        beta_reduce at hCS
        have hRnn : 0 ≤ ∑ i : Fin 3, ∑ j : Fin 3,
            (g.coeff (chartAt E3 p).symm (chartAt E3 p x))⁻¹ i j *
              partialDeriv i (fun z => χ ((chartAt E3 p).symm z)) (chartAt E3 p x) *
              partialDeriv j (fun z => χ ((chartAt E3 p).symm z)) (chartAt E3 p x) := by
          have h := (hGpd _ hyt).inv.posSemidef.dotProduct_mulVec_nonneg
            (fun i => partialDeriv i (fun z => χ ((chartAt E3 p).symm z)) (chartAt E3 p x))
          simp only [dotProduct, Matrix.mulVec, star_trivial, Finset.mul_sum] at h
          refine h.trans_eq ?_
          refine Finset.sum_congr rfl fun i _ => Finset.sum_congr rfl fun j _ => ?_
          ring
        have hQ := hY.2.2.2 (chartAt E3 p x)
        have h1 := hCS.trans (mul_le_of_le_one_left hRnn hQ)
        have h2 := Real.abs_le_sqrt h1
        calc ∑ i : Fin 3, partialDeriv i (fun z => χ ((chartAt E3 p).symm z)) (chartAt E3 p x) *
              Y (chartAt E3 p x) i
            = ∑ i : Fin 3, Y (chartAt E3 p x) i *
                partialDeriv i (fun z => χ ((chartAt E3 p).symm z)) (chartAt E3 p x) :=
              Finset.sum_congr rfl fun i _ => mul_comm _ _
          _ ≤ _ := (le_abs_self _).trans h2
      · rw [Set.indicator_of_notMem hyK, image_eq_zero_of_notMem_tsupport hyK]
        simp
    linarith [hrel, hT1, hT2]
  
  have hzero : ∀ y ∈ chartAt E3 p '' (E ∩ (chartAt E3 p).source) \
      chartAt E3 p '' ((E \ {x | x ∈ O ∧ w x ≤ t}) ∩ (chartAt E3 p).source),
      sepDensDiv (g.coeff (chartAt E3 p).symm)
        (fun z => (1 - χ ((chartAt E3 p).symm z)) • Y z) y = 0 := by
    rintro y ⟨⟨x, ⟨hxE, hxs⟩, rfl⟩, hyT⟩
    have hxSt : x ∈ {x | x ∈ O ∧ w x ≤ t} := by
      by_contra h
      exact hyT ⟨x, ⟨⟨hxE, h⟩, hxs⟩, rfl⟩
    have hyt : chartAt E3 p x ∈ (chartAt E3 p).target := (chartAt E3 p).map_source hxs
    have hinv : (chartAt E3 p).symm (chartAt E3 p x) = x := (chartAt E3 p).left_inv hxs
    have hχx : χ x = 1 := (hχ1 x hxSt.1 hxSt.2).1
    have hmin : IsLocalMin (fun z => 1 - χ ((chartAt E3 p).symm z)) (chartAt E3 p x) := by
      refine Filter.Eventually.of_forall fun z => ?_
      simp only [hinv, hχx, sub_self]
      exact hs0 z
    have hfd0 := hmin.fderiv_eq_zero
    have hleib := sepDensDiv_smul_eq (g.coeff (chartAt E3 p).symm)
      (fun z => 1 - χ ((chartAt E3 p).symm z)) Y (chartAt E3 p x) (hsD _ hyt)
      (hFd _ hyt (hAd x ⟨hxE, hxs⟩))
    simp only [partialDeriv, hfd0, ContinuousLinearMap.zero_apply, zero_mul,
      Finset.sum_const_zero, mul_zero, add_zero, hinv, hχx, sub_self] at hleib
    exact hleib
  
  have hTo : IsOpen (chartAt E3 p '' ((E \ {x | x ∈ O ∧ w x ≤ t}) ∩ (chartAt E3 p).source)) :=
    (chartAt E3 p).isOpen_image_of_subset_source ((hE.sdiff hStC).inter hsrc)
      Set.inter_subset_right
  have hAo : IsOpen (chartAt E3 p '' (E ∩ (chartAt E3 p).source)) :=
    (chartAt E3 p).isOpen_image_of_subset_source (hE.inter hsrc) Set.inter_subset_right
  have hSlo : IsOpen (chartAt E3 p '' (E ∩ {x | x ∈ O ∧ t < w x ∧ w x < t + ε} ∩
      (chartAt E3 p).source)) :=
    (chartAt E3 p).isOpen_image_of_subset_source
      ((hE.inter (hwc.isOpen_inter_preimage hO (isOpen_Ioo (a := t) (b := t + ε)))).inter hsrc)
      Set.inter_subset_right
  have hTA : chartAt E3 p '' ((E \ {x | x ∈ O ∧ w x ≤ t}) ∩ (chartAt E3 p).source) ⊆
      chartAt E3 p '' (E ∩ (chartAt E3 p).source) :=
    Set.image_mono (Set.inter_subset_inter_left _ Set.diff_subset)
  have hSfin : volume (chartAt E3 p '' (E ∩ {x | x ∈ O ∧ t < w x ∧ w x < t + ε} ∩
      (chartAt E3 p).source) ∩ tsupport Y) ≠ ⊤ :=
    (lt_of_le_of_lt (measure_mono Set.inter_subset_right) hKc.measure_lt_top).ne
  have hD := (sepDensDiv_support_integrable (g.coeff (chartAt E3 p).symm) Y).2 hY.2.1 C hYC
  have hDt := (sepDensDiv_support_integrable (g.coeff (chartAt E3 p).symm)
    (fun z => (1 - χ ((chartAt E3 p).symm z)) • Y z)).2 hA2 _ hA5
  have hJ : IntegrableOn (fun y => Real.sqrt (g.coeff (chartAt E3 p).symm y).det *
      Real.sqrt (g.gradInner χ χ ((chartAt E3 p).symm y)))
      (chartAt E3 p '' (E ∩ (chartAt E3 p).source) ∩ tsupport Y) :=
    ((hJcont.mono hKt).integrableOn_compact hKc).mono_set Set.inter_subset_right
  
  refine ⟨⟨hA1, hA2, hA3, hA4, ⟨_, hA5⟩⟩, ?_⟩
  exact setIntegral_split_le _ _ _ (tsupport Y) _ _ _ C hTo.measurableSet hAo.measurableSet
    (hSlo.measurableSet.inter (isClosed_tsupport Y).measurableSet)
    (isClosed_tsupport Y).measurableSet hTA hSfin hC0 hD hDt hJ
    (fun y _ => mul_nonneg (Real.sqrt_nonneg _) (Real.sqrt_nonneg _)) hpt hzero

theorem collar_gain_neg [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (Sig E O Ω O'' : Set M) (w : M → ℝ) (t₀ a b c d : ℝ) (hE : IsOpen E) (hfr : frontier E = Sig)
    (hO : IsOpen O) (hcpt : IsCompact {x | x ∈ O ∧ w x ≤ t₀}) (hwc : ContinuousOn w O)
    (hw0 : ∀ x ∈ O, x ∈ Sig → w x = 0) (hwpos : ∀ x ∈ O, x ∉ Sig → 0 < w x)
    (hws : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w (O \ Sig))
    (hdw : ∀ x ∈ O \ Sig, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x ≠ 0)
    (hH : ∀ x ∈ O \ Sig, g.levelMeanCurv w x < 0)
    (hbd : ∃ C : ℝ, ∀ x ∈ O \ Sig, w x ≤ t₀ → g.gradInner w w x ≤ C ∧ |g.levelMeanCurv w x| ≤ C)
    (hne : (O ∩ Sig).Nonempty) (ha : 0 < a) (hab : a < b) (hbc : b ≤ c) (hcd : c < d)
    (hd : d ≤ t₀) {n : ℕ} (q : Fin n → M) (φ : Fin n → M → ℝ) (hφ : calPartition q φ Ω)
    (hO'' : IsOpen O'') (hsub : {x | x ∈ O ∧ w x ≤ t₀} ⊆ O'') (h1 : ∀ x ∈ O'', ∑ j, φ j x = 1) :
    calVolSum g q φ E (fun x =>
        O.indicator (fun x => 1 - Real.smoothTransition ((w x - c) / (d - c))) x *
          g.levelMeanCurv w x) ≤
      calVolSum g q φ E (fun x =>
        O.indicator (fun x => 1 - Real.smoothTransition ((w x - a) / (b - a))) x *
          g.levelMeanCurv w x) ∧
    calVolSum g q φ E (fun x =>
        O.indicator (fun x => 1 - Real.smoothTransition ((w x - a) / (b - a))) x *
          g.levelMeanCurv w x) < 0 :=
by
  classical
  
  have cut01 : ∀ α β : ℝ, ∀ x, 0 ≤ O.indicator
      (fun x => 1 - Real.smoothTransition ((w x - α) / (β - α))) x ∧
      O.indicator (fun x => 1 - Real.smoothTransition ((w x - α) / (β - α))) x ≤ 1 := by
    intro α β x
    by_cases hx : x ∈ O
    · rw [Set.indicator_of_mem hx]
      have h1 := Real.smoothTransition.nonneg ((w x - α) / (β - α))
      have h2 := Real.smoothTransition.le_one ((w x - α) / (β - α))
      constructor <;> linarith
    · rw [Set.indicator_of_notMem hx]
      exact ⟨le_refl _, zero_le_one⟩
  have cut0 : ∀ α β : ℝ, α < β → ∀ x, O.indicator
      (fun x => 1 - Real.smoothTransition ((w x - α) / (β - α))) x ≠ 0 → x ∈ O ∧ w x < β := by
    intro α β hαβ x hx
    by_cases hxO : x ∈ O
    · refine ⟨hxO, ?_⟩
      by_contra hge
      push_neg at hge
      apply hx
      rw [Set.indicator_of_mem hxO]
      have h1 : 1 ≤ (w x - α) / (β - α) := by
        rw [le_div_iff₀ (by linarith)]
        linarith
      rw [Real.smoothTransition.one_of_one_le h1]
      ring
    · exact absurd (Set.indicator_of_notMem hxO _) hx
  have cut1 : ∀ α β : ℝ, α < β → ∀ x ∈ O, w x ≤ α → O.indicator
      (fun x => 1 - Real.smoothTransition ((w x - α) / (β - α))) x = 1 := by
    intro α β hαβ x hxO hwx
    rw [Set.indicator_of_mem hxO]
    have h1 : (w x - α) / (β - α) ≤ 0 :=
      div_nonpos_of_nonpos_of_nonneg (by linarith) (by linarith)
    rw [Real.smoothTransition.zero_of_nonpos h1]
    ring
  obtain ⟨ζ, hζ⟩ : ∃ f : M → ℝ,
      f = O.indicator (fun x => 1 - Real.smoothTransition ((w x - a) / (b - a))) := ⟨_, rfl⟩
  obtain ⟨χ, hχ⟩ : ∃ f : M → ℝ,
      f = O.indicator (fun x => 1 - Real.smoothTransition ((w x - c) / (d - c))) := ⟨_, rfl⟩
  rw [← hζ, ← hχ]
  have hζ01 : ∀ x, 0 ≤ ζ x ∧ ζ x ≤ 1 := by rw [hζ]; exact cut01 a b
  have hχ01 : ∀ x, 0 ≤ χ x ∧ χ x ≤ 1 := by rw [hχ]; exact cut01 c d
  have hζ0 : ∀ x, ζ x ≠ 0 → x ∈ O ∧ w x < b := by rw [hζ]; exact cut0 a b hab
  have hζ1 : ∀ x ∈ O, w x ≤ a → ζ x = 1 := by rw [hζ]; exact cut1 a b hab
  have hχ1 : ∀ x ∈ O, w x ≤ c → χ x = 1 := by rw [hχ]; exact cut1 c d hcd
  have hζO : ∀ x, x ∉ O → ζ x = 0 := fun x hx => by rw [hζ]; exact Set.indicator_of_notMem hx _
  have hχO : ∀ x, x ∉ O → χ x = 0 := fun x hx => by rw [hχ]; exact Set.indicator_of_notMem hx _
  
  have hEsig : ∀ x ∈ E, x ∉ Sig := by
    intro x hx hxS
    rw [← hfr, hE.frontier_eq] at hxS
    exact hxS.2 hx
  
  have hpt : ∀ x ∈ E, χ x * g.levelMeanCurv w x ≤ ζ x * g.levelMeanCurv w x ∧
      ζ x * g.levelMeanCurv w x ≤ 0 := by
    intro x hxE
    by_cases hxO : x ∈ O
    · have hH' := hH x ⟨hxO, hEsig x hxE⟩
      have hle : ζ x ≤ χ x := by
        by_cases hwc' : w x ≤ c
        · rw [hχ1 x hxO hwc']
          exact (hζ01 x).2
        · have h0 : ζ x = 0 := by
            by_contra h
            have := (hζ0 x h).2
            exact hwc' (by linarith)
          rw [h0]
          exact (hχ01 x).1
      exact ⟨mul_le_mul_of_nonpos_right hle hH'.le,
        mul_nonpos_of_nonneg_of_nonpos (hζ01 x).1 hH'.le⟩
    · rw [hζO x hxO, hχO x hxO]
      simp
  
  obtain ⟨Fζ, hFζ⟩ : ∃ F : Fin n → E3 → ℝ, F = fun j y =>
      φ j ((chartAt E3 (q j)).symm y) * (ζ ((chartAt E3 (q j)).symm y) *
        g.levelMeanCurv w ((chartAt E3 (q j)).symm y)) *
        Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det := ⟨_, rfl⟩
  obtain ⟨Fχ, hFχ⟩ : ∃ F : Fin n → E3 → ℝ, F = fun j y =>
      φ j ((chartAt E3 (q j)).symm y) * (χ ((chartAt E3 (q j)).symm y) *
        g.levelMeanCurv w ((chartAt E3 (q j)).symm y)) *
        Real.sqrt (g.coeff (chartAt E3 (q j)).symm y).det := ⟨_, rfl⟩
  have hcalζ : calVolSum g q φ E (fun x => ζ x * g.levelMeanCurv w x) =
      ∑ j, ∫ y in chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source), Fζ j y := by
    rw [hFζ]; rfl
  have hcalχ : calVolSum g q φ E (fun x => χ x * g.levelMeanCurv w x) =
      ∑ j, ∫ y in chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source), Fχ j y := by
    rw [hFχ]; rfl
  rw [hcalζ, hcalχ]
  have hSm : ∀ j, MeasurableSet (chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source)) :=
    fun j => ((chartAt E3 (q j)).isOpen_image_of_subset_source
      (hE.inter (chartAt E3 (q j)).open_source) Set.inter_subset_right).measurableSet
  have hψs : ∀ j, tsupport (φ j) ⊆ (chartAt E3 (q j)).source :=
    fun j => (hφ.2.2.2 j).2.trans Set.inter_subset_right
  have hintζ : ∀ j, MeasureTheory.IntegrableOn (Fζ j)
      (chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source)) := by
    intro j
    have h := collar_curv_integrableOn g Sig E O w t₀ a b hE hfr hO hcpt hwc hw0 hws hdw hbd ha
      hab (by linarith) (φ j) (hφ.1 j) (q j) (hφ.2.2.2 j).1 (hψs j)
    rw [← hζ] at h
    rw [hFζ]
    exact h
  have hintχ : ∀ j, MeasureTheory.IntegrableOn (Fχ j)
      (chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source)) := by
    intro j
    have h := collar_curv_integrableOn g Sig E O w t₀ c d hE hfr hO hcpt hwc hw0 hws hdw hbd
      (by linarith) hcd hd (φ j) (hφ.1 j) (q j) (hφ.2.2.2 j).1 (hψs j)
    rw [← hχ] at h
    rw [hFχ]
    exact h
  
  have hFpt : ∀ j, ∀ y ∈ chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source),
      Fχ j y ≤ Fζ j y ∧ Fζ j y ≤ 0 := by
    intro j
    rintro _ ⟨x, ⟨hxE, hxs⟩, rfl⟩
    rw [hFζ, hFχ]
    simp only [(chartAt E3 (q j)).left_inv hxs]
    have h0 := hφ.2.1 j x
    have h2 := Real.sqrt_nonneg (g.coeff (chartAt E3 (q j)).symm (chartAt E3 (q j) x)).det
    obtain ⟨hA, hB⟩ := hpt x hxE
    exact ⟨mul_le_mul_of_nonneg_right (mul_le_mul_of_nonneg_left hA h0) h2,
      mul_nonpos_of_nonpos_of_nonneg (mul_nonpos_of_nonneg_of_nonpos h0 hB) h2⟩
  refine ⟨?_, ?_⟩
  · refine Finset.sum_le_sum fun j _ => ?_
    exact MeasureTheory.setIntegral_mono_on (hintχ j) (hintζ j) (hSm j)
      (fun y hy => (hFpt j y hy).1)
  · 
    obtain ⟨p₀, hp₀O, hp₀S⟩ := hne
    have hNa : IsOpen (O ∩ w ⁻¹' Set.Iio a) := hwc.isOpen_inter_preimage hO isOpen_Iio
    have hp₀cl : p₀ ∈ closure E := by
      rw [← hfr] at hp₀S
      exact frontier_subset_closure hp₀S
    have hp₀N : p₀ ∈ O ∩ w ⁻¹' Set.Iio a := by
      refine ⟨hp₀O, ?_⟩
      show w p₀ < a
      rw [hw0 p₀ hp₀O hp₀S]
      exact ha
    obtain ⟨x₁, ⟨hx₁O, hx₁a⟩, hx₁E⟩ := mem_closure_iff.1 hp₀cl _ hNa hp₀N
    have hx₁a' : w x₁ < a := hx₁a
    have hx₁O'' : x₁ ∈ O'' := hsub ⟨hx₁O, by linarith⟩
    obtain ⟨j, -, hj⟩ := Finset.exists_ne_zero_of_sum_ne_zero
      (by rw [h1 x₁ hx₁O'']; exact one_ne_zero : ∑ j, φ j x₁ ≠ 0)
    have hjpos : 0 < φ j x₁ := lt_of_le_of_ne (hφ.2.1 j x₁) (Ne.symm hj)
    have hx₁s : x₁ ∈ (chartAt E3 (q j)).source := hψs j (subset_tsupport _ hj)
    
    set N : Set E3 := chartAt E3 (q j) ''
      (E ∩ (O ∩ w ⁻¹' Set.Iio a) ∩ {x | 0 < φ j x} ∩ (chartAt E3 (q j)).source) with hNdef
    have hNo : IsOpen N :=
      (chartAt E3 (q j)).isOpen_image_of_subset_source
        (((hE.inter hNa).inter (isOpen_lt continuous_const (hφ.1 j).continuous)).inter
          (chartAt E3 (q j)).open_source) Set.inter_subset_right
    have hNne : N.Nonempty :=
      ⟨chartAt E3 (q j) x₁, x₁, ⟨⟨⟨hx₁E, hx₁O, hx₁a⟩, hjpos⟩, hx₁s⟩, rfl⟩
    have hNS : N ⊆ chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source) := by
      rintro _ ⟨x, ⟨⟨⟨hxE, -⟩, -⟩, hxs⟩, rfl⟩
      exact ⟨x, ⟨hxE, hxs⟩, rfl⟩
    have hlt : ∀ y ∈ N, Fζ j y < 0 := by
      rintro _ ⟨x, ⟨⟨⟨hxE, hxO, hxa⟩, hxφ⟩, hxs⟩, rfl⟩
      rw [hFζ]
      simp only [(chartAt E3 (q j)).left_inv hxs]
      have hxa' : w x < a := hxa
      have hxφ' : 0 < φ j x := hxφ
      have hHx := hH x ⟨hxO, hEsig x hxE⟩
      have hζx := hζ1 x hxO hxa'.le
      have hdet : 0 < Real.sqrt (g.coeff (chartAt E3 (q j)).symm (chartAt E3 (q j) x)).det :=
        Real.sqrt_pos.2 (coeff_chart_symm_posDef g (q j) _
          ((chartAt E3 (q j)).map_source hxs)).det_pos
      rw [hζx, one_mul]
      exact mul_neg_of_neg_of_pos (mul_neg_of_pos_of_neg hxφ' hHx) hdet
    have hneg_j : ∫ y in chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source), Fζ j y < 0 := by
      have hnn : 0 ≤ᵐ[MeasureTheory.volume.restrict
          (chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source))] fun y => -Fζ j y :=
        (MeasureTheory.ae_restrict_iff' (hSm j)).2
          (MeasureTheory.ae_of_all _ fun y hy => neg_nonneg.2 (hFpt j y hy).2)
      have hpos := (MeasureTheory.setIntegral_pos_iff_support_of_nonneg_ae hnn
        (hintζ j).neg).2 ?_
      · rw [MeasureTheory.integral_neg] at hpos
        linarith
      · refine lt_of_lt_of_le (hNo.measure_pos MeasureTheory.volume hNne)
          (MeasureTheory.measure_mono ?_)
        intro y hy
        exact ⟨show -Fζ j y ≠ 0 from ne_of_gt (neg_pos.2 (hlt y hy)), hNS hy⟩
    have hle : ∀ i ∈ Finset.univ,
        ∫ y in chartAt E3 (q i) '' (E ∩ (chartAt E3 (q i)).source), Fζ i y ≤ (fun _ => (0 : ℝ)) i :=
      fun i _ => MeasureTheory.setIntegral_nonpos (hSm i) (fun y hy => (hFpt i y hy).2)
    calc ∑ i, ∫ y in chartAt E3 (q i) '' (E ∩ (chartAt E3 (q i)).source), Fζ i y
        < ∑ i : Fin n, (fun _ => (0 : ℝ)) i :=
          Finset.sum_lt_sum hle ⟨j, Finset.mem_univ _, hneg_j⟩
      _ = 0 := Finset.sum_const_zero

theorem collar_removal_decreases_hull [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (Sig E Ω O : Set M) (w : M → ℝ) (t₀ : ℝ) (hE : IsOpen E)
    (hfr : frontier E = Sig) (hΩ : IsOpen Ω) (hO : IsOpen O) (hOΩ : O ⊆ Ω)
    (hfin : hullRiemPer g E Ω Sig < ⊤) (ht₀ : 0 < t₀)
    (hcpt : IsCompact {x | x ∈ O ∧ w x ≤ t₀}) (hwc : ContinuousOn w O)
    (hw0 : ∀ x ∈ O, x ∈ Sig → w x = 0) (hwpos : ∀ x ∈ O, x ∉ Sig → 0 < w x)
    (hws : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ w (O \ Sig))
    (hdw : ∀ x ∈ O \ Sig, mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) w x ≠ 0)
    (hH : ∀ x ∈ O \ Sig, g.levelMeanCurv w x < 0)
    (hbd : ∃ C : ℝ, ∀ x ∈ O \ Sig, w x ≤ t₀ → g.gradInner w w x ≤ C ∧ |g.levelMeanCurv w x| ≤ C)
    (hne : (O ∩ Sig).Nonempty) :
    ∃ t : ℝ, 0 < t ∧ t ≤ t₀ ∧
      hullRiemPer g (E \ {x | x ∈ O ∧ w x ≤ t}) Ω Sig < hullRiemPer g E Ω Sig :=
by
  
  obtain ⟨t, ht_eq⟩ : ∃ t : ℝ, t = t₀ / 2 := ⟨_, rfl⟩
  have ht : 0 < t := by rw [ht_eq]; linarith
  have htt₀ : t ≤ t₀ := by rw [ht_eq]; linarith
  have hSigc : IsClosed Sig := hfr ▸ isClosed_frontier
  have hESig : Disjoint E Sig := by
    rw [← hfr, hE.frontier_eq]; exact Set.disjoint_sdiff_right
  have hSigi : interior Sig = ∅ := by
    rw [← hfr, ← frontier_compl]; exact interior_frontier hE.isClosed_compl
  have hEm : sepChartMeas E := by
    intro q'
    exact ((chartAt E3 q').isOpen_image_of_subset_source (hE.inter (chartAt E3 q').open_source)
      Set.inter_subset_right).measurableSet
  
  have hP0 : calPartition (fun j : Fin 0 => (j.elim0 : M))
      (fun j : Fin 0 => (j.elim0 : M → ℝ)) O :=
    ⟨fun j => j.elim0, fun j => j.elim0, fun x => by simp, fun j => j.elim0⟩
  obtain ⟨n, q, φ, O', hφ, hO'o, hKO'', hφ1, -⟩ :=
    calPartition_extend g O hO (fun j : Fin 0 => (j.elim0 : M))
      (fun j : Fin 0 => (j.elim0 : M → ℝ)) hP0 ∅ isOpen_empty (fun x hx => hx.elim)
      {x | x ∈ O ∧ w x ≤ t₀} hcpt (fun x hx => hx.1)
  have hKO' : {x | x ∈ O ∧ w x ≤ t₀} ⊆ O' := fun x hx => hKO'' (Or.inl hx)
  
  obtain ⟨β, hβdef⟩ : ∃ β : M → ℝ, β = O.indicator
      (fun x => 1 - Real.smoothTransition ((w x - t / 4) / (t / 2 - t / 4))) := ⟨_, rfl⟩
  obtain ⟨hβs, hβ01, hβ1, hβ0, -, hcl, -⟩ := collar_cutoff_props Sig O w t₀ (t / 4) (t / 2)
    hSigc hO hcpt hwc hw0 hws (by linarith) (by linarith) (by linarith)
  rw [← hβdef] at hβs hβ01 hβ1 hβ0
  
  have hUo : IsOpen {x | x ∈ O ∧ w x < 3 * t / 4} :=
    hwc.isOpen_inter_preimage hO (isOpen_Iio (a := 3 * t / 4))
  have hC₁c : IsClosed {x | x ∈ O ∧ w x ≤ 3 * t / 4} := (hcl (3 * t / 4) (by linarith)).1
  have hUC₁ : {x | x ∈ O ∧ w x < 3 * t / 4} ⊆ {x | x ∈ O ∧ w x ≤ 3 * t / 4} :=
    fun x hx => ⟨hx.1, hx.2.le⟩
  
  have hLR := hullRiemPer_disjoint_sum_le g E Ω Sig
    ![Ω \ {x | x ∈ O ∧ w x ≤ 3 * t / 4}, {x | x ∈ O ∧ w x < 3 * t / 4}]
    (fun j => by
      fin_cases j
      · exact Set.diff_subset
      · intro x hx
        exact hOΩ (show x ∈ {x | x ∈ O ∧ w x < 3 * t / 4} from hx).1)
    (by
      have hd : Disjoint (Ω \ {x | x ∈ O ∧ w x ≤ 3 * t / 4}) {x | x ∈ O ∧ w x < 3 * t / 4} :=
        Set.disjoint_left.2 fun x hx hx' => hx.2 (hUC₁ hx')
      intro a b hab
      fin_cases a <;> fin_cases b
      · exact absurd rfl hab
      · exact hd
      · exact hd.symm
      · exact absurd rfl hab)
  rw [Fin.sum_univ_two] at hLR
  simp only [Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons] at hLR
  have hP₁fin : hullRiemPer g E (Ω \ {x | x ∈ O ∧ w x ≤ 3 * t / 4}) Sig ≠ ⊤ :=
    (lt_of_le_of_lt (le_trans le_self_add hLR) hfin).ne
  have hPUfin : hullRiemPer g E {x | x ∈ O ∧ w x < 3 * t / 4} Sig ≠ ⊤ :=
    (lt_of_le_of_lt (le_trans le_add_self hLR) hfin).ne
  obtain ⟨P, hPeq, hPnn⟩ : ∃ P : ℝ, hullRiemPer g E Ω Sig = ENNReal.ofReal P ∧ 0 ≤ P :=
    ⟨_, (ENNReal.ofReal_toReal hfin.ne).symm, ENNReal.toReal_nonneg⟩
  obtain ⟨P₁, hP₁eq, hP₁nn⟩ : ∃ P₁ : ℝ,
      hullRiemPer g E (Ω \ {x | x ∈ O ∧ w x ≤ 3 * t / 4}) Sig = ENNReal.ofReal P₁ ∧ 0 ≤ P₁ :=
    ⟨_, (ENNReal.ofReal_toReal hP₁fin).symm, ENNReal.toReal_nonneg⟩
  obtain ⟨PU, hPUeq, hPUnn⟩ : ∃ PU : ℝ,
      hullRiemPer g E {x | x ∈ O ∧ w x < 3 * t / 4} Sig = ENNReal.ofReal PU ∧ 0 ≤ PU :=
    ⟨_, (ENNReal.ofReal_toReal hPUfin).symm, ENNReal.toReal_nonneg⟩
  have hsumR : P₁ + PU ≤ P := by
    rw [hP₁eq, hPUeq, hPeq, ← ENNReal.ofReal_add hP₁nn hPUnn] at hLR
    exact (ENNReal.ofReal_le_ofReal_iff hPnn).1 hLR
  
  obtain ⟨V, hVs, hVd, hV1, hVsupp, hVform⟩ := collar_jump_field g Sig E O w t₀ (t / 8) (t / 4)
    hE hfr hO hcpt hwc hw0 hwpos hws hdw hbd (by linarith) (by linarith) (by linarith)
  have hβtsupp : tsupport β ⊆ {x | x ∈ O ∧ w x < 3 * t / 4} := by
    refine (closure_minimal (fun x hx => ?_) (hcl (t / 2) (by linarith)).1).trans ?_
    · obtain ⟨h1, h2⟩ := hβ0 x hx
      exact ⟨h1, h2.le⟩
    · intro x hx
      exact ⟨hx.1, by linarith [hx.2]⟩
  have hφU : calPartition q (fun j x => β x * φ j x) {x | x ∈ O ∧ w x < 3 * t / 4} := by
    refine ⟨fun j => hβs.mul (hφ.1 j), fun j x => mul_nonneg (hβ01 x).1 (hφ.2.1 j x),
      fun x => ?_, fun j => ⟨?_, ?_⟩⟩
    · rw [← Finset.mul_sum]
      exact mul_le_one₀ (hβ01 x).2 (Finset.sum_nonneg fun j _ => hφ.2.1 j x) (hφ.2.2.1 x)
    · exact (hφ.2.2.2 j).1.of_isClosed_subset (isClosed_tsupport _) tsupport_mul_subset_right
    · intro x hx
      exact ⟨hβtsupp (tsupport_mul_subset_left hx),
        ((hφ.2.2.2 j).2 (tsupport_mul_subset_right hx)).2⟩
  have hlow := hull_jump_lower_bound g E {x | x ∈ O ∧ w x < 3 * t / 4} Sig hE hSigc hSigi hESig
    hUo q (fun j x => β x * φ j x) hφU V hVs hVd hV1
  have hcalU : calDivSum g q (fun j x => β x * φ j x) E V = calDivSum g q φ E V := by
    unfold calDivSum
    refine Finset.sum_congr rfl fun j _ => ?_
    have hpc : calPiece (q j) (fun x => β x * φ j x) V = calPiece (q j) (φ j) V := by
      unfold calPiece
      congr 1
      funext y
      by_cases hV : V ((chartAt E3 (q j)).symm y) = 0
      · simp [hV]
      · have h := hVsupp _ hV
        beta_reduce
        rw [(hβ1 _ h.2.1 (by linarith [h.2.2])).1, one_mul]
    rw [hpc]
  rw [hcalU, hVform O O' q φ hφ hO'o (fun x hx => hKO' ⟨hx.1, by linarith [hx.2]⟩) hφ1,
    hPUeq] at hlow
  have hΦU := (ENNReal.ofReal_le_ofReal_iff hPUnn).1 hlow
  
  obtain ⟨VζH, hVζH⟩ : ∃ v : ℝ, calVolSum g q φ E (fun x =>
      O.indicator (fun x => 1 - Real.smoothTransition ((w x - t / 8) / (t / 4 - t / 8))) x *
        g.levelMeanCurv w x) = v := ⟨_, rfl⟩
  have hneg := (collar_gain_neg g Sig E O O O' w t₀ (t / 8) (t / 4) t (t + t / 2) hE hfr hO hcpt
    hwc hw0 hwpos hws hdw hH hbd hne (by linarith) (by linarith) (by linarith) (by linarith)
    (by linarith) q φ hφ hO'o hKO' hφ1).2
  rw [hVζH] at hneg
  have hVnn : ∀ u : M → ℝ, 0 ≤ calVolSum g q φ E (fun x => Real.sqrt (g.gradInner u u x)) := by
    intro u
    unfold calVolSum
    exact Finset.sum_nonneg fun j _ => integral_nonneg fun y =>
      mul_nonneg (mul_nonneg (hφ.2.1 j _) (Real.sqrt_nonneg _)) (Real.sqrt_nonneg _)
  have hPpos : 0 < P := by
    have := hVnn (O.indicator (fun x => 1 - Real.smoothTransition ((w x - t / 8) / (t / 4 - t / 8))))
    linarith
  
  have s10 : ∀ (m : ℕ) (pp : Fin m → M) (W : Fin m → Set M),
      (∀ k, IsOpen (W k) ∧ W k ⊆ Ω ∩ (chartAt E3 (pp k)).source) →
      Pairwise (fun k l => Disjoint (W k) (W l)) →
      ∀ Y : Fin m → E3 → E3, (∀ k,
        (∀ y, y ∉ chartAt E3 (pp k) '' (Sig ∩ (chartAt E3 (pp k)).source) →
          ContDiffAt ℝ ∞ (Y k) y) ∧ HasCompactSupport (Y k) ∧
        tsupport (Y k) ⊆ chartAt E3 (pp k) '' W k ∧
        (∀ y, ∑ i : Fin 3, ∑ j : Fin 3,
          g.coeff (chartAt E3 (pp k)).symm y i j * Y k y i * Y k y j ≤ 1) ∧
        ∃ C : ℝ, ∀ y, |sepDensDiv (g.coeff (chartAt E3 (pp k)).symm) (Y k) y| ≤ C) →
      ∑ k, ∫ y in chartAt E3 (pp k) '' ((E \ {x | x ∈ O ∧ w x ≤ t}) ∩ (chartAt E3 (pp k)).source),
          sepDensDiv (g.coeff (chartAt E3 (pp k)).symm) (Y k) y ≤ P + VζH := by
    intro m pp W hW hWd Y hY
    choose C hC using fun k => (hY k).2.2.2.2
    
    have hε : ∀ ε : ℝ, 0 < ε → ε ≤ t / 2 →
        ∑ k, ∫ y in chartAt E3 (pp k) '' ((E \ {x | x ∈ O ∧ w x ≤ t}) ∩
            (chartAt E3 (pp k)).source),
          sepDensDiv (g.coeff (chartAt E3 (pp k)).symm) (Y k) y ≤
        P + VζH + ∑ k, C k * (volume (chartAt E3 (pp k) '' (E ∩
          {x | x ∈ O ∧ t < w x ∧ w x < t + ε} ∩ (chartAt E3 (pp k)).source) ∩
            tsupport (Y k))).toReal := by
      intro ε hε0 hεt
      obtain ⟨χ, hχdef⟩ : ∃ χ : M → ℝ, χ = O.indicator
          (fun x => 1 - Real.smoothTransition ((w x - t) / (t + ε - t))) := ⟨_, rfl⟩
      obtain ⟨hχs, hχ01, hχ1, hχ0, hχd, hχcl, hKfc⟩ := collar_cutoff_props Sig O w t₀ t (t + ε)
        hSigc hO hcpt hwc hw0 hws ht (by linarith) (by linarith)
      rw [← hχdef] at hχs hχ01 hχ1 hχ0 hχd
      have hspl := fun k => collar_member_split g Sig E O (W k) w χ (pp k) t ε (3 * t / 4) (C k)
        hE hfr hO hwc (hW k).1 ((hW k).2.trans Set.inter_subset_right) (by linarith)
        (hχcl (3 * t / 4) (by linarith)).1 (hχcl (t + ε) (by linarith)).1 hχs hχ01 hχ1 hχ0
        (Y k) ⟨(hY k).1, (hY k).2.1, (hY k).2.2.1, (hY k).2.2.2.1⟩ (hC k)
      
      have hfam : (∀ k, IsOpen (W k \ {x | x ∈ O ∧ w x ≤ 3 * t / 4}) ∧
            W k \ {x | x ∈ O ∧ w x ≤ 3 * t / 4} ⊆
              (Ω \ {x | x ∈ O ∧ w x ≤ 3 * t / 4}) ∩ (chartAt E3 (pp k)).source) ∧
          Pairwise (fun k l => Disjoint (W k \ {x | x ∈ O ∧ w x ≤ 3 * t / 4})
            (W l \ {x | x ∈ O ∧ w x ≤ 3 * t / 4})) :=
        ⟨fun k => ⟨(hW k).1.sdiff hC₁c,
          fun x hx => ⟨⟨((hW k).2 hx.1).1, hx.2⟩, ((hW k).2 hx.1).2⟩⟩,
          fun k l hkl => (hWd hkl).mono Set.diff_subset Set.diff_subset⟩
      have hD : ∑ k, ENNReal.ofReal (∫ y in chartAt E3 (pp k) '' (E ∩ (chartAt E3 (pp k)).source),
            sepDensDiv (g.coeff (chartAt E3 (pp k)).symm)
              (fun z => (1 - χ ((chartAt E3 (pp k)).symm z)) • Y k z) y) ≤
          hullRiemPer g E (Ω \ {x | x ∈ O ∧ w x ≤ 3 * t / 4}) Sig := by
        refine le_trans ?_ (le_iSup_of_le m (le_iSup_of_le pp
          (le_iSup_of_le (fun k => W k \ {x | x ∈ O ∧ w x ≤ 3 * t / 4})
            (le_iSup_of_le hfam le_rfl))))
        exact Finset.sum_le_sum fun k _ => le_iSup₂_of_le _ (hspl k).1 le_rfl
      have hsub : ∀ (x : Fin m → ℝ), ENNReal.ofReal (∑ k, x k) ≤ ∑ k, ENNReal.ofReal (x k) :=
        fun x => Finset.le_sum_of_subadditive ENNReal.ofReal ENNReal.ofReal_zero.le
          (fun a b => ENNReal.ofReal_add_le) _ _
      have hDR := (ENNReal.ofReal_le_ofReal_iff hP₁nn).1 (((hsub _).trans hD).trans hP₁eq.le)
      
      have hJ := chart_volume_family_le g O O' E {y | y ∈ O ∧ t ≤ w y ∧ w y ≤ t + ε} hEm q φ hφ
        hO'o hφ1 χ hχs hKfc (fun x hx => hKO' ⟨hx.1, by linarith [hx.2.2]⟩) hχd pp W
        (fun k => tsupport (Y k)) (fun k => ⟨(hW k).1, (hW k).2.trans Set.inter_subset_right⟩)
        hWd (fun k => ⟨(hY k).2.1, (hY k).2.2.1⟩)
      beta_reduce at hJ
      
      have hflux := collar_flux_conservation g Sig E O O O' w t₀ (t / 8) (t / 4) t (t + ε) hE hfr
        hO hcpt hwc hw0 hwpos hws hdw hbd (by linarith) (by linarith) (by linarith) ht
        (by linarith) (by linarith) q φ hφ hO'o hKO' hφ1
      have hgain := (collar_gain_neg g Sig E O O O' w t₀ (t / 8) (t / 4) t (t + ε) hE hfr hO hcpt
        hwc hw0 hwpos hws hdw hH hbd hne (by linarith) (by linarith) (by linarith) (by linarith)
        (by linarith) q φ hφ hO'o hKO' hφ1).1
      rw [← hχdef] at hflux hgain
      have hsum := Finset.sum_le_sum fun k (_ : k ∈ Finset.univ) => (hspl k).2
      rw [Finset.sum_add_distrib, Finset.sum_add_distrib] at hsum
      linarith
    
    have hlim : ∀ k, Tendsto (fun N : ℕ => (volume (chartAt E3 (pp k) '' (E ∩
        {x | x ∈ O ∧ t < w x ∧ w x < t + t / 2 / ((N : ℝ) + 1)} ∩ (chartAt E3 (pp k)).source) ∩
          tsupport (Y k))).toReal) atTop (𝓝 0) := by
      intro k
      obtain ⟨S, hSdef⟩ : ∃ S : ℕ → Set E3, S = fun N : ℕ => chartAt E3 (pp k) '' (E ∩
          {x | x ∈ O ∧ t < w x ∧ w x < t + t / 2 / ((N : ℝ) + 1)} ∩
            (chartAt E3 (pp k)).source) ∩ tsupport (Y k) := ⟨_, rfl⟩
      have hmeas : ∀ N : ℕ, NullMeasurableSet (S N) volume := by
        intro N
        simp only [hSdef]
        refine MeasurableSet.nullMeasurableSet ?_
        refine (IsOpen.measurableSet ?_).inter (isClosed_tsupport _).measurableSet
        refine (chartAt E3 (pp k)).isOpen_image_of_subset_source ?_ Set.inter_subset_right
        exact (hE.inter (hwc.isOpen_inter_preimage hO
          (isOpen_Ioo (a := t) (b := t + t / 2 / ((N : ℝ) + 1))))).inter
          (chartAt E3 (pp k)).open_source
      have hanti : Antitone S := by
        intro N N' hNN'
        simp only [hSdef]
        refine Set.inter_subset_inter_left _ (Set.image_mono ?_)
        rintro x ⟨⟨hxE, hxO, h1, h2⟩, hxs⟩
        refine ⟨⟨hxE, hxO, h1, lt_of_lt_of_le h2 ?_⟩, hxs⟩
        have hc : (N : ℝ) + 1 ≤ (N' : ℝ) + 1 := by
          have := (Nat.cast_le (α := ℝ)).2 hNN'
          linarith
        have : t / 2 / ((N' : ℝ) + 1) ≤ t / 2 / ((N : ℝ) + 1) :=
          div_le_div_of_nonneg_left (by linarith) (by positivity) hc
        linarith
      have hfin' : ∃ N, volume (S N) ≠ ⊤ := ⟨0, by
        simp only [hSdef]
        exact (lt_of_le_of_lt (measure_mono Set.inter_subset_right)
          (hY k).2.1.measure_lt_top).ne⟩
      have hempty : volume (⋂ N, S N) = 0 := by
