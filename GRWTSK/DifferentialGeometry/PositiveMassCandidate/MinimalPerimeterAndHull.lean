    intro x₀ hx₀ p1 p2 a b d c σ₀ hσ₀ had hq hqx
    have hx₀n : ‖x₀‖ < 1 / 4 := by simpa using hx₀
    obtain ⟨s, hs⟩ : ∃ v : ℝ, v = -(a + d) / 4 := ⟨_, rfl⟩
    have hspos : 0 < s := by rw [hs]; linarith
    obtain ⟨p1', hp1'⟩ : ∃ v : ℝ, v = p1 - 2 * s * x₀.re := ⟨_, rfl⟩
    obtain ⟨p2', hp2'⟩ : ∃ v : ℝ, v = p2 - 2 * s * x₀.im := ⟨_, rfl⟩
    obtain ⟨a', ha'⟩ : ∃ v : ℝ, v = a + s := ⟨_, rfl⟩
    obtain ⟨d', hd'⟩ : ∃ v : ℝ, v = d + s := ⟨_, rfl⟩
    obtain ⟨c', hc'⟩ : ∃ v : ℝ, v = c + s * (x₀.re ^ 2 + x₀.im ^ 2) := ⟨_, rfl⟩
    have hid : ∀ ζ : ℂ, p1' * ζ.re + p2' * ζ.im + a' * ζ.re ^ 2 + 2 * b * ζ.re * ζ.im +
        d' * ζ.im ^ 2 + c' =
        p1 * ζ.re + p2 * ζ.im + a * ζ.re ^ 2 + 2 * b * ζ.re * ζ.im + d * ζ.im ^ 2 + c +
          s * ‖ζ - x₀‖ ^ 2 := by
      intro ζ
      rw [hcnorm (ζ - x₀), Complex.sub_re, Complex.sub_im, hp1', hp2', ha', hd', hc']
      ring
    have hq'x : p1' * x₀.re + p2' * x₀.im + a' * x₀.re ^ 2 + 2 * b * x₀.re * x₀.im +
        d' * x₀.im ^ 2 + c' = u x₀ := by
      have := hid x₀
      rw [sub_self, norm_zero] at this
      linarith
    have hcont : Continuous (fun ζ : ℂ => p1' * ζ.re + p2' * ζ.im + a' * ζ.re ^ 2 +
        2 * b * ζ.re * ζ.im + d' * ζ.im ^ 2 + c') := by fun_prop
    obtain ⟨δ, hδ, hδq⟩ := Metric.continuous_iff.mp hcont x₀ 1 one_pos
    obtain ⟨σ, hσ⟩ : ∃ v : ℝ, v = min (σ₀ / 2) (min (δ / 2) (1 / 100)) := ⟨_, rfl⟩
    have hσpos : 0 < σ := by
      rw [hσ]; exact lt_min (by linarith) (lt_min (by linarith) (by norm_num))
    have hσ1 : σ ≤ σ₀ / 2 := by rw [hσ]; exact min_le_left _ _
    have hσ2 : σ ≤ δ / 2 := by rw [hσ]; exact (min_le_right _ _).trans (min_le_left _ _)
    have hσ3 : σ ≤ 1 / 100 := by rw [hσ]; exact (min_le_right _ _).trans (min_le_right _ _)
    have hsσ : 0 < s * σ ^ 2 := mul_pos hspos (pow_pos hσpos 2)
    obtain ⟨γ, hγ⟩ : ∃ v : ℝ, v = min (s * σ ^ 2 / 4) (1 / 4) := ⟨_, rfl⟩
    have hγpos : 0 < γ := by rw [hγ]; exact lt_min (by linarith) (by norm_num)
    have hγ1 : γ < s * σ ^ 2 / 2 := by
      rw [hγ]; exact (min_le_left _ _).trans_lt (by linarith)
    have hγ2 : γ < 1 / 2 := by rw [hγ]; exact (min_le_right _ _).trans_lt (by norm_num)
    have hbd : ∀ ζ ∈ Metric.closedBall x₀ σ, |p1' * ζ.re + p2' * ζ.im + a' * ζ.re ^ 2 +
        2 * b * ζ.re * ζ.im + d' * ζ.im ^ 2 + c'| ≤ 2 := by
      intro ζ hζ
      have hd : dist ζ x₀ < δ := by
        rw [Metric.mem_closedBall] at hζ; linarith
      have h1 := hδq ζ hd
      simp only [Real.dist_eq] at h1
      rw [hq'x] at h1
      have h2 := hu1 x₀
      have h3 := abs_sub_abs_le_abs_sub (p1' * ζ.re + p2' * ζ.im + a' * ζ.re ^ 2 +
        2 * b * ζ.re * ζ.im + d' * ζ.im ^ 2 + c') (u x₀)
      linarith
    have hneg : a' + d' < 0 := by rw [ha', hd', hs]; linarith
    have hμ : 0 < -(a' + d') := by linarith
    have hA : 0 < |p1'| + |p2'| + |a'| + 2 * |b| + |d'| + 1 := by positivity
    obtain ⟨K, hK⟩ := hGC γ hγpos
    obtain ⟨N, hN⟩ := hsmall _ (hTpos _ _ hA hμ)
    have hk1 := hK (max K N) (le_max_left _ _)
    have hk2 := hN (max K N) (le_max_right _ _)
    refine (flatSlab_sliding_touch T (F (φ (max K N))) (ν (φ (max K N))) (e1 (φ (max K N)))
      (e2 (φ (max K N))) (τ (φ (max K N))) (η (φ (max K N))) γ u x₀ p1' p2' a' b d' c' σ s
      (hν _) (he1 _) (he2 _) (he12 _) (he1ν _) (he2ν _) (hcomp _) (hτ _) (hτ100 _) (hslab _)
      (hs1 _) (hs2 _) (hTouch _) (hfib _) hk1 hγpos.le hγ2 hx₀n hσpos hσ3 hspos hγ1 hbd
      hq'x).2 hneg hk2.1 hk2.2 ?_
    intro ζ hζ
    rw [hid ζ]
    have hζ' : ζ ∈ Metric.ball x₀ σ₀ := by
