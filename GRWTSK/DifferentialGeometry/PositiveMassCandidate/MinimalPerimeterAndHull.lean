  have hKcpt : IsCompact K := by
    refine (isCompact_closedBall (0 : E3) 1).of_isClosed_subset hKcl ?_
    intro z hz
    obtain ⟨-, h2, h3⟩ := (hKm z).1 hz
    have := mem_ball_zero_iff.mp (hball2 z h2 h3)
    rw [mem_closedBall_zero_iff]; linarith
  have hGCK : ∀ z ∈ K, |inner ℝ ν z / τ - u ⟨inner ℝ e1 z, inner ℝ e2 z⟩| ≤ γ := by
    intro z hz
    obtain ⟨h1, h2, h3⟩ := (hKm z).1 hz
    exact hGC z (ball_subset_ball (by norm_num) (hball2 z h2 h3)) h1 (hcyl _ _ h2).1
  
  obtain ⟨t₀, ht₀, hz₁F⟩ := hfib x₀ (by linarith)
  obtain ⟨z₁, hz₁⟩ : ∃ z₁ : E3, z₁ = x₀.re • e1 + x₀.im • e2 + (τ * t₀) • ν := ⟨_, rfl⟩
  rw [← hz₁] at hz₁F
  obtain ⟨hX₁, hY₁, hH₁⟩ := hcoord x₀.re x₀.im (τ * t₀)
  rw [← hz₁] at hX₁ hY₁ hH₁
  have hZ₁ : (⟨inner ℝ e1 z₁, inner ℝ e2 z₁⟩ : ℂ) = x₀ := by rw [hX₁, hY₁]
  have hz₁K : z₁ ∈ K := by
    rw [hKm, hZ₁, hH₁]
