      exact ⟨N', Filter.mem_of_superset (isOpen_interior.mem_nhds hw') interior_subset, h0⟩
    have hEo : IsOpen {w : E3 | ∃ N' ∈ 𝓝 w, volume (N' ∩ F) = 0} := by
      rw [isOpen_iff_mem_nhds]
