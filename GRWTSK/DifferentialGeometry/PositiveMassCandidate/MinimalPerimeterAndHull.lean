    rcases hΩc.subset_or_subset hFo hEo hdisj hcov with hsub | hsub
    · refine ⟨fun _ => ?_, fun hNF => ?_⟩
      · apply measure_null_of_locally_null
        intro y hy
        obtain ⟨N', hN', h0⟩ := hsub hy.1
        exact ⟨(Ω \ F) ∩ N', inter_mem_nhdsWithin _ hN',
