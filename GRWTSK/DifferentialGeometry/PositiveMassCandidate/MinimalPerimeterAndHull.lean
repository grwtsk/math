    obtain ⟨hSSv, hSSw⟩ := hvisc G F U a b ℓ υ hU hG hsymm hpd hcb hlt (hbaδ.trans hδN3)
      (fun z hz i j => ⟨((hmet z hz i j).1).trans hδN3,
        ((hmet z hz i j).2).trans (mul_le_mul_of_nonneg_right hδN3 hε.le)⟩)
      ha hb hi hii hiv1 hiv2 htouch
    have hvlsc : LowerSemicontinuousOn (fun x => (ℓ x - a) / (b - a))
        (Metric.ball (0 : E2) (1 / 2)) := by
      intro x hx y hy
      have hy' : a + y * (b - a) < ℓ x := by
        have := (lt_div_iff₀ hε).1 hy
