      push_cast
      ring
    rw [hfun]
    convert h3 using 1
    ext v
    simp only [ContinuousLinearMap.smul_apply, innerSL_apply_apply, smul_eq_mul, nsmul_eq_mul, e1]
    push_cast
    ring
  
  refine ⟨g, hgC, hgS, hgUp, fun w hw1 hw2 => ?_⟩
  have hU : IsOpen {u : E2 | ρ < ‖u‖ ∧ ‖u‖ < 1} :=
    (isOpen_lt continuous_const continuous_norm).inter (isOpen_lt continuous_norm continuous_const)
  have hwU : w ∈ {u : E2 | ρ < ‖u‖ ∧ ‖u‖ < 1} := ⟨hw1, hw2⟩
  have hgF : ∀ x : E2, ρ < ‖x‖ → ‖x‖ < 1 →
      fderiv ℝ g x = (-(1 / 2) * ‖x‖ ^ (-(5 / 2 : ℝ))) • innerSL ℝ x := by
    intro x hx1 hx2
    have hx0 : x ≠ 0 := by
      intro h
      rw [h, norm_zero] at hx1
      linarith
    have hev : g =ᶠ[𝓝 x] fun y => ‖y‖ ^ (-(1 / 2 : ℝ)) - s ^ (-(1 / 2 : ℝ)) := by
      filter_upwards [hU.mem_nhds (show x ∈ {u : E2 | ρ < ‖u‖ ∧ ‖u‖ < 1} from ⟨hx1, hx2⟩)]
        with y hy
      exact hgEq y hy.1 hy.2
    have h := ((hD (-(1 / 2)) x hx0).sub_const (s ^ (-(1 / 2 : ℝ)))).congr_of_eventuallyEq hev
    have e : (-(1 / 2 : ℝ)) - 2 = -(5 / 2) := by norm_num
    rw [h.fderiv, e]
  have hw0 : w ≠ 0 := by
    intro h
    rw [h, norm_zero] at hw1
    linarith
  have hr : 0 < ‖w‖ := norm_pos_iff.mpr hw0
  obtain ⟨L, hL⟩ : ∃ L : E2 →L[ℝ] E2 →L[ℝ] ℝ, ∀ x y : E2, L x y = @inner ℝ E2 _ x y :=
    ⟨innerSL ℝ, fun x y => rfl⟩
  have hLx : ∀ x : E2, L x = innerSL ℝ x := fun x => by
    ext y
    rw [hL, innerSL_apply_apply]
  have hLn : ‖L‖ ≤ 1 := ContinuousLinearMap.opNorm_le_bound₂ L zero_le_one (fun x y => by
    rw [hL, one_mul, Real.norm_eq_abs]
    exact abs_real_inner_le_norm x y)
  have hT : HasFDerivAt (fderiv ℝ g)
      ((-(1 / 2) * ‖w‖ ^ (-(5 / 2 : ℝ))) • L +
        ((-(1 / 2) : ℝ) • ((-(5 / 2) * ‖w‖ ^ (-(9 / 2 : ℝ))) • innerSL ℝ w)).smulRight
          (L w)) w := by
    have ha : HasFDerivAt (fun x : E2 => -(1 / 2 : ℝ) * ‖x‖ ^ (-(5 / 2 : ℝ)))
        ((-(1 / 2) : ℝ) • ((-(5 / 2) * ‖w‖ ^ (-(9 / 2 : ℝ))) • innerSL ℝ w)) w := by
      have h := hD (-(5 / 2)) w hw0
      have e : (-(5 / 2 : ℝ)) - 2 = -(9 / 2) := by norm_num
      rw [e] at h
      exact h.const_mul _
    have hi : HasFDerivAt (fun x : E2 => L x) L w := L.hasFDerivAt
    refine (ha.smul hi).congr_of_eventuallyEq ?_
    filter_upwards [hU.mem_nhds hwU] with y hy
    rw [hgF y hy.1 hy.2]
    show _ = (-(1 / 2) * ‖y‖ ^ (-(5 / 2 : ℝ))) • L y
    rw [hLx]
  
  have R1 : ‖w‖ ^ (-(5 / 2 : ℝ)) * ‖w‖ = ‖w‖ ^ (-(3 / 2 : ℝ)) := by
    rw [← Real.rpow_add_one hr.ne']
    norm_num
  have R2 : ‖w‖ ^ (-(9 / 2 : ℝ)) * ‖w‖ ^ 2 = ‖w‖ ^ (-(5 / 2 : ℝ)) := by
    rw [← Real.rpow_two, ← Real.rpow_add hr]
    norm_num
  have hA : 0 < ‖w‖ ^ (-(5 / 2 : ℝ)) := Real.rpow_pos_of_pos hr _
  have hB : 0 < ‖w‖ ^ (-(9 / 2 : ℝ)) := Real.rpow_pos_of_pos hr _
  refine ⟨hgEq w hw1 hw2, ?_, ?_, ?_⟩
  · rw [hgF w hw1 hw2, norm_smul, innerSL_apply_norm, Real.norm_eq_abs]
    have : |-(1 / 2) * ‖w‖ ^ (-(5 / 2 : ℝ))| = 1 / 2 * ‖w‖ ^ (-(5 / 2 : ℝ)) := by
      rw [abs_mul, abs_of_pos hA]
      norm_num
    rw [this, mul_assoc, R1]
  · have hTv : ∀ v : E2, fderiv ℝ (fun u => fderiv ℝ g u v) w v =
        -(1 / 2) * ‖w‖ ^ (-(5 / 2 : ℝ)) * @inner ℝ E2 _ v v +
          (5 / 4) * ‖w‖ ^ (-(9 / 2 : ℝ)) * @inner ℝ E2 _ w v ^ 2 := by
      intro v
      rw [(hT.clm_apply (hasFDerivAt_const v w)).fderiv]
      simp [hL]
      ring
    have hn : ‖w‖ ^ 2 = w 0 ^ 2 + w 1 ^ 2 := by
      rw [EuclideanSpace.norm_sq_eq, Fin.sum_univ_two, Real.norm_eq_abs, Real.norm_eq_abs,
        sq_abs, sq_abs]
    rw [Fin.sum_univ_two, hTv, hTv]
    simp [EuclideanSpace.inner_single_right]
    linear_combination (5 / 4 : ℝ) * R2 - (5 / 4 : ℝ) * ‖w‖ ^ (-(9 / 2 : ℝ)) * hn
  · rw [hT.fderiv]
    have hadd := norm_add_le ((-(1 / 2) * ‖w‖ ^ (-(5 / 2 : ℝ))) • L)
      (((-(1 / 2) : ℝ) • ((-(5 / 2) * ‖w‖ ^ (-(9 / 2 : ℝ))) • innerSL ℝ w)).smulRight (L w))
    have h1 : |-(1 / 2) * ‖w‖ ^ (-(5 / 2 : ℝ))| = 1 / 2 * ‖w‖ ^ (-(5 / 2 : ℝ)) := by
      rw [abs_mul, abs_of_pos hA]
      norm_num
    have h2 : |-(5 / 2) * ‖w‖ ^ (-(9 / 2 : ℝ))| = 5 / 2 * ‖w‖ ^ (-(9 / 2 : ℝ)) := by
      rw [abs_mul, abs_of_pos hB]
      norm_num
    have h3 : |(-(1 / 2) : ℝ)| = 1 / 2 := by norm_num
    have b1 : ‖(-(1 / 2) * ‖w‖ ^ (-(5 / 2 : ℝ))) • L‖ ≤ 1 / 2 * ‖w‖ ^ (-(5 / 2 : ℝ)) := by
      refine le_trans (ContinuousLinearMap.opNorm_smul_le
        (-(1 / 2) * ‖w‖ ^ (-(5 / 2 : ℝ)) : ℝ) L) ?_
      rw [Real.norm_eq_abs, h1]
      exact mul_le_of_le_one_right (by positivity) hLn
    have hX : ‖(-(5 / 2) * ‖w‖ ^ (-(9 / 2 : ℝ))) • innerSL ℝ w‖ ≤
        5 / 2 * ‖w‖ ^ (-(9 / 2 : ℝ)) * ‖w‖ := by
      refine le_trans (norm_smul_le (-(5 / 2) * ‖w‖ ^ (-(9 / 2 : ℝ)) : ℝ) (innerSL ℝ w)) ?_
      rw [Real.norm_eq_abs, h2, innerSL_apply_norm]
    have ha1 : ‖(-(1 / 2) : ℝ) • ((-(5 / 2) * ‖w‖ ^ (-(9 / 2 : ℝ))) • innerSL ℝ w)‖ ≤
        1 / 2 * (5 / 2 * ‖w‖ ^ (-(9 / 2 : ℝ)) * ‖w‖) := by
      refine le_trans (norm_smul_le (-(1 / 2) : ℝ)
        ((-(5 / 2) * ‖w‖ ^ (-(9 / 2 : ℝ))) • innerSL ℝ w)) ?_
      rw [Real.norm_eq_abs, h3]
      exact mul_le_mul_of_nonneg_left hX (by norm_num)
    have b2 : ‖((-(1 / 2) : ℝ) • ((-(5 / 2) * ‖w‖ ^ (-(9 / 2 : ℝ))) • innerSL ℝ w)).smulRight
        (L w)‖ ≤ 5 / 4 * ‖w‖ ^ (-(5 / 2 : ℝ)) := by
      rw [ContinuousLinearMap.norm_smulRight_apply, hLx, innerSL_apply_norm]
      calc _ ≤ 1 / 2 * (5 / 2 * ‖w‖ ^ (-(9 / 2 : ℝ)) * ‖w‖) * ‖w‖ :=
            mul_le_mul_of_nonneg_right ha1 (norm_nonneg _)
        _ = 5 / 4 * (‖w‖ ^ (-(9 / 2 : ℝ)) * ‖w‖ ^ 2) := by ring
        _ = 5 / 4 * ‖w‖ ^ (-(5 / 2 : ℝ)) := by rw [R2]
    exact le_trans hadd (le_trans (add_le_add b1 b2) (le_of_eq (by ring)))

theorem hpWH_conv_calculus : ∀ (K : Set E2) (g ψ : E2 → ℝ) (c : ℝ), IsCompact K →
    ContDiff ℝ ∞ g → HasCompactSupport g → 0 ≤ c → (∀ x, ψ x = c * ∫ y in K, g (x - y)) →
    ContDiff ℝ ∞ ψ ∧ ∀ x : E2,
      ‖fderiv ℝ ψ x‖ ≤ c * (∫ y in K, ‖fderiv ℝ g (x - y)‖) ∧
      ∑ i : Fin 2, fderiv ℝ (fun u => fderiv ℝ ψ u (e2 i)) x (e2 i) =
        c * (∫ y in K, ∑ i : Fin 2, fderiv ℝ (fun u => fderiv ℝ g u (e2 i)) (x - y) (e2 i)) ∧
      ‖fderiv ℝ (fderiv ℝ ψ) x‖ ≤ c * (∫ y in K, ‖fderiv ℝ (fderiv ℝ g) (x - y)‖) :=
by
  intro K g ψ c hK hg hgc hc hψ
  
  have hA : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (h : E2 → F),
      ContDiff ℝ 1 h → HasCompactSupport h → ∀ x : E2,
      HasFDerivAt (fun u => ∫ y in K, h (u - y)) (∫ y in K, fderiv ℝ h (x - y)) x := by
    intro F _ _ h hh hhc x
    have hcont : Continuous h := hh.continuous
    have hdcont : Continuous (fderiv ℝ h) := hh.continuous_fderiv (by norm_num)
    obtain ⟨C, hC⟩ := hdcont.bounded_above_of_compact_support (hhc.fderiv ℝ)
    have hdiff : Differentiable ℝ h := hh.differentiable (by norm_num)
    refine hasFDerivAt_integral_of_dominated_of_fderiv_le (𝕜 := ℝ) (μ := volume.restrict K)
      (F := fun u y => h (u - y)) (F' := fun u y => fderiv ℝ h (u - y)) (x₀ := x)
      (s := Set.univ) (bound := fun _ => C) Filter.univ_mem ?_ ?_ ?_ ?_ ?_ ?_
    · exact Filter.Eventually.of_forall (fun u =>
        (hcont.comp (continuous_const.sub continuous_id)).aestronglyMeasurable)
    · exact (hcont.comp (continuous_const.sub continuous_id)).continuousOn.integrableOn_compact hK
    · exact ((hdcont.comp (continuous_const.sub continuous_id)).continuousOn.integrableOn_compact
        hK).aestronglyMeasurable
    · exact ae_of_all _ (fun y u _ => hC (u - y))
    · exact continuousOn_const.integrableOn_compact hK
    · refine ae_of_all _ (fun y u _ => ?_)
      have h1 := (hdiff (u - y)).hasFDerivAt.comp u ((hasFDerivAt_id u).sub_const y)
      simpa using h1
  have hg1 : ContDiff ℝ 1 g := hg.of_le (by exact_mod_cast le_top)
  have hDg : ContDiff ℝ 1 (fderiv ℝ g) :=
    (contDiff_infty_iff_fderiv.mp hg).2.of_le (by exact_mod_cast le_top)
  have hDgc : HasCompactSupport (fderiv ℝ g) := hgc.fderiv ℝ
  have hDgcont : Continuous (fderiv ℝ g) := hg1.continuous_fderiv (by norm_num)
  
  have hsmooth : ContDiff ℝ ∞ (fun u => ∫ y in K, g (u - y)) := by
    have hloc : LocallyIntegrable (K.indicator (fun _ => (1 : ℝ))) volume :=
      ((integrable_indicator_iff hK.measurableSet).2
        (continuousOn_const.integrableOn_compact hK)).locallyIntegrable
    have hconv := HasCompactSupport.contDiff_convolution_right (n := ⊤)
      (ContinuousLinearMap.lsmul ℝ ℝ) hgc hloc hg
    have heq : (fun u => ∫ y in K, g (u - y)) =
        convolution (K.indicator (fun _ => (1 : ℝ))) g (ContinuousLinearMap.lsmul ℝ ℝ) volume := by
      funext u
      rw [convolution_def, ← integral_indicator hK.measurableSet]
      congr 1
      funext t
      by_cases ht : t ∈ K
      · simp [Set.indicator_of_mem ht]
      · simp [Set.indicator_of_notMem ht]
    rw [heq]
    exact hconv
  have hψeq : ψ = fun u => c * ∫ y in K, g (u - y) := funext hψ
  have hψd : ∀ u, HasFDerivAt ψ (c • ∫ y in K, fderiv ℝ g (u - y)) u := by
    intro u
    rw [hψeq]
    exact (hA g hg1 hgc u).const_mul c
  have hfd : fderiv ℝ ψ = fun u => c • ∫ y in K, fderiv ℝ g (u - y) :=
    funext fun u => (hψd u).fderiv
  have hHess : ∀ x, fderiv ℝ (fderiv ℝ ψ) x =
      c • ∫ y in K, fderiv ℝ (fderiv ℝ g) (x - y) := by
    intro x
    rw [hfd]
    exact ((hA (fderiv ℝ g) hDg hDgc x).const_smul c).fderiv
  have hint1 : ∀ u, Integrable (fun y => fderiv ℝ g (u - y)) (volume.restrict K) := fun u =>
    (hDgcont.comp (continuous_const.sub continuous_id)).continuousOn.integrableOn_compact hK
  
  have hpart : ∀ (i : Fin 2) (x : E2),
      fderiv ℝ (fun u => fderiv ℝ ψ u (e2 i)) x (e2 i) =
        c * ∫ y in K, fderiv ℝ (fun u => fderiv ℝ g u (e2 i)) (x - y) (e2 i) := by
    intro i x
    have hi1 : ContDiff ℝ 1 (fun w => fderiv ℝ g w (e2 i)) := hDg.clm_apply contDiff_const
    have hic : HasCompactSupport (fun w => fderiv ℝ g w (e2 i)) := hgc.fderiv_apply ℝ (e2 i)
    have hicont : Continuous (fderiv ℝ (fun w => fderiv ℝ g w (e2 i))) :=
      hi1.continuous_fderiv (by norm_num)
    have hstep1 : (fun u => fderiv ℝ ψ u (e2 i)) =
        fun u => c * ∫ y in K, fderiv ℝ g (u - y) (e2 i) := by
      funext u
      rw [hfd]
      simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
      rw [ContinuousLinearMap.integral_apply (hint1 u)]
    rw [hstep1]
    have hd := (hA (fun w => fderiv ℝ g w (e2 i)) hi1 hic x).const_mul c
    rw [hd.fderiv]
    simp only [ContinuousLinearMap.smul_apply, smul_eq_mul]
    have hint2 : Integrable (fun y => fderiv ℝ (fun w => fderiv ℝ g w (e2 i)) (x - y))
        (volume.restrict K) :=
      (hicont.comp (continuous_const.sub continuous_id)).continuousOn.integrableOn_compact hK
    rw [ContinuousLinearMap.integral_apply hint2]
  refine ⟨?_, fun x => ⟨?_, ?_, ?_⟩⟩
  · rw [hψeq]
    exact contDiff_const.mul hsmooth
  · rw [hfd]
    refine (ContinuousLinearMap.opNorm_smul_le c (∫ y in K, fderiv ℝ g (x - y))).trans ?_
    rw [Real.norm_of_nonneg hc]
    exact mul_le_mul_of_nonneg_left (norm_integral_le_integral_norm _) hc
  · simp only [hpart]
    rw [← Finset.mul_sum, integral_finset_sum]
    intro i _
    have hi1 : ContDiff ℝ 1 (fun w => fderiv ℝ g w (e2 i)) := hDg.clm_apply contDiff_const
    have hicont : Continuous (fderiv ℝ (fun w => fderiv ℝ g w (e2 i))) :=
      hi1.continuous_fderiv (by norm_num)
    exact ((hicont.comp (continuous_const.sub continuous_id)).clm_apply
      continuous_const).continuousOn.integrableOn_compact hK
  · rw [hHess x]
    refine (ContinuousLinearMap.opNorm_smul_le c
      (∫ y in K, fderiv ℝ (fderiv ℝ g) (x - y))).trans ?_
    rw [Real.norm_of_nonneg hc]
    exact mul_le_mul_of_nonneg_left (norm_integral_le_integral_norm _) hc

theorem hpWH_kernel_int_upper : ∀ (K : Set E2) (g : E2 → ℝ) (x : E2) (s : ℝ), IsCompact K →
    Continuous g → 0 < s → (∀ y ∈ K, ‖x - y‖ < 1) →
    (∀ w : E2, w ≠ 0 → ‖w‖ < 1 → g w ≤ ‖w‖ ^ (-(1 / 2 : ℝ)) - s ^ (-(1 / 2 : ℝ))) →
    ∫⁻ y in Metric.ball x 1, ENNReal.ofReal (‖x - y‖ ^ (-(1 / 2 : ℝ))) ≤
      ENNReal.ofReal (4 * Real.pi / 3) →
    (∫ y in K, g (x - y)) ≤ 4 * Real.pi / 3 :=
by
  intro K g x s hKc hg hs0 hK1 hup hball
  have hKm : MeasurableSet K := hKc.measurableSet
  have hGc : Continuous (fun y : E2 => g (x - y)) := hg.comp (continuous_const.sub continuous_id)
  have hPc : Continuous (fun y : E2 => max (g (x - y)) 0) := hGc.max continuous_const
  have hGi : MeasureTheory.IntegrableOn (fun y : E2 => g (x - y)) K :=
    hGc.continuousOn.integrableOn_compact hKc
  have hPi : MeasureTheory.IntegrableOn (fun y : E2 => max (g (x - y)) 0) K :=
    hPc.continuousOn.integrableOn_compact hKc
  have hKsub : K ⊆ Metric.ball x 1 := by
    intro y hy
    rw [Metric.mem_ball, dist_eq_norm, norm_sub_rev]
    exact hK1 y hy
  have hs : 0 < s ^ (-(1 / 2 : ℝ)) := Real.rpow_pos_of_pos hs0 _
  have h2 : (∫ y in K, g (x - y)) ≤ ∫ y in K, max (g (x - y)) 0 :=
    MeasureTheory.setIntegral_mono_on hGi hPi hKm (fun y _ => le_max_left _ _)
  have h3 : (∫ y in K, max (g (x - y)) 0) =
      (∫⁻ y in K, ENNReal.ofReal (max (g (x - y)) 0)).toReal :=
    MeasureTheory.integral_eq_lintegral_of_nonneg_ae
      (Filter.Eventually.of_forall (fun y => le_max_right _ _)) hPi.aestronglyMeasurable
  have h4 : ∀ᵐ y ∂(MeasureTheory.volume.restrict K),
      ENNReal.ofReal (max (g (x - y)) 0) ≤ ENNReal.ofReal (‖x - y‖ ^ (-(1 / 2 : ℝ))) := by
    have hne : ∀ᵐ y ∂(MeasureTheory.volume.restrict K), y ≠ x :=
      MeasureTheory.ae_restrict_of_ae (MeasureTheory.Measure.ae_ne _ x)
    have hmem : ∀ᵐ y ∂(MeasureTheory.volume.restrict K), y ∈ K :=
      MeasureTheory.ae_restrict_mem hKm
    filter_upwards [hne, hmem] with y hyx hyK
    apply ENNReal.ofReal_le_ofReal
    have hw0 : x - y ≠ 0 := sub_ne_zero.mpr (Ne.symm hyx)
    have hb := hup (x - y) hw0 (hK1 y hyK)
    have hH0 : 0 ≤ ‖x - y‖ ^ (-(1 / 2 : ℝ)) := Real.rpow_nonneg (norm_nonneg _) _
    exact max_le (by linarith) hH0
  have h5 : (∫⁻ y in K, ENNReal.ofReal (max (g (x - y)) 0)) ≤
      ∫⁻ y in K, ENNReal.ofReal (‖x - y‖ ^ (-(1 / 2 : ℝ))) :=
    MeasureTheory.lintegral_mono_ae h4
  have h6 : (∫⁻ y in K, ENNReal.ofReal (‖x - y‖ ^ (-(1 / 2 : ℝ)))) ≤
      ∫⁻ y in Metric.ball x 1, ENNReal.ofReal (‖x - y‖ ^ (-(1 / 2 : ℝ))) :=
    MeasureTheory.lintegral_mono_set hKsub
  have h7 : (∫⁻ y in K, ENNReal.ofReal (max (g (x - y)) 0)).toReal ≤ 4 * Real.pi / 3 :=
    ENNReal.toReal_le_of_le_ofReal (by positivity) (h5.trans (h6.trans hball))
  rw [h3] at h2
  exact h2.trans h7

theorem hpWH_kernel_int_deriv : ∀ (K : Set E2) (g : E2 → ℝ) (x : E2) (ρ : ℝ), IsCompact K →
    ContDiff ℝ ∞ g → 0 < ρ → (∀ y ∈ K, ρ < ‖x - y‖ ∧ ‖x - y‖ < 1) →
    (∀ w : E2, ρ < ‖w‖ → ‖w‖ < 1 →
      ‖fderiv ℝ g w‖ ≤ (1 / 2) * ‖w‖ ^ (-(3 / 2 : ℝ)) ∧
      ∑ i : Fin 2, fderiv ℝ (fun u => fderiv ℝ g u (e2 i)) w (e2 i) =
        (1 / 4) * ‖w‖ ^ (-(5 / 2 : ℝ)) ∧
      ‖fderiv ℝ (fderiv ℝ g) w‖ ≤ (7 / 4) * ‖w‖ ^ (-(5 / 2 : ℝ))) →
    ∫⁻ y in Metric.ball x 1, ENNReal.ofReal (‖x - y‖ ^ (-(3 / 2 : ℝ))) ≤
      ENNReal.ofReal (4 * Real.pi) →
    (∫ y in K, ‖fderiv ℝ g (x - y)‖) ≤ 2 * Real.pi ∧
    ∃ J : ℝ, (volume K).toReal ≤ J ∧
      (∫ y in K, ∑ i : Fin 2, fderiv ℝ (fun u => fderiv ℝ g u (e2 i)) (x - y) (e2 i)) = J / 4 ∧
      (∫ y in K, ‖fderiv ℝ (fderiv ℝ g) (x - y)‖) ≤ (7 / 4) * J :=
by
  intro K g x ρ hKc hg hρ hKx hB hball
  have hK : MeasurableSet K := hKc.measurableSet
  have hpos : ∀ y ∈ K, 0 < ‖x - y‖ := fun y hy => lt_trans hρ (hKx y hy).1
  have hint : ∀ p : ℝ, IntegrableOn (fun y => ‖x - y‖ ^ p) K := by
    intro p
    apply ContinuousOn.integrableOn_compact hKc
    exact ContinuousOn.rpow_const ((continuous_const.sub continuous_id).norm.continuousOn)
      (fun y hy => Or.inl (ne_of_gt (hpos y hy)))
  have I3 := hint (-(3 / 2 : ℝ))
  have I5 := hint (-(5 / 2 : ℝ))
  refine ⟨?_, ?_⟩
  · have hA : (∫ y in K, ‖fderiv ℝ g (x - y)‖) ≤
        ∫ y in K, (1 / 2 : ℝ) * ‖x - y‖ ^ (-(3 / 2 : ℝ)) := by
      apply integral_mono_of_nonneg
      · exact Filter.Eventually.of_forall
          (fun y => (norm_nonneg (fderiv ℝ g (x - y)) : _))
      · exact I3.const_mul (1 / 2)
      · exact ae_restrict_of_forall_mem hK
          (fun y hy => (hB (x - y) (hKx y hy).1 (hKx y hy).2).1)
    rw [integral_const_mul] at hA
    have hC : (∫ y in K, ‖x - y‖ ^ (-(3 / 2 : ℝ))) =
        (∫⁻ y in K, ENNReal.ofReal (‖x - y‖ ^ (-(3 / 2 : ℝ)))).toReal :=
      integral_eq_lintegral_of_nonneg_ae
        (Filter.Eventually.of_forall (fun y => Real.rpow_nonneg (norm_nonneg _) _))
        I3.aestronglyMeasurable
    have hsub : K ⊆ Metric.ball x 1 := by
      intro y hy
      rw [Metric.mem_ball, dist_eq_norm, norm_sub_rev]
      exact (hKx y hy).2
    have hD : (∫⁻ y in K, ENNReal.ofReal (‖x - y‖ ^ (-(3 / 2 : ℝ)))) ≤
        ENNReal.ofReal (4 * Real.pi) :=
      (lintegral_mono_set hsub).trans hball
    have hE := ENNReal.toReal_le_of_le_ofReal (by positivity) hD
    rw [← hC] at hE
    linarith
  · refine ⟨∫ y in K, ‖x - y‖ ^ (-(5 / 2 : ℝ)), ?_, ?_, ?_⟩
    · have h1 : (∫ y in K, (1 : ℝ)) ≤ ∫ y in K, ‖x - y‖ ^ (-(5 / 2 : ℝ)) := by
        apply setIntegral_mono_on (continuousOn_const.integrableOn_compact hKc) I5 hK
        intro y hy
        exact Real.one_le_rpow_of_pos_of_le_one_of_nonpos (hpos y hy) (hKx y hy).2.le
          (by norm_num)
      rw [setIntegral_const, smul_eq_mul, mul_one, measureReal_def] at h1
      exact h1
    · rw [setIntegral_congr_fun hK
        (fun y hy => (hB (x - y) (hKx y hy).1 (hKx y hy).2).2.1), integral_const_mul]
      ring
    · calc (∫ y in K, ‖fderiv ℝ (fderiv ℝ g) (x - y)‖)
          ≤ ∫ y in K, (7 / 4 : ℝ) * ‖x - y‖ ^ (-(5 / 2 : ℝ)) := by
            apply integral_mono_of_nonneg
            · exact Filter.Eventually.of_forall
                (fun y => (norm_nonneg (fderiv ℝ (fderiv ℝ g) (x - y)) : _))
            · exact I5.const_mul (7 / 4)
            · exact ae_restrict_of_forall_mem hK
                (fun y hy => (hB (x - y) (hKx y hy).1 (hKx y hy).2).2.2)
        _ = (7 / 4) * ∫ y in K, ‖x - y‖ ^ (-(5 / 2 : ℝ)) := integral_const_mul _ _

theorem hpWH_compare : ∀ (v ψ : E2 → ℝ) (Λ₀ β₀ : ℝ) (z : E2) (R : ℝ) (O : Set E2),
    LowerSemicontinuousOn v (Metric.ball (0 : E2) (1 / 2)) →
    (∀ x ∈ Metric.ball (0 : E2) (1 / 2), 0 ≤ v x) → hpSuperSol v Λ₀ β₀ →
    Metric.closedBall z R ⊆ Metric.ball (0 : E2) (1 / 2) → 0 ≤ R → ContDiff ℝ ∞ ψ →
    (∀ x, dist x z = R → ψ x ≤ 0) →
    (∀ x ∈ Metric.closedBall z R, x ∈ O → ψ x ≤ v x) →
    (∀ x ∈ Metric.ball z R, x ∉ O → ‖fderiv ℝ ψ x‖ ≤ Λ₀ ∧
      β₀ * (1 + ‖fderiv ℝ (fderiv ℝ ψ) x‖) <
        ∑ i : Fin 2, fderiv ℝ (fun y => fderiv ℝ ψ y (e2 i)) x (e2 i)) →
    ∀ x ∈ Metric.closedBall z R, ψ x ≤ v x :=
by
  intro v ψ Λ₀ β₀ z R O hlsc hv0 hss hBD hR hψ hsph hO hout
  have hcpt : IsCompact (Metric.closedBall z R) := isCompact_closedBall z R
  have hne : (Metric.closedBall z R).Nonempty := ⟨z, Metric.mem_closedBall_self hR⟩
  have hF : LowerSemicontinuousOn (fun x => v x + -ψ x) (Metric.closedBall z R) := by
    have h1 : LowerSemicontinuousOn v (Metric.closedBall z R) := hlsc.mono hBD
    have h2 : LowerSemicontinuousOn (fun x => -ψ x) (Metric.closedBall z R) :=
      (hψ.continuous.neg.lowerSemicontinuous).lowerSemicontinuousOn _
    exact h1.add h2
  obtain ⟨xs, hxs, hmin⟩ := hF.exists_isMinOn hne hcpt
  rw [isMinOn_iff] at hmin
  set m : ℝ := v xs - ψ xs with hm
  have hspade : ∀ x ∈ Metric.closedBall z R, ψ x + m ≤ v x := by
    intro x hx
    have := hmin x hx
    simp only at this
    rw [hm]
    linarith
  have hm0 : 0 ≤ m := by
    by_contra hneg
    push_neg at hneg
    have hlt : v xs < ψ xs := by rw [hm] at hneg; linarith
    have hxD : xs ∈ Metric.ball (0 : E2) (1 / 2) := hBD hxs
    have hd : dist xs z ≤ R := Metric.mem_closedBall.mp hxs
    rcases lt_or_eq_of_le hd with hlt' | heq
    · have hxb : xs ∈ Metric.ball z R := Metric.mem_ball.mpr hlt'
      by_cases hxO : xs ∈ O
      · have := hO xs hxs hxO
        linarith
      · obtain ⟨hgrad, hstrict⟩ := hout xs hxb hxO
        have hsm : ContDiff ℝ ∞ (fun x => ψ x + m) := hψ.add contDiff_const
        have hev : ∀ᶠ x in 𝓝 xs, (fun x => ψ x + m) x ≤ v x := by
          apply Filter.eventually_of_mem (Metric.isOpen_ball.mem_nhds hxb)
          intro x hx
          exact hspade x (Metric.ball_subset_closedBall hx)
        have heqv : (fun x => ψ x + m) xs = v xs := by
          simp only [hm]; ring
        have hDf : fderiv ℝ (fun x => ψ x + m) = fderiv ℝ ψ := by
          funext y
          exact fderiv_add_const _
        have hg' : ‖fderiv ℝ (fun x => ψ x + m) xs‖ ≤ Λ₀ := by
          rw [hDf]; exact hgrad
        have key := hss (fun x => ψ x + m) hsm xs hxD hev heqv hg'
        rw [hDf] at key
        linarith
    · have h1 := hsph xs heq
      have h2 := hv0 xs hxD
      linarith
  intro x hx
  have := hspade x hx
  linarith

theorem hpWH_growth : ∀ (v : E2 → ℝ) (Λ₀ β₀ : ℝ) (z : E2) (R s s' μ m : ℝ) (K O : Set E2),
    LowerSemicontinuousOn v (Metric.ball (0 : E2) (1 / 2)) →
    (∀ x ∈ Metric.ball (0 : E2) (1 / 2), 0 ≤ v x) → hpSuperSol v Λ₀ β₀ →
    ‖z‖ + R < 1 / 2 → 0 < s' → s' < s → s ≤ R → IsCompact K →
    K ⊆ Metric.closedBall z (R - s) → IsOpen O → K ⊆ O → (∀ x ∈ O, μ ≤ v x) → 0 < μ →
    2 * μ ≤ Λ₀ → 0 < m → ENNReal.ofReal m ≤ volume K → 0 < β₀ → β₀ ≤ 1 / 14 →
    β₀ ≤ μ * m / 40 →
    ∀ x ∈ Metric.closedBall z R, (∀ y ∈ K, dist x y ≤ s') →
      min μ (μ * (3 / (4 * Real.pi)) * m * (s' ^ (-(1 / 2 : ℝ)) - s ^ (-(1 / 2 : ℝ)))) ≤ v x :=
by
  intro v Λ₀ β₀ z R s s' μ m K O hlsc hv0 hss hzR hs' hss' hsR hKc hKsub hO hKO hOv hμ hΛ hm
    hKvol hβ0 hβ14 hβm
  have hpi := Real.pi_pos
  have hpi2 := Real.pi_lt_d2
  
  have hR0 : 0 < R := by linarith
  have hzn : 0 ≤ ‖z‖ := norm_nonneg z
  have hR12 : R < 1 / 2 := by linarith
  have hBD : Metric.closedBall z R ⊆ Metric.ball (0 : E2) (1 / 2) := by
    intro x hx
    rw [Metric.mem_closedBall, dist_eq_norm] at hx
    rw [mem_ball_zero_iff]
    have := norm_le_norm_add_norm_sub' x z
    linarith
  have hstar : ∀ x ∈ Metric.closedBall z R, ∀ y ∈ K, ‖x - y‖ < 1 := by
    intro x hx y hy
    have hyz : dist y z ≤ R - s := hKsub hy
    have hxz : dist x z ≤ R := hx
    rw [← dist_eq_norm]
    have := dist_triangle x z y
    rw [dist_comm z y] at this
    linarith
  have hKmeas : MeasurableSet K := hKc.measurableSet
  have hKfin : volume K < ⊤ := hKc.measure_lt_top
  have hmK : m ≤ (volume K).toReal := (ENNReal.ofReal_le_iff_le_toReal hKfin.ne).1 hKvol
  
  obtain ⟨δ, hδ, hδO⟩ := hKc.exists_thickening_subset_open hO hKO
  set ρ : ℝ := min δ s / 2 with hρ
  have hmin1 : min δ s ≤ δ := min_le_left _ _
  have hmin2 : min δ s ≤ s := min_le_right _ _
  have hmin0 : 0 < min δ s := lt_min hδ (by linarith)
  have hρ0 : 0 < ρ := by rw [hρ]; linarith
  have hρδ : ρ < δ := by rw [hρ]; linarith
  have hρs : ρ < s := by rw [hρ]; linarith
  have hdiam : ∀ x, x ∉ O → ∀ y ∈ K, ρ < ‖x - y‖ := by
    intro x hxO y hy
    by_contra hcon
    push_neg at hcon
    apply hxO
    apply hδO
    rw [Metric.mem_thickening_iff]
    exact ⟨y, hy, by rw [dist_eq_norm]; linarith⟩
  
  obtain ⟨g, hgC, hgS, hgUp, hgEq⟩ := hpWH_kernel ρ s hρ0 (by linarith)
  set c : ℝ := μ * (3 / (4 * Real.pi)) with hc
  have hc0 : 0 < c := by rw [hc]; positivity
  set ψ : E2 → ℝ := fun x => c * ∫ y in K, g (x - y) with hψ
  obtain ⟨hψC, hψD⟩ := hpWH_conv_calculus K g ψ c hKc hgC hgS hc0.le (fun x => rfl)
  have h1 : ∀ x : E2, ∫⁻ y in Metric.ball x 1, ENNReal.ofReal (‖x - y‖ ^ (-(1 / 2 : ℝ))) ≤
      ENNReal.ofReal (4 * Real.pi / 3) := by
    intro x
    have h := hpWH_rpow_ball x (1 / 2) (by norm_num) (by norm_num)
    have e : (2 * Real.pi / (2 - 1 / 2) : ℝ) = 4 * Real.pi / 3 := by ring
    rwa [e] at h
  have h3 : ∀ x : E2, ∫⁻ y in Metric.ball x 1, ENNReal.ofReal (‖x - y‖ ^ (-(3 / 2 : ℝ))) ≤
      ENNReal.ofReal (4 * Real.pi) := by
    intro x
    have h := hpWH_rpow_ball x (3 / 2) (by norm_num) (by norm_num)
    have e : (2 * Real.pi / (2 - 3 / 2) : ℝ) = 4 * Real.pi := by ring
    rwa [e] at h
  
  have hsphere : ∀ x, dist x z = R → ψ x ≤ 0 := by
    intro x hxR
    have hxB : x ∈ Metric.closedBall z R := by rw [Metric.mem_closedBall]; exact hxR.le
    have hint : ∫ y in K, g (x - y) ≤ 0 := by
      apply setIntegral_nonpos hKmeas
      intro y hy
      have hyz : dist y z ≤ R - s := hKsub hy
      have hge : s ≤ ‖x - y‖ := by
        rw [← dist_eq_norm]
        have := dist_triangle x y z
        linarith
      have hlt1 := hstar x hxB y hy
      rw [(hgEq (x - y) (by linarith) hlt1).1]
      have := Real.rpow_le_rpow_of_nonpos (by linarith : (0 : ℝ) < s) hge
        (by norm_num : (-(1 / 2 : ℝ)) ≤ 0)
      linarith
    exact mul_nonpos_of_nonneg_of_nonpos hc0.le hint
  have hinO : ∀ x ∈ Metric.closedBall z R, x ∈ O → ψ x ≤ v x := by
    intro x hxB hxO
    have hI := hpWH_kernel_int_upper K g x s hKc hgC.continuous (by linarith) (hstar x hxB)
      hgUp (h1 x)
    have hle : ψ x ≤ μ := by
      calc ψ x = c * ∫ y in K, g (x - y) := rfl
        _ ≤ c * (4 * Real.pi / 3) := mul_le_mul_of_nonneg_left hI hc0.le
        _ = μ := by rw [hc]; field_simp
    exact hle.trans (hOv x hxO)
  have hout : ∀ x ∈ Metric.ball z R, x ∉ O → ‖fderiv ℝ ψ x‖ ≤ Λ₀ ∧
      β₀ * (1 + ‖fderiv ℝ (fderiv ℝ ψ) x‖) <
        ∑ i : Fin 2, fderiv ℝ (fun y => fderiv ℝ ψ y (e2 i)) x (e2 i) := by
    intro x hxb hxO
    have hxB : x ∈ Metric.closedBall z R := Metric.ball_subset_closedBall hxb
    have hKx : ∀ y ∈ K, ρ < ‖x - y‖ ∧ ‖x - y‖ < 1 :=
      fun y hy => ⟨hdiam x hxO y hy, hstar x hxB y hy⟩
    obtain ⟨hI1, J, hJ, hJlap, hJhess⟩ := hpWH_kernel_int_deriv K g x ρ hKc hgC hρ0 hKx
      (fun w hw1 hw2 => (hgEq w hw1 hw2).2) (h3 x)
    obtain ⟨hD1, hD2, hD3⟩ := hψD x
    have hmJ : m ≤ J := hmK.trans hJ
    have hJpos : 0 < J := lt_of_lt_of_le hm hmJ
    constructor
    · calc ‖fderiv ℝ ψ x‖ ≤ c * (∫ y in K, ‖fderiv ℝ g (x - y)‖) := hD1
        _ ≤ c * (2 * Real.pi) := mul_le_mul_of_nonneg_left hI1 hc0.le
        _ = 3 / 2 * μ := by rw [hc]; field_simp; ring
        _ ≤ Λ₀ := by linarith
    · rw [hD2, hJlap]
      have hH : ‖fderiv ℝ (fderiv ℝ ψ) x‖ ≤ c * (7 / 4 * J) :=
        hD3.trans (mul_le_mul_of_nonneg_left hJhess hc0.le)
      have hcJ : 0 < c * J := mul_pos hc0 hJpos
      have e1 : β₀ * (1 + ‖fderiv ℝ (fderiv ℝ ψ) x‖) ≤ β₀ + β₀ * (c * (7 / 4 * J)) := by
        have := mul_le_mul_of_nonneg_left hH hβ0.le
        linarith
      have e2 : β₀ * (c * (7 / 4 * J)) ≤ 1 / 14 * (c * (7 / 4 * J)) :=
        mul_le_mul_of_nonneg_right hβ14 (by positivity)
      have hA : (1 / 5 : ℝ) < 3 / (4 * Real.pi) := by
        rw [lt_div_iff₀ (by positivity)]
        nlinarith
      have hμm : 0 < μ * m := mul_pos hμ hm
      have e3 : μ * m / 40 < c * m / 8 := by
        rw [hc]
        have := mul_lt_mul_of_pos_left hA hμm
        nlinarith
      have e4 : c * m / 8 ≤ c * J / 8 := by
        have := mul_le_mul_of_nonneg_left hmJ hc0.le
        linarith
      nlinarith
  have hcmp := hpWH_compare v ψ Λ₀ β₀ z R O hlsc hv0 hss hBD hR0.le hψC hsphere hinO hout
  
  intro x hxB hxK
  have hκ : 0 ≤ s' ^ (-(1 / 2 : ℝ)) - s ^ (-(1 / 2 : ℝ)) :=
    sub_nonneg.2 (Real.rpow_le_rpow_of_nonpos hs' hss'.le (by norm_num))
  by_cases hxO : x ∈ O
  · exact (min_le_left _ _).trans (hOv x hxO)
  · refine (min_le_right _ _).trans ?_
    have hge : ∀ y ∈ K, s' ^ (-(1 / 2 : ℝ)) - s ^ (-(1 / 2 : ℝ)) ≤ g (x - y) := by
      intro y hy
      have hy1 := hdiam x hxO y hy
      have hy2 := hstar x hxB y hy
      rw [(hgEq (x - y) hy1 hy2).1]
      have hy3 : ‖x - y‖ ≤ s' := by rw [← dist_eq_norm]; exact hxK y hy
      have := Real.rpow_le_rpow_of_nonpos (by linarith : (0 : ℝ) < ‖x - y‖) hy3
        (by norm_num : (-(1 / 2 : ℝ)) ≤ 0)
      linarith
    have hint : IntegrableOn (fun y => g (x - y)) K :=
      (hgC.continuous.comp (continuous_const.sub continuous_id)).continuousOn.integrableOn_compact
        hKc
    have hlow := setIntegral_ge_of_const_le hKmeas hKfin.ne hge hint
    have hreal : (volume : Measure E2).real K = (volume K).toReal := rfl
    rw [hreal, smul_eq_mul] at hlow
    have hmk : m * (s' ^ (-(1 / 2 : ℝ)) - s ^ (-(1 / 2 : ℝ))) ≤ ∫ y in K, g (x - y) :=
      le_trans (mul_le_mul_of_nonneg_right hmK hκ) hlow
    calc μ * (3 / (4 * Real.pi)) * m * (s' ^ (-(1 / 2 : ℝ)) - s ^ (-(1 / 2 : ℝ)))
        = c * (m * (s' ^ (-(1 / 2 : ℝ)) - s ^ (-(1 / 2 : ℝ)))) := by rw [hc]; ring
      _ ≤ c * ∫ y in K, g (x - y) := mul_le_mul_of_nonneg_left hmk hc0.le
      _ = ψ x := rfl
      _ ≤ v x := hcmp x hxB

theorem hpWH_find_ball : ∀ S : Set E2, MeasurableSet S → S ⊆ Metric.ball (0 : E2) (1 / 4) →
    volume (Metric.ball (0 : E2) (1 / 4)) ≤ 3 * volume S →
    ∃ (z : E2) (K : Set E2), ‖z‖ < 5 / 16 ∧ IsCompact K ∧
      K ⊆ S ∩ Metric.closedBall z (1 / 16) ∧ ENNReal.ofReal (1 / 2000) ≤ volume K :=
by
  classical
  have key1 : ∀ n a b : ℝ, 0 ≤ n → n < 1 / 4 → n ^ 2 = a ^ 2 + b ^ 2 →
      -(1 / 4) < a ∧ a < 1 / 4 ∧ -(1 / 4) < b ∧ b < 1 / 4 := by
    intro n a b hn hlt he
    have h1 : n ^ 2 < (1 / 4) ^ 2 := sq_lt_sq' (by linarith) hlt
    have ha := abs_lt_of_sq_lt_sq' (show a ^ 2 < (1 / 4 : ℝ) ^ 2 by nlinarith [sq_nonneg b])
      (by norm_num)
    have hb := abs_lt_of_sq_lt_sq' (show b ^ 2 < (1 / 4 : ℝ) ^ 2 by nlinarith [sq_nonneg a])
      (by norm_num)
    exact ⟨ha.1, ha.2, hb.1, hb.2⟩
  have key2 : ∀ n t s : ℝ, 0 ≤ n → n ^ 2 = t ^ 2 + s ^ 2 → -(1 / 32) ≤ t → t ≤ 1 / 32 →
      -(1 / 32) ≤ s → s ≤ 1 / 32 → n ≤ 1 / 16 := by
    intro n t s hn he ht1 ht2 hs1 hs2
    have h1 : t ^ 2 ≤ (1 / 32) ^ 2 := sq_le_sq' ht1 ht2
    have h2 : s ^ 2 ≤ (1 / 32) ^ 2 := sq_le_sq' hs1 hs2
    have h3 : n ^ 2 ≤ (1 / 16) ^ 2 := by nlinarith
    exact (abs_le_of_sq_le_sq' h3 (by norm_num)).2
  intro S hSm hS hvol
  
  have hnorm2 : ∀ y : E2, ‖y‖ ^ 2 = y 0 ^ 2 + y 1 ^ 2 := by
    intro y
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (by positivity), Fin.sum_univ_two,
      Real.norm_eq_abs, Real.norm_eq_abs, sq_abs, sq_abs]
  let cen : ℤ × ℤ → E2 := fun p =>
    (((p.1 : ℝ) + 1 / 2) / 16) • e2 0 + (((p.2 : ℝ) + 1 / 2) / 16) • e2 1
  have hcen0 : ∀ p : ℤ × ℤ, cen p 0 = ((p.1 : ℝ) + 1 / 2) / 16 := by
    intro p; simp [cen, e2, EuclideanSpace.single_apply]
  have hcen1 : ∀ p : ℤ × ℤ, cen p 1 = ((p.2 : ℝ) + 1 / 2) / 16 := by
    intro p; simp [cen, e2, EuclideanSpace.single_apply]
  set C : Finset E2 := (Finset.Ico (-4 : ℤ) 4 ×ˢ Finset.Ico (-4 : ℤ) 4).image cen with hC
  have hCcard : C.card ≤ 64 := by
    refine (Finset.card_image_le).trans ?_
    rw [Finset.card_product, Int.card_Ico]
    norm_num
    first | decide | exact le_rfl | simp
  have hcov : ∀ x : E2, ‖x‖ < 1 / 4 → ∃ c ∈ C, dist x c ≤ 1 / 16 := by
    intro x hx
    obtain ⟨h0l, h0u, h1l, h1u⟩ := key1 ‖x‖ (x 0) (x 1) (norm_nonneg x) hx (hnorm2 x)
    set k0 : ℤ := ⌊16 * x 0⌋ with hk0
    set k1 : ℤ := ⌊16 * x 1⌋ with hk1
    have hk0l : -4 ≤ k0 := Int.le_floor.mpr (by push_cast; linarith only [h0l])
    have hk0u : k0 < 4 := Int.floor_lt.mpr (by push_cast; linarith only [h0u])
    have hk1l : -4 ≤ k1 := Int.le_floor.mpr (by push_cast; linarith only [h1l])
    have hk1u : k1 < 4 := Int.floor_lt.mpr (by push_cast; linarith only [h1u])
    have f0a : (k0 : ℝ) ≤ 16 * x 0 := Int.floor_le _
    have f0b : 16 * x 0 < (k0 : ℝ) + 1 := Int.lt_floor_add_one _
    have f1a : (k1 : ℝ) ≤ 16 * x 1 := Int.floor_le _
    have f1b : 16 * x 1 < (k1 : ℝ) + 1 := Int.lt_floor_add_one _
    refine ⟨cen (k0, k1), Finset.mem_image_of_mem _ ?_, ?_⟩
    · simp only [Finset.mem_product, Finset.mem_Ico]
      exact ⟨⟨hk0l, hk0u⟩, ⟨hk1l, hk1u⟩⟩
    · rw [dist_eq_norm]
      have hd := hnorm2 (x - cen (k0, k1))
      simp only [PiLp.sub_apply, hcen0, hcen1] at hd
      exact key2 _ _ _ (norm_nonneg _) hd (by linarith only [f0a, f0b])
        (by linarith only [f0a, f0b]) (by linarith only [f1a, f1b]) (by linarith only [f1a, f1b])
  
  have hball : volume (Metric.ball (0 : E2) (1 / 4)) = ENNReal.ofReal ((1 / 4) ^ 2 * Real.pi) := by
    rw [EuclideanSpace.volume_ball_fin_two, ← ENNReal.ofReal_pow (by norm_num),
      ← ENNReal.ofReal_mul (by positivity)]
  have h64 : (64 : ENNReal) * ENNReal.ofReal (1 / 2000) < volume S := by
    by_contra hcon
    push_neg at hcon
    have h1 : ENNReal.ofReal ((1 / 4) ^ 2 * Real.pi) ≤ ENNReal.ofReal (3 * (64 * (1 / 2000))) := by
      calc ENNReal.ofReal ((1 / 4) ^ 2 * Real.pi) = volume (Metric.ball (0 : E2) (1 / 4)) :=
            hball.symm
        _ ≤ 3 * volume S := hvol
        _ ≤ 3 * (64 * ENNReal.ofReal (1 / 2000)) := by gcongr
        _ = ENNReal.ofReal (3 * (64 * (1 / 2000))) := by
          rw [ENNReal.ofReal_mul (by norm_num), ENNReal.ofReal_mul (by norm_num)]
          simp
    rw [ENNReal.ofReal_le_ofReal_iff (by norm_num)] at h1
    nlinarith only [h1, Real.pi_gt_three]
  
  have hcovS : ∀ x ∈ S, ∃ c ∈ C, dist x c ≤ 1 / 16 :=
    fun x hx => hcov x (mem_ball_zero_iff.mp (hS hx))
  have hlt : (C.card : ENNReal) * ENNReal.ofReal (1 / 2000) < volume S := by
    refine lt_of_le_of_lt ?_ h64
    gcongr
    exact_mod_cast hCcard
  obtain ⟨c, hcC, hc⟩ : ∃ c ∈ C,
      ENNReal.ofReal (1 / 2000) < volume (S ∩ Metric.closedBall c (1 / 16)) := by
    by_contra hcon
    push_neg at hcon
    have hsub : S ⊆ ⋃ c ∈ C, S ∩ Metric.closedBall c (1 / 16) := by
      intro x hx
      obtain ⟨c, hc, hd⟩ := hcovS x hx
      exact Set.mem_iUnion₂.mpr ⟨c, hc, hx, Metric.mem_closedBall.mpr hd⟩
    have hle : volume S ≤ (C.card : ENNReal) * ENNReal.ofReal (1 / 2000) :=
      calc volume S ≤ volume (⋃ c ∈ C, S ∩ Metric.closedBall c (1 / 16)) := measure_mono hsub
        _ ≤ ∑ c ∈ C, volume (S ∩ Metric.closedBall c (1 / 16)) := measure_biUnion_finset_le C _
        _ ≤ C.card • ENNReal.ofReal (1 / 2000) := Finset.sum_le_card_nsmul _ _ _ hcon
        _ = (C.card : ENNReal) * ENNReal.ofReal (1 / 2000) := nsmul_eq_mul _ _
    exact absurd hlt (not_lt.mpr hle)
  
  obtain ⟨K, hKT, hKc, hKv⟩ :=
    (hSm.inter Metric.isClosed_closedBall.measurableSet).exists_lt_isCompact hc
  obtain ⟨y, hy⟩ := MeasureTheory.nonempty_of_measure_ne_zero
    (ne_of_gt (lt_of_le_of_lt (zero_le _) hKv))
