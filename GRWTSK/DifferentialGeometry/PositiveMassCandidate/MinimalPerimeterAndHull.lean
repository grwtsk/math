                (f2 ⟨inner ℝ e1 z, inner ℝ e2 z⟩ - f1 ⟨inner ℝ e1 z, inner ℝ e2 z⟩) *
                (f2 ⟨inner ℝ e1 z, inner ℝ e2 z⟩ - f1 ⟨inner ℝ e1 z, inner ℝ e2 z⟩) =
                inner ℝ ν z := by
