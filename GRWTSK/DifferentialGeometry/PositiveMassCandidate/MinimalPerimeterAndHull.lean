theorem hpHarn_envelope_viscosity : ∀ Λ₀ β₀ : ℝ, 0 < Λ₀ → 0 < β₀ → ∃ δ₃ : ℝ, 0 < δ₃ ∧
    ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (F U : Set E3) (a b : ℝ) (ℓ υ : E2 → ℝ),
    IsOpen U → (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => G z i j) U) →
    (∀ (z : E3) (i j : Fin 3), G z i j = G z j i) → (∀ z ∈ U, (G z).PosDef) →
    Metric.closedBall (0 : E3) 1 ⊆ U → a < b → b - a ≤ δ₃ →
    (∀ z ∈ Metric.ball (0 : E3) 1, ∀ i j : Fin 3,
       |G z i j - (if i = j then (1 : ℝ) else 0)| ≤ δ₃ ∧
       ‖fderiv ℝ (fun w => G w i j) z‖ ≤ δ₃ * (b - a)) →
    -(1 / 8) ≤ a → b ≤ 1 / 8 →
    (∀ x ∈ Metric.ball (0 : E2) (1 / 2), a ≤ ℓ x ∧ ℓ x ≤ υ x ∧ υ x ≤ b) →
    (∀ x ∈ Metric.ball (0 : E2) (1 / 2),
      (∀ N ∈ 𝓝 (hpLift (ℓ x) x), volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0) ∧
      (∀ N ∈ 𝓝 (hpLift (υ x) x), volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0)) →
    volume ({z | z ∈ hpCyl (1 / 2) (1 / 2) ∧ z 0 < ℓ (hpProj z)} \ F) = 0 →
    volume ({z | z ∈ hpCyl (1 / 2) (1 / 2) ∧ υ (hpProj z) < z 0} ∩ F) = 0 →
    (∀ (W : Set E3) (f : E3 → ℝ) (z₀ : E3), IsOpen W → W ⊆ U → ContDiff ℝ ∞ f → z₀ ∈ W →
      f z₀ = 0 → (∀ N ∈ 𝓝 z₀, volume (N ∩ F) ≠ 0 ∧ volume (N \ F) ≠ 0) →
      ((∀ z ∈ W, levelMeanCurvCoord G f z < 0) →
          volume ((W ∩ {z | f z < 0}) \ F) = 0 → False) ∧
      ((∀ z ∈ W, 0 < levelMeanCurvCoord G f z) →
          volume (W ∩ {z | 0 < f z} ∩ F) = 0 → False)) →
    hpSuperSol (fun x => (ℓ x - a) / (b - a)) Λ₀ β₀ ∧
      hpSuperSol (fun x => (b - υ x) / (b - a)) Λ₀ β₀ :=
by
  intro Λ₀ β₀ hΛ₀ hβ₀
  obtain ⟨A, hAeq⟩ : ∃ A : ℝ, A = 2 * Λ₀ + 1 := ⟨_, rfl⟩
  have hA : 0 < A := by rw [hAeq]; linarith
  have hA1 : 1 ≤ A := by rw [hAeq]; linarith
  have hΛA : 2 * Λ₀ ≤ A := by rw [hAeq]; linarith
  obtain ⟨κ, hκeq⟩ : ∃ κ : ℝ, κ = β₀ * A / 2 := ⟨_, rfl⟩
  have hκ : 0 < κ := by rw [hκeq]; positivity
  obtain ⟨t, ht, hQ⟩ := quadSurface_meanCurv_approx A κ hA hκ
  refine ⟨t / A, div_pos ht hA, ?_⟩
  intro G F U a b ℓ υ hU hG hsymm hpd hcb hab hδ hmet ha hb hi hii hiv1 hiv2 htouch
  have hε : 0 < b - a := sub_pos.mpr hab
  have hδt : t / A ≤ t := div_le_self ht.le hA1
  have hεt : b - a ≤ t := hδ.trans hδt
  have hδA : t / A * A = t := div_mul_cancel₀ t hA.ne'
  obtain ⟨η, hηeq⟩ : ∃ η : ℝ, η = β₀ / (4 + β₀) := ⟨_, rfl⟩
  have hη : 0 < η := by rw [hηeq]; positivity
  have hηid : (β₀ / 2 + 2) * η = β₀ / 2 := by
    rw [hηeq]; field_simp; ring
  
  have hproj_cont : Continuous hpProj := by
    unfold hpProj
    refine (EuclideanSpace.equiv (Fin 2) ℝ).symm.continuous.comp (continuous_pi fun i => ?_)
    fin_cases i <;> simp <;> fun_prop
  have hlift_c : ∀ (s' : ℝ) (x : E2),
      (hpLift s' x) 0 = s' ∧ (hpLift s' x) 1 = x 0 ∧ (hpLift s' x) 2 = x 1 := by
    intro s' x; simp [hpLift, cylPt, e, EuclideanSpace.single_apply]
  have hproj_c : ∀ z : E3, (hpProj z) 0 = z 1 ∧ (hpProj z) 1 = z 2 := by
    intro z; simp [hpProj]
  have hproj_lift : ∀ (s' : ℝ) (x : E2), hpProj (hpLift s' x) = x := by
    intro s' x
    ext i
    fin_cases i
    · simp only [Fin.zero_eta]
      rw [(hproj_c _).1, (hlift_c s' x).2.1]
    · simp only [Fin.mk_one]
      rw [(hproj_c _).2, (hlift_c s' x).2.2]
  have hcyl_open : IsOpen (hpCyl (1 / 2) (1 / 2)) := by
    unfold hpCyl
    exact IsOpen.and (isOpen_lt (by fun_prop) continuous_const)
      (isOpen_lt (by fun_prop) continuous_const)
  have hn2 : ∀ x : E2, ‖x‖ ^ 2 = x 0 ^ 2 + x 1 ^ 2 := by
    intro x
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (by positivity), Fin.sum_univ_two]
    simp [Real.norm_eq_abs, sq_abs]
  have hn3 : ∀ z : E3, ‖z‖ ^ 2 = z 0 ^ 2 + z 1 ^ 2 + z 2 ^ 2 := by
    intro z
    rw [EuclideanSpace.norm_eq, Real.sq_sqrt (by positivity), Fin.sum_univ_three]
    simp [Real.norm_eq_abs, sq_abs]
  have hcyl_ball : hpCyl (1 / 2) (1 / 2) ⊆ Metric.ball (0 : E3) 1 := by
    intro z hz
    obtain ⟨h1, h2⟩ := hz
    obtain ⟨h3, h4⟩ := abs_lt.1 h2
    rw [mem_ball_zero_iff]
    have h5 := hn3 z
    have h6 : ‖z‖ ^ 2 < 1 := by nlinarith
    nlinarith [norm_nonneg z]
  have hlift_mem : ∀ (s' : ℝ) (x : E2), ‖x‖ < 1 / 2 → |s'| < 1 / 2 →
      hpLift s' x ∈ hpCyl (1 / 2) (1 / 2) := by
    intro s' x hx hs'
    obtain ⟨c0, c1, c2⟩ := hlift_c s' x
    refine ⟨?_, ?_⟩
    · rw [c1, c2, ← hn2 x]
      nlinarith [norm_nonneg x]
    · rw [c0]; exact hs'
  have he0n : ‖(e 0 : E3)‖ = 1 := by simp [e, EuclideanSpace.norm_single]
  have hcyl_norm : ∀ u v : ℝ, ‖cylPt 0 u v‖ ≤ |u| + |v| := by
    intro u v
    unfold cylPt
    refine (norm_add_le _ _).trans ?_
    refine (add_le_add (norm_add_le ((0 : ℝ) • e 0) (u • e 1)) (le_refl ‖v • e 2‖)).trans ?_
    simp [norm_smul, e, EuclideanSpace.norm_single]
  
  have hdec : ∀ h : E2, h = h 0 • e2 0 + h 1 • e2 1 := by
    intro h; ext i; fin_cases i <;> simp [EuclideanSpace.single_apply]
  have hLc : ∀ (L : E2 →L[ℝ] ℝ) (h : E2), L h = h 0 * L (e2 0) + h 1 * L (e2 1) := by
    intro L h
    conv_lhs => rw [hdec h]
    simp only [map_add, map_smul, smul_eq_mul]
  have hBc : ∀ (B : E2 →L[ℝ] E2 →L[ℝ] ℝ) (h : E2), B h h =
      h 0 * h 0 * B (e2 0) (e2 0) + h 0 * h 1 * B (e2 0) (e2 1) +
        h 1 * h 0 * B (e2 1) (e2 0) + h 1 * h 1 * B (e2 1) (e2 1) := by
    intro B h
    have k : B h = h 0 • B (e2 0) + h 1 • B (e2 1) := by
      conv_lhs => rw [hdec h]
      simp only [map_add, map_smul]
    rw [hLc (B h) h, k]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    ring
  
  have hderiv : ∀ (φ : E2 → ℝ) (x₀ : E2), ContDiff ℝ ∞ φ → ∀ k l : Fin 2,
      fderiv ℝ (fun y => fderiv ℝ φ y (e2 l)) x₀ (e2 k) =
        fderiv ℝ (fderiv ℝ φ) x₀ (e2 k) (e2 l) := by
    intro φ x₀ hφ k l
    have hD : ContDiff ℝ ∞ (fderiv ℝ φ) := hφ.fderiv_right (by simp)
    have hDd : Differentiable ℝ (fderiv ℝ φ) := hD.differentiable (by simp)
    rw [fderiv_clm_apply (hDd x₀) (differentiableAt_const _)]
    simp
  
  have htaylor : ∀ (φ : E2 → ℝ) (x₀ : E2) (η : ℝ), ContDiff ℝ ∞ φ → 0 < η →
      ∀ᶠ x in 𝓝 x₀, φ x₀ + fderiv ℝ φ x₀ (x - x₀) +
        (1 / 2) * fderiv ℝ (fderiv ℝ φ) x₀ (x - x₀) (x - x₀) - (η / 2) * ‖x - x₀‖ ^ 2 ≤ φ x := by
    intro φ x₀ η hφ hη
    have hφd : Differentiable ℝ φ := hφ.differentiable (by simp)
    have hD : ContDiff ℝ ∞ (fderiv ℝ φ) := hφ.fderiv_right (by simp)
    have hDd : Differentiable ℝ (fderiv ℝ φ) := hD.differentiable (by simp)
    have hlo := (hDd x₀).hasFDerivAt.isLittleO
    have h1 := hlo.def (by positivity : (0 : ℝ) < η / 2)
    obtain ⟨r, hr, hball⟩ := Metric.eventually_nhds_iff.1 h1
    rw [Metric.eventually_nhds_iff]
    refine ⟨r, hr, fun x hx => ?_⟩
    set D2 := fderiv ℝ (fderiv ℝ φ) x₀ with hD2
    set h := x - x₀ with hh
    have hγ : ∀ s : ℝ, HasDerivAt (fun s : ℝ => φ (x₀ + s • h) - s * fderiv ℝ φ x₀ h -
        s ^ 2 / 2 * D2 h h + η / 2 * s ^ 2 * ‖h‖ ^ 2)
        (fderiv ℝ φ (x₀ + s • h) h - fderiv ℝ φ x₀ h - s * D2 h h + η * s * ‖h‖ ^ 2) s := by
      intro s
      have hl : HasDerivAt (fun s : ℝ => x₀ + s • h) h s := by
        simpa using ((hasDerivAt_id s).smul_const h).const_add x₀
      have k1 : HasDerivAt (fun s => φ (x₀ + s • h)) (fderiv ℝ φ (x₀ + s • h) h) s :=
        (hφd _).hasFDerivAt.comp_hasDerivAt s hl
      have k2 := (hasDerivAt_id s).mul_const (fderiv ℝ φ x₀ h)
      have k3 := ((hasDerivAt_pow 2 s).div_const 2).mul_const (D2 h h)
      have k4 := ((hasDerivAt_pow 2 s).const_mul (η / 2)).mul_const (‖h‖ ^ 2)
      convert ((k1.sub k2).sub k3).add k4 using 1
      simp only [Nat.cast_ofNat]
      ring
    have hmono : MonotoneOn (fun s : ℝ => φ (x₀ + s • h) - s * fderiv ℝ φ x₀ h -
        s ^ 2 / 2 * D2 h h + η / 2 * s ^ 2 * ‖h‖ ^ 2) (Set.Icc 0 1) := by
      apply monotoneOn_of_deriv_nonneg (convex_Icc 0 1)
      · exact HasDerivAt.continuousOn (fun s _ => hγ s)
      · exact fun s _ => (hγ s).differentiableAt.differentiableWithinAt
      · intro s hs
        rw [interior_Icc] at hs
        rw [(hγ s).deriv]
        obtain ⟨hs0, hs1⟩ := hs
        have hnh : ‖s • h‖ = s * ‖h‖ := by rw [norm_smul, Real.norm_eq_abs, abs_of_pos hs0]
        have hxr : ‖h‖ < r := by rw [hh, ← dist_eq_norm]; exact hx
        have hdist : dist (x₀ + s • h) x₀ < r := by
          rw [dist_eq_norm, add_sub_cancel_left, hnh]
          nlinarith [norm_nonneg h]
        have hb := hball hdist
        rw [add_sub_cancel_left, hnh] at hb
        have hop := (fderiv ℝ φ (x₀ + s • h) - fderiv ℝ φ x₀ - D2 (s • h)).le_opNorm h
        have hval : (fderiv ℝ φ (x₀ + s • h) - fderiv ℝ φ x₀ - D2 (s • h)) h =
            fderiv ℝ φ (x₀ + s • h) h - fderiv ℝ φ x₀ h - s * D2 h h := by
          simp [map_smul]
        rw [hval, Real.norm_eq_abs] at hop
        have hlow := neg_abs_le (fderiv ℝ φ (x₀ + s • h) h - fderiv ℝ φ x₀ h - s * D2 h h)
        have hm := mul_le_mul_of_nonneg_right hb (norm_nonneg h)
        nlinarith [norm_nonneg h, mul_nonneg (mul_nonneg hη.le hs0.le) (sq_nonneg ‖h‖)]
    have key := hmono ⟨le_refl (0 : ℝ), zero_le_one⟩ ⟨zero_le_one, le_refl (1 : ℝ)⟩ zero_le_one
    have hx' : x₀ + h = x := by rw [hh]; abel
    simp only [zero_smul, add_zero, zero_mul, sub_zero, one_smul, one_mul, hx'] at key
    norm_num at key
    linarith
  
  have hexp : ∀ (ρ ε s g0 g1 h00 h01 h10 h11 η : ℝ) (M : Matrix (Fin 3) (Fin 3) ℝ) (p y : E3),
      ρ ≠ 0 →
      M = !![0, 0, 0; 0, s * (ρ / 2) * (h00 - η), s * (ρ / 4) * (h01 + h10);
        0, s * (ρ / 4) * (h01 + h10), s * (ρ / 2) * (h11 - η)] →
      @inner ℝ E3 _ (e 0) (y - p) - ε * ρ * (@inner ℝ E3 _ (cylPt 0 (s * g0) (s * g1))
        (ρ⁻¹ • (y - p)) + ∑ i, ∑ j, M i j * (ρ⁻¹ • (y - p)) i * (ρ⁻¹ • (y - p)) j + 0) =
      (y 0 - p 0) - s * ε * ((g0 * (y 1 - p 1) + g1 * (y 2 - p 2)) +
        (1 / 2) * (h00 * (y 1 - p 1) ^ 2 + (h01 + h10) * (y 1 - p 1) * (y 2 - p 2) +
          h11 * (y 2 - p 2) ^ 2) - (η / 2) * ((y 1 - p 1) ^ 2 + (y 2 - p 2) ^ 2)) := by
    intro ρ ε s g0 g1 h00 h01 h10 h11 η M p y hρ hM
    subst hM
    simp [Fin.sum_univ_three, cylPt, inner_add_left, inner_smul_left,
      EuclideanSpace.inner_single_left]
    field_simp
    ring
  
  have hprops : ∀ (ρ s h00 h01 h10 h11 η B : ℝ) (M : Matrix (Fin 3) (Fin 3) ℝ), 0 < ρ → 0 ≤ η →
      |h00| ≤ B → |h01| ≤ B → |h10| ≤ B → |h11| ≤ B →
      M = !![0, 0, 0; 0, s * (ρ / 2) * (h00 - η), s * (ρ / 4) * (h01 + h10);
        0, s * (ρ / 4) * (h01 + h10), s * (ρ / 2) * (h11 - η)] →
      (∀ i j, M i j = M j i) ∧ (∀ i, ∑ j, M i j * (e 0) j = 0) ∧
      ∑ i, M i i = s * (ρ / 2) * (h00 + h11 - 2 * η) ∧
      (∀ i j, |M i j| ≤ |s| * (ρ / 2) * (B + η)) := by
    intro ρ s h00 h01 h10 h11 η B M hρ hη h1 h2 h3 h4 hM
    have hB : 0 ≤ B := (abs_nonneg _).trans h1
    refine ⟨?_, ?_, ?_, ?_⟩
    · intro i j; rw [hM]; fin_cases i <;> fin_cases j <;> simp
    · intro i; rw [hM]; fin_cases i <;> simp [EuclideanSpace.single_apply]
    · rw [hM]; simp [Fin.sum_univ_three]; ring
    · have k1 : |s * (ρ / 2) * (h00 - η)| ≤ |s| * (ρ / 2) * (B + η) := by
        rw [abs_mul, abs_mul, abs_of_pos (by positivity : (0:ℝ) < ρ / 2)]
        gcongr
        exact (abs_sub _ _).trans (by rw [abs_of_nonneg hη]; linarith)
      have k2 : |s * (ρ / 2) * (h11 - η)| ≤ |s| * (ρ / 2) * (B + η) := by
        rw [abs_mul, abs_mul, abs_of_pos (by positivity : (0:ℝ) < ρ / 2)]
        gcongr
        exact (abs_sub _ _).trans (by rw [abs_of_nonneg hη]; linarith)
      have k3 : |s * (ρ / 4) * (h01 + h10)| ≤ |s| * (ρ / 2) * (B + η) := by
        rw [abs_mul, abs_mul, abs_of_pos (by positivity : (0:ℝ) < ρ / 4)]
        have : |h01 + h10| ≤ 2 * B := (abs_add_le _ _).trans (by linarith)
        have hs := abs_nonneg s
        calc |s| * (ρ / 4) * |h01 + h10| ≤ |s| * (ρ / 4) * (2 * B) := by gcongr
          _ ≤ |s| * (ρ / 2) * (B + η) := by
            have : |s| * (ρ / 4) * (2 * B) = |s| * (ρ / 2) * B := by ring
            rw [this]; gcongr; linarith
      have k0 : (0:ℝ) ≤ |s| * (ρ / 2) * (B + η) := by positivity
      have hent : ∀ i j, M i j = 0 ∨ M i j = s * (ρ / 2) * (h00 - η) ∨
          M i j = s * (ρ / 4) * (h01 + h10) ∨ M i j = s * (ρ / 2) * (h11 - η) := by
        intro i j; rw [hM]; fin_cases i <;> fin_cases j <;> simp
      intro i j
      rcases hent i j with h | h | h | h <;> rw [h]
      · rw [abs_zero]; exact k0
      · exact k1
      · exact k3
      · exact k2
  
  have hcase : ∀ (s : ℝ) (m φ : E2 → ℝ) (x₀ : E2) (N : Set E2), (s = 1 ∨ s = -1) →
      ContDiff ℝ ∞ φ → ‖x₀‖ < 1 / 2 → |m x₀| < 1 / 2 → N ∈ 𝓝 x₀ →
      ‖fderiv ℝ φ x₀‖ ≤ Λ₀ →
      β₀ * (1 + ‖fderiv ℝ (fderiv ℝ φ) x₀‖) <
        ∑ i : Fin 2, fderiv ℝ (fun y => fderiv ℝ φ y (e2 i)) x₀ (e2 i) →
      ∃ (W : Set E3) (f : E3 → ℝ), IsOpen W ∧ W ⊆ U ∧ ContDiff ℝ ∞ f ∧
        hpLift (m x₀) x₀ ∈ W ∧ f (hpLift (m x₀) x₀) = 0 ∧
        (∀ z ∈ W, s * levelMeanCurvCoord G f z < 0) ∧
        ∀ z ∈ W, z ∈ hpCyl (1 / 2) (1 / 2) ∧ hpProj z ∈ N ∧
          ∃ P : ℝ, f z = (z 0 - m x₀) - s * (b - a) * P ∧ P ≤ φ (hpProj z) - φ x₀ := by
    intro s m φ x₀ N hs hφ hx₀ hm hN hgrad hT
    have habs_s : |s| = 1 := by rcases hs with rfl | rfl <;> simp
    obtain ⟨K₂, hK₂eq⟩ : ∃ K : ℝ, K = ‖fderiv ℝ (fderiv ℝ φ) x₀‖ := ⟨_, rfl⟩
    have hK₂ : 0 ≤ K₂ := by
      rw [hK₂eq]; positivity
    obtain ⟨g0, hg0⟩ : ∃ g : ℝ, g = fderiv ℝ φ x₀ (e2 0) := ⟨_, rfl⟩
    obtain ⟨g1, hg1⟩ : ∃ g : ℝ, g = fderiv ℝ φ x₀ (e2 1) := ⟨_, rfl⟩
    obtain ⟨H00, hH00⟩ : ∃ H : ℝ, H = fderiv ℝ (fderiv ℝ φ) x₀ (e2 0) (e2 0) := ⟨_, rfl⟩
    obtain ⟨H01, hH01⟩ : ∃ H : ℝ, H = fderiv ℝ (fderiv ℝ φ) x₀ (e2 0) (e2 1) := ⟨_, rfl⟩
    obtain ⟨H10, hH10⟩ : ∃ H : ℝ, H = fderiv ℝ (fderiv ℝ φ) x₀ (e2 1) (e2 0) := ⟨_, rfl⟩
    obtain ⟨H11, hH11⟩ : ∃ H : ℝ, H = fderiv ℝ (fderiv ℝ φ) x₀ (e2 1) (e2 1) := ⟨_, rfl⟩
    have hTeq : ∑ i : Fin 2, fderiv ℝ (fun y => fderiv ℝ φ y (e2 i)) x₀ (e2 i) = H00 + H11 := by
      rw [Fin.sum_univ_two, hderiv φ x₀ hφ 0 0, hderiv φ x₀ hφ 1 1, hH00, hH11]
    rw [hTeq, ← hK₂eq] at hT
    have hgb : ∀ k : Fin 2, |fderiv ℝ φ x₀ (e2 k)| ≤ Λ₀ := fun k => by
      have h1 := (fderiv ℝ φ x₀).le_opNorm (e2 k)
      have h2 : |fderiv ℝ φ x₀ (e2 k)| ≤ ‖fderiv ℝ φ x₀‖ := by
        simpa [e2, EuclideanSpace.norm_single] using h1
      linarith
    have hHb : ∀ k l : Fin 2, |fderiv ℝ (fderiv ℝ φ) x₀ (e2 k) (e2 l)| ≤ K₂ := fun k l => by
      have h1 := (fderiv ℝ (fderiv ℝ φ) x₀).le_opNorm₂ (e2 k) (e2 l)
      rw [hK₂eq]
      simpa [e2, EuclideanSpace.norm_single] using h1
    obtain ⟨ρ, hρeq⟩ : ∃ ρ : ℝ, ρ = A / (1 + K₂ + η) := ⟨_, rfl⟩
    have hden : 0 < 1 + K₂ + η := by linarith
    have hρpos : 0 < ρ := by rw [hρeq]; exact div_pos hA hden
    have hρA : ρ * (1 + K₂ + η) = A := by rw [hρeq]; exact div_mul_cancel₀ A hden.ne'
    have hρle : ρ ≤ A := by nlinarith [mul_nonneg hρpos.le (add_nonneg hK₂ hη.le)]
    obtain ⟨M, hMeq⟩ : ∃ M : Matrix (Fin 3) (Fin 3) ℝ,
        M = !![0, 0, 0; 0, s * (ρ / 2) * (H00 - η), s * (ρ / 4) * (H01 + H10);
          0, s * (ρ / 4) * (H01 + H10), s * (ρ / 2) * (H11 - η)] := ⟨_, rfl⟩
    obtain ⟨hMs, hMk, hMtr, hMb⟩ := hprops ρ s H00 H01 H10 H11 η K₂ M hρpos hη.le
      (hH00 ▸ hHb 0 0) (hH01 ▸ hHb 0 1) (hH10 ▸ hHb 1 0) (hH11 ▸ hHb 1 1) hMeq
    have hMA : ∀ i j, |M i j| ≤ A := by
      intro i j
      refine (hMb i j).trans ?_
      rw [habs_s, one_mul]
      nlinarith [mul_nonneg hρpos.le hK₂, mul_nonneg hρpos.le hη.le]
    have hbA : ‖cylPt 0 (s * g0) (s * g1)‖ ≤ A := by
      refine (hcyl_norm _ _).trans ?_
      rw [abs_mul, abs_mul, habs_s, one_mul, one_mul]
      have k0 := hgb 0
      have k1 := hgb 1
      rw [← hg0] at k0
      rw [← hg1] at k1
      linarith
