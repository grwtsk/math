  have hVPa : ∀ x₀ ∈ Metric.ball (0 : ℂ) (1 / 4), ∀ p1 p2 a b d c σ : ℝ, 0 < σ → a + d < 0 →
      (∀ ζ ∈ Metric.ball x₀ σ, u ζ ≤ p1 * ζ.re + p2 * ζ.im + a * ζ.re ^ 2 +
