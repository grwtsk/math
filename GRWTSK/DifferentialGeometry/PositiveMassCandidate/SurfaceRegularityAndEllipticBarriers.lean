  unfold hullRiemPer hspSectorPer
  refine iSup_le fun n => iSup_le fun q => iSup_le fun W => iSup_le fun hW => ?_
  have hP : ∀ j, hullPerG (g.coeff (chartAt E3 (q j)).symm)
