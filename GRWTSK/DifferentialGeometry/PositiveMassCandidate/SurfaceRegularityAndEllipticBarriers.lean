  have hS6 : ∀ (q' : M) (W' : Set M), IsOpen W' → W' ⊆ κ.source →
      W' ⊆ (chartAt E3 q').source → κ '' W' ⊆ B → ∀ s : Fin k → Bool,
      sepPerG (g.coeff (chartAt E3 q').symm)
