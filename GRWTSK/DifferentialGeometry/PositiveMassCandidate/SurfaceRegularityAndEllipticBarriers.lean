            (fun i => (hwallT (q j) _ hRo hRt hRs hRB i).1)
            (fun i => (hwallT (q j) _ hRo hRt hRs hRB i).2)
            (chartAt E3 (q j) '' (K ∩ (chartAt E3 (q j)).source)) hKc
            (chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source)) (hE (q j))
      _ ≤ _ := Finset.sum_le_sum fun s _ => hS6 (q j) (W j) hW'o hW'p hW'q hWB s
  have hEDm : ∀ s : Fin k → Bool, MeasurableSet (κ '' (E ∩ κ.source) ∩ hspSector B φ s) :=
    fun s => (hE p).inter
      (hsecOpen B Metric.isOpen_ball φ (fun i => (hφ i).continuousOn) s).measurableSet
  have hdisj : Pairwise (fun a b => Disjoint (κ '' W a) (κ '' W b)) := by
    intro a b hab
    rw [Set.disjoint_left]
    rintro _ ⟨x, hx, rfl⟩ ⟨y, hy, hxy⟩
    have hxs : x ∈ κ.source := hO ((hW.1 a).2 hx).1
    have hys : y ∈ κ.source := hO ((hW.1 b).2 hy).1
    have hyx : y = x := κ.injOn hys hxs hxy
    exact Set.disjoint_left.1 (hW.2 hab) hx (hyx ▸ hy)
  calc _ ≤ ∑ j, ∑ s : Fin k → Bool,
