      rw [he, measure_empty]
    calc sepPerG (g.coeff (chartAt E3 q').symm)
          (chartAt E3 q' '' (E ∩ (chartAt E3 q').source) ∩
            hspSector (chartAt E3 q' '' W') (fun i z => φ i (κ ((chartAt E3 q').symm z))) s)
          (chartAt E3 q' '' W')
        = sepPerG (g.coeff (chartAt E3 q').symm) (Y ∩ R') R' := by rw [hd, hR'def]
