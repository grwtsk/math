      rintro _ ⟨w, hw, rfl⟩; rw [(chartAt E3 (q j)).left_inv (hW'q hw)]; exact hW'p hw
    have hRB : ∀ z ∈ chartAt E3 (q j) '' W j, κ ((chartAt E3 (q j)).symm z) ∈ B := by
      rintro _ ⟨w, hw, rfl⟩; rw [(chartAt E3 (q j)).left_inv (hW'q hw)]; exact hWB ⟨w, hw, rfl⟩
    have hKc : ∀ z ∈ chartAt E3 (q j) '' W j,
        z ∈ chartAt E3 (q j) '' (K ∩ (chartAt E3 (q j)).source) →
        ∃ i, φ i (κ ((chartAt E3 (q j)).symm z)) = 0 := by
      rintro _ ⟨w, hw, rfl⟩ ⟨x, hx, hxw⟩
      have hxw' : x = w := (chartAt E3 (q j)).injOn hx.2 (hW'q hw) hxw
