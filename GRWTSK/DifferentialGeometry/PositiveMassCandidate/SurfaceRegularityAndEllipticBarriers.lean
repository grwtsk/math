      exact h1 (hxw' ▸ hx.1)
    calc hullPerG (g.coeff (chartAt E3 (q j)).symm)
          (chartAt E3 (q j) '' (E ∩ (chartAt E3 (q j)).source)) (chartAt E3 (q j) '' W j)
          (chartAt E3 (q j) '' (K ∩ (chartAt E3 (q j)).source))
        ≤ ∑ s : Fin k → Bool, sepPerG (g.coeff (chartAt E3 (q j)).symm)
