        rfl
      have hfd : ContDiffOn ℝ ∞ (fderiv ℝ (fun z => φ.symm ((chartAt E3 x₀).symm z)))
          ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' φ.target) :=
        ((contDiffOn_infty_iff_fderiv_of_isOpen hW₁).1 hτ).2
      have hcomp : ∀ (k a : Fin 3), ContDiffOn ℝ ∞ (fun z => EuclideanSpace.proj a
          (fderiv ℝ (fun z => φ.symm ((chartAt E3 x₀).symm z)) z (e k)))
          ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' φ.target) := by
        intro k a
        have h2 : ContDiffOn ℝ ∞
            (fun z => fderiv ℝ (fun z => φ.symm ((chartAt E3 x₀).symm z)) z (e k))
            ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' φ.target) :=
          hfd.clm_apply contDiffOn_const
        exact (EuclideanSpace.proj a : E3 →L[ℝ] ℝ).contDiff.comp_contDiffOn h2
      have hHτ : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun z => H (φ.symm ((chartAt E3 x₀).symm z)) a b)
          ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' φ.target) := fun a b =>
        (hH a b).comp_contDiffOn hτ
      have hF : ContDiffOn ℝ ∞ (fun z => t * ∑ a : Fin 3, ∑ b : Fin 3,
          EuclideanSpace.proj a (fderiv ℝ (fun z => φ.symm ((chartAt E3 x₀).symm z)) z (e i)) *
            H (φ.symm ((chartAt E3 x₀).symm z)) a b *
            EuclideanSpace.proj b (fderiv ℝ (fun z => φ.symm ((chartAt E3 x₀).symm z)) z (e j)))
          ((chartAt E3 x₀).target ∩ (chartAt E3 x₀).symm ⁻¹' φ.target) :=
        contDiffOn_const.mul (ContDiffOn.sum fun a _ => ContDiffOn.sum fun b _ =>
          ((hcomp i a).mul (hHτ a b)).mul (hcomp j b))
      refine (hF.mono Set.inter_subset_right).congr fun z hz => ?_
      rw [hPev _ hz.2.2, hder z hz.2 (e i), hder z hz.2 (e j), Finset.mul_sum]
      refine Finset.sum_congr rfl fun a _ => ?_
      rw [Finset.mul_sum]
      refine Finset.sum_congr rfl fun b _ => ?_
      ring
    · refine ⟨_, hW₂, ⟨hy, fun hmem => hyt (hφKt hmem)⟩, ?_⟩
      refine (contDiffOn_const (c := (0 : ℝ))).congr fun z hz => ?_
      rw [hPoff _ hz.2.2]
      rfl
  
  have hsym : ∀ x (v w : E3), (fun p => g.g p + P p) x v w = (fun p => g.g p + P p) x w v := by
    intro x v w
    simp only [ContinuousLinearMap.add_apply]
    rw [g.symm x v w, hPsymm x v w]
  have hpd : ∀ x (v : E3), v ≠ 0 → 0 < (fun p => g.g p + P p) x v v := by
    intro x v hv
    simp only [ContinuousLinearMap.add_apply]
    have h1 := (abs_le.1 (hPb x v)).1
    have h2 := g.posDef x v hv
    linarith
  refine ⟨⟨fun p => g.g p + P p, hsym, hpd, hsm⟩, ?_, ?_, ?_⟩
  · intro p hp
    show g.g p + P p = g.g p
    rw [hPoff p hp, add_zero]
  · intro y hy
    ext i j
    have hpt : φ y ∈ φ.target := φ.toPartialEquiv.map_source hy
    have hsy : φ.symm (φ y) = y := φ.toPartialEquiv.left_inv hy
    have hc : P (φ y) (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y (e i))
        (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) φ y (e j)) = t * H y i j := by
      rw [hPev _ hpt, inv1 y hy, inv1 y hy, hsy]
      fin_cases i <;> fin_cases j <;>
        simp [Fin.sum_univ_three, hproj, EuclideanSpace.single_apply]
    rw [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul, ← hc]
    show (g.g (φ y) + P (φ y)) _ _ = _
    rw [ContinuousLinearMap.add_apply, ContinuousLinearMap.add_apply]
    rfl
  · intro p ξ
    show (1 / 2 : ℝ) * g.g p ξ ξ ≤ (g.g p + P p) ξ ξ ∧ (g.g p + P p) ξ ξ ≤ 2 * g.g p ξ ξ
    rw [ContinuousLinearMap.add_apply, ContinuousLinearMap.add_apply]
    have h1 := abs_le.1 (hPb p ξ)
    have h2 := hgnn p ξ
    constructor <;> linarith [h1.1, h1.2]

theorem local_geometry_contDiffOn (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (f : E3 → ℝ) (U : Set E3)
    (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hdet : ∀ y ∈ U, (G y).det ≠ 0) (hf : ContDiffOn ℝ ∞ f U) :
    (∀ k i j : Fin 3, ContDiffOn ℝ ∞ (christoffel G k i j) U) ∧
    (∀ i j : Fin 3, ContDiffOn ℝ ∞ (ricci G i j) U) ∧
    ContDiffOn ℝ ∞ (scalarCurvatureLocal G) U ∧
    (∀ i j : Fin 3, ContDiffOn ℝ ∞ (staticSymLoc G f i j) U) :=
by
  classical
  
  have hpd : ∀ h : E3 → ℝ, ContDiffOn ℝ ∞ h U → ∀ c : Fin 3,
      ContDiffOn ℝ ∞ (partialDeriv c h) U := by
    intro h hh c
    have hD := ((contDiffOn_infty_iff_fderiv_of_isOpen hU).mp hh).2
    show ContDiffOn ℝ ∞ (fun y => fderiv ℝ h y (e c)) U
    exact hD.clm_apply contDiffOn_const
  
  have hdetgen : ∀ F : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => F z i j) U) →
      ContDiffOn ℝ ∞ (fun z => (F z).det) U := by
    intro F hF
    simp only [Matrix.det_apply]
    refine ContDiffOn.sum (fun σ _ => ?_)
    simp only [Units.smul_def, zsmul_eq_mul]
    refine contDiffOn_const.mul ?_
    have hp := contDiffOn_prod' (t := (Finset.univ : Finset (Fin 3)))
      (f := fun i z => F z (σ i) i) (s := U) (n := ∞) (fun i _ => hF _ _)
    refine hp.congr (fun z _ => ?_)
    simp [Finset.prod_apply]
  have hadj : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => (G z).adjugate i j) U := by
    intro i j
    simp only [Matrix.adjugate_apply]
    refine hdetgen (fun z => (G z).updateRow j (Pi.single i 1)) ?_
    intro a b
    by_cases hab : a = j
    · subst hab
      simp only [Matrix.updateRow_self]
      exact contDiffOn_const
    · simp only [Matrix.updateRow_ne hab]
      exact hG a b
  have hinv : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => (G z)⁻¹ i j) U := by
    intro i j
    have heq : (fun z => (G z)⁻¹ i j) =
        fun z => ((G z).det)⁻¹ * (G z).adjugate i j := by
      funext z
      rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
    rw [heq]
    exact ((hdetgen _ hG).inv hdet).mul (hadj i j)
  have hpar : ∀ a b c : Fin 3,
      ContDiffOn ℝ ∞ (fun y => partialDeriv c (fun z => G z a b) y) U :=
    fun a b c => hpd _ (hG a b) c
  
  have hΓ : ∀ k i j : Fin 3, ContDiffOn ℝ ∞ (christoffel G k i j) U := by
    intro k i j
    show ContDiffOn ℝ ∞ (fun y => christoffel G k i j y) U
    unfold christoffel
    exact contDiffOn_const.mul (ContDiffOn.sum (fun l _ =>
      (hinv k l).mul (((hpar j l i).add (hpar i l j)).sub (hpar i j l))))
  
  have hRic : ∀ j k : Fin 3, ContDiffOn ℝ ∞ (ricci G j k) U := by
    intro j k
    show ContDiffOn ℝ ∞ (fun y => ricci G j k y) U
    unfold ricci
    refine (ContDiffOn.sum (fun i _ => ?_)).add
      (ContDiffOn.sum (fun i _ => ContDiffOn.sum (fun p _ =>
        ((hΓ i i p).mul (hΓ p j k)).sub ((hΓ i j p).mul (hΓ p i k)))))
    exact (hpd _ (hΓ i j k) i).sub (hpd _ (hΓ i i k) j)
  
  have hScal : ContDiffOn ℝ ∞ (scalarCurvatureLocal G) U := by
    show ContDiffOn ℝ ∞ (fun y => scalarCurvatureLocal G y) U
    unfold scalarCurvatureLocal
    exact ContDiffOn.sum (fun j _ => ContDiffOn.sum (fun k _ => (hinv j k).mul (hRic j k)))
  
  have hdf : ∀ j : Fin 3, ContDiffOn ℝ ∞ (partialDeriv j f) U := fun j => hpd f hf j
  have hHess : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (hessLoc G f i j) U := by
    intro i j
    show ContDiffOn ℝ ∞ (fun y => hessLoc G f i j y) U
    unfold hessLoc
    exact (hpd _ (hdf j) i).sub (ContDiffOn.sum (fun k _ => (hΓ k i j).mul (hdf k)))
  have hLap : ContDiffOn ℝ ∞ (lapLoc G f) U := by
    show ContDiffOn ℝ ∞ (fun y => lapLoc G f y) U
    unfold lapLoc
    exact ContDiffOn.sum (fun i _ => ContDiffOn.sum (fun j _ => (hinv i j).mul (hHess i j)))
  have hSt : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (staticLoc G f i j) U := by
    intro i j
    show ContDiffOn ℝ ∞ (fun y => staticLoc G f i j y) U
    unfold staticLoc
    exact ((hf.mul (hRic i j)).sub (hHess i j)).add (hLap.mul (hG i j))
  have hSym : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (staticSymLoc G f i j) U := by
    intro i j
    show ContDiffOn ℝ ∞ (fun y => staticSymLoc G f i j y) U
    unfold staticSymLoc
    exact ((hSt i j).add (hSt j i)).div_const 2
  exact ⟨hΓ, hRic, hScal, hSym⟩

theorem scalarCurvature_of_local_deformation [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g h : RiemannianMetric3 M) (φ : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞)
    (K : Set E3) (hK : IsCompact K) (hKφ : K ⊆ φ.source) (H : E3 → Matrix (Fin 3) (Fin 3) ℝ)
    (t : ℝ) (hh : ∀ p : M, p ∉ φ '' K → h.g p = g.g p)
    (hcoeff : ∀ y ∈ φ.source, h.coeff φ y = g.coeff φ y + t • H y) :
    ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ h.scalarCurvature ∧
    (∀ p : M, p ∉ φ '' K → h.scalarCurvature p = g.scalarCurvature p) ∧
    (∀ y ∈ φ.source, h.scalarCurvature (φ y) =
      scalarCurvatureLocal (fun z => g.coeff φ z + t • H z) y) :=
by
  
  have hloc : ∀ (G G' : E3 → Matrix (Fin 3) (Fin 3) ℝ) (y : E3), G =ᶠ[𝓝 y] G' →
      scalarCurvatureLocal G y = scalarCurvatureLocal G' y := by
    intro G G' y hGG
    have hpd : ∀ (z : E3) (f f' : E3 → ℝ), f =ᶠ[𝓝 z] f' →
        ∀ m, partialDeriv m f z = partialDeriv m f' z := by
      intro z f f' hf m
      unfold partialDeriv
      rw [hf.fderiv_eq]
    have hchr : ∀ z, G =ᶠ[𝓝 z] G' → ∀ k i j, christoffel G k i j z = christoffel G' k i j z := by
      intro z hz k i j
      have h0 : G z = G' z := hz.eq_of_nhds
      have hent : ∀ a b m, partialDeriv m (fun w => G w a b) z =
          partialDeriv m (fun w => G' w a b) z :=
        fun a b m => hpd z _ _ (hz.mono fun w hw => by simp only [hw]) m
      unfold christoffel
      simp only [h0, hent]
    have hchrev : ∀ k i j, christoffel G k i j =ᶠ[𝓝 y] christoffel G' k i j := fun k i j =>
      hGG.eventuallyEq_nhds.mono fun z hz => hchr z hz k i j
    have hP : ∀ a b c m, partialDeriv m (christoffel G a b c) y =
        partialDeriv m (christoffel G' a b c) y :=
      fun a b c m => hpd y _ _ (hchrev a b c) m
    have hV : ∀ a b c, christoffel G a b c y = christoffel G' a b c y :=
      fun a b c => (hchrev a b c).eq_of_nhds
    have hric : ∀ j k, ricci G j k y = ricci G' j k y := by
      intro j k
      unfold ricci
      simp only [hP, hV]
    have hGy : G y = G' y := hGG.eq_of_nhds
    unfold scalarCurvatureLocal
    simp only [hGy, hric]
  
  have hsmooth : ∀ g' : RiemannianMetric3 M,
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ g'.scalarCurvature := by
    intro g' x₀
    let c := chartAt E3 x₀
    let Φc : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
      PartialDiffeomorph.mk c.symm.toPartialEquiv c.open_target c.open_source
        contMDiffOn_chart_symm contMDiffOn_chart
    have hform : ∀ y ∈ c.target,
        g'.scalarCurvature (c.symm y) = scalarCurvatureLocal (g'.coeff c.symm) y :=
      fun y hy => scalarCurvature_eq_scalarCurvatureLocal_coeff g' Φc y hy
    have hloc_sm : ContDiffOn ℝ ∞ (scalarCurvatureLocal (g'.coeff c.symm)) c.target :=
      (local_geometry_contDiffOn (g'.coeff c.symm) (fun _ => (0 : ℝ)) c.target c.open_target
        (fun i j => g'.smooth x₀ i j)
        (fun y hy => (coeff_chart_symm_posDef g' x₀ y hy).det_pos.ne') contDiffOn_const).2.2.1
    have hF : ContDiffOn ℝ ∞ (fun y => g'.scalarCurvature (c.symm y)) c.target :=
      hloc_sm.congr fun y hy => hform y hy
    have hFM : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun y => g'.scalarCurvature (c.symm y)) c.target :=
      contMDiffOn_iff_contDiffOn.mpr hF
    have hcomp : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞
        ((fun y => g'.scalarCurvature (c.symm y)) ∘ c) c.source :=
      hFM.comp contMDiffOn_chart (fun x hx => c.map_source hx)
    have hR : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ g'.scalarCurvature c.source :=
      hcomp.congr fun x hx => by simp only [Function.comp, c.left_inv hx]
    exact hR.contMDiffAt (chart_source_mem_nhds E3 x₀)
  refine ⟨hsmooth h, ?_, ?_⟩
  · intro p hp
    have hcl : IsClosed (φ '' K) :=
      (hK.image_of_continuousOn (φ.contMDiffOn_toFun.continuousOn.mono hKφ)).isClosed
    let c := chartAt E3 p
    have hO : (φ '' K)ᶜ ∈ 𝓝 (c.symm (c p)) := by
      rw [c.left_inv (mem_chart_source E3 p)]
      exact hcl.isOpen_compl.mem_nhds hp
    have hN : c.symm ⁻¹' (φ '' K)ᶜ ∈ 𝓝 (c p) :=
      (c.continuousAt_symm (mem_chart_target E3 p)).preimage_mem_nhds hO
    have hev : h.coeff c.symm =ᶠ[𝓝 (c p)] g.coeff c.symm := by
      filter_upwards [hN] with z hz
      have hz' := hh (c.symm z) hz
      unfold RiemannianMetric3.coeff coeffMatrix
      rw [hz']
    show scalarCurvatureLocal (h.coeff c.symm) (c p) = scalarCurvatureLocal (g.coeff c.symm) (c p)
    exact hloc _ _ _ hev
  · intro y hy
    rw [scalarCurvature_eq_scalarCurvatureLocal_coeff h φ y hy]
    apply hloc
    filter_upwards [φ.open_source.mem_nhds hy] with z hz
    exact hcoeff z hz

theorem sqrt_det_perturbation (G H : E3 → Matrix (Fin 3) (Fin 3) ℝ) (K : Set E3) (hK : IsCompact K)
    (hGc : ∀ i j : Fin 3, ContinuousOn (fun y => G y i j) K)
    (hHc : ∀ i j : Fin 3, ContinuousOn (fun y => H y i j) K)
    (hGpos : ∀ y ∈ K, 0 < (G y).det) :
    ∃ t₁ C : ℝ, 0 < t₁ ∧ t₁ ≤ 1 ∧ 0 ≤ C ∧ ∀ t : ℝ, |t| ≤ t₁ →
      ContinuousOn (fun y => Real.sqrt (G y + t • H y).det) K ∧
      (∀ i j : Fin 3, ContinuousOn (fun y => (G y + t • H y)⁻¹ i j) K) ∧
      ∀ y ∈ K, 0 < (G y + t • H y).det ∧ Real.sqrt (G y + t • H y).det ≤ C ∧
        |Real.sqrt (G y + t • H y).det - Real.sqrt (G y).det| ≤ C * |t| ∧
        ∀ i j : Fin 3, |(G y + t • H y)⁻¹ i j * Real.sqrt (G y + t • H y).det -
            (G y)⁻¹ i j * Real.sqrt (G y).det| ≤ C * |t| :=
by
  classical
  
  have trip : ∀ x1 x2 x3 y1 y2 y3 L δ : ℝ, 0 ≤ L → |x1| ≤ L → |x2| ≤ L → |x3| ≤ L →
      |y1| ≤ L → |y2| ≤ L → |y3| ≤ L → |x1 - y1| ≤ δ → |x2 - y2| ≤ δ → |x3 - y3| ≤ δ →
      |x1 * x2 * x3 - y1 * y2 * y3| ≤ 3 * L ^ 2 * δ ∧ |x1 * x2 * x3| ≤ L ^ 3 := by
    intro x1 x2 x3 y1 y2 y3 L δ hL hx1 hx2 hx3 hy1 hy2 hy3 h1 h2 h3
    have hδ : 0 ≤ δ := (abs_nonneg _).trans h1
    have e : x1 * x2 * x3 - y1 * y2 * y3 =
        (x1 - y1) * x2 * x3 + y1 * (x2 - y2) * x3 + y1 * y2 * (x3 - y3) := by ring
    constructor
    · rw [e]
      refine (abs_add_three _ _ _).trans ?_
      simp only [abs_mul]
      have a1 : |x1 - y1| * |x2| * |x3| ≤ δ * L * L :=
        mul_le_mul (mul_le_mul h1 hx2 (abs_nonneg _) hδ) hx3 (abs_nonneg _) (mul_nonneg hδ hL)
      have a2 : |y1| * |x2 - y2| * |x3| ≤ L * δ * L :=
        mul_le_mul (mul_le_mul hy1 h2 (abs_nonneg _) hL) hx3 (abs_nonneg _) (mul_nonneg hL hδ)
      have a3 : |y1| * |y2| * |x3 - y3| ≤ L * L * δ :=
        mul_le_mul (mul_le_mul hy1 hy2 (abs_nonneg _) hL) h3 (abs_nonneg _) (mul_nonneg hL hL)
      nlinarith
    · simp only [abs_mul]
      calc |x1| * |x2| * |x3| ≤ L * L * L :=
            mul_le_mul (mul_le_mul hx1 hx2 (abs_nonneg _) hL) hx3 (abs_nonneg _) (mul_nonneg hL hL)
        _ = L ^ 3 := by ring
  
  have det3 : ∀ (X Y : Matrix (Fin 3) (Fin 3) ℝ) (L δ : ℝ), 0 ≤ L → (∀ i j, |X i j| ≤ L) →
      (∀ i j, |Y i j| ≤ L) → (∀ i j, |X i j - Y i j| ≤ δ) →
      |X.det - Y.det| ≤ 18 * L ^ 2 * δ ∧ |X.det| ≤ 6 * L ^ 3 := by
    intro X Y L δ hL hX hY hXY
    rw [Matrix.det_fin_three, Matrix.det_fin_three]
    obtain ⟨a1, b1⟩ := trip (X 0 0) (X 1 1) (X 2 2) (Y 0 0) (Y 1 1) (Y 2 2) L δ hL (hX _ _)
      (hX _ _) (hX _ _) (hY _ _) (hY _ _) (hY _ _) (hXY _ _) (hXY _ _) (hXY _ _)
    obtain ⟨a2, b2⟩ := trip (X 0 0) (X 1 2) (X 2 1) (Y 0 0) (Y 1 2) (Y 2 1) L δ hL (hX _ _)
      (hX _ _) (hX _ _) (hY _ _) (hY _ _) (hY _ _) (hXY _ _) (hXY _ _) (hXY _ _)
    obtain ⟨a3, b3⟩ := trip (X 0 1) (X 1 0) (X 2 2) (Y 0 1) (Y 1 0) (Y 2 2) L δ hL (hX _ _)
      (hX _ _) (hX _ _) (hY _ _) (hY _ _) (hY _ _) (hXY _ _) (hXY _ _) (hXY _ _)
    obtain ⟨a4, b4⟩ := trip (X 0 1) (X 1 2) (X 2 0) (Y 0 1) (Y 1 2) (Y 2 0) L δ hL (hX _ _)
      (hX _ _) (hX _ _) (hY _ _) (hY _ _) (hY _ _) (hXY _ _) (hXY _ _) (hXY _ _)
    obtain ⟨a5, b5⟩ := trip (X 0 2) (X 1 0) (X 2 1) (Y 0 2) (Y 1 0) (Y 2 1) L δ hL (hX _ _)
      (hX _ _) (hX _ _) (hY _ _) (hY _ _) (hY _ _) (hXY _ _) (hXY _ _) (hXY _ _)
    obtain ⟨a6, b6⟩ := trip (X 0 2) (X 1 1) (X 2 0) (Y 0 2) (Y 1 1) (Y 2 0) L δ hL (hX _ _)
      (hX _ _) (hX _ _) (hY _ _) (hY _ _) (hY _ _) (hXY _ _) (hXY _ _) (hXY _ _)
    rw [abs_le] at a1 a2 a3 a4 a5 a6 b1 b2 b3 b4 b5 b6
    constructor
    · rw [abs_le]; constructor <;> linarith
    · rw [abs_le]; constructor <;> linarith
  
  have adj3 : ∀ (X Y : Matrix (Fin 3) (Fin 3) ℝ) (L δ : ℝ), 1 ≤ L → 0 ≤ δ →
      (∀ i j, |X i j| ≤ L) → (∀ i j, |Y i j| ≤ L) → (∀ i j, |X i j - Y i j| ≤ δ) →
      ∀ i j, |X.adjugate i j - Y.adjugate i j| ≤ 18 * L ^ 2 * δ ∧
        |X.adjugate i j| ≤ 6 * L ^ 3 := by
    intro X Y L δ hL hδ hX hY hXY i j
    rw [Matrix.adjugate_apply, Matrix.adjugate_apply]
    have hs : ∀ k : Fin 3, |(Pi.single i (1 : ℝ) : Fin 3 → ℝ) k| ≤ L := by
      intro k
      by_cases hk : k = i
      · subst hk; rw [Pi.single_eq_same, abs_one]; exact hL
      · rw [Pi.single_eq_of_ne hk, abs_zero]; linarith
    apply det3 _ _ L δ (by linarith)
    · intro a b; rw [Matrix.updateRow_apply]; split_ifs
      · exact hs b
      · exact hX a b
    · intro a b; rw [Matrix.updateRow_apply]; split_ifs
      · exact hs b
      · exact hY a b
    · intro a b; rw [Matrix.updateRow_apply, Matrix.updateRow_apply]; split_ifs
      · rw [sub_self, abs_zero]; exact hδ
      · exact hXY a b
  
  have sq1 : ∀ a b s : ℝ, 0 < s → s ^ 2 ≤ a → s ^ 2 ≤ b →
      |Real.sqrt a - Real.sqrt b| ≤ |a - b| / s := by
    intro a b s hs ha hb
    have hsa : s ≤ Real.sqrt a := by
      have := Real.sqrt_le_sqrt ha; rwa [Real.sqrt_sq hs.le] at this
    have hsb : s ≤ Real.sqrt b := by
      have := Real.sqrt_le_sqrt hb; rwa [Real.sqrt_sq hs.le] at this
    have ha0 : 0 ≤ a := le_trans (sq_nonneg s) ha
    have hb0 : 0 ≤ b := le_trans (sq_nonneg s) hb
    have h1 := Real.mul_self_sqrt ha0
    have h2 := Real.mul_self_sqrt hb0
    have e : a - b = (Real.sqrt a - Real.sqrt b) * (Real.sqrt a + Real.sqrt b) := by
      linear_combination (-1 : ℝ) * h1 + h2
    have hpos : 0 < Real.sqrt a + Real.sqrt b := by linarith [Real.sqrt_nonneg b]
    have hge : s ≤ Real.sqrt a + Real.sqrt b := by linarith [Real.sqrt_nonneg b]
    rw [le_div_iff₀ hs, e, abs_mul, abs_of_pos hpos]
    exact mul_le_mul_of_nonneg_left hge (abs_nonneg _)
  have sq2 : ∀ a b s P Q : ℝ, 0 < s → s ^ 2 ≤ a → s ^ 2 ≤ b →
      |P / Real.sqrt a - Q / Real.sqrt b| ≤ |P - Q| / s + |Q| * |a - b| / s ^ 3 := by
    intro a b s P Q hs ha hb
    have hsa : s ≤ Real.sqrt a := by
      have := Real.sqrt_le_sqrt ha; rwa [Real.sqrt_sq hs.le] at this
    have hsb : s ≤ Real.sqrt b := by
      have := Real.sqrt_le_sqrt hb; rwa [Real.sqrt_sq hs.le] at this
    have hra : 0 < Real.sqrt a := lt_of_lt_of_le hs hsa
    have hrb : 0 < Real.sqrt b := lt_of_lt_of_le hs hsb
    have hra' := hra.ne'
    have hrb' := hrb.ne'
    have e : P / Real.sqrt a - Q / Real.sqrt b = (P - Q) / Real.sqrt a +
        Q * (Real.sqrt b - Real.sqrt a) / (Real.sqrt a * Real.sqrt b) := by
      field_simp
      ring
    rw [e]
    refine (abs_add_le _ _).trans (add_le_add ?_ ?_)
    · rw [abs_div, abs_of_pos hra]
      exact div_le_div_of_nonneg_left (abs_nonneg _) hs hsa
    · rw [abs_div, abs_mul, abs_of_pos (mul_pos hra hrb), abs_sub_comm]
      have h1 := sq1 a b s hs ha hb
      have h2 : s ^ 2 ≤ Real.sqrt a * Real.sqrt b := by
        rw [sq]; exact mul_le_mul hsa hsb hs.le hra.le
      calc |Q| * |Real.sqrt a - Real.sqrt b| / (Real.sqrt a * Real.sqrt b)
          ≤ |Q| * |Real.sqrt a - Real.sqrt b| / s ^ 2 :=
            div_le_div_of_nonneg_left (mul_nonneg (abs_nonneg _) (abs_nonneg _)) (by positivity) h2
        _ ≤ |Q| * (|a - b| / s) / s ^ 2 :=
            div_le_div_of_nonneg_right (mul_le_mul_of_nonneg_left h1 (abs_nonneg _)) (by positivity)
        _ = |Q| * |a - b| / s ^ 3 := by
            rw [mul_div_assoc', div_div]; ring
  
  have invq : ∀ X : Matrix (Fin 3) (Fin 3) ℝ, 0 < X.det → ∀ i j : Fin 3,
      X⁻¹ i j * Real.sqrt X.det = X.adjugate i j / Real.sqrt X.det := by
    intro X hX i j
    rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv']
    have hr : 0 < Real.sqrt X.det := Real.sqrt_pos.2 hX
    have hrr : Real.sqrt X.det * Real.sqrt X.det = X.det := Real.mul_self_sqrt hX.le
    obtain ⟨r, hrdef⟩ : ∃ r : ℝ, r = Real.sqrt X.det := ⟨_, rfl⟩
    rw [← hrdef] at hr hrr ⊢
    rw [← hrr]
    calc (r * r)⁻¹ * X.adjugate i j * r = X.adjugate i j * (r * r⁻¹) * r⁻¹ := by ring
      _ = X.adjugate i j / r := by rw [mul_inv_cancel₀ hr.ne', mul_one, div_eq_mul_inv]
  
  choose BG hBG using fun i j => hK.exists_bound_of_continuousOn (hGc i j)
  choose BH hBH using fun i j => hK.exists_bound_of_continuousOn (hHc i j)
  obtain ⟨M, hMdef⟩ : ∃ M : ℝ, M = ∑ i : Fin 3, ∑ j : Fin 3, (|BG i j| + |BH i j|) := ⟨_, rfl⟩
  have hMij : ∀ i j : Fin 3, |BG i j| + |BH i j| ≤ M := by
    intro i j
    have h1 : |BG i j| + |BH i j| ≤ ∑ j' : Fin 3, (|BG i j'| + |BH i j'|) :=
      Finset.single_le_sum (f := fun j' => |BG i j'| + |BH i j'|)
        (fun _ _ => add_nonneg (abs_nonneg _) (abs_nonneg _)) (Finset.mem_univ j)
    have h2 : ∑ j' : Fin 3, (|BG i j'| + |BH i j'|) ≤ M := by
      rw [hMdef]
      exact Finset.single_le_sum (f := fun i' => ∑ j' : Fin 3, (|BG i' j'| + |BH i' j'|))
        (fun _ _ => Finset.sum_nonneg fun _ _ => add_nonneg (abs_nonneg _) (abs_nonneg _))
        (Finset.mem_univ i)
    linarith
  have hM : 0 ≤ M := le_trans (add_nonneg (abs_nonneg _) (abs_nonneg _)) (hMij 0 0)
  have hGb : ∀ y ∈ K, ∀ i j : Fin 3, |G y i j| ≤ M := by
    intro y hy i j
    have h := hBG i j y hy
    rw [Real.norm_eq_abs] at h
    linarith [le_abs_self (BG i j), hMij i j, abs_nonneg (BH i j)]
  have hHb : ∀ y ∈ K, ∀ i j : Fin 3, |H y i j| ≤ M := by
    intro y hy i j
    have h := hBH i j y hy
    rw [Real.norm_eq_abs] at h
    linarith [le_abs_self (BH i j), hMij i j, abs_nonneg (BG i j)]
  have hGcK : ContinuousOn G K := continuousOn_pi.2 fun i => continuousOn_pi.2 fun j => hGc i j
  have hdetc : ContinuousOn (fun y => (G y).det) K :=
    (continuous_id.matrix_det).comp_continuousOn hGcK
  obtain ⟨m, hm, hmK⟩ : ∃ m : ℝ, 0 < m ∧ ∀ y ∈ K, m ≤ (G y).det := by
    rcases K.eq_empty_or_nonempty with he | hne
    · exact ⟨1, one_pos, fun y hy => by simp [he] at hy⟩
    · obtain ⟨y0, hy0, hmin⟩ := hK.exists_isMinOn hne hdetc
      exact ⟨(G y0).det, hGpos y0 hy0, fun y hy => (isMinOn_iff.1 hmin) y hy⟩
  
  obtain ⟨L, hLdef⟩ : ∃ L : ℝ, L = 2 * M + 1 := ⟨_, rfl⟩
  have hL1 : 1 ≤ L := by rw [hLdef]; linarith
  have hL0 : 0 ≤ L := by linarith
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ, D = 18 * L ^ 2 * M := ⟨_, rfl⟩
  have hD : 0 ≤ D := by rw [hDdef]; positivity
  obtain ⟨s, hsdef⟩ : ∃ s : ℝ, s = Real.sqrt (m / 2) := ⟨_, rfl⟩
  have hs : 0 < s := by rw [hsdef]; exact Real.sqrt_pos.2 (half_pos hm)
  have hs2 : s ^ 2 = m / 2 := by rw [hsdef]; exact Real.sq_sqrt (half_pos hm).le
  obtain ⟨C, hCdef⟩ : ∃ C : ℝ, C = 1 + 6 * L ^ 3 + 2 * (D / s) + 6 * L ^ 3 * (D / s ^ 3) :=
    ⟨_, rfl⟩
  have hDs : 0 ≤ D / s := div_nonneg hD hs.le
  have hDs3 : 0 ≤ 6 * L ^ 3 * (D / s ^ 3) := by positivity
  have hL3 : 0 ≤ 6 * L ^ 3 := by positivity
  have hC : 0 ≤ C := by rw [hCdef]; linarith
  have hD2 : 0 < 2 * (D + 1) := by linarith
  refine ⟨min 1 (m / (2 * (D + 1))), C, lt_min one_pos (div_pos hm hD2), min_le_left _ _, hC, ?_⟩
  intro t ht
  have ht1 : |t| ≤ 1 := ht.trans (min_le_left _ _)
  have ht2 : |t| ≤ m / (2 * (D + 1)) := ht.trans (min_le_right _ _)
  have htD : D * |t| ≤ m / 2 := by
    have h := (le_div_iff₀ hD2).1 ht2
    nlinarith [abs_nonneg t]
  have hat : 0 ≤ |t| := abs_nonneg t
  have hδ : 0 ≤ M * |t| := mul_nonneg hM hat
  have hAe : ∀ y i j, (G y + t • H y) i j = G y i j + t * H y i j := by
    intro y i j; simp [Matrix.add_apply, Matrix.smul_apply]
  have key : ∀ y ∈ K, 0 < (G y + t • H y).det ∧ Real.sqrt (G y + t • H y).det ≤ C ∧
      |Real.sqrt (G y + t • H y).det - Real.sqrt (G y).det| ≤ C * |t| ∧
      ∀ i j : Fin 3, |(G y + t • H y)⁻¹ i j * Real.sqrt (G y + t • H y).det -
          (G y)⁻¹ i j * Real.sqrt (G y).det| ≤ C * |t| := by
    intro y hy
    have hGL : ∀ i j, |G y i j| ≤ L := fun i j => by linarith [hGb y hy i j]
    have hAL : ∀ i j, |(G y + t • H y) i j| ≤ L := by
      intro i j
      rw [hAe]
      have h1 : |t * H y i j| ≤ 1 * M := by
        rw [abs_mul]; exact mul_le_mul ht1 (hHb y hy i j) (abs_nonneg _) zero_le_one
      have h2 := abs_add_le (G y i j) (t * H y i j)
      linarith [hGb y hy i j]
    have hAd : ∀ i j, |(G y + t • H y) i j - G y i j| ≤ M * |t| := by
      intro i j
      rw [hAe, add_sub_cancel_left, abs_mul, mul_comm]
      exact mul_le_mul_of_nonneg_right (hHb y hy i j) hat
    obtain ⟨hdd, hdA⟩ := det3 _ _ L (M * |t|) hL0 hAL hGL hAd
    have hdd' : |(G y + t • H y).det - (G y).det| ≤ D * |t| := by
      rw [hDdef]; linarith
    have hb : m ≤ (G y).det := hmK y hy
    have hpos : m / 2 ≤ (G y + t • H y).det := by
      have := (abs_le.1 hdd').1
      linarith
    have hApos : 0 < (G y + t • H y).det := by linarith
    have hsa : s ^ 2 ≤ (G y + t • H y).det := by rw [hs2]; exact hpos
    have hsb : s ^ 2 ≤ (G y).det := by rw [hs2]; linarith
    refine ⟨hApos, ?_, ?_, ?_⟩
    · have h1 : (G y + t • H y).det ≤ (1 + 6 * L ^ 3) ^ 2 := by
        have := le_abs_self (G y + t • H y).det
        nlinarith
      have h2 := Real.sqrt_le_sqrt h1
      rw [Real.sqrt_sq (by linarith)] at h2
      rw [hCdef]; linarith
    · have h1 := sq1 _ _ s hs hsa hsb
      have h2 : |(G y + t • H y).det - (G y).det| / s ≤ D * |t| / s :=
        div_le_div_of_nonneg_right hdd' hs.le
      have h3 : D * |t| / s = (D / s) * |t| := by ring
      have h4 : D / s ≤ C := by rw [hCdef]; linarith
      have h5 : (D / s) * |t| ≤ C * |t| := mul_le_mul_of_nonneg_right h4 hat
      linarith
    · intro i j
      rw [invq _ hApos i j, invq _ (hGpos y hy) i j]
      have h1 := sq2 _ _ s ((G y + t • H y).adjugate i j) ((G y).adjugate i j) hs hsa hsb
      obtain ⟨hPQ, -⟩ := adj3 _ _ L (M * |t|) hL1 hδ hAL hGL hAd i j
      obtain ⟨-, hQ⟩ := adj3 (G y) (G y) L 0 hL1 le_rfl hGL hGL
        (fun a b => by rw [sub_self, abs_zero]) i j
      have hPQ' : |(G y + t • H y).adjugate i j - (G y).adjugate i j| ≤ D * |t| := by
        rw [hDdef]; linarith
      have h2 : |(G y + t • H y).adjugate i j - (G y).adjugate i j| / s ≤ D * |t| / s :=
        div_le_div_of_nonneg_right hPQ' hs.le
      have h3 : |(G y).adjugate i j| * |(G y + t • H y).det - (G y).det| / s ^ 3 ≤
          6 * L ^ 3 * (D * |t|) / s ^ 3 :=
        div_le_div_of_nonneg_right (mul_le_mul hQ hdd' (abs_nonneg _) hL3) (by positivity)
      have h4 : D * |t| / s + 6 * L ^ 3 * (D * |t|) / s ^ 3 =
          (D / s + 6 * L ^ 3 * (D / s ^ 3)) * |t| := by ring
      have h5 : D / s + 6 * L ^ 3 * (D / s ^ 3) ≤ C := by rw [hCdef]; linarith
      have h6 := mul_le_mul_of_nonneg_right h5 hat
      linarith
  
  have hAc : ∀ i j, ContinuousOn (fun y => (G y + t • H y) i j) K := by
    intro i j
    have : ContinuousOn (fun y => G y i j + t * H y i j) K :=
      (hGc i j).add (continuousOn_const.mul (hHc i j))
    exact this.congr (fun y _ => hAe y i j)
  have hAcK : ContinuousOn (fun y => G y + t • H y) K :=
    continuousOn_pi.2 fun i => continuousOn_pi.2 fun j => hAc i j
  have hdetAc : ContinuousOn (fun y => (G y + t • H y).det) K :=
    (continuous_id.matrix_det).comp_continuousOn hAcK
  have hadjc : ContinuousOn (fun y => (G y + t • H y).adjugate) K :=
    (continuous_id.matrix_adjugate).comp_continuousOn hAcK
  refine ⟨hdetAc.sqrt, ?_, key⟩
  intro i j
  have h1 : ContinuousOn (fun y => (G y + t • H y).adjugate i j) K :=
    continuousOn_pi.1 (continuousOn_pi.1 hadjc i) j
  have h2 := hdetAc.inv₀ (fun y hy => (key y hy).1.ne')
  exact (h2.mul h1).congr (fun y _ => by
    rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv'])

theorem param_taylor_compact (Φ : ℝ × E3 → ℝ) (W : Set (ℝ × E3)) (hW : IsOpen W)
    (hΦ : ContDiffOn ℝ 2 Φ W) (K : Set E3) (hK : IsCompact K)
    (hKW : ∀ y ∈ K, ((0 : ℝ), y) ∈ W) :
    ∃ t₁ C : ℝ, 0 < t₁ ∧ 0 ≤ C ∧
      ContinuousOn (fun y => deriv (fun s => Φ (s, y)) 0) K ∧
      ∀ t : ℝ, |t| ≤ t₁ → ∀ y ∈ K, (t, y) ∈ W ∧
        |Φ (t, y) - Φ (0, y) - t * deriv (fun s => Φ (s, y)) 0| ≤ C * t ^ 2 :=
by
  classical
  
  have taylor2 : ∀ (f D D2 : ℝ → ℝ) (r M : ℝ),
      (∀ s ∈ Set.Icc (-r) r, HasDerivAt f (D s) s) →
      (∀ s ∈ Set.Icc (-r) r, HasDerivAt D (D2 s) s) →
      (∀ s ∈ Set.Icc (-r) r, |D2 s| ≤ M) →
      ∀ t : ℝ, |t| ≤ r → |f t - f 0 - t * D 0| ≤ M * t ^ 2 := by
    intro f D D2 r M hf hD hD2 t ht
    have hr : 0 ≤ r := (abs_nonneg t).trans ht
    have h0I : (0:ℝ) ∈ Set.Icc (-r) r := ⟨by linarith, hr⟩
    have htI : t ∈ Set.Icc (-r) r := abs_le.1 ht
    have hM : 0 ≤ M := (abs_nonneg _).trans (hD2 0 h0I)
    have h1 : ∀ s ∈ Set.Icc (-r) r, |D s - D 0| ≤ M * |s| := by
      intro s hs
      have := (convex_Icc (-r) r).norm_image_sub_le_of_norm_hasDerivWithin_le
        (f := D) (f' := D2) (C := M) (fun x hx => (hD x hx).hasDerivWithinAt)
        (fun x hx => by rw [Real.norm_eq_abs]; exact hD2 x hx) h0I hs
      rw [Real.norm_eq_abs, Real.norm_eq_abs, sub_zero] at this
      exact this
    have hJ : Set.uIcc 0 t ⊆ Set.Icc (-r) r := Set.uIcc_subset_Icc h0I htI
    have hg : ∀ s ∈ Set.uIcc 0 t, HasDerivWithinAt (fun s => f s - f 0 - s * D 0)
        (D s - D 0) (Set.uIcc 0 t) s := by
      intro s hs
      have h2 := ((hf s (hJ hs)).sub (hasDerivAt_const s (f 0))).sub
        ((hasDerivAt_id' s).mul_const (D 0))
      have h3 := h2.hasDerivWithinAt (s := Set.uIcc 0 t)
      convert h3 using 1
      ring
    have hgb : ∀ s ∈ Set.uIcc 0 t, ‖D s - D 0‖ ≤ M * |t| := by
      intro s hs
      rw [Real.norm_eq_abs]
      have h2 : |s| ≤ |t| := by
        have h3 := Set.abs_sub_left_of_mem_uIcc hs
        rw [sub_zero, sub_zero] at h3
        exact h3
      exact (h1 s (hJ hs)).trans (mul_le_mul_of_nonneg_left h2 hM)
    have hfin := (convex_uIcc (0:ℝ) t).norm_image_sub_le_of_norm_hasDerivWithin_le hg hgb
      Set.left_mem_uIcc Set.right_mem_uIcc
    simp only [Real.norm_eq_abs, sub_self, zero_mul, sub_zero] at hfin
    calc |f t - f 0 - t * D 0| ≤ M * |t| * |t| := hfin
      _ = M * t ^ 2 := by rw [mul_assoc, ← sq, sq_abs]
  
  have slice : ∀ {F : Type} [NormedAddCommGroup F] [NormedSpace ℝ F] (Ψ : ℝ × E3 → F)
      (s : ℝ) (y : E3), DifferentiableAt ℝ Ψ (s, y) →
      HasDerivAt (fun r : ℝ => Ψ (r, y)) (fderiv ℝ Ψ (s, y) ((1 : ℝ), (0 : E3))) s := by
    intro F _ _ Ψ s y h
    have hγ : HasDerivAt (fun r : ℝ => ((r, y) : ℝ × E3)) ((1 : ℝ), (0 : E3)) s :=
      (hasDerivAt_id' s).prodMk (hasDerivAt_const s y)
    exact h.hasFDerivAt.comp_hasDerivAt s hγ
  
  obtain ⟨u, v, hu, hv, h0u, hKv, huvW⟩ :=
    generalized_tube_lemma (isCompact_singleton (x := (0:ℝ))) hK hW (by
      rintro ⟨a, y⟩ ⟨ha, hy⟩
      obtain rfl : a = 0 := ha
      exact hKW y hy)
  obtain ⟨δ, hδ, hball⟩ := Metric.isOpen_iff.1 hu 0 (h0u (Set.mem_singleton 0))
  have hslab : ∀ t : ℝ, |t| ≤ δ / 2 → ∀ y ∈ K, (t, y) ∈ W := by
    intro t ht y hy
    apply huvW
    refine ⟨hball ?_, hKv hy⟩
    rw [Metric.mem_ball, Real.dist_eq, sub_zero]
    linarith
  
  have hΦ1 : ContDiffOn ℝ 1 (fun p => fderiv ℝ Φ p) W := hΦ.fderiv_of_isOpen hW (by norm_num)
  have hΦ2c : ContinuousOn (fun p => fderiv ℝ (fun q => fderiv ℝ Φ q) p) W :=
    hΦ1.continuousOn_fderiv_of_isOpen hW le_rfl
  have hΦ1c : ContinuousOn (fun p => fderiv ℝ Φ p) W :=
    hΦ.continuousOn_fderiv_of_isOpen hW (by norm_num)
  have hΦd : ∀ p ∈ W, DifferentiableAt ℝ Φ p := fun p hp =>
    (hΦ.differentiableOn (by norm_num)).differentiableAt (hW.mem_nhds hp)
  have hΦ1d : ∀ p ∈ W, DifferentiableAt ℝ (fun q => fderiv ℝ Φ q) p := fun p hp =>
    (hΦ1.differentiableOn (by norm_num)).differentiableAt (hW.mem_nhds hp)
  
  have ht₁ : 0 < δ / 2 := half_pos hδ
  have hLW : Set.Icc (-(δ / 2)) (δ / 2) ×ˢ K ⊆ W := by
    rintro ⟨t, y⟩ ⟨ht, hy⟩
    exact hslab t (abs_le.2 ht) y hy
  have hc2 := (hΦ1.continuousOn_fderiv_of_isOpen hW le_rfl).mono hLW
  obtain ⟨M, hM'⟩ := isBounded_iff_forall_norm_le.1
    ((isCompact_Icc.prod hK).image_of_continuousOn hc2).isBounded
  have hM : ∀ p ∈ Set.Icc (-(δ / 2)) (δ / 2) ×ˢ K,
      ‖fderiv ℝ (fun q => fderiv ℝ Φ q) p‖ ≤ M := fun p hp => hM' _ ⟨p, hp, rfl⟩
  have he₁n : ‖((1 : ℝ), (0 : E3))‖ = 1 := by simp [Prod.norm_def]
  
  have hderiv0 : ∀ y ∈ K,
      deriv (fun s => Φ (s, y)) 0 = fderiv ℝ Φ (0, y) ((1 : ℝ), (0 : E3)) :=
    fun y hy => (slice Φ 0 y (hΦd _ (hKW y hy))).deriv
  refine ⟨δ / 2, max M 0, ht₁, le_max_right _ _, ?_, ?_⟩
  · have hc : ContinuousOn (fun y : E3 => fderiv ℝ Φ ((0:ℝ), y)) K :=
      hΦ1c.comp (continuous_const.prodMk continuous_id).continuousOn (fun y hy => hKW y hy)
    exact (hc.clm_apply continuousOn_const).congr hderiv0
  
  · intro t ht y hy
    refine ⟨hslab t ht y hy, ?_⟩
    rw [hderiv0 y hy]
    refine taylor2 (fun s => Φ (s, y)) (fun s => fderiv ℝ Φ (s, y) ((1 : ℝ), (0 : E3)))
      (fun s => fderiv ℝ (fun q => fderiv ℝ Φ q) (s, y) ((1 : ℝ), (0 : E3)) ((1 : ℝ), (0 : E3)))
      (δ / 2) (max M 0) ?_ ?_ ?_ t ht
    · intro s hs
      exact slice Φ s y (hΦd _ (hLW ⟨hs, hy⟩))
    · intro s hs
      have h1 := slice (fun q => fderiv ℝ Φ q) s y (hΦ1d _ (hLW ⟨hs, hy⟩))
      have h2 := h1.clm_apply (hasDerivAt_const s ((1 : ℝ), (0 : E3)))
      convert h2 using 1
      rw [map_zero, add_zero]
    · intro s hs
      have h1 := hM (s, y) ⟨hs, hy⟩
      calc |fderiv ℝ (fun q => fderiv ℝ Φ q) (s, y) ((1 : ℝ), (0 : E3)) ((1 : ℝ), (0 : E3))|
          = ‖fderiv ℝ (fun q => fderiv ℝ Φ q) (s, y) ((1 : ℝ), (0 : E3))
              ((1 : ℝ), (0 : E3))‖ := (Real.norm_eq_abs _).symm
        _ ≤ ‖fderiv ℝ (fun q => fderiv ℝ Φ q) (s, y)‖ * ‖((1 : ℝ), (0 : E3))‖ *
              ‖((1 : ℝ), (0 : E3))‖ := ContinuousLinearMap.le_opNorm₂ _ _ _
        _ = ‖fderiv ℝ (fun q => fderiv ℝ Φ q) (s, y)‖ := by rw [he₁n]; ring
        _ ≤ M := h1
        _ ≤ max M 0 := le_max_left _ _

theorem perturbed_curvature_contDiffOn (G H : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3)
    (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hH : ∀ i j : Fin 3, ContDiff ℝ ∞ (fun y => H y i j)) :
    IsOpen {p : ℝ × E3 | p.2 ∈ U ∧ (G p.2 + p.1 • H p.2).det ≠ 0} ∧
    (∀ k i j : Fin 3, ContDiffOn ℝ ∞
      (fun p : ℝ × E3 => christoffel (fun z => G z + p.1 • H z) k i j p.2)
      {p : ℝ × E3 | p.2 ∈ U ∧ (G p.2 + p.1 • H p.2).det ≠ 0}) ∧
    ContDiffOn ℝ ∞ (fun p : ℝ × E3 => scalarCurvatureLocal (fun z => G z + p.1 • H z) p.2)
      {p : ℝ × E3 | p.2 ∈ U ∧ (G p.2 + p.1 • H p.2).det ≠ 0} :=
by
  classical
  
  have hdetgen : ∀ (S : Set (ℝ × E3)) (F : ℝ × E3 → Matrix (Fin 3) (Fin 3) ℝ),
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => F z i j) S) →
      ContDiffOn ℝ ∞ (fun z => (F z).det) S := by
    intro S F hF
    simp only [Matrix.det_apply]
    refine ContDiffOn.sum (fun σ _ => ?_)
    simp only [Units.smul_def, zsmul_eq_mul]
    refine contDiffOn_const.mul ?_
    have hp := contDiffOn_prod' (t := (Finset.univ : Finset (Fin 3)))
      (f := fun i z => F z (σ i) i) (s := S) (n := ∞) (fun i _ => hF _ _)
    refine hp.congr (fun z _ => ?_)
    simp [Finset.prod_apply]
  
  have hinvgen : ∀ (S : Set (ℝ × E3)) (F : ℝ × E3 → Matrix (Fin 3) (Fin 3) ℝ),
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => F z i j) S) →
      (∀ z ∈ S, (F z).det ≠ 0) →
      ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => (F z)⁻¹ i j) S := by
    intro S F hF hdet i j
    have hadj : ContDiffOn ℝ ∞ (fun z => (F z).adjugate i j) S := by
      simp only [Matrix.adjugate_apply]
      refine hdetgen S (fun z => (F z).updateRow j (Pi.single i 1)) ?_
      intro a b
      by_cases hab : a = j
      · subst hab
        simp only [Matrix.updateRow_self]
        exact contDiffOn_const
      · simp only [Matrix.updateRow_ne hab]
        exact hF a b
    have heq : (fun z => (F z)⁻¹ i j) =
        fun z => ((F z).det)⁻¹ * (F z).adjugate i j := by
      funext z
      rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
    rw [heq]
    exact ((hdetgen S F hF).inv hdet).mul hadj
  
  have hD : ∀ (O : Set (ℝ × E3)), IsOpen O → ∀ F : ℝ × E3 → ℝ, ContDiffOn ℝ ∞ F O →
      ∀ v : ℝ × E3, ContDiffOn ℝ ∞ (fun p => fderiv ℝ F p v) O := by
    intro O hO F hF v
    exact ((contDiffOn_infty_iff_fderiv_of_isOpen hO).mp hF).2.clm_apply contDiffOn_const
  have hdiff : ∀ (O : Set (ℝ × E3)), IsOpen O → ∀ F : ℝ × E3 → ℝ, ContDiffOn ℝ ∞ F O →
      ∀ p ∈ O, DifferentiableAt ℝ F p := by
    intro O hO F hF p hp
    exact ((contDiffOn_infty_iff_fderiv_of_isOpen hO).mp hF).1.differentiableAt (hO.mem_nhds hp)
  
  have hslice : ∀ (F : ℝ × E3 → ℝ) (p : ℝ × E3), DifferentiableAt ℝ F p → ∀ c : Fin 3,
      partialDeriv c (fun z => F (p.1, z)) p.2 = fderiv ℝ F p ((0 : ℝ), e c) := by
    intro F p hF c
    obtain ⟨s, y⟩ := p
    have hι := hasFDerivAt_prodMk_right (𝕜 := ℝ) s y
    have hF' : HasFDerivAt F (fderiv ℝ F (s, y)) (s, y) := hF.hasFDerivAt
    have hcomp := hF'.comp y hι
    unfold partialDeriv
    have hfun : (fun z => F ((s, y).1, z)) = F ∘ (fun z => (s, z)) := rfl
    rw [hfun, hcomp.fderiv, ContinuousLinearMap.comp_apply, ContinuousLinearMap.inr_apply]
  
  have hVo : IsOpen {p : ℝ × E3 | p.2 ∈ U} := hU.preimage continuous_snd
  have hM : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun p : ℝ × E3 => (G p.2 + p.1 • H p.2) a b)
      {p : ℝ × E3 | p.2 ∈ U} := by
    intro a b
    have h1 : ContDiffOn ℝ ∞ (fun p : ℝ × E3 => G p.2 a b) {p : ℝ × E3 | p.2 ∈ U} :=
      (hG a b).comp contDiff_snd.contDiffOn (fun p hp => hp)
    have h2 : ContDiffOn ℝ ∞ (fun p : ℝ × E3 => p.1 * H p.2 a b) {p : ℝ × E3 | p.2 ∈ U} :=
      (contDiff_fst.mul ((hH a b).comp contDiff_snd)).contDiffOn
    refine (h1.add h2).congr (fun p _ => ?_)
    simp [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul]
  have hdetV : ContDiffOn ℝ ∞ (fun p : ℝ × E3 => (G p.2 + p.1 • H p.2).det)
      {p : ℝ × E3 | p.2 ∈ U} :=
    hdetgen _ (fun p => G p.2 + p.1 • H p.2) hM
  have hWo : IsOpen {p : ℝ × E3 | p.2 ∈ U ∧ (G p.2 + p.1 • H p.2).det ≠ 0} := by
    have h := hdetV.continuousOn.isOpen_inter_preimage hVo (isOpen_compl_singleton (x := (0 : ℝ)))
    exact h
  set W := {p : ℝ × E3 | p.2 ∈ U ∧ (G p.2 + p.1 • H p.2).det ≠ 0} with hWdef
  have hWmem : ∀ p ∈ W, p.2 ∈ U ∧ (G p.2 + p.1 • H p.2).det ≠ 0 := by
    intro p hp
    rw [hWdef] at hp
    exact hp
  have hWV : ∀ p ∈ W, p ∈ {p : ℝ × E3 | p.2 ∈ U} := fun p hp => (hWmem p hp).1
  have hinvW : ∀ a b : Fin 3,
      ContDiffOn ℝ ∞ (fun p : ℝ × E3 => (G p.2 + p.1 • H p.2)⁻¹ a b) W :=
    hinvgen W (fun p => G p.2 + p.1 • H p.2) (fun a b => (hM a b).mono hWV)
      (fun p hp => (hWmem p hp).2)
  have hparM : ∀ a b c : Fin 3, ContDiffOn ℝ ∞
      (fun p : ℝ × E3 => partialDeriv c (fun z => (G z + p.1 • H z) a b) p.2) W := by
    intro a b c
    refine ((hD _ hVo _ (hM a b) ((0 : ℝ), e c)).mono hWV).congr (fun p hp => ?_)
    exact hslice (fun q : ℝ × E3 => (G q.2 + q.1 • H q.2) a b) p
      (hdiff _ hVo _ (hM a b) p (hWV p hp)) c
  
  have hΓ : ∀ k i j : Fin 3, ContDiffOn ℝ ∞
      (fun p : ℝ × E3 => christoffel (fun z => G z + p.1 • H z) k i j p.2) W := by
    intro k i j
    unfold christoffel
    exact contDiffOn_const.mul (ContDiffOn.sum (fun l _ =>
      (hinvW k l).mul (((hparM j l i).add (hparM i l j)).sub (hparM i j l))))
  have hparΓ : ∀ d a b c : Fin 3, ContDiffOn ℝ ∞
      (fun p : ℝ × E3 => partialDeriv d (christoffel (fun z => G z + p.1 • H z) a b c) p.2) W := by
    intro d a b c
    refine (hD _ hWo _ (hΓ a b c) ((0 : ℝ), e d)).congr (fun p hp => ?_)
    exact hslice (fun q : ℝ × E3 => christoffel (fun z => G z + q.1 • H z) a b c q.2) p
      (hdiff _ hWo _ (hΓ a b c) p hp) d
  
  have hRic : ∀ j k : Fin 3, ContDiffOn ℝ ∞
      (fun p : ℝ × E3 => ricci (fun z => G z + p.1 • H z) j k p.2) W := by
    intro j k
    unfold ricci
    refine (ContDiffOn.sum (fun i _ => ?_)).add
      (ContDiffOn.sum (fun i _ => ContDiffOn.sum (fun q _ =>
        ((hΓ i i q).mul (hΓ q j k)).sub ((hΓ i j q).mul (hΓ q i k)))))
    exact (hparΓ i i j k).sub (hparΓ j i i k)
  
  have hScal : ContDiffOn ℝ ∞
      (fun p : ℝ × E3 => scalarCurvatureLocal (fun z => G z + p.1 • H z) p.2) W := by
    unfold scalarCurvatureLocal
    exact ContDiffOn.sum (fun j _ => ContDiffOn.sum (fun k _ => (hinvW j k).mul (hRic j k)))
  exact ⟨hWo, hΓ, hScal⟩

theorem scalar_first_variation_hasDerivAt (G H : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3)
    (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hGs : ∀ y i j, G y i j = G y j i) (hGpos : ∀ y ∈ U, 0 < (G y).det)
    (hH : ∀ i j : Fin 3, ContDiff ℝ ∞ (fun y => H y i j)) (hHs : ∀ y i j, H y i j = H y j i) :
    ∀ y ∈ U, HasDerivAt (fun s : ℝ => scalarCurvatureLocal (fun z => G z + s • H z) y)
      (fvScalarVar G H y) 0 :=
by
  classical
  intro y hy
  
  
  
  have L1 : ∀ (A B : Matrix (Fin 3) (Fin 3) ℝ), A.det ≠ 0 → ∀ k l : Fin 3,
      HasDerivAt (fun s : ℝ => (A + s • B)⁻¹ k l)
        (-(∑ a : Fin 3, ∑ b : Fin 3, A⁻¹ k a * B a b * A⁻¹ b l)) 0 := by
    intro A B hA
    have hdetd : Differentiable ℝ (fun s : ℝ => (A + s • B).det) := by
      simp only [Matrix.det_fin_three, Matrix.add_apply, Matrix.smul_apply, smul_eq_mul]
      fun_prop
    have hadjd : ∀ k l : Fin 3, Differentiable ℝ (fun s : ℝ => (A + s • B).adjugate k l) := by
      intro k l s
      fin_cases k <;> fin_cases l <;>
        simp [Matrix.adjugate_fin_three, Matrix.add_apply, Matrix.smul_apply, smul_eq_mul] <;>
        fun_prop
    have hA0 : (A + (0 : ℝ) • B).det ≠ 0 := by simpa using hA
    have hQd : ∀ k l : Fin 3, DifferentiableAt ℝ (fun s : ℝ => (A + s • B)⁻¹ k l) 0 := by
      intro k l
      have heq : (fun s : ℝ => (A + s • B)⁻¹ k l) =
          fun s => ((A + s • B).det)⁻¹ * (A + s • B).adjugate k l := by
        funext s
        rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
      rw [heq]
      exact ((hdetd 0).inv hA0).mul (hadjd k l 0)
    obtain ⟨D, hQ⟩ : ∃ D : Fin 3 → Fin 3 → ℝ,
        ∀ m l, HasDerivAt (fun s : ℝ => (A + s • B)⁻¹ m l) (D m l) 0 :=
      ⟨fun m l => deriv (fun s : ℝ => (A + s • B)⁻¹ m l) 0, fun m l => (hQd m l).hasDerivAt⟩
    have hev : ∀ᶠ s in 𝓝 (0 : ℝ), (A + s • B).det ≠ 0 :=
      (hdetd 0).continuousAt.eventually_ne hA0
    have hkey : ∀ k l : Fin 3, ∑ m : Fin 3, (B k m * A⁻¹ m l + A k m * D m l) = 0 := by
      intro k l
      have h1 : HasDerivAt (fun s : ℝ => ∑ m : Fin 3, (A k m + s * B k m) * (A + s • B)⁻¹ m l)
          (∑ m : Fin 3, (B k m * (A + (0 : ℝ) • B)⁻¹ m l + (A k m + 0 * B k m) * D m l)) 0 := by
        apply HasDerivAt.fun_sum
        intro m _
        exact ((hasDerivAt_mul_const (B k m)).const_add (A k m)).fun_mul (hQ m l)
      have h2 : HasDerivAt (fun s : ℝ => ∑ m : Fin 3, (A k m + s * B k m) * (A + s • B)⁻¹ m l)
          0 0 := by
        apply (hasDerivAt_const (0 : ℝ) ((1 : Matrix (Fin 3) (Fin 3) ℝ) k l)).congr_of_eventuallyEq
        filter_upwards [hev] with s hs
        have h4 := Matrix.mul_nonsing_inv (A + s • B) hs.isUnit
        have h3 := congrFun (congrFun h4 k) l
        rw [Matrix.mul_apply] at h3
        simpa [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul] using h3
      have h5 := h1.unique h2
      simpa using h5
    have hmat : B * A⁻¹ + A * Matrix.of D = 0 := by
      ext k l
      simpa [Matrix.add_apply, Matrix.mul_apply, Finset.sum_add_distrib] using hkey k l
    have hDm : Matrix.of D = -(A⁻¹ * B * A⁻¹) := by
      have h1 : A * Matrix.of D = -(B * A⁻¹) := by
        rw [eq_neg_iff_add_eq_zero, add_comm]; exact hmat
      calc Matrix.of D = A⁻¹ * (A * Matrix.of D) :=
            (Matrix.nonsing_inv_mul_cancel_left A (Matrix.of D) hA.isUnit).symm
        _ = -(A⁻¹ * B * A⁻¹) := by rw [h1, Matrix.mul_neg, Matrix.mul_assoc]
    intro k l
    refine (hQ k l).congr_deriv ?_
    have h2 := congrFun (congrFun hDm k) l
    simp only [Matrix.of_apply, Matrix.neg_apply, Matrix.mul_apply] at h2
    rw [h2]
    simp only [Fin.sum_univ_three]
    ring
  
  
  
  have L2 : ∀ y' : E3, (∀ a b : Fin 3, DifferentiableAt ℝ (fun z => G z a b) y') →
      (∀ a b : Fin 3, DifferentiableAt ℝ (fun z => H z a b) y') → (G y').det ≠ 0 →
      ∀ k i j : Fin 3, HasDerivAt (fun s : ℝ => christoffel (fun z => G z + s • H z) k i j y')
        (fvChristoffelVar G H k i j y') 0 := by
    intro y' hGd hHd hdet k i j
    have hpd : ∀ (s : ℝ) (c a b : Fin 3), partialDeriv c (fun z => (G z + s • H z) a b) y' =
        partialDeriv c (fun z => G z a b) y' + s * partialDeriv c (fun z => H z a b) y' := by
      intro s c a b
      have hf : (fun z => (G z + s • H z) a b) = fun z => G z a b + s * H z a b := by
        funext z; simp [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul]
      unfold partialDeriv
      have hsum : HasFDerivAt (fun z => G z a b + s * H z a b)
          (fderiv ℝ (fun z => G z a b) y' + s • fderiv ℝ (fun z => H z a b) y') y' :=
        (hGd a b).hasFDerivAt.add ((hHd a b).hasFDerivAt.const_mul s)
      rw [hf, hsum.fderiv]
      simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply, smul_eq_mul]
    have hform : (fun s : ℝ => christoffel (fun z => G z + s • H z) k i j y') =
        fun s => (1 / 2 : ℝ) * ∑ l : Fin 3, (G y' + s • H y')⁻¹ k l *
          ((partialDeriv i (fun z => G z j l) y' + partialDeriv j (fun z => G z i l) y'
              - partialDeriv l (fun z => G z i j) y') +
           s * (partialDeriv i (fun z => H z j l) y' + partialDeriv j (fun z => H z i l) y'
              - partialDeriv l (fun z => H z i j) y')) := by
      funext s
      unfold christoffel
      simp only [hpd]
      congr 1
      refine Finset.sum_congr rfl (fun l _ => ?_)
      ring
    rw [hform]
    have hlin : ∀ (a b : ℝ), HasDerivAt (fun s : ℝ => a + s * b) b 0 :=
      fun a b => (hasDerivAt_mul_const b).const_add a
    refine ((HasDerivAt.fun_sum (u := Finset.univ) (fun l _ =>
        (L1 (G y') (H y') hdet k l).fun_mul (hlin _ _))).const_mul (1 / 2 : ℝ)).congr_deriv ?_
    simp only [zero_smul, add_zero, zero_mul]
    unfold fvChristoffelVar christoffel
    simp only [Fin.sum_univ_three]
    ring
  
  
  
  have hdetgen : ∀ (S : Set (ℝ × E3)) (F : ℝ × E3 → Matrix (Fin 3) (Fin 3) ℝ),
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => F z i j) S) →
      ContDiffOn ℝ ∞ (fun z => (F z).det) S := by
    intro S F hF
    simp only [Matrix.det_apply]
    refine ContDiffOn.sum (fun σ _ => ?_)
    simp only [Units.smul_def, zsmul_eq_mul]
    refine contDiffOn_const.mul ?_
    have hp := contDiffOn_prod' (t := (Finset.univ : Finset (Fin 3)))
      (f := fun i z => F z (σ i) i) (s := S) (n := ∞) (fun i _ => hF _ _)
    refine hp.congr (fun z _ => ?_)
    simp [Finset.prod_apply]
  have hinvgen : ∀ (S : Set (ℝ × E3)) (F : ℝ × E3 → Matrix (Fin 3) (Fin 3) ℝ),
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => F z i j) S) →
      (∀ z ∈ S, (F z).det ≠ 0) →
      ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => (F z)⁻¹ i j) S := by
    intro S F hF hdet i j
    have hadj : ContDiffOn ℝ ∞ (fun z => (F z).adjugate i j) S := by
      simp only [Matrix.adjugate_apply]
      refine hdetgen S (fun z => (F z).updateRow j (Pi.single i 1)) ?_
      intro a b
      by_cases hab : a = j
      · subst hab
        simp only [Matrix.updateRow_self]
        exact contDiffOn_const
      · simp only [Matrix.updateRow_ne hab]
        exact hF a b
    have heq : (fun z => (F z)⁻¹ i j) =
        fun z => ((F z).det)⁻¹ * (F z).adjugate i j := by
      funext z
      rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
    rw [heq]
    exact ((hdetgen S F hF).inv hdet).mul hadj
  have hDv : ∀ (O : Set (ℝ × E3)), IsOpen O → ∀ F : ℝ × E3 → ℝ, ContDiffOn ℝ ∞ F O →
      ∀ v : ℝ × E3, ContDiffOn ℝ ∞ (fun p => fderiv ℝ F p v) O := by
    intro O hO F hF v
    exact ((contDiffOn_infty_iff_fderiv_of_isOpen hO).mp hF).2.clm_apply contDiffOn_const
  have hdiff : ∀ (O : Set (ℝ × E3)), IsOpen O → ∀ F : ℝ × E3 → ℝ, ContDiffOn ℝ ∞ F O →
      ∀ p ∈ O, DifferentiableAt ℝ F p := by
    intro O hO F hF p hp
    exact ((contDiffOn_infty_iff_fderiv_of_isOpen hO).mp hF).1.differentiableAt (hO.mem_nhds hp)
  have hslice : ∀ (F : ℝ × E3 → ℝ) (p : ℝ × E3), DifferentiableAt ℝ F p → ∀ c : Fin 3,
      partialDeriv c (fun z => F (p.1, z)) p.2 = fderiv ℝ F p ((0 : ℝ), e c) := by
    intro F p hF c
    obtain ⟨s, y⟩ := p
    have hι := hasFDerivAt_prodMk_right (𝕜 := ℝ) s y
    have hF' : HasFDerivAt F (fderiv ℝ F (s, y)) (s, y) := hF.hasFDerivAt
    have hcomp := hF'.comp y hι
    unfold partialDeriv
    have hfun : (fun z => F ((s, y).1, z)) = F ∘ (fun z => (s, z)) := rfl
    rw [hfun, hcomp.fderiv, ContinuousLinearMap.comp_apply, ContinuousLinearMap.inr_apply]
  have hVo : IsOpen {p : ℝ × E3 | p.2 ∈ U} := hU.preimage continuous_snd
  have hM : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun p : ℝ × E3 => (G p.2 + p.1 • H p.2) a b)
      {p : ℝ × E3 | p.2 ∈ U} := by
    intro a b
    have h1 : ContDiffOn ℝ ∞ (fun p : ℝ × E3 => G p.2 a b) {p : ℝ × E3 | p.2 ∈ U} :=
      (hG a b).comp contDiff_snd.contDiffOn (fun p hp => hp)
    have h2 : ContDiffOn ℝ ∞ (fun p : ℝ × E3 => p.1 * H p.2 a b) {p : ℝ × E3 | p.2 ∈ U} :=
      (contDiff_fst.mul ((hH a b).comp contDiff_snd)).contDiffOn
    refine (h1.add h2).congr (fun p _ => ?_)
    simp [Matrix.add_apply, Matrix.smul_apply, smul_eq_mul]
  have hdetV : ContDiffOn ℝ ∞ (fun p : ℝ × E3 => (G p.2 + p.1 • H p.2).det)
      {p : ℝ × E3 | p.2 ∈ U} :=
    hdetgen _ (fun p => G p.2 + p.1 • H p.2) hM
  have hWo : IsOpen {p : ℝ × E3 | p.2 ∈ U ∧ (G p.2 + p.1 • H p.2).det ≠ 0} := by
    have h := hdetV.continuousOn.isOpen_inter_preimage hVo (isOpen_compl_singleton (x := (0 : ℝ)))
    exact h
  set W := {p : ℝ × E3 | p.2 ∈ U ∧ (G p.2 + p.1 • H p.2).det ≠ 0} with hWdef
  have hWmem : ∀ p ∈ W, p.2 ∈ U ∧ (G p.2 + p.1 • H p.2).det ≠ 0 := by
    intro p hp
    rw [hWdef] at hp
    exact hp
  have hWV : ∀ p ∈ W, p ∈ {p : ℝ × E3 | p.2 ∈ U} := fun p hp => (hWmem p hp).1
  have hinvW : ∀ a b : Fin 3,
      ContDiffOn ℝ ∞ (fun p : ℝ × E3 => (G p.2 + p.1 • H p.2)⁻¹ a b) W :=
    hinvgen W (fun p => G p.2 + p.1 • H p.2) (fun a b => (hM a b).mono hWV)
      (fun p hp => (hWmem p hp).2)
  have hparM : ∀ a b c : Fin 3, ContDiffOn ℝ ∞
      (fun p : ℝ × E3 => partialDeriv c (fun z => (G z + p.1 • H z) a b) p.2) W := by
    intro a b c
    refine ((hDv _ hVo _ (hM a b) ((0 : ℝ), e c)).mono hWV).congr (fun p hp => ?_)
    exact hslice (fun q : ℝ × E3 => (G q.2 + q.1 • H q.2) a b) p
      (hdiff _ hVo _ (hM a b) p (hWV p hp)) c
  have hΓ : ∀ k i j : Fin 3, ContDiffOn ℝ ∞
      (fun p : ℝ × E3 => christoffel (fun z => G z + p.1 • H z) k i j p.2) W := by
    intro k i j
    unfold christoffel
    exact contDiffOn_const.mul (ContDiffOn.sum (fun l _ =>
      (hinvW k l).mul (((hparM j l i).add (hparM i l j)).sub (hparM i j l))))
  
  
  
  have hdetU : ∀ y' ∈ U, (G y').det ≠ 0 := fun y' hy' => (hGpos y' hy').ne'
  have hGdU : ∀ y' ∈ U, ∀ a b : Fin 3, DifferentiableAt ℝ (fun z => G z a b) y' :=
    fun y' hy' a b => ((hG a b).contDiffAt (hU.mem_nhds hy')).differentiableAt (by simp)
  have hHd : ∀ (y' : E3) (a b : Fin 3), DifferentiableAt ℝ (fun z => H z a b) y' :=
    fun y' a b => ((hH a b).differentiable (by simp)) y'
  have h0W : ∀ y' ∈ U, ((0 : ℝ), y') ∈ W := by
    intro y' hy'
    rw [hWdef]
    show y' ∈ U ∧ (G y' + (0 : ℝ) • H y').det ≠ 0
    exact ⟨hy', by simpa using hdetU y' hy'⟩
  
  
  
  have L3 : ∀ m k i j : Fin 3, HasDerivAt
      (fun s : ℝ => partialDeriv m (christoffel (fun z => G z + s • H z) k i j) y)
      (partialDeriv m (fvChristoffelVar G H k i j) y) 0 := by
    intro m k i j
    set F : ℝ × E3 → ℝ := fun p => christoffel (fun z => G z + p.1 • H z) k i j p.2 with hFdef
    have hFs : ContDiffOn ℝ ∞ F W := hΓ k i j
    have hFat : ∀ p ∈ W, ContDiffAt ℝ ∞ F p := fun p hp => hFs.contDiffAt (hWo.mem_nhds hp)
    have hFd : ∀ p ∈ W, DifferentiableAt ℝ F p :=
      fun p hp => (hFat p hp).differentiableAt (by simp)
    have p0 : ((0 : ℝ), y) ∈ W := h0W y hy
    have hDF : ContDiffAt ℝ ∞ (fderiv ℝ F) ((0 : ℝ), y) :=
      (hFat _ p0).fderiv_right (m := ∞) le_rfl
    obtain ⟨D2, hD2h⟩ : ∃ D2, HasFDerivAt (fderiv ℝ F) D2 ((0 : ℝ), y) :=
      ⟨_, (hDF.differentiableAt (by simp)).hasFDerivAt⟩
    
    have hslice' : ∀ (s : ℝ) (y' : E3), (s, y') ∈ W →
        partialDeriv m (christoffel (fun z => G z + s • H z) k i j) y' =
          fderiv ℝ F (s, y') ((0 : ℝ), e m) :=
      fun s y' hp => hslice F (s, y') (hFd _ hp) m
    
    have hc : HasDerivAt (fun s : ℝ => (s, y)) ((1 : ℝ), (0 : E3)) 0 :=
      (hasDerivAt_id' (0 : ℝ)).prodMk (hasDerivAt_const (0 : ℝ) y)
    have hL1 : HasDerivAt (fun s : ℝ => fderiv ℝ F (s, y)) (D2 ((1 : ℝ), (0 : E3))) 0 :=
      hD2h.comp_hasDerivAt (0 : ℝ) hc
    have hL2 : HasDerivAt (fun s : ℝ => fderiv ℝ F (s, y) ((0 : ℝ), e m))
        (D2 ((1 : ℝ), (0 : E3)) ((0 : ℝ), e m)) 0 :=
      (hL1.clm_apply (hasDerivAt_const (0 : ℝ) ((0 : ℝ), e m))).congr_deriv (by simp)
    have hopen : {s : ℝ | (s, y) ∈ W} ∈ 𝓝 (0 : ℝ) := by
      have hcont : Continuous (fun s : ℝ => (s, y)) := continuous_id.prodMk continuous_const
      exact hcont.continuousAt.preimage_mem_nhds (hWo.mem_nhds p0)
    have hLHS : HasDerivAt
        (fun s : ℝ => partialDeriv m (christoffel (fun z => G z + s • H z) k i j) y)
        (D2 ((1 : ℝ), (0 : E3)) ((0 : ℝ), e m)) 0 := by
      refine hL2.congr_of_eventuallyEq ?_
      filter_upwards [hopen] with s hs
      exact hslice' s y hs
    
    have hfvEq : ∀ y' ∈ U,
        fvChristoffelVar G H k i j y' = fderiv ℝ F ((0 : ℝ), y') ((1 : ℝ), (0 : E3)) := by
      intro y' hy'
      have hcy : HasDerivAt (fun s : ℝ => (s, y')) ((1 : ℝ), (0 : E3)) 0 :=
        (hasDerivAt_id' (0 : ℝ)).prodMk (hasDerivAt_const (0 : ℝ) y')
      have hFh : HasFDerivAt F (fderiv ℝ F ((0 : ℝ), y')) ((0 : ℝ), y') :=
        (hFd _ (h0W y' hy')).hasFDerivAt
      have h1 : HasDerivAt (fun s : ℝ => F (s, y'))
          (fderiv ℝ F ((0 : ℝ), y') ((1 : ℝ), (0 : E3))) 0 :=
        HasFDerivAt.comp_hasDerivAt (l := F) (f := fun s : ℝ => (s, y')) (0 : ℝ) hFh hcy
      have h2 : HasDerivAt (fun s : ℝ => F (s, y')) (fvChristoffelVar G H k i j y') 0 :=
        L2 y' (hGdU y' hy') (hHd y') (hdetU y' hy') k i j
      exact h2.unique h1
    have hRHS : partialDeriv m (fvChristoffelVar G H k i j) y =
        D2 ((0 : ℝ), e m) ((1 : ℝ), (0 : E3)) := by
      have hc1 : HasFDerivAt (fun y' : E3 => fderiv ℝ F ((0 : ℝ), y'))
          (D2.comp (ContinuousLinearMap.inr ℝ ℝ E3)) y :=
        hD2h.comp y (hasFDerivAt_prodMk_right (0 : ℝ) y)
      have hc2 := hc1.clm_apply (hasFDerivAt_const ((1 : ℝ), (0 : E3)) y)
      have hev : fvChristoffelVar G H k i j =ᶠ[𝓝 y]
          (fun y' => fderiv ℝ F ((0 : ℝ), y') ((1 : ℝ), (0 : E3))) := by
        filter_upwards [hU.mem_nhds hy] with y' hy'
        exact hfvEq y' hy'
      unfold partialDeriv
      rw [hev.fderiv_eq, hc2.fderiv]
      simp
    
    have hsymm : IsSymmSndFDerivAt ℝ F ((0 : ℝ), y) :=
      (hFat _ p0).isSymmSndFDerivAt (by
        rw [minSmoothness_of_isRCLikeNormedField]; exact WithTop.coe_le_coe.2 le_top)
    have hsw : D2 ((1 : ℝ), (0 : E3)) ((0 : ℝ), e m) = D2 ((0 : ℝ), e m) ((1 : ℝ), (0 : E3)) := by
      rw [← hD2h.fderiv]
      exact hsymm _ _
    rw [hRHS, ← hsw]
    exact hLHS
  
  
  
  have hdet : (G y).det ≠ 0 := hdetU y hy
  have L2y := L2 y (hGdU y hy) (hHd y) hdet
  have h0 : (fun z => G z + (0 : ℝ) • H z) = G := by funext z; simp
  have L5 : ∀ j k : Fin 3, HasDerivAt (fun s : ℝ => ricci (fun z => G z + s • H z) j k y)
      (fvRicciVar G H j k y) 0 := by
    intro j k
    unfold ricci
    have hd := (HasDerivAt.fun_sum (u := Finset.univ)
        (fun i _ => (L3 i i j k).sub (L3 j i i k))).add
      (HasDerivAt.fun_sum (u := Finset.univ) (fun i _ => HasDerivAt.fun_sum (u := Finset.univ)
        (fun p _ => ((L2y i i p).fun_mul (L2y p j k)).sub ((L2y i j p).fun_mul (L2y p i k)))))
    refine hd.congr_deriv ?_
    rw [h0]
    unfold fvRicciVar
    simp only [Fin.sum_univ_three]
    ring
  unfold scalarCurvatureLocal
  have hd := HasDerivAt.fun_sum (u := Finset.univ) (fun j _ => HasDerivAt.fun_sum
    (u := Finset.univ) (fun k _ => (L1 (G y) (H y) hdet j k).fun_mul (L5 j k)))
  refine hd.congr_deriv ?_
  rw [h0]
  simp only [zero_smul, add_zero]
  unfold fvScalarVar
  simp only [Fin.sum_univ_three]
  ring

theorem first_variation_divergence_pointwise (G H : E3 → Matrix (Fin 3) (Fin 3) ℝ) (f : E3 → ℝ)
    (U : Set E3) (hU : IsOpen U) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hGs : ∀ y i j, G y i j = G y j i) (hGpos : ∀ y ∈ U, 0 < (G y).det)
    (hH : ∀ i j : Fin 3, ContDiff ℝ ∞ (fun y => H y i j)) (hHs : ∀ y i j, H y i j = H y j i)
    (hf : ContDiffOn ℝ ∞ f U) :
    ∀ y ∈ U, f y * fvScalarVar G H y * Real.sqrt (G y).det =
      -((∑ a : Fin 3, ∑ b : Fin 3, ∑ c : Fin 3, ∑ d : Fin 3,
          (G y)⁻¹ a c * (G y)⁻¹ b d * H y a b * staticLoc G f c d y) * Real.sqrt (G y).det)
      + ∑ i : Fin 3, partialDeriv i (fvField G H f i) y :=
by
  intro y hy
  have hyU : U ∈ 𝓝 y := hU.mem_nhds hy
  have hdet : 0 < (G y).det := hGpos y hy
  have hdet0 : (G y).det ≠ 0 := hdet.ne'
  have hGd : ∀ a b : Fin 3, DifferentiableAt ℝ (fun z => G z a b) y :=
    fun a b => ((hG a b).contDiffAt hyU).differentiableAt (by simp)
  
  have hdetD : ∀ K : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ a b : Fin 3, DifferentiableAt ℝ (fun z => K z a b) y) →
      DifferentiableAt ℝ (fun z => (K z).det) y := by
    intro K hK
    have hfun : (fun z => (K z).det) = fun z =>
        K z 0 0 * K z 1 1 * K z 2 2 - K z 0 0 * K z 1 2 * K z 2 1
        - K z 0 1 * K z 1 0 * K z 2 2 + K z 0 1 * K z 1 2 * K z 2 0
        + K z 0 2 * K z 1 0 * K z 2 1 - K z 0 2 * K z 1 1 * K z 2 0 := by
      funext z; exact Matrix.det_fin_three (K z)
    rw [hfun]
    have h00 := hK 0 0
    have h01 := hK 0 1
    have h02 := hK 0 2
    have h10 := hK 1 0
    have h11 := hK 1 1
    have h12 := hK 1 2
    have h20 := hK 2 0
    have h21 := hK 2 1
    have h22 := hK 2 2
    fun_prop
  have hD : DifferentiableAt ℝ (fun z => (G z).det) y := hdetD G hGd
  have hPd : ∀ k l : Fin 3, DifferentiableAt ℝ (fun z => (G z)⁻¹ k l) y := by
    intro k l
    have hfun : (fun z => (G z)⁻¹ k l) =
        fun z => ((G z).det)⁻¹ * ((G z).updateRow l (Pi.single k 1)).det := by
      funext z
      rw [Matrix.inv_def, Matrix.smul_apply, Matrix.adjugate_apply, Ring.inverse_eq_inv,
        smul_eq_mul]
    rw [hfun]
    refine (hD.inv hdet0).mul (hdetD _ ?_)
    intro a b
    by_cases hal : a = l
    · subst hal
      simp only [Matrix.updateRow_self]
      exact differentiableAt_const _
    · simp only [Matrix.updateRow_ne hal]
      exact hGd a b
  
  have hev : ∀ᶠ z in 𝓝 y, (G z).det ≠ 0 := hD.continuousAt.eventually_ne hdet0
  have hinv : ∀ m k l : Fin 3, partialDeriv m (fun z => (G z)⁻¹ k l) y =
      -∑ a : Fin 3, ∑ b : Fin 3,
        (G y)⁻¹ k a * partialDeriv m (fun z => G z a b) y * (G y)⁻¹ b l := by
    intro m
    have hE : ∀ a l : Fin 3, ∑ b : Fin 3, G y a b * partialDeriv m (fun z => (G z)⁻¹ b l) y
        + ∑ b : Fin 3, partialDeriv m (fun z => G z a b) y * (G y)⁻¹ b l = 0 := by
      intro a l
      have h1 : HasFDerivAt (fun z => ∑ b : Fin 3, G z a b * (G z)⁻¹ b l)
          (∑ b : Fin 3, (G y a b • fderiv ℝ (fun z => (G z)⁻¹ b l) y
            + (G y)⁻¹ b l • fderiv ℝ (fun z => G z a b) y)) y := by
        have hs := HasFDerivAt.sum (u := Finset.univ)
          (A := fun b z => G z a b * (G z)⁻¹ b l)
          (fun b _ => (hGd a b).hasFDerivAt.mul (hPd b l).hasFDerivAt)
        convert hs using 1
      have h2 : HasFDerivAt (fun z => ∑ b : Fin 3, G z a b * (G z)⁻¹ b l)
          (0 : E3 →L[ℝ] ℝ) y := by
        apply (hasFDerivAt_const (if a = l then (1 : ℝ) else 0) y).congr_of_eventuallyEq
        filter_upwards [hev] with z hz
        have := congrFun (congrFun (Matrix.mul_nonsing_inv (G z) (isUnit_iff_ne_zero.mpr hz)) a) l
        rw [Matrix.mul_apply, Matrix.one_apply] at this
        exact this
      have h3 := congrArg (fun L : E3 →L[ℝ] ℝ => L (e m)) (h1.unique h2)
      simp only [ContinuousLinearMap.sum_apply, ContinuousLinearMap.add_apply,
        ContinuousLinearMap.smul_apply, smul_eq_mul, ContinuousLinearMap.zero_apply] at h3
      unfold partialDeriv
      rw [← h3, ← Finset.sum_add_distrib]
      apply Finset.sum_congr rfl
      intro b _
      ring
    intro k l
    let X : Matrix (Fin 3) (Fin 3) ℝ :=
      Matrix.of fun b l => partialDeriv m (fun z => (G z)⁻¹ b l) y
    let DM : Matrix (Fin 3) (Fin 3) ℝ :=
      Matrix.of fun a b => partialDeriv m (fun z => G z a b) y
    have hM : G y * X = -(DM * (G y)⁻¹) := by
      ext a l'
      rw [Matrix.mul_apply, Matrix.neg_apply, Matrix.mul_apply, eq_neg_iff_add_eq_zero]
      simp only [X, DM, Matrix.of_apply]
      exact hE a l'
    have hX : X = -((G y)⁻¹ * (DM * (G y)⁻¹)) := by
      calc X = ((G y)⁻¹ * G y) * X := by
            rw [Matrix.nonsing_inv_mul _ (isUnit_iff_ne_zero.mpr hdet0), Matrix.one_mul]
        _ = (G y)⁻¹ * (G y * X) := Matrix.mul_assoc _ _ _
        _ = _ := by rw [hM, Matrix.mul_neg]
    have hkl := congrFun (congrFun hX k) l
    simp only [X, DM, Matrix.of_apply, Matrix.neg_apply, Matrix.mul_apply] at hkl
    rw [hkl]
    congr 1
    apply Finset.sum_congr rfl
    intro a _
    rw [Finset.mul_sum]
    apply Finset.sum_congr rfl
    intro b _
    ring
  
  have hsd : DifferentiableAt ℝ (fun z => Real.sqrt (G z).det) y := hD.sqrt hdet0
  have hfd : DifferentiableAt ℝ f y := (hf.contDiffAt hyU).differentiableAt (by simp)
  have hdfd : ∀ j : Fin 3, DifferentiableAt ℝ (partialDeriv j f) y := by
    intro j
    have h1 : ContDiffOn ℝ ∞ (fderiv ℝ f) U := hf.fderiv_of_isOpen hU (by simp)
    have h2 : ContDiffOn ℝ ∞ (fun z => fderiv ℝ f z (e j)) U := h1.clm_apply contDiffOn_const
    exact (h2.contDiffAt hyU).differentiableAt (by simp)
  have hDGd : ∀ m a b : Fin 3, DifferentiableAt ℝ (partialDeriv m (fun z => G z a b)) y := by
    intro m a b
    have h1 : ContDiffOn ℝ ∞ (fderiv ℝ (fun z => G z a b)) U :=
      (hG a b).fderiv_of_isOpen hU (by simp)
    have h2 : ContDiffOn ℝ ∞ (fun z => fderiv ℝ (fun z => G z a b) z (e m)) U :=
      h1.clm_apply contDiffOn_const
    exact (h2.contDiffAt hyU).differentiableAt (by simp)
  have hHd : ∀ a b : Fin 3, DifferentiableAt ℝ (fun z => H z a b) y :=
    fun a b => (hH a b).differentiable (by simp) y
  have hdHd : ∀ m a b : Fin 3, DifferentiableAt ℝ (partialDeriv m (fun z => H z a b)) y := by
    intro m a b
    have h1 : ContDiff ℝ ∞ (fderiv ℝ (fun z => H z a b)) := (hH a b).fderiv_right (by simp)
    have h2 : ContDiff ℝ ∞ (fun z => fderiv ℝ (fun z => H z a b) z (e m)) :=
      h1.clm_apply contDiff_const
    exact h2.differentiable (by simp) y
  have hΓd : ∀ k i j : Fin 3, DifferentiableAt ℝ (christoffel G k i j) y := by
    intro k i j
    show DifferentiableAt ℝ (fun z => (1 / 2 : ℝ) * ∑ l : Fin 3, (G z)⁻¹ k l *
      (partialDeriv i (fun z => G z j l) z + partialDeriv j (fun z => G z i l) z
        - partialDeriv l (fun z => G z i j) z)) y
    exact (DifferentiableAt.fun_sum fun l _ => (hPd k l).fun_mul
      (((hDGd i j l).fun_add (hDGd j i l)).fun_sub (hDGd l i j))).const_mul _
  have hAd : ∀ k i j : Fin 3, DifferentiableAt ℝ (fvChristoffelVar G H k i j) y := by
    intro k i j
    show DifferentiableAt ℝ (fun z => (1 / 2 : ℝ) * ∑ l : Fin 3, (G z)⁻¹ k l *
      (partialDeriv i (fun z => H z j l) z + partialDeriv j (fun z => H z i l) z
        - partialDeriv l (fun z => H z i j) z)
      - ∑ a : Fin 3, ∑ b : Fin 3, (G z)⁻¹ k a * H z a b * christoffel G b i j z) y
    exact ((DifferentiableAt.fun_sum fun l _ => (hPd k l).fun_mul
      (((hdHd i j l).fun_add (hdHd j i l)).fun_sub (hdHd l i j))).const_mul _).fun_sub
      (DifferentiableAt.fun_sum fun a _ => DifferentiableAt.fun_sum fun b _ =>
        ((hPd k a).fun_mul (hHd a b)).fun_mul (hΓd b i j))
  
  have hGT : (G y).transpose = G y := by
    ext a b
    exact hGs y b a
  have hPs : ∀ a b : Fin 3, (G y)⁻¹ a b = (G y)⁻¹ b a := by
    intro a b
    have h := congrFun (congrFun (Matrix.transpose_nonsing_inv (G y)) b) a
    rw [hGT, Matrix.transpose_apply] at h
    exact h
  have hDs : ∀ m a b : Fin 3,
      partialDeriv m (fun z => G z a b) y = partialDeriv m (fun z => G z b a) y := by
    intro m a b
    rw [show (fun z => G z a b) = (fun z => G z b a) from funext fun z => hGs z a b]
  have hdHs : ∀ m a b : Fin 3,
      partialDeriv m (fun z => H z a b) y = partialDeriv m (fun z => H z b a) y := by
    intro m a b
    rw [show (fun z => H z a b) = (fun z => H z b a) from funext fun z => hHs z a b]
  have hΓs : ∀ k i j : Fin 3, christoffel G k i j y = christoffel G k j i y := by
    intro k i j
    have hij : (fun z => G z j i) = fun z => G z i j := funext fun z => hGs z j i
    rw [christoffel, christoffel, hij]
    congr 1
    refine Finset.sum_congr rfl fun l _ => ?_
    ring
  have hGP : ∀ b c : Fin 3, ∑ d : Fin 3, (G y)⁻¹ b d * G y d c = if b = c then 1 else 0 := by
    intro b c
    have h := congrFun (congrFun (Matrix.nonsing_inv_mul (G y) (isUnit_iff_ne_zero.mpr hdet0)) b) c
    rw [Matrix.mul_apply, Matrix.one_apply] at h
    exact h
  have hPadj : ∀ a b : Fin 3, (G y)⁻¹ a b = ((G y).det)⁻¹ * (G y).adjugate a b := by
    intro a b
    rw [Matrix.inv_def, Matrix.smul_apply, Ring.inverse_eq_inv, smul_eq_mul]
  
  have calg : ∀ (P : Fin 3 → Fin 3 → ℝ) (D : Fin 3 → Fin 3 → Fin 3 → ℝ),
      (∀ a b : Fin 3, P a b = P b a) → (∀ m a b : Fin 3, D m a b = D m b a) →
      (∀ m : Fin 3, ∑ a : Fin 3, (1 / 2 : ℝ) * ∑ l : Fin 3, P a l * (D a m l + D m a l - D l a m) =
          (1 / 2 : ℝ) * ∑ a : Fin 3, ∑ b : Fin 3, P b a * D m a b) ∧
      ∀ m k l : Fin 3, ∑ a : Fin 3, ∑ b : Fin 3, P k a * D m a b * P b l =
        ∑ b : Fin 3, (((1 / 2 : ℝ) * ∑ q : Fin 3, P k q * (D b m q + D m b q - D q b m)) * P b l +
          P k b * ((1 / 2 : ℝ) * ∑ q : Fin 3, P l q * (D b m q + D m b q - D q b m))) := by
    intro P D hP hD
    obtain ⟨Q, rfl⟩ : ∃ Q : Fin 3 → Fin 3 → ℝ, P = fun a b => Q a b + Q b a :=
      ⟨fun a b => P a b / 2, by funext a b; show P a b = P a b / 2 + P b a / 2; rw [hP a b]; ring⟩
    obtain ⟨E, rfl⟩ : ∃ E : Fin 3 → Fin 3 → Fin 3 → ℝ, D = fun m a b => E m a b + E m b a :=
      ⟨fun m a b => D m a b / 2, by
        funext m a b; show D m a b = D m a b / 2 + D m b a / 2; rw [hD m a b]; ring⟩
    refine ⟨fun m => ?_, fun m k l => ?_⟩ <;> simp only [Fin.sum_univ_three] <;> ring
  
  have hdP : ∀ m j k : Fin 3, partialDeriv m (fun z => (G z)⁻¹ j k) y =
      -∑ b : Fin 3, (christoffel G j b m y * (G y)⁻¹ b k + (G y)⁻¹ j b * christoffel G k b m y) := by
    intro m j k
    have h2 : ∑ a : Fin 3, ∑ b : Fin 3,
        (G y)⁻¹ j a * partialDeriv m (fun z => G z a b) y * (G y)⁻¹ b k =
        ∑ b : Fin 3, (christoffel G j b m y * (G y)⁻¹ b k + (G y)⁻¹ j b * christoffel G k b m y) :=
      (calg (fun a b => (G y)⁻¹ a b) (fun m a b => partialDeriv m (fun z => G z a b) y) hPs hDs).2 m j k
    rw [hinv m j k, h2]
  
  have hJac : ∀ m : Fin 3, partialDeriv m (fun z => Real.sqrt (G z).det) y =
      Real.sqrt (G y).det * ∑ a : Fin 3, christoffel G a a m y := by
    intro m
    have h00 := (hGd 0 0).hasFDerivAt
    have h01 := (hGd 0 1).hasFDerivAt
    have h02 := (hGd 0 2).hasFDerivAt
    have h10 := (hGd 1 0).hasFDerivAt
    have h11 := (hGd 1 1).hasFDerivAt
    have h12 := (hGd 1 2).hasFDerivAt
    have h20 := (hGd 2 0).hasFDerivAt
    have h21 := (hGd 2 1).hasFDerivAt
    have h22 := (hGd 2 2).hasFDerivAt
    have hpoly := ((((((h00.fun_mul h11).fun_mul h22).fun_sub ((h00.fun_mul h12).fun_mul h21)).fun_sub
      ((h01.fun_mul h10).fun_mul h22)).fun_add ((h01.fun_mul h12).fun_mul h20)).fun_add
      ((h02.fun_mul h10).fun_mul h21)).fun_sub ((h02.fun_mul h11).fun_mul h20)
    have hdetF := hpoly.congr_of_eventuallyEq (f₁ := fun z => (G z).det)
      (Filter.Eventually.of_forall fun z => Matrix.det_fin_three (G z))
    have hsq := hdetF.sqrt hdet0
    have hc : ∑ a : Fin 3, christoffel G a a m y =
        (1 / 2 : ℝ) * ∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ b a * partialDeriv m (fun z => G z a b) y :=
      (calg (fun a b => (G y)⁻¹ a b) (fun m a b => partialDeriv m (fun z => G z a b) y) hPs hDs).1 m
    rw [hc]
    simp only [hPadj]
    unfold partialDeriv
    rw [hsq.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.sub_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul]
    have hs0 : Real.sqrt (G y).det ≠ 0 := (Real.sqrt_pos.2 hdet).ne'
    have hsq2 : Real.sqrt (G y).det ^ 2 = (G y).det := Real.sq_sqrt hdet.le
    generalize Real.sqrt (G y).det = s at hs0 hsq2 ⊢
    rw [← hsq2]
    simp only [Fin.sum_univ_three, Matrix.adjugate_fin_three, Matrix.of_apply, Matrix.cons_val',
      Matrix.cons_val_zero, Matrix.cons_val_one, Matrix.head_cons, Matrix.cons_val_two,
      Matrix.tail_cons, Matrix.empty_val', Matrix.cons_val_fin_one, Matrix.vecHead,
      Matrix.vecTail, Function.comp_apply, Fin.succ_zero_eq_one, Fin.succ_one_eq_two,
      Matrix.cons_val_succ]
    field_simp
    ring
  
  have leib : ∀ (s F : E3 → ℝ) (P Hf : Fin 3 → Fin 3 → E3 → ℝ)
      (A : Fin 3 → Fin 3 → Fin 3 → E3 → ℝ) (dF : Fin 3 → E3 → ℝ) (i : Fin 3),
      DifferentiableAt ℝ s y → DifferentiableAt ℝ F y → (∀ a b, DifferentiableAt ℝ (P a b) y) →
      (∀ a b, DifferentiableAt ℝ (Hf a b) y) → (∀ k a b, DifferentiableAt ℝ (A k a b) y) →
      (∀ j, DifferentiableAt ℝ (dF j) y) →
      partialDeriv i (fun z => s z *
          (F z * (∑ j : Fin 3, ∑ k : Fin 3, P j k z * A i j k z
                - ∑ j : Fin 3, ∑ k : Fin 3, P i j z * A k k j z)
            - ∑ j : Fin 3, (∑ a : Fin 3, ∑ b : Fin 3, P i a z * Hf a b z * P b j z
                - P i j z * ∑ a : Fin 3, ∑ b : Fin 3, P a b z * Hf a b z) * dF j z)) y =
        partialDeriv i s y *
            (F y * (∑ j : Fin 3, ∑ k : Fin 3, P j k y * A i j k y
                    - ∑ j : Fin 3, ∑ k : Fin 3, P i j y * A k k j y)
              - ∑ j : Fin 3, (∑ a : Fin 3, ∑ b : Fin 3, P i a y * Hf a b y * P b j y
                    - P i j y * ∑ a : Fin 3, ∑ b : Fin 3, P a b y * Hf a b y) * dF j y)
          + s y *
            (partialDeriv i F y * (∑ j : Fin 3, ∑ k : Fin 3, P j k y * A i j k y
                    - ∑ j : Fin 3, ∑ k : Fin 3, P i j y * A k k j y)
              + F y * (∑ j : Fin 3, ∑ k : Fin 3, (partialDeriv i (P j k) y * A i j k y
                        + P j k y * partialDeriv i (A i j k) y)
                    - ∑ j : Fin 3, ∑ k : Fin 3, (partialDeriv i (P i j) y * A k k j y
                        + P i j y * partialDeriv i (A k k j) y))
              - ∑ j : Fin 3,
                  ((∑ a : Fin 3, ∑ b : Fin 3,
                      (partialDeriv i (P i a) y * Hf a b y * P b j y
                        + P i a y * partialDeriv i (Hf a b) y * P b j y
                        + P i a y * Hf a b y * partialDeriv i (P b j) y)
                    - (partialDeriv i (P i j) y * ∑ a : Fin 3, ∑ b : Fin 3, P a b y * Hf a b y
                        + P i j y * ∑ a : Fin 3, ∑ b : Fin 3,
                          (partialDeriv i (P a b) y * Hf a b y
                            + P a b y * partialDeriv i (Hf a b) y)))
                    * dF j y
                  + (∑ a : Fin 3, ∑ b : Fin 3, P i a y * Hf a b y * P b j y
                      - P i j y * ∑ a : Fin 3, ∑ b : Fin 3, P a b y * Hf a b y)
                    * partialDeriv i (dF j) y)) := by
    intro s F P Hf A dF i hs hF hP hHf hA hdF
    have h := hs.hasFDerivAt.fun_mul
      ((hF.hasFDerivAt.fun_mul
        ((HasFDerivAt.fun_sum (u := Finset.univ) fun (j : Fin 3) _ =>
            HasFDerivAt.fun_sum (u := Finset.univ) fun (k : Fin 3) _ =>
              (hP j k).hasFDerivAt.fun_mul (hA i j k).hasFDerivAt).fun_sub
          (HasFDerivAt.fun_sum (u := Finset.univ) fun (j : Fin 3) _ =>
            HasFDerivAt.fun_sum (u := Finset.univ) fun (k : Fin 3) _ =>
              (hP i j).hasFDerivAt.fun_mul (hA k k j).hasFDerivAt))).fun_sub
        (HasFDerivAt.fun_sum (u := Finset.univ) fun (j : Fin 3) _ =>
          ((HasFDerivAt.fun_sum (u := Finset.univ) fun (a : Fin 3) _ =>
              HasFDerivAt.fun_sum (u := Finset.univ) fun (b : Fin 3) _ =>
                ((hP i a).hasFDerivAt.fun_mul (hHf a b).hasFDerivAt).fun_mul
                  (hP b j).hasFDerivAt).fun_sub
            ((hP i j).hasFDerivAt.fun_mul
              (HasFDerivAt.fun_sum (u := Finset.univ) fun (a : Fin 3) _ =>
                HasFDerivAt.fun_sum (u := Finset.univ) fun (b : Fin 3) _ =>
                  (hP a b).hasFDerivAt.fun_mul (hHf a b).hasFDerivAt))).fun_mul
            (hdF j).hasFDerivAt))
    unfold partialDeriv
    rw [h.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.sub_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul, ContinuousLinearMap.sum_apply]
    simp only [Fin.sum_univ_three]
    ring
  
  have master : ∀ (P Hm Gm Ric hess ddf : Fin 3 → Fin 3 → ℝ)
      (Γ A dP dH : Fin 3 → Fin 3 → Fin 3 → ℝ)
      (dA : Fin 3 → Fin 3 → Fin 3 → Fin 3 → ℝ) (sg f0 lap : ℝ) (dsg df L : Fin 3 → ℝ),
      (∀ a b : Fin 3, P a b = P b a) → (∀ a b : Fin 3, Hm a b = Hm b a) →
      (∀ k i j : Fin 3, Γ k i j = Γ k j i) → (∀ m a b : Fin 3, dH m a b = dH m b a) →
      (∀ m : Fin 3, dsg m = sg * ∑ a : Fin 3, Γ a a m) →
      (∀ m j k : Fin 3, dP m j k = -∑ b : Fin 3, (Γ j b m * P b k + P j b * Γ k b m)) →
      (∀ k i j : Fin 3, A k i j = (1 / 2 : ℝ) * ∑ l : Fin 3, P k l * (dH i j l + dH j i l - dH l i j)
        - ∑ a : Fin 3, ∑ b : Fin 3, P k a * Hm a b * Γ b i j) →
      (∀ a b : Fin 3, Gm a b = Gm b a) →
      (∀ b c : Fin 3, ∑ d : Fin 3, P b d * Gm d c = if b = c then 1 else 0) →
      (∀ c d : Fin 3, hess c d = ddf c d - ∑ k : Fin 3, Γ k c d * df k) →
      (lap = ∑ i : Fin 3, ∑ j : Fin 3, P i j * hess i j) →
      (∀ i : Fin 3, L i =
        dsg i *
            (f0 * (∑ j : Fin 3, ∑ k : Fin 3, P j k * A i j k
                    - ∑ j : Fin 3, ∑ k : Fin 3, P i j * A k k j)
              - ∑ j : Fin 3, (∑ a : Fin 3, ∑ b : Fin 3, P i a * Hm a b * P b j
                    - P i j * ∑ a : Fin 3, ∑ b : Fin 3, P a b * Hm a b) * df j)
          + sg *
            (df i * (∑ j : Fin 3, ∑ k : Fin 3, P j k * A i j k
                    - ∑ j : Fin 3, ∑ k : Fin 3, P i j * A k k j)
              + f0 * (∑ j : Fin 3, ∑ k : Fin 3, (dP i j k * A i j k + P j k * dA i i j k)
                    - ∑ j : Fin 3, ∑ k : Fin 3, (dP i i j * A k k j + P i j * dA i k k j))
              - ∑ j : Fin 3,
                  ((∑ a : Fin 3, ∑ b : Fin 3,
                      (dP i i a * Hm a b * P b j + P i a * dH i a b * P b j
                        + P i a * Hm a b * dP i b j)
                    - (dP i i j * ∑ a : Fin 3, ∑ b : Fin 3, P a b * Hm a b
                        + P i j * ∑ a : Fin 3, ∑ b : Fin 3, (dP i a b * Hm a b + P a b * dH i a b)))
                    * df j
                  + (∑ a : Fin 3, ∑ b : Fin 3, P i a * Hm a b * P b j
                      - P i j * ∑ a : Fin 3, ∑ b : Fin 3, P a b * Hm a b) * ddf i j))) →
      f0 * (- ∑ j : Fin 3, ∑ k : Fin 3,
              (∑ a : Fin 3, ∑ b : Fin 3, P j a * Hm a b * P b k) * Ric j k
            + ∑ j : Fin 3, ∑ k : Fin 3, P j k *
              (∑ i : Fin 3, (dA i i j k - dA j i i k)
                + ∑ i : Fin 3, ∑ p : Fin 3,
                    (A i i p * Γ p j k + Γ i i p * A p j k - A i j p * Γ p i k - Γ i j p * A p i k)))
          * sg =
        -((∑ a : Fin 3, ∑ b : Fin 3, ∑ c : Fin 3, ∑ d : Fin 3,
            P a c * P b d * Hm a b * (f0 * Ric c d - hess c d + lap * Gm c d)) * sg)
        + ∑ i : Fin 3, L i := by
    intro P Hm Gm Ric hess ddf Γ A dP dH dA sg f0 lap dsg df L hP hH hΓ hdH hsg hdP' hA hGm hGP'
      hhess hlap hL
    have p10 := hP 1 0
    have p20 := hP 2 0
    have p21 := hP 2 1
    have h10 := hH 1 0
    have h20 := hH 2 0
    have h21 := hH 2 1
    have g10 : ∀ k, Γ k 1 0 = Γ k 0 1 := fun k => hΓ k 1 0
    have g20 : ∀ k, Γ k 2 0 = Γ k 0 2 := fun k => hΓ k 2 0
    have g21 : ∀ k, Γ k 2 1 = Γ k 1 2 := fun k => hΓ k 2 1
    have e10 : ∀ k, dH k 1 0 = dH k 0 1 := fun k => hdH k 1 0
    have e20 : ∀ k, dH k 2 0 = dH k 0 2 := fun k => hdH k 2 0
    have e21 : ∀ k, dH k 2 1 = dH k 1 2 := fun k => hdH k 2 1
    
    have hPal : sg * ∑ j : Fin 3, ∑ k : Fin 3, P j k *
          (∑ i : Fin 3, (dA i i j k - dA j i i k) +
            ∑ i : Fin 3, ∑ p : Fin 3, (A i i p * Γ p j k + Γ i i p * A p j k
              - A i j p * Γ p i k - Γ i j p * A p i k)) =
        ∑ i : Fin 3, (dsg i * (∑ j : Fin 3, ∑ k : Fin 3, P j k * A i j k
              - ∑ j : Fin 3, ∑ k : Fin 3, P i j * A k k j)
          + sg * ((∑ j : Fin 3, ∑ k : Fin 3, (dP i j k * A i j k + P j k * dA i i j k))
              - ∑ j : Fin 3, ∑ k : Fin 3, (dP i i j * A k k j + P i j * dA i k k j))) := by
      simp only [hsg, hdP']
      simp only [Fin.sum_univ_three, g10, g20, g21]
      ring
    
    have hHess : ∑ i : Fin 3, (-(dsg i * ∑ j : Fin 3, (∑ a : Fin 3, ∑ b : Fin 3,
              P i a * Hm a b * P b j
            - P i j * ∑ a : Fin 3, ∑ b : Fin 3, P a b * Hm a b) * df j)
        + sg * (df i * (∑ j : Fin 3, ∑ k : Fin 3, P j k * A i j k
              - ∑ j : Fin 3, ∑ k : Fin 3, P i j * A k k j)
          - ∑ j : Fin 3, ((∑ a : Fin 3, ∑ b : Fin 3, (dP i i a * Hm a b * P b j
                  + P i a * dH i a b * P b j + P i a * Hm a b * dP i b j)
                - (dP i i j * ∑ a : Fin 3, ∑ b : Fin 3, P a b * Hm a b
                  + P i j * ∑ a : Fin 3, ∑ b : Fin 3, (dP i a b * Hm a b + P a b * dH i a b)))
                * df j
              + (∑ a : Fin 3, ∑ b : Fin 3, P i a * Hm a b * P b j
                  - P i j * ∑ a : Fin 3, ∑ b : Fin 3, P a b * Hm a b) * ddf i j))) =
        -(sg * (∑ a : Fin 3, ∑ b : Fin 3, ∑ c : Fin 3, ∑ d : Fin 3,
              P a c * P b d * Hm a b * hess c d
            - lap * ∑ a : Fin 3, ∑ b : Fin 3, P a b * Hm a b)) := by
      simp only [hlap, hhess]
      simp only [hsg, hdP', hA]
      simp only [Fin.sum_univ_three, p10, p20, p21, h10, h20, h21, g10, g20, g21, e10, e20, e21]
      ring
    
    have hXT : ∑ a : Fin 3, ∑ b : Fin 3, ∑ c : Fin 3, ∑ d : Fin 3,
          P a c * P b d * Hm a b * Ric c d =
        ∑ j : Fin 3, ∑ k : Fin 3, (∑ a : Fin 3, ∑ b : Fin 3, P j a * Hm a b * P b k) * Ric j k := by
      simp only [Fin.sum_univ_three, p10, p20, p21]
      ring
    
    have hTG : ∑ a : Fin 3, ∑ b : Fin 3, ∑ c : Fin 3, ∑ d : Fin 3,
          P a c * P b d * Hm a b * Gm c d =
        ∑ a : Fin 3, ∑ b : Fin 3, P a b * Hm a b := by
      refine Finset.sum_congr rfl fun a _ => Finset.sum_congr rfl fun b _ => ?_
      have h1 : ∑ c : Fin 3, ∑ d : Fin 3, P a c * P b d * Hm a b * Gm c d =
          ∑ c : Fin 3, P a c * Hm a b * ∑ d : Fin 3, P b d * Gm d c := by
        refine Finset.sum_congr rfl fun c _ => ?_
        rw [Finset.mul_sum]
        refine Finset.sum_congr rfl fun d _ => ?_
        rw [hGm c d]
        ring
      rw [h1]
      simp only [hGP', mul_ite, mul_one, mul_zero, Finset.sum_ite_eq, Finset.mem_univ, if_true]
    simp only [hL]
    simp only [Fin.sum_univ_three] at hPal hHess hXT hTG ⊢
    linear_combination f0 * hPal + f0 * sg * hXT + sg * lap * hTG - hHess
  exact master (fun a b => (G y)⁻¹ a b) (fun a b => H y a b) (fun a b => G y a b) (fun j k => ricci G j k y) (fun c d => hessLoc G f c d y)
    (fun i j => partialDeriv i (partialDeriv j f) y) (fun k i j => christoffel G k i j y)
    (fun k i j => fvChristoffelVar G H k i j y)
    (fun m a b => partialDeriv m (fun z => (G z)⁻¹ a b) y)
    (fun m a b => partialDeriv m (fun z => H z a b) y)
    (fun m k i j => partialDeriv m (fvChristoffelVar G H k i j) y)
    (Real.sqrt (G y).det) (f y) (lapLoc G f y)
    (fun m => partialDeriv m (fun z => Real.sqrt (G z).det) y) (fun k => partialDeriv k f y)
    (fun i => partialDeriv i (fvField G H f i) y)
    hPs (hHs y) hΓs hdHs hJac hdP (fun k i j => rfl) (hGs y) hGP (fun c d => rfl) rfl
    (fun i => leib (fun z => Real.sqrt (G z).det) f (fun a b z => (G z)⁻¹ a b)
      (fun a b z => H z a b) (fvChristoffelVar G H) (fun j => partialDeriv j f) i
      hsd hfd hPd hHd hAd hdfd)

theorem first_variation_regularity (G H : E3 → Matrix (Fin 3) (Fin 3) ℝ) (f : E3 → ℝ)
    (U K : Set E3) (hU : IsOpen U) (hKc : IsClosed K)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hGpos : ∀ y ∈ U, 0 < (G y).det)
    (hH : ∀ i j : Fin 3, ContDiff ℝ ∞ (fun y => H y i j)) (hHK : ∀ y, y ∉ K → H y = 0)
    (hf : ContDiffOn ℝ ∞ f U) :
    (∀ i : Fin 3, ContDiffOn ℝ ∞ (fvField G H f i) U) ∧
    (∀ i : Fin 3, ∀ y ∈ U, y ∉ K → fvField G H f i y = 0) ∧
    (∀ c d : Fin 3, ContinuousOn (staticLoc G f c d) U) ∧
    (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ i j) U) ∧
    ContDiffOn ℝ ∞ (fun y => Real.sqrt (G y).det) U :=
by
  classical
  have hdet : ∀ y ∈ U, (G y).det ≠ 0 := fun y hy => (hGpos y hy).ne'
  have hpd : ∀ h : E3 → ℝ, ContDiffOn ℝ ∞ h U → ∀ c : Fin 3,
      ContDiffOn ℝ ∞ (partialDeriv c h) U := by
    intro h hh c
    have hD := ((contDiffOn_infty_iff_fderiv_of_isOpen hU).mp hh).2
    show ContDiffOn ℝ ∞ (fun y => fderiv ℝ h y (e c)) U
    exact hD.clm_apply contDiffOn_const
  have hdetgen : ∀ F : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => F z i j) U) →
      ContDiffOn ℝ ∞ (fun z => (F z).det) U := by
    intro F hF
    simp only [Matrix.det_apply]
    refine ContDiffOn.sum (fun σ _ => ?_)
    simp only [Units.smul_def, zsmul_eq_mul]
    refine contDiffOn_const.mul ?_
    have hp := contDiffOn_prod' (t := (Finset.univ : Finset (Fin 3)))
      (f := fun i z => F z (σ i) i) (s := U) (n := ∞) (fun i _ => hF _ _)
    refine hp.congr (fun z _ => ?_)
    simp [Finset.prod_apply]
  have hadj : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => (G z).adjugate i j) U := by
    intro i j
    simp only [Matrix.adjugate_apply]
    refine hdetgen (fun z => (G z).updateRow j (Pi.single i 1)) ?_
    intro a b
    by_cases hab : a = j
    · subst hab
      simp only [Matrix.updateRow_self]
      exact contDiffOn_const
    · simp only [Matrix.updateRow_ne hab]
      exact hG a b
  have hinv : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun z => (G z)⁻¹ i j) U := by
    intro i j
    have heq : (fun z => (G z)⁻¹ i j) =
        fun z => ((G z).det)⁻¹ * (G z).adjugate i j := by
      funext z
      rw [Matrix.inv_def, Ring.inverse_eq_inv', Matrix.smul_apply, smul_eq_mul]
    rw [heq]
    exact ((hdetgen _ hG).inv hdet).mul (hadj i j)
  have hsq : ContDiffOn ℝ ∞ (fun y => Real.sqrt (G y).det) U :=
    (hdetgen _ hG).sqrt hdet
  have hpar : ∀ a b c : Fin 3,
      ContDiffOn ℝ ∞ (fun y => partialDeriv c (fun z => G z a b) y) U :=
    fun a b c => hpd _ (hG a b) c
  have hΓ : ∀ k i j : Fin 3, ContDiffOn ℝ ∞ (christoffel G k i j) U := by
    intro k i j
    show ContDiffOn ℝ ∞ (fun y => christoffel G k i j y) U
    unfold christoffel
    exact contDiffOn_const.mul (ContDiffOn.sum (fun l _ =>
      (hinv k l).mul (((hpar j l i).add (hpar i l j)).sub (hpar i j l))))
  have hRic : ∀ j k : Fin 3, ContDiffOn ℝ ∞ (ricci G j k) U := by
    intro j k
    show ContDiffOn ℝ ∞ (fun y => ricci G j k y) U
    unfold ricci
    refine (ContDiffOn.sum (fun i _ => ?_)).add
      (ContDiffOn.sum (fun i _ => ContDiffOn.sum (fun p _ =>
        ((hΓ i i p).mul (hΓ p j k)).sub ((hΓ i j p).mul (hΓ p i k)))))
    exact (hpd _ (hΓ i j k) i).sub (hpd _ (hΓ i i k) j)
  have hHU : ∀ a b : Fin 3, ContDiffOn ℝ ∞ (fun y => H y a b) U :=
    fun a b => (hH a b).contDiffOn
  have hdH : ∀ a b c : Fin 3,
      ContDiffOn ℝ ∞ (fun y => partialDeriv c (fun z => H z a b) y) U :=
    fun a b c => hpd _ (hHU a b) c
  have hdf : ∀ j : Fin 3, ContDiffOn ℝ ∞ (partialDeriv j f) U := fun j => hpd f hf j
  have hΓ' : ∀ k i j : Fin 3, ContDiffOn ℝ ∞ (fvChristoffelVar G H k i j) U := by
    intro k i j
    show ContDiffOn ℝ ∞ (fun y => fvChristoffelVar G H k i j y) U
    unfold fvChristoffelVar
    exact (contDiffOn_const.mul (ContDiffOn.sum fun l _ =>
        (hinv k l).mul (((hdH j l i).add (hdH i l j)).sub (hdH i j l)))).sub
      (ContDiffOn.sum fun a _ => ContDiffOn.sum fun b _ =>
        ((hinv k a).mul (hHU a b)).mul (hΓ b i j))
  have hFsm : ∀ i : Fin 3, ContDiffOn ℝ ∞ (fvField G H f i) U := by
    intro i
    have hV : ContDiffOn ℝ ∞ (fun y =>
        ∑ j : Fin 3, ∑ k : Fin 3, (G y)⁻¹ j k * fvChristoffelVar G H i j k y
          - ∑ j : Fin 3, ∑ k : Fin 3, (G y)⁻¹ i j * fvChristoffelVar G H k k j y) U :=
      (ContDiffOn.sum fun j _ => ContDiffOn.sum fun k _ => (hinv j k).mul (hΓ' i j k)).sub
        (ContDiffOn.sum fun j _ => ContDiffOn.sum fun k _ => (hinv i j).mul (hΓ' k k j))
    have hN : ∀ j : Fin 3, ContDiffOn ℝ ∞ (fun y =>
        (∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ i a * H y a b * (G y)⁻¹ b j
          - (G y)⁻¹ i j * ∑ a : Fin 3, ∑ b : Fin 3, (G y)⁻¹ a b * H y a b)
          * partialDeriv j f y) U := by
      intro j
      exact ((ContDiffOn.sum fun a _ => ContDiffOn.sum fun b _ =>
          ((hinv i a).mul (hHU a b)).mul (hinv b j)).sub
        ((hinv i j).mul (ContDiffOn.sum fun a _ => ContDiffOn.sum fun b _ =>
          (hinv a b).mul (hHU a b)))).mul (hdf j)
    show ContDiffOn ℝ ∞ (fun y => fvField G H f i y) U
    unfold fvField
    exact hsq.mul ((hf.mul hV).sub (ContDiffOn.sum fun j _ => hN j))
  have hHess : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (hessLoc G f i j) U := by
    intro i j
    show ContDiffOn ℝ ∞ (fun y => hessLoc G f i j y) U
    unfold hessLoc
    exact (hpd _ (hdf j) i).sub (ContDiffOn.sum (fun k _ => (hΓ k i j).mul (hdf k)))
  have hLap : ContDiffOn ℝ ∞ (lapLoc G f) U := by
    show ContDiffOn ℝ ∞ (fun y => lapLoc G f y) U
    unfold lapLoc
    exact ContDiffOn.sum (fun i _ => ContDiffOn.sum (fun j _ => (hinv i j).mul (hHess i j)))
  have hSt : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (staticLoc G f i j) U := by
    intro i j
    show ContDiffOn ℝ ∞ (fun y => staticLoc G f i j y) U
    unfold staticLoc
    exact ((hf.mul (hRic i j)).sub (hHess i j)).add (hLap.mul (hG i j))
  have hF0 : ∀ i : Fin 3, ∀ y ∈ U, y ∉ K → fvField G H f i y = 0 := by
    intro i y _ hyK
    have hnhds : Kᶜ ∈ 𝓝 y := hKc.isOpen_compl.mem_nhds hyK
    have hb2 : ∀ a b : Fin 3, H y a b = 0 := by
      intro a b; rw [hHK y hyK]; rfl
    have hb3 : ∀ a b c : Fin 3, partialDeriv c (fun z => H z a b) y = 0 := by
      intro a b c
      have hev : (fun z => H z a b) =ᶠ[𝓝 y] (fun _ => (0 : ℝ)) := by
        filter_upwards [hnhds] with z hz
        rw [hHK z hz]; rfl
      show fderiv ℝ (fun z => H z a b) y (e c) = 0
      rw [hev.fderiv_eq, fderiv_const_apply]
      rfl
    have hb4 : ∀ k i' j : Fin 3, fvChristoffelVar G H k i' j y = 0 := by
      intro k i' j
      unfold fvChristoffelVar
      simp [hb2, hb3]
    unfold fvField
    simp [hb2, hb4]
  exact ⟨hFsm, hF0, fun c d => (hSt c d).continuousOn, hinv, hsq⟩

theorem flux_integral_estimate (U K : Set E3) (hU : IsOpen U) (hK : IsCompact K) (hKU : K ⊆ U)
    (φ ρ δ σ σ₀ u : E3 → ℝ) (M : Fin 3 → Fin 3 → E3 → ℝ) (t P Q C₂ C₃ D B₀ : ℝ)
    (ht : 0 < t) (hP : 0 ≤ P) (hQ : 0 ≤ Q) (hC₂ : 0 ≤ C₂) (hC₃ : 0 ≤ C₃) (hD : 0 ≤ D)
    (hB₀ : 0 ≤ B₀)
    (hφc : ContinuousOn φ K) (hdφc : ∀ i : Fin 3, ContinuousOn (partialDeriv i φ) K)
    (hρc : ContinuousOn ρ K) (hδc : ContinuousOn δ K) (hσc : ContinuousOn σ K)
    (hσ₀c : ContinuousOn σ₀ K) (hMc : ∀ i j : Fin 3, ContinuousOn (M i j) K)
    (hu : ContDiffOn ℝ 1 u U)
    (hφb : ∀ y ∈ K, |φ y| ≤ P ∧ ∀ i : Fin 3, |partialDeriv i φ y| ≤ P)
    (hσb : ∀ y ∈ K, |σ y| ≤ Q)
    (hρb : ∀ y ∈ K, |ρ y - t * δ y| ≤ C₂ * t ^ 2 ∧ |ρ y| ≤ C₃ * t ∧ |δ y| ≤ D)
    (hσσ : ∀ y ∈ K, |σ y - σ₀ y| ≤ C₂ * t)
    (hMb : ∀ y ∈ K, ∀ i j : Fin 3, |M i j y| ≤ C₂ * t)
    (hint : ∫ y in K, (|u y| + ‖fderiv ℝ u y‖) ≤ B₀ * t) :
    |(∫ y in K, (φ y * (ρ y * (1 + u y) / 8) * σ y +
        ∑ i : Fin 3, ∑ j : Fin 3, M i j y * partialDeriv i φ y * partialDeriv j u y))
      - t / 8 * ∫ y in K, φ y * δ y * σ₀ y|
      ≤ (MeasureTheory.volume.real K * P * C₂ * (Q + D) / 8 + P * C₃ * Q * B₀ / 8
          + 9 * C₂ * P * B₀) * t ^ 2 :=
by
  classical
  have hKm : MeasurableSet K := hK.measurableSet
  have huc : ContinuousOn u K := hu.continuousOn.mono hKU
  have hdu : ContinuousOn (fun y => fderiv ℝ u y) K :=
    (hu.continuousOn_fderiv_of_isOpen hU le_rfl).mono hKU
  have hduj : ∀ j : Fin 3, ContinuousOn (partialDeriv j u) K := by
    intro j
    show ContinuousOn (fun y => fderiv ℝ u y (e j)) K
    exact hdu.clm_apply continuousOn_const
  have hwc : ContinuousOn (fun y => |u y| + ‖fderiv ℝ u y‖) K := huc.abs.add hdu.norm
  have hFc : ContinuousOn (fun y => φ y * (ρ y * (1 + u y) / 8) * σ y +
        ∑ i : Fin 3, ∑ j : Fin 3, M i j y * partialDeriv i φ y * partialDeriv j u y) K := by
    refine ContinuousOn.add ?_ ?_
    · exact (hφc.mul ((hρc.mul (continuousOn_const.add huc)).div_const 8)).mul hσc
    · exact continuousOn_finset_sum _ fun i _ => continuousOn_finset_sum _ fun j _ =>
        ((hMc i j).mul (hdφc i)).mul (hduj j)
  have hGc : ContinuousOn (fun y => φ y * δ y * σ₀ y) K := (hφc.mul hδc).mul hσ₀c
  have hpd : ∀ (y : E3) (j : Fin 3), |partialDeriv j u y| ≤ ‖fderiv ℝ u y‖ := by
    intro y j
    have h1 := (fderiv ℝ u y).le_opNorm (e j)
    have h2 : ‖(e j : E3)‖ = 1 := by simp [e, EuclideanSpace.norm_single]
    rw [h2, mul_one] at h1
    rw [← Real.norm_eq_abs]
    exact h1
  have hC₂t : 0 ≤ C₂ * t := mul_nonneg hC₂ ht.le
  have hb0 : 0 ≤ (P * C₃ * Q / 8 + 9 * C₂ * P) * t := by
    have h1 : 0 ≤ P * C₃ * Q / 8 := by
      have := mul_nonneg (mul_nonneg hP hC₃) hQ
      linarith
    have h2 : 0 ≤ 9 * C₂ * P := mul_nonneg (mul_nonneg (by norm_num) hC₂) hP
    exact mul_nonneg (add_nonneg h1 h2) ht.le
  
  have hpt : ∀ y ∈ K, ‖(φ y * (ρ y * (1 + u y) / 8) * σ y +
        ∑ i : Fin 3, ∑ j : Fin 3, M i j y * partialDeriv i φ y * partialDeriv j u y)
        - t / 8 * (φ y * δ y * σ₀ y)‖ ≤ P * C₂ * (Q + D) / 8 * t ^ 2 +
          (P * C₃ * Q / 8 + 9 * C₂ * P) * t * (|u y| + ‖fderiv ℝ u y‖) := by
    intro y hy
    rw [Real.norm_eq_abs]
    obtain ⟨hφ, hdφ⟩ := hφb y hy
    have hσ := hσb y hy
    obtain ⟨hρδ, hρ, hδ⟩ := hρb y hy
    have hss := hσσ y hy
    have hN0 : 0 ≤ ‖fderiv ℝ u y‖ := norm_nonneg _
    have hu0 : 0 ≤ |u y| := abs_nonneg _
    set S := ∑ i : Fin 3, ∑ j : Fin 3, M i j y * partialDeriv i φ y * partialDeriv j u y with hS
    have hid : (φ y * (ρ y * (1 + u y) / 8) * σ y + S) - t / 8 * (φ y * δ y * σ₀ y) =
        φ y * (ρ y - t * δ y) * σ y / 8 + φ y * t * δ y * (σ y - σ₀ y) / 8 +
          φ y * ρ y * u y * σ y / 8 + S := by ring
    have h8 : |(8 : ℝ)| = 8 := abs_of_pos (by norm_num)
    have e1 : |φ y * (ρ y - t * δ y) * σ y / 8| ≤ P * (C₂ * t ^ 2) * Q / 8 := by
      have hp : |φ y| * |ρ y - t * δ y| * |σ y| ≤ P * (C₂ * t ^ 2) * Q :=
        mul_le_mul (mul_le_mul hφ hρδ (abs_nonneg _) hP) hσ (abs_nonneg _)
          (mul_nonneg hP (mul_nonneg hC₂ (sq_nonneg t)))
      rw [abs_div, abs_mul, abs_mul, h8]
      linarith
    have e2 : |φ y * t * δ y * (σ y - σ₀ y) / 8| ≤ P * t * D * (C₂ * t) / 8 := by
      have hp : |φ y| * t * |δ y| * |σ y - σ₀ y| ≤ P * t * D * (C₂ * t) :=
        mul_le_mul (mul_le_mul (mul_le_mul hφ le_rfl ht.le hP) hδ (abs_nonneg _)
          (mul_nonneg hP ht.le)) hss (abs_nonneg _) (mul_nonneg (mul_nonneg hP ht.le) hD)
      rw [abs_div, abs_mul, abs_mul, abs_mul, abs_of_pos ht, h8]
      linarith
    have e3 : |φ y * ρ y * u y * σ y / 8| ≤ P * (C₃ * t) * |u y| * Q / 8 := by
      have hp : |φ y| * |ρ y| * |u y| * |σ y| ≤ P * (C₃ * t) * |u y| * Q :=
        mul_le_mul (mul_le_mul (mul_le_mul hφ hρ (abs_nonneg _) hP) le_rfl hu0
          (mul_nonneg hP (mul_nonneg hC₃ ht.le))) hσ (abs_nonneg _)
          (mul_nonneg (mul_nonneg hP (mul_nonneg hC₃ ht.le)) hu0)
      rw [abs_div, abs_mul, abs_mul, abs_mul, h8]
      linarith
    have eS : |S| ≤ 9 * (C₂ * t * P * ‖fderiv ℝ u y‖) := by
      have hterm : ∀ i j : Fin 3,
          |M i j y * partialDeriv i φ y * partialDeriv j u y| ≤ C₂ * t * P * ‖fderiv ℝ u y‖ := by
        intro i j
        rw [abs_mul, abs_mul]
        exact mul_le_mul (mul_le_mul (hMb y hy i j) (hdφ i) (abs_nonneg _) hC₂t) (hpd y j)
          (abs_nonneg _) (mul_nonneg hC₂t hP)
      rw [hS]
      calc |∑ i : Fin 3, ∑ j : Fin 3, M i j y * partialDeriv i φ y * partialDeriv j u y|
          ≤ ∑ i : Fin 3, |∑ j : Fin 3, M i j y * partialDeriv i φ y * partialDeriv j u y| :=
            Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ i : Fin 3, ∑ j : Fin 3, |M i j y * partialDeriv i φ y * partialDeriv j u y| :=
            Finset.sum_le_sum fun i _ => Finset.abs_sum_le_sum_abs _ _
        _ ≤ ∑ i : Fin 3, ∑ j : Fin 3, C₂ * t * P * ‖fderiv ℝ u y‖ :=
            Finset.sum_le_sum fun i _ => Finset.sum_le_sum fun j _ => hterm i j
        _ = 9 * (C₂ * t * P * ‖fderiv ℝ u y‖) := by
            simp only [Fin.sum_univ_three]; ring
    have tri : |φ y * (ρ y - t * δ y) * σ y / 8 + φ y * t * δ y * (σ y - σ₀ y) / 8 +
          φ y * ρ y * u y * σ y / 8 + S| ≤
        |φ y * (ρ y - t * δ y) * σ y / 8| + |φ y * t * δ y * (σ y - σ₀ y) / 8| +
          |φ y * ρ y * u y * σ y / 8| + |S| := by
      have a1 := abs_add_le (φ y * (ρ y - t * δ y) * σ y / 8 + φ y * t * δ y * (σ y - σ₀ y) / 8 +
          φ y * ρ y * u y * σ y / 8) S
      have a2 := abs_add_le (φ y * (ρ y - t * δ y) * σ y / 8 + φ y * t * δ y * (σ y - σ₀ y) / 8)
          (φ y * ρ y * u y * σ y / 8)
      have a3 := abs_add_le (φ y * (ρ y - t * δ y) * σ y / 8) (φ y * t * δ y * (σ y - σ₀ y) / 8)
      linarith
    have n1 : 0 ≤ P * C₃ * Q * t * ‖fderiv ℝ u y‖ :=
      mul_nonneg (mul_nonneg (mul_nonneg (mul_nonneg hP hC₃) hQ) ht.le) hN0
    have n2 : 0 ≤ C₂ * P * t * |u y| :=
      mul_nonneg (mul_nonneg (mul_nonneg hC₂ hP) ht.le) hu0
    rw [hid]
    linarith [tri, e1, e2, e3, eS, n1, n2]
  
  have hFi : IntegrableOn (fun y => φ y * (ρ y * (1 + u y) / 8) * σ y +
        ∑ i : Fin 3, ∑ j : Fin 3, M i j y * partialDeriv i φ y * partialDeriv j u y) K :=
    hFc.integrableOn_compact hK
  have hGi : IntegrableOn (fun y => φ y * δ y * σ₀ y) K := hGc.integrableOn_compact hK
  have hwi : IntegrableOn (fun y => |u y| + ‖fderiv ℝ u y‖) K := hwc.integrableOn_compact hK
  have hci : IntegrableOn (fun _ : E3 => P * C₂ * (Q + D) / 8 * t ^ 2) K :=
    continuousOn_const.integrableOn_compact hK
  have hlin : (∫ y in K, (φ y * (ρ y * (1 + u y) / 8) * σ y +
        ∑ i : Fin 3, ∑ j : Fin 3, M i j y * partialDeriv i φ y * partialDeriv j u y))
      - t / 8 * ∫ y in K, φ y * δ y * σ₀ y =
      ∫ y in K, ((φ y * (ρ y * (1 + u y) / 8) * σ y +
        ∑ i : Fin 3, ∑ j : Fin 3, M i j y * partialDeriv i φ y * partialDeriv j u y)
        - t / 8 * (φ y * δ y * σ₀ y)) := by
    rw [← integral_const_mul]
    exact (integral_sub hFi (hGi.const_mul (t / 8))).symm
  have hgi : Integrable (fun y => P * C₂ * (Q + D) / 8 * t ^ 2 +
      (P * C₃ * Q / 8 + 9 * C₂ * P) * t * (|u y| + ‖fderiv ℝ u y‖)) (volume.restrict K) :=
    hci.add (hwi.const_mul _)
  have hnorm := norm_integral_le_of_norm_le hgi (ae_restrict_of_forall_mem hKm hpt)
  have hgeq : ∫ y in K, (P * C₂ * (Q + D) / 8 * t ^ 2 +
      (P * C₃ * Q / 8 + 9 * C₂ * P) * t * (|u y| + ‖fderiv ℝ u y‖)) =
      MeasureTheory.volume.real K * (P * C₂ * (Q + D) / 8 * t ^ 2) +
        (P * C₃ * Q / 8 + 9 * C₂ * P) * t * ∫ y in K, (|u y| + ‖fderiv ℝ u y‖) := by
    rw [integral_add hci (hwi.const_mul _), setIntegral_const, integral_const_mul, smul_eq_mul]
  rw [hgeq, Real.norm_eq_abs] at hnorm
  have hfin : (P * C₃ * Q / 8 + 9 * C₂ * P) * t * ∫ y in K, (|u y| + ‖fderiv ℝ u y‖) ≤
      (P * C₃ * Q / 8 + 9 * C₂ * P) * t * (B₀ * t) := mul_le_mul_of_nonneg_left hint hb0
  rw [hlin]
  calc _ ≤ MeasureTheory.volume.real K * (P * C₂ * (Q + D) / 8 * t ^ 2) +
        (P * C₃ * Q / 8 + 9 * C₂ * P) * t * ∫ y in K, (|u y| + ‖fderiv ℝ u y‖) := hnorm
    _ ≤ MeasureTheory.volume.real K * (P * C₂ * (Q + D) / 8 * t ^ 2) +
        (P * C₃ * Q / 8 + 9 * C₂ * P) * t * (B₀ * t) := by linarith
    _ = (MeasureTheory.volume.real K * P * C₂ * (Q + D) / 8 + P * C₃ * Q * B₀ / 8
          + 9 * C₂ * P * B₀) * t ^ 2 := by ring

theorem flux_first_order_expansion (G H : E3 → Matrix (Fin 3) (Fin 3) ℝ) (f : E3 → ℝ)
    (U K : Set E3) (hU : IsOpen U) (hK : IsCompact K) (hKU : K ⊆ U)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U)
    (hGs : ∀ y i j, G y i j = G y j i) (hGpos : ∀ y ∈ U, 0 < (G y).det)
    (hR : ∀ y ∈ U, scalarCurvatureLocal G y = 0)
    (hH : ∀ i j : Fin 3, ContDiff ℝ ∞ (fun y => H y i j)) (hHs : ∀ y i j, H y i j = H y j i)
    (hHK : ∀ y, y ∉ K → H y = 0) (hf : ContDiffOn ℝ ∞ f U) :
    ∃ t₂ C₃ : ℝ, 0 < t₂ ∧ 0 ≤ C₃ ∧
      (∀ t : ℝ, |t| ≤ t₂ → ∀ y ∈ K,
        |scalarCurvatureLocal (fun z => G z + t • H z) y| ≤ C₃ * |t|) ∧
      ∀ B₀ : ℝ, 0 ≤ B₀ → ∃ C₄ : ℝ, 0 ≤ C₄ ∧ ∀ t : ℝ, 0 < t → t ≤ t₂ →
        ∀ u : E3 → ℝ, ContDiffOn ℝ 1 u U →
          ∫ y in K, (|u y| + ‖fderiv ℝ u y‖) ≤ B₀ * t →
          |(∫ y in K, (f y * (scalarCurvatureLocal (fun z => G z + t • H z) y * (1 + u y) / 8) *
                Real.sqrt (G y + t • H y).det +
              ∑ i : Fin 3, ∑ j : Fin 3,
                ((G y + t • H y)⁻¹ i j * Real.sqrt (G y + t • H y).det -
                  (G y)⁻¹ i j * Real.sqrt (G y).det) * partialDeriv i f y * partialDeriv j u y))
            - t / 8 * (-∫ y in K, (∑ a : Fin 3, ∑ b : Fin 3, ∑ c : Fin 3, ∑ d : Fin 3,
                (G y)⁻¹ a c * (G y)⁻¹ b d * H y a b * staticLoc G f c d y) *
                Real.sqrt (G y).det)| ≤ C₄ * t ^ 2 :=
by
  classical
  
  have hGc : ∀ i j : Fin 3, ContinuousOn (fun y => G y i j) K :=
    fun i j => (hG i j).continuousOn.mono hKU
  have hHc : ∀ i j : Fin 3, ContinuousOn (fun y => H y i j) K :=
    fun i j => (hH i j).continuous.continuousOn
  obtain ⟨t₁a, Ca, ht₁a, ht₁a1, hCa, hs1⟩ :=
    sqrt_det_perturbation G H K hK hGc hHc (fun y hy => hGpos y (hKU hy))
  
  obtain ⟨hWo, -, hΦ⟩ := perturbed_curvature_contDiffOn G H U hU hG hH
  have hKW : ∀ y ∈ K,
      ((0 : ℝ), y) ∈ {p : ℝ × E3 | p.2 ∈ U ∧ (G p.2 + p.1 • H p.2).det ≠ 0} := by
    intro y hy
    show y ∈ U ∧ (G y + (0 : ℝ) • H y).det ≠ 0
    refine ⟨hKU hy, ?_⟩
    rw [zero_smul, add_zero]
    exact (hGpos y (hKU hy)).ne'
  obtain ⟨t₁b, Cb, ht₁b, hCb, hDRc, hTay⟩ :=
    param_taylor_compact
      (fun p : ℝ × E3 => scalarCurvatureLocal (fun z => G z + p.1 • H z) p.2) _ hWo
      (hΦ.of_le (WithTop.coe_le_coe.2 le_top)) K hK hKW
  obtain ⟨DR, hDRdef⟩ : ∃ DR : E3 → ℝ,
      DR = fun y => deriv (fun s : ℝ => scalarCurvatureLocal (fun z => G z + s • H z) y) 0 :=
    ⟨_, rfl⟩
  have hDRc' : ContinuousOn DR K := by rw [hDRdef]; exact hDRc
  have hR0 : ∀ y ∈ K, scalarCurvatureLocal (fun z => G z + (0 : ℝ) • H z) y = 0 := by
    intro y hy
    have h : (fun z => G z + (0 : ℝ) • H z) = G := by
      funext z; rw [zero_smul, add_zero]
    rw [h]; exact hR y (hKU hy)
  have hTay' : ∀ t : ℝ, |t| ≤ t₁b → ∀ y ∈ K,
      |scalarCurvatureLocal (fun z => G z + t • H z) y - t * DR y| ≤ Cb * t ^ 2 := by
    intro t ht y hy
    have h : |scalarCurvatureLocal (fun z => G z + t • H z) y
        - scalarCurvatureLocal (fun z => G z + (0 : ℝ) • H z) y - t * DR y| ≤ Cb * t ^ 2 := by
      rw [hDRdef]; exact (hTay t ht y hy).2
    rw [hR0 y hy, sub_zero] at h
    exact h
  
  obtain ⟨D₀, hD₀⟩ := hK.exists_bound_of_continuousOn hDRc'
  obtain ⟨D, hDdef⟩ : ∃ D : ℝ, D = max D₀ 0 := ⟨_, rfl⟩
  have hD : 0 ≤ D := by rw [hDdef]; exact le_max_right _ _
  have hDb : ∀ y ∈ K, |DR y| ≤ D := by
    intro y hy
    have h := hD₀ y hy
    rw [Real.norm_eq_abs] at h
    rw [hDdef]; exact h.trans (le_max_left _ _)
  
  obtain ⟨C₂, hC₂def⟩ : ∃ C₂ : ℝ, C₂ = max Ca Cb := ⟨_, rfl⟩
  have hCaC₂ : Ca ≤ C₂ := by rw [hC₂def]; exact le_max_left _ _
  have hCbC₂ : Cb ≤ C₂ := by rw [hC₂def]; exact le_max_right _ _
  have hC₂ : 0 ≤ C₂ := hCa.trans hCaC₂
  have hC₃ : 0 ≤ D + C₂ := add_nonneg hD hC₂
  
  have hcl1 : ∀ t : ℝ, |t| ≤ min t₁a t₁b → ∀ y ∈ K,
      |scalarCurvatureLocal (fun z => G z + t • H z) y| ≤ (D + C₂) * |t| := by
    intro t ht y hy
    have hta : |t| ≤ t₁a := ht.trans (min_le_left _ _)
    have htb : |t| ≤ t₁b := ht.trans (min_le_right _ _)
    have h1 := hTay' t htb y hy
    have h2 := hDb y hy
    have ht1 : |t| ≤ 1 := hta.trans ht₁a1
    have hsq : t ^ 2 ≤ |t| := by
      nlinarith [mul_nonneg (abs_nonneg t) (sub_nonneg.2 ht1), sq_abs t]
    have h3 : |scalarCurvatureLocal (fun z => G z + t • H z) y| ≤
        |scalarCurvatureLocal (fun z => G z + t • H z) y - t * DR y| + |t| * |DR y| := by
      have h := abs_sub_abs_le_abs_sub (scalarCurvatureLocal (fun z => G z + t • H z) y)
        (t * DR y)
      rw [abs_mul] at h
      linarith
    have h4 : |t| * |DR y| ≤ |t| * D := mul_le_mul_of_nonneg_left h2 (abs_nonneg t)
    have h5 : Cb * t ^ 2 ≤ Cb * |t| := mul_le_mul_of_nonneg_left hsq hCb
    have h6 : Cb * |t| ≤ C₂ * |t| := mul_le_mul_of_nonneg_right hCbC₂ (abs_nonneg t)
    nlinarith
  
  obtain ⟨hFsm, hF0, hstc, hPsm, hsqsm⟩ :=
    first_variation_regularity G H f U K hU hK.isClosed hG hGpos hH hHK hf
  have hfv := first_variation_divergence_pointwise G H f U hU hG hGs hGpos hH hHs hf
  have hderiv := scalar_first_variation_hasDerivAt G H U hU hG hGs hGpos hH hHs
  have hDReq : ∀ y ∈ U, DR y = fvScalarVar G H y := by
    intro y hy
    rw [hDRdef]
    exact (hderiv y hy).deriv
  have hKm : MeasurableSet K := hK.measurableSet
  have hXc : ContinuousOn (fun y => (∑ a : Fin 3, ∑ b : Fin 3, ∑ c : Fin 3, ∑ d : Fin 3,
      (G y)⁻¹ a c * (G y)⁻¹ b d * H y a b * staticLoc G f c d y) * Real.sqrt (G y).det) K := by
    refine ContinuousOn.mul ?_ (hsqsm.continuousOn.mono hKU)
    refine continuousOn_finset_sum _ fun a _ => continuousOn_finset_sum _ fun b _ =>
      continuousOn_finset_sum _ fun c _ => continuousOn_finset_sum _ fun d _ => ?_
    exact ((((hPsm a c).continuousOn.mono hKU).mul ((hPsm b d).continuousOn.mono hKU)).mul
      (hHc a b)).mul ((hstc c d).mono hKU)
  have hdivc : ContinuousOn (fun y => ∑ i : Fin 3, partialDeriv i (fvField G H f i) y) K := by
    refine continuousOn_finset_sum _ fun i _ => ?_
    have h1 : ContinuousOn (fun y => fderiv ℝ (fvField G H f i) y) U :=
      (hFsm i).continuousOn_fderiv_of_isOpen hU (by exact_mod_cast le_top)
    show ContinuousOn (fun y => fderiv ℝ (fvField G H f i) y (e i)) K
    exact (h1.clm_apply continuousOn_const).mono hKU
  have hI10 : ∫ y in K, f y * DR y * Real.sqrt (G y).det =
      -∫ y in K, (∑ a : Fin 3, ∑ b : Fin 3, ∑ c : Fin 3, ∑ d : Fin 3,
        (G y)⁻¹ a c * (G y)⁻¹ b d * H y a b * staticLoc G f c d y) * Real.sqrt (G y).det := by
    have h1 : ∫ y in K, f y * DR y * Real.sqrt (G y).det =
        ∫ y in K, ((∑ i : Fin 3, partialDeriv i (fvField G H f i) y) -
          (∑ a : Fin 3, ∑ b : Fin 3, ∑ c : Fin 3, ∑ d : Fin 3,
            (G y)⁻¹ a c * (G y)⁻¹ b d * H y a b * staticLoc G f c d y) *
              Real.sqrt (G y).det) := by
      refine setIntegral_congr_fun hKm fun y hy => ?_
      rw [hDReq y (hKU hy), hfv y (hKU hy)]
      ring
    rw [h1, integral_sub (hdivc.integrableOn_compact hK) (hXc.integrableOn_compact hK),
      divergence_setIntegral_eq_zero U K hU hK hKU (fvField G H f)
        (fun i => (hFsm i).of_le (by exact_mod_cast le_top)) hF0, zero_sub]
  
  have hdfU : ∀ i : Fin 3, ContinuousOn (partialDeriv i f) U := by
    intro i
    have h1 : ContinuousOn (fun y => fderiv ℝ f y) U :=
      hf.continuousOn_fderiv_of_isOpen hU (by exact_mod_cast le_top)
    show ContinuousOn (fun y => fderiv ℝ f y (e i)) U
    exact h1.clm_apply continuousOn_const
  obtain ⟨P₀, hP₀⟩ := hK.exists_bound_of_continuousOn (hf.continuousOn.mono hKU)
  have hPi : ∀ i : Fin 3, ∃ C : ℝ, ∀ y ∈ K, ‖partialDeriv i f y‖ ≤ C :=
    fun i => hK.exists_bound_of_continuousOn ((hdfU i).mono hKU)
  choose Pd hPd using hPi
  obtain ⟨PP, hPPdef⟩ : ∃ PP : ℝ, PP = max P₀ 0 + ∑ j : Fin 3, |Pd j| := ⟨_, rfl⟩
  have hPPs : 0 ≤ ∑ j : Fin 3, |Pd j| := Finset.sum_nonneg fun j _ => abs_nonneg _
  have hPP : 0 ≤ PP := by rw [hPPdef]; exact add_nonneg (le_max_right _ _) hPPs
  have hPb : ∀ y ∈ K, |f y| ≤ PP ∧ ∀ i : Fin 3, |partialDeriv i f y| ≤ PP := by
    intro y hy
    refine ⟨?_, fun i => ?_⟩
    · have h := hP₀ y hy
      rw [Real.norm_eq_abs] at h
      rw [hPPdef]
      linarith [le_max_left P₀ 0]
    · have h := hPd i y hy
      rw [Real.norm_eq_abs] at h
      have hsum : Pd i ≤ ∑ j : Fin 3, |Pd j| :=
        (le_abs_self _).trans (Finset.single_le_sum (f := fun j => |Pd j|)
          (fun j _ => abs_nonneg _) (Finset.mem_univ i))
      rw [hPPdef]
      linarith [le_max_right P₀ 0]
  refine ⟨min t₁a t₁b, D + C₂, lt_min ht₁a ht₁b, hC₃, hcl1, ?_⟩
  intro B₀ hB₀
  have hC₄ : 0 ≤ MeasureTheory.volume.real K * PP * C₂ * (Ca + D) / 8 + PP * (D + C₂) * Ca * B₀ / 8
      + 9 * C₂ * PP * B₀ := by
    have hv : 0 ≤ MeasureTheory.volume.real K := MeasureTheory.measureReal_nonneg
    have a1 : 0 ≤ MeasureTheory.volume.real K * PP * C₂ * (Ca + D) / 8 :=
      div_nonneg (mul_nonneg (mul_nonneg (mul_nonneg hv hPP) hC₂) (add_nonneg hCa hD))
        (by norm_num)
    have a2 : 0 ≤ PP * (D + C₂) * Ca * B₀ / 8 :=
      div_nonneg (mul_nonneg (mul_nonneg (mul_nonneg hPP hC₃) hCa) hB₀) (by norm_num)
    have a3 : 0 ≤ 9 * C₂ * PP * B₀ :=
      mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) hC₂) hPP) hB₀
    linarith
  refine ⟨_, hC₄, ?_⟩
  intro t ht0 htt u hu hint
  have htabs : |t| = t := abs_of_pos ht0
  have htm : |t| ≤ min t₁a t₁b := by rw [htabs]; exact htt
  have hta : |t| ≤ t₁a := htm.trans (min_le_left _ _)
  have htb : |t| ≤ t₁b := htm.trans (min_le_right _ _)
  obtain ⟨hsqc, hPtc, hpt⟩ := hs1 t hta
  have hρc : ContinuousOn (fun y => scalarCurvatureLocal (fun z => G z + t • H z) y) K := by
    have hmaps : Set.MapsTo (fun y : E3 => (t, y)) K
        {p : ℝ × E3 | p.2 ∈ U ∧ (G p.2 + p.1 • H p.2).det ≠ 0} := by
      intro y hy
      show y ∈ U ∧ (G y + t • H y).det ≠ 0
      exact ⟨hKU hy, (hpt y hy).1.ne'⟩
    have hcont : ContinuousOn (fun y : E3 => ((t, y) : ℝ × E3)) K :=
      (Continuous.prodMk (continuous_const (y := t)) continuous_id).continuousOn
    have hcomp := ContinuousOn.comp
      (g := fun p : ℝ × E3 => scalarCurvatureLocal (fun z => G z + p.1 • H z) p.2)
      (f := fun y : E3 => ((t, y) : ℝ × E3)) hΦ.continuousOn hcont hmaps
    refine hcomp.congr ?_
    intro y _
    rfl
  have hMc : ∀ i j : Fin 3, ContinuousOn (fun y => (G y + t • H y)⁻¹ i j *
      Real.sqrt (G y + t • H y).det - (G y)⁻¹ i j * Real.sqrt (G y).det) K := fun i j =>
    ((hPtc i j).mul hsqc).sub
      (((hPsm i j).continuousOn.mono hKU).mul (hsqsm.continuousOn.mono hKU))
  have hσb : ∀ y ∈ K, |Real.sqrt (G y + t • H y).det| ≤ Ca := by
    intro y hy
    rw [abs_of_nonneg (Real.sqrt_nonneg _)]
    exact (hpt y hy).2.1
  have hρb : ∀ y ∈ K, |scalarCurvatureLocal (fun z => G z + t • H z) y - t * DR y| ≤ C₂ * t ^ 2 ∧
      |scalarCurvatureLocal (fun z => G z + t • H z) y| ≤ (D + C₂) * t ∧ |DR y| ≤ D := by
    intro y hy
    refine ⟨(hTay' t htb y hy).trans (mul_le_mul_of_nonneg_right hCbC₂ (sq_nonneg t)), ?_,
      hDb y hy⟩
    have h := hcl1 t htm y hy
    rw [htabs] at h
    exact h
  have hσσ : ∀ y ∈ K, |Real.sqrt (G y + t • H y).det - Real.sqrt (G y).det| ≤ C₂ * t := by
    intro y hy
    have h := (hpt y hy).2.2.1
    rw [htabs] at h
    exact h.trans (mul_le_mul_of_nonneg_right hCaC₂ ht0.le)
  have hMb : ∀ y ∈ K, ∀ i j : Fin 3, |(G y + t • H y)⁻¹ i j *
      Real.sqrt (G y + t • H y).det - (G y)⁻¹ i j * Real.sqrt (G y).det| ≤ C₂ * t := by
    intro y hy i j
    have h := (hpt y hy).2.2.2 i j
    rw [htabs] at h
    exact h.trans (mul_le_mul_of_nonneg_right hCaC₂ ht0.le)
  have key := flux_integral_estimate U K hU hK hKU f
    (fun y => scalarCurvatureLocal (fun z => G z + t • H z) y) DR
    (fun y => Real.sqrt (G y + t • H y).det) (fun y => Real.sqrt (G y).det) u
    (fun i j y => (G y + t • H y)⁻¹ i j * Real.sqrt (G y + t • H y).det -
      (G y)⁻¹ i j * Real.sqrt (G y).det)
    t PP Ca C₂ (D + C₂) D B₀ ht0 hPP hCa hC₂ hC₃ hD hB₀
    (hf.continuousOn.mono hKU) (fun i => (hdfU i).mono hKU) hρc hDRc' hsqc
    (hsqsm.continuousOn.mono hKU) hMc hu hPb hσb hρb hσσ hMb hint
  beta_reduce at key
  rw [← hI10]
  exact key

theorem conformal_scalar_flat [IsManifold 𝓘(ℝ, E3) ∞ M] (h g' : RiemannianMetric3 M) (v : M → ℝ)
    (hv : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ v) (hvpos : ∀ p : M, 0 < 1 + v p)
    (hg' : ∀ x, g'.g x = ((1 + v x) ^ 4) • h.g x)
    (hveq : ∀ p : M, -8 * h.lapM v p + h.scalarCurvature p * (1 + v p) = 0) :
    ∀ p : M, g'.scalarCurvature p = 0 :=
by
  intro p
  have hU : IsOpen (chartAt E3 p).target := (chartAt E3 p).open_target
  have hG : ∀ i j : Fin 3,
      ContDiffOn ℝ ∞ (fun x => h.coeff (chartAt E3 p).symm x i j) (chartAt E3 p).target :=
    fun i j => h.smooth p i j
  have hsymm : ∀ (x : E3) (i j : Fin 3),
      h.coeff (chartAt E3 p).symm x i j = h.coeff (chartAt E3 p).symm x j i :=
    fun x i j => h.symm _ _ _
  have hdet : ∀ x ∈ (chartAt E3 p).target, (h.coeff (chartAt E3 p).symm x).det ≠ 0 :=
    fun x hx => (coeff_chart_symm_posDef h p x hx).det_pos.ne'
  have hw : ContDiffOn ℝ ∞ (fun y => v ((chartAt E3 p).symm y)) (chartAt E3 p).target :=
    contMDiffOn_iff_contDiffOn.mp (hv.comp_contMDiffOn contMDiffOn_chart_symm)
  have hu : ContDiffOn ℝ ∞ (fun y => 1 + v ((chartAt E3 p).symm y)) (chartAt E3 p).target :=
    contDiffOn_const.add hw
  have hupos : ∀ x ∈ (chartAt E3 p).target, 0 < 1 + v ((chartAt E3 p).symm x) :=
    fun x _ => hvpos _
  have hy : chartAt E3 p p ∈ (chartAt E3 p).target := mem_chart_target E3 p
  have key := conformal_scalarCurvatureLocal (h.coeff (chartAt E3 p).symm)
    (fun y => 1 + v ((chartAt E3 p).symm y)) _ hU hG hsymm hdet hu hupos _ hy
  have hcoeff : g'.coeff (chartAt E3 p).symm =
      fun x => ((1 + v ((chartAt E3 p).symm x)) ^ 4) • h.coeff (chartAt E3 p).symm x := by
    funext y
    ext i j
    show g'.g ((chartAt E3 p).symm y) _ _ =
      (1 + v ((chartAt E3 p).symm y)) ^ 4 * h.g ((chartAt E3 p).symm y) _ _
    rw [hg' ((chartAt E3 p).symm y), ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.smul_apply, smul_eq_mul]
  have hpd : ∀ k : Fin 3, partialDeriv k (fun y => 1 + v ((chartAt E3 p).symm y)) =
      partialDeriv k (fun y => v ((chartAt E3 p).symm y)) := by
    intro k
    funext z
    simp only [partialDeriv, fderiv_const_add]
  have hlap : lapLocal (h.coeff (chartAt E3 p).symm) (fun y => 1 + v ((chartAt E3 p).symm y))
      (chartAt E3 p p) = h.lapM v p := by
    simp only [lapLocal, RiemannianMetric3.lapM, lapLoc, hessLoc, hpd]
  have hleft : (chartAt E3 p).symm (chartAt E3 p p) = p :=
    (chartAt E3 p).left_inv (mem_chart_source E3 p)
  show scalarCurvatureLocal (g'.coeff (chartAt E3 p).symm) (chartAt E3 p p) = 0
  refine (congrArg (fun G => scalarCurvatureLocal G (chartAt E3 p p)) hcoeff).trans ?_
  refine key.trans ?_
  show ((1 + v ((chartAt E3 p).symm (chartAt E3 p p))) ^ 5)⁻¹ *
      (-8 * lapLocal (h.coeff (chartAt E3 p).symm) (fun y => 1 + v ((chartAt E3 p).symm y))
          (chartAt E3 p p) +
        h.scalarCurvature p * (1 + v ((chartAt E3 p).symm (chartAt E3 p p)))) = 0
  rw [hlap, hleft, hveq p, mul_zero]

theorem isCompleteRiemannian_of_equiv [IsManifold 𝓘(ℝ, E3) ∞ M] (g g' : RiemannianMetric3 M)
    (c₁ c₂ : ℝ) (hc₁ : 0 < c₁) (hlo : ∀ (p : M) (ξ : E3), c₁ * g.g p ξ ξ ≤ g'.g p ξ ξ)
    (hhi : ∀ (p : M) (ξ : E3), g'.g p ξ ξ ≤ c₂ * g.g p ξ ξ) (hC : g.IsCompleteRiemannian) :
    g'.IsCompleteRiemannian :=
by
  
  have hexp : ∀ (B : E3 →L[ℝ] E3 →L[ℝ] ℝ) (L : E3 →L[ℝ] E3) (w : E3),
      B (L w) (L w) = ∑ i : Fin 3, ∑ j : Fin 3, w i * w j * B (L (e i)) (L (e j)) := by
    intro B L w
    have hw : w = w 0 • e 0 + w 1 • e 1 + w 2 • e 2 := by
      ext k
      fin_cases k <;> simp [e]
    conv_lhs => rw [hw]
    simp only [map_add, map_smul, ContinuousLinearMap.add_apply, ContinuousLinearMap.coe_smul',
      Pi.smul_apply, smul_eq_mul, Fin.sum_univ_three]
    ring
  have hsum3 : ∀ (t₀ : ℝ) (f : Fin 3 → ℝ → ℝ), (∀ i, ContinuousAt (f i) t₀) →
      ContinuousAt (fun s => ∑ i : Fin 3, f i s) t₀ := by
    intro t₀ f hf
    simp only [Fin.sum_univ_three]
    exact ((hf 0).add (hf 1)).add (hf 2)
  
  have hspeed : ∀ (h : RiemannianMetric3 M) (γ : ℝ → M), ContMDiff 𝓘(ℝ, ℝ) 𝓘(ℝ, E3) 1 γ →
      Continuous (fun t => h.g (γ t) (RiemannianMetric3.velocity γ t)
        (RiemannianMetric3.velocity γ t)) := by
    intro h γ hγ
    rw [continuous_iff_continuousAt]
    intro t₀
    obtain ⟨c, hc⟩ : ∃ c, c = chartAt E3 (γ t₀) := ⟨_, rfl⟩
    have hcatlas : c ∈ atlas E3 M := by rw [hc]; exact chart_mem_atlas E3 (γ t₀)
    obtain ⟨U, hU⟩ : ∃ U : Set ℝ, U = γ ⁻¹' c.source := ⟨_, rfl⟩
    have hUo : IsOpen U := by rw [hU]; exact c.open_source.preimage hγ.continuous
    have ht₀ : t₀ ∈ U := by rw [hU, hc]; exact mem_chart_source E3 (γ t₀)
    obtain ⟨ψ, hψ⟩ : ∃ ψ : ℝ → E3, ψ = fun s => c (γ s) := ⟨_, rfl⟩
    have hψm : ContMDiffOn 𝓘(ℝ, ℝ) 𝓘(ℝ, E3) 1 ψ U := by
      have h1 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, E3) 1 c c.source := by
        rw [hc]; exact contMDiffOn_chart
      rw [hψ]
      exact h1.comp hγ.contMDiffOn (fun s hs => by rw [hU] at hs; exact hs)
    have hψd : ContDiffOn ℝ 1 ψ U := contMDiffOn_iff_contDiffOn.mp hψm
    have hdc : ContinuousOn (deriv ψ) U := hψd.continuousOn_deriv_of_isOpen hUo le_rfl
    have hvel : ∀ s ∈ U, RiemannianMetric3.velocity γ s =
        mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) c.symm (ψ s) (deriv ψ s) := by
      intro s hs
      have hUs : U ∈ 𝓝 s := hUo.mem_nhds hs
      have hs' : γ s ∈ c.source := by rw [hU] at hs; exact hs
      have heq : γ =ᶠ[𝓝 s] (c.symm ∘ ψ) := by
        filter_upwards [hUs] with s' hs''
        rw [hU] at hs''
        simp only [Function.comp, hψ]
        exact (c.left_inv hs'').symm
      have h1 : MDifferentiableAt 𝓘(ℝ, E3) 𝓘(ℝ, E3) c.symm (ψ s) := by
        have : ψ s = c (γ s) := by rw [hψ]
        rw [this]
        exact mdifferentiableAt_atlas_symm hcatlas (c.map_source hs')
      have h2 : MDifferentiableAt 𝓘(ℝ, ℝ) 𝓘(ℝ, E3) ψ s :=
        (hψm.contMDiffAt hUs).mdifferentiableAt one_ne_zero
      unfold RiemannianMetric3.velocity
      have hB : (mfderiv 𝓘(ℝ, ℝ) 𝓘(ℝ, E3) ψ s) (1 : ℝ) = deriv ψ s := by
        rw [mfderiv_eq_fderiv]
        rfl
      rw [heq.mfderiv_eq, mfderiv_comp s h1 h2]
      exact congrArg (mfderiv 𝓘(ℝ, E3) 𝓘(ℝ, E3) c.symm (ψ s)) hB
    obtain ⟨F, hF⟩ : ∃ F : ℝ → ℝ, F = fun s => ∑ i : Fin 3, ∑ j : Fin 3,
        deriv ψ s i * deriv ψ s j * coeffMatrix h.g c.symm (ψ s) i j := ⟨_, rfl⟩
    have hFeq : F =ᶠ[𝓝 t₀] (fun t => h.g (γ t) (RiemannianMetric3.velocity γ t)
        (RiemannianMetric3.velocity γ t)) := by
      filter_upwards [hUo.mem_nhds ht₀] with s hs
      have hs' : γ s ∈ c.source := by rw [hU] at hs; exact hs
      have hγs : γ s = c.symm (ψ s) := by rw [hψ]; exact (c.left_inv hs').symm
      rw [hvel s hs, hF]
      simp only [coeffMatrix]
      rw [hγs]
      exact (hexp _ _ _).symm
    have hFc : ContinuousAt F t₀ := by
      rw [hF]
      have hψc : ContinuousAt ψ t₀ := hψd.continuousOn.continuousAt (hUo.mem_nhds ht₀)
      have hdct : ContinuousAt (deriv ψ) t₀ := hdc.continuousAt (hUo.mem_nhds ht₀)
      have hwi : ∀ i : Fin 3, ContinuousAt (fun s => deriv ψ s i) t₀ := fun i =>
        (PiLp.continuous_apply 2 _ i).continuousAt.comp hdct
      have hψt : ψ t₀ ∈ c.target := by
        have : ψ t₀ = c (γ t₀) := by rw [hψ]
        rw [this]
        have hs' : γ t₀ ∈ c.source := by rw [hU] at ht₀; exact ht₀
        exact c.map_source hs'
      have hcoef : ∀ i j : Fin 3, ContinuousAt (fun s => coeffMatrix h.g c.symm (ψ s) i j) t₀ := by
        intro i j
        have h1 : ContinuousAt (fun y => coeffMatrix h.g c.symm y i j) (ψ t₀) := by
          have := h.smooth (γ t₀) i j
          rw [← hc] at this
          exact this.continuousOn.continuousAt (c.open_target.mem_nhds hψt)
        exact h1.comp hψc
      exact hsum3 t₀ _ (fun i => hsum3 t₀ _ (fun j => ((hwi i).mul (hwi j)).mul (hcoef i j)))
    exact hFc.congr hFeq
  
  have hnn : ∀ (h : RiemannianMetric3 M) (p q : M), 0 ≤ h.riemannianDist p q := by
    intro h p q
    unfold RiemannianMetric3.riemannianDist RiemannianMetric3.curveLength
    exact Real.iInf_nonneg (fun i =>
      intervalIntegral.integral_nonneg zero_le_one (fun t _ => Real.sqrt_nonneg _))
  have hcmp : ∀ (h₁ h₂ : RiemannianMetric3 M) (a : ℝ), 0 ≤ a →
      (∀ (p : M) (ξ : E3), a * h₁.g p ξ ξ ≤ h₂.g p ξ ξ) →
      ∀ p q : M, Real.sqrt a * h₁.riemannianDist p q ≤ h₂.riemannianDist p q := by
    intro h₁ h₂ a ha hle p q
    have hL : ∀ γ : ℝ → M, ContMDiff 𝓘(ℝ, ℝ) 𝓘(ℝ, E3) 1 γ →
        0 ≤ h₁.curveLength γ ∧ Real.sqrt a * h₁.curveLength γ ≤ h₂.curveLength γ := by
      intro γ hγ
      have c1 := (hspeed h₁ γ hγ).sqrt
      have c2 := (hspeed h₂ γ hγ).sqrt
      unfold RiemannianMetric3.curveLength
      refine ⟨intervalIntegral.integral_nonneg zero_le_one (fun t _ => Real.sqrt_nonneg _), ?_⟩
      rw [← intervalIntegral.integral_const_mul]
      refine intervalIntegral.integral_mono_on zero_le_one
        ((c1.intervalIntegrable 0 1).const_mul _) (c2.intervalIntegrable 0 1) (fun t _ => ?_)
      rw [← Real.sqrt_mul ha]
      exact Real.sqrt_le_sqrt (hle _ _)
    unfold RiemannianMetric3.riemannianDist
    rw [Real.mul_iInf_of_nonneg (Real.sqrt_nonneg a)]
    exact ciInf_mono ⟨0, by
        rintro _ ⟨i, rfl⟩; exact mul_nonneg (Real.sqrt_nonneg _) (hL i.1 i.2.1).1⟩
      (fun i => (hL i.1 i.2.1).2)
  
  have hgnn : ∀ (p : M) (ξ : E3), 0 ≤ g.g p ξ ξ := by
    intro p ξ
    by_cases hξ : ξ = 0
    · subst hξ; simp
    · exact (g.posDef p ξ hξ).le
  obtain ⟨C, hCdef⟩ : ∃ C : ℝ, C = max c₂ 1 := ⟨_, rfl⟩
  have hCpos : 0 < C := by rw [hCdef]; exact lt_max_of_lt_right one_pos
  have hle2 : ∀ (p : M) (ξ : E3), (1 / C) * g'.g p ξ ξ ≤ g.g p ξ ξ := by
    intro p ξ
    have h1 : g'.g p ξ ξ ≤ C * g.g p ξ ξ := (hhi p ξ).trans
      (mul_le_mul_of_nonneg_right (by rw [hCdef]; exact le_max_left _ _) (hgnn p ξ))
    rw [div_mul_eq_mul_div, one_mul, div_le_iff₀ hCpos]
    linarith
  have hd1 := hcmp g g' c₁ hc₁.le hlo
  have hd2 := hcmp g' g (1 / C) (by positivity) hle2
  have hk : 0 < Real.sqrt (1 / C) := Real.sqrt_pos.2 (by positivity)
  intro u hu
  have hu' : ∀ ε > 0, ∃ N : ℕ, ∀ m ≥ N, ∀ n ≥ N, g.riemannianDist (u m) (u n) < ε := by
    intro ε hε
    obtain ⟨N, hN⟩ := hu (Real.sqrt c₁ * ε) (mul_pos (Real.sqrt_pos.2 hc₁) hε)
    refine ⟨N, fun m hm n hn => ?_⟩
    have h3 : Real.sqrt c₁ * g.riemannianDist (u m) (u n) < Real.sqrt c₁ * ε :=
      lt_of_le_of_lt (hd1 _ _) (hN m hm n hn)
    exact lt_of_mul_lt_mul_left h3 (Real.sqrt_nonneg _)
  obtain ⟨p, hp⟩ := hC u hu'
  refine ⟨p, ?_⟩
  have ht : Tendsto (fun n => (Real.sqrt (1 / C))⁻¹ * g.riemannianDist (u n) p) atTop (𝓝 0) := by
    simpa using hp.const_mul (Real.sqrt (1 / C))⁻¹
  refine squeeze_zero (fun n => hnn g' (u n) p) (fun n => ?_) ht
  rw [le_inv_mul_iff₀ hk]
  exact hd2 (u n) p

theorem conformal_factor_decay (G G' : E3 → Matrix (Fin 3) (Fin 3) ℝ) (u : E3 → ℝ)
    (q q' R : ℝ) (hq : 0 < q) (hq' : 0 < q') (hR : 1 ≤ R)
    (hsmooth : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => G x i j) {x : E3 | 1 < ‖x‖})
    (hu : ContDiffOn ℝ ∞ u {x : E3 | 1 < ‖x‖})
    (hdecay : ∀ i j : Fin 3, ∀ l : ℕ, l ≤ 2 →
      (fun x : E3 => ‖iteratedFDeriv ℝ l (fun y => G y i j - if i = j then (1 : ℝ) else 0) x‖)
        =O[Bornology.cobounded E3] fun x : E3 => ‖x‖ ^ (-q - (l : ℝ)))
    (hudec : ∀ l : ℕ, l ≤ 2 → (fun x : E3 => ‖iteratedFDeriv ℝ l u x‖)
        =O[Bornology.cobounded E3] fun x : E3 => ‖x‖ ^ (-q' - (l : ℝ)))
    (hG' : ∀ x : E3, R < ‖x‖ → G' x = ((1 + u x) ^ 4) • G x) :
    ∀ i j : Fin 3, ∀ l : ℕ, l ≤ 2 →
      (fun x : E3 => ‖iteratedFDeriv ℝ l (fun y => G' y i j - if i = j then (1 : ℝ) else 0) x‖)
        =O[Bornology.cobounded E3] fun x : E3 => ‖x‖ ^ (-(min q q') - (l : ℝ)) :=
by
  intro i j l hl
  have hev : ∀ᶠ x in Bornology.cobounded E3, 1 < ‖x‖ :=
    tendsto_norm_cobounded_atTop.eventually_gt_atTop 1
  have hopen : IsOpen {x : E3 | 1 < ‖x‖} := isOpen_lt continuous_const continuous_norm
  have t_mono : ∀ (s s' : ℝ), s ≤ s' →
      (fun x : E3 => ‖x‖ ^ s) =O[Bornology.cobounded E3] fun x : E3 => ‖x‖ ^ s' := by
    intro s s' hss
    refine Asymptotics.IsBigO.of_bound 1 ?_
    filter_upwards [hev] with x hx
    rw [Real.norm_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _),
      Real.norm_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _), one_mul]
    exact Real.rpow_le_rpow_of_exponent_le hx.le hss
  
  have t_lincomb : ∀ (f g : E3 → ℝ) (m₁ m₂ m α β : ℝ), m₁ ≤ m → m₂ ≤ m →
      cdecaySym f m₁ → cdecaySym g m₂ → cdecaySym (fun y => α * f y + β * g y) m := by
    intro f g m₁ m₂ m α β h₁ h₂ hf hg
    refine ⟨(contDiffOn_const.mul hf.1).add (contDiffOn_const.mul hg.1), fun l hl => ?_⟩
    have key : ∀ᶠ x in Bornology.cobounded E3,
        ‖‖iteratedFDeriv ℝ l (fun y => α * f y + β * g y) x‖‖ ≤
          1 * ‖|α| * ‖iteratedFDeriv ℝ l f x‖ + |β| * ‖iteratedFDeriv ℝ l g x‖‖ := by
      filter_upwards [hev] with x hx
      have hfx : ContDiffAt ℝ l f x :=
        (hf.1.contDiffAt (hopen.mem_nhds hx)).of_le (by exact_mod_cast le_top)
      have hgx : ContDiffAt ℝ l g x :=
        (hg.1.contDiffAt (hopen.mem_nhds hx)).of_le (by exact_mod_cast le_top)
      have e : (fun y => α * f y + β * g y) = α • f + β • g := by
        funext y; simp [smul_eq_mul]
      have hfs : ContDiffAt ℝ l (α • f) x := hfx.const_smul α
      have hgs : ContDiffAt ℝ l (β • g) x := hgx.const_smul β
      rw [e, iteratedFDeriv_add_apply hfs hgs,
        iteratedFDeriv_const_smul_apply hfx, iteratedFDeriv_const_smul_apply hgx, norm_norm,
        one_mul, Real.norm_of_nonneg (by positivity)]
      calc _ ≤ ‖α • iteratedFDeriv ℝ l f x‖ + ‖β • iteratedFDeriv ℝ l g x‖ := norm_add_le _ _
        _ = _ := by rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs]
    have b1 := ((hf.2 l hl).const_mul_left |α|).trans (t_mono (m₁ - l) (m - l) (by linarith))
    have b2 := ((hg.2 l hl).const_mul_left |β|).trans (t_mono (m₂ - l) (m - l) (by linarith))
    exact (Asymptotics.IsBigO.of_bound 1 key).trans (b1.add b2)
  
  have t_mul : ∀ (f g : E3 → ℝ) (m₁ m₂ : ℝ),
      cdecaySym f m₁ → cdecaySym g m₂ → cdecaySym (fun y => f y * g y) (m₁ + m₂) := by
    intro f g m₁ m₂ hf hg
    refine ⟨hf.1.mul hg.1, fun l hl => ?_⟩
    have key : ∀ᶠ x in Bornology.cobounded E3,
        ‖‖iteratedFDeriv ℝ l (fun y => f y * g y) x‖‖ ≤
          1 * ‖∑ k ∈ Finset.range (l + 1), (l.choose k : ℝ) * ‖iteratedFDeriv ℝ k f x‖ *
            ‖iteratedFDeriv ℝ (l - k) g x‖‖ := by
      filter_upwards [hev] with x hx
      have h := norm_iteratedFDerivWithin_mul_le hf.1 hg.1 hopen.uniqueDiffOn hx (n := l)
        (by exact_mod_cast le_top)
      have hw : ∀ (n : ℕ) (u : E3 → ℝ),
          iteratedFDerivWithin ℝ n u {x : E3 | 1 < ‖x‖} x = iteratedFDeriv ℝ n u x :=
        fun n u => iteratedFDerivWithin_of_isOpen n hopen hx
      simp only [hw] at h
      rw [norm_norm, one_mul, Real.norm_of_nonneg (Finset.sum_nonneg (fun k _ => by positivity))]
      exact h
    have hsum : (fun x => ∑ k ∈ Finset.range (l + 1), (l.choose k : ℝ) *
        ‖iteratedFDeriv ℝ k f x‖ * ‖iteratedFDeriv ℝ (l - k) g x‖) =O[Bornology.cobounded E3]
        (fun x : E3 => ‖x‖ ^ (m₁ + m₂ - (l : ℝ))) := by
      apply Asymptotics.IsBigO.sum
      intro k hk
      have hkl : k ≤ l := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
      have h1 :=
        ((hf.2 k (by omega)).const_mul_left (l.choose k : ℝ)).mul (hg.2 (l - k) (by omega))
      refine h1.congr' (Eventually.of_forall fun x => rfl) ?_
      filter_upwards [hev] with x hx
      rw [← Real.rpow_add (by linarith)]
      congr 1
      rw [Nat.cast_sub hkl]
      ring
    exact (Asymptotics.IsBigO.of_bound 1 key).trans hsum
  
  have hus : cdecaySym u (-q') := ⟨hu, hudec⟩
  
  have hu2 := t_mul _ _ _ _ hus hus
  have hu3 := t_mul _ _ _ _ hu2 hus
  have hu4 := t_mul _ _ _ _ hu3 hus
  have hA := t_lincomb _ _ _ _ (-q') 4 6 le_rfl (by linarith) hus hu2
  have hB := t_lincomb _ _ _ _ (-q') 4 1 (by linarith) (by linarith) hu3 hu4
  have hV' := t_lincomb _ _ _ _ (-q') 1 1 le_rfl le_rfl hA hB
  obtain ⟨V, hVdef⟩ : ∃ V : E3 → ℝ, V = fun y => (1 + u y) ^ 4 - 1 := ⟨_, rfl⟩
  have hV : cdecaySym V (-q') := by
    have e : V = fun y => 1 * (4 * u y + 6 * (u y * u y)) +
        1 * (4 * (u y * u y * u y) + 1 * (u y * u y * u y * u y)) := by
      rw [hVdef]; funext y; ring
    rw [e]; exact hV'
  
  obtain ⟨c, hc⟩ : ∃ c : ℝ, c = if i = j then (1 : ℝ) else 0 := ⟨_, rfl⟩
  obtain ⟨h, hhdef⟩ : ∃ h : E3 → ℝ, h = fun y => G y i j - c := ⟨_, rfl⟩
  have hh : cdecaySym h (-q) := by
    refine ⟨?_, ?_⟩
    · rw [hhdef]; exact (hsmooth i j).sub contDiffOn_const
    · intro l hl
      rw [hhdef, hc]
      exact hdecay i j l hl
  have hVh := t_mul _ _ _ _ hV hh
  have hmin1 := min_le_left q q'
  have hmin2 := min_le_right q q'
  have hT := t_lincomb _ _ (-q) (-q' + -q) (-(min q q')) 1 1 (by linarith) (by linarith) hh hVh
  have hH := t_lincomb _ _ (-(min q q')) (-q') (-(min q q')) 1 c le_rfl (by linarith) hT hV
  have hfarnhds : ∀ x : E3, R < ‖x‖ →
      (fun y => G' y i j - if i = j then (1 : ℝ) else 0) =ᶠ[𝓝 x]
        (fun y => 1 * (1 * h y + 1 * (V y * h y)) + c * V y) := by
    intro x hx
    refine Filter.eventuallyEq_of_mem
      ((isOpen_lt continuous_const continuous_norm).mem_nhds hx) ?_
    intro y hy
    have hy' : R < ‖y‖ := hy
    have hGy : G' y i j = (1 + u y) ^ 4 * G y i j := by
      rw [hG' y hy', Matrix.smul_apply, smul_eq_mul]
    simp only
    rw [hGy, ← hc, hhdef, hVdef]
    ring
  refine (hH.2 l hl).congr' ?_ (EventuallyEq.rfl)
  filter_upwards [tendsto_norm_cobounded_atTop.eventually_gt_atTop R] with x hx
  rw [((hfarnhds x hx).iteratedFDeriv ℝ l).eq_of_nhds]

theorem conformal_flux_difference (G G' : E3 → Matrix (Fin 3) (Fin 3) ℝ) (u : E3 → ℝ)
    (q q' R : ℝ) (hq : 1 / 2 < q) (hq' : 1 / 2 < q') (hR : 1 ≤ R)
    (hsmooth : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => G x i j) {x : E3 | 1 < ‖x‖})
    (hu : ContDiffOn ℝ ∞ u {x : E3 | 1 < ‖x‖})
    (hdecay : ∀ i j : Fin 3, ∀ l : ℕ, l ≤ 2 →
      (fun x : E3 => ‖iteratedFDeriv ℝ l (fun y => G y i j - if i = j then (1 : ℝ) else 0) x‖)
        =O[Bornology.cobounded E3] fun x : E3 => ‖x‖ ^ (-q - (l : ℝ)))
    (hudec : ∀ l : ℕ, l ≤ 2 → (fun x : E3 => ‖iteratedFDeriv ℝ l u x‖)
        =O[Bornology.cobounded E3] fun x : E3 => ‖x‖ ^ (-q' - (l : ℝ)))
    (hG' : ∀ x : E3, R < ‖x‖ → G' x = ((1 + u x) ^ 4) • G x) :
    Tendsto (fun r : ℝ => fluxLocal G' r - fluxLocal G r -
      4 * fluxLocal (fun x => (1 + u x) • (1 : Matrix (Fin 3) (Fin 3) ℝ)) r) atTop (𝓝 0) :=
by
  classical
  
  have hnorm : ∀ r : ℝ, 0 < r → ∀ θ : sphere (0 : E3) 1, ‖r • (θ : E3)‖ = r := by
    intro r hr θ
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hr, norm_eq_of_mem_sphere θ, mul_one]
  have hθle : ∀ (θ : sphere (0 : E3) 1) (i : Fin 3), |(θ : E3) i| ≤ 1 := by
    intro θ i
    have h := PiLp.norm_apply_le (θ : E3) i
    rw [norm_eq_of_mem_sphere θ, Real.norm_eq_abs] at h
    exact h
  have hSopen : IsOpen {x : E3 | 1 < ‖x‖} := isOpen_lt continuous_const continuous_norm
  have hUopen : IsOpen {x : E3 | R < ‖x‖} := isOpen_lt continuous_const continuous_norm
  have hpd : ∀ (f : E3 → ℝ) (k : Fin 3) (y : E3), |partialDeriv k f y| ≤ ‖fderiv ℝ f y‖ := by
    intro f k y
    have he : ‖e k‖ = 1 := by
      show ‖EuclideanSpace.single k (1 : ℝ)‖ = 1
      rw [EuclideanSpace.norm_single, norm_one]
    have h := (fderiv ℝ f y).le_opNorm (e k)
    rw [he, mul_one, Real.norm_eq_abs] at h
    exact h
  
  obtain ⟨F, hF⟩ : ∃ F : (E3 → Matrix (Fin 3) (Fin 3) ℝ) → ℝ → sphere (0 : E3) 1 → ℝ,
      F = fun (H : E3 → Matrix (Fin 3) (Fin 3) ℝ) (r : ℝ) (θ : sphere (0 : E3) 1) =>
        ∑ i : Fin 3, ∑ j : Fin 3,
        (partialDeriv i (fun x => H x i j) (r • (θ : E3))
          - partialDeriv j (fun x => H x i i) (r • (θ : E3))) * (θ : E3) j := ⟨_, rfl⟩
  have hflux : ∀ H r, fluxLocal H r = 1 / (16 * Real.pi) * r ^ 2 *
      ∫ θ, F H r θ ∂(volume : Measure E3).toSphere := by
    intro H r; rw [hF]; rfl
  obtain ⟨Gu, hGu⟩ : ∃ Gu : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      Gu = fun x => (1 + u x) • (1 : Matrix (Fin 3) (Fin 3) ℝ) := ⟨_, rfl⟩
  have hpdGu : ∀ (k a c : Fin 3) (y : E3), partialDeriv k (fun z => Gu z a c) y =
      if a = c then partialDeriv k u y else 0 := by
    intro k a c y
    by_cases hac : a = c
    · have hfun : (fun z => Gu z a c) = fun z => 1 + u z := by
        funext z
        subst hac
        simp [hGu]
      rw [hfun, if_pos hac]
      simp only [partialDeriv, fderiv_const_add]
    · have hfun : (fun z => Gu z a c) = fun _ => (0 : ℝ) := by
        funext z
        simp [hGu, hac]
      rw [hfun, if_neg hac]
      simp [partialDeriv]
  have hGusm : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => Gu x i j) {x : E3 | 1 < ‖x‖} := by
    intro i j
    by_cases hij : i = j
    · have hfun : (fun z => Gu z i j) = fun z => 1 + u z := by
        funext z
        subst hij
        simp [hGu]
      rw [hfun]
      exact contDiffOn_const.add hu
    · have hfun : (fun z => Gu z i j) = fun _ => (0 : ℝ) := by
        funext z
        simp [hGu, hij]
      rw [hfun]
      exact contDiffOn_const
  have hG'sm : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => G' x i j) {x : E3 | R < ‖x‖} := by
    intro i j
    have hsub : {x : E3 | R < ‖x‖} ⊆ {x : E3 | 1 < ‖x‖} := fun x hx =>
      lt_of_le_of_lt hR hx
    refine (((((contDiffOn_const (c := (1 : ℝ))).add hu).pow 4).mul (hsmooth i j)).mono
      hsub).congr ?_
    intro x hx
    rw [hG' x hx]
    rfl
  
  have hcoord : ∀ j : Fin 3, Continuous fun θ : sphere (0 : E3) 1 => (θ : E3) j :=
    fun j => (PiLp.continuous_apply 2 _ j).comp continuous_subtype_val
  have hint : ∀ (H : E3 → Matrix (Fin 3) (Fin 3) ℝ) (ρ : ℝ), 0 ≤ ρ →
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => H x i j) {x : E3 | ρ < ‖x‖}) →
      ∀ r : ℝ, ρ < r → Integrable (F H r) (volume : Measure E3).toSphere := by
    intro H ρ hρ hH r hr
    have hr0 : 0 < r := lt_of_le_of_lt hρ hr
    have hopen : IsOpen {x : E3 | ρ < ‖x‖} := isOpen_lt continuous_const continuous_norm
    have hcD : ∀ k i j : Fin 3, Continuous fun θ : sphere (0 : E3) 1 =>
        partialDeriv k (fun x => H x i j) (r • (θ : E3)) := by
      intro k i j
      have h1 : ContinuousOn (fun y => fderiv ℝ (fun x => H x i j) y (e k))
          {x : E3 | ρ < ‖x‖} :=
        ((hH i j).continuousOn_fderiv_of_isOpen hopen (by simp)).clm_apply continuousOn_const
      exact h1.comp_continuous (continuous_subtype_val.const_smul r)
        (fun θ => show ρ < ‖r • (θ : E3)‖ by rw [hnorm r hr0 θ]; exact hr)
    have hc : Continuous (F H r) := by
      rw [hF]
      exact continuous_finset_sum _ fun i _ => continuous_finset_sum _ fun j _ =>
        ((hcD i i j).sub (hcD j i i)).mul (hcoord j)
    exact hc.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  
  have hid : ∀ r : ℝ, R < r → ∀ θ : sphere (0 : E3) 1,
      F G' r θ - F G r θ - 4 * F Gu r θ =
      ((1 + u (r • (θ : E3))) ^ 4 - 1) *
        (∑ i : Fin 3, ∑ j : Fin 3, (partialDeriv i (fun y => G y i j) (r • (θ : E3)) -
          partialDeriv j (fun y => G y i i) (r • (θ : E3))) * (θ : E3) j) +
      4 * ∑ i : Fin 3, ∑ j : Fin 3,
        (((1 + u (r • (θ : E3))) ^ 3 * G (r • (θ : E3)) i j - (if i = j then (1 : ℝ) else 0)) *
            partialDeriv i u (r • (θ : E3)) -
          ((1 + u (r • (θ : E3))) ^ 3 * G (r • (θ : E3)) i i - 1) *
            partialDeriv j u (r • (θ : E3))) * (θ : E3) j := by
    intro r hr θ
    have hr0 : 0 < r := by linarith
    obtain ⟨x, hx⟩ : ∃ x : E3, x = r • (θ : E3) := ⟨_, rfl⟩
    have hxn : ‖x‖ = r := by rw [hx]; exact hnorm r hr0 θ
    have hx1 : x ∈ {x : E3 | 1 < ‖x‖} := show (1 : ℝ) < ‖x‖ by rw [hxn]; linarith
    have hGd : ∀ i j : Fin 3, DifferentiableAt ℝ (fun y => G y i j) x := fun i j =>
      ((hsmooth i j).differentiableOn (by simp)).differentiableAt (hSopen.mem_nhds hx1)
    have hud : DifferentiableAt ℝ u x :=
      (hu.differentiableOn (by simp)).differentiableAt (hSopen.mem_nhds hx1)
    have hWd : HasFDerivAt (fun y => (1 + u y) ^ 4) _ x := (hud.hasFDerivAt.const_add 1).pow 4
    have hprod : ∀ k i j : Fin 3, partialDeriv k (fun y => G' y i j) x =
        (1 + u x) ^ 4 * partialDeriv k (fun y => G y i j) x +
          G x i j * (4 * (1 + u x) ^ 3 * partialDeriv k u x) := by
      intro k i j
      have hev : (fun y => G' y i j) =ᶠ[𝓝 x] (fun y => (1 + u y) ^ 4 * G y i j) := by
        filter_upwards [hUopen.mem_nhds (show R < ‖x‖ by rw [hxn]; exact hr)] with y hy
        rw [hG' y hy]
        rfl
      have hd : HasFDerivAt (fun y => (1 + u y) ^ 4 * G y i j) _ x :=
        hWd.mul (hGd i j).hasFDerivAt
      rw [partialDeriv, hev.fderiv_eq, hd.fderiv]
      simp only [partialDeriv, ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
        smul_eq_mul, nsmul_eq_mul, Nat.cast_ofNat]
      try ring
    rw [hF]
    dsimp only
    rw [← hx]
    simp only [hprod, hpdGu, Fin.sum_univ_three, Fin.isValue]
    simp only [Fin.isValue, Fin.reduceEq, ↓reduceIte]
    ring
  
  have key2 : ∀ f : Fin 3 → Fin 3 → ℝ, ∀ ε : ℝ, (∀ i j, |f i j| ≤ ε) →
      |∑ i : Fin 3, ∑ j : Fin 3, f i j| ≤ 9 * ε := by
    intro f ε hf
    simp only [Fin.sum_univ_three]
    obtain ⟨h1, h2⟩ := abs_le.mp (hf 0 0)
    obtain ⟨h3, h4⟩ := abs_le.mp (hf 0 1)
    obtain ⟨h5, h6⟩ := abs_le.mp (hf 0 2)
    obtain ⟨h7, h8⟩ := abs_le.mp (hf 1 0)
    obtain ⟨h9, h10⟩ := abs_le.mp (hf 1 1)
    obtain ⟨h11, h12⟩ := abs_le.mp (hf 1 2)
    obtain ⟨h13, h14⟩ := abs_le.mp (hf 2 0)
    obtain ⟨h15, h16⟩ := abs_le.mp (hf 2 1)
    obtain ⟨h17, h18⟩ := abs_le.mp (hf 2 2)
    rw [abs_le]; constructor <;> linarith
  have hdens : ∀ (U A B P Q : ℝ) (g : Fin 3 → Fin 3 → ℝ) (dG : Fin 3 → Fin 3 → Fin 3 → ℝ)
      (du t : Fin 3 → ℝ), |U| ≤ 1 → |U| ≤ A →
      (∀ i j : Fin 3, |g i j - (if i = j then (1 : ℝ) else 0)| ≤ B) → B ≤ 1 →
      (∀ k i j : Fin 3, |dG k i j| ≤ P) → (∀ k : Fin 3, |du k| ≤ Q) →
      (∀ j : Fin 3, |t j| ≤ 1) →
      |((1 + U) ^ 4 - 1) * (∑ i : Fin 3, ∑ j : Fin 3, (dG i i j - dG j i i) * t j) +
        4 * ∑ i : Fin 3, ∑ j : Fin 3,
          (((1 + U) ^ 3 * g i j - (if i = j then (1 : ℝ) else 0)) * du i -
            ((1 + U) ^ 3 * g i i - 1) * du j) * t j| ≤ 1350 * (A * P + A * Q + B * Q) := by
    intro U A B P Q g dG du t hU1 hUA hg hB1 hdG hdu ht
    have hA0 : 0 ≤ A := (abs_nonneg U).trans hUA
    have hB0 : 0 ≤ B := (abs_nonneg _).trans (hg 0 0)
    have hP0 : 0 ≤ P := (abs_nonneg _).trans (hdG 0 0 0)
    have hQ0 : 0 ≤ Q := (abs_nonneg _).trans (hdu 0)
    obtain ⟨hU1a, hU1b⟩ := abs_le.mp hU1
    have hw0 : 0 ≤ 1 + U := by linarith
    have hw2 : 1 + U ≤ 2 := by linarith
    have hw2' : (1 + U) ^ 2 ≤ 4 := by
      calc (1 + U) ^ 2 ≤ 2 ^ 2 := pow_le_pow_left₀ hw0 hw2 2
        _ = 4 := by norm_num
    have hw3' : (1 + U) ^ 3 ≤ 8 := by
      calc (1 + U) ^ 3 ≤ 2 ^ 3 := pow_le_pow_left₀ hw0 hw2 3
        _ = 8 := by norm_num
    have hw2n : 0 ≤ (1 + U) ^ 2 := pow_nonneg hw0 2
    have hw3n : 0 ≤ (1 + U) ^ 3 := pow_nonneg hw0 3
    have h4 : |(1 + U) ^ 4 - 1| ≤ 15 * A := by
      rw [show (1 + U) ^ 4 - 1 = U * ((1 + U) ^ 3 + (1 + U) ^ 2 + (1 + U) + 1) by ring, abs_mul,
        abs_of_nonneg (by linarith : (0 : ℝ) ≤ (1 + U) ^ 3 + (1 + U) ^ 2 + (1 + U) + 1)]
      have := mul_le_mul_of_nonneg_left
        (show (1 + U) ^ 3 + (1 + U) ^ 2 + (1 + U) + 1 ≤ 15 by linarith) (abs_nonneg U)
      linarith
    have h3 : |(1 + U) ^ 3 - 1| ≤ 7 * A := by
      rw [show (1 + U) ^ 3 - 1 = U * ((1 + U) ^ 2 + (1 + U) + 1) by ring, abs_mul,
        abs_of_nonneg (by linarith : (0 : ℝ) ≤ (1 + U) ^ 2 + (1 + U) + 1)]
      have := mul_le_mul_of_nonneg_left
        (show (1 + U) ^ 2 + (1 + U) + 1 ≤ 7 by linarith) (abs_nonneg U)
      linarith
    have hg2 : ∀ i j : Fin 3, |g i j| ≤ 2 := by
      intro i j
      have h1 := hg i j
      have hδ : |(if i = j then (1 : ℝ) else 0)| ≤ 1 := by split_ifs <;> simp
      have := abs_add_le (g i j - (if i = j then (1 : ℝ) else 0)) (if i = j then (1 : ℝ) else 0)
      rw [sub_add_cancel] at this
      linarith
    have hX : ∀ i j : Fin 3,
        |(1 + U) ^ 3 * g i j - (if i = j then (1 : ℝ) else 0)| ≤ 14 * A + B := by
      intro i j
      rw [show (1 + U) ^ 3 * g i j - (if i = j then (1 : ℝ) else 0) =
          ((1 + U) ^ 3 - 1) * g i j + (g i j - (if i = j then (1 : ℝ) else 0)) by ring]
      have h1 : |((1 + U) ^ 3 - 1) * g i j| ≤ 7 * A * 2 := by
        rw [abs_mul]; exact mul_le_mul h3 (hg2 i j) (abs_nonneg _) (by linarith)
      have h2 := abs_add_le (((1 + U) ^ 3 - 1) * g i j) (g i j - (if i = j then (1 : ℝ) else 0))
      linarith [hg i j]
    have hY : ∀ i : Fin 3, |(1 + U) ^ 3 * g i i - 1| ≤ 14 * A + B := by
      intro i
      have h := hX i i
      rwa [if_pos rfl] at h
    have hT1 : ∀ i j : Fin 3, |(dG i i j - dG j i i) * t j| ≤ 2 * P := by
      intro i j
      rw [abs_mul]
      have h1 : |dG i i j - dG j i i| ≤ 2 * P := by
        obtain ⟨a1, a2⟩ := abs_le.mp (hdG i i j)
        obtain ⟨b1, b2⟩ := abs_le.mp (hdG j i i)
        rw [abs_le]; constructor <;> linarith
      have := mul_le_mul h1 (ht j) (abs_nonneg _) (by linarith)
      linarith
    have hT2 : ∀ i j : Fin 3,
        |(((1 + U) ^ 3 * g i j - (if i = j then (1 : ℝ) else 0)) * du i -
            ((1 + U) ^ 3 * g i i - 1) * du j) * t j| ≤ 2 * ((14 * A + B) * Q) := by
      intro i j
      rw [abs_mul]
      have e1 : |((1 + U) ^ 3 * g i j - (if i = j then (1 : ℝ) else 0)) * du i| ≤
          (14 * A + B) * Q := by
        rw [abs_mul]; exact mul_le_mul (hX i j) (hdu i) (abs_nonneg _) (by linarith)
      have e2 : |((1 + U) ^ 3 * g i i - 1) * du j| ≤ (14 * A + B) * Q := by
        rw [abs_mul]; exact mul_le_mul (hY i) (hdu j) (abs_nonneg _) (by linarith)
      have h1 : |((1 + U) ^ 3 * g i j - (if i = j then (1 : ℝ) else 0)) * du i -
          ((1 + U) ^ 3 * g i i - 1) * du j| ≤ 2 * ((14 * A + B) * Q) := by
        obtain ⟨a1, a2⟩ := abs_le.mp e1
        obtain ⟨b1, b2⟩ := abs_le.mp e2
        rw [abs_le]; constructor <;> linarith
      have := mul_le_mul h1 (ht j) (abs_nonneg _)
        (mul_nonneg (by norm_num) (mul_nonneg (by linarith) hQ0))
      linarith
    have hS1 : |∑ i : Fin 3, ∑ j : Fin 3, (dG i i j - dG j i i) * t j| ≤ 9 * (2 * P) :=
      key2 (fun i j => (dG i i j - dG j i i) * t j) _ hT1
    have hS2 : |∑ i : Fin 3, ∑ j : Fin 3,
        (((1 + U) ^ 3 * g i j - (if i = j then (1 : ℝ) else 0)) * du i -
          ((1 + U) ^ 3 * g i i - 1) * du j) * t j| ≤ 9 * (2 * ((14 * A + B) * Q)) :=
      key2 (fun i j => (((1 + U) ^ 3 * g i j - (if i = j then (1 : ℝ) else 0)) * du i -
          ((1 + U) ^ 3 * g i i - 1) * du j) * t j) _ hT2
    calc _ ≤ |((1 + U) ^ 4 - 1) * (∑ i : Fin 3, ∑ j : Fin 3, (dG i i j - dG j i i) * t j)| +
          |4 * ∑ i : Fin 3, ∑ j : Fin 3,
            (((1 + U) ^ 3 * g i j - (if i = j then (1 : ℝ) else 0)) * du i -
              ((1 + U) ^ 3 * g i i - 1) * du j) * t j| := abs_add_le _ _
      _ ≤ 15 * A * (9 * (2 * P)) + 4 * (9 * (2 * ((14 * A + B) * Q))) := by
          refine add_le_add ?_ ?_
          · rw [abs_mul]; exact mul_le_mul h4 hS1 (abs_nonneg _) (by linarith)
          · rw [abs_mul, abs_of_pos (by norm_num : (0 : ℝ) < 4)]; linarith
      _ ≤ 1350 * (A * P + A * Q + B * Q) := by
          nlinarith [mul_nonneg hA0 hP0, mul_nonneg hA0 hQ0, mul_nonneg hB0 hQ0]
  
  have hGbd : ∀ i j : Fin 3, ∃ c : ℝ, ∀ᶠ x in Bornology.cobounded E3,
      |G x i j - (if i = j then (1 : ℝ) else 0)| ≤ c * ‖x‖ ^ (-q) ∧
      ‖fderiv ℝ (fun y => G y i j) x‖ ≤ c * ‖x‖ ^ (-q - 1) := by
    intro i j
    obtain ⟨a0, ha0⟩ := (hdecay i j 0 (by norm_num)).bound
    obtain ⟨a1, ha1⟩ := (hdecay i j 1 (by norm_num)).bound
    refine ⟨|a0| + |a1|, (ha0.and ha1).mono fun x hx => ?_⟩
    obtain ⟨h0, h1⟩ := hx
    have habs : ∀ y : ℝ, |‖x‖ ^ y| = ‖x‖ ^ y := fun y =>
      abs_of_nonneg (Real.rpow_nonneg (norm_nonneg x) y)
    simp only [norm_iteratedFDeriv_zero, norm_iteratedFDeriv_one, Real.norm_eq_abs, abs_abs,
      Nat.cast_zero, Nat.cast_one, sub_zero, abs_norm, habs, fderiv_sub_const] at h0 h1
    have hp0 := Real.rpow_nonneg (norm_nonneg x) (-q)
    have hp1 := Real.rpow_nonneg (norm_nonneg x) (-q - 1)
    constructor
    · exact h0.trans (mul_le_mul_of_nonneg_right
        (by linarith [le_abs_self a0, abs_nonneg a1]) hp0)
    · exact h1.trans (mul_le_mul_of_nonneg_right
        (by linarith [le_abs_self a1, abs_nonneg a0]) hp1)
  choose cG hcG using hGbd
  have hevG : ∀ᶠ x in Bornology.cobounded E3, ∀ i j : Fin 3,
      |G x i j - (if i = j then (1 : ℝ) else 0)| ≤ cG i j * ‖x‖ ^ (-q) ∧
      ‖fderiv ℝ (fun y => G y i j) x‖ ≤ cG i j * ‖x‖ ^ (-q - 1) := by
    rw [Filter.eventually_all]; intro i; rw [Filter.eventually_all]; exact hcG i
  rw [← comap_norm_atTop, Filter.eventually_comap, Filter.eventually_atTop] at hevG
  obtain ⟨RG, hRG⟩ := hevG
  obtain ⟨CG, hCGdef⟩ : ∃ CG : ℝ, CG = ∑ i : Fin 3, ∑ j : Fin 3, |cG i j| := ⟨_, rfl⟩
  have hcGC : ∀ i j, cG i j ≤ CG := by
    intro i j
    rw [hCGdef]
    calc cG i j ≤ |cG i j| := le_abs_self _
      _ ≤ ∑ j' : Fin 3, |cG i j'| :=
        Finset.single_le_sum (f := fun j' => |cG i j'|) (fun _ _ => abs_nonneg _)
          (Finset.mem_univ j)
      _ ≤ ∑ i' : Fin 3, ∑ j' : Fin 3, |cG i' j'| :=
        Finset.single_le_sum (f := fun i' => ∑ j' : Fin 3, |cG i' j'|)
          (fun _ _ => Finset.sum_nonneg fun _ _ => abs_nonneg _) (Finset.mem_univ i)
  have hGb : ∀ x : E3, RG ≤ ‖x‖ → ∀ i j : Fin 3,
      |G x i j - (if i = j then (1 : ℝ) else 0)| ≤ CG * ‖x‖ ^ (-q) ∧
      ‖fderiv ℝ (fun y => G y i j) x‖ ≤ CG * ‖x‖ ^ (-q - 1) := by
    intro x hx i j
    obtain ⟨h0, h1⟩ := hRG ‖x‖ hx x rfl i j
    exact ⟨h0.trans (mul_le_mul_of_nonneg_right (hcGC i j) (Real.rpow_nonneg (norm_nonneg x) _)),
      h1.trans (mul_le_mul_of_nonneg_right (hcGC i j) (Real.rpow_nonneg (norm_nonneg x) _))⟩
  obtain ⟨c0, hc0⟩ := (hudec 0 (by norm_num)).bound
  obtain ⟨c1, hc1⟩ := (hudec 1 (by norm_num)).bound
  have hut : Tendsto (fun x : E3 => ‖iteratedFDeriv ℝ 0 u x‖) (Bornology.cobounded E3)
      (𝓝 0) := by
    refine (hudec 0 (by norm_num)).trans_tendsto ?_
    have e0 : (-q' - ((0 : ℕ) : ℝ)) = -q' := by simp
    rw [e0]
    exact (tendsto_rpow_neg_atTop (by linarith : (0 : ℝ) < q')).comp tendsto_norm_cobounded_atTop
  have hev := (Filter.Tendsto.eventually_lt_const zero_lt_one hut).and (hc0.and hc1)
  rw [← comap_norm_atTop, Filter.eventually_comap, Filter.eventually_atTop] at hev
  obtain ⟨Ru, hRu⟩ := hev
  have hub : ∀ x : E3, Ru ≤ ‖x‖ → |u x| ≤ 1 ∧ |u x| ≤ |c0| * ‖x‖ ^ (-q') ∧
      ‖fderiv ℝ u x‖ ≤ |c1| * ‖x‖ ^ (-q' - 1) := by
    intro x hx
    obtain ⟨h1, h2, h3⟩ := hRu ‖x‖ hx x rfl
    have habs : ∀ y : ℝ, |‖x‖ ^ y| = ‖x‖ ^ y := fun y =>
      abs_of_nonneg (Real.rpow_nonneg (norm_nonneg x) y)
    simp only [norm_iteratedFDeriv_zero, norm_iteratedFDeriv_one, Real.norm_eq_abs, abs_abs,
      Nat.cast_zero, Nat.cast_one, sub_zero, abs_norm, habs] at h1 h2 h3
    refine ⟨h1.le, h2.trans (mul_le_mul_of_nonneg_right (le_abs_self _)
      (Real.rpow_nonneg (norm_nonneg x) _)), h3.trans (mul_le_mul_of_nonneg_right (le_abs_self _)
      (Real.rpow_nonneg (norm_nonneg x) _))⟩
  obtain ⟨C, hC⟩ : ∃ C : ℝ, C = CG + |c0| + |c1| := ⟨_, rfl⟩
  have hCG0 : 0 ≤ CG := by
    rw [hCGdef]; exact Finset.sum_nonneg fun _ _ => Finset.sum_nonneg fun _ _ => abs_nonneg _
  have hCGC : CG ≤ C := by rw [hC]; linarith [abs_nonneg c0, abs_nonneg c1]
  have hc0C : |c0| ≤ C := by rw [hC]; linarith [abs_nonneg c0, abs_nonneg c1]
  have hc1C : |c1| ≤ C := by rw [hC]; linarith [abs_nonneg c0, abs_nonneg c1]
  have hB1 : ∀ᶠ r in atTop, C * r ^ (-q) ≤ 1 := by
    have h := (tendsto_rpow_neg_atTop (by linarith : (0 : ℝ) < q)).const_mul C
    rw [mul_zero] at h
    exact Filter.Tendsto.eventually_le_const zero_lt_one h
  obtain ⟨bd, hbd⟩ : ∃ bd : ℝ → ℝ, bd = fun r => 1350 * (C * r ^ (-q') * (C * r ^ (-q - 1)) +
      C * r ^ (-q') * (C * r ^ (-q' - 1)) + C * r ^ (-q) * (C * r ^ (-q' - 1))) := ⟨_, rfl⟩
  
  have hpt : ∀ r : ℝ, max R (max RG Ru) < r → C * r ^ (-q) ≤ 1 → ∀ θ : sphere (0 : E3) 1,
      |F G' r θ - F G r θ - 4 * F Gu r θ| ≤ bd r := by
    intro r hr hrB θ
    have hRr : R < r := lt_of_le_of_lt (le_max_left _ _) hr
    have hRGr : RG < r := lt_of_le_of_lt ((le_max_left _ _).trans (le_max_right _ _)) hr
    have hRur : Ru < r := lt_of_le_of_lt ((le_max_right _ _).trans (le_max_right _ _)) hr
    have hr0 : 0 < r := by linarith
    have hxn := hnorm r hr0 θ
    obtain ⟨hu1, huA, hdu⟩ := hub (r • (θ : E3)) (by rw [hxn]; exact hRur.le)
    rw [hxn] at huA hdu
    have hGx := hGb (r • (θ : E3)) (by rw [hxn]; exact hRGr.le)
    rw [hid r hRr θ, hbd]
    refine hdens (u (r • (θ : E3))) (C * r ^ (-q')) (C * r ^ (-q)) (C * r ^ (-q - 1))
      (C * r ^ (-q' - 1)) (G (r • (θ : E3)))
      (fun k i j => partialDeriv k (fun y => G y i j) (r • (θ : E3)))
      (fun k => partialDeriv k u (r • (θ : E3))) (fun j => (θ : E3) j) hu1 ?_ ?_ hrB ?_ ?_
      (hθle θ)
    · exact huA.trans (mul_le_mul_of_nonneg_right hc0C (Real.rpow_nonneg hr0.le _))
    · intro i j
      have h := (hGx i j).1
      rw [hxn] at h
      exact h.trans (mul_le_mul_of_nonneg_right hCGC (Real.rpow_nonneg hr0.le _))
    · intro k i j
      show |partialDeriv k (fun y => G y i j) (r • (θ : E3))| ≤ C * r ^ (-q - 1)
      have h := (hGx i j).2
      rw [hxn] at h
      exact (hpd _ k _).trans (h.trans (mul_le_mul_of_nonneg_right hCGC
        (Real.rpow_nonneg hr0.le _)))
    · intro k
      show |partialDeriv k u (r • (θ : E3))| ≤ C * r ^ (-q' - 1)
      exact (hpd u k _).trans (hdu.trans (mul_le_mul_of_nonneg_right hc1C
        (Real.rpow_nonneg hr0.le _)))
  
  have hDeq : ∀ r : ℝ, R < r → fluxLocal G' r - fluxLocal G r - 4 * fluxLocal Gu r =
      1 / (16 * Real.pi) * r ^ 2 *
        ∫ θ, (F G' r θ - F G r θ - 4 * F Gu r θ) ∂(volume : Measure E3).toSphere := by
    intro r hr
    have h1 := hint G' R (by linarith) hG'sm r hr
    have h2 := hint G 1 zero_le_one hsmooth r (by linarith)
    have h3 := hint Gu 1 zero_le_one hGusm r (by linarith)
    have i12 : Integrable (fun θ => F G' r θ - F G r θ) (volume : Measure E3).toSphere :=
      h1.sub h2
    have i3 : Integrable (fun θ => 4 * F Gu r θ) (volume : Measure E3).toSphere :=
      h3.const_mul 4
    rw [hflux, hflux, hflux, integral_sub i12 i3, integral_sub h1 h2, integral_const_mul]
    ring
  
  have hrate : ∀ a b : ℝ, a + b < -2 →
      Tendsto (fun r : ℝ => r ^ 2 * (r ^ a * r ^ b)) atTop (𝓝 0) := by
    intro a b hab
    have h := tendsto_rpow_neg_atTop (show 0 < -(2 + a + b) by linarith)
    refine h.congr' ?_
    filter_upwards [eventually_gt_atTop 0] with r hr
    rw [neg_neg, ← Real.rpow_two, ← Real.rpow_add hr, ← Real.rpow_add hr]
    congr 1
    ring
  have key : Tendsto (fun r => fluxLocal G' r - fluxLocal G r - 4 * fluxLocal Gu r) atTop
      (𝓝 0) := by
    refine squeeze_zero_norm' (a := fun r => 1 / (16 * Real.pi) * r ^ 2 *
      (bd r * ((volume : Measure E3).toSphere).real Set.univ)) ?_ ?_
    · filter_upwards [eventually_gt_atTop (max R (max RG Ru)), hB1] with r hr hrB
      have hRr : R < r := lt_of_le_of_lt (le_max_left _ _) hr
      rw [hDeq r hRr, Real.norm_eq_abs, abs_mul,
        abs_of_nonneg (by positivity : (0 : ℝ) ≤ 1 / (16 * Real.pi) * r ^ 2)]
      refine mul_le_mul_of_nonneg_left ?_ (by positivity)
      have hpt' : ∀ θ : sphere (0 : E3) 1, ‖F G' r θ - F G r θ - 4 * F Gu r θ‖ ≤ bd r :=
        fun θ => by rw [Real.norm_eq_abs]; exact hpt r hr hrB θ
      have h := norm_integral_le_of_norm_le_const (μ := (volume : Measure E3).toSphere)
        (ae_of_all _ hpt')
      rw [Real.norm_eq_abs] at h
      exact h
    · have h1 := hrate (-q') (-q - 1) (by linarith)
      have h2 := hrate (-q') (-q' - 1) (by linarith)
      have h3 := hrate (-q) (-q' - 1) (by linarith)
      have h := ((h1.add h2).add h3).const_mul
        (1 / (16 * Real.pi) * 1350 * C ^ 2 * ((volume : Measure E3).toSphere).real Set.univ)
      rw [add_zero, add_zero, mul_zero] at h
      refine h.congr' ?_
      filter_upwards with r
      simp only [hbd]
      ring
  rw [hGu] at key
  exact key

theorem green_div_pointwise (U : Set E3) (hU : IsOpen U) (G H : E3 → Matrix (Fin 3) (Fin 3) ℝ) (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => G x i j) U) (hH : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => H x i j) U) (hGs : ∀ (x : E3) (i j : Fin 3), G x i j = G x j i) (hHs : ∀ (x : E3) (i j : Fin 3), H x i j = H x j i) (hGpd : ∀ x ∈ U, (G x).PosDef) (hHpd : ∀ x ∈ U, (H x).PosDef) (f u : E3 → ℝ) (hf : ContDiffOn ℝ ∞ f U) (hu : ContDiffOn ℝ ∞ u U) (y : E3) (hy : y ∈ U) : ∑ a : Fin 3, partialDeriv a (fun z => Real.sqrt (H z).det * (f z * ∑ e : Fin 3, (H z)⁻¹ a e * partialDeriv e u z) - Real.sqrt (G z).det * (u z * ∑ e : Fin 3, (G z)⁻¹ a e * partialDeriv e f z)) y = f y * lapLoc H u y * Real.sqrt (H y).det - u y * lapLoc G f y * Real.sqrt (G y).det + ∑ i : Fin 3, ∑ j : Fin 3, ((H y)⁻¹ i j * Real.sqrt (H y).det - (G y)⁻¹ i j * Real.sqrt (G y).det) * partialDeriv i f y * partialDeriv j u y :=
by
  classical
  
  have divform : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ),
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => G x i j) U) →
      (∀ (x : E3) (i j : Fin 3), G x i j = G x j i) →
      (∀ x ∈ U, (G x).PosDef) → ∀ (v : E3 → ℝ), ContDiffOn ℝ ∞ v U → ∀ x ∈ U,
      (∀ a : Fin 3, DifferentiableAt ℝ (fun y => ∑ b : Fin 3,
        Real.sqrt (G y).det * (G y)⁻¹ a b * partialDeriv b v y) x) ∧
      ∑ a : Fin 3, partialDeriv a (fun y => ∑ b : Fin 3,
        Real.sqrt (G y).det * (G y)⁻¹ a b * partialDeriv b v y) x =
      Real.sqrt (G x).det * lapLoc G v x := by
    intro G hG hsymm hpos v hv x hx
    have hUx : U ∈ 𝓝 x := hU.mem_nhds hx
    have hdet : 0 < (G x).det := (hpos x hx).det_pos
    have hGd : ∀ a b : Fin 3, DifferentiableAt ℝ (fun z => G z a b) x := fun a b =>
      ((hG a b).differentiableOn (by simp)).differentiableAt hUx
    have hpd' : ∀ a : Fin 3, DifferentiableAt ℝ (partialDeriv a v) x := by
      intro a
      have h1 : ContDiffAt ℝ ∞ v x := hv.contDiffAt hUx
      have h2 : ContDiffAt ℝ 1 (fderiv ℝ v) x :=
        ((contDiffAt_infty.1 h1) 2).fderiv_right (m := 1) (by norm_num)
      have h3 : DifferentiableAt ℝ (fderiv ℝ v) x := h2.differentiableAt one_ne_zero
      exact h3.clm_apply (differentiableAt_const (e a))
    have hsymI : ∀ a b : Fin 3, (G x)⁻¹ a b = (G x)⁻¹ b a := by
      have hS : (G x).IsSymm := Matrix.IsSymm.ext (fun i j => hsymm x j i)
      have hSi := hS.inv
      intro a b
      exact hSi.apply b a
    have inv_entry : ∀ (m : Fin 3) (k l : Fin 3),
        DifferentiableAt ℝ (fun y => (G y)⁻¹ k l) x ∧
          partialDeriv m (fun y => (G y)⁻¹ k l) x =
            -∑ a : Fin 3, ∑ b : Fin 3,
              (G x)⁻¹ k a * partialDeriv m (fun y => G y a b) x * (G x)⁻¹ b l := by
      intro m
      have hdet0 : (G x).det ≠ 0 := hdet.ne'
      have hdetD : ∀ H : E3 → Matrix (Fin 3) (Fin 3) ℝ,
          (∀ a b : Fin 3, DifferentiableAt ℝ (fun y => H y a b) x) →
          DifferentiableAt ℝ (fun y => (H y).det) x := by
        intro H hH
        have hfun : (fun y => (H y).det) = fun y =>
            H y 0 0 * H y 1 1 * H y 2 2 - H y 0 0 * H y 1 2 * H y 2 1
            - H y 0 1 * H y 1 0 * H y 2 2 + H y 0 1 * H y 1 2 * H y 2 0
            + H y 0 2 * H y 1 0 * H y 2 1 - H y 0 2 * H y 1 1 * H y 2 0 := by
          funext y; exact Matrix.det_fin_three (H y)
        rw [hfun]
        have h00 := hH 0 0
        have h01 := hH 0 1
        have h02 := hH 0 2
        have h10 := hH 1 0
        have h11 := hH 1 1
        have h12 := hH 1 2
        have h20 := hH 2 0
        have h21 := hH 2 1
        have h22 := hH 2 2
        fun_prop
      have hD : DifferentiableAt ℝ (fun y => (G y).det) x := hdetD G hGd
      have hP : ∀ k l : Fin 3, DifferentiableAt ℝ (fun y => (G y)⁻¹ k l) x := by
        intro k l
        have hfun : (fun y => (G y)⁻¹ k l) =
            fun y => ((G y).det)⁻¹ * ((G y).updateRow l (Pi.single k 1)).det := by
          funext y
          rw [Matrix.inv_def, Matrix.smul_apply, Matrix.adjugate_apply, Ring.inverse_eq_inv,
            smul_eq_mul]
        rw [hfun]
        refine (hD.inv hdet0).mul (hdetD _ ?_)
        intro a b
        by_cases hal : a = l
        · subst hal
          simp only [Matrix.updateRow_self]
          exact differentiableAt_const _
        · simp only [Matrix.updateRow_ne hal]
          exact hGd a b
      have hev : ∀ᶠ y in 𝓝 x, (G y).det ≠ 0 := hD.continuousAt.eventually_ne hdet0
      have hE : ∀ a l : Fin 3, ∑ b : Fin 3, G x a b * partialDeriv m (fun y => (G y)⁻¹ b l) x
          + ∑ b : Fin 3, partialDeriv m (fun y => G y a b) x * (G x)⁻¹ b l = 0 := by
