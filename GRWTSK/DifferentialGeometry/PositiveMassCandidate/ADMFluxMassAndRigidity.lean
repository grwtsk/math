    have h1 := mul_le_mul_of_nonneg_left hS2 hWZ
    have h2 := mul_le_mul_of_nonneg_left hS1 (div_nonneg hWZ hr0.le)
    have h3 : W * Z * (9 * ((3 + (1 + δ) * (3 + δ)) / r ^ 5 * (r * r) + (2 + δ) / r ^ 3)) +
        W * Z / r * (3 * ((2 + δ) / r ^ 3 * r)) = A * Z * (W / r ^ 3) := by
      rw [hAdef]; field_simp; ring
    have h4 : K₂ * A * Z * (W / r ^ 3) ≤ c0 * (W / r ^ 3) :=
      mul_le_mul_of_nonneg_right hZ.le (div_nonneg hW0 hr3.le)
    calc K₂ * (W * Z * ∑ i : Fin 3, ∑ j : Fin 3,
          |partialDeriv i (fun z => partialDeriv j (farPot δ) z) x|
        + W * Z / r * ∑ k : Fin 3, |partialDeriv k (farPot δ) x|)
        ≤ K₂ * (A * Z * (W / r ^ 3)) := mul_le_mul_of_nonneg_left (by linarith) hK0
      _ = K₂ * A * Z * (W / r ^ 3) := by ring
      _ ≤ c0 * (W / r ^ 3) := h4
  rw [hflat] at hP
  have hab := abs_le.mp hP
  have hEpos : 0 ≤ c0 * (W / r ^ 3) := mul_nonneg hc0.le (div_nonneg hW0 hr3.le)
  rw [hE]
  refine ⟨by linarith [hab.1, herr], ?_⟩
  rw [abs_le]
  constructor
  · linarith [hab.1, herr]
  · linarith [hab.2, herr]

theorem conformal_flux_tendsto (G G' : E3 → Matrix (Fin 3) (Fin 3) ℝ) (q a δ m R₂ : ℝ)
    (hq : 0 < q) (ha : 0 ≤ a) (ha' : a ≤ 1 / 4) (hδ : 0 < δ) (hR₂ : 1 ≤ R₂)
    (hsmooth : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => G x i j) {x : E3 | 1 < ‖x‖})
    (hdecay : ∀ i j : Fin 3, ∀ l : ℕ, l ≤ 2 →
      (fun x : E3 => ‖iteratedFDeriv ℝ l (fun y => G y i j - if i = j then (1 : ℝ) else 0) x‖)
        =O[Bornology.cobounded E3] fun x : E3 => ‖x‖ ^ (-q - (l : ℝ)))
    (hG' : ∀ x : E3, R₂ < ‖x‖ → G' x = ((1 - a * farPot δ x) ^ 4) • G x)
    (hm : Tendsto (fun r : ℝ => fluxLocal G r) atTop (𝓝 m)) :
    Tendsto (fun r : ℝ => fluxLocal G' r) atTop (𝓝 (m - 2 * a)) :=
by
  classical
  
  have hnorm : ∀ r : ℝ, 0 < r → ∀ θ : sphere (0 : E3) 1, ‖r • (θ : E3)‖ = r := by
    intro r hr θ
    rw [norm_smul, Real.norm_eq_abs, abs_of_pos hr, norm_eq_of_mem_sphere θ, mul_one]
  have hθsq : ∀ θ : sphere (0 : E3) 1,
      (θ : E3) 0 ^ 2 + (θ : E3) 1 ^ 2 + (θ : E3) 2 ^ 2 = 1 := by
    intro θ
    have h := EuclideanSpace.norm_sq_eq (θ : E3)
    rw [norm_eq_of_mem_sphere θ, Fin.sum_univ_three] at h
    simp only [Real.norm_eq_abs, sq_abs] at h
    linarith
  have hθle : ∀ (θ : sphere (0 : E3) 1) (i : Fin 3), |(θ : E3) i| ≤ 1 := by
    intro θ i
    have h := PiLp.norm_apply_le (θ : E3) i
    rw [norm_eq_of_mem_sphere θ, Real.norm_eq_abs] at h
    exact h
  have hSopen : IsOpen {x : E3 | 1 < ‖x‖} := isOpen_lt continuous_const continuous_norm
  have hUopen : IsOpen {x : E3 | R₂ < ‖x‖} := isOpen_lt continuous_const continuous_norm
  
  have hS4 : ((volume : Measure E3).toSphere).real Set.univ = 4 * Real.pi := by
    rw [measureReal_def, Measure.toSphere_apply_univ, finrank_euclideanSpace_fin,
      EuclideanSpace.volume_ball_fin_three, ENNReal.ofReal_one, one_pow, one_mul,
      ENNReal.toReal_mul, ENNReal.toReal_ofReal (by positivity)]
    simp only [ENNReal.toReal_natCast]
    push_cast
    ring
  
  obtain ⟨F, hF⟩ : ∃ F : (E3 → Matrix (Fin 3) (Fin 3) ℝ) → ℝ → sphere (0 : E3) 1 → ℝ,
      F = fun (H : E3 → Matrix (Fin 3) (Fin 3) ℝ) (r : ℝ) (θ : sphere (0 : E3) 1) =>
        ∑ i : Fin 3, ∑ j : Fin 3,
        (partialDeriv i (fun x => H x i j) (r • (θ : E3))
          - partialDeriv j (fun x => H x i i) (r • (θ : E3))) * (θ : E3) j := ⟨_, rfl⟩
  have hflux : ∀ H r, fluxLocal H r = 1 / (16 * Real.pi) * r ^ 2 *
      ∫ θ, F H r θ ∂(volume : Measure E3).toSphere := by
    intro H r; rw [hF]; rfl
  obtain ⟨T, hT⟩ : ∃ T : ℝ → sphere (0 : E3) 1 → ℝ,
      T = fun (r : ℝ) (θ : sphere (0 : E3) 1) =>
        ∑ i : Fin 3, ∑ j : Fin 3, (θ : E3) i * (θ : E3) j * G (r • (θ : E3)) i j
        - ∑ i : Fin 3, G (r • (θ : E3)) i i := ⟨_, rfl⟩
  obtain ⟨Ψ, hΨ⟩ : ∃ Ψ : ℝ → ℝ, Ψ = fun t : ℝ => (1 - a * (t⁻¹ + t ^ (-1 - δ))) ^ 4 :=
    ⟨_, rfl⟩
  obtain ⟨P, hP⟩ : ∃ P : ℝ → ℝ, P = fun t : ℝ =>
      4 * (1 - a * (t⁻¹ + t ^ (-1 - δ))) ^ 3 * (a * ((t ^ 2)⁻¹ + (1 + δ) * t ^ (-2 - δ))) :=
    ⟨_, rfl⟩
  obtain ⟨W, hW⟩ : ∃ W : E3 → ℝ, W = fun y : E3 => (1 - a * farPot δ y) ^ 4 := ⟨_, rfl⟩
  
  have hχ : ∀ t : ℝ, t ≠ 0 →
      HasDerivAt (fun t : ℝ => (1 - a * (t⁻¹ + t ^ (-1 - δ))) ^ 4) (P t) t := by
    intro t ht
    have h1 : HasDerivAt (fun t : ℝ => t⁻¹) (-(t ^ 2)⁻¹) t := hasDerivAt_inv ht
    have h2 : HasDerivAt (fun t : ℝ => t ^ (-1 - δ)) ((-1 - δ) * t ^ (-1 - δ - 1)) t :=
      Real.hasDerivAt_rpow_const (Or.inl ht)
    have e : (-1 - δ - 1) = -2 - δ := by ring
    rw [e] at h2
    have h3 := (((h1.add h2).const_mul a).const_sub 1).pow 4
    rw [hP]
    refine h3.congr_deriv ?_
    norm_num <;> ring
  have hWd : ∀ x : E3, x ≠ 0 →
      HasFDerivAt W (P ‖x‖ • ((1 / (2 * √(‖x‖ ^ 2))) • (2 • innerSL ℝ x))) x := by
    intro x hx
    have hn : ‖x‖ ≠ 0 := norm_ne_zero_iff.mpr hx
    have h1 : HasFDerivAt (fun y : E3 => √(‖y‖ ^ 2))
        ((1 / (2 * √(‖x‖ ^ 2))) • (2 • innerSL ℝ x)) x :=
      (hasStrictFDerivAt_norm_sq x).hasFDerivAt.sqrt (pow_ne_zero 2 hn)
    have h2 : (fun y : E3 => √(‖y‖ ^ 2)) = fun y => ‖y‖ :=
      funext fun y => Real.sqrt_sq (norm_nonneg y)
    rw [h2] at h1
    have h3 := (hχ ‖x‖ hn).comp_hasFDerivAt x h1
    rw [hW]
    exact h3
  have hdW : ∀ x : E3, x ≠ 0 → ∀ l : Fin 3, partialDeriv l W x = P ‖x‖ * (x l / ‖x‖) := by
    intro x hx l
    have hn : ‖x‖ ≠ 0 := norm_ne_zero_iff.mpr hx
    rw [partialDeriv, (hWd x hx).fderiv]
    simp [EuclideanSpace.inner_single_right, Real.sqrt_sq (norm_nonneg x)]
    field_simp
    try simp
  
  have hpt : ∀ r : ℝ, R₂ < r → ∀ θ : sphere (0 : E3) 1,
      F G' r θ = Ψ r * F G r θ + P r * T r θ := by
    intro r hr θ
    have hr0 : 0 < r := by linarith
    obtain ⟨x, hx⟩ : ∃ x : E3, x = r • (θ : E3) := ⟨_, rfl⟩
    have hxn : ‖x‖ = r := by rw [hx]; exact hnorm r hr0 θ
    have hx0 : x ≠ 0 := by intro h; rw [h, norm_zero] at hxn; linarith
    have hxl : ∀ l : Fin 3, x l = r * (θ : E3) l := by intro l; rw [hx]; rfl
    have hWx : W x = Ψ r := by rw [hW, hΨ]; simp only [farPot, hxn]
    have hdWx : ∀ l : Fin 3, partialDeriv l W x = P r * (θ : E3) l := by
      intro l; rw [hdW x hx0 l, hxn, hxl]; field_simp
    have hGd : ∀ i j : Fin 3, DifferentiableAt ℝ (fun y => G y i j) x := by
      intro i j
      exact ((hsmooth i j).differentiableOn (by simp)).differentiableAt
        (hSopen.mem_nhds (show (1:ℝ) < ‖x‖ by rw [hxn]; linarith))
    have hprod : ∀ k i j : Fin 3, partialDeriv k (fun y => G' y i j) x =
        Ψ r * partialDeriv k (fun y => G y i j) x + G x i j * (P r * (θ : E3) k) := by
      intro k i j
      have hev : (fun y => G' y i j) =ᶠ[𝓝 x] (fun y => W y * G y i j) := by
        filter_upwards [hUopen.mem_nhds (show R₂ < ‖x‖ by rw [hxn]; exact hr)] with y hy
        rw [hG' y hy, hW]
        rfl
      have hd : HasFDerivAt (fun y => W y * G y i j)
          (W x • fderiv ℝ (fun y => G y i j) x +
            G x i j • (P ‖x‖ • ((1 / (2 * √(‖x‖ ^ 2))) • (2 • innerSL ℝ x)))) x :=
        (hWd x hx0).mul (hGd i j).hasFDerivAt
      rw [partialDeriv, hev.fderiv_eq, hd.fderiv, ← hWx, ← hdWx k]
      simp only [partialDeriv, (hWd x hx0).fderiv, ContinuousLinearMap.add_apply,
        ContinuousLinearMap.smul_apply, smul_eq_mul]
    rw [hF, hT]
    dsimp only
    rw [← hx]
    simp only [hprod, Fin.sum_univ_three]
    linear_combination (-(P r * (G x 0 0 + G x 1 1 + G x 2 2))) * hθsq θ
  
  have hcontG : ∀ r : ℝ, 1 < r → ∀ i j : Fin 3,
      Continuous fun θ : sphere (0 : E3) 1 => G (r • (θ : E3)) i j := by
    intro r hr i j
    exact (hsmooth i j).continuousOn.comp_continuous (continuous_subtype_val.const_smul r)
      (fun θ => show (1:ℝ) < ‖r • (θ : E3)‖ by rw [hnorm r (by linarith) θ]; exact hr)
  have hcontD : ∀ r : ℝ, 1 < r → ∀ k i j : Fin 3,
      Continuous fun θ : sphere (0 : E3) 1 => partialDeriv k (fun x => G x i j) (r • (θ : E3)) := by
    intro r hr k i j
    have h1 : ContinuousOn (fun y => fderiv ℝ (fun x => G x i j) y (e k)) {x : E3 | 1 < ‖x‖} :=
      ((hsmooth i j).continuousOn_fderiv_of_isOpen hSopen (by simp)).clm_apply continuousOn_const
    exact h1.comp_continuous (continuous_subtype_val.const_smul r)
      (fun θ => show (1:ℝ) < ‖r • (θ : E3)‖ by rw [hnorm r (by linarith) θ]; exact hr)
  have hcoord : ∀ j : Fin 3, Continuous fun θ : sphere (0 : E3) 1 => (θ : E3) j :=
    fun j => (PiLp.continuous_apply 2 _ j).comp continuous_subtype_val
  have hint1 : ∀ r : ℝ, 1 < r → Integrable (F G r) (volume : Measure E3).toSphere := by
    intro r hr
    have hc : Continuous (F G r) := by
      rw [hF]
      exact continuous_finset_sum _ fun i _ => continuous_finset_sum _ fun j _ =>
        ((hcontD r hr i i j).sub (hcontD r hr j i i)).mul (hcoord j)
    exact hc.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  have hint2 : ∀ r : ℝ, 1 < r → Integrable (T r) (volume : Measure E3).toSphere := by
    intro r hr
    have hc : Continuous (T r) := by
      rw [hT]
      exact (continuous_finset_sum _ fun i _ => continuous_finset_sum _ fun j _ =>
        ((hcoord i).mul (hcoord j)).mul (hcontG r hr i j)).sub
        (continuous_finset_sum _ fun i _ => hcontG r hr i i)
    exact hc.integrable_of_hasCompactSupport (HasCompactSupport.of_compactSpace _)
  
  have hstar : ∀ r : ℝ, R₂ < r → fluxLocal G' r = Ψ r * fluxLocal G r +
      1 / (16 * Real.pi) * (r ^ 2 * P r) * ∫ θ, T r θ ∂(volume : Measure E3).toSphere := by
    intro r hr
    have hr1 : 1 < r := by linarith
    rw [hflux, hflux, show (∫ θ, F G' r θ ∂(volume : Measure E3).toSphere) =
        ∫ θ, (Ψ r * F G r θ + P r * T r θ) ∂(volume : Measure E3).toSphere from
        integral_congr_ae (ae_of_all _ (hpt r hr)),
      integral_add ((hint1 r hr1).const_mul _) ((hint2 r hr1).const_mul _),
      integral_const_mul, integral_const_mul]
    ring
  
  have hinv : Tendsto (fun r : ℝ => r⁻¹) atTop (𝓝 0) := tendsto_inv_atTop_zero
  have hrp : Tendsto (fun r : ℝ => r ^ (-1 - δ)) atTop (𝓝 0) := by
    have h := tendsto_rpow_neg_atTop (show 0 < 1 + δ by linarith)
    rwa [neg_add'] at h
  have hrd : Tendsto (fun r : ℝ => r ^ (-δ)) atTop (𝓝 0) := tendsto_rpow_neg_atTop hδ
  have hu : Tendsto (fun r : ℝ => 1 - a * (r⁻¹ + r ^ (-1 - δ))) atTop (𝓝 1) := by
    have h := ((hinv.add hrp).const_mul a).const_sub 1
    rwa [add_zero, mul_zero, sub_zero] at h
  have hΨlim : Tendsto Ψ atTop (𝓝 1) := by
    rw [hΨ]
    have h := hu.pow 4
    rwa [one_pow] at h
  have hPlim : Tendsto (fun r => r ^ 2 * P r) atTop (𝓝 (4 * a)) := by
    have h : Tendsto (fun r : ℝ => 4 * (1 - a * (r⁻¹ + r ^ (-1 - δ))) ^ 3 *
        (a * (1 + (1 + δ) * r ^ (-δ)))) atTop
        (𝓝 (4 * 1 ^ 3 * (a * (1 + (1 + δ) * 0)))) :=
      ((hu.pow 3).const_mul 4).mul (((hrd.const_mul (1 + δ)).const_add 1).const_mul a)
    simp only [one_pow, mul_zero, add_zero, mul_one] at h
    refine h.congr' ?_
    filter_upwards [eventually_gt_atTop 0] with r hr
    rw [hP]
    dsimp only
    have hA : r ^ 2 * r ^ (-2 - δ) = r ^ (-δ) := by
      rw [← Real.rpow_two, ← Real.rpow_add hr]; congr 1; ring
    have hB : r ^ 2 * (r ^ 2)⁻¹ = 1 := mul_inv_cancel₀ (by positivity)
    linear_combination (-(4 * (1 - a * (r⁻¹ + r ^ (-1 - δ))) ^ 3 * a)) * hB +
      (-(4 * (1 - a * (r⁻¹ + r ^ (-1 - δ))) ^ 3 * a * (1 + δ))) * hA
  
  have hTlim : Tendsto (fun r => ∫ θ, T r θ ∂(volume : Measure E3).toSphere) atTop
      (𝓝 (-2 * ((volume : Measure E3).toSphere).real Set.univ)) := by
    have hb : ∀ i j : Fin 3, ∃ c : ℝ, ∀ᶠ x in Bornology.cobounded E3,
        |G x i j - (if i = j then (1 : ℝ) else 0)| ≤ c * ‖x‖ ^ (-q) := by
      intro i j
      obtain ⟨c, hc⟩ := (hdecay i j 0 (by norm_num)).bound
      refine ⟨c, hc.mono fun x hx => ?_⟩
      simp only [norm_iteratedFDeriv_zero, Real.norm_eq_abs, abs_abs, Nat.cast_zero,
        sub_zero] at hx
      rwa [abs_of_nonneg (Real.rpow_nonneg (norm_nonneg x) _)] at hx
    choose c hc using hb
    have hev : ∀ᶠ x in Bornology.cobounded E3, ∀ i j : Fin 3,
        |G x i j - (if i = j then (1 : ℝ) else 0)| ≤ c i j * ‖x‖ ^ (-q) := by
      rw [Filter.eventually_all]; intro i; rw [Filter.eventually_all]; exact hc i
    rw [← comap_norm_atTop, Filter.eventually_comap, Filter.eventually_atTop] at hev
    obtain ⟨R, hR⟩ := hev
    obtain ⟨C, hC⟩ : ∃ C : ℝ, C = ∑ i : Fin 3, ∑ j : Fin 3, |c i j| := ⟨_, rfl⟩
    have hcC : ∀ i j, c i j ≤ C := by
      intro i j
      rw [hC]
      calc c i j ≤ |c i j| := le_abs_self _
        _ ≤ ∑ j' : Fin 3, |c i j'| :=
          Finset.single_le_sum (f := fun j' => |c i j'|) (fun _ _ => abs_nonneg _)
            (Finset.mem_univ j)
        _ ≤ ∑ i' : Fin 3, ∑ j' : Fin 3, |c i' j'| :=
          Finset.single_le_sum (f := fun i' => ∑ j' : Fin 3, |c i' j'|)
            (fun _ _ => Finset.sum_nonneg fun _ _ => abs_nonneg _) (Finset.mem_univ i)
    have key2 : ∀ f : Fin 3 → Fin 3 → ℝ, ∀ ε : ℝ, (∀ i j, |f i j| ≤ ε) →
        |∑ i : Fin 3, ∑ j : Fin 3, f i j| ≤ 9 * ε := by
      intro f ε hf
      simp only [Fin.sum_univ_three]
      obtain ⟨h1, h2⟩ := abs_le.mp (hf 0 0)
      obtain ⟨h3, h4⟩ := abs_le.mp (hf 0 1)
      obtain ⟨h5, h6⟩ := abs_le.mp (hf 0 2)
      obtain ⟨h7, h8⟩ := abs_le.mp (hf 1 0)
      obtain ⟨h9, h10⟩ := abs_le.mp (hf 1 1)
      obtain ⟨h11, h12⟩ := abs_le.mp (hf 1 2)
      obtain ⟨h13, h14⟩ := abs_le.mp (hf 2 0)
      obtain ⟨h15, h16⟩ := abs_le.mp (hf 2 1)
      obtain ⟨h17, h18⟩ := abs_le.mp (hf 2 2)
      rw [abs_le]; constructor <;> linarith
    have key1 : ∀ f : Fin 3 → ℝ, ∀ ε : ℝ, (∀ i, |f i| ≤ ε) →
        |∑ i : Fin 3, f i| ≤ 3 * ε := by
      intro f ε hf
      simp only [Fin.sum_univ_three]
      obtain ⟨h1, h2⟩ := abs_le.mp (hf 0)
      obtain ⟨h3, h4⟩ := abs_le.mp (hf 1)
      obtain ⟨h5, h6⟩ := abs_le.mp (hf 2)
      rw [abs_le]; constructor <;> linarith
    have hpw : ∀ r : ℝ, max R 2 ≤ r → ∀ θ : sphere (0 : E3) 1,
        ‖T r θ - (-2)‖ ≤ 12 * (C * r ^ (-q)) := by
      intro r hr θ
      have hr2 : 2 ≤ r := le_trans (le_max_right _ _) hr
      have hr0 : 0 < r := by linarith
      obtain ⟨x, hx⟩ : ∃ x : E3, x = r • (θ : E3) := ⟨_, rfl⟩
      have hxn : ‖x‖ = r := by rw [hx]; exact hnorm r hr0 θ
      have hbx := hR ‖x‖ (by rw [hxn]; exact le_trans (le_max_left _ _) hr) x rfl
      rw [hxn] at hbx
      have hε : ∀ i j : Fin 3, |G x i j - (if i = j then (1 : ℝ) else 0)| ≤ C * r ^ (-q) :=
        fun i j => le_trans (hbx i j)
          (mul_le_mul_of_nonneg_right (hcC i j) (Real.rpow_nonneg hr0.le _))
      have hterm : ∀ i j : Fin 3, |(θ : E3) i * (θ : E3) j *
          (G x i j - (if i = j then (1 : ℝ) else 0))| ≤ C * r ^ (-q) := by
        intro i j
        rw [abs_mul, abs_mul]
        have := mul_le_mul (mul_le_one₀ (hθle θ i) (abs_nonneg _) (hθle θ j)) (hε i j)
          (abs_nonneg _) zero_le_one
        linarith
      have hdiag : ∀ i : Fin 3, |G x i i - 1| ≤ C * r ^ (-q) := by
        intro i
        have h := hε i i
        rwa [if_pos rfl] at h
      have hid : T r θ - (-2) = ∑ i : Fin 3, ∑ j : Fin 3, (θ : E3) i * (θ : E3) j *
          (G x i j - (if i = j then (1 : ℝ) else 0)) - ∑ i : Fin 3, (G x i i - 1) := by
        rw [hT]
        dsimp only
        rw [← hx]
        simp only [Fin.sum_univ_three]
        simp
        linear_combination hθsq θ
      rw [Real.norm_eq_abs, hid]
      have hA := key2 _ _ hterm
      have hB := key1 _ _ hdiag
      rw [abs_le] at hA hB ⊢
      constructor <;> linarith [hA.1, hA.2, hB.1, hB.2]
    rw [tendsto_iff_norm_sub_tendsto_zero]
    refine squeeze_zero' (g := fun r => 12 * (C * r ^ (-q)) *
        ((volume : Measure E3).toSphere).real Set.univ)
      (Eventually.of_forall fun r => norm_nonneg _) ?_ ?_
    · filter_upwards [eventually_ge_atTop (max R 2)] with r hr
      have hr1 : 1 < r := by linarith [le_max_right R 2]
      have hrw : ∫ θ, (T r θ - (-2)) ∂(volume : Measure E3).toSphere =
          ∫ θ, T r θ ∂(volume : Measure E3).toSphere -
            -2 * ((volume : Measure E3).toSphere).real Set.univ := by
        rw [integral_sub (hint2 r hr1) (integrable_const _), integral_const, smul_eq_mul]
        ring
      rw [← hrw]
      exact norm_integral_le_of_norm_le_const (ae_of_all _ (hpw r hr))
    · have h := (((tendsto_rpow_neg_atTop hq).const_mul C).const_mul 12).mul_const
        (((volume : Measure E3).toSphere).real Set.univ)
      rwa [mul_zero, mul_zero, zero_mul] at h
  
  have hlim := (hΨlim.mul hm).add ((tendsto_const_nhds (x := 1 / (16 * Real.pi))).mul
    hPlim |>.mul hTlim)
  have hval : 1 * m + 1 / (16 * Real.pi) * (4 * a) * (-2 * (4 * Real.pi)) = m - 2 * a := by
    field_simp
    ring
  rw [hS4, hval] at hlim
  refine hlim.congr' ?_
  filter_upwards [eventually_gt_atTop R₂] with r hr
  rw [hstar r hr]

theorem conformal_decay (G G' : E3 → Matrix (Fin 3) (Fin 3) ℝ) (q a δ R₂ : ℝ)
    (hq : 0 < q) (ha : 0 ≤ a) (ha' : a ≤ 1 / 4) (hδ : 0 < δ) (hR₂ : 1 ≤ R₂)
    (hsmooth : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => G x i j) {x : E3 | 1 < ‖x‖})
    (hdecay : ∀ i j : Fin 3, ∀ l : ℕ, l ≤ 2 →
      (fun x : E3 => ‖iteratedFDeriv ℝ l (fun y => G y i j - if i = j then (1 : ℝ) else 0) x‖)
        =O[Bornology.cobounded E3] fun x : E3 => ‖x‖ ^ (-q - (l : ℝ)))
    (hG' : ∀ x : E3, R₂ < ‖x‖ → G' x = ((1 - a * farPot δ x) ^ 4) • G x) :
    ∀ i j : Fin 3, ∀ l : ℕ, l ≤ 2 →
      (fun x : E3 => ‖iteratedFDeriv ℝ l (fun y => G' y i j - if i = j then (1 : ℝ) else 0) x‖)
        =O[Bornology.cobounded E3] fun x : E3 => ‖x‖ ^ (-(min q 1) - (l : ℝ)) :=
by
  intro i j l hl
  have hev : ∀ᶠ x in Bornology.cobounded E3, 1 < ‖x‖ :=
    tendsto_norm_cobounded_atTop.eventually_gt_atTop 1
  have hopen : IsOpen {x : E3 | 1 < ‖x‖} := isOpen_lt continuous_const continuous_norm
  
  have t_mono : ∀ (s s' : ℝ), s ≤ s' →
      (fun x : E3 => ‖x‖ ^ s) =O[Bornology.cobounded E3] fun x : E3 => ‖x‖ ^ s' := by
    intro s s' hss
    refine Asymptotics.IsBigO.of_bound 1 ?_
    filter_upwards [hev] with x hx
    rw [Real.norm_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _),
      Real.norm_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _), one_mul]
    exact Real.rpow_le_rpow_of_exponent_le hx.le hss
  
  have t_lincomb : ∀ (f g : E3 → ℝ) (m₁ m₂ m α β : ℝ), m₁ ≤ m → m₂ ≤ m →
      cdecaySym f m₁ → cdecaySym g m₂ → cdecaySym (fun y => α * f y + β * g y) m := by
    intro f g m₁ m₂ m α β h₁ h₂ hf hg
    refine ⟨(contDiffOn_const.mul hf.1).add (contDiffOn_const.mul hg.1), fun l hl => ?_⟩
    have key : ∀ᶠ x in Bornology.cobounded E3,
        ‖‖iteratedFDeriv ℝ l (fun y => α * f y + β * g y) x‖‖ ≤
          1 * ‖|α| * ‖iteratedFDeriv ℝ l f x‖ + |β| * ‖iteratedFDeriv ℝ l g x‖‖ := by
      filter_upwards [hev] with x hx
      have hfx : ContDiffAt ℝ l f x :=
        (hf.1.contDiffAt (hopen.mem_nhds hx)).of_le (by exact_mod_cast le_top)
      have hgx : ContDiffAt ℝ l g x :=
        (hg.1.contDiffAt (hopen.mem_nhds hx)).of_le (by exact_mod_cast le_top)
      have e : (fun y => α * f y + β * g y) = α • f + β • g := by
        funext y; simp [smul_eq_mul]
      have hfs : ContDiffAt ℝ l (α • f) x := hfx.const_smul α
      have hgs : ContDiffAt ℝ l (β • g) x := hgx.const_smul β
      rw [e, iteratedFDeriv_add_apply hfs hgs,
        iteratedFDeriv_const_smul_apply hfx, iteratedFDeriv_const_smul_apply hgx, norm_norm,
        one_mul, Real.norm_of_nonneg (by positivity)]
      calc _ ≤ ‖α • iteratedFDeriv ℝ l f x‖ + ‖β • iteratedFDeriv ℝ l g x‖ := norm_add_le _ _
        _ = _ := by rw [norm_smul, norm_smul, Real.norm_eq_abs, Real.norm_eq_abs]
    have b1 := ((hf.2 l hl).const_mul_left |α|).trans (t_mono (m₁ - l) (m - l) (by linarith))
    have b2 := ((hg.2 l hl).const_mul_left |β|).trans (t_mono (m₂ - l) (m - l) (by linarith))
    exact (Asymptotics.IsBigO.of_bound 1 key).trans (b1.add b2)
  
  have t_mul : ∀ (f g : E3 → ℝ) (m₁ m₂ : ℝ),
      cdecaySym f m₁ → cdecaySym g m₂ → cdecaySym (fun y => f y * g y) (m₁ + m₂) := by
    intro f g m₁ m₂ hf hg
    refine ⟨hf.1.mul hg.1, fun l hl => ?_⟩
    have key : ∀ᶠ x in Bornology.cobounded E3,
        ‖‖iteratedFDeriv ℝ l (fun y => f y * g y) x‖‖ ≤
          1 * ‖∑ k ∈ Finset.range (l + 1), (l.choose k : ℝ) * ‖iteratedFDeriv ℝ k f x‖ *
            ‖iteratedFDeriv ℝ (l - k) g x‖‖ := by
      filter_upwards [hev] with x hx
      have h := norm_iteratedFDerivWithin_mul_le hf.1 hg.1 hopen.uniqueDiffOn hx (n := l)
        (by exact_mod_cast le_top)
      have hw : ∀ (n : ℕ) (u : E3 → ℝ),
          iteratedFDerivWithin ℝ n u {x : E3 | 1 < ‖x‖} x = iteratedFDeriv ℝ n u x :=
        fun n u => iteratedFDerivWithin_of_isOpen n hopen hx
      simp only [hw] at h
      rw [norm_norm, one_mul, Real.norm_of_nonneg (Finset.sum_nonneg (fun k _ => by positivity))]
      exact h
    have hsum : (fun x => ∑ k ∈ Finset.range (l + 1), (l.choose k : ℝ) *
        ‖iteratedFDeriv ℝ k f x‖ * ‖iteratedFDeriv ℝ (l - k) g x‖) =O[Bornology.cobounded E3]
        (fun x : E3 => ‖x‖ ^ (m₁ + m₂ - (l : ℝ))) := by
      apply Asymptotics.IsBigO.sum
      intro k hk
      have hkl : k ≤ l := Nat.lt_succ_iff.mp (Finset.mem_range.mp hk)
      have h1 :=
        ((hf.2 k (by omega)).const_mul_left (l.choose k : ℝ)).mul (hg.2 (l - k) (by omega))
      refine h1.congr' (Eventually.of_forall fun x => rfl) ?_
      filter_upwards [hev] with x hx
      rw [← Real.rpow_add (by linarith)]
      congr 1
      rw [Nat.cast_sub hkl]
      ring
    exact (Asymptotics.IsBigO.of_bound 1 key).trans hsum
  
  have t_rpow : ∀ p : ℝ, cdecaySym (fun y : E3 => ‖y‖ ^ p) p := by
    intro p
    have hU : IsOpen {y : E3 | y ≠ 0} := isOpen_ne
    have hcd : ∀ y : E3, y ≠ 0 → ContDiffAt ℝ ∞ (fun y : E3 => ‖y‖ ^ p) y := fun y hy =>
      (contDiffAt_norm ℝ hy).rpow_const_of_ne (norm_ne_zero_iff.mpr hy)
    have hcdU : ContDiffOn ℝ ∞ (fun y : E3 => ‖y‖ ^ p) {y | y ≠ 0} := fun y hy =>
      (hcd y hy).contDiffWithinAt
    have hne : ∀ x : E3, 1 < ‖x‖ → x ≠ 0 := by
      intro x hx h
      rw [h, norm_zero] at hx
      linarith
    refine ⟨hcdU.mono (fun x hx => hne x hx), fun l hl => ?_⟩
    have hcont : ContinuousOn (iteratedFDeriv ℝ l (fun y : E3 => ‖y‖ ^ p)) {y | y ≠ 0} := by
      have := hcdU.continuousOn_iteratedFDerivWithin (m := l) (by exact_mod_cast le_top)
        hU.uniqueDiffOn
      exact this.congr (fun y hy => (iteratedFDerivWithin_of_isOpen l hU hy).symm)
    obtain ⟨K, hK⟩ := (isCompact_sphere (0 : E3) 1).exists_bound_of_continuousOn
      (hcont.mono (fun y hy => by
        have hy' : ‖y‖ = 1 := mem_sphere_zero_iff_norm.mp hy
        show y ≠ 0
        intro h; rw [h, norm_zero] at hy'; norm_num at hy'))
    have main : ∀ x : E3, x ≠ 0 →
        ‖iteratedFDeriv ℝ l (fun y : E3 => ‖y‖ ^ p) x‖ ≤ K * ‖x‖ ^ (p - (l : ℝ)) := by
      intro x hx
      have hr : 0 < ‖x‖ := norm_pos_iff.mpr hx
      have ht : 0 < ‖x‖⁻¹ := inv_pos.mpr hr
      let L : E3 →L[ℝ] E3 := ‖x‖⁻¹ • ContinuousLinearMap.id ℝ E3
      have hLy : ∀ y, L y = ‖x‖⁻¹ • y := fun y => rfl
      have hcomp : (fun y : E3 => ‖y‖ ^ p) ∘ L = fun y => ‖x‖⁻¹ ^ p * ‖y‖ ^ p := by
        funext y
        show ‖L y‖ ^ p = ‖x‖⁻¹ ^ p * ‖y‖ ^ p
        rw [hLy, norm_smul, Real.norm_of_nonneg ht.le]
        exact Real.mul_rpow ht.le (norm_nonneg y)
      have hLx : L x ∈ {y : E3 | y ≠ 0} := by
        show L x ≠ 0
        rw [hLy]; exact smul_ne_zero ht.ne' hx
      have hpre : IsOpen (L ⁻¹' {y : E3 | y ≠ 0}) := hU.preimage L.continuous
      have hxpre : x ∈ L ⁻¹' {y : E3 | y ≠ 0} := hLx
      have hchain := L.iteratedFDerivWithin_comp_right hcdU hU.uniqueDiffOn hpre.uniqueDiffOn
        hLx (i := l) (by exact_mod_cast le_top)
      rw [iteratedFDerivWithin_of_isOpen l hpre hxpre, iteratedFDerivWithin_of_isOpen l hU hLx,
        hcomp] at hchain
      have hsm : (fun y : E3 => ‖x‖⁻¹ ^ p * ‖y‖ ^ p) =
          (‖x‖⁻¹ ^ p) • (fun y : E3 => ‖y‖ ^ p) := by
        funext y; simp [smul_eq_mul]
      rw [hsm, iteratedFDeriv_const_smul_apply ((hcd x hx).of_le (by exact_mod_cast le_top))]
        at hchain
      have hn := congrArg norm hchain
      rw [norm_smul, Real.norm_of_nonneg (Real.rpow_nonneg ht.le p)] at hn
      have hle := ContinuousMultilinearMap.norm_compContinuousLinearMap_le
        (iteratedFDeriv ℝ l (fun y : E3 => ‖y‖ ^ p) (L x)) (fun _ => L)
      rw [← hn] at hle
      have hLn : ‖L‖ ≤ ‖x‖⁻¹ := by
        calc ‖L‖ ≤ ‖‖x‖⁻¹‖ * ‖ContinuousLinearMap.id ℝ E3‖ :=
              norm_smul_le (‖x‖⁻¹ : ℝ) (ContinuousLinearMap.id ℝ E3)
          _ ≤ ‖x‖⁻¹ * 1 := by
            rw [Real.norm_of_nonneg ht.le]
            exact mul_le_mul_of_nonneg_left ContinuousLinearMap.norm_id_le ht.le
          _ = ‖x‖⁻¹ := mul_one _
      have hprod : ∏ _i : Fin l, ‖L‖ ≤ ‖x‖⁻¹ ^ l := by
        rw [Finset.prod_const, Finset.card_univ, Fintype.card_fin]
        exact pow_le_pow_left₀ (norm_nonneg _) hLn l
      have hKx : ‖iteratedFDeriv ℝ l (fun y : E3 => ‖y‖ ^ p) (L x)‖ ≤ K := by
        apply hK
        rw [mem_sphere_zero_iff_norm, hLy, norm_smul, Real.norm_of_nonneg ht.le]
        exact inv_mul_cancel₀ hr.ne'
      have hK0 : 0 ≤ K := le_trans (norm_nonneg _) hKx
      have h2 : ‖x‖⁻¹ ^ p * ‖iteratedFDeriv ℝ l (fun y : E3 => ‖y‖ ^ p) x‖ ≤ K * ‖x‖⁻¹ ^ l :=
        le_trans hle (mul_le_mul hKx hprod (Finset.prod_nonneg (fun _ _ => norm_nonneg _)) hK0)
      have hrp : 0 < ‖x‖ ^ p := Real.rpow_pos_of_pos hr p
      rw [Real.inv_rpow hr.le, inv_pow] at h2
      rw [Real.rpow_sub hr, Real.rpow_natCast]
      calc ‖iteratedFDeriv ℝ l (fun y : E3 => ‖y‖ ^ p) x‖
          = ‖x‖ ^ p * ((‖x‖ ^ p)⁻¹ * ‖iteratedFDeriv ℝ l (fun y : E3 => ‖y‖ ^ p) x‖) := by
            field_simp
        _ ≤ ‖x‖ ^ p * (K * (‖x‖ ^ l)⁻¹) := mul_le_mul_of_nonneg_left h2 hrp.le
        _ = K * (‖x‖ ^ p / ‖x‖ ^ l) := by ring
    refine Asymptotics.IsBigO.of_bound K ?_
    filter_upwards [hev] with x hx
    rw [norm_norm, Real.norm_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _)]
    exact main x (hne x hx)
  
  have hφ : cdecaySym (farPot δ) (-1) := by
    have e : farPot δ = fun y => 1 * ‖y‖ ^ (-1 : ℝ) + 1 * ‖y‖ ^ (-1 - δ) := by
      funext y; simp only [farPot, Real.rpow_neg_one, one_mul]
    rw [e]
    exact t_lincomb _ _ (-1) (-1 - δ) (-1) 1 1 le_rfl (by linarith) (t_rpow _) (t_rpow _)
  have hφ2 := t_mul _ _ _ _ hφ hφ
  have hφ3 := t_mul _ _ _ _ hφ2 hφ
  have hφ4 := t_mul _ _ _ _ hφ3 hφ
  have hA := t_lincomb _ _ _ _ (-1) (-4 * a) (6 * a ^ 2) le_rfl (by norm_num) hφ hφ2
  have hB := t_lincomb _ _ _ _ (-1) (-4 * a ^ 3) (a ^ 4) (by norm_num) (by norm_num) hφ3 hφ4
  have hV' := t_lincomb _ _ _ _ (-1) 1 1 le_rfl le_rfl hA hB
  obtain ⟨V, hVdef⟩ : ∃ V : E3 → ℝ, V = fun y => (1 - a * farPot δ y) ^ 4 - 1 := ⟨_, rfl⟩
  have hV : cdecaySym V (-1) := by
    have e : V = fun y => 1 * ((-4 * a) * farPot δ y + (6 * a ^ 2) * (farPot δ y * farPot δ y)) +
        1 * ((-4 * a ^ 3) * (farPot δ y * farPot δ y * farPot δ y) +
          a ^ 4 * (farPot δ y * farPot δ y * farPot δ y * farPot δ y)) := by
      rw [hVdef]; funext y; ring
    rw [e]; exact hV'
  
  obtain ⟨c, hc⟩ : ∃ c : ℝ, c = if i = j then (1 : ℝ) else 0 := ⟨_, rfl⟩
  obtain ⟨h, hhdef⟩ : ∃ h : E3 → ℝ, h = fun y => G y i j - c := ⟨_, rfl⟩
  have hh : cdecaySym h (-q) := by
    refine ⟨?_, ?_⟩
    · rw [hhdef]; exact (hsmooth i j).sub contDiffOn_const
    · intro l hl
      rw [hhdef, hc]
      exact hdecay i j l hl
  have hVh := t_mul _ _ _ _ hV hh
  have hmin1 := min_le_left q 1
  have hmin2 := min_le_right q 1
  have hT := t_lincomb _ _ (-q) (-1 + -q) (-(min q 1)) 1 1 (by linarith) (by linarith) hh hVh
  have hH := t_lincomb _ _ (-(min q 1)) (-1) (-(min q 1)) 1 c le_rfl (by linarith) hT hV
  have hfarnhds : ∀ x : E3, R₂ < ‖x‖ →
      (fun y => G' y i j - if i = j then (1 : ℝ) else 0) =ᶠ[𝓝 x]
        (fun y => 1 * (1 * h y + 1 * (V y * h y)) + c * V y) := by
    intro x hx
    refine Filter.eventuallyEq_of_mem
      ((isOpen_lt continuous_const continuous_norm).mem_nhds hx) ?_
    intro y hy
    have hy' : R₂ < ‖y‖ := hy
    have hGy : G' y i j = (1 - a * farPot δ y) ^ 4 * G y i j := by
      rw [hG' y hy', Matrix.smul_apply, smul_eq_mul]
    simp only
    rw [hGy, ← hc, hhdef, hVdef]
    ring
  refine (hH.2 l hl).congr' ?_ (EventuallyEq.rfl)
  filter_upwards [tendsto_norm_cobounded_atTop.eventually_gt_atTop R₂] with x hx
  rw [((hfarnhds x hx).iteratedFDeriv ℝ l).eq_of_nhds]

theorem conformal_scalar_integrable (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (u : E3 → ℝ)
    (q a δ R₂ : ℝ) (hδ : 0 < δ) (hδq : δ < q) (ha : 0 ≤ a) (ha' : a ≤ 1 / 4) (hR₂ : 2 ≤ R₂)
    (hsmooth : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => G x i j) {x : E3 | 1 < ‖x‖})
    (hsymm : ∀ (x : E3) (i j : Fin 3), G x i j = G x j i)
    (hdet : ∀ x : E3, 1 < ‖x‖ → 0 < (G x).det)
    (hdecay : ∀ i j : Fin 3, ∀ l : ℕ, l ≤ 2 →
      (fun x : E3 => ‖iteratedFDeriv ℝ l (fun y => G y i j - if i = j then (1 : ℝ) else 0) x‖)
        =O[Bornology.cobounded E3] fun x : E3 => ‖x‖ ^ (-q - (l : ℝ)))
    (hint : IntegrableOn (fun x : E3 => scalarCurvatureLocal G x * Real.sqrt (G x).det)
      {x : E3 | 2 < ‖x‖})
    (hu : ContDiffOn ℝ ∞ u {x : E3 | 1 < ‖x‖}) (hupos : ∀ x : E3, 1 < ‖x‖ → 0 < u x)
    (hufar : ∀ x : E3, R₂ < ‖x‖ → u x = 1 - a * farPot δ x) :
    IntegrableOn (fun x : E3 => scalarCurvatureLocal (fun y => (u y ^ 4) • G y) x *
      Real.sqrt ((u x ^ 4) • G x).det) {x : E3 | 2 < ‖x‖} :=
by
  classical
  have hq0 : 0 < q := by linarith
  have hUo : IsOpen {x : E3 | 1 < ‖x‖} := isOpen_lt continuous_const continuous_norm
  have hSm : MeasurableSet {x : E3 | 2 < ‖x‖} := measurableSet_lt measurable_const measurable_norm
  have hSU : {x : E3 | 2 < ‖x‖} ⊆ {x : E3 | 1 < ‖x‖} := fun x hx => by
    have h : (2 : ℝ) < ‖x‖ := hx
    show (1 : ℝ) < ‖x‖
    linarith
  have hKc : ∀ T : ℝ, IsCompact (closedBall (0 : E3) T ∩ {x : E3 | 2 ≤ ‖x‖}) := fun T =>
    (isCompact_closedBall 0 T).inter_right (isClosed_le continuous_const continuous_norm)
  have hKU : ∀ T : ℝ, closedBall (0 : E3) T ∩ {x : E3 | 2 ≤ ‖x‖} ⊆ {x : E3 | 1 < ‖x‖} :=
    fun T x hx => by
      have h : (2 : ℝ) ≤ ‖x‖ := hx.2
      show (1 : ℝ) < ‖x‖
      linarith
  
  have hGc : ∀ i j : Fin 3, ContinuousOn (fun x => G x i j) {x : E3 | 1 < ‖x‖} :=
    fun i j => (hsmooth i j).continuousOn
  have hA : Continuous (fun y : {x : E3 | 1 < ‖x‖} => G (y : E3)) :=
    continuous_matrix (fun i j => (hGc i j).restrict)
  have hinvf : ∀ (A : Matrix (Fin 3) (Fin 3) ℝ) (i j : Fin 3), A⁻¹ i j = A.det⁻¹ * A.adjugate i j := by
    intro A i j
    rw [Matrix.inv_def, Ring.inverse_eq_inv, Matrix.smul_apply, smul_eq_mul]
  have hGinvC : ∀ i j : Fin 3, ContinuousOn (fun x => (G x)⁻¹ i j) {x : E3 | 1 < ‖x‖} := by
    intro i j
    rw [continuousOn_iff_continuous_restrict]
    have h1 : Continuous (fun y : {x : E3 | 1 < ‖x‖} => ((G (y : E3)).det)⁻¹) :=
      hA.matrix_det.inv₀ (fun y => (hdet y y.2).ne')
    have h2 := hA.matrix_adjugate.matrix_elem i j
    have heq : Set.restrict {x : E3 | 1 < ‖x‖} (fun x => (G x)⁻¹ i j) =
        fun y : {x : E3 | 1 < ‖x‖} => ((G (y : E3)).det)⁻¹ * (G (y : E3)).adjugate i j := by
      funext y
      simp only [Set.restrict_apply]
      rw [hinvf]
    rw [heq]
    exact h1.mul h2
  have hsqC : ContinuousOn (fun x => Real.sqrt (G x).det) {x : E3 | 1 < ‖x‖} :=
    (continuousOn_iff_continuous_restrict.2 hA.matrix_det).sqrt
  have hpd : ∀ f : E3 → ℝ, ContDiffOn ℝ ∞ f {x : E3 | 1 < ‖x‖} → ∀ l : Fin 3,
      ContDiffOn ℝ ∞ (fun z => partialDeriv l f z) {x : E3 | 1 < ‖x‖} := by
    intro f hf l
    have h1 : ContDiffOn ℝ ∞ (fderiv ℝ f) {x : E3 | 1 < ‖x‖} := hf.fderiv_of_isOpen hUo (by simp)
    exact h1.clm_apply contDiffOn_const
  have hchr : ∀ k i j : Fin 3, ContinuousOn (fun y => christoffel G k i j y) {x : E3 | 1 < ‖x‖} := by
    intro k i j
    unfold christoffel
    refine continuousOn_const.mul (continuousOn_finset_sum _ (fun l _ => ?_))
    exact (hGinvC k l).mul ((((hpd _ (hsmooth j l) i).continuousOn).add
      ((hpd _ (hsmooth i l) j).continuousOn)).sub ((hpd _ (hsmooth i j) l).continuousOn))
  have hlapC : ContinuousOn (fun y => lapLocal G u y) {x : E3 | 1 < ‖x‖} := by
    unfold lapLocal
    refine continuousOn_finset_sum _ (fun i _ => continuousOn_finset_sum _ (fun j _ => ?_))
    refine (hGinvC i j).mul (((hpd _ (hpd u hu j) i).continuousOn).sub
      (continuousOn_finset_sum _ (fun k _ => ?_)))
    exact (hchr k i j).mul ((hpd u hu k).continuousOn)
  have huC : ContinuousOn u {x : E3 | 1 < ‖x‖} := hu.continuousOn
  
  have hpt : ∀ x : E3, 1 < ‖x‖ →
      scalarCurvatureLocal (fun y => (u y ^ 4) • G y) x * Real.sqrt ((u x ^ 4) • G x).det =
        -8 * u x * lapLocal G u x * Real.sqrt (G x).det +
          u x ^ 2 * (scalarCurvatureLocal G x * Real.sqrt (G x).det) := by
    intro x hx
    have hc := conformal_scalarCurvatureLocal G u {x : E3 | 1 < ‖x‖} hUo hsmooth hsymm
      (fun y hy => (hdet y hy).ne') hu (fun y hy => hupos y hy) x hx
    have hv : 0 < u x := hupos x hx
    have hdet' : ((u x ^ 4) • G x).det = (u x ^ 6) ^ 2 * (G x).det := by
      rw [Matrix.det_smul, Fintype.card_fin]; ring
    rw [hc, hdet', Real.sqrt_mul (sq_nonneg _), Real.sqrt_sq (pow_nonneg hv.le 6)]
    have e6 : u x ^ 6 = u x ^ 5 * u x := by ring
    rw [e6]
    have hinv5 : (u x ^ 5)⁻¹ * u x ^ 5 = 1 := inv_mul_cancel₀ (pow_ne_zero 5 hv.ne')
    linear_combination (-8 * lapLocal G u x * u x * Real.sqrt (G x).det +
      scalarCurvatureLocal G x * u x * u x * Real.sqrt (G x).det) * hinv5
  
  have hφ : ∀ x : E3, 1 ≤ ‖x‖ → 0 ≤ farPot δ x ∧ farPot δ x ≤ 2 := by
    intro x hx
    have h1 : ‖x‖⁻¹ ≤ 1 := inv_le_one_of_one_le₀ hx
    have h2 : ‖x‖ ^ (-1 - δ) ≤ 1 := Real.rpow_le_one_of_one_le_of_nonpos hx (by linarith)
    have h3 : 0 ≤ ‖x‖⁻¹ := inv_nonneg.mpr (norm_nonneg _)
    have h4 : 0 ≤ ‖x‖ ^ (-1 - δ) := Real.rpow_nonneg (norm_nonneg _) _
    unfold farPot
    constructor <;> linarith
  have hub : ∀ x : E3, R₂ < ‖x‖ → 1 / 2 ≤ u x ∧ u x ≤ 1 := by
    intro x hx
    have h := hφ x (by linarith)
    rw [hufar x hx]
    have h1 : a * farPot δ x ≤ a * 2 := mul_le_mul_of_nonneg_left h.2 ha
    have h2 : 0 ≤ a * farPot δ x := mul_nonneg ha h.1
    constructor <;> linarith
  
  have hh₂ : IntegrableOn (fun x => u x ^ 2 * (scalarCurvatureLocal G x * Real.sqrt (G x).det))
      {x : E3 | 2 < ‖x‖} := by
    obtain ⟨C₁, hC₁⟩ := (hKc R₂).exists_bound_of_continuousOn ((huC.pow 2).mono (hKU R₂))
    refine Integrable.bdd_mul (c := max C₁ 1) hint ?_ ?_
    · exact ((huC.pow 2).mono hSU).aestronglyMeasurable hSm
    · refine ae_restrict_of_forall_mem hSm (fun x hx => ?_)
      have hx2 : (2 : ℝ) < ‖x‖ := hx
      by_cases hxR : ‖x‖ ≤ R₂
      · have := hC₁ x ⟨mem_closedBall_zero_iff.2 hxR, show (2 : ℝ) ≤ ‖x‖ by linarith⟩
        exact this.trans (le_max_left _ _)
      · push_neg at hxR
        have hb := hub x hxR
        rw [Real.norm_eq_abs, abs_of_nonneg (sq_nonneg _)]
        nlinarith [le_max_right C₁ 1]
  
  have H1 : ∀ (u v : E3 → ℝ) (y : E3), u =ᶠ[𝓝 y] v → lapLocal G u y = lapLocal G v y := by
    intro u v y huv
    have h1 : ∀ l : Fin 3, partialDeriv l u y = partialDeriv l v y := by
      intro l
      show fderiv ℝ u y (e l) = fderiv ℝ v y (e l)
      rw [huv.fderiv_eq]
    have h2 : ∀ i l : Fin 3, partialDeriv i (fun z => partialDeriv l u z) y =
        partialDeriv i (fun z => partialDeriv l v z) y := by
      intro i l
      have hev : (fun z => partialDeriv l u z) =ᶠ[𝓝 y] (fun z => partialDeriv l v z) := by
        filter_upwards [huv.eventuallyEq_nhds] with z hz
        show fderiv ℝ u z (e l) = fderiv ℝ v z (e l)
        rw [hz.fderiv_eq]
      show fderiv ℝ (fun z => partialDeriv l u z) y (e i) =
        fderiv ℝ (fun z => partialDeriv l v z) y (e i)
      rw [hev.fderiv_eq]
    simp only [lapLocal, h1, h2]
  have H2 : ∀ (u : E3 → ℝ) (α γ : ℝ) (y : E3),
      lapLocal G (fun z => α * u z + γ) y = α * lapLocal G u y := by
    intro u α γ y
    have hP0 : ∀ (w : E3 → ℝ) (l : Fin 3) (z : E3),
        partialDeriv l (fun z => α * w z) z = α * partialDeriv l w z := by
      intro w l z
      show fderiv ℝ (fun z => α * w z) z (e l) = α * fderiv ℝ w z (e l)
      have : (fun z => α * w z) = α • w := by funext z; simp
      rw [this, fderiv_const_smul_of_field]; rfl
    have hP : ∀ (w : E3 → ℝ) (γ' : ℝ) (l : Fin 3) (z : E3),
        partialDeriv l (fun z => α * w z + γ') z = α * partialDeriv l w z := by
      intro w γ' l z
      rw [← hP0]
      show fderiv ℝ (fun z => α * w z + γ') z (e l) = fderiv ℝ (fun z => α * w z) z (e l)
      rw [fderiv_add_const]
    have h2 : ∀ i l : Fin 3, partialDeriv i (fun z => partialDeriv l (fun z => α * u z + γ) z) y
        = α * partialDeriv i (fun z => partialDeriv l u z) y := by
      intro i l
      have : (fun z => partialDeriv l (fun z => α * u z + γ) z) =
          fun z => α * partialDeriv l u z := by
        funext z; exact hP u γ l z
      rw [this, hP0]
    simp only [lapLocal, h2, hP, hP0, Fin.sum_univ_three]
    ring
  have hlapfar : ∀ x : E3, R₂ < ‖x‖ → lapLocal G u x = -a * lapLocal G (farPot δ) x := by
    intro x hx
    have hev : u =ᶠ[𝓝 x] (fun z => -a * farPot δ z + 1) := by
      filter_upwards [(isOpen_lt continuous_const continuous_norm).mem_nhds
        (show x ∈ {z : E3 | R₂ < ‖z‖} from hx)] with z hz
      rw [hufar z hz]; ring
    rw [H1 u _ x hev, H2 (farPot δ) (-a) 1 x]
  
  have hdet48 : ∀ A : Matrix (Fin 3) (Fin 3) ℝ, (∀ i j, |A i j| ≤ 2) → A.det ≤ 48 := by
    intro A hA
    rw [Matrix.det_fin_three]
    have hp : ∀ i j k l m n : Fin 3, A i j * A k l * A m n ≤ 8 ∧ -(A i j * A k l * A m n) ≤ 8 := by
      intro i j k l m n
      have h : |A i j * A k l * A m n| ≤ 8 := by
        rw [abs_mul, abs_mul]
        have h1 := hA i j
        have h2 := hA k l
        have h3 := hA m n
        calc |A i j| * |A k l| * |A m n| ≤ 2 * 2 * 2 := by gcongr
          _ = 8 := by norm_num
      exact ⟨(le_abs_self _).trans h, (neg_le_abs _).trans h⟩
    linarith [(hp 0 0 1 1 2 2).1, (hp 0 0 1 2 2 1).2, (hp 0 1 1 0 2 2).2, (hp 0 1 1 2 2 0).1,
      (hp 0 2 1 0 2 1).1, (hp 0 2 1 1 2 0).2]
  have hev : ∀ᶠ x in Bornology.cobounded E3, ∀ i j : Fin 3, |G x i j| ≤ 2 := by
    rw [Filter.eventually_all]; intro i
    rw [Filter.eventually_all]; intro j
    have hO := hdecay i j 0 (by norm_num)
    have ht : Tendsto (fun x : E3 => ‖x‖ ^ (-q - ((0 : ℕ) : ℝ))) (Bornology.cobounded E3) (𝓝 0) := by
      have := (tendsto_rpow_neg_atTop hq0).comp (tendsto_norm_cobounded_atTop (E := E3))
      refine this.congr (fun x => ?_)
      simp
    have h2 := (hO.trans_tendsto ht).eventually (gt_mem_nhds one_pos)
    filter_upwards [h2] with x hx
    simp only [norm_iteratedFDeriv_zero, Real.norm_eq_abs] at hx
    have h3 := abs_sub_abs_le_abs_sub (G x i j) (if i = j then (1 : ℝ) else 0)
    have h01 : |(if i = j then (1 : ℝ) else 0)| ≤ 1 := by split_ifs <;> simp
    linarith
  obtain ⟨R₁, -, hR₁⟩ := (Metric.hasBasis_cobounded_compl_closedBall (0 : E3)).eventually_iff.1 hev
  
  obtain ⟨R₀, C, hR₀, hRC⟩ := farPot_lap_bounds G q δ hδ hδq hsmooth hsymm hdecay
  obtain ⟨R₃, hR₃⟩ : ∃ R₃ : ℝ, R₃ = max (max R₀ R₂) R₁ + 1 := ⟨_, rfl⟩
  have hR₃0 : R₀ < R₃ := by rw [hR₃]; have := le_max_left R₀ R₂; have := le_max_left (max R₀ R₂) R₁; linarith
  have hR₃2 : R₂ < R₃ := by rw [hR₃]; have := le_max_right R₀ R₂; have := le_max_left (max R₀ R₂) R₁; linarith
  have hR₃1 : R₁ < R₃ := by rw [hR₃]; have := le_max_right (max R₀ R₂) R₁; linarith
  have hBm : MeasurableSet {x : E3 | R₃ < ‖x‖} := measurableSet_lt measurable_const measurable_norm
  have hBU : {x : E3 | R₃ < ‖x‖} ⊆ {x : E3 | 1 < ‖x‖} := fun x hx => by
    have h : R₃ < ‖x‖ := hx
    show (1 : ℝ) < ‖x‖
    linarith
  
  have hpow : IntegrableOn (fun x : E3 => ‖x‖ ^ (-3 - δ)) {x : E3 | R₃ < ‖x‖} := by
    have hI : Integrable (fun x : E3 => (1 + ‖x‖) ^ (-(3 + δ))) :=
      integrable_one_add_norm (by rw [finrank_euclideanSpace_fin]; push_cast; linarith)
    have hI2 : Integrable (fun x : E3 => 2 ^ (3 + δ) * (1 + ‖x‖) ^ (-(3 + δ))) := hI.const_mul _
    refine Integrable.mono' hI2.integrableOn ?_ ?_
    · exact (measurable_norm.pow_const _).aestronglyMeasurable
    · refine ae_restrict_of_forall_mem hBm (fun x hx => ?_)
      have hx' : R₃ < ‖x‖ := hx
      have hx1 : 1 ≤ ‖x‖ := by linarith
      rw [Real.norm_eq_abs, abs_of_nonneg (Real.rpow_nonneg (norm_nonneg _) _)]
      have h1 : ‖x‖ ^ (-3 - δ) ≤ ((1 + ‖x‖) / 2) ^ (-3 - δ) :=
        Real.rpow_le_rpow_of_nonpos (by positivity) (by linarith) (by linarith)
      have h2 : ((1 + ‖x‖) / 2) ^ (-3 - δ) = 2 ^ (3 + δ) * (1 + ‖x‖) ^ (-(3 + δ)) := by
        rw [Real.div_rpow (by positivity) (by norm_num)]
        rw [show (-3 - δ) = -(3 + δ) by ring, Real.rpow_neg (by norm_num : (0 : ℝ) ≤ 2),
          div_inv_eq_mul, mul_comm]
      linarith
  
  have hh₁C : ContinuousOn (fun x => -8 * u x * lapLocal G u x * Real.sqrt (G x).det)
      {x : E3 | 1 < ‖x‖} :=
    ((continuousOn_const.mul huC).mul hlapC).mul hsqC
  have hh₁A : IntegrableOn (fun x => -8 * u x * lapLocal G u x * Real.sqrt (G x).det)
      (closedBall (0 : E3) R₃ ∩ {x : E3 | 2 ≤ ‖x‖}) :=
    ContinuousOn.integrableOn_compact (hKc R₃) (hh₁C.mono (hKU R₃))
  have hh₁B : IntegrableOn (fun x => -8 * u x * lapLocal G u x * Real.sqrt (G x).det)
      {x : E3 | R₃ < ‖x‖} := by
    refine Integrable.mono' (Integrable.const_mul hpow (56 * a * C)) ?_ ?_
    · exact (hh₁C.mono hBU).aestronglyMeasurable hBm
    · refine ae_restrict_of_forall_mem hBm (fun x hx => ?_)
      have hx' : R₃ < ‖x‖ := hx
      have hxR₂ : R₂ < ‖x‖ := by linarith
      have hxR₀ : R₀ < ‖x‖ := by linarith
      have hxR₁ : R₁ < ‖x‖ := by linarith
      have hb := hub x hxR₂
      have hL := (hRC x hxR₀).2
      have hGb : ∀ i j : Fin 3, |G x i j| ≤ 2 := by
        have hxc : x ∈ (closedBall (0 : E3) R₁)ᶜ := by
          rw [Set.mem_compl_iff, mem_closedBall_zero_iff]; linarith
        exact hR₁ hxc
      have hD48 := hdet48 (G x) hGb
      have hs0 : 0 ≤ Real.sqrt (G x).det := Real.sqrt_nonneg _
      have hs7 : Real.sqrt (G x).det ≤ 7 := Real.sqrt_le_iff.mpr ⟨by norm_num, by linarith⟩
      show ‖-8 * u x * lapLocal G u x * Real.sqrt (G x).det‖ ≤ 56 * a * C * ‖x‖ ^ (-3 - δ)
      rw [hlapfar x hxR₂]
      have hcoef : 0 ≤ 8 * a * u x * Real.sqrt (G x).det :=
        mul_nonneg (mul_nonneg (mul_nonneg (by norm_num) ha) (by linarith)) hs0
      have e : ‖-8 * u x * (-a * lapLocal G (farPot δ) x) * Real.sqrt (G x).det‖ =
          8 * a * u x * Real.sqrt (G x).det * |lapLocal G (farPot δ) x| := by
        rw [Real.norm_eq_abs, show -8 * u x * (-a * lapLocal G (farPot δ) x) * Real.sqrt (G x).det
          = (8 * a * u x * Real.sqrt (G x).det) * lapLocal G (farPot δ) x by ring, abs_mul,
          abs_of_nonneg hcoef]
      rw [e]
      have hus : u x * Real.sqrt (G x).det ≤ 7 := by nlinarith
      have h1 : 8 * a * u x * Real.sqrt (G x).det ≤ 56 * a := by
        nlinarith [mul_le_mul_of_nonneg_left hus ha]
      calc 8 * a * u x * Real.sqrt (G x).det * |lapLocal G (farPot δ) x|
          ≤ 56 * a * |lapLocal G (farPot δ) x| := mul_le_mul_of_nonneg_right h1 (abs_nonneg _)
        _ ≤ 56 * a * (C * ‖x‖ ^ (-3 - δ)) :=
          mul_le_mul_of_nonneg_left hL (mul_nonneg (by norm_num) ha)
        _ = 56 * a * C * ‖x‖ ^ (-3 - δ) := by ring
  have hh₁ : IntegrableOn (fun x => -8 * u x * lapLocal G u x * Real.sqrt (G x).det)
      {x : E3 | 2 < ‖x‖} := by
    refine (hh₁A.union hh₁B).mono_set (fun x hx => ?_)
    have hx2 : (2 : ℝ) < ‖x‖ := hx
    by_cases h : ‖x‖ ≤ R₃
    · exact Or.inl ⟨mem_closedBall_zero_iff.2 h, show (2 : ℝ) ≤ ‖x‖ by linarith⟩
    · exact Or.inr (show R₃ < ‖x‖ from lt_of_not_ge h)
  have hsum : IntegrableOn (fun x => -8 * u x * lapLocal G u x * Real.sqrt (G x).det +
      u x ^ 2 * (scalarCurvatureLocal G x * Real.sqrt (G x).det)) {x : E3 | 2 < ‖x‖} :=
    Integrable.add hh₁ hh₂
  refine hsum.congr_fun (fun x hx => ?_) hSm
  have hx2 : (2 : ℝ) < ‖x‖ := hx
  exact (hpt x (by linarith)).symm

theorem smax1_props : ContDiff ℝ ∞ smax1 ∧
    (∀ u, deriv smax1 u = Real.smoothTransition ((u + 1) / 2)) ∧
    (∀ u, 0 ≤ deriv (deriv smax1) u) ∧ (∀ u, u ≤ -1 → smax1 u = 0) ∧
    (∀ u, 1 ≤ u → smax1 u = u) ∧ (∀ u, max u 0 ≤ smax1 u) ∧ (∀ u, smax1 u ≤ max u 0 + 1) :=
by
  obtain ⟨σ, hσ⟩ : ∃ σ : ℝ → ℝ, σ = fun t => Real.smoothTransition ((t + 1) / 2) := ⟨_, rfl⟩
  have hσd : ContDiff ℝ ∞ σ := by
    rw [hσ]
    exact Real.smoothTransition.contDiff.comp (by fun_prop)
  have hσc : Continuous σ := hσd.continuous
  have hσmono : Monotone σ := by
    intro a b hab
    rw [hσ]
    exact Real.smoothTransition.monotone (by linarith)
  have hσ01 : ∀ u, 0 ≤ σ u ∧ σ u ≤ 1 := by
    intro u; rw [hσ]
    exact ⟨Real.smoothTransition.nonneg _, Real.smoothTransition.le_one _⟩
  have hσ0 : ∀ t, t ≤ -1 → σ t = 0 := by
    intro t ht; rw [hσ]
    exact Real.smoothTransition.zero_of_nonpos (by linarith)
  have hσ1 : ∀ t, 1 ≤ t → σ t = 1 := by
    intro t ht; rw [hσ]
    exact Real.smoothTransition.one_of_one_le (by linarith)
  
  have hS : ∀ x : ℝ, Real.smoothTransition x + Real.smoothTransition (1 - x) = 1 := by
    intro x
    have h1 := Real.smoothTransition.pos_denom x
    unfold Real.smoothTransition
    rw [sub_sub_cancel, add_comm (expNegInvGlue (1 - x)) (expNegInvGlue x), div_add_div_same,
      div_self h1.ne']
  have hσs : ∀ t, σ t + σ (-t) = 1 := by
    intro t
    have h := hS ((t + 1) / 2)
    have e : 1 - (t + 1) / 2 = (-t + 1) / 2 := by ring
    rw [e] at h
    rw [hσ]
    exact h
  
  have e1 : smax1 = fun u => ∫ t in (-1 : ℝ)..u, σ t := by
    funext v; rw [hσ]; rfl
  have hD : ∀ u, HasDerivAt smax1 (σ u) u := by
    intro u
    rw [e1]
    exact intervalIntegral.integral_hasDerivAt_right (hσc.intervalIntegrable (-1) u)
      (hσc.stronglyMeasurableAtFilter _ _) hσc.continuousAt
  have hderiv : deriv smax1 = σ := funext fun u => (hD u).deriv
  have hdiff : Differentiable ℝ smax1 := fun u => (hD u).differentiableAt
  have P1 : ContDiff ℝ ∞ smax1 := contDiff_infty_iff_deriv.mpr ⟨hdiff, hderiv ▸ hσd⟩
  have P4 : ∀ u, u ≤ -1 → smax1 u = 0 := by
    intro u hu
    rw [e1]
    show ∫ t in (-1 : ℝ)..u, σ t = 0
    rw [intervalIntegral.integral_congr (g := fun _ => (0 : ℝ)) ?_]
    · exact intervalIntegral.integral_zero
    · intro t ht
      rw [Set.uIcc_of_ge hu] at ht
      exact hσ0 t ht.2
  have hI : ∫ t in (-1 : ℝ)..1, σ t = 1 := by
    have h1 : ∫ x in (-1 : ℝ)..1, σ (-x) = ∫ x in (-1 : ℝ)..1, σ x := by
      rw [intervalIntegral.integral_comp_neg]
      norm_num
    have h2 : ∫ x in (-1 : ℝ)..1, (σ x + σ (-x)) =
        (∫ x in (-1 : ℝ)..1, σ x) + ∫ x in (-1 : ℝ)..1, σ (-x) :=
      intervalIntegral.integral_add (hσc.intervalIntegrable _ _)
        ((hσc.comp continuous_neg : Continuous fun x => σ (-x)).intervalIntegrable _ _)
    have h3 : ∫ x in (-1 : ℝ)..1, (σ x + σ (-x)) = 2 := by
      simp only [hσs]
      rw [intervalIntegral.integral_const, smul_eq_mul]
      norm_num
    linarith
  have P5 : ∀ u, 1 ≤ u → smax1 u = u := by
    intro u hu
    rw [e1]
    show ∫ t in (-1 : ℝ)..u, σ t = u
    rw [← intervalIntegral.integral_add_adjacent_intervals (b := 1)
      (hσc.intervalIntegrable _ _) (hσc.intervalIntegrable _ _), hI]
    rw [intervalIntegral.integral_congr (g := fun _ => (1 : ℝ)) ?_]
    · rw [intervalIntegral.integral_const, smul_eq_mul]
      ring
    · intro t ht
      rw [Set.uIcc_of_le hu] at ht
      exact hσ1 t ht.1
  have hmono : Monotone smax1 :=
    monotone_of_deriv_nonneg hdiff (fun u => by rw [hderiv]; exact (hσ01 u).1)
  have hDh : ∀ u, HasDerivAt (fun v => smax1 v - v) (σ u - 1) u :=
    fun u => (hD u).sub (hasDerivAt_id' u)
  have hanti : Antitone (fun v => smax1 v - v) :=
    antitone_of_deriv_nonpos (fun u => (hDh u).differentiableAt)
      (fun u => by rw [(hDh u).deriv]; linarith [(hσ01 u).2])
  have P6 : ∀ u, max u 0 ≤ smax1 u := by
    intro u
    apply max_le
    · have h := hanti (le_max_left u 1)
      simp only at h
      rw [P5 _ (le_max_right u 1)] at h
      linarith
    · have h := hmono (min_le_left u (-1))
      rw [P4 _ (min_le_right u (-1))] at h
      exact h
  have P7 : ∀ u, smax1 u ≤ max u 0 + 1 := by
    intro u
    have h := hmono (le_max_left u 1)
    rw [P5 _ (le_max_right u 1)] at h
    have h0 := le_max_left u 0
    have h1 := le_max_right u 0
    have h2 : max u 1 ≤ max u 0 + 1 := max_le (by linarith) (by linarith)
    linarith
  refine ⟨P1, fun u => by rw [hderiv, hσ], fun u => ?_, P4, P5, P6, P7⟩
  rw [hderiv]
  exact hσmono.deriv_nonneg

theorem smax1_lap_ge (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (f₁ f₂ : E3 → ℝ) (U : Set E3)
    (hU : IsOpen U) (y : E3) (hy : y ∈ U)
    (hG : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun x => G x i j) U)
    (hf₁ : ContDiffOn ℝ ∞ f₁ U) (hf₂ : ContDiffOn ℝ ∞ f₂ U)
    (hpsd : ∀ v : Fin 3 → ℝ, 0 ≤ ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * v i * v j)
    (ε : ℝ) (hε : 0 < ε) :
    ∃ s : ℝ, 0 ≤ s ∧ s ≤ 1 ∧ (1 - s) * lapLocal G f₁ y + s * lapLocal G f₂ y ≤
      lapLocal G (fun x => f₁ x + ε * smax1 ((f₂ x - f₁ x) / ε)) y :=
by
  
  obtain ⟨σ, hσ⟩ : ∃ σ : ℝ → ℝ, σ = fun t => Real.smoothTransition ((t + 1) / 2) := ⟨_, rfl⟩
  have hσd : ContDiff ℝ ∞ σ := by
    rw [hσ]
    exact Real.smoothTransition.contDiff.comp (by fun_prop)
  have hσc : Continuous σ := hσd.continuous
  have hσmono : Monotone σ := by
    intro a b hab
    rw [hσ]
    exact Real.smoothTransition.monotone (by linarith)
  have hσ'nn : ∀ u, 0 ≤ deriv σ u := fun u => hσmono.deriv_nonneg
  have hσ01 : ∀ u, 0 ≤ σ u ∧ σ u ≤ 1 := by
    intro u; rw [hσ]
    exact ⟨Real.smoothTransition.nonneg _, Real.smoothTransition.le_one _⟩
  have hsm : ∀ u, HasDerivAt smax1 (σ u) u := by
    intro u
    have h := intervalIntegral.integral_hasDerivAt_right (hσc.intervalIntegrable (-1) u)
      (hσc.stronglyMeasurableAtFilter _ _) hσc.continuousAt
    have e1 : smax1 = fun u => ∫ t in (-1 : ℝ)..u, σ t := by
      funext v; rw [hσ]; rfl
    rw [e1]; exact h
  
  have hD : ∀ z ∈ U, HasFDerivAt f₁ (fderiv ℝ f₁ z) z ∧ HasFDerivAt f₂ (fderiv ℝ f₂ z) z := by
    intro z hz
    exact ⟨((hf₁.contDiffAt (hU.mem_nhds hz)).differentiableAt (by simp)).hasFDerivAt,
      ((hf₂.contDiffAt (hU.mem_nhds hz)).differentiableAt (by simp)).hasFDerivAt⟩
  have hw : ∀ z ∈ U, HasFDerivAt (fun x => (f₂ x - f₁ x) / ε)
      (ε⁻¹ • (fderiv ℝ f₂ z - fderiv ℝ f₁ z)) z := by
    intro z hz
    have := ((hD z hz).2.sub (hD z hz).1).const_mul ε⁻¹
    convert this using 1
    funext x; rw [div_eq_inv_mul]; rfl
  
  have hfirst : ∀ z ∈ U, ∀ j : Fin 3,
      partialDeriv j (fun x => f₁ x + ε * smax1 ((f₂ x - f₁ x) / ε)) z =
        partialDeriv j f₁ z + σ ((f₂ z - f₁ z) / ε) * (partialDeriv j f₂ z - partialDeriv j f₁ z) := by
    intro z hz j
    have dc := (hsm ((f₂ z - f₁ z) / ε)).comp_hasFDerivAt z (hw z hz)
    have dh : HasFDerivAt (fun x => f₁ x + ε * smax1 ((f₂ x - f₁ x) / ε))
        (fderiv ℝ f₁ z + ε • (σ ((f₂ z - f₁ z) / ε) •
          (ε⁻¹ • (fderiv ℝ f₂ z - fderiv ℝ f₁ z)))) z :=
      (hD z hz).1.add (dc.const_mul ε)
    unfold partialDeriv
    rw [dh.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.sub_apply, smul_eq_mul]
    field_simp
  
  have hP : ∀ (f : E3 → ℝ), ContDiffOn ℝ ∞ f U → ∀ j : Fin 3,
      HasFDerivAt (fun z => partialDeriv j f z) (fderiv ℝ (fun z => partialDeriv j f z) y) y := by
    intro f hf j
    have h1 : ContDiffAt ℝ 1 (fderiv ℝ f) y :=
      (hf.contDiffAt (hU.mem_nhds hy)).fderiv_right (m := 1) (WithTop.coe_le_coe.mpr le_top)
    have h2 : DifferentiableAt ℝ (fderiv ℝ f) y := h1.differentiableAt one_ne_zero
    exact (h2.clm_apply (differentiableAt_const (e j))).hasFDerivAt
  have hsecond : ∀ i j : Fin 3,
      partialDeriv i (fun z => partialDeriv j
        (fun x => f₁ x + ε * smax1 ((f₂ x - f₁ x) / ε)) z) y =
        (1 - σ ((f₂ y - f₁ y) / ε)) * partialDeriv i (fun z => partialDeriv j f₁ z) y +
          σ ((f₂ y - f₁ y) / ε) * partialDeriv i (fun z => partialDeriv j f₂ z) y +
          deriv σ ((f₂ y - f₁ y) / ε) / ε *
            (partialDeriv i f₂ y - partialDeriv i f₁ y) * (partialDeriv j f₂ y - partialDeriv j f₁ y) := by
    intro i j
    have hev : (fun z => partialDeriv j (fun x => f₁ x + ε * smax1 ((f₂ x - f₁ x) / ε)) z)
        =ᶠ[𝓝 y] (fun z => partialDeriv j f₁ z + σ ((f₂ z - f₁ z) / ε) *
          (partialDeriv j f₂ z - partialDeriv j f₁ z)) :=
      Filter.eventuallyEq_of_mem (hU.mem_nhds hy) (fun z hz => hfirst z hz j)
    have dσ : HasDerivAt σ (deriv σ ((f₂ y - f₁ y) / ε)) ((f₂ y - f₁ y) / ε) :=
      ((hσd.differentiable (by simp)) _).hasDerivAt
    have dσw := dσ.comp_hasFDerivAt y (hw y hy)
    have dB : HasFDerivAt (fun z => partialDeriv j f₁ z + σ ((f₂ z - f₁ z) / ε) *
          (partialDeriv j f₂ z - partialDeriv j f₁ z))
        (fderiv ℝ (fun z => partialDeriv j f₁ z) y +
          (σ ((f₂ y - f₁ y) / ε) • (fderiv ℝ (fun z => partialDeriv j f₂ z) y -
              fderiv ℝ (fun z => partialDeriv j f₁ z) y) +
            (partialDeriv j f₂ y - partialDeriv j f₁ y) •
              (deriv σ ((f₂ y - f₁ y) / ε) • (ε⁻¹ • (fderiv ℝ f₂ y - fderiv ℝ f₁ y))))) y :=
      (hP f₁ hf₁ j).add (dσw.mul ((hP f₂ hf₂ j).sub (hP f₁ hf₁ j)))
    have : partialDeriv i (fun z => partialDeriv j
        (fun x => f₁ x + ε * smax1 ((f₂ x - f₁ x) / ε)) z) y =
        fderiv ℝ (fun z => partialDeriv j f₁ z + σ ((f₂ z - f₁ z) / ε) *
          (partialDeriv j f₂ z - partialDeriv j f₁ z)) y (e i) := by
      show fderiv ℝ _ y (e i) = _
      rw [hev.fderiv_eq]
    rw [this, dB.fderiv]
    simp only [ContinuousLinearMap.add_apply, ContinuousLinearMap.smul_apply,
      ContinuousLinearMap.sub_apply, smul_eq_mul]
    simp only [partialDeriv]
    field_simp
    ring
  
  have alg : ∀ (u : E3 → ℝ) (s c : ℝ),
      (∀ k : Fin 3, partialDeriv k u y = (1 - s) * partialDeriv k f₁ y + s * partialDeriv k f₂ y) →
      (∀ i j : Fin 3, partialDeriv i (fun z => partialDeriv j u z) y =
        (1 - s) * partialDeriv i (fun z => partialDeriv j f₁ z) y +
          s * partialDeriv i (fun z => partialDeriv j f₂ z) y +
          c * (partialDeriv i f₂ y - partialDeriv i f₁ y) * (partialDeriv j f₂ y - partialDeriv j f₁ y)) →
      lapLocal G u y = (1 - s) * lapLocal G f₁ y + s * lapLocal G f₂ y +
        c * ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j *
          (partialDeriv i f₂ y - partialDeriv i f₁ y) * (partialDeriv j f₂ y - partialDeriv j f₁ y) := by
    intro u s c h1 h2
    have e1 : ∀ i j : Fin 3, (G y)⁻¹ i j *
        (partialDeriv i (fun z => partialDeriv j u z) y -
          ∑ k : Fin 3, christoffel G k i j y * partialDeriv k u y) =
        (1 - s) * ((G y)⁻¹ i j * (partialDeriv i (fun z => partialDeriv j f₁ z) y -
          ∑ k : Fin 3, christoffel G k i j y * partialDeriv k f₁ y)) +
        s * ((G y)⁻¹ i j * (partialDeriv i (fun z => partialDeriv j f₂ z) y -
          ∑ k : Fin 3, christoffel G k i j y * partialDeriv k f₂ y)) +
        c * ((G y)⁻¹ i j * (partialDeriv i f₂ y - partialDeriv i f₁ y) *
          (partialDeriv j f₂ y - partialDeriv j f₁ y)) := by
      intro i j
      rw [h2 i j]
      simp only [h1, Fin.sum_univ_three]
      ring
    unfold lapLocal
    simp only [e1, Finset.sum_add_distrib, ← Finset.mul_sum]
  set s := σ ((f₂ y - f₁ y) / ε) with hs
  refine ⟨s, (hσ01 _).1, (hσ01 _).2, ?_⟩
  have key := alg (fun x => f₁ x + ε * smax1 ((f₂ x - f₁ x) / ε)) s
    (deriv σ ((f₂ y - f₁ y) / ε) / ε)
    (fun k => by rw [hfirst y hy k]; ring) hsecond
  rw [key]
  have hQ := hpsd (fun i => partialDeriv i f₂ y - partialDeriv i f₁ y)
  have hc : 0 ≤ deriv σ ((f₂ y - f₁ y) / ε) / ε := div_nonneg (hσ'nn _) hε.le
  nlinarith [mul_nonneg hc hQ]

theorem cs_good_propagate [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (hR : ∀ p : M, 0 ≤ g.scalarCurvature p) (p : M)
    (hp : ∀ U : Set M, IsOpen U → p ∈ U → ∃ q ∈ U, ∃ f : M → ℝ,
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧ (∀ x, 0 ≤ f x) ∧
      (∀ x, 0 ≤ 16 * lapM g f x + g.scalarCurvature x) ∧
      (∃ K : Set M, IsCompact K ∧ ∀ x, x ∉ K → f x = 0) ∧ 0 < f q) :
    ∃ F : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ F ∧ (∀ x, 0 ≤ F x) ∧
      (∀ x, 0 ≤ 16 * lapM g F x + g.scalarCurvature x) ∧
      (∃ K : Set M, IsCompact K ∧ ∀ x, x ∉ K → F x = 0) ∧ 0 < F p :=
by
  classical
  
  have hform : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (yt : E3) (α A C : ℝ) (y : E3),
      lapLocal G (fun z => A * Real.exp (-α * ‖z - yt‖ ^ 2) + C) y =
        A * Real.exp (-α * ‖y - yt‖ ^ 2) *
          (4 * α ^ 2 * (∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * (y - yt) i * (y - yt) j)
            - 2 * α * (∑ i : Fin 3, (G y)⁻¹ i i)
            + 2 * α * (∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j *
                ∑ k : Fin 3, christoffel G k i j y * (y - yt) k)) := by
    intro G yt α A C y
    have h1 : ∀ z : E3, HasFDerivAt (fun z : E3 => z - yt) (ContinuousLinearMap.id ℝ E3) z :=
      fun z => (hasFDerivAt_id z).sub_const yt
    have hco : ∀ (k : Fin 3) (z : E3),
        HasFDerivAt (fun z : E3 => (z - yt) k) (EuclideanSpace.proj k : E3 →L[ℝ] ℝ) z := by
      intro k z
      have e : (fun z : E3 => (z - yt) k) =
          fun z => (EuclideanSpace.proj k : E3 →L[ℝ] ℝ) z - yt k := by
        funext z; simp
      rw [e]; exact (EuclideanSpace.proj k : E3 →L[ℝ] ℝ).hasFDerivAt.sub_const _
    have hd1 : ∀ (k : Fin 3) (z : E3),
        partialDeriv k (fun z => A * Real.exp (-α * ‖z - yt‖ ^ 2) + C) z =
          -2 * α * A * Real.exp (-α * ‖z - yt‖ ^ 2) * (z - yt) k := by
      intro k z
      have h2 := (((h1 z).norm_sq.const_mul (-α)).exp.const_mul A).add_const C
      unfold partialDeriv
      rw [h2.fderiv]
      simp [EuclideanSpace.inner_single_right]
      ring
    have hd2 : ∀ i k : Fin 3,
        partialDeriv i (fun z => partialDeriv k
          (fun z => A * Real.exp (-α * ‖z - yt‖ ^ 2) + C) z) y =
          A * Real.exp (-α * ‖y - yt‖ ^ 2) * (4 * α ^ 2 * ((y - yt) i * (y - yt) k) -
            2 * α * (if k = i then (1:ℝ) else 0)) := by
      intro i k
      have e1 : (fun z => partialDeriv k (fun z => A * Real.exp (-α * ‖z - yt‖ ^ 2) + C) z) =
          (fun z : E3 => -2 * α * A * Real.exp (-α * ‖z - yt‖ ^ 2)) *
            (fun z : E3 => (z - yt) k) := by
        funext z; rw [hd1 k z]; rfl
      have h2 := ((h1 y).norm_sq.const_mul (-α)).exp.const_mul (-2 * α * A)
      have h4 := h2.mul (hco k y)
      rw [e1]
      unfold partialDeriv
      rw [h4.fderiv]
      simp [EuclideanSpace.inner_single_right, EuclideanSpace.single_apply]
      split_ifs <;> ring
    unfold lapLocal
    simp only [hd2]
    simp only [hd1, Fin.sum_univ_three]
    try simp only [Fin.isValue, Fin.reduceEq, ↓reduceIte]
    ring
  
  have H1 : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (u v : E3 → ℝ) (y : E3),
      u =ᶠ[𝓝 y] v → lapLocal G u y = lapLocal G v y := by
    intro G u v y huv
    have h1 : ∀ l : Fin 3, partialDeriv l u y = partialDeriv l v y := by
      intro l
      show fderiv ℝ u y (e l) = fderiv ℝ v y (e l)
      rw [huv.fderiv_eq]
    have h2 : ∀ i l : Fin 3, partialDeriv i (fun z => partialDeriv l u z) y =
        partialDeriv i (fun z => partialDeriv l v z) y := by
      intro i l
      have hev : (fun z => partialDeriv l u z) =ᶠ[𝓝 y] (fun z => partialDeriv l v z) := by
        filter_upwards [huv.eventuallyEq_nhds] with z hz
        show fderiv ℝ u z (e l) = fderiv ℝ v z (e l)
        rw [hz.fderiv_eq]
      show fderiv ℝ (fun z => partialDeriv l u z) y (e i) =
        fderiv ℝ (fun z => partialDeriv l v z) y (e i)
      rw [hev.fderiv_eq]
    simp only [lapLocal, h1, h2]
  have lapM_congr : ∀ (u v : M → ℝ) (x : M), u =ᶠ[𝓝 x] v → lapM g u x = lapM g v x := by
    intro u v x huv
    have hc : Tendsto (chartAt E3 x).symm (𝓝 (chartAt E3 x x)) (𝓝 x) := by
      have := ((chartAt E3 x).continuousAt_symm (mem_chart_target E3 x)).tendsto
      rwa [(chartAt E3 x).left_inv (mem_chart_source E3 x)] at this
    exact H1 _ _ _ _ (huv.comp_tendsto hc)
  have hpsd_of : ∀ A : Matrix (Fin 3) (Fin 3) ℝ, A.PosDef →
      ∀ v : Fin 3 → ℝ, 0 ≤ ∑ i : Fin 3, ∑ l : Fin 3, A i l * v i * v l := by
    intro A hA v
    have := hA.posSemidef.dotProduct_mulVec_nonneg v
    simp only [dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, Fin.sum_univ_three]
      at this ⊢
    nlinarith [this]
  obtain ⟨hsm_cd, -, -, hsm0, -, hsmlo, -⟩ := smax1_props
  
  have hbar : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (U : Set E3), IsOpen U →
      (∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) U) → (∀ y ∈ U, (G y).PosDef) →
      ∀ (yt : E3) (μ s R₂ : ℝ), 0 < μ → 0 < s → Metric.closedBall yt R₂ ⊆ U →
      ∃ α : ℝ, 0 < α ∧ ∀ (C : ℝ) (y : E3), s ≤ ‖y - yt‖ → ‖y - yt‖ ≤ R₂ →
        0 ≤ lapLocal G (fun z => μ / 2 * Real.exp (-α * ‖z - yt‖ ^ 2) + C) y := by
    intro G U hU hG hPD yt μ s R₂ hμ hs hKU
    by_cases hsR : R₂ < s
    · exact ⟨1, one_pos, fun C y h1 h2 => absurd (lt_of_le_of_lt (h1.trans h2) hsR) (lt_irrefl _)⟩
    push_neg at hsR
    have hK : IsCompact (Metric.closedBall yt R₂) := isCompact_closedBall yt R₂
    have hGc : ContinuousOn G U :=
      continuousOn_pi.2 (fun i => continuousOn_pi.2 (fun j => (hG i j).continuousOn))
    have hdet : ContinuousOn (fun y => (G y).det) U :=
      (continuous_id.matrix_det).comp_continuousOn hGc
    have hadj : ∀ i j : Fin 3, ContinuousOn (fun y => (G y).adjugate i j) U := by
      intro i j
      exact ((continuous_apply j).comp ((continuous_apply i).comp
        (continuous_id.matrix_adjugate))).comp_continuousOn hGc
    have hN : ∀ i j : Fin 3, ContinuousOn (fun y => (G y)⁻¹ i j) U := by
      intro i j
      have e : (fun y => (G y)⁻¹ i j) = fun y => ((G y).det)⁻¹ * (G y).adjugate i j := by
        funext y; rw [Matrix.inv_def, Ring.inverse_eq_inv']; rfl
      rw [e]
      exact (hdet.inv₀ (fun y hy => (hPD y hy).det_pos.ne')).mul (hadj i j)
    have hPd : ∀ i j l : Fin 3,
        ContinuousOn (fun y => partialDeriv l (fun z => G z i j) y) U :=
      fun i j l => ((hG i j).continuousOn_fderiv_of_isOpen hU (by simp)).clm_apply
        continuousOn_const
    have hΓ : ∀ k i j : Fin 3, ContinuousOn (fun y => christoffel G k i j y) U := by
      intro k i j
      unfold christoffel
      exact continuousOn_const.mul (continuousOn_finset_sum _ (fun l _ =>
        (hN k l).mul (((hPd j l i).add (hPd i l j)).sub (hPd i j l))))
    have htr : ContinuousOn (fun y => ∑ i : Fin 3, (G y)⁻¹ i i) U :=
      continuousOn_finset_sum _ (fun i _ => hN i i)
    have hbb : ContinuousOn (fun y => ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3,
        |(G y)⁻¹ i j * christoffel G k i j y|) U :=
      continuousOn_finset_sum _ (fun i _ => continuousOn_finset_sum _ (fun j _ =>
        continuousOn_finset_sum _ (fun k _ => ((hN i j).mul (hΓ k i j)).abs)))
    obtain ⟨T, hT⟩ := hK.exists_bound_of_continuousOn (htr.mono hKU)
    obtain ⟨B, hB⟩ := hK.exists_bound_of_continuousOn (hbb.mono hKU)
    
    have hS1 : IsCompact (Metric.sphere (0 : E3) 1) := isCompact_sphere 0 1
    have hQc : ContinuousOn (fun yv : E3 × E3 => ∑ i : Fin 3, ∑ j : Fin 3,
        (G yv.1)⁻¹ i j * yv.2 i * yv.2 j)
        (Metric.closedBall yt R₂ ×ˢ Metric.sphere (0 : E3) 1) := by
      apply continuousOn_finset_sum _ (fun i _ => continuousOn_finset_sum _ (fun j _ => ?_))
      have h1 : ContinuousOn (fun yv : E3 × E3 => (G yv.1)⁻¹ i j)
          (Metric.closedBall yt R₂ ×ˢ Metric.sphere (0 : E3) 1) :=
        (hN i j).comp continuous_fst.continuousOn (fun yv hyv => hKU hyv.1)
      have h2 : Continuous (fun yv : E3 × E3 => yv.2 i) := by fun_prop
      have h3 : Continuous (fun yv : E3 × E3 => yv.2 j) := by fun_prop
      exact (h1.mul h2.continuousOn).mul h3.continuousOn
    have hne : (Metric.closedBall yt R₂ ×ˢ Metric.sphere (0 : E3) 1).Nonempty :=
      ⟨(yt, e 0), Metric.mem_closedBall_self (hs.le.trans hsR), by simp⟩
    obtain ⟨⟨y0, v0⟩, hyv0, hmin⟩ := (hK.prod hS1).exists_isMinOn hne hQc
    obtain ⟨lam, hlam⟩ : ∃ lam : ℝ, lam = ∑ i : Fin 3, ∑ j : Fin 3, (G y0)⁻¹ i j * v0 i * v0 j :=
      ⟨_, rfl⟩
    have hlam0 : 0 < lam := by
      have hPDi := (hPD y0 (hKU hyv0.1)).inv
      have hv0 : (fun i => v0 i) ≠ 0 := by
        intro h
        have h' : v0 = 0 := by ext i; simpa using congrFun h i
        have := hyv0.2
        rw [h', Metric.mem_sphere, dist_self] at this
        norm_num at this
      have := hPDi.dotProduct_mulVec_pos hv0
      simp only [dotProduct, Matrix.mulVec, Pi.star_apply, star_trivial, Fin.sum_univ_three]
        at this
      rw [hlam]; simp only [Fin.sum_univ_three]
      nlinarith [this]
    have hcoer : ∀ y ∈ Metric.closedBall yt R₂, ∀ v : E3,
        lam * ‖v‖ ^ 2 ≤ ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * v i * v j := by
      intro y hy v
      by_cases hv : v = 0
      · subst hv; simp
      have hn : 0 < ‖v‖ := norm_pos_iff.2 hv
      have hu : ‖v‖⁻¹ • v ∈ Metric.sphere (0 : E3) 1 := by
        rw [mem_sphere_zero_iff_norm, norm_smul, norm_inv, norm_norm, inv_mul_cancel₀ hn.ne']
      have hm : lam ≤ ∑ i : Fin 3, ∑ j : Fin 3,
          (G y)⁻¹ i j * (‖v‖⁻¹ * v i) * (‖v‖⁻¹ * v j) := by
        have := isMinOn_iff.1 hmin (y, ‖v‖⁻¹ • v) ⟨hy, hu⟩
        rw [hlam]
        simpa using this
      have e : ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * (‖v‖⁻¹ * v i) * (‖v‖⁻¹ * v j) =
          (‖v‖⁻¹) ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * v i * v j := by
        simp only [Fin.sum_univ_three]; ring
      rw [e] at hm
      have h2 : ‖v‖ ^ 2 * (‖v‖⁻¹) ^ 2 = 1 := by field_simp
      calc lam * ‖v‖ ^ 2
          ≤ ((‖v‖⁻¹) ^ 2 * ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * v i * v j) * ‖v‖ ^ 2 :=
            mul_le_mul_of_nonneg_right hm (by positivity)
        _ = _ := by rw [mul_comm, ← mul_assoc, h2, one_mul]
    obtain ⟨α, hα⟩ : ∃ α : ℝ, α = (|T| + |B| * R₂) / (2 * lam * s ^ 2) + 1 := ⟨_, rfl⟩
    have hden : 0 < 2 * lam * s ^ 2 := by positivity
    have hα0 : 0 < α := by
      rw [hα]
      have : 0 ≤ (|T| + |B| * R₂) / (2 * lam * s ^ 2) := by
        apply div_nonneg _ hden.le
        have : 0 ≤ R₂ := hs.le.trans hsR
        positivity
      linarith
    have hαeq : 2 * α * lam * s ^ 2 = |T| + |B| * R₂ + 2 * lam * s ^ 2 := by
      rw [hα]; field_simp
    refine ⟨α, hα0, fun C y h1 h2 => ?_⟩
    have hy : y ∈ Metric.closedBall yt R₂ := by
      rw [Metric.mem_closedBall, dist_eq_norm]; exact h2
    rw [hform]
    have hQ := hcoer y hy (y - yt)
    have hζs : s ^ 2 ≤ ‖y - yt‖ ^ 2 := by
      have := mul_le_mul h1 h1 hs.le (norm_nonneg _); nlinarith
    have hQ' : lam * s ^ 2 ≤ ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * (y - yt) i * (y - yt) j :=
      le_trans (mul_le_mul_of_nonneg_left hζs hlam0.le) hQ
    have htrb : ∑ i : Fin 3, (G y)⁻¹ i i ≤ |T| := by
      have := hT y hy
      rw [Real.norm_eq_abs] at this
      exact (le_abs_self _).trans (this.trans (le_abs_self _))
    have hXb : -(|B| * R₂) ≤ ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j *
        ∑ k : Fin 3, christoffel G k i j y * (y - yt) k := by
      have hterm : ∀ i j k : Fin 3, -(|(G y)⁻¹ i j * christoffel G k i j y| * ‖y - yt‖) ≤
          (G y)⁻¹ i j * christoffel G k i j y * (y - yt) k := by
        intro i j k
        have hk : |(y - yt) k| ≤ ‖y - yt‖ := by
          have := PiLp.norm_apply_le (y - yt) k
          rwa [Real.norm_eq_abs] at this
        have h3 : |(G y)⁻¹ i j * christoffel G k i j y * (y - yt) k| ≤
            |(G y)⁻¹ i j * christoffel G k i j y| * ‖y - yt‖ := by
          rw [abs_mul]; exact mul_le_mul_of_nonneg_left hk (abs_nonneg _)
        linarith [neg_abs_le ((G y)⁻¹ i j * christoffel G k i j y * (y - yt) k)]
      have e : ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j *
          ∑ k : Fin 3, christoffel G k i j y * (y - yt) k =
          ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3,
            (G y)⁻¹ i j * christoffel G k i j y * (y - yt) k := by
        simp only [Finset.mul_sum, mul_assoc]
      have hsum := Finset.sum_le_sum fun i (_ : i ∈ Finset.univ) =>
        Finset.sum_le_sum fun j (_ : j ∈ Finset.univ) =>
          Finset.sum_le_sum fun k (_ : k ∈ Finset.univ) => hterm i j k
      have e2 : ∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3,
          -(|(G y)⁻¹ i j * christoffel G k i j y| * ‖y - yt‖) =
          -((∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3,
            |(G y)⁻¹ i j * christoffel G k i j y|) * ‖y - yt‖) := by
        simp only [Finset.sum_neg_distrib, Finset.sum_mul]
      have hBy := hB y hy
      rw [Real.norm_eq_abs] at hBy
      have hB' : (∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3,
          |(G y)⁻¹ i j * christoffel G k i j y|) ≤ |B| :=
        (le_abs_self _).trans (hBy.trans (le_abs_self _))
      have h4 : (∑ i : Fin 3, ∑ j : Fin 3, ∑ k : Fin 3,
          |(G y)⁻¹ i j * christoffel G k i j y|) * ‖y - yt‖ ≤ |B| * R₂ :=
        mul_le_mul hB' h2 (norm_nonneg _) (abs_nonneg _)
      rw [e]; rw [e2] at hsum; linarith
    have hE : 0 < Real.exp (-α * ‖y - yt‖ ^ 2) := Real.exp_pos _
    have hbr : 0 ≤ 4 * α ^ 2 * (∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j * (y - yt) i * (y - yt) j)
        - 2 * α * (∑ i : Fin 3, (G y)⁻¹ i i)
        + 2 * α * (∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j *
            ∑ k : Fin 3, christoffel G k i j y * (y - yt) k) := by
      have k1 := mul_le_mul_of_nonneg_left hQ' (by positivity : (0:ℝ) ≤ 4 * α ^ 2)
      have k2 := mul_le_mul_of_nonneg_left htrb (by positivity : (0:ℝ) ≤ 2 * α)
      have k3 := mul_le_mul_of_nonneg_left hXb (by positivity : (0:ℝ) ≤ 2 * α)
      have k4 : 4 * α ^ 2 * (lam * s ^ 2) = 2 * α * (|T| + |B| * R₂ + 2 * lam * s ^ 2) := by
        rw [← hαeq]; ring
      have k5 : 0 ≤ 2 * α * (2 * lam * s ^ 2) := by positivity
      nlinarith [k1, k2, k3, k4, k5]
    exact mul_nonneg (mul_nonneg (by linarith : (0:ℝ) ≤ μ / 2) hE.le) hbr
  
  set c := chartAt E3 p with hc
  have hyp : c p ∈ c.target := mem_chart_target E3 p
  have hps : p ∈ c.source := mem_chart_source E3 p
  obtain ⟨ε₀, hε₀, hball⟩ := Metric.isOpen_iff.1 c.open_target (c p) hyp
  obtain ⟨S, hS⟩ : ∃ S : ℝ, S = ε₀ / 5 := ⟨_, rfl⟩
  have hS0 : 0 < S := by rw [hS]; positivity
  obtain ⟨q, hqU, f, hfs, hf0, hfl, ⟨Kf, hKf, hfK⟩, hfq⟩ :=
    hp (c.source ∩ c ⁻¹' Metric.ball (c p) S) (c.isOpen_inter_preimage Metric.isOpen_ball)
      ⟨hps, Metric.mem_ball_self hS0⟩
  have hqs : q ∈ c.source := hqU.1
  have hqb : dist (c q) (c p) < S := hqU.2
  obtain ⟨yt, hyt⟩ : ∃ yt : E3, yt = c q := ⟨_, rfl⟩
  have hyt_t : yt ∈ c.target := by rw [hyt]; exact c.map_source hqs
  have hsymq : c.symm yt = q := by rw [hyt]; exact c.left_inv hqs
  have hytp : dist (c p) yt < S := by rw [dist_comm, hyt]; exact hqb
  obtain ⟨μ, hμ⟩ : ∃ μ : ℝ, μ = f q / 2 := ⟨_, rfl⟩
  have hμ0 : 0 < μ := by rw [hμ]; linarith
  have hcont : ContinuousAt (fun y => f (c.symm y)) yt :=
    hfs.continuous.continuousAt.comp (c.continuousAt_symm hyt_t)
  obtain ⟨δ, hδ0, hδ⟩ := Metric.continuousAt_iff.1 hcont μ hμ0
  have hfnear : ∀ y, dist y yt < δ → μ < f (c.symm y) := by
    intro y hy
    have h := hδ hy
    simp only [hsymq, Real.dist_eq] at h
    have := (abs_lt.1 h).1
    linarith
  obtain ⟨s, hs⟩ : ∃ s : ℝ, s = min (δ / 2) (S / 2) := ⟨_, rfl⟩
  have hs0 : 0 < s := by rw [hs]; exact lt_min (by linarith) (by linarith)
  have hsδ : s < δ := by rw [hs]; exact lt_of_le_of_lt (min_le_left _ _) (by linarith)
  have hsS : s < S := by rw [hs]; exact lt_of_le_of_lt (min_le_right _ _) (by linarith)
  have hKsub : Metric.closedBall yt (3 * S) ⊆ c.target := by
    intro z hz
    apply hball
    rw [Metric.mem_closedBall] at hz
    rw [Metric.mem_ball]
    have := dist_triangle z yt (c p)
    rw [dist_comm yt (c p)] at this
    linarith
  
  obtain ⟨α, hα0, hαlap⟩ := hbar (g.coeff c.symm) c.target c.open_target (g.smooth p)
    (coeff_chart_symm_posDef g p) yt μ s (3 * S) hμ0 hs0 hKsub
  obtain ⟨C₀, hC₀⟩ : ∃ C₀ : ℝ, C₀ = -(μ / 2 * Real.exp (-α * (2 * S) ^ 2)) := ⟨_, rfl⟩
  obtain ⟨w, hw⟩ : ∃ w : E3 → ℝ, w = fun z => μ / 2 * Real.exp (-α * ‖z - yt‖ ^ 2) + C₀ :=
    ⟨_, rfl⟩
  have hwz : ∀ z, w z = μ / 2 * Real.exp (-α * ‖z - yt‖ ^ 2) + C₀ := fun z => by rw [hw]
  have hn2 : ContDiff ℝ ∞ (fun z : E3 => ‖z - yt‖ ^ 2) :=
    (contDiff_norm_sq ℝ).comp (contDiff_id.sub contDiff_const)
  have hwcd : ContDiff ℝ ∞ w := by
    rw [hw]
    exact (contDiff_const.mul (Real.contDiff_exp.comp (contDiff_const.mul hn2))).add
      contDiff_const
  have hw1 : ∀ z, w z < μ / 2 := by
    intro z; rw [hwz]
    have h1 : Real.exp (-α * ‖z - yt‖ ^ 2) ≤ 1 :=
      Real.exp_le_one_iff.2 (by nlinarith [mul_nonneg hα0.le (sq_nonneg ‖z - yt‖)])
    have h2 : 0 < Real.exp (-α * (2 * S) ^ 2) := Real.exp_pos _
    rw [hC₀]; nlinarith
  have hw2 : 0 < w (c p) := by
    rw [hwz, hC₀]
    have h1 : ‖c p - yt‖ < 2 * S := by rw [← dist_eq_norm]; linarith
    have h2 : ‖c p - yt‖ ^ 2 < (2 * S) ^ 2 := by
      have := norm_nonneg (c p - yt)
      nlinarith [mul_pos (sub_pos.2 h1) (by linarith : (0:ℝ) < 2 * S + ‖c p - yt‖)]
    have h3 : Real.exp (-α * (2 * S) ^ 2) < Real.exp (-α * ‖c p - yt‖ ^ 2) :=
      Real.exp_lt_exp.2 (by nlinarith [mul_pos hα0 (sub_pos.2 h2)])
    nlinarith
  obtain ⟨ε₁, hε₁⟩ : ∃ ε₁ : ℝ,
      ε₁ = μ / 2 * (Real.exp (-α * (2 * S) ^ 2) - Real.exp (-α * (5 * S / 2) ^ 2)) := ⟨_, rfl⟩
  have hε₁0 : 0 < ε₁ := by
    rw [hε₁]
    have h : Real.exp (-α * (5 * S / 2) ^ 2) < Real.exp (-α * (2 * S) ^ 2) :=
      Real.exp_lt_exp.2 (by nlinarith [mul_pos hα0 (mul_pos hS0 hS0)])
    exact mul_pos (by linarith) (sub_pos.2 h)
  have hw3 : ∀ z, 5 * S / 2 ≤ ‖z - yt‖ → w z ≤ -ε₁ := by
    intro z hz
    rw [hwz, hC₀, hε₁]
    have h2 : (5 * S / 2) ^ 2 ≤ ‖z - yt‖ ^ 2 := by
      have := mul_le_mul hz hz (by positivity) (norm_nonneg _); nlinarith
    have h3 : Real.exp (-α * ‖z - yt‖ ^ 2) ≤ Real.exp (-α * (5 * S / 2) ^ 2) :=
      Real.exp_le_exp.2 (by nlinarith [mul_le_mul_of_nonneg_left h2 hα0.le])
    have : 0 < μ / 2 := by linarith
    nlinarith [mul_le_mul_of_nonneg_left h3 this.le]
  have hw4 : ∀ y, s ≤ ‖y - yt‖ → ‖y - yt‖ ≤ 3 * S → 0 ≤ lapLocal (g.coeff c.symm) w y := by
    intro y h1 h2; rw [hw]; exact hαlap C₀ y h1 h2
  obtain ⟨ε, hε⟩ : ∃ ε : ℝ, ε = min (μ / 2) ε₁ := ⟨_, rfl⟩
  have hε0 : 0 < ε := by rw [hε]; exact lt_min (by linarith) hε₁0
  have hεμ : ε ≤ μ / 2 := by rw [hε]; exact min_le_left _ _
  have hεε : ε ≤ ε₁ := by rw [hε]; exact min_le_right _ _
  
  obtain ⟨V, hV⟩ : ∃ V : Set M, V = c.source ∩ c ⁻¹' Metric.ball yt (3 * S) := ⟨_, rfl⟩
  have hVo : IsOpen V := by rw [hV]; exact c.isOpen_inter_preimage Metric.isOpen_ball
  have hVsrc : V ⊆ c.source := by rw [hV]; exact Set.inter_subset_left
  obtain ⟨Vs, hVs⟩ : ∃ Vs : Set M, Vs = c.source ∩ c ⁻¹' Metric.ball yt s := ⟨_, rfl⟩
  have hVso : IsOpen Vs := by rw [hVs]; exact c.isOpen_inter_preimage Metric.isOpen_ball
  obtain ⟨K', hK'⟩ : ∃ K' : Set M, K' = c.symm '' Metric.closedBall yt (5 * S / 2) := ⟨_, rfl⟩
  have hcb : Metric.closedBall yt (5 * S / 2) ⊆ c.target :=
    (Metric.closedBall_subset_closedBall (by linarith)).trans hKsub
  have hK'c : IsCompact K' := by
    rw [hK']
    exact (isCompact_closedBall yt _).image_of_continuousOn (c.continuousOn_symm.mono hcb)
  have hK'cl : IsClosed K' := hK'c.isClosed
  have hK'mem : ∀ x ∈ K', x ∈ c.source ∧ ‖c x - yt‖ ≤ 5 * S / 2 := by
    intro x hx; rw [hK'] at hx
    obtain ⟨y, hy, rfl⟩ := hx
    have hyt' := hcb hy
    refine ⟨c.map_target hyt', ?_⟩
    rw [c.right_inv hyt', ← dist_eq_norm]; exact hy
  have hK'V : K' ⊆ V := by
    intro x hx
    obtain ⟨h1, h2⟩ := hK'mem x hx
    rw [hV]; refine ⟨h1, ?_⟩
    show c x ∈ Metric.ball yt (3 * S)
    rw [Metric.mem_ball, dist_eq_norm]; linarith
  have hnotK' : ∀ x ∈ V, x ∉ K' → 5 * S / 2 < ‖c x - yt‖ := by
    intro x hxV hxK
    by_contra hcon; push_neg at hcon
    apply hxK; rw [hK']
    refine ⟨c x, ?_, c.left_inv (hVsrc hxV)⟩
    rw [Metric.mem_closedBall, dist_eq_norm]; exact hcon
  obtain ⟨F, hF⟩ : ∃ F : M → ℝ,
      F = fun x => f x + V.indicator (fun x => ε * smax1 ((w (c x) - f x) / ε)) x := ⟨_, rfl⟩
  have hFV : ∀ x ∈ V, F x = f x + ε * smax1 ((w (c x) - f x) / ε) := by
    intro x hx; rw [hF]; simp only [Set.indicator_of_mem hx]
  have hFnV : ∀ x, x ∉ V → F x = f x := by
    intro x hx; rw [hF]; simp only [Set.indicator_of_notMem hx, add_zero]
  have hzero : ∀ x, w (c x) - f x ≤ -ε → ε * smax1 ((w (c x) - f x) / ε) = 0 := by
    intro x h
    rw [hsm0 _ (by rw [div_le_iff₀ hε0]; linarith), mul_zero]
  have hF1 : ∀ x, x ∉ K' → F x = f x := by
    intro x hx
    by_cases hxV : x ∈ V
    · rw [hFV x hxV, hzero x ?_, add_zero]
      have := hw3 (c x) (hnotK' x hxV hx).le
      have := hf0 x
      linarith
    · exact hFnV x hxV
  have hF2 : ∀ x ∈ Vs, F x = f x := by
    intro x hx
    rw [hVs] at hx
    obtain ⟨hxs, hxb⟩ := hx
    have hxb' : dist (c x) yt < s := hxb
    have hxV : x ∈ V := by
      rw [hV]; refine ⟨hxs, ?_⟩
      show dist (c x) yt < 3 * S; linarith
    rw [hFV x hxV, hzero x ?_, add_zero]
    have h1 := hfnear (c x) (by linarith)
    rw [c.left_inv hxs] at h1
    have := hw1 (c x)
    linarith
  have hwc : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (w ∘ c) V :=
    hwcd.contMDiff.comp_contMDiffOn (contMDiffOn_chart.mono hVsrc)
  have hGlue : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞
      (fun x => f x + ε * smax1 ((w (c x) - f x) / ε)) V :=
    hfs.contMDiffOn.add (contMDiffOn_const.mul
      (hsm_cd.contMDiff.comp_contMDiffOn ((hwc.sub hfs.contMDiffOn).div_const ε)))
  have hFs : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ F := by
    apply contMDiff_of_locally_contMDiffOn
    intro x
    by_cases hx : x ∈ K'
    · exact ⟨V, hVo, hK'V hx, hGlue.congr (fun y hy => hFV y hy)⟩
    · exact ⟨K'ᶜ, hK'cl.isOpen_compl, hx, hfs.contMDiffOn.congr (fun y hy => hF1 y hy)⟩
  have hF0 : ∀ x, 0 ≤ F x := by
    intro x
    by_cases hxV : x ∈ V
    · rw [hFV x hxV]
      have h1 := hsmlo ((w (c x) - f x) / ε)
      have h2 : 0 ≤ max ((w (c x) - f x) / ε) 0 := le_max_right _ _
      have := mul_nonneg hε0.le (h2.trans h1)
      linarith [hf0 x]
    · rw [hFnV x hxV]; exact hf0 x
  have hFK : ∀ x, x ∉ Kf ∪ K' → F x = 0 := by
    intro x hx
    rw [Set.mem_union, not_or] at hx
    rw [hF1 x hx.2, hfK x hx.1]
  have hpV : p ∈ V := by
    rw [hV]; refine ⟨hps, ?_⟩
    show dist (c p) yt < 3 * S; linarith
  have hFp : 0 < F p := by
    rw [hFV p hpV]
    have h1 := hsmlo ((w (c p) - f p) / ε)
    have h2 : (w (c p) - f p) / ε ≤ max ((w (c p) - f p) / ε) 0 := le_max_left _ _
    have h3 : ε * ((w (c p) - f p) / ε) ≤ ε * smax1 ((w (c p) - f p) / ε) :=
      mul_le_mul_of_nonneg_left (h2.trans h1) hε0.le
    have h4 : ε * ((w (c p) - f p) / ε) = w (c p) - f p := by field_simp
    linarith
  
  obtain ⟨Φc, hΦc, hΦs⟩ : ∃ Φc : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞,
      (Φc : E3 → M) = c.symm ∧ Φc.source = c.target :=
    ⟨⟨c.symm.toPartialEquiv, c.symm.open_source, c.symm.open_target, contMDiffOn_chart_symm,
      contMDiffOn_chart⟩, rfl, rfl⟩
  have hLw : ∀ x ∈ V, lapM g (fun x => w (c x)) x = lapLocal (g.coeff c.symm) w (c x) := by
    intro x hxV
    have hxs := hVsrc hxV
    have hct : c x ∈ c.target := c.map_source hxs
    have hu : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun x => w (c x)) c.source :=
      hwcd.contMDiff.comp_contMDiffOn contMDiffOn_chart
    have h := lapLocal_chart_invariant g Φc (fun x => w (c x)) c.source c.open_source hu (c x)
      (by rw [hΦs]; exact hct) (by rw [hΦc, c.left_inv hxs]; exact hxs)
    rw [hΦc, c.left_inv hxs] at h
    rw [← h]
    apply H1
    filter_upwards [c.open_target.mem_nhds hct] with z hz
    simp only [Function.comp_apply, c.right_inv hz]
  
  have hsup : ∀ x, 0 ≤ 16 * lapM g F x + g.scalarCurvature x := by
    intro x
    by_cases hxK : x ∈ K'
    swap
    · have hev : F =ᶠ[𝓝 x] f :=
        Filter.eventuallyEq_of_mem (hK'cl.isOpen_compl.mem_nhds hxK) (fun y hy => hF1 y hy)
      rw [lapM_congr _ _ x hev]; exact hfl x
    by_cases hxs : x ∈ Vs
    · have hev : F =ᶠ[𝓝 x] f :=
        Filter.eventuallyEq_of_mem (hVso.mem_nhds hxs) (fun y hy => hF2 y hy)
      rw [lapM_congr _ _ x hev]; exact hfl x
    have hxV := hK'V hxK
    obtain ⟨hxsrc, hx52⟩ := hK'mem x hxK
    have hxs' : s ≤ ‖c x - yt‖ := by
      by_contra hcon; push_neg at hcon
      apply hxs; rw [hVs]; refine ⟨hxsrc, ?_⟩
      show dist (c x) yt < s; rw [dist_eq_norm]; exact hcon
    have hwx : 0 ≤ lapM g (fun x => w (c x)) x := by
      rw [hLw x hxV]; exact hw4 (c x) hxs' (by linarith)
    have hy : chartAt E3 x x ∈ (chartAt E3 x).target := mem_chart_target E3 x
    obtain ⟨U, hU⟩ : ∃ U : Set E3, U = (chartAt E3 x).target ∩ (chartAt E3 x).symm ⁻¹' V :=
      ⟨_, rfl⟩
    have hUopen : IsOpen U := by rw [hU]; exact (chartAt E3 x).isOpen_inter_preimage_symm hVo
    have hUsub : U ⊆ (chartAt E3 x).target := by rw [hU]; exact Set.inter_subset_left
    have hyU : chartAt E3 x x ∈ U := by
      rw [hU]; refine ⟨hy, ?_⟩
      show (chartAt E3 x).symm (chartAt E3 x x) ∈ V
      rw [(chartAt E3 x).left_inv (mem_chart_source E3 x)]; exact hxV
    have hu₁ : ContDiffOn ℝ ∞ (fun z => f ((chartAt E3 x).symm z)) U := by
      have h0 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (fun z => f ((chartAt E3 x).symm z))
          (chartAt E3 x).target := hfs.comp_contMDiffOn contMDiffOn_chart_symm
      exact (contMDiffOn_iff_contDiffOn.mp h0).mono hUsub
    have hu₂ : ContDiffOn ℝ ∞ (fun z => w (c ((chartAt E3 x).symm z))) U := by
      have h0 : ContMDiffOn 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ ((w ∘ c) ∘ (chartAt E3 x).symm) U :=
        hwc.comp (contMDiffOn_chart_symm.mono hUsub) (by rw [hU]; exact fun z hz => hz.2)
      exact contMDiffOn_iff_contDiffOn.mp h0
    have hGcd : ∀ i l : Fin 3, ContDiffOn ℝ ∞ (fun z => g.coeff (chartAt E3 x).symm z i l) U :=
      fun i l => (g.smooth x i l).mono hUsub
    have hpsd := hpsd_of _ (coeff_chart_symm_posDef g x _ hy).inv
    obtain ⟨s', hs0', hs1', hineq⟩ := smax1_lap_ge (g.coeff (chartAt E3 x).symm)
      (fun z => f ((chartAt E3 x).symm z)) (fun z => w (c ((chartAt E3 x).symm z))) U hUopen
      (chartAt E3 x x) hyU hGcd hu₁ hu₂ hpsd ε hε0
    have hFeq : (F ∘ (chartAt E3 x).symm) =ᶠ[𝓝 (chartAt E3 x x)]
        (fun z => f ((chartAt E3 x).symm z) + ε * smax1 ((w (c ((chartAt E3 x).symm z)) -
          f ((chartAt E3 x).symm z)) / ε)) := by
      filter_upwards [hUopen.mem_nhds hyU] with z hz
      have hzV : (chartAt E3 x).symm z ∈ V := by rw [hU] at hz; exact hz.2
      exact hFV _ hzV
    have hLF : lapM g F x = lapLocal (g.coeff (chartAt E3 x).symm)
        (fun z => f ((chartAt E3 x).symm z) + ε * smax1 ((w (c ((chartAt E3 x).symm z)) -
          f ((chartAt E3 x).symm z)) / ε)) (chartAt E3 x x) :=
      H1 _ _ _ _ hFeq
    have hL1 : lapLocal (g.coeff (chartAt E3 x).symm) (fun z => f ((chartAt E3 x).symm z))
        (chartAt E3 x x) = lapM g f x := rfl
    have hL2 : lapLocal (g.coeff (chartAt E3 x).symm) (fun z => w (c ((chartAt E3 x).symm z)))
        (chartAt E3 x x) = lapM g (fun x => w (c x)) x := rfl
    rw [hL1, hL2] at hineq
    rw [hLF]
    have hRx := hR x
    have hfx := hfl x
    nlinarith [mul_nonneg (sub_nonneg.2 hs1') hfx, mul_nonneg hs0' hwx, mul_nonneg hs0' hRx]
  exact ⟨F, hFs, hF0, hsup, ⟨Kf ∪ K', hKf.union hK'c, hFK⟩, hFp⟩

theorem cs_bump_at_positive_scalar [T2Space M] [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M)
    (hR : ∀ p : M, 0 ≤ g.scalarCurvature p) (p₀ : M) (hp₀ : 0 < g.scalarCurvature p₀) :
    ∃ f : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧ (∀ x, 0 ≤ f x) ∧
      (∀ x, 0 ≤ 16 * lapM g f x + g.scalarCurvature x) ∧
      (∃ K : Set M, IsCompact K ∧ ∀ x, x ∉ K → f x = 0) ∧ 0 < f p₀ :=
by
  classical
  
  have H1 : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (u v : E3 → ℝ) (y : E3),
      u =ᶠ[𝓝 y] v → lapLocal G u y = lapLocal G v y := by
    intro G u v y huv
    have h1 : ∀ l : Fin 3, partialDeriv l u y = partialDeriv l v y := by
      intro l
      show fderiv ℝ u y (e l) = fderiv ℝ v y (e l)
      rw [huv.fderiv_eq]
    have h2 : ∀ i l : Fin 3, partialDeriv i (fun z => partialDeriv l u z) y =
        partialDeriv i (fun z => partialDeriv l v z) y := by
      intro i l
      have hev : (fun z => partialDeriv l u z) =ᶠ[𝓝 y] (fun z => partialDeriv l v z) := by
        filter_upwards [huv.eventuallyEq_nhds] with z hz
        show fderiv ℝ u z (e l) = fderiv ℝ v z (e l)
        rw [hz.fderiv_eq]
      show fderiv ℝ (fun z => partialDeriv l u z) y (e i) =
        fderiv ℝ (fun z => partialDeriv l v z) y (e i)
      rw [hev.fderiv_eq]
    simp only [lapLocal, h1, h2]
  have H2 : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (u : E3 → ℝ) (α γ : ℝ) (y : E3),
      lapLocal G (fun z => α * u z + γ) y = α * lapLocal G u y := by
    intro G u α γ y
    have hP0 : ∀ (w : E3 → ℝ) (l : Fin 3) (z : E3),
        partialDeriv l (fun z => α * w z) z = α * partialDeriv l w z := by
      intro w l z
      show fderiv ℝ (fun z => α * w z) z (e l) = α * fderiv ℝ w z (e l)
      have : (fun z => α * w z) = α • w := by funext z; simp
      rw [this, fderiv_const_smul_of_field]; rfl
    have hP : ∀ (w : E3 → ℝ) (γ' : ℝ) (l : Fin 3) (z : E3),
        partialDeriv l (fun z => α * w z + γ') z = α * partialDeriv l w z := by
      intro w γ' l z
      rw [← hP0]
      show fderiv ℝ (fun z => α * w z + γ') z (e l) = fderiv ℝ (fun z => α * w z) z (e l)
      rw [fderiv_add_const]
    have h2 : ∀ i l : Fin 3, partialDeriv i (fun z => partialDeriv l (fun z => α * u z + γ) z) y
        = α * partialDeriv i (fun z => partialDeriv l u z) y := by
      intro i l
      have : (fun z => partialDeriv l (fun z => α * u z + γ) z) =
          fun z => α * partialDeriv l u z := by
        funext z; exact hP u γ l z
      rw [this, hP0]
    simp only [lapLocal, h2, hP, hP0, Fin.sum_univ_three]
    ring
  have lapM_congr : ∀ (u v : M → ℝ) (p : M), u =ᶠ[𝓝 p] v → lapM g u p = lapM g v p := by
    intro u v p huv
    have hc : Tendsto (chartAt E3 p).symm (𝓝 (chartAt E3 p p)) (𝓝 p) := by
      have := ((chartAt E3 p).continuousAt_symm (mem_chart_target E3 p)).tendsto
      rwa [(chartAt E3 p).left_inv (mem_chart_source E3 p)] at this
    exact H1 _ _ _ _ (huv.comp_tendsto hc)
  have lap0 : ∀ x : M, lapM g (fun _ => (0 : ℝ)) x = 0 := by
    intro x
    have e1 : ((fun _ : M => (0 : ℝ)) ∘ (chartAt E3 x).symm) =
        fun z : E3 => 0 * (fun _ : E3 => (0 : ℝ)) z + 0 := by
      funext z; simp
    show lapLocal (g.coeff (chartAt E3 x).symm) ((fun _ : M => (0 : ℝ)) ∘ (chartAt E3 x).symm)
      (chartAt E3 x x) = 0
    rw [e1, H2, zero_mul]
  
  set c := chartAt E3 p₀ with hc
  have hU : IsOpen c.target := c.open_target
  have hy₀ : c p₀ ∈ c.target := mem_chart_target E3 p₀
  have hp₀s : p₀ ∈ c.source := mem_chart_source E3 p₀
  set G := g.coeff c.symm with hG
  have hGs : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => G y i j) c.target := g.smooth p₀
  have hpd : ∀ y ∈ c.target, (G y).PosDef := fun y hy => coeff_chart_symm_posDef g p₀ y hy
  
  have hdetgen : ∀ N : E3 → Matrix (Fin 3) (Fin 3) ℝ,
      (∀ k l : Fin 3, ContDiffOn ℝ ∞ (fun y => N y k l) c.target) →
      ContDiffOn ℝ ∞ (fun y => (N y).det) c.target := by
    intro N hN
    have t1 := ((hN 0 0).mul (hN 1 1)).mul (hN 2 2)
    have t2 := ((hN 0 0).mul (hN 1 2)).mul (hN 2 1)
    have t3 := ((hN 0 1).mul (hN 1 0)).mul (hN 2 2)
    have t4 := ((hN 0 1).mul (hN 1 2)).mul (hN 2 0)
    have t5 := ((hN 0 2).mul (hN 1 0)).mul (hN 2 1)
    have t6 := ((hN 0 2).mul (hN 1 1)).mul (hN 2 0)
    have hpoly := ((((t1.sub t2).sub t3).add t4).add t5).sub t6
    exact hpoly.congr (fun y _ => Matrix.det_fin_three (N y))
  have hdet : ContDiffOn ℝ ∞ (fun y => (G y).det) c.target := hdetgen G hGs
  have hadj : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y).adjugate i j) c.target := by
    intro i j
    have h := hdetgen (fun y => (G y).updateRow j (Pi.single i 1)) (by
      intro k l
      by_cases hk : k = j
      · subst hk
        simp only [Matrix.updateRow_self]
        exact contDiffOn_const
      · simp only [Matrix.updateRow_ne hk]
        exact hGs k l)
    exact h.congr (fun y _ => Matrix.adjugate_apply (G y) i j)
  have hinvformula : ∀ (y : E3) (i j : Fin 3),
      (G y)⁻¹ i j = ((G y).det)⁻¹ * (G y).adjugate i j := by
    intro y i j
    rw [Matrix.inv_def, Matrix.smul_apply, smul_eq_mul, Ring.inverse_eq_inv']
  have hGinv : ∀ i j : Fin 3, ContDiffOn ℝ ∞ (fun y => (G y)⁻¹ i j) c.target := by
    intro i j
    have h := (hdet.inv (fun y hy => (hpd y hy).det_pos.ne')).mul (hadj i j)
    exact h.congr (fun y _ => hinvformula y i j)
  
  have hP : ∀ (u : E3 → ℝ), ContDiffOn ℝ ∞ u c.target → ∀ k : Fin 3,
      ContDiffOn ℝ ∞ (fun y => partialDeriv k u y) c.target := by
    intro u hu k
    exact (hu.fderiv_of_isOpen hU (by simp)).clm_apply contDiffOn_const
  have hΓ : ∀ k i j : Fin 3, ContDiffOn ℝ ∞ (christoffel G k i j) c.target := by
    intro k i j
    show ContDiffOn ℝ ∞ (fun y => (1 / 2 : ℝ) * ∑ l : Fin 3, (G y)⁻¹ k l *
      (partialDeriv i (fun z => G z j l) y + partialDeriv j (fun z => G z i l) y
        - partialDeriv l (fun z => G z i j) y)) c.target
    apply contDiffOn_const.mul
    apply ContDiffOn.sum
    intro l _
    exact (hGinv k l).mul (((hP _ (hGs j l) i).add (hP _ (hGs i l) j)).sub (hP _ (hGs i j) l))
  have hRic : ∀ j k : Fin 3, ContDiffOn ℝ ∞ (ricci G j k) c.target := by
    intro j k
    show ContDiffOn ℝ ∞ (fun y => ∑ i : Fin 3, (partialDeriv i (christoffel G i j k) y
        - partialDeriv j (christoffel G i i k) y)
      + ∑ i : Fin 3, ∑ p : Fin 3,
        (christoffel G i i p y * christoffel G p j k y
          - christoffel G i j p y * christoffel G p i k y)) c.target
    apply ContDiffOn.add
    · apply ContDiffOn.sum
      intro i _
      exact (hP _ (hΓ i j k) i).sub (hP _ (hΓ i i k) j)
    · apply ContDiffOn.sum
      intro i _
      apply ContDiffOn.sum
      intro p _
      exact ((hΓ i i p).mul (hΓ p j k)).sub ((hΓ i j p).mul (hΓ p i k))
  have hρ : ContDiffOn ℝ ∞ (scalarCurvatureLocal G) c.target := by
    show ContDiffOn ℝ ∞ (fun y => ∑ j : Fin 3, ∑ k : Fin 3, (G y)⁻¹ j k * ricci G j k y) c.target
    apply ContDiffOn.sum
    intro j _
    apply ContDiffOn.sum
    intro k _
    exact (hGinv j k).mul (hRic j k)
  
  obtain ⟨κ, hκ⟩ : ∃ κ : ℝ, κ = g.scalarCurvature p₀ / 2 := ⟨_, rfl⟩
  have hκ0 : 0 < κ := by rw [hκ]; linarith
  have hρ0 : scalarCurvatureLocal G (c p₀) = g.scalarCurvature p₀ := rfl
  have hρcont : ContinuousAt (scalarCurvatureLocal G) (c p₀) :=
    hρ.continuousOn.continuousAt (hU.mem_nhds hy₀)
  have hev1 : ∀ᶠ y in 𝓝 (c p₀), y ∈ c.target := hU.mem_nhds hy₀
  have hev2 : ∀ᶠ y in 𝓝 (c p₀), κ < scalarCurvatureLocal G y :=
    Filter.Tendsto.eventually hρcont (lt_mem_nhds (by rw [hρ0, hκ]; linarith))
  obtain ⟨ε, hε, hball⟩ := Metric.eventually_nhds_iff.1 (hev1.and hev2)
  have hs : 0 < ε / 3 := by linarith
  have hK₀good : ∀ y ∈ Metric.closedBall (c p₀) (2 * (ε / 3)),
      y ∈ c.target ∧ κ < scalarCurvatureLocal G y := by
    intro y hy
    apply hball
    have := Metric.mem_closedBall.1 hy
    linarith
  have hK₀sub : Metric.closedBall (c p₀) (2 * (ε / 3)) ⊆ c.target := fun y hy => (hK₀good y hy).1
  
  obtain ⟨β, hβin, hβout⟩ : ∃ β : ContDiffBump (c p₀), β.rIn = ε / 3 ∧ β.rOut = 2 * (ε / 3) :=
    ⟨⟨ε / 3, 2 * (ε / 3), hs, by linarith⟩, rfl, rfl⟩
  have hβcd : ContDiff ℝ ∞ (β : E3 → ℝ) := β.contDiff
  have hLβ : ContDiffOn ℝ ∞ (lapLocal G β) c.target := by
    have hβ : ContDiffOn ℝ ∞ (β : E3 → ℝ) c.target := hβcd.contDiffOn
    show ContDiffOn ℝ ∞ (fun y => ∑ i : Fin 3, ∑ j : Fin 3, (G y)⁻¹ i j *
      (partialDeriv i (fun z => partialDeriv j β z) y -
        ∑ k : Fin 3, christoffel G k i j y * partialDeriv k β y)) c.target
    apply ContDiffOn.sum
    intro i _
    apply ContDiffOn.sum
    intro j _
    apply (hGinv i j).mul
    apply (hP _ (hP _ hβ j) i).sub
    apply ContDiffOn.sum
    intro k _
    exact (hΓ k i j).mul (hP _ hβ k)
  obtain ⟨L, hL⟩ := (isCompact_closedBall (c p₀) (2 * (ε / 3))).exists_bound_of_continuousOn
    (hLβ.continuousOn.mono hK₀sub)
  obtain ⟨η, hη⟩ : ∃ η : ℝ, η = κ / (16 * (|L| + 1)) := ⟨_, rfl⟩
  have hden : (0 : ℝ) < 16 * (|L| + 1) := by positivity
  have hη0 : 0 < η := by rw [hη]; exact div_pos hκ0 hden
  have hEta : 16 * η * (|L| + 1) = κ := by
    calc 16 * η * (|L| + 1) = κ / (16 * (|L| + 1)) * (16 * (|L| + 1)) := by rw [hη]; ring
      _ = κ := div_mul_cancel₀ κ hden.ne'
  have hEta' : 16 * (η * |L|) + 16 * η = κ := by rw [← hEta]; ring
  have hw : ContDiff ℝ ∞ (fun z : E3 => η * β z) := contDiff_const.mul hβcd
  
  obtain ⟨f, hf⟩ : ∃ f : M → ℝ, f = c.source.indicator (fun x => η * β (c x)) := ⟨_, rfl⟩
  have hfsrc : ∀ x ∈ c.source, f x = η * β (c x) := by
    intro x hx; rw [hf]; exact Set.indicator_of_mem hx _
  have hfout : ∀ x, x ∉ c.source → f x = 0 := by
    intro x hx; rw [hf]; exact Set.indicator_of_notMem hx _
  obtain ⟨K, hK⟩ : ∃ K : Set M, K = c.symm '' Metric.closedBall (c p₀) (2 * (ε / 3)) := ⟨_, rfl⟩
  have hKc : IsCompact K := by
    rw [hK]
    exact (isCompact_closedBall _ _).image_of_continuousOn (c.continuousOn_symm.mono hK₀sub)
  have hKcl : IsClosed K := hKc.isClosed
  have hKsub : K ⊆ c.source := by
    rw [hK]
    rintro x ⟨y, hy, rfl⟩
    exact c.map_target (hK₀sub hy)
  have hfzero : ∀ x, x ∉ K → f x = 0 := by
    intro x hxK
    by_cases hxs : x ∈ c.source
    · rw [hfsrc x hxs]
      have hd : 2 * (ε / 3) ≤ dist (c x) (c p₀) := by
        by_contra hcon
        push_neg at hcon
        apply hxK
        rw [hK]
        exact ⟨c x, Metric.mem_closedBall.2 hcon.le, c.left_inv hxs⟩
      rw [β.zero_of_le_dist (by rw [hβout]; exact hd), mul_zero]
    · exact hfout x hxs
  have hfnn : ∀ x, 0 ≤ f x := by
    intro x
    rw [hf]
    exact Set.indicator_nonneg (fun y _ => mul_nonneg hη0.le β.nonneg) x
  have hfpos : 0 < f p₀ := by
    rw [hfsrc p₀ hp₀s, β.one_of_mem_closedBall (by rw [hβin]; exact Metric.mem_closedBall_self hs.le),
      mul_one]
    exact hη0
  have hfsm : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f := by
    apply contMDiff_of_locally_contMDiffOn
    intro x
    by_cases hxs : x ∈ c.source
    · refine ⟨c.source, c.open_source, hxs, ?_⟩
      exact (hw.contMDiff.comp_contMDiffOn contMDiffOn_chart).congr (fun z hz => hfsrc z hz)
    · refine ⟨Kᶜ, hKcl.isOpen_compl, fun h => hxs (hKsub h), ?_⟩
      exact (contMDiffOn_const (c := (0 : ℝ))).congr (fun z hz => hfzero z hz)
  
  let Φc : PartialDiffeomorph 𝓘(ℝ, E3) 𝓘(ℝ, E3) E3 M ∞ :=
    ⟨c.symm.toPartialEquiv, c.symm.open_source, c.symm.open_target, contMDiffOn_chart_symm,
      contMDiffOn_chart⟩
  
  have hsup : ∀ x, 0 ≤ 16 * lapM g f x + g.scalarCurvature x := by
    intro x
    by_cases hxK : x ∈ K
    · rw [hK] at hxK
      obtain ⟨y, hyK₀, rfl⟩ := hxK
      have hyt : y ∈ c.target := hK₀sub hyK₀
      have hRx : g.scalarCurvature (c.symm y) = scalarCurvatureLocal G y :=
        scalarCurvature_eq_scalarCurvatureLocal_coeff g Φc y hyt
      have hlap1 : lapM g f (c.symm y) = lapLocal G (f ∘ c.symm) y :=
        (lapLocal_chart_invariant g Φc f Set.univ isOpen_univ hfsm.contMDiffOn y hyt
          (Set.mem_univ _)).symm
      have hev3 : (f ∘ c.symm) =ᶠ[𝓝 y] (fun z => η * β z + 0) := by
        filter_upwards [hU.mem_nhds hyt] with z hz
        simp only [Function.comp_apply, add_zero]
        rw [hfsrc _ (c.map_target hz), c.right_inv hz]
      have hlap2 : lapM g f (c.symm y) = η * lapLocal G β y := by
        rw [hlap1, H1 _ _ _ _ hev3, H2]
      have hLy := hL y hyK₀
      rw [Real.norm_eq_abs] at hLy
      have hlow : -|L| ≤ lapLocal G β y := by
        have h1 := (abs_le.1 hLy).1
        have h2 := le_abs_self L
        linarith
      have hm : -(η * |L|) ≤ η * lapLocal G β y := by
        rw [← mul_neg]; exact mul_le_mul_of_nonneg_left hlow hη0.le
      have hκρ := (hK₀good y hyK₀).2
      rw [hlap2, hRx]
      linarith
    · have hev : f =ᶠ[𝓝 x] (fun _ => (0 : ℝ)) :=
        Filter.eventuallyEq_of_mem (hKcl.isOpen_compl.mem_nhds hxK) (fun z hz => hfzero z hz)
      rw [lapM_congr _ _ x hev, lap0]
      linarith [hR x]
  exact ⟨f, hfsm, hfnn, hsup, ⟨K, hKc, hfzero⟩, hfpos⟩

theorem cs_average_supersolution [IsManifold 𝓘(ℝ, E3) ∞ M] (g : RiemannianMetric3 M) {ι : Type*}
    (t : Finset ι) (ht : t.Nonempty) (f : ι → M → ℝ)
    (hf : ∀ i ∈ t, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ (f i))
    (hsup : ∀ i ∈ t, ∀ x, 0 ≤ 16 * lapM g (f i) x + g.scalarCurvature x) (x : M) :
    0 ≤ 16 * lapM g (fun y => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, f i y) x + g.scalarCurvature x :=
by
  classical
  have hn0 : (0 : ℝ) < (t.card : ℝ) := by exact_mod_cast Finset.card_pos.2 ht
  have hU : IsOpen (chartAt E3 x).target := (chartAt E3 x).open_target
  have hy0 : chartAt E3 x x ∈ (chartAt E3 x).target := mem_chart_target E3 x
  have hu : ∀ i ∈ t, ContDiffOn ℝ ∞ (f i ∘ (chartAt E3 x).symm) (chartAt E3 x).target :=
    fun i hi => contMDiffOn_iff_contDiffOn.mp ((hf i hi).comp_contMDiffOn contMDiffOn_chart_symm)
  
  have hA : ∀ (w : ι → E3 → ℝ) (z : E3) (k : Fin 3), (∀ i ∈ t, DifferentiableAt ℝ (w i) z) →
      partialDeriv k (fun z' => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, w i z') z
        = ((t.card : ℝ))⁻¹ * ∑ i ∈ t, partialDeriv k (w i) z := by
    intro w z k hw
    have hS : DifferentiableAt ℝ (fun z' => ∑ i ∈ t, w i z') z := DifferentiableAt.fun_sum hw
    show fderiv ℝ (fun z' => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, w i z') z (e k)
        = ((t.card : ℝ))⁻¹ * ∑ i ∈ t, fderiv ℝ (w i) z (e k)
    rw [fderiv_const_mul hS, fderiv_fun_sum hw]
    simp [ContinuousLinearMap.sum_apply]
  
  have hdiff : ∀ i ∈ t, ∀ z ∈ (chartAt E3 x).target,
      DifferentiableAt ℝ (f i ∘ (chartAt E3 x).symm) z := fun i hi z hz =>
    ((hu i hi).differentiableOn (by simp)).differentiableAt (hU.mem_nhds hz)
  have hpd : ∀ i ∈ t, ∀ j : Fin 3,
      DifferentiableAt ℝ (fun z => partialDeriv j (f i ∘ (chartAt E3 x).symm) z)
        (chartAt E3 x x) := by
    intro i hi j
    have h1 : ContDiffOn ℝ ∞ (fderiv ℝ (f i ∘ (chartAt E3 x).symm)) (chartAt E3 x).target :=
      (hu i hi).fderiv_of_isOpen hU (by simp)
    have h2 : ContDiffOn ℝ ∞ (fun z => partialDeriv j (f i ∘ (chartAt E3 x).symm) z)
        (chartAt E3 x).target :=
      h1.clm_apply contDiffOn_const
    exact (h2.differentiableOn (by simp)).differentiableAt (hU.mem_nhds hy0)
  
  have hfirst : ∀ j : Fin 3, ∀ z ∈ (chartAt E3 x).target,
      partialDeriv j (fun z' => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, (f i ∘ (chartAt E3 x).symm) z') z
        = ((t.card : ℝ))⁻¹ * ∑ i ∈ t, partialDeriv j (f i ∘ (chartAt E3 x).symm) z :=
    fun j z hz => hA _ z j (fun i hi => hdiff i hi z hz)
  have hfirst0 : ∀ j : Fin 3,
      partialDeriv j (fun z' => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, (f i ∘ (chartAt E3 x).symm) z')
          (chartAt E3 x x)
        = ((t.card : ℝ))⁻¹ * ∑ i ∈ t, partialDeriv j (f i ∘ (chartAt E3 x).symm) (chartAt E3 x x) :=
    fun j => hfirst j _ hy0
  
  have hsecond : ∀ a b : Fin 3,
      partialDeriv a (fun z => partialDeriv b
          (fun z' => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, (f i ∘ (chartAt E3 x).symm) z') z) (chartAt E3 x x)
        = ((t.card : ℝ))⁻¹ * ∑ i ∈ t,
            partialDeriv a (fun z => partialDeriv b (f i ∘ (chartAt E3 x).symm) z)
              (chartAt E3 x x) := by
    intro a b
    have hev : (fun z => partialDeriv b
          (fun z' => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, (f i ∘ (chartAt E3 x).symm) z') z)
        =ᶠ[𝓝 (chartAt E3 x x)]
        (fun z => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, partialDeriv b (f i ∘ (chartAt E3 x).symm) z) :=
      Filter.eventuallyEq_of_mem (hU.mem_nhds hy0) (fun z hz => hfirst b z hz)
    have h1 : partialDeriv a (fun z => partialDeriv b
          (fun z' => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, (f i ∘ (chartAt E3 x).symm) z') z) (chartAt E3 x x)
        = partialDeriv a
          (fun z => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, partialDeriv b (f i ∘ (chartAt E3 x).symm) z)
          (chartAt E3 x x) :=
      congrArg (fun L : E3 →L[ℝ] ℝ => L (e a)) hev.fderiv_eq
    rw [h1]
    exact hA (fun i z => partialDeriv b (f i ∘ (chartAt E3 x).symm) z) _ a (fun i hi => hpd i hi b)
  
  have key : ∀ (N : ℝ) (Γ : Fin 3 → ℝ) (A : ι → ℝ) (B : ι → Fin 3 → ℝ),
      N * (((t.card : ℝ))⁻¹ * ∑ i ∈ t, A i
          - ∑ k : Fin 3, Γ k * (((t.card : ℝ))⁻¹ * ∑ i ∈ t, B i k)) =
        ((t.card : ℝ))⁻¹ * ∑ i ∈ t, N * (A i - ∑ k : Fin 3, Γ k * B i k) := by
    intro N Γ A B
    have e1 : ∀ i ∈ t, N * (A i - ∑ k : Fin 3, Γ k * B i k) =
        N * A i - (N * Γ 0) * B i 0 - (N * Γ 1) * B i 1 - (N * Γ 2) * B i 2 := by
      intro i _
      simp only [Fin.sum_univ_three]
      ring
    rw [Finset.sum_congr rfl e1]
    simp only [Finset.sum_sub_distrib, ← Finset.mul_sum, Fin.sum_univ_three]
    ring
  have hlap : lapM g (fun y => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, f i y) x
      = ((t.card : ℝ))⁻¹ * ∑ i ∈ t, lapM g (f i) x := by
    show lapLocal (g.coeff (chartAt E3 x).symm)
        (fun z' => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, (f i ∘ (chartAt E3 x).symm) z') (chartAt E3 x x)
      = ((t.card : ℝ))⁻¹ * ∑ i ∈ t,
          lapLocal (g.coeff (chartAt E3 x).symm) (f i ∘ (chartAt E3 x).symm) (chartAt E3 x x)
    unfold lapLocal
    have hab : ∀ a b : Fin 3,
        (g.coeff (chartAt E3 x).symm (chartAt E3 x x))⁻¹ a b *
          (partialDeriv a (fun z => partialDeriv b
              (fun z' => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, (f i ∘ (chartAt E3 x).symm) z') z)
              (chartAt E3 x x) -
            ∑ k : Fin 3, christoffel (g.coeff (chartAt E3 x).symm) k a b (chartAt E3 x x) *
              partialDeriv k
                (fun z' => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, (f i ∘ (chartAt E3 x).symm) z')
                (chartAt E3 x x))
        = ((t.card : ℝ))⁻¹ * ∑ i ∈ t,
            (g.coeff (chartAt E3 x).symm (chartAt E3 x x))⁻¹ a b *
              (partialDeriv a (fun z => partialDeriv b (f i ∘ (chartAt E3 x).symm) z)
                  (chartAt E3 x x) -
                ∑ k : Fin 3, christoffel (g.coeff (chartAt E3 x).symm) k a b (chartAt E3 x x) *
                  partialDeriv k (f i ∘ (chartAt E3 x).symm) (chartAt E3 x x)) := by
      intro a b
      rw [hsecond a b]
      simp only [hfirst0]
      exact key _ _ _ _
    rw [Finset.sum_congr rfl (fun a _ => Finset.sum_congr rfl (fun b _ => hab a b))]
    simp only [Finset.mul_sum]
    conv_rhs => rw [Finset.sum_comm]
    refine Finset.sum_congr rfl (fun a _ => ?_)
    exact Finset.sum_comm
  rw [hlap]
  have hsum : 0 ≤ ∑ i ∈ t, (16 * lapM g (f i) x + g.scalarCurvature x) :=
    Finset.sum_nonneg (fun i hi => hsup i hi x)
  rw [Finset.sum_add_distrib, Finset.sum_const, nsmul_eq_mul, ← Finset.mul_sum] at hsum
  have hre : 16 * (((t.card : ℝ))⁻¹ * ∑ i ∈ t, lapM g (f i) x) + g.scalarCurvature x
      = ((t.card : ℝ))⁻¹ *
        (16 * ∑ i ∈ t, lapM g (f i) x + (t.card : ℝ) * g.scalarCurvature x) := by
    rw [mul_add, inv_mul_cancel_left₀ hn0.ne']
    ring
  rw [hre]
  exact mul_nonneg (inv_nonneg.2 hn0.le) hsum

theorem core_supersolution [T2Space M] [ConnectedSpace M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hAF : AsymptoticallyFlat g) (hR : ∀ p : M, 0 ≤ g.scalarCurvature p)
    (p₀ : M) (hp₀ : 0 < g.scalarCurvature p₀) (r : ℝ) (hr : 2 ≤ r) :
    ∃ (f : M → ℝ) (ρ₁ ρ₂ c₀ : ℝ), r < ρ₁ ∧ ρ₁ < ρ₂ ∧ 0 < c₀ ∧
      ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧ (∀ p, 0 ≤ f p ∧ f p ≤ 1 / 4) ∧
      (∀ p, 0 ≤ 16 * lapM g f p + g.scalarCurvature p) ∧
      (∀ (j : Fin hAF.numEnds) (x : E3), ρ₂ < ‖x‖ → f ((hAF.ends j).Φ x) = 0) ∧
      (∀ (j : Fin hAF.numEnds) (x : E3), r ≤ ‖x‖ → ‖x‖ ≤ ρ₁ → c₀ ≤ f ((hAF.ends j).Φ x)) :=
by
  classical
  
  have H2 : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (u : E3 → ℝ) (α γ : ℝ) (y : E3),
      lapLocal G (fun z => α * u z + γ) y = α * lapLocal G u y := by
    intro G u α γ y
    have hP0 : ∀ (w : E3 → ℝ) (l : Fin 3) (z : E3),
        partialDeriv l (fun z => α * w z) z = α * partialDeriv l w z := by
      intro w l z
      show fderiv ℝ (fun z => α * w z) z (e l) = α * fderiv ℝ w z (e l)
      have : (fun z => α * w z) = α • w := by funext z; simp
      rw [this, fderiv_const_smul_of_field]; rfl
    have hP : ∀ (w : E3 → ℝ) (γ' : ℝ) (l : Fin 3) (z : E3),
        partialDeriv l (fun z => α * w z + γ') z = α * partialDeriv l w z := by
      intro w γ' l z
      rw [← hP0]
      show fderiv ℝ (fun z => α * w z + γ') z (e l) = fderiv ℝ (fun z => α * w z) z (e l)
      rw [fderiv_add_const]
    have h2 : ∀ i l : Fin 3, partialDeriv i (fun z => partialDeriv l (fun z => α * u z + γ) z) y
        = α * partialDeriv i (fun z => partialDeriv l u z) y := by
      intro i l
      have : (fun z => partialDeriv l (fun z => α * u z + γ) z) =
          fun z => α * partialDeriv l u z := by
        funext z; exact hP u γ l z
      rw [this, hP0]
    simp only [lapLocal, h2, hP, hP0, Fin.sum_univ_three]
    ring
  have hsrc : ∀ j : Fin hAF.numEnds, (hAF.ends j).Φ.source = {x : E3 | 1 < ‖x‖} :=
    fun j => (hAF.ends j).source_eq
  
  obtain ⟨P, hP⟩ : ∃ P : Set M, P = {q | ∃ f : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧
      (∀ x, 0 ≤ f x) ∧ (∀ x, 0 ≤ 16 * lapM g f x + g.scalarCurvature x) ∧
      (∃ K : Set M, IsCompact K ∧ ∀ x, x ∉ K → f x = 0) ∧ 0 < f q} := ⟨_, rfl⟩
  have hPopen : IsOpen P := by
    rw [isOpen_iff_forall_mem_open]
    intro q hq
    rw [hP, Set.mem_setOf_eq] at hq
    obtain ⟨f, hfs, hf0, hfl, hfK, hfq⟩ := hq
    refine ⟨{x | 0 < f x}, ?_, isOpen_lt continuous_const hfs.continuous, hfq⟩
    intro x hx
    rw [hP, Set.mem_setOf_eq]
    exact ⟨f, hfs, hf0, hfl, hfK, hx⟩
  have hPclosed : IsClosed P := by
    apply isClosed_of_closure_subset
    intro p hp
    have key := cs_good_propagate g hR p (fun U hU hpU => by
      obtain ⟨q, hqU, hqP⟩ := mem_closure_iff.1 hp U hU hpU
      rw [hP, Set.mem_setOf_eq] at hqP
      exact ⟨q, hqU, hqP⟩)
    rw [hP, Set.mem_setOf_eq]
    exact key
  have hP0 : p₀ ∈ P := by
    rw [hP, Set.mem_setOf_eq]
    exact cs_bump_at_positive_scalar g hR p₀ hp₀
  have hPuniv : P = Set.univ := IsClopen.eq_univ ⟨hPclosed, hPopen⟩ ⟨p₀, hP0⟩
  have hgood : ∀ q : M, ∃ f : M → ℝ, ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f ∧
      (∀ x, 0 ≤ f x) ∧ (∀ x, 0 ≤ 16 * lapM g f x + g.scalarCurvature x) ∧
      (∃ K : Set M, IsCompact K ∧ ∀ x, x ∉ K → f x = 0) ∧ 0 < f q := by
    intro q
    have hq : q ∈ P := by rw [hPuniv]; exact Set.mem_univ q
    rw [hP, Set.mem_setOf_eq] at hq
    exact hq
  choose fp hfps hfp0 hfpl hfpK hfpq using hgood
  choose Kp hKpc hKp using hfpK
  
  obtain ⟨ρ₁, hρ₁⟩ : ∃ ρ₁ : ℝ, ρ₁ = r + 1 := ⟨_, rfl⟩
  obtain ⟨A, hA⟩ : ∃ A : Set M,
      A = ⋃ j, (hAF.ends j).Φ '' {x : E3 | r ≤ ‖x‖ ∧ ‖x‖ ≤ ρ₁} := ⟨_, rfl⟩
  have hAc : IsCompact A := by
    rw [hA]
    apply isCompact_iUnion
    intro j
    have hK : IsCompact {x : E3 | r ≤ ‖x‖ ∧ ‖x‖ ≤ ρ₁} := by
      apply (isCompact_closedBall (0 : E3) ρ₁).of_isClosed_subset
      · exact (isClosed_le continuous_const continuous_norm).inter
          (isClosed_le continuous_norm continuous_const)
      · intro x hx
        rw [Metric.mem_closedBall, dist_zero_right]
        exact hx.2
    apply hK.image_of_continuousOn
    apply (hAF.ends j).Φ.contMDiffOn_toFun.continuousOn.mono
    intro x hx
    rw [hsrc j]
    show (1 : ℝ) < ‖x‖
    have := hx.1
    linarith
  
  have hAcov : A ⊆ ⋃ q : M, {x | 0 < fp q x} := fun x _ => Set.mem_iUnion.2 ⟨x, hfpq x⟩
  obtain ⟨t₀, ht₀⟩ := hAc.elim_finite_subcover (fun q => {x | 0 < fp q x})
    (fun q => isOpen_lt continuous_const (hfps q).continuous) hAcov
  obtain ⟨t, ht⟩ : ∃ t : Finset M, t = insert p₀ t₀ := ⟨_, rfl⟩
  have htne : t.Nonempty := by rw [ht]; exact Finset.insert_nonempty _ _
  have hcard : 0 < (t.card : ℝ) := by exact_mod_cast Finset.card_pos.2 htne
  obtain ⟨favg, hfavg⟩ : ∃ favg : M → ℝ,
      favg = fun y => ((t.card : ℝ))⁻¹ * ∑ i ∈ t, fp i y := ⟨_, rfl⟩
  have hfavgs : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ favg := by
    rw [hfavg]
    exact contMDiff_const.mul (contMDiff_finset_sum (fun i _ => hfps i))
  have hfavg0 : ∀ y, 0 ≤ favg y := by
    intro y
    rw [hfavg]
    exact mul_nonneg (inv_nonneg.2 hcard.le) (Finset.sum_nonneg fun i _ => hfp0 i y)
  have hfavgl : ∀ x, 0 ≤ 16 * lapM g favg x + g.scalarCurvature x := by
    intro x
    rw [hfavg]
    exact cs_average_supersolution g t htne fp (fun i _ => hfps i) (fun i _ => hfpl i) x
  obtain ⟨Kt, hKt⟩ : ∃ Kt : Set M, Kt = ⋃ i ∈ t, Kp i := ⟨_, rfl⟩
  have hKtc : IsCompact Kt := by
    rw [hKt]
    exact t.isCompact_biUnion (fun i _ => hKpc i)
  have hfavgK : ∀ y, y ∉ Kt → favg y = 0 := by
    intro y hy
    have hy' : ∀ i ∈ t, y ∉ Kp i := fun i hi hyi =>
      hy (by rw [hKt]; exact Set.mem_biUnion hi hyi)
    rw [hfavg]
    show ((t.card : ℝ))⁻¹ * ∑ i ∈ t, fp i y = 0
    rw [Finset.sum_eq_zero (fun i hi => hKp i y (hy' i hi)), mul_zero]
  have hfavgpos : ∀ y ∈ A, 0 < favg y := by
    intro y hy
    obtain ⟨i, hi, hpos⟩ := Set.mem_iUnion₂.1 (ht₀ hy)
    rw [hfavg]
    show 0 < ((t.card : ℝ))⁻¹ * ∑ i ∈ t, fp i y
    refine mul_pos (inv_pos.2 hcard) (Finset.sum_pos' (fun i _ => hfp0 i y) ⟨i, ?_, hpos⟩)
    rw [ht]
    exact Finset.mem_insert_of_mem hi
  
  have hfavgc : Continuous favg := hfavgs.continuous
  obtain ⟨m₀, hm₀, hm₀A⟩ : ∃ m₀ : ℝ, 0 < m₀ ∧ ∀ y ∈ A, m₀ ≤ favg y := by
    rcases A.eq_empty_or_nonempty with hAe | hAne
    · refine ⟨1, one_pos, fun y hy => ?_⟩
      rw [hAe] at hy
      simp at hy
    · obtain ⟨x, hxA, hxmin⟩ := hAc.exists_isMinOn hAne hfavgc.continuousOn
      exact ⟨favg x, hfavgpos x hxA, fun y hy => isMinOn_iff.1 hxmin y hy⟩
  
  obtain ⟨C₁, hC₁⟩ := hfavgc.bounded_above_of_compact_support (HasCompactSupport.intro hKtc hfavgK)
  obtain ⟨lam, hlam⟩ : ∃ lam : ℝ, lam = 1 / (4 * (|C₁| + 1)) := ⟨_, rfl⟩
  have hlam0 : 0 < lam := by rw [hlam]; positivity
  have hlamC : lam * (|C₁| + 1) = 1 / 4 := by
    rw [hlam]
    have : (0 : ℝ) < |C₁| + 1 := by positivity
    field_simp
  have hlam1 : lam ≤ 1 := by
    have := abs_nonneg C₁
    nlinarith
  obtain ⟨f, hf⟩ : ∃ f : M → ℝ, f = fun y => lam * favg y := ⟨_, rfl⟩
  have hfs : ContMDiff 𝓘(ℝ, E3) 𝓘(ℝ, ℝ) ∞ f := by
    rw [hf]
    exact contMDiff_const.mul hfavgs
  have hfb : ∀ p, 0 ≤ f p ∧ f p ≤ 1 / 4 := by
    intro p
    rw [hf]
    show 0 ≤ lam * favg p ∧ lam * favg p ≤ 1 / 4
    have h1 := hfavg0 p
    have h2 : favg p ≤ |C₁| := by
      have := hC₁ p
      rw [Real.norm_eq_abs] at this
      exact le_trans (le_abs_self _) (le_trans this (le_abs_self _))
    refine ⟨mul_nonneg hlam0.le h1, ?_⟩
    nlinarith
  have hlapf : ∀ p, lapM g f p = lam * lapM g favg p := by
    intro p
    have e1 : f ∘ (chartAt E3 p).symm = fun z => lam * (favg ∘ (chartAt E3 p).symm) z + 0 := by
      funext z
      rw [hf]
      simp
    show lapLocal (g.coeff (chartAt E3 p).symm) (f ∘ (chartAt E3 p).symm) (chartAt E3 p p) =
      lam * lapLocal (g.coeff (chartAt E3 p).symm) (favg ∘ (chartAt E3 p).symm) (chartAt E3 p p)
    rw [e1, H2]
  have hfsup : ∀ p, 0 ≤ 16 * lapM g f p + g.scalarCurvature p := by
    intro p
    rw [hlapf p]
    have h1 := hfavgl p
    have h2 := hR p
    nlinarith [mul_nonneg hlam0.le h1, mul_nonneg (sub_nonneg.2 hlam1) h2]
  
  have hfar : ∀ j : Fin hAF.numEnds, ∃ ρ : ℝ, 2 ≤ ρ ∧
      ∀ x : E3, ρ < ‖x‖ → (hAF.ends j).Φ x ∉ Kt := by
    intro j
    obtain ⟨ρ₀, hρ₀2, hρ₀c⟩ := endChart_far_isClosed g hAF j
    obtain ⟨C, hC⟩ : ∃ C : ℕ → Set M,
        C = fun n : ℕ => (hAF.ends j).Φ '' {x : E3 | ρ₀ + (n : ℝ) ≤ ‖x‖} := ⟨_, rfl⟩
    have hCmem : ∀ (n : ℕ) (p : M), p ∈ C n ↔
        ∃ x : E3, ρ₀ + (n : ℝ) ≤ ‖x‖ ∧ (hAF.ends j).Φ x = p := by
      intro n p; rw [hC]; exact Iff.rfl
    have hCc : ∀ n : ℕ, IsClosed (C n) := by
      intro n
      rw [hC]
      exact hρ₀c _ (by have := n.cast_nonneg (α := ℝ); linarith)
    have hmono : Monotone (fun n : ℕ => (C n)ᶜ) := by
      intro n m hnm
      apply Set.compl_subset_compl.2
      intro p hp
      obtain ⟨x, hx, hxp⟩ := (hCmem m p).1 hp
      refine (hCmem n p).2 ⟨x, ?_, hxp⟩
      have : (n : ℝ) ≤ m := Nat.cast_le.2 hnm
      linarith
    have hcov : Kt ⊆ ⋃ n : ℕ, (C n)ᶜ := by
      intro p _
      rw [Set.mem_iUnion]
      by_cases hpt : p ∈ C 0
      · obtain ⟨x₀, hx₀, hx₀p⟩ := (hCmem 0 p).1 hpt
        obtain ⟨n, hn⟩ := exists_nat_gt ‖x₀‖
        refine ⟨n, fun hpn => ?_⟩
        obtain ⟨x, hx, hxp⟩ := (hCmem n p).1 hpn
        have hn0 : (0 : ℝ) ≤ n := n.cast_nonneg
        have hx₀' : ρ₀ ≤ ‖x₀‖ := by simpa using hx₀
        have hx1 : x ∈ (hAF.ends j).Φ.source := by
          rw [hsrc j]; show (1 : ℝ) < ‖x‖; linarith
        have hx01 : x₀ ∈ (hAF.ends j).Φ.source := by
          rw [hsrc j]; show (1 : ℝ) < ‖x₀‖; linarith
        have e1 : (hAF.ends j).Φ.symm ((hAF.ends j).Φ x) = x :=
          (hAF.ends j).Φ.toPartialEquiv.left_inv hx1
        have e2 : (hAF.ends j).Φ.symm ((hAF.ends j).Φ x₀) = x₀ :=
          (hAF.ends j).Φ.toPartialEquiv.left_inv hx01
        have hxx : x = x₀ := by
          calc x = (hAF.ends j).Φ.symm ((hAF.ends j).Φ x) := e1.symm
            _ = (hAF.ends j).Φ.symm ((hAF.ends j).Φ x₀) := by rw [hxp, hx₀p]
            _ = x₀ := e2
        rw [hxx] at hx
        linarith
      · exact ⟨0, hpt⟩
    obtain ⟨n, hn⟩ := hKtc.elim_directed_cover (fun n => (C n)ᶜ)
      (fun n => (hCc n).isOpen_compl) hcov hmono.directed_le
    refine ⟨ρ₀ + n, by have := n.cast_nonneg (α := ℝ); linarith, fun x hx hxK => ?_⟩
    exact hn hxK ((hCmem n _).2 ⟨x, hx.le, rfl⟩)
  choose ρj hρj2 hρj using hfar
  obtain ⟨ρ₂, hρ₂⟩ : ∃ ρ₂ : ℝ, ρ₂ = ρ₁ + 1 + ∑ j, |ρj j| := ⟨_, rfl⟩
  have hsum0 : 0 ≤ ∑ j, |ρj j| := Finset.sum_nonneg (fun j _ => abs_nonneg _)
  have hρjle : ∀ j, ρj j ≤ ρ₂ := by
    intro j
    have h1 : |ρj j| ≤ ∑ i, |ρj i| :=
      Finset.single_le_sum (f := fun i => |ρj i|) (fun i _ => abs_nonneg _) (Finset.mem_univ j)
    have h2 := le_abs_self (ρj j)
    have h3 : 0 ≤ ρ₁ := by rw [hρ₁]; linarith
    rw [hρ₂]
    linarith
  refine ⟨f, ρ₁, ρ₂, lam * m₀, by rw [hρ₁]; linarith, by rw [hρ₂]; linarith,
    mul_pos hlam0 hm₀, hfs, hfb, hfsup, ?_, ?_⟩
  · intro j x hx
    have hxK : (hAF.ends j).Φ x ∉ Kt := hρj j x (by linarith [hρjle j])
    rw [hf]
    show lam * favg ((hAF.ends j).Φ x) = 0
    rw [hfavgK _ hxK, mul_zero]
  · intro j x hx1 hx2
    have hxA : (hAF.ends j).Φ x ∈ A := by
      rw [hA]
      exact Set.mem_iUnion.2 ⟨j, x, ⟨hx1, hx2⟩, rfl⟩
    rw [hf]
    show lam * m₀ ≤ lam * favg ((hAF.ends j).Φ x)
    exact mul_le_mul_of_nonneg_left (hm₀A _ hxA) hlam0.le

theorem conformal_mass_drop_of_scalar_pos [T2Space M] [ConnectedSpace M] [IsManifold 𝓘(ℝ, E3) ∞ M]
    (g : RiemannianMetric3 M) (hComplete : g.IsCompleteRiemannian) (hAF : AsymptoticallyFlat g)
    (hR : ∀ p : M, 0 ≤ g.scalarCurvature p) (p₀ : M) (hp₀ : 0 < g.scalarCurvature p₀)
    (k : Fin hAF.numEnds) (m : ℝ)
    (hm : Tendsto (fun r : ℝ => admFlux g (hAF.ends k) r) atTop (𝓝 m)) :
    ∃ (g' : RiemannianMetric3 M) (_ : g'.IsCompleteRiemannian) (hAF' : AsymptoticallyFlat g')
      (k' : Fin hAF'.numEnds) (m' : ℝ),
      (∀ p : M, 0 ≤ g'.scalarCurvature p) ∧
      Tendsto (fun r : ℝ => admFlux g' (hAF'.ends k') r) atTop (𝓝 m') ∧ m' < m :=
by
  classical
  
  have H1 : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (u v : E3 → ℝ) (y : E3),
      u =ᶠ[𝓝 y] v → lapLocal G u y = lapLocal G v y := by
    intro G u v y huv
    have h1 : ∀ l : Fin 3, partialDeriv l u y = partialDeriv l v y := by
      intro l
      show fderiv ℝ u y (e l) = fderiv ℝ v y (e l)
      rw [huv.fderiv_eq]
    have h2 : ∀ i l : Fin 3, partialDeriv i (fun z => partialDeriv l u z) y =
        partialDeriv i (fun z => partialDeriv l v z) y := by
      intro i l
      have hev : (fun z => partialDeriv l u z) =ᶠ[𝓝 y] (fun z => partialDeriv l v z) := by
        filter_upwards [huv.eventuallyEq_nhds] with z hz
        show fderiv ℝ u z (e l) = fderiv ℝ v z (e l)
        rw [hz.fderiv_eq]
      show fderiv ℝ (fun z => partialDeriv l u z) y (e i) =
        fderiv ℝ (fun z => partialDeriv l v z) y (e i)
      rw [hev.fderiv_eq]
    simp only [lapLocal, h1, h2]
  have H2 : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (u : E3 → ℝ) (α γ : ℝ) (y : E3),
      lapLocal G (fun z => α * u z + γ) y = α * lapLocal G u y := by
    intro G u α γ y
    have hP0 : ∀ (w : E3 → ℝ) (l : Fin 3) (z : E3),
        partialDeriv l (fun z => α * w z) z = α * partialDeriv l w z := by
      intro w l z
      show fderiv ℝ (fun z => α * w z) z (e l) = α * fderiv ℝ w z (e l)
      have : (fun z => α * w z) = α • w := by funext z; simp
      rw [this, fderiv_const_smul_of_field]; rfl
    have hP : ∀ (w : E3 → ℝ) (γ' : ℝ) (l : Fin 3) (z : E3),
        partialDeriv l (fun z => α * w z + γ') z = α * partialDeriv l w z := by
      intro w γ' l z
      rw [← hP0]
      show fderiv ℝ (fun z => α * w z + γ') z (e l) = fderiv ℝ (fun z => α * w z) z (e l)
      rw [fderiv_add_const]
    have h2 : ∀ i l : Fin 3, partialDeriv i (fun z => partialDeriv l (fun z => α * u z + γ) z) y
        = α * partialDeriv i (fun z => partialDeriv l u z) y := by
      intro i l
      have : (fun z => partialDeriv l (fun z => α * u z + γ) z) =
          fun z => α * partialDeriv l u z := by
        funext z; exact hP u γ l z
      rw [this, hP0]
    simp only [lapLocal, h2, hP, hP0, Fin.sum_univ_three]
    ring
  have H2' : ∀ (G : E3 → Matrix (Fin 3) (Fin 3) ℝ) (u : E3 → ℝ) (γ : ℝ) (y : E3),
      lapLocal G (fun z => u z - γ) y = lapLocal G u y := by
    intro G u γ y
    have e1 : (fun z => u z - γ) = fun z => 1 * u z + -γ := by funext z; ring
    rw [e1, H2, one_mul]
  have lapM_congr : ∀ (u v : M → ℝ) (p : M), u =ᶠ[𝓝 p] v → lapM g u p = lapM g v p := by
    intro u v p huv
    have hc : Tendsto (chartAt E3 p).symm (𝓝 (chartAt E3 p p)) (𝓝 p) := by
