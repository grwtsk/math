import FormalResearch.RiemannHypothesis.ThetaXiMellin
import Mathlib.MeasureTheory.Integral.IntervalIntegral.FundThmCalculus
import Mathlib.Analysis.Complex.RealDeriv
import Mathlib.Analysis.SpecialFunctions.ExpDeriv

/-!
# Finite-interval theta-Phi integration-by-parts bridge

The centered Mellin theorem in `ThetaXiMellin` expresses xi through `thetaA`.
The differential source theorem gives

`A'' - A = 8 Phi`

and the exact endpoint derivative `A'(0) = -1/2`.

This file performs the next bounded step.  Instead of discarding the endpoint at
infinity, it proves an exact finite-interval exponential identity with the
boundary term still present.  Algebraically this packages the two integrations
by parts into the derivative of

`(A'(t) - 2 u A(t)) * exp(2 u t)`.

No limit at infinity, coefficient formula, total-positivity assertion, or RH
conclusion is used here.
-/

namespace FormalResearch.RiemannHypothesis.ThetaPositiveLift

open MeasureTheory Set

noncomputable section

/-- The modewise second-derivative series is the source-level second derivative
of `thetaA`; rewriting the existing differential theorem in these explicit
series coordinates gives the exact source equation used below. -/
theorem thetaASecondSeries_sub_thetaA_eq_eight_phi (t : ℝ) :
    thetaASecondSeries t - thetaA t = 8 * thetaPhi t := by
  have hfirst : deriv thetaA = thetaADerivSeries := by
    funext x
    exact (hasDerivAt_thetaA x).deriv
  have h := thetaA_second_deriv_sub t
  rw [hfirst, (hasDerivAt_thetaADerivSeries t).deriv] at h
  exact h

/-- The explicit first-derivative series carries the exact lower-endpoint value. -/
theorem thetaADerivSeries_zero :
    thetaADerivSeries 0 = -(1 / 2 : ℝ) := by
  rw [← (hasDerivAt_thetaA 0).deriv]
  exact thetaA_deriv_zero

/-- Exponential spectral kernel on the logarithmic theta coordinate. -/
def thetaExpKernel (u : ℂ) (t : ℝ) : ℂ :=
  Complex.exp ((2 * u) * (t : ℂ))

/-- The finite-endpoint Wronskian-type boundary expression generated by the
second-order source operator. -/
def thetaExpBoundary (u : ℂ) (t : ℝ) : ℂ :=
  ((thetaADerivSeries t : ℂ) - (2 * u) * (thetaA t : ℂ)) *
    thetaExpKernel u t

/-- Real differentiation of the complex exponential kernel. -/
theorem thetaExpKernel_hasDerivAt (u : ℂ) (t : ℝ) :
    HasDerivAt (thetaExpKernel u) ((2 * u) * thetaExpKernel u t) t := by
  have hlin :
      HasDerivAt (fun x : ℝ => (2 * u) * (x : ℂ)) (2 * u) t := by
    simpa only [Complex.ofReal_one, mul_one] using!
      (hasDerivAt_id t).ofReal_comp.const_mul (2 * u)
  unfold thetaExpKernel
  convert! hlin.cexp using 1
  ring

/-- Differentiating the boundary expression exposes precisely the positive
theta source minus the spectral multiple of `A`.  This is the differential
form of the two integrations by parts, before any endpoint is discarded. -/
theorem thetaExpBoundary_hasDerivAt (u : ℂ) (t : ℝ) :
    HasDerivAt (thetaExpBoundary u)
      (((8 : ℂ) * (thetaPhi t : ℂ) -
          (((2 * u) ^ 2 - 1) * (thetaA t : ℂ))) *
        thetaExpKernel u t) t := by
  have hD := (hasDerivAt_thetaADerivSeries t).ofReal_comp
  have hA := (hasDerivAt_thetaA t).ofReal_comp
  have hleft := hD.sub (hA.const_mul (2 * u))
  have hprod := hleft.mul (thetaExpKernel_hasDerivAt u t)
  have hrel :
      (thetaASecondSeries t : ℂ) - (thetaA t : ℂ) =
        (8 : ℂ) * (thetaPhi t : ℂ) := by
    exact_mod_cast thetaASecondSeries_sub_thetaA_eq_eight_phi t
  convert! hprod using 1
  rw [← hrel]
  simp only [Pi.sub_apply]
  ring

/-- The exponential kernel is continuous in the finite-interval variable. -/
theorem continuous_thetaExpKernel (u : ℂ) :
    Continuous (thetaExpKernel u) :=
  continuous_iff_continuousAt.mpr fun t =>
    (thetaExpKernel_hasDerivAt u t).continuousAt

/-- `thetaA`, viewed in the complex codomain, is continuous. -/
private theorem continuous_thetaA_complex :
    Continuous (fun t : ℝ => (thetaA t : ℂ)) := by
  have hA : Continuous thetaA :=
    continuous_iff_continuousAt.mpr fun t => (hasDerivAt_thetaA t).continuousAt
  exact Complex.continuous_ofReal.comp hA

/-- `thetaPhi`, viewed in the complex codomain, is continuous. -/
private theorem continuous_thetaPhi_complex :
    Continuous (fun t : ℝ => (thetaPhi t : ℂ)) :=
  Complex.continuous_ofReal.comp continuous_thetaPhi

/-- Exact finite-interval source identity.

The left side is already the positive `Phi` source.  The first term on the
right is the retained boundary debt; the last term is the same `A` transform
that occurs in the centered xi formula.  Passing from this theorem to the
improper cosh identity therefore requires only the even `u,-u` combination
and a separately proved vanishing of the upper boundary. -/
theorem thetaPhi_exp_interval_identity (u : ℂ) (b : ℝ) :
    (8 : ℂ) *
        ∫ t in (0 : ℝ)..b, (thetaPhi t : ℂ) * thetaExpKernel u t =
      thetaExpBoundary u b - thetaExpBoundary u 0 +
        (((2 * u) ^ 2 - 1) *
          ∫ t in (0 : ℝ)..b, (thetaA t : ℂ) * thetaExpKernel u t) := by
  let q : ℂ := (2 * u) ^ 2 - 1
  let phiPart : ℝ → ℂ := fun t =>
    (thetaPhi t : ℂ) * thetaExpKernel u t
  let aPart : ℝ → ℂ := fun t =>
    (thetaA t : ℂ) * thetaExpKernel u t
  let sourceDeriv : ℝ → ℂ := fun t =>
    (8 : ℂ) * phiPart t - q * aPart t
  have hphi : Continuous phiPart := by
    unfold phiPart
    exact continuous_thetaPhi_complex.mul (continuous_thetaExpKernel u)
  have ha : Continuous aPart := by
    unfold aPart
    exact continuous_thetaA_complex.mul (continuous_thetaExpKernel u)
  have hsource : Continuous sourceDeriv := by
    unfold sourceDeriv
    fun_prop
  have hftc :
      (∫ t in (0 : ℝ)..b, sourceDeriv t) =
        thetaExpBoundary u b - thetaExpBoundary u 0 := by
    apply intervalIntegral.integral_eq_sub_of_hasDerivAt
    · intro t _
      unfold sourceDeriv phiPart aPart q
      convert! thetaExpBoundary_hasDerivAt u t using 1
      ring
    · exact Continuous.intervalIntegrable hsource _ _
  have hleft :
      IntervalIntegrable (fun t : ℝ => (8 : ℂ) * phiPart t) volume 0 b :=
    Continuous.intervalIntegrable (continuous_const.mul hphi) _ _
  have hright :
      IntervalIntegrable (fun t : ℝ => q * aPart t) volume 0 b :=
    Continuous.intervalIntegrable (continuous_const.mul ha) _ _
  have hsplit :
      (∫ t in (0 : ℝ)..b, sourceDeriv t) =
        (8 : ℂ) * (∫ t in (0 : ℝ)..b, phiPart t) -
          q * (∫ t in (0 : ℝ)..b, aPart t) := by
    unfold sourceDeriv
    rw [intervalIntegral.integral_sub hleft hright]
    simp only [intervalIntegral.integral_const_mul]
  rw [hsplit] at hftc
  dsimp only [phiPart, aPart, q] at hftc
  linear_combination hftc

/-- The lower boundary is explicit.  The odd term in `u` cancels when the
`u` and `-u` identities are averaged, while the remaining derivative value
is exactly the `-1/2` source endpoint. -/
theorem thetaExpBoundary_zero (u : ℂ) :
    thetaExpBoundary u 0 =
      -(1 / 2 : ℂ) - (2 * u) * (thetaA 0 : ℂ) := by
  simp [thetaExpBoundary, thetaExpKernel, thetaADerivSeries_zero]

/-- The evenized finite-endpoint boundary.  Defining it as the average of the
two exponential orientations makes the cancellation of the odd lower-endpoint
term structural rather than implicit. -/
def thetaCoshBoundary (u : ℂ) (t : ℝ) : ℂ :=
  (thetaExpBoundary u t + thetaExpBoundary (-u) t) / 2

private theorem thetaExpKernel_neg (u : ℂ) (t : ℝ) :
    thetaExpKernel (-u) t =
      Complex.exp (-(2 * u * (t : ℂ))) := by
  unfold thetaExpKernel
  congr 1
  ring

/-- Averaging the two exponential kernels gives the hyperbolic cosine kernel. -/
theorem thetaExpKernel_average_eq_cosh (u : ℂ) (t : ℝ) :
    (thetaExpKernel u t + thetaExpKernel (-u) t) / 2 =
      Complex.cosh (2 * u * (t : ℂ)) := by
  rw [thetaExpKernel_neg]
  simp [thetaExpKernel, Complex.cosh]

/-- Their signed average gives the hyperbolic sine kernel. -/
theorem thetaExpKernel_difference_eq_sinh (u : ℂ) (t : ℝ) :
    (thetaExpKernel u t - thetaExpKernel (-u) t) / 2 =
      Complex.sinh (2 * u * (t : ℂ)) := by
  rw [thetaExpKernel_neg]
  simp [thetaExpKernel, Complex.sinh]

/-- The evenized boundary has the expected Wronskian form
`A'(t) cosh(2ut) - 2u A(t) sinh(2ut)`. -/
theorem thetaCoshBoundary_eq (u : ℂ) (t : ℝ) :
    thetaCoshBoundary u t =
      (thetaADerivSeries t : ℂ) * Complex.cosh (2 * u * (t : ℂ)) -
        (2 * u) * (thetaA t : ℂ) * Complex.sinh (2 * u * (t : ℂ)) := by
  unfold thetaCoshBoundary thetaExpBoundary
  rw [← thetaExpKernel_average_eq_cosh u t,
    ← thetaExpKernel_difference_eq_sinh u t]
  ring

/-- Symmetrization cancels the odd `2u A(0)` debt and leaves exactly
`-1/2` at the lower endpoint. -/
theorem thetaCoshBoundary_zero (u : ℂ) :
    thetaCoshBoundary u 0 = -(1 / 2 : ℂ) := by
  unfold thetaCoshBoundary
  rw [thetaExpBoundary_zero u, thetaExpBoundary_zero (-u)]
  ring

private theorem thetaPhi_cosh_interval_eq_average (u : ℂ) (b : ℝ) :
    (∫ t in (0 : ℝ)..b,
        (thetaPhi t : ℂ) * Complex.cosh (2 * u * (t : ℂ))) =
      ((∫ t in (0 : ℝ)..b,
          (thetaPhi t : ℂ) * thetaExpKernel u t) +
       (∫ t in (0 : ℝ)..b,
          (thetaPhi t : ℂ) * thetaExpKernel (-u) t)) / 2 := by
  have hp :
      IntervalIntegrable
        (fun t : ℝ => (thetaPhi t : ℂ) * thetaExpKernel u t)
        volume 0 b :=
    Continuous.intervalIntegrable
      (continuous_thetaPhi_complex.mul (continuous_thetaExpKernel u)) _ _
  have hm :
      IntervalIntegrable
        (fun t : ℝ => (thetaPhi t : ℂ) * thetaExpKernel (-u) t)
        volume 0 b :=
    Continuous.intervalIntegrable
      (continuous_thetaPhi_complex.mul (continuous_thetaExpKernel (-u))) _ _
  rw [show
    (fun t : ℝ =>
      (thetaPhi t : ℂ) * Complex.cosh (2 * u * (t : ℂ))) =
      fun t : ℝ =>
        ((thetaPhi t : ℂ) * thetaExpKernel u t +
          (thetaPhi t : ℂ) * thetaExpKernel (-u) t) / 2 by
    funext t
    rw [← thetaExpKernel_average_eq_cosh u t]
    ring]
  rw [intervalIntegral.integral_div, intervalIntegral.integral_add hp hm]

private theorem thetaA_cosh_interval_eq_average (u : ℂ) (b : ℝ) :
    (∫ t in (0 : ℝ)..b,
        (thetaA t : ℂ) * Complex.cosh (2 * u * (t : ℂ))) =
      ((∫ t in (0 : ℝ)..b,
          (thetaA t : ℂ) * thetaExpKernel u t) +
       (∫ t in (0 : ℝ)..b,
          (thetaA t : ℂ) * thetaExpKernel (-u) t)) / 2 := by
  have hp :
      IntervalIntegrable
        (fun t : ℝ => (thetaA t : ℂ) * thetaExpKernel u t)
        volume 0 b :=
    Continuous.intervalIntegrable
      (continuous_thetaA_complex.mul (continuous_thetaExpKernel u)) _ _
  have hm :
      IntervalIntegrable
        (fun t : ℝ => (thetaA t : ℂ) * thetaExpKernel (-u) t)
        volume 0 b :=
    Continuous.intervalIntegrable
      (continuous_thetaA_complex.mul (continuous_thetaExpKernel (-u))) _ _
  rw [show
    (fun t : ℝ =>
      (thetaA t : ℂ) * Complex.cosh (2 * u * (t : ℂ))) =
      fun t : ℝ =>
        ((thetaA t : ℂ) * thetaExpKernel u t +
          (thetaA t : ℂ) * thetaExpKernel (-u) t) / 2 by
    funext t
    rw [← thetaExpKernel_average_eq_cosh u t]
    ring]
  rw [intervalIntegral.integral_div, intervalIntegral.integral_add hp hm]

/-- Exact finite cosh identity obtained by averaging the source identities at
`u` and `-u`.  No upper boundary has been discarded. -/
theorem thetaPhi_cosh_interval_identity (u : ℂ) (b : ℝ) :
    (8 : ℂ) *
        ∫ t in (0 : ℝ)..b,
          (thetaPhi t : ℂ) * Complex.cosh (2 * u * (t : ℂ)) =
      (1 / 2 : ℂ) +
        (4 * u ^ 2 - 1) *
          (∫ t in (0 : ℝ)..b,
            (thetaA t : ℂ) * Complex.cosh (2 * u * (t : ℂ))) +
        thetaCoshBoundary u b := by
  have hp := thetaPhi_exp_interval_identity u b
  have hm := thetaPhi_exp_interval_identity (-u) b
  have havg :
      (8 : ℂ) *
          (((∫ t in (0 : ℝ)..b,
                (thetaPhi t : ℂ) * thetaExpKernel u t) +
            (∫ t in (0 : ℝ)..b,
                (thetaPhi t : ℂ) * thetaExpKernel (-u) t)) / 2) =
        thetaCoshBoundary u b - thetaCoshBoundary u 0 +
          (((2 * u) ^ 2 - 1) *
            (((∫ t in (0 : ℝ)..b,
                  (thetaA t : ℂ) * thetaExpKernel u t) +
              (∫ t in (0 : ℝ)..b,
                  (thetaA t : ℂ) * thetaExpKernel (-u) t)) / 2)) := by
    unfold thetaCoshBoundary
    linear_combination (1 / 2 : ℂ) * hp + (1 / 2 : ℂ) * hm
  rw [← thetaPhi_cosh_interval_eq_average u b,
    ← thetaA_cosh_interval_eq_average u b] at havg
  rw [thetaCoshBoundary_zero] at havg
  convert! havg using 1
  ring

/-- Expanded form of the same theorem: the surviving upper boundary is exactly
`A'(b) cosh(2ub) - 2u A(b) sinh(2ub)`. -/
theorem thetaPhi_cosh_interval_identity_explicit (u : ℂ) (b : ℝ) :
    (8 : ℂ) *
        ∫ t in (0 : ℝ)..b,
          (thetaPhi t : ℂ) * Complex.cosh (2 * u * (t : ℂ)) =
      (1 / 2 : ℂ) +
        (4 * u ^ 2 - 1) *
          (∫ t in (0 : ℝ)..b,
            (thetaA t : ℂ) * Complex.cosh (2 * u * (t : ℂ))) +
        (thetaADerivSeries b : ℂ) * Complex.cosh (2 * u * (b : ℂ)) -
        (2 * u) * (thetaA b : ℂ) * Complex.sinh (2 * u * (b : ℂ)) := by
  rw [thetaPhi_cosh_interval_identity, thetaCoshBoundary_eq]
  ring

/-- At the degenerate interval endpoint the explicit retained boundary exactly
cancels the source debt, a consistency check on the normalization. -/
theorem thetaPhi_cosh_interval_identity_at_zero (u : ℂ) :
    (1 / 2 : ℂ) + thetaCoshBoundary u 0 = 0 := by
  rw [thetaCoshBoundary_zero]
  ring

end

end FormalResearch.RiemannHypothesis.ThetaPositiveLift
