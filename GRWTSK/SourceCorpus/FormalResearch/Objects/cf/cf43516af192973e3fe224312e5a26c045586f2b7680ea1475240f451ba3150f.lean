module

public meta import Surface.Core.Classification
public import Mathlib.Analysis.CStarAlgebra.ContinuousFunctionalCalculus.Range
public import Mathlib.Analysis.CStarAlgebra.ContinuousLinearMap
public import Mathlib.Analysis.CStarAlgebra.Projection
public import Mathlib.Topology.LocallyConstant.Algebra

/-!
# Clopen spectral projections from the continuous functional calculus

For a bounded normal operator `A` on a complete complex Hilbert space and a
clopen subset `U` of its **relative spectrum**, this module applies the
continuous functional calculus to the characteristic function `1_U`:

```text
P_U = cfcHom(A)(1_U).
```

The clopen hypothesis is exactly what makes `1_U` continuous on `spectrum ℂ A`.
Multiplicativity of `cfcHom` then transports the pointwise identity
`1_U * 1_U = 1_U` to `P_U * P_U = P_U`.  Since the normal CFC also preserves
normality, `P_U` is a star projection (an orthogonal projection in the bounded
operator algebra).

## Architectural boundary

* `cfcHom` is written with ambient codomain `H →L[ℂ] H`, but its range is the
  elemental C⋆-subalgebra generated by `A`; it is not asserted to be onto the
  full bounded-operator algebra.  `cfcSpectralProjection_mem_elemental` records
  that boundary explicitly.
* Normality is essential to this construction.  A self-adjoint operator is
  covered because `IsSelfAdjoint.isStarNormal`, but this file does not construct
  projections for arbitrary nonnormal operators.
* The selected part of the spectrum must be clopen in the relative topology.
  A positive spectral gap around an isolated spectral value supplies this data
  in `spectralSingleton_isClopen_of_gap`.
* This construction does not identify its result with
  `RieszCircle.circleRieszCandidate`.  Such an equality is a separate
  contour–CFC compatibility theorem and is deliberately not claimed here.
-/

public section

noncomputable section

open Set
open scoped ContinuousFunctionalCalculus CStarAlgebra

namespace Surface.Core.CFCProjection

variable {H : Type*}
variable [NormedAddCommGroup H] [InnerProductSpace ℂ H] [CompleteSpace H]

/-! ## A clopen characteristic function on the relative spectrum -/

/--
The continuous `{0, 1}`-valued characteristic function of a clopen part of a
normal operator's relative spectrum.
-/
@[expose, surface_adapter, surface_published]
def spectralCharacteristic (A : H →L[ℂ] H)
    (U : Set (spectrum ℂ A)) (hU : IsClopen U) : C(spectrum ℂ A, ℂ) :=
  (LocallyConstant.charFn ℂ hU : C(spectrum ℂ A, ℂ))

omit [CompleteSpace H] in
/-- The spectral characteristic function is pointwise, hence algebraically, idempotent. -/
@[surface_adapter, surface_published]
theorem spectralCharacteristic_mul_self
    (A : H →L[ℂ] H) (U : Set (spectrum ℂ A)) (hU : IsClopen U) :
    spectralCharacteristic A U hU * spectralCharacteristic A U hU =
      spectralCharacteristic A U hU := by
  ext z
  by_cases hz : z ∈ U <;>
    simp [spectralCharacteristic, LocallyConstant.charFn, Set.indicator, hz]

/-! ## The CFC spectral projection -/

/--
The normal continuous-functional-calculus image of the characteristic function
of a clopen spectral subset.

Although the displayed codomain is the whole bounded-operator algebra, the
value lies in `StarAlgebra.elemental ℂ A`; see
`cfcSpectralProjection_mem_elemental`.
-/
@[expose, surface_novel, surface_published]
def cfcSpectralProjection (A : H →L[ℂ] H) (hA : IsStarNormal A)
    (U : Set (spectrum ℂ A)) (hU : IsClopen U) : H →L[ℂ] H :=
  cfcHom hA (spectralCharacteristic A U hU)

/--
The CFC projection belongs to the elemental C⋆-subalgebra generated by `A`.
This makes explicit that CFC does not supply a surjection onto all of
`H →L[ℂ] H`.
-/
@[surface_adapter, surface_published]
theorem cfcSpectralProjection_mem_elemental
    (A : H →L[ℂ] H) (hA : IsStarNormal A)
    (U : Set (spectrum ℂ A)) (hU : IsClopen U) :
    cfcSpectralProjection A hA U hU ∈ StarAlgebra.elemental ℂ A := by
  exact cfcHom_mem_elemental hA (spectralCharacteristic A U hU)

/-- Multiplicativity transfers characteristic-function idempotence to the operator. -/
@[surface_novel, surface_published]
theorem cfcSpectralProjection_isIdempotentElem
    (A : H →L[ℂ] H) (hA : IsStarNormal A)
    (U : Set (spectrum ℂ A)) (hU : IsClopen U) :
    IsIdempotentElem (cfcSpectralProjection A hA U hU) := by
  rw [IsIdempotentElem]
  change cfcHom hA (spectralCharacteristic A U hU) *
      cfcHom hA (spectralCharacteristic A U hU) =
    cfcHom hA (spectralCharacteristic A U hU)
  rw [← map_mul, spectralCharacteristic_mul_self]

/--
The clopen CFC image is a star projection.  For bounded Hilbert-space
operators this is the algebraic form of being an orthogonal projection.
-/
@[surface_novel, surface_published]
theorem cfcSpectralProjection_isStarProjection
    (A : H →L[ℂ] H) (hA : IsStarNormal A)
    (U : Set (spectrum ℂ A)) (hU : IsClopen U) :
    IsStarProjection (cfcSpectralProjection A hA U hU) := by
  rw [isStarProjection_iff_isIdempotentElem_and_isStarNormal]
  exact ⟨cfcSpectralProjection_isIdempotentElem A hA U hU,
    cfcHom_predicate hA (spectralCharacteristic A U hU)⟩

/-! ## Isolating one spectral value by a positive gap -/

/-- The relative singleton determined by a scalar spectral value. -/
@[expose, surface_adapter, surface_published]
def spectralSingleton (A : H →L[ℂ] H) (lambda : ℂ) : Set (spectrum ℂ A) :=
  {z | (z : ℂ) = lambda}

omit [CompleteSpace H] in
/--
A spectral value separated from every other spectral value by a positive gap
defines a clopen singleton in the relative spectrum.

The gap is given as a radius `r > 0` such that every distinct spectral value is
at distance at least `r` from `λ`.  Thus the relative open ball of radius `r`
around `λ` contains exactly `λ`.
-/
@[surface_novel, surface_published]
theorem spectralSingleton_isClopen_of_gap
    (A : H →L[ℂ] H) (lambda : ℂ) (hlambda : lambda ∈ spectrum ℂ A)
    (r : ℝ) (hr : 0 < r)
    (hgap : ∀ z ∈ spectrum ℂ A, z ≠ lambda → r ≤ dist z lambda) :
    IsClopen (spectralSingleton A lambda) := by
  let lambdas : spectrum ℂ A := ⟨lambda, hlambda⟩
  have hsingleton : spectralSingleton A lambda = {lambdas} := by
    ext z
    simp only [spectralSingleton, Set.mem_setOf_eq, Set.mem_singleton_iff]
    exact ⟨fun hz ↦ Subtype.ext hz, fun hz ↦ congrArg Subtype.val hz⟩
  constructor
  · rw [hsingleton]
    exact isClosed_singleton
  · have hopen :
        IsOpen ((fun z : spectrum ℂ A ↦ (z : ℂ)) ⁻¹' Metric.ball lambda r) :=
      Metric.isOpen_ball.preimage continuous_subtype_val
    convert hopen using 1
    ext z
    simp only [spectralSingleton, Set.mem_setOf_eq, Set.mem_preimage,
      Metric.mem_ball]
    constructor
    · intro hz
      rw [hz, dist_self]
      exact hr
    · intro hz
      by_contra hne
      exact (not_lt_of_ge (hgap z z.property hne)) hz

/--
The CFC projection onto one isolated spectral value, with the isolation data
carried explicitly in the term.
-/
@[expose, surface_novel, surface_published]
def isolatedSpectralProjection
    (A : H →L[ℂ] H) (hA : IsStarNormal A)
    (lambda : ℂ) (hlambda : lambda ∈ spectrum ℂ A)
    (r : ℝ) (hr : 0 < r)
    (hgap : ∀ z ∈ spectrum ℂ A, z ≠ lambda → r ≤ dist z lambda) : H →L[ℂ] H :=
  cfcSpectralProjection A hA (spectralSingleton A lambda)
    (spectralSingleton_isClopen_of_gap A lambda hlambda r hr hgap)

/-- The isolated-value construction is an orthogonal projection. -/
@[surface_novel, surface_published]
theorem isolatedSpectralProjection_isStarProjection
    (A : H →L[ℂ] H) (hA : IsStarNormal A)
    (lambda : ℂ) (hlambda : lambda ∈ spectrum ℂ A)
    (r : ℝ) (hr : 0 < r)
    (hgap : ∀ z ∈ spectrum ℂ A, z ≠ lambda → r ≤ dist z lambda) :
    IsStarProjection (isolatedSpectralProjection A hA lambda hlambda r hr hgap) :=
  cfcSpectralProjection_isStarProjection A hA (spectralSingleton A lambda)
    (spectralSingleton_isClopen_of_gap A lambda hlambda r hr hgap)

/-! ## Self-adjoint specialization -/

/-- A self-adjoint operator uses the same construction through its induced normality. -/
@[expose, surface_adapter, surface_published]
def selfAdjointSpectralProjection
    (A : H →L[ℂ] H) (hA : IsSelfAdjoint A)
    (U : Set (spectrum ℂ A)) (hU : IsClopen U) : H →L[ℂ] H :=
  cfcSpectralProjection A hA.isStarNormal U hU

/-- The self-adjoint specialization remains a star projection. -/
@[surface_adapter, surface_published]
theorem selfAdjointSpectralProjection_isStarProjection
    (A : H →L[ℂ] H) (hA : IsSelfAdjoint A)
    (U : Set (spectrum ℂ A)) (hU : IsClopen U) :
    IsStarProjection (selfAdjointSpectralProjection A hA U hU) :=
  cfcSpectralProjection_isStarProjection A hA.isStarNormal U hU

end Surface.Core.CFCProjection
