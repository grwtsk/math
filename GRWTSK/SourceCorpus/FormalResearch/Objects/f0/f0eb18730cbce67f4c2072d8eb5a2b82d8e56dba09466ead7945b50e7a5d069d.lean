import MathDiscovery.Hilbert.Quotient

/-!
# Completed rhetorical Hilbert space

The canonical space is the uniform completion of the explicit Hausdorff
kernel quotient.  This is an actual Mathlib completion, not a completeness
capability field or a finite-dimensional substitute.
-/

noncomputable section

namespace MathDiscovery.Hilbert

open MathDiscovery.Kernel

universe u

variable {Index : Type u} (kernel : Kernel.PositiveKernel Index)

/-- The completed Hilbert space generated by a positive kernel. -/
@[reducible] def KernelSpace :=
  UniformSpace.Completion (PreKernelSpace kernel)

/-- The canonical isometric inclusion of the pre-Hilbert quotient into its
completion. -/
def completePreKernel
    (f : PreKernelSpace kernel) : KernelSpace kernel :=
  (f : UniformSpace.Completion (PreKernelSpace kernel))

/-- The construction supplies the full bundled Hilbert-space structure. -/
def kernelSpace_hilbertStructure :
    HilbertSpace ℂ (KernelSpace kernel) :=
  ⟨⟩

/-- Completeness follows from the actual completion construction. -/
theorem kernelSpace_isHilbert :
    CompleteSpace (KernelSpace kernel) :=
  inferInstance

/-- Completion preserves the quotient inner product on the dense image. -/
@[simp]
theorem inner_completePreKernel
    (f g : PreKernelSpace kernel) :
    inner ℂ (completePreKernel kernel f)
        (completePreKernel kernel g) =
      preKernelInner kernel f g := by
  exact UniformSpace.Completion.inner_coe f g

/-- The quotient image is dense in the completed space. -/
theorem completePreKernel_denseRange :
    DenseRange (completePreKernel kernel) :=
  UniformSpace.Completion.denseRange_coe

end MathDiscovery.Hilbert
