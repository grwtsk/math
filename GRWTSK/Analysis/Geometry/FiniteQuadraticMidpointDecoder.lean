import GRWTSK.Analysis.Geometry.FiniteQuadraticContactGraph
import GRWTSK.Algebra.LinearAlgebra.FiniteBoundaryReturnTrace
import Mathlib

set_option autoImplicit false
noncomputable section

/-!
# Exact midpoint observations and algebraic quadratic reconstruction

A single scalar quadratic Bezier source has three independent control
coordinates.  Its two true outer endpoints and its exact *contact point*
at the interior midpoint give a three-symbol ordinary-evaluation code.

The explicit decoder reconstructs all three original control coordinates.
This is an algebraic source decoder and a finite identity-return fixture;
it is NOT an added geometric return edge, a two-dimensional planar embedding,
or a Hilbert-Polya spectral representation.
-/

namespace GRWTSK.Analysis.Geometry.FiniteQuadraticMidpointDecoder

open GRWTSK.Analysis.Geometry.QuadraticBezierContact
open GRWTSK.Analysis.Geometry.FiniteQuadraticContactGraph
open GRWTSK.Algebra.LinearAlgebra.FiniteBoundaryReturn
open GRWTSK.Algebra.LinearAlgebra.FiniteClosedWalkTrace

/-- Original source control coordinates: start, control, finish. -/
abbrev Controls := Fin 3 → ℝ

/-- The *actual* scalar quadratic source represented as a segment. -/
def sourceSegment (x : Controls) : Segment Unit where
  start := fun _ => x 0
  control := fun _ => x 1
  finish := fun _ => x 2

/-- Real contact graph generated by one strict interior split of that source. -/
def midpointGraph (x : Controls) : SplitGraph Unit Unit where
  source := sourceSegment x
  cut := 1 / 2
  cut_pos := by norm_num
  cut_lt_one := by norm_num
  sourceLabel := ()
  multiplicity := 1
  multiplicity_pos := by norm_num

/-- The three *real* observations: the two actual source endpoints and
the middle point of the contact, not two copies of the seam. -/
def contactSamples (x : Controls) : Fin 3 → ℝ :=
  fun i =>
    if i = 0 then (sourceSegment x).eval 0 ()
    else if i = 1 then (midpointGraph x).seam.common.point ()
    else (sourceSegment x).eval 1 ()

/-- Exact finite evaluation matrix at times 0, 1/2, and 1, for quadratic
Bezier control coordinates. The middle row keeps its two mixed entries. -/
def sampleMatrix : Matrix (Fin 3) (Fin 3) ℝ :=
  fun i j =>
    if i = 0 then (if j = 0 then 1 else 0)
    else if i = 1 then
      (if j = 0 then 1 / 4 else if j = 1 then 1 / 2 else 1 / 4)
    else if j = 2 then 1 else 0

/-- Recovery of start/control/finish from the ordinary evaluation
samples. The central control is 2*middle - (start+finish)/2. -/
def decoderMatrix : Matrix (Fin 3) (Fin 3) ℝ :=
  fun i j =>
    if i = 0 then (if j = 0 then 1 else 0)
    else if i = 1 then
      (if j = 0 then -(1 / 2) else if j = 1 then 2 else -(1 / 2))
    else if j = 2 then 1 else 0

/-- The actual quadratic contact samples coincide with the matrix code:
this is an identity between the geometric source and its linear encoding. -/
theorem contactSamples_eq_mulVec (x : Controls) :
    contactSamples x = sampleMatrix *ᵥ x := by
  funext i
  fin_cases i <;>
    norm_num [contactSamples, sourceSegment, midpointGraph, SplitGraph.seam,
      Segment.jet, Segment.eval, sampleMatrix, Matrix.mulVec,
      Matrix.dotProduct, Fin.sum_univ_three] <;> ring

/-- Both end samples and the middle seam sample determine all controls.
This is verified as the *whole matrix product*, not only on test vectors. -/
theorem decoder_mul_sample :
    decoderMatrix * sampleMatrix = (1 : Matrix (Fin 3) (Fin 3) ℝ) := by
  ext i j
  fin_cases i <;> fin_cases j <;>
    norm_num [decoderMatrix, sampleMatrix, Matrix.mul_apply,
      Fin.sum_univ_three, Matrix.one_apply] <;> ring

/-- Decoding the actual source contact observations returns the entire
control triple, including the mixed/central coordinate. -/
theorem decode_contactSamples (x : Controls) :
    decoderMatrix *ᵥ contactSamples x = x := by
  rw [contactSamples_eq_mulVec, ← Matrix.mulVec_mulVec, decoder_mul_sample]
  exact Matrix.one_mulVec x

/-- The existing typed finite boundary-return `System`, populated from
these genuine source-sampling and source-decoding matrices. Endpoint
operators are zero because this leaf asserts no spectral dynamics. -/
def midpointSystem :
    System (Fin 3 → ℝ) (Fin 3 → ℝ) :=
  System.ofMatrices sampleMatrix decoderMatrix 0 0

/-- Its algebraic return is the actual identity reconstruction; this
states neither a boundary quotient nor an independent geometric loop. -/
theorem midpointSystem_returnOperator :
    midpointSystem.returnOperator = LinearMap.id := by
  change (decoderMatrix.mulVecLin).comp sampleMatrix.mulVecLin = LinearMap.id
  rw [← Matrix.mulVecLin_mul, decoder_mul_sample]
  exact Matrix.mulVecLin_one

/-- The same finite source reconstruction is the complex identity matrix. -/
theorem midpointSystem_complexReturnOperator :
    midpointSystem.complexReturnOperator =
      (1 : Matrix (Fin 3) (Fin 3) ℂ) := by
  rw [System.complexReturnOperator_eq_source, midpointSystem_returnOperator]
  simp

/-- The finite based-closed-walk trace of this exact reconstruction fixture
is dimension three at every length; no zeta-zero claim is made. -/
theorem midpointSystem_closedWalkMoment (n : ℕ) :
    closedWalkMoment midpointSystem.complexReturnOperator n = (3 : ℂ) := by
  rw [midpointSystem_complexReturnOperator, closedWalkMoment_eq_trace]
  simp

end GRWTSK.Analysis.Geometry.FiniteQuadraticMidpointDecoder
