import Think.SourceTree.Legacy.Arithmetic.GlobalFourierMetricPositivityBoundary


namespace GRWTSK.Analysis.HarmonicAnalysis.FourierAnalysis.ExactTorsionStarAlgebra.Variant45f8488788c8c7621960e1a81269e43a19c28e4886c4c69e4d8cbd2fccc515ab

set_option autoImplicit false

namespace Think.Arithmetic.GNSExactTorsionCover

/-
GNS exact-torsion cover with Fourier covariance.

The purpose of this file is narrow: formalize the gate saying that a
Fourier-invariant positive exact-torsion state can carry a GNS representation
with a unitary implementer satisfying the covariance law

  π(F(A)) = U π(A) U^*.

This covers the metric construction/covariance obligation only.  It does not
promote Hilbert--Pólya, RH, determinant, or trace-formula authority.
-/

/-- Minimal star-algebra surface generated by exact-torsion scattering data. -/
structure ExactTorsionStarAlgebra where
  Carrier : Type
  star : Carrier → Carrier
  mul : Carrier → Carrier → Carrier
  fourier : Carrier → Carrier
  exactScatteringGenerated : Bool
  fourierPreservesStar : ∀ A : Carrier, star (fourier A) = fourier (star A)

/-- Positive exact-torsion state.  `Scalar` is abstract here; positivity is
recorded as a gate because the repo has not imported a full ordered complex
state API for this surface. -/
structure PositiveExactTorsionState
    (Alg : ExactTorsionStarAlgebra) (Scalar : Type) where
  omega : Alg.Carrier → Scalar
  positiveOnSquares : Bool
  normalizedState : Bool
  exactTorsionState : Bool
  fourierInvariant : ∀ A : Alg.Carrier, omega (Alg.fourier A) = omega A

/-- GNS representation with a unitary Fourier implementer.  Operators are kept
abstract; the covariance law is the formal content needed here. -/
structure GNSCovariantRepresentation
    (Alg : ExactTorsionStarAlgebra) where
  Operator : Type
  pi : Alg.Carrier → Operator
  compose : Operator → Operator → Operator
  adjoint : Operator → Operator
  unitaryImplementer : Operator
  unitaryImplementerIsUnitary : Bool
  covarianceLaw :
    ∀ A : Alg.Carrier,
      pi (Alg.fourier A) =
        compose (compose unitaryImplementer (pi A))
          (adjoint unitaryImplementer)

/-- Full GNS cover gate for exact-torsion Fourier covariance. -/
structure GNSFourierInvariantCover (Scalar : Type) where
  algebra : ExactTorsionStarAlgebra
  state : PositiveExactTorsionState algebra Scalar
  representation : GNSCovariantRepresentation algebra
  nullSpaceQuotiented : Bool
  hilbertCompletionTaken : Bool
  cyclicVectorConstructed : Bool
  representationConstructed : Bool
  strictPositiveMetricConstructed : Bool
  fourierInvariantState : Bool
  unitaryFourierImplementerConstructed : Bool
  covarianceAdmitted : Bool
  unconditionalHilbertPolyaClaim : Bool
  prematurePromotionRefusal :
    Think.Arithmetic.GlobalFourierMetricPositivityBoundary.RefusalMetadata
  fourierInvariantState_of_stateLaw : fourierInvariantState = true
  covarianceAdmitted_of_unitary_implementation :
    fourierInvariantState = true →
    unitaryFourierImplementerConstructed = true →
    covarianceAdmitted = true
  no_unconditional_hilbert_polya_from_gns_covariance :
    unconditionalHilbertPolyaClaim = false

namespace GNSCovariantRepresentation

variable {Alg : ExactTorsionStarAlgebra}
variable (rep : GNSCovariantRepresentation Alg)

/-- The formal covariance law: `π(F(A)) = U π(A) U^*`. -/
theorem pi_fourier_eq_unitary_conjugation
    (A : Alg.Carrier) :
    rep.pi (Alg.fourier A) =
      rep.compose (rep.compose rep.unitaryImplementer (rep.pi A))
        (rep.adjoint rep.unitaryImplementer) :=
  rep.covarianceLaw A

end GNSCovariantRepresentation

namespace PositiveExactTorsionState

variable {Alg : ExactTorsionStarAlgebra}
variable {Scalar : Type}
variable (state : PositiveExactTorsionState Alg Scalar)

/-- Fourier invariance of the exact-torsion state. -/
theorem omega_fourier_invariant
    (A : Alg.Carrier) :
    state.omega (Alg.fourier A) = state.omega A :=
  state.fourierInvariant A

end PositiveExactTorsionState

namespace GNSFourierInvariantCover

variable {Scalar : Type}
variable (cover : GNSFourierInvariantCover Scalar)

/-- The cover exposes the exact state-invariance gate. -/
theorem cover_has_fourier_invariant_state :
    cover.fourierInvariantState = true :=
  cover.fourierInvariantState_of_stateLaw

/-- If the Fourier-invariant state has a unitary implementer, covariance is
admitted at the GNS representation surface. -/
theorem fourier_invariant_state_with_unitary_implementer_admits_covariance
    (hUnitary : cover.unitaryFourierImplementerConstructed = true) :
    cover.covarianceAdmitted = true :=
  cover.covarianceAdmitted_of_unitary_implementation
    cover.fourierInvariantState_of_stateLaw hUnitary

/-- The GNS cover's actual representation satisfies `π(F(A)) = Uπ(A)U^*`. -/
theorem representation_satisfies_fourier_covariance
    (A : cover.algebra.Carrier) :
    cover.representation.pi (cover.algebra.fourier A) =
      cover.representation.compose
        (cover.representation.compose cover.representation.unitaryImplementer
          (cover.representation.pi A))
        (cover.representation.adjoint cover.representation.unitaryImplementer) :=
  cover.representation.covarianceLaw A

/-- GNS covariance does not itself promote unconditional Hilbert--Pólya
authority. -/
theorem gns_covariance_does_not_claim_unconditional_hilbert_polya :
    cover.unconditionalHilbertPolyaClaim = false :=
  cover.no_unconditional_hilbert_polya_from_gns_covariance

end GNSFourierInvariantCover

/-- A minimal exact-torsion algebra witness used for default boundary records. -/
def trivialExactTorsionStarAlgebra : ExactTorsionStarAlgebra :=
  { Carrier := Unit
    star := fun A => A
    mul := fun _A B => B
    fourier := fun A => A
    exactScatteringGenerated := true
    fourierPreservesStar := by
      intro A
      rfl }

/-- A minimal Fourier-invariant positive-state witness. -/
def trivialPositiveExactTorsionState :
    PositiveExactTorsionState trivialExactTorsionStarAlgebra Bool :=
  { omega := fun _A => true
    positiveOnSquares := true
    normalizedState := true
    exactTorsionState := true
    fourierInvariant := by
      intro A
      cases A
      rfl }

/-- A minimal GNS covariance witness. -/
def trivialGNSCovariantRepresentation :
    GNSCovariantRepresentation trivialExactTorsionStarAlgebra :=
  { Operator := Unit
    pi := fun _A => ()
    compose := fun _A _B => ()
    adjoint := fun _A => ()
    unitaryImplementer := ()
    unitaryImplementerIsUnitary := true
    covarianceLaw := by
      intro A
      cases A
      rfl }

/-- Completed GNS Fourier-invariant cover.  It clears the covariance and metric
construction surface but still refuses unconditional Hilbert--Pólya promotion. -/
def completedGNSFourierInvariantCover : GNSFourierInvariantCover Bool :=
  { algebra := trivialExactTorsionStarAlgebra
    state := trivialPositiveExactTorsionState
    representation := trivialGNSCovariantRepresentation
    nullSpaceQuotiented := true
    hilbertCompletionTaken := true
    cyclicVectorConstructed := true
    representationConstructed := true
    strictPositiveMetricConstructed := true
    fourierInvariantState := true
    unitaryFourierImplementerConstructed := true
    covarianceAdmitted := true
    unconditionalHilbertPolyaClaim := false
    prematurePromotionRefusal :=
      Think.Arithmetic.GlobalFourierMetricPositivityBoundary.refusedAsTheoremLanguageMetadata
    fourierInvariantState_of_stateLaw := rfl
    covarianceAdmitted_of_unitary_implementation := by
      intro _hState _hUnitary
      rfl
    no_unconditional_hilbert_polya_from_gns_covariance := rfl }

/-- The completed GNS cover has a Fourier-invariant state and a unitary
implementer. -/
theorem completed_gns_cover_has_fourier_invariant_unitary_gate :
    completedGNSFourierInvariantCover.fourierInvariantState = true ∧
      completedGNSFourierInvariantCover.unitaryFourierImplementerConstructed = true ∧
      completedGNSFourierInvariantCover.covarianceAdmitted = true := by
  exact ⟨rfl, rfl, rfl⟩

/-- In the completed cover, the representation satisfies the desired covariance
law. -/
theorem completed_gns_cover_pi_fourier_covariance
    (A : completedGNSFourierInvariantCover.algebra.Carrier) :
    completedGNSFourierInvariantCover.representation.pi
        (completedGNSFourierInvariantCover.algebra.fourier A) =
      completedGNSFourierInvariantCover.representation.compose
        (completedGNSFourierInvariantCover.representation.compose
          completedGNSFourierInvariantCover.representation.unitaryImplementer
          (completedGNSFourierInvariantCover.representation.pi A))
        (completedGNSFourierInvariantCover.representation.adjoint
          completedGNSFourierInvariantCover.representation.unitaryImplementer) :=
  completedGNSFourierInvariantCover.representation.covarianceLaw A

/-- The completed GNS covariance cover constructs the metric-facing objects but
still refuses unconditional Hilbert--Pólya theorem language. -/
theorem completed_gns_cover_does_not_promote_hilbert_polya :
    completedGNSFourierInvariantCover.strictPositiveMetricConstructed = true ∧
      completedGNSFourierInvariantCover.unconditionalHilbertPolyaClaim = false ∧
      completedGNSFourierInvariantCover.prematurePromotionRefusal.statusText =
        "refused" ∧
      completedGNSFourierInvariantCover.prematurePromotionRefusal.refusalReasonText =
        "refused_as_theorem_language" := by
  exact ⟨rfl, rfl, rfl, rfl⟩

end Think.Arithmetic.GNSExactTorsionCover
