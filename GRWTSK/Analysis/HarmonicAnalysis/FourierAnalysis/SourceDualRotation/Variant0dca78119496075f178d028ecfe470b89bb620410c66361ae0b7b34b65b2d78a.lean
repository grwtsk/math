/-- The actual quarter-turn generator, in frozen order J=R∘T. -/
def quarterTurn : ComplexL2 ≃ₗᵢ[ℂ] ComplexL2 := angularSignDuality.trans reflection

/-- The defining order tracks reflection after angular sign duality. -/
theorem quarterTurn_apply (f : ComplexL2) :
    quarterTurn f = reflection (angularSignDuality f) := rfl

/-- The two anti-commuting involutions generate a negative square. -/
theorem quarterTurn_sq (f : ComplexL2) : quarterTurn (quarterTurn f) = -f := by
  simp only [quarterTurn_apply, angular_reflection_duality_anticommute,
    map_neg, angular_duality_involutive, reflection_involutive]

/-- The generator is genuinely skew-Hermitian on the actual L² space. -/
theorem quarterTurn_inner_skew (f g : ComplexL2) :
    ⟪quarterTurn f,g⟫_ℂ = -⟪f,quarterTurn g⟫_ℂ := by
  have h := quarterTurn.inner_map_map f (quarterTurn g)
  rw [quarterTurn_sq,inner_neg_right] at h
  linear_combination -h

/-- The same generator as a bounded complex-linear operator. -/
def quarterTurnCLM : ComplexL2 →L[ℂ] ComplexL2 :=
  quarterTurn.toLinearIsometry.toContinuousLinearMap

/-- The bounded adjoint equals the negative operator, without a domain premise. -/
theorem quarterTurn_adjoint : quarterTurnCLM.adjoint = -quarterTurnCLM := by
  apply ContinuousLinearMap.ext
  intro f
  apply ext_inner_right ℂ
  intro g
  rw [ContinuousLinearMap.adjoint_inner_left]
  change ⟪f,quarterTurn g⟫_ℂ = ⟪-quarterTurn f,g⟫_ℂ
  rw [inner_neg_left,quarterTurn_inner_skew,neg_neg]

/-- Reflection reverses the literal right-translation parameter. -/
theorem reflection_translation_reverse (u : ℝ) (f : ComplexL2) :
    reflection (translation u f) = translation (-u) (reflection f) := by
  apply Lp.ext
  filter_upwards [reflection_coe_ae (translation u f),
    (LinearIsometryEquiv.neg ℝ (E:=ℝ)).measurePreserving.quasiMeasurePreserving.ae
      (translation_coe_ae u f),translation_coe_ae (-u) (reflection f),
    (measurePreserving_sub_right volume (-u)).quasiMeasurePreserving.ae
      (reflection_coe_ae f)] with x h1 h2 h3 h4
  change translation u f (-x) = f (-x-u) at h2
  change reflection f (x-(-u)) = f (-(x-(-u))) at h4
  rw [h1,h2,h3,h4]
  congr 1
  ring

/-- The quarter turn reverses translation; translated planes are not asserted invariant. -/
theorem quarterTurn_translation_reverse (u : ℝ) (f : ComplexL2) :
    quarterTurn (translation u f) = translation (-u) (quarterTurn f) := by
  rw [quarterTurn_apply,← angular_translation_duality_commute,
    reflection_translation_reverse,quarterTurn_apply]

/-- Sign duality conjugates the generator to its negative. -/
theorem dual_quarterTurn_reverse (f : ComplexL2) :
    angularSignDuality (quarterTurn (angularSignDuality f)) = -quarterTurn f := by
  simp only [quarterTurn_apply,angular_duality_involutive,
    angular_reflection_duality_anticommute, neg_neg]

/-- The independent real-coefficient rotation operator cI+sJ. -/
def rotationMap (c s : ℝ) : ComplexL2 →L[ℂ] ComplexL2 :=
  (c : ℂ) • ContinuousLinearMap.id ℂ ComplexL2 + (s : ℂ) • quarterTurnCLM

/-- Exact pointwise evaluation of the bounded rotation operator. -/
theorem rotationMap_apply (c s : ℝ) (f : ComplexL2) :
    rotationMap c s f = (c : ℂ) • f + (s : ℂ) • quarterTurn f := rfl

/-- Frozen order: the second map multiplies on the left of the first map. -/
theorem rotation_comp (c₂ s₂ c₁ s₁ : ℝ) (f : ComplexL2) :
    rotationMap c₂ s₂ (rotationMap c₁ s₁ f) =
      rotationMap (c₂*c₁-s₂*s₁) (c₂*s₁+s₂*c₁) f := by
  simp only [rotationMap_apply,map_add,map_smul,quarterTurn_sq]
  push_cast
  module

/-- Unit-circle coefficients give the exact inverse cI-sJ. -/
theorem rotation_inverse (c s : ℝ) (h : c ^ 2 + s ^ 2 = 1) (f : ComplexL2) :
    rotationMap c s (rotationMap c (-s) f) = f := by
  rw [rotation_comp]
  have h1 : c*c-s*(-s)=1 := by nlinarith [h]
  have h0 : c*(-s)+s*c=0 := by ring
  rw [h1,h0]
  simp [rotationMap_apply]

/-- Real-coefficient skew-Hermitian rotation retains every Hermitian pairing. -/
theorem rotation_inner (c s : ℝ) (h : c ^ 2 + s ^ 2 = 1) (f g : ComplexL2) :
    ⟪rotationMap c s f,rotationMap c s g⟫_ℂ = ⟪f,g⟫_ℂ := by
  have hC : (c : ℂ)^2+(s : ℂ)^2=1 := by exact_mod_cast h
  calc
    _ = ((c : ℂ)^2+(s : ℂ)^2)*⟪f,g⟫_ℂ := by
      simp only [rotationMap_apply,inner_add_left,inner_add_right,inner_smul_left,
        inner_smul_right,Complex.conj_ofReal,quarterTurn.inner_map_map,
        quarterTurn_inner_skew]
      ring
    _ = _ := by rw [hC,one_mul]

/-- Norm preservation is proved from the actual Hermitian pairing identity. -/
theorem rotation_norm (c s : ℝ) (h : c ^ 2 + s ^ 2 = 1) (f : ComplexL2) :
    ‖rotationMap c s f‖ = ‖f‖ := by
  have he := congrArg Complex.re (rotation_inner c s h f f)
  rw [norm_eq_sqrt_re_inner (𝕜 := ℂ) (rotationMap c s f),
    norm_eq_sqrt_re_inner (𝕜 := ℂ) f]
  exact congrArg Real.sqrt he

/-- The exact unit-circle rotation as a linear isometry. -/
def rotationLI (c s : ℝ) (h : c ^ 2 + s ^ 2 = 1) : ComplexL2 →ₗᵢ[ℂ] ComplexL2 where
  toLinearMap := (rotationMap c s).toLinearMap
  norm_map' := rotation_norm c s h

/-- The rotation is unitary, with its explicitly proved inverse. -/
def rotation (c s : ℝ) (h : c ^ 2 + s ^ 2 = 1) : ComplexL2 ≃ₗᵢ[ℂ] ComplexL2 :=
  LinearIsometryEquiv.ofSurjective (rotationLI c s h)
    (fun f => ⟨rotationMap c (-s) f,rotation_inverse c s h f⟩)

/-- The unitary API has the same literal cI+sJ action. -/
theorem rotation_apply (c s : ℝ) (h : c ^ 2 + s ^ 2 = 1) (f : ComplexL2) :
    rotation c s h f = rotationMap c s f := rfl

/-- Sign duality reverses rotation rather than changing product order. -/
theorem dual_rotation_reverse (c s : ℝ) (f : ComplexL2) :
    angularSignDuality (rotationMap c s (angularSignDuality f)) = rotationMap c (-s) f := by
  simp only [rotationMap_apply,map_add,map_smul,angular_duality_involutive,
    dual_quarterTurn_reverse,Complex.ofReal_neg,neg_smul,smul_neg]

/-- Trigonometric unit-circle rotations on the same actual L² space. -/
def angleRotation (θ : ℝ) : ComplexL2 ≃ₗᵢ[ℂ] ComplexL2 :=
  rotation (Real.cos θ) (Real.sin θ) (Real.cos_sq_add_sin_sq θ)

/-- The angle API evaluates to the independently defined linear operator. -/
theorem angleRotation_apply (θ : ℝ) (f : ComplexL2) :
    angleRotation θ f = rotationMap (Real.cos θ) (Real.sin θ) f := rfl

/-- Angle composition uses the frozen left multiplication convention. -/
theorem angleRotation_comp (θ φ : ℝ) (f : ComplexL2) :
    angleRotation θ (angleRotation φ f) = angleRotation (θ + φ) f := by
  simp only [angleRotation_apply, rotation_comp, Real.cos_add, Real.sin_add]
  congr 2
  ring

/-- The zero-angle rotation is literally the identity. -/
theorem angleRotation_zero (f : ComplexL2) : angleRotation 0 f = f := by
  simp [angleRotation_apply, rotationMap_apply]

/-- The negative angle gives the inverse with no phase or basis change. -/
theorem angleRotation_inverse (θ : ℝ) (f : ComplexL2) :
    angleRotation θ (angleRotation (-θ) f) = f := by
  rw [angleRotation_comp, add_neg_cancel, angleRotation_zero]

/-- A quarter turn has the declared J action. -/
theorem angleRotation_pi_div_two (f : ComplexL2) :
    angleRotation (Real.pi / 2) f = quarterTurn f := by
  simp [angleRotation_apply, rotationMap_apply]

/-- Sign duality reverses a trigonometric rotation. -/
theorem dual_angleRotation_reverse (θ : ℝ) (f : ComplexL2) :
    angularSignDuality (angleRotation θ (angularSignDuality f)) = angleRotation (-θ) f := by
  simp only [angleRotation_apply, dual_rotation_reverse, Real.cos_neg, Real.sin_neg]

/-- Orthogonality of a reflection-even vector and its sign dual is exact. -/
theorem even_dual_inner_zero {q : ComplexL2} (hq : reflection q = q) :
    ⟪angularSignDuality q,q⟫_ℂ = 0 := by
  have h := reflection.inner_map_map (angularSignDuality q) q
  rw [angular_even_to_odd hq,hq,inner_neg_left] at h
  have hsum : ⟪angularSignDuality q,q⟫_ℂ + ⟪angularSignDuality q,q⟫_ℂ = 0 := by
    linear_combination -h
  exact add_self_eq_zero.mp hsum

/-- The reverse Hermitian pairing also vanishes. -/
theorem even_inner_dual_zero {q : ComplexL2} (hq : reflection q = q) :
    ⟪q,angularSignDuality q⟫_ℂ = 0 := by
  rw [← inner_conj_symm,even_dual_inner_zero hq,map_zero]

/-- On an even source J sends q to minus Tq. -/
theorem quarterTurn_even {q : ComplexL2} (hq : reflection q = q) :
    quarterTurn q = -angularSignDuality q := angular_even_to_odd hq

/-- The second source-plane axis has the opposite oriented image. -/
theorem quarterTurn_even_dual {q : ComplexL2} (hq : reflection q = q) :
    quarterTurn (angularSignDuality q) = q := by
  rw [quarterTurn_apply,angular_duality_involutive,hq]

/-- Exact coordinates in the even-source plane, without claiming finite arithmetic closure. -/
def sourcePlane (q : ComplexL2) (a b : ℂ) : ComplexL2 :=
  a • q + b • angularSignDuality q

/-- Reflection is diag(1,-1) in these source-plane coordinates. -/
theorem sourcePlane_reflection {q : ComplexL2} (hq : reflection q = q) (a b : ℂ) :
    reflection (sourcePlane q a b) = sourcePlane q a (-b) := by
  simp [sourcePlane,map_add,map_smul,hq,angular_even_to_odd hq]

/-- Sign duality exchanges the two coordinates exactly. -/
theorem sourcePlane_duality (q : ComplexL2) (a b : ℂ) :
    angularSignDuality (sourcePlane q a b) = sourcePlane q b a := by
  simp only [sourcePlane,map_add,map_smul,angular_duality_involutive]
  exact add_comm _ _

/-- J has matrix [[0,1],[-1,0]] in the oriented source-plane basis. -/
theorem sourcePlane_quarterTurn {q : ComplexL2} (hq : reflection q = q) (a b : ℂ) :
    quarterTurn (sourcePlane q a b) = sourcePlane q b (-a) := by
  simp only [sourcePlane,map_add,map_smul,quarterTurn_even hq,quarterTurn_even_dual hq]
  module

/-- Rotation acts by the exact two-coordinate real rotation matrix. -/
theorem sourcePlane_rotation {q : ComplexL2} (hq : reflection q = q)
    (c s : ℝ) (a b : ℂ) :
    rotationMap c s (sourcePlane q a b) =
      sourcePlane q ((c : ℂ)*a+(s : ℂ)*b) ((c : ℂ)*b-(s : ℂ)*a) := by
  rw [rotationMap_apply,sourcePlane_quarterTurn hq]
  simp only [sourcePlane]
  module

/-- The exact source-plane Gram matrix is the identity for a unit even vector. -/
theorem sourcePlane_inner {q : ComplexL2} (hq : reflection q = q)
    (hn : ‖q‖ ^ 2 = 1) (a b c d : ℂ) :
    ⟪sourcePlane q a b,sourcePlane q c d⟫_ℂ = star a*c+star b*d := by
  have hi : ⟪q,q⟫_ℂ = 1 := by
    rw [inner_self_eq_norm_sq_to_K]
    rw [← RCLike.ofReal_pow]
    exact congrArg RCLike.ofReal hn
  simp only [sourcePlane,inner_add_left,inner_add_right,inner_smul_left,inner_smul_right,
    even_inner_dual_zero hq,even_dual_inner_zero hq,
    angularSignDuality.inner_map_map,hi,starRingEnd_apply]
  ring

/-- A unit-even coordinate fixture has norm one but reflection readout minus one after J. -/
theorem rotation_norm_not_signed_readout {q : ComplexL2} (hq : reflection q = q)
    (hn : ‖q‖ ^ 2 = 1) :
    ‖rotationMap 0 1 q‖ ^ 2 = 1 ∧ ⟪q,reflection q⟫_ℂ = 1 ∧
      ⟪rotationMap 0 1 q,reflection (rotationMap 0 1 q)⟫_ℂ = -1 := by
  have hi : ⟪q,q⟫_ℂ = 1 := by
    rw [inner_self_eq_norm_sq_to_K]
    rw [← RCLike.ofReal_pow]
    exact congrArg RCLike.ofReal hn
  simp only [rotationMap_apply,Complex.ofReal_zero,Complex.ofReal_one,zero_smul,
    one_smul,zero_add,quarterTurn_even hq,norm_neg,map_neg,inner_neg_neg]
  refine ⟨by simpa using hn,?_,unit_even_reflected_dual hq hn⟩
  rwa [hq]

/-- The literal normalized polynomial source forces reflection-evenness of its L² class. -/
theorem actual_source_even {A : ℝ} (hA : 0 < A) (q : ComplexL2)
    (hq : q =ᵐ[volume] fun x => (normalizedTest explicitSecondDerivative A x : ℂ)) :
    reflection q = q := by
  apply Lp.ext
  filter_upwards [reflection_coe_ae q,hq,
    (LinearIsometryEquiv.neg ℝ (E := ℝ)).measurePreserving.quasiMeasurePreserving.ae hq]
      with x hr hx hn
  change q (-x) = (normalizedTest explicitSecondDerivative A (-x) : ℂ) at hn
  rw [hr,hn,hx,normalized_source_even hA]

/-- The unchanged source normalization is transported to the complex L² norm. -/
theorem actual_source_norm_sq {A : ℝ} (hA : 1 ≤ A) (q : ComplexL2)
    (hq : q =ᵐ[volume] fun x => (normalizedTest explicitSecondDerivative A x : ℂ)) :
    ‖q‖ ^ 2 = 1 := by
  have hi : ⟪q,q⟫_ℂ = 1 := by
    rw [L2.inner_def]
    calc
      _ = ∫ x : ℝ, (((normalizedTest explicitSecondDerivative A x)^2 : ℝ) : ℂ) := by
        apply integral_congr_ae
        filter_upwards [hq] with x hx
        rw [hx,RCLike.inner_apply']
        simp [pow_two]
      _ = 1 := by rw [integral_complex_ofReal,normalized_square_integral A hA,Complex.ofReal_one]
  have hr : RCLike.re ⟪q,q⟫_ℂ = 1 := congrArg Complex.re hi
  rwa [inner_self_eq_norm_sq] at hr

/-- An actual source class exists; this is a construction rather than a source premise. -/
theorem actual_source_exists {A : ℝ} (hA : 1 ≤ A) :
    ∃ q : ComplexL2,
      q =ᵐ[volume] (fun x => (normalizedTest explicitSecondDerivative A x : ℂ)) ∧
      reflection q = q ∧ ‖q‖ ^ 2 = 1 := by
  have hp : 0 < A := by linarith
  let q : ComplexL2 := Complex.ofRealCLM.compLp (forwardL2 A hp {1} (fun _ => 1))
  have hq : q =ᵐ[volume] fun x => (normalizedTest explicitSecondDerivative A x : ℂ) := by
    filter_upwards [Complex.ofRealCLM.coeFn_compLp (forwardL2 A hp {1} (fun _ => 1)),
      (forwardProfile_memLp hp {1} (fun _ => 1)).coeFn_toLp] with x hc hf
    change q x = (forwardL2 A hp {1} (fun _ => 1) x : ℂ) at hc
    rw [hc]
    change ((forwardProfile_memLp hp {1} (fun _ => 1)).toLp _ x : ℂ) = _
    rw [hf]
    simp [forwardProfile]
  exact ⟨q,hq,actual_source_even hp q hq,actual_source_norm_sq hA q hq⟩

/-- Literal source classes satisfy the oriented rotation plane and its hostile readout fixture. -/
theorem actual_source_rotation_readout {A : ℝ} (hA : 1 ≤ A) (q : ComplexL2)
    (hq : q =ᵐ[volume] fun x => (normalizedTest explicitSecondDerivative A x : ℂ)) :
    ‖rotationMap 0 1 q‖ ^ 2 = 1 ∧ ⟪q,reflection q⟫_ℂ = 1 ∧
      ⟪rotationMap 0 1 q,reflection (rotationMap 0 1 q)⟫_ℂ = -1 :=
  rotation_norm_not_signed_readout (actual_source_even (by linarith) q hq)
    (actual_source_norm_sq hA q hq)

/-- Standard Fourier orientation gives c+s·sgn for an even source; angular frequency reverses it. -/
theorem rotation_even_fourier_coe_ae {q : ComplexL2} (hq : reflection q = q)
    (c s : ℝ) :
    ((𝓕 (rotationMap c s q) : ComplexL2) : ℝ → ℂ) =ᵐ[volume]
      fun ξ => ((c : ℂ)+(s : ℂ)*signSymbol ξ)*(𝓕 q : ComplexL2) ξ := by
  rw [rotationMap_apply,quarterTurn_even hq]
  rw [FourierTransform.fourier_add,FourierTransform.fourier_smul,
    FourierTransform.fourier_smul,FourierTransform.fourier_neg]
  filter_upwards [Lp.coeFn_add ((c : ℂ) • (𝓕 q : ComplexL2))
      ((s : ℂ) • -(𝓕 (angularSignDuality q) : ComplexL2)),
    Lp.coeFn_smul (c : ℂ) (𝓕 q : ComplexL2),
    Lp.coeFn_smul (s : ℂ) (-(𝓕 (angularSignDuality q) : ComplexL2)),
    Lp.coeFn_neg (𝓕 (angularSignDuality q) : ComplexL2),
    angular_duality_fourier_coe_ae q] with ξ ha hc hs hn ht
  rw [ha]
  simp only [Pi.add_apply]
  rw [hc,hs]
  simp only [Pi.smul_apply]
  rw [hn]
  simp only [Pi.neg_apply]
  rw [ht]
  simp only [smul_eq_mul]
  ring

/-- Frequency conversion exposes the literal source-angular c-s·sgn symbol off zero. -/
theorem rotation_source_angular_symbol (c s : ℝ) {ω : ℝ} (hω : ω ≠ 0) :
    (c : ℂ)+(s : ℂ)*signSymbol (sourceAngularFrequency ω) =
      (c : ℂ)-(s : ℂ)*signSymbol ω := by
  have hs := angular_standard_symbol_to_source_sign hω
  rw [← hs]
  ring

/-- The equal-coefficient rotation kills the negative standard-frequency half exactly. -/
theorem rotation_equal_coefficient_negative_half {q : ComplexL2} (hq : reflection q = q)
    (c : ℝ) :
    ∀ᵐ ξ ∂volume, ξ < 0 → (𝓕 (rotationMap c c q) : ComplexL2) ξ = 0 := by
  filter_upwards [rotation_even_fourier_coe_ae hq c c] with ξ hξ hn
  rw [hξ,signSymbol,if_pos hn]
  ring

/-- The surviving positive standard-frequency half has the exact doubled coefficient. -/
theorem rotation_equal_coefficient_positive_half {q : ComplexL2} (hq : reflection q = q)
    (c : ℝ) :
    ∀ᵐ ξ ∂volume, 0 ≤ ξ → (𝓕 (rotationMap c c q) : ComplexL2) ξ =
      (2*(c : ℂ))*(𝓕 q : ComplexL2) ξ := by
  filter_upwards [rotation_even_fourier_coe_ae hq c c] with ξ hξ hp
  rw [hξ,signSymbol,if_neg (not_lt.mpr hp)]
  ring

/-- The adjoint of cI+sJ is cI-sJ, even away from the unit circle. -/
theorem rotationMap_adjoint (c s : ℝ) :
    (rotationMap c s).adjoint = rotationMap c (-s) := by
  apply ContinuousLinearMap.ext
  intro f
  apply ext_inner_right ℂ
  intro g
  rw [ContinuousLinearMap.adjoint_inner_left]
  have hc : (starRingEnd ℂ) (c : ℂ) = (c : ℂ) := Complex.conj_ofReal c
  have hs : (starRingEnd ℂ) (-(s : ℂ)) = -(s : ℂ) := by
    rw [map_neg]
    exact congrArg Neg.neg (Complex.conj_ofReal s)
  simp only [rotationMap_apply,inner_add_left,inner_add_right,inner_smul_left,
    inner_smul_right,hc,Complex.ofReal_neg,hs,quarterTurn_inner_skew]
  ring

/-- The explicit inverse also evaluates the equivalence inverse. -/
theorem rotation_symm_apply (c s : ℝ) (h : c ^ 2 + s ^ 2 = 1) (f : ComplexL2) :
    (rotation c s h).symm f = rotationMap c (-s) f := by
  apply (rotation c s h).injective
  rw [LinearIsometryEquiv.apply_symm_apply,rotation_apply,rotation_inverse c s h]

/-- Rotating a translated state keeps both translation directions explicitly. -/
theorem rotation_translation (c s u : ℝ) (f : ComplexL2) :
    rotationMap c s (translation u f) =
      (c : ℂ) • translation u f + (s : ℂ) • translation (-u) (quarterTurn f) := by
  rw [rotationMap_apply,quarterTurn_translation_reverse]

/-- Reflection conjugation also reverses the generator. -/
theorem reflection_quarterTurn_reverse (f : ComplexL2) :
    reflection (quarterTurn (reflection f)) = -quarterTurn f := by
  simp only [quarterTurn_apply,reflection_involutive,angular_reflection_duality_anticommute,
    map_neg,neg_neg]

/-- Reflection conjugation reverses every real-coefficient rotation. -/
theorem reflection_rotation_reverse (c s : ℝ) (f : ComplexL2) :
    reflection (rotationMap c s (reflection f)) = rotationMap c (-s) f := by
  simp only [rotationMap_apply,map_add,map_smul,reflection_involutive,
    reflection_quarterTurn_reverse,Complex.ofReal_neg,neg_smul,smul_neg]

/-- Unit-even source-plane coordinates have the literal Euclidean norm square. -/
theorem sourcePlane_norm_sq {q : ComplexL2} (hq : reflection q = q)
    (hn : ‖q‖ ^ 2 = 1) (a b : ℂ) :
    ‖sourcePlane q a b‖ ^ 2 = ‖a‖ ^ 2 + ‖b‖ ^ 2 := by
  have hi := sourcePlane_inner hq hn a b a b
  have hr : RCLike.re ⟪sourcePlane q a b,sourcePlane q a b⟫_ℂ =
      Complex.re (star a*a+star b*b) := congrArg Complex.re hi
  rw [inner_self_eq_norm_sq] at hr
  rw [hr]
  simp only [Complex.add_re,Complex.mul_re,Complex.star_def,Complex.conj_re,Complex.conj_im,
    Complex.sq_norm,Complex.normSq_apply]
  ring

/-- The source-plane reflected form retains the signed difference of sectors. -/
theorem sourcePlane_reflected_inner {q : ComplexL2} (hq : reflection q = q)
    (hn : ‖q‖ ^ 2 = 1) (a b : ℂ) :
    ⟪sourcePlane q a b,reflection (sourcePlane q a b)⟫_ℂ = star a*a-star b*b := by
  rw [sourcePlane_reflection hq,sourcePlane_inner hq hn]
  ring

/-- Evenness of the actual L² Fourier class is transported without an L¹ assertion. -/
theorem even_fourier_coe_ae {q : ComplexL2} (hq : reflection q = q) :
    ∀ᵐ ξ ∂volume, (𝓕 q : ComplexL2) (-ξ) = (𝓕 q : ComplexL2) ξ := by
  have hf : reflection (𝓕 q : ComplexL2) = (𝓕 q : ComplexL2) := by
    rw [← fourier_reflection,hq]
  filter_upwards [reflection_coe_ae (𝓕 q : ComplexL2)] with ξ hξ
  rw [hf] at hξ
  exact hξ.symm

/-- The spectrum at paired frequencies has invariant total mass under a unit-circle rotation. -/
theorem rotation_paired_fourier_mass {q : ComplexL2} (hq : reflection q = q)
    (c s : ℝ) (hu : c ^ 2 + s ^ 2 = 1) :
    ∀ᵐ ξ ∂volume, ξ ≠ 0 →
      ‖(𝓕 (rotationMap c s q) : ComplexL2) ξ‖ ^ 2 +
        ‖(𝓕 (rotationMap c s q) : ComplexL2) (-ξ)‖ ^ 2 =
      ‖(𝓕 q : ComplexL2) ξ‖ ^ 2 + ‖(𝓕 q : ComplexL2) (-ξ)‖ ^ 2 := by
  filter_upwards [rotation_even_fourier_coe_ae hq c s,
    (LinearIsometryEquiv.neg ℝ (E := ℝ)).measurePreserving.quasiMeasurePreserving.ae
      (rotation_even_fourier_coe_ae hq c s),even_fourier_coe_ae hq] with ξ hp hm he hξ
  change (𝓕 (rotationMap c s q) : ComplexL2) (-ξ) =
    ((c : ℂ)+(s : ℂ)*signSymbol (-ξ))*(𝓕 q : ComplexL2) (-ξ) at hm
  rw [hp,hm,he]
  rcases lt_or_gt_of_ne hξ with hn | hn
  · simp only [signSymbol,if_pos hn,if_neg (by linarith : ¬ -ξ < 0)]
    simp only [mul_neg,mul_one,← Complex.ofReal_neg,← Complex.ofReal_add,
      norm_mul,Complex.norm_real,Real.norm_eq_abs,mul_pow,sq_abs]
    linear_combination 2*‖(𝓕 q : ComplexL2) ξ‖ ^ 2*hu
  · simp only [signSymbol,if_neg (by linarith : ¬ ξ < 0),if_pos (by linarith : -ξ < 0)]
    simp only [mul_neg,mul_one,← Complex.ofReal_neg,← Complex.ofReal_add,
      norm_mul,Complex.norm_real,Real.norm_eq_abs,mul_pow,sq_abs]
    linear_combination 2*‖(𝓕 q : ComplexL2) ξ‖ ^ 2*hu

/-- Norm preservation and a vanished spectral half coexist at equal unit-circle coefficients. -/
theorem unit_equal_coefficient_spectral_half {q : ComplexL2} (hq : reflection q = q)
    (c : ℝ) (hc : c ^ 2 + c ^ 2 = 1) :
    ‖rotationMap c c q‖ = ‖q‖ ∧
      ∀ᵐ ξ ∂volume, ξ < 0 → (𝓕 (rotationMap c c q) : ComplexL2) ξ = 0 :=
  ⟨rotation_norm c c hc q,rotation_equal_coefficient_negative_half hq c⟩

/-- Group multiplication of actual isometries agrees with the frozen left product order. -/
theorem angleRotation_mul (θ φ : ℝ) :
    angleRotation θ * angleRotation φ = angleRotation (θ + φ) := by
  apply LinearIsometryEquiv.ext
  intro f
  exact angleRotation_comp θ φ f

/-- All members of the one common-J family commute as actual isometries. -/
theorem angleRotation_commute (θ φ : ℝ) : Commute (angleRotation θ) (angleRotation φ) := by
  change angleRotation θ * angleRotation φ = angleRotation φ * angleRotation θ
  rw [angleRotation_mul,angleRotation_mul,add_comm]

/-- The inverse group element is the negative-angle rotation. -/
theorem angleRotation_inv (θ : ℝ) : (angleRotation θ)⁻¹ = angleRotation (-θ) := by
  apply LinearIsometryEquiv.ext
  intro f
  change (rotation (Real.cos θ) (Real.sin θ) (Real.cos_sq_add_sin_sq θ)).symm f = _
  rw [rotation_symm_apply,angleRotation_apply,Real.cos_neg,Real.sin_neg]

/-- The actual angular sign involution is its own group inverse. -/
theorem angular_duality_inv : angularSignDuality⁻¹ = angularSignDuality := by
  apply LinearIsometryEquiv.ext
  intro f
  apply angularSignDuality.injective
  change angularSignDuality (angularSignDuality.symm f) =
    angularSignDuality (angularSignDuality f)
  rw [LinearIsometryEquiv.apply_symm_apply,angular_duality_involutive]

/-- The common-J family has exact sign-conjugation inverse transport in the actual group. -/
theorem angleRotation_sign_conjugation (θ : ℝ) :
    angularSignDuality * angleRotation θ * angularSignDuality⁻¹ = (angleRotation θ)⁻¹ := by
  rw [angular_duality_inv,angleRotation_inv]
  apply LinearIsometryEquiv.ext
  intro f
  exact dual_angleRotation_reverse θ f

/-- Half-turn and full-turn values record the real periodicity of the unitary family. -/
theorem angleRotation_pi (f : ComplexL2) : angleRotation Real.pi f = -f := by
  simp [angleRotation_apply,rotationMap_apply]

/-- A full turn closes at the identity on the actual L² space. -/
theorem angleRotation_two_pi (f : ComplexL2) : angleRotation (2*Real.pi) f = f := by
  simp [angleRotation_apply,rotationMap_apply]

/-- The actual angular-frequency pullback has the c-s·sgn Fourier rotation symbol. -/
theorem rotation_even_source_angular_fourier_coe_ae {q : ComplexL2}
    (hq : reflection q = q) (c s : ℝ) :
    (fun ω => (𝓕 (rotationMap c s q) : ComplexL2) (sourceAngularFrequency ω)) =ᵐ[volume]
      fun ω => ((c : ℂ)-(s : ℂ)*signSymbol ω)*
        (𝓕 q : ComplexL2) (sourceAngularFrequency ω) := by
  have hn : -(2*Real.pi)⁻¹ ≠ 0 := neg_ne_zero.mpr (inv_ne_zero (by positivity))
  have hm : Measure.QuasiMeasurePreserving sourceAngularFrequency volume volume := by
    convert Measure.quasiMeasurePreserving_smul (volume : Measure ℝ) hn using 1
    funext ω
    simp only [sourceAngularFrequency,smul_eq_mul,div_eq_mul_inv]
    ring
  have hzero : ∀ᵐ ω : ℝ ∂volume, ω ≠ 0 := by rw [ae_iff]; simp
  filter_upwards [hm.ae (rotation_even_fourier_coe_ae hq c s),hzero] with ω hω hnω
  change (𝓕 (rotationMap c s q) : ComplexL2) (sourceAngularFrequency ω) =
    ((c : ℂ)+(s : ℂ)*signSymbol (sourceAngularFrequency ω))*
      (𝓕 q : ComplexL2) (sourceAngularFrequency ω) at hω
  rw [hω,rotation_source_angular_symbol c s hnω]

end FormalResearch.RiemannHypothesis.SourceDualRotation
