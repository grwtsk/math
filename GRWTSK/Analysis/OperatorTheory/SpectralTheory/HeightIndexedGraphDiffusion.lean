import GRWTSK.Analysis.OperatorTheory.SpectralTheory.HeightIndexedGraphSpectrum
import Mathlib.Analysis.Normed.Algebra.MatrixExponential
import Mathlib.Analysis.SpecialFunctions.Exp

set_option autoImplicit false

noncomputable section

/-!
# Height-indexed graph heat diffusion

For every eligible finite graph Laplacian `L`, this module defines

`D(t) = exp (-t L)`.

The matrix exponential gives the initial-value, semigroup, symmetry, and
invertibility properties. Entrywise positivity, mass preservation, and the
exact action on every recorded eigenspace are retained as explicit
certificates. A complete height-indexed diffusion tensor requires those
certificates for every operator in its declared finite family.

Graph height is a filtration coordinate. It is not a zeta-zero ordinate or
real part. No graph inclusion is converted into spectral ordering. No Chowla
cancellation, Riemann-Hypothesis implication, or arithmetic compression
improvement is proved.

SOURCE_ONLY / NOT_RUN / NOT_KERNEL_AUDITED.
-/

universe u v

namespace GRWTSK.Analysis.OperatorTheory.SpectralTheory.HeightIndexedGraphDiffusion

open Matrix
open GRWTSK.GraphSandwichDiffusion
open GRWTSK.CombinatoricsAndDiscreteMathematics.GraphTheory.AlgebraicGraphTheory.FiniteWeightedLaplacian
open GRWTSK.Analysis.OperatorTheory.SpectralTheory.HeightIndexedGraphSpectrum

variable {Vertex : Type u} [Fintype Vertex] [DecidableEq Vertex]

/-- A nonnegative diffusion time. -/
structure DiffusionTime where
  value : ℝ
  nonnegative : 0 ≤ value

namespace DiffusionTime

/-- Initial diffusion time. -/
def zero : DiffusionTime where
  value := 0
  nonnegative := le_rfl

/-- Sum of nonnegative diffusion times. -/
def add (left right : DiffusionTime) : DiffusionTime where
  value := left.value + right.value
  nonnegative := add_nonneg left.nonnegative right.nonnegative

@[simp]
theorem zero_value : zero.value = 0 := rfl

@[simp]
theorem add_value (left right : DiffusionTime) :
    (add left right).value = left.value + right.value := rfl

end DiffusionTime

/-- Matrix heat diffusion generated by the finite graph Laplacian. -/
def diffusionMatrix
    (operator : FiniteSimpleGraphOperator Vertex)
    (time : ℝ) : Matrix Vertex Vertex ℝ :=
  NormedSpace.exp ((-time) • operator.laplacian)

/-- The scaled Laplacian in the heat exponent remains symmetric. -/
theorem scaledLaplacian_isSymm
    (operator : FiniteSimpleGraphOperator Vertex)
    (time : ℝ) :
    ((-time) • operator.laplacian).IsSymm := by
  apply Matrix.IsSymm.ext
  intro source target
  change (-time) * operator.laplacian source target =
    (-time) * operator.laplacian target source
  rw [operator.laplacian_isSymm.apply source target]

/-- Heat diffusion starts at the identity matrix. -/
@[simp]
theorem diffusionMatrix_zero
    (operator : FiniteSimpleGraphOperator Vertex) :
    diffusionMatrix operator 0 = 1 := by
  simp [diffusionMatrix]

/-- Scalar multiples of the same Laplacian commute. -/
theorem scaledLaplacians_commute
    (operator : FiniteSimpleGraphOperator Vertex)
    (left right : ℝ) :
    Commute
      ((-left) • operator.laplacian)
      ((-right) • operator.laplacian) := by
  change
    ((-left) • operator.laplacian) *
        ((-right) • operator.laplacian) =
      ((-right) • operator.laplacian) *
        ((-left) • operator.laplacian)
  simp [Matrix.smul_mul, Matrix.mul_smul, smul_smul, mul_comm]

/-- The matrix-exponential diffusion is a semigroup. -/
theorem diffusionMatrix_add
    (operator : FiniteSimpleGraphOperator Vertex)
    (left right : ℝ) :
    diffusionMatrix operator (left + right) =
      diffusionMatrix operator left * diffusionMatrix operator right := by
  unfold diffusionMatrix
  have exponent_add :
      (-(left + right)) • operator.laplacian =
        (-left) • operator.laplacian +
          (-right) • operator.laplacian := by
    ext source target
    change
      (-(left + right)) * operator.laplacian source target =
        (-left) * operator.laplacian source target +
          (-right) * operator.laplacian source target
    ring
  rw [exponent_add]
  exact Matrix.exp_add_of_commute _ _
    (scaledLaplacians_commute operator left right)

/-- Diffusion of a symmetric graph Laplacian is symmetric. -/
theorem diffusionMatrix_isSymm
    (operator : FiniteSimpleGraphOperator Vertex)
    (time : ℝ) :
    (diffusionMatrix operator time).IsSymm := by
  exact (scaledLaplacian_isSymm operator time).exp

/-- Every finite-time diffusion matrix is invertible. -/
theorem diffusionMatrix_isUnit
    (operator : FiniteSimpleGraphOperator Vertex)
    (time : ℝ) :
    IsUnit (diffusionMatrix operator time) := by
  exact Matrix.isUnit_exp ((-time) • operator.laplacian)

/-- Scalar attenuation attached to a nonnegative diffusion time and one
spectral value. -/
def spectralAttenuation
    (time : DiffusionTime) (eigenvalue : ℝ) : ℝ :=
  Real.exp (-(time.value * eigenvalue))

/-- Every scalar heat attenuation is strictly positive. -/
theorem spectralAttenuation_pos
    (time : DiffusionTime) (eigenvalue : ℝ) :
    0 < spectralAttenuation time eigenvalue := by
  exact Real.exp_pos _

/-- A nonnegative Laplacian eigenvalue has attenuation at most one at
nonnegative time. -/
theorem spectralAttenuation_le_one
    (time : DiffusionTime) {eigenvalue : ℝ}
    (eigenvalue_nonnegative : 0 ≤ eigenvalue) :
    spectralAttenuation time eigenvalue ≤ 1 := by
  rw [spectralAttenuation, Real.exp_le_one_iff]
  exact neg_nonpos.mpr
    (mul_nonneg time.nonnegative eigenvalue_nonnegative)

/-- Markov properties are explicit proof obligations. Matrix-exponential
semigroup identities alone do not establish entrywise positivity. -/
structure MarkovHeatCertificate
    (operator : FiniteSimpleGraphOperator Vertex) where
  entrywiseNonnegative :
    ∀ time : DiffusionTime, ∀ source target : Vertex,
      0 ≤ diffusionMatrix operator time.value source target
  rowSumOne :
    ∀ time : DiffusionTime, ∀ source : Vertex,
      (∑ target : Vertex,
        diffusionMatrix operator time.value source target) = 1

/-- Exact spectral action of the heat matrix on one recorded eigenspace. The
nonnegativity field supports the scalar attenuation bound. -/
structure SpectralDiffusionCertificate
    {operator : FiniteSimpleGraphOperator Vertex}
    (atom : SpectralAtom operator) where
  eigenvalueNonnegative : 0 ≤ atom.eigenvalue
  actsOnEigenspace :
    ∀ time : DiffusionTime, ∀ x : Vertex → ℝ,
      x ∈ atom.eigenspace →
        (diffusionMatrix operator time.value).mulVec x =
          spectralAttenuation time atom.eigenvalue • x

/-- One independent row of the height-indexed diffusion tensor. -/
structure DiffusionObservation where
  coordinate : OperatorCoordinate
  time : ℝ
  time_nonnegative : 0 ≤ time
  eigenvalue : ℝ
  algebraicMultiplicity : ℕ
  geometricMultiplicity : ℕ
  attenuation : ℝ
  provenance : List SourceIdentity

/-- Convert one spectral atom at one nonnegative time into an independent
height/layer/operator/spectral/provenance observation. -/
def SpectralAtom.toDiffusionObservation
    {operator : FiniteSimpleGraphOperator Vertex}
    (atom : SpectralAtom operator)
    (time : DiffusionTime) : DiffusionObservation where
  coordinate := operator.coordinate
  time := time.value
  time_nonnegative := time.nonnegative
  eigenvalue := atom.eigenvalue
  algebraicMultiplicity := atom.algebraicMultiplicity
  geometricMultiplicity := atom.geometricMultiplicity
  attenuation := spectralAttenuation time atom.eigenvalue
  provenance := operator.provenance

/-- A complete finite diffusion tensor. It contains one complete finite
spectrum for each declared operator, a Markov certificate for every heat
matrix, and the exact exponential action on every recorded eigenspace. -/
structure HeightIndexedDiffusionTensor
    (Index : Type v) (Vertex : Type u)
    [Fintype Index] [Fintype Vertex] [DecidableEq Vertex] where
  spectral : HeightIndexedSpectrumTensor Index Vertex
  markov : (index : Index) →
    MarkovHeatCertificate (spectral.operators.operator index)
  spectralAction :
    (index : Index) →
      (atom : SpectralAtom (spectral.operators.operator index)) →
        atom ∈ (spectral.spectrum index).atoms →
          SpectralDiffusionCertificate atom

namespace HeightIndexedDiffusionTensor

/-- Diffusion observations at one finite operator coordinate and time. -/
def observationsAt
    {Index : Type v} [Fintype Index]
    (tensor : HeightIndexedDiffusionTensor Index Vertex)
    (index : Index) (time : DiffusionTime) :
    List DiffusionObservation :=
  (tensor.spectral.spectrum index).atoms.map
    (fun atom => atom.toDiffusionObservation time)

/-- Every selected operator has an identity initial condition. -/
theorem initial
    {Index : Type v} [Fintype Index]
    (tensor : HeightIndexedDiffusionTensor Index Vertex)
    (index : Index) :
    diffusionMatrix (tensor.spectral.operators.operator index) 0 = 1 :=
  diffusionMatrix_zero _

/-- Every selected operator satisfies the heat semigroup law. -/
theorem semigroup
    {Index : Type v} [Fintype Index]
    (tensor : HeightIndexedDiffusionTensor Index Vertex)
    (index : Index) (left right : ℝ) :
    diffusionMatrix
        (tensor.spectral.operators.operator index) (left + right) =
      diffusionMatrix
          (tensor.spectral.operators.operator index) left *
        diffusionMatrix
          (tensor.spectral.operators.operator index) right :=
  diffusionMatrix_add _ left right

/-- Every selected heat matrix is symmetric. -/
theorem symmetric
    {Index : Type v} [Fintype Index]
    (tensor : HeightIndexedDiffusionTensor Index Vertex)
    (index : Index) (time : ℝ) :
    (diffusionMatrix
      (tensor.spectral.operators.operator index) time).IsSymm :=
  diffusionMatrix_isSymm _ time

/-- Every selected heat matrix is invertible. -/
theorem invertible
    {Index : Type v} [Fintype Index]
    (tensor : HeightIndexedDiffusionTensor Index Vertex)
    (index : Index) (time : ℝ) :
    IsUnit
      (diffusionMatrix
        (tensor.spectral.operators.operator index) time) :=
  diffusionMatrix_isUnit _ time

/-- Entrywise nonnegativity is available only through the supplied Markov
certificate. -/
theorem entrywise_nonnegative
    {Index : Type v} [Fintype Index]
    (tensor : HeightIndexedDiffusionTensor Index Vertex)
    (index : Index) (time : DiffusionTime)
    (source target : Vertex) :
    0 ≤ diffusionMatrix
      (tensor.spectral.operators.operator index)
      time.value source target :=
  (tensor.markov index).entrywiseNonnegative time source target

/-- Row normalization is available only through the supplied Markov
certificate. -/
theorem row_sum_one
    {Index : Type v} [Fintype Index]
    (tensor : HeightIndexedDiffusionTensor Index Vertex)
    (index : Index) (time : DiffusionTime)
    (source : Vertex) :
    (∑ target : Vertex,
      diffusionMatrix
        (tensor.spectral.operators.operator index)
        time.value source target) = 1 :=
  (tensor.markov index).rowSumOne time source

/-- Exact heat action on one recorded eigenspace. -/
theorem acts_on_eigenspace
    {Index : Type v} [Fintype Index]
    (tensor : HeightIndexedDiffusionTensor Index Vertex)
    (index : Index)
    (atom : SpectralAtom (tensor.spectral.operators.operator index))
    (member : atom ∈ (tensor.spectral.spectrum index).atoms)
    (time : DiffusionTime) (x : Vertex → ℝ)
    (x_mem : x ∈ atom.eigenspace) :
    (diffusionMatrix
      (tensor.spectral.operators.operator index)
      time.value).mulVec x =
        spectralAttenuation time atom.eigenvalue • x :=
  (tensor.spectralAction index atom member).actsOnEigenspace
    time x x_mem

/-- Every observation row retains its graph height, sandwich layer, and
operator identity. -/
theorem observation_coordinate
    {Index : Type v} [Fintype Index]
    (tensor : HeightIndexedDiffusionTensor Index Vertex)
    (index : Index) (time : DiffusionTime)
    {observation : DiffusionObservation}
    (member : observation ∈ tensor.observationsAt index time) :
    observation.coordinate =
      (tensor.spectral.operators.operator index).coordinate := by
  unfold observationsAt at member
  rcases List.mem_map.1 member with ⟨atom, _, rfl⟩
  rfl

/-- Every recorded diffusion mode has positive attenuation. -/
theorem observation_attenuation_pos
    {Index : Type v} [Fintype Index]
    (tensor : HeightIndexedDiffusionTensor Index Vertex)
    (index : Index) (time : DiffusionTime)
    {observation : DiffusionObservation}
    (member : observation ∈ tensor.observationsAt index time) :
    0 < observation.attenuation := by
  unfold observationsAt at member
  rcases List.mem_map.1 member with ⟨atom, _, rfl⟩
  exact spectralAttenuation_pos time atom.eigenvalue

end HeightIndexedDiffusionTensor

end GRWTSK.Analysis.OperatorTheory.SpectralTheory.HeightIndexedGraphDiffusion
