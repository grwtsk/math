variable (X : Over (Spec ↧ℂ)) [IsIntegral X.left] [Smooth X.hom]
  [OAI.AlgebraicGeometry.Foundations.ProjectiveSpaceIs.IsProjective X.hom]
  [GrpObj X] [FiniteDimensional ℚ (OriginalBetti X 0)]
variable (d : ℕ) [NeZero d]

local notation "V" =>
  OAI.AlgebraicGeometry.ComplexMultiplication.BundledAbelianBridge.originalIntegralProjectiveVariety X

/-- The literal two source factors used in the previous rank-two candidate.
The optional real coupling κ is NOT inferred from the original arithmetic. -/
abbrev actualGeometricVector : CommonHilbert d := sourceCMUnit X d
abbrev actualArithmeticVector (j : ℕ) : LabelledState j := sourceArithmeticUnit j

/-- An explicit self-adjoint bounded interaction Hamiltonian in the chosen
joint Hilbert metric; it is not claimed to be the physical system's H. -/
def actualInteractionHamiltonian (j : ℕ) :
    selfAdjoint (ActualJoint d j →L[ℂ] ActualJoint d j) :=
  sourceSelfAdjoint (actualGeometricVector X d) (actualArithmeticVector j)

/-- The actual source Hamiltonian is exactly the two ORIGINAL cross-channel
rank-one maps, not a new, freely selected wave operator. -/
theorem actualInteractionHamiltonian_source (j : ℕ) :
    (actualInteractionHamiltonian X d j : ActualJoint d j →L[ℂ] ActualJoint d j) =
      cmToArithmetic (actualGeometricVector X d) (actualArithmeticVector j) +
        arithmeticToCM (actualGeometricVector X d) (actualArithmeticVector j) := rfl

/-- The true geometric full-cycle nonzero theorem and the literal mu(1)
latent coefficient give norm ONE for BOTH directional Hamiltonian blocks. -/
theorem actualHamiltonian_both_channel_norm_one
    [PathConnectedSpace V.analyticSpace] (j : ℕ) :
    ‖cmToArithmetic (actualGeometricVector X d) (actualArithmeticVector j)‖ = 1 ∧
      ‖arithmeticToCM (actualGeometricVector X d) (actualArithmeticVector j)‖ = 1 := by
  constructor
  · rw [cmToArithmetic_norm, sourceCMUnit_norm X d, sourceArithmeticUnit_norm j]
    ring
  · rw [arithmeticToCM_norm, sourceCMUnit_norm X d, sourceArithmeticUnit_norm j]
    ring

/-- The interaction unitary is the exponential of the ACTUAL source-built
self-adjoint operator with an EXPLICIT free real coupling strength κ. -/
def actualInteractionUnitary (j : ℕ) (κ s t : ℝ) :
    unitary (ActualJoint d j →L[ℂ] ActualJoint d j) :=
  sourceUnitaryTwoTime (actualGeometricVector X d) (actualArithmeticVector j) κ s t

/-- The unitary as a bounded complex-linear map, including all orthogonal
CM and arithmetic residual directions. -/
def actualInteractionCLM (j : ℕ) (κ s t : ℝ) :
    ActualJoint d j →L[ℂ] ActualJoint d j :=
  sourceUnitaryCLM (actualGeometricVector X d) (actualArithmeticVector j) κ s t

theorem actualInteractionCLM_self (j : ℕ) (κ s : ℝ) :
    actualInteractionCLM X d j κ s s =
      ContinuousLinearMap.id ℂ (ActualJoint d j) :=
  sourceUnitaryCLM_self _ _ κ s

theorem actualInteractionCLM_comp (j : ℕ) (κ s t u : ℝ) :
    (actualInteractionCLM X d j κ t u).comp
        (actualInteractionCLM X d j κ s t) =
      actualInteractionCLM X d j κ s u :=
  sourceUnitaryCLM_comp _ _ κ s t u

theorem actualInteractionCLM_norm (j : ℕ) (κ s t : ℝ)
    (z : ActualJoint d j) :
    ‖actualInteractionCLM X d j κ s t z‖ = ‖z‖ :=
  sourceUnitaryCLM_norm_map _ _ κ s t z

/-- A genuine bounded frame from the original source-causal transport
and the new UNITARY CM/arithmetic interaction. -/
def actualUnitaryCausalFrame (j : ℕ) (κ t : ℝ) :
    ActualJoint d j →L[ℂ] ActualJoint d j :=
  (exactLabelledJointEvolution d j 0 t).comp
    (actualInteractionCLM X d j κ 0 t)

/-- The two factors are both invertible at all real times, even at source
birth thresholds when the OBSERVED packet may vanish. -/
def actualUnitaryCausalFrameInverse (j : ℕ) (κ t : ℝ) :
    ActualJoint d j →L[ℂ] ActualJoint d j :=
  (actualInteractionCLM X d j κ t 0).comp
    (exactLabelledJointEvolution d j t 0)

theorem actualUnitaryFrame_inverse_left (j : ℕ) (κ t : ℝ) :
    (actualUnitaryCausalFrameInverse X d j κ t).comp
      (actualUnitaryCausalFrame X d j κ t) =
      ContinuousLinearMap.id ℂ (ActualJoint d j) := by
  apply ContinuousLinearMap.ext
  intro z
  change actualInteractionCLM X d j κ t 0
      (exactLabelledJointEvolution d j t 0
        (exactLabelledJointEvolution d j 0 t
          (actualInteractionCLM X d j κ 0 t z))) = z
  have he := congrArg
    (fun T : ActualJoint d j →L[ℂ] ActualJoint d j =>
      T (actualInteractionCLM X d j κ 0 t z))
    (exactLabelledJointEvolution_inverse d j 0 t)
  rw [ContinuousLinearMap.comp_apply, ContinuousLinearMap.id_apply] at he
  rw [he]
  have hp := congrArg
    (fun T : ActualJoint d j →L[ℂ] ActualJoint d j => T z)
    (actualInteractionCLM_comp X d j κ 0 t 0)
  rw [ContinuousLinearMap.comp_apply, actualInteractionCLM_self,
    ContinuousLinearMap.id_apply] at hp
  exact hp

theorem actualUnitaryFrame_inverse_right (j : ℕ) (κ t : ℝ) :
    (actualUnitaryCausalFrame X d j κ t).comp
      (actualUnitaryCausalFrameInverse X d j κ t) =
      ContinuousLinearMap.id ℂ (ActualJoint d j) := by
  apply ContinuousLinearMap.ext
  intro z
  change exactLabelledJointEvolution d j 0 t
      (actualInteractionCLM X d j κ 0 t
        (actualInteractionCLM X d j κ t 0
          (exactLabelledJointEvolution d j t 0 z))) = z
  have hp := congrArg
    (fun T : ActualJoint d j →L[ℂ] ActualJoint d j =>
      T (exactLabelledJointEvolution d j t 0 z))
    (actualInteractionCLM_comp X d j κ t 0 t)
  rw [ContinuousLinearMap.comp_apply, actualInteractionCLM_self,
    ContinuousLinearMap.id_apply] at hp
  rw [hp]
  have he := congrArg
    (fun T : ActualJoint d j →L[ℂ] ActualJoint d j => T z)
    (exactLabelledJointEvolution_inverse d j t 0)
  simpa only [ContinuousLinearMap.comp_apply,
    ContinuousLinearMap.id_apply] using he

/-- The source-derived, time-composing coupled operator; it is a genuine
bounded two-time cocycle but NOT automatically a physically calibrated flow. -/
def actualUnitaryCoupledTwoTime (j : ℕ) (κ s t : ℝ) :
    ActualJoint d j →L[ℂ] ActualJoint d j :=
  (actualUnitaryCausalFrame X d j κ t).comp
    (actualUnitaryCausalFrameInverse X d j κ s)

@[simp] theorem actualUnitaryCoupledTwoTime_self (j : ℕ) (κ s : ℝ) :
    actualUnitaryCoupledTwoTime X d j κ s s =
      ContinuousLinearMap.id ℂ (ActualJoint d j) :=
  actualUnitaryFrame_inverse_right X d j κ s

/-- Exact time composition on the WHOLE Hilbert carrier, including both
CM residual and arithmetic original integer labels, for every κ. -/
theorem actualUnitaryCoupledTwoTime_comp (j : ℕ) (κ s t u : ℝ) :
    (actualUnitaryCoupledTwoTime X d j κ t u).comp
        (actualUnitaryCoupledTwoTime X d j κ s t) =
      actualUnitaryCoupledTwoTime X d j κ s u := by
  apply ContinuousLinearMap.ext
  intro z
  change actualUnitaryCausalFrame X d j κ u
      (actualUnitaryCausalFrameInverse X d j κ t
        (actualUnitaryCausalFrame X d j κ t
          (actualUnitaryCausalFrameInverse X d j κ s z))) = _
  have hi := congrArg
    (fun T : ActualJoint d j →L[ℂ] ActualJoint d j =>
      T (actualUnitaryCausalFrameInverse X d j κ s z))
    (actualUnitaryFrame_inverse_left X d j κ t)
  rw [ContinuousLinearMap.comp_apply, ContinuousLinearMap.id_apply] at hi
  rw [hi]
  rfl

/-- The source-causal/time-unitary factorization makes the arithmetic
response and conservative rank-two interaction independently inspectable.
This identity is stronger than merely naming an arbitrary invertible frame. -/
theorem actualUnitaryCoupled_factor (j : ℕ) (κ s t : ℝ) :
    actualUnitaryCoupledTwoTime X d j κ s t =
      (exactLabelledJointEvolution d j 0 t).comp
        ((actualInteractionCLM X d j κ s t).comp
          (exactLabelledJointEvolution d j s 0)) := by
  apply ContinuousLinearMap.ext
  intro z
  change exactLabelledJointEvolution d j 0 t
      (actualInteractionCLM X d j κ 0 t
        (actualInteractionCLM X d j κ s 0
          (exactLabelledJointEvolution d j s 0 z))) =
    exactLabelledJointEvolution d j 0 t
      (actualInteractionCLM X d j κ s t
        (exactLabelledJointEvolution d j s 0 z))
  have h := congrArg
    (fun T : ActualJoint d j →L[ℂ] ActualJoint d j =>
      T (exactLabelledJointEvolution d j s 0 z))
    (actualInteractionCLM_comp X d j κ s 0 t)
  rw [ContinuousLinearMap.comp_apply] at h
  rw [h]

/-- The reversed two-time operator is the exact inverse; source births
never require division by a zero response. -/
theorem actualUnitaryCoupledTwoTime_inverse (j : ℕ) (κ s t : ℝ) :
    (actualUnitaryCoupledTwoTime X d j κ t s).comp
        (actualUnitaryCoupledTwoTime X d j κ s t) =
      ContinuousLinearMap.id ℂ (ActualJoint d j) := by
  rw [actualUnitaryCoupledTwoTime_comp, actualUnitaryCoupledTwoTime_self]

/-- The unitary interaction itself has NO time-growth in operator norm. -/
theorem actualInteraction_opNorm_le_one (j : ℕ) (κ s t : ℝ) :
    ‖actualInteractionCLM X d j κ s t‖ ≤ 1 :=
  sourceUnitaryCLM_opNorm_le_one _ _ κ s t

/-- Quantitative improvement over the previous polynomial shear coupling:
for every κ and EVERY nonnegative pair of times, including arbitrary long
time intervals, the coupled operator has norm ≤25, independent of j. -/
theorem actualUnitaryCoupled_opNorm_le_twentyfive
    (j : ℕ) (κ s t : ℝ) (hs : 0 ≤ s) (ht : 0 ≤ t) :
    ‖actualUnitaryCoupledTwoTime X d j κ s t‖ ≤ 25 := by
  rw [actualUnitaryCoupled_factor]
  calc
    _ ≤ ‖exactLabelledJointEvolution d j 0 t‖ *
        ‖(actualInteractionCLM X d j κ s t).comp
            (exactLabelledJointEvolution d j s 0)‖ :=
      ContinuousLinearMap.opNorm_comp_le _ _
    _ ≤ ‖exactLabelledJointEvolution d j 0 t‖ *
        (‖actualInteractionCLM X d j κ s t‖ *
          ‖exactLabelledJointEvolution d j s 0‖) :=
      mul_le_mul_of_nonneg_left (ContinuousLinearMap.opNorm_comp_le _ _)
        (norm_nonneg _)
    _ ≤ 5 * (1 * 5) := by
      gcongr
      · exact exactLabelledJointEvolution_opNorm_le_five d j (by norm_num) ht
      · exact actualInteraction_opNorm_le_one X d j κ s t
      · exact exactLabelledJointEvolution_opNorm_le_five d j hs (by norm_num)
    _ = 25 := by norm_num

/-- Actual CM algebraic and residual projectors remain genuine
orthogonal contractions in the full joint Hilbert metric. -/
theorem actualUnitary_jointP_opNorm_le_one (j : ℕ) :
    ‖jointP d X 0 j‖ ≤ 1 := by
  apply ContinuousLinearMap.opNorm_le_bound _ (by norm_num)
  intro z
  simpa only [one_mul] using jointP_norm_le X d j z

theorem actualUnitary_jointQ_opNorm_le_one (j : ℕ) :
    ‖jointQ d X 0 j‖ ≤ 1 := by
  apply ContinuousLinearMap.opNorm_le_bound _ (by norm_num)
  intro z
  simpa only [one_mul] using jointQ_norm_le X d j z

/-- Both true compressed defects retain a UNIFORM norm budget, with no
unproved claim that they vanish. The full source-pinned Hamiltonian has
norm-one directed cross blocks under the geometric nonvanishing premise. -/
theorem actualUnitary_QUP_opNorm_le_twentyfive
    (j : ℕ) (κ s t : ℝ) (hs : 0 ≤ s) (ht : 0 ≤ t) :
    ‖(jointQ d X 0 j).comp
        ((actualUnitaryCoupledTwoTime X d j κ s t).comp (jointP d X 0 j))‖ ≤ 25 := by
  calc
    _ ≤ ‖jointQ d X 0 j‖ *
        ‖(actualUnitaryCoupledTwoTime X d j κ s t).comp (jointP d X 0 j)‖ :=
      ContinuousLinearMap.opNorm_comp_le _ _
    _ ≤ ‖jointQ d X 0 j‖ *
        (‖actualUnitaryCoupledTwoTime X d j κ s t‖ * ‖jointP d X 0 j‖) :=
      mul_le_mul_of_nonneg_left (ContinuousLinearMap.opNorm_comp_le _ _)
        (norm_nonneg _)
    _ ≤ 1 * (25 * 1) := by
      gcongr
      · exact actualUnitary_jointQ_opNorm_le_one X d j
      · exact actualUnitaryCoupled_opNorm_le_twentyfive X d j κ s t hs ht
      · exact actualUnitary_jointP_opNorm_le_one X d j
    _ = 25 := by norm_num

theorem actualUnitary_PUQ_opNorm_le_twentyfive
    (j : ℕ) (κ s t : ℝ) (hs : 0 ≤ s) (ht : 0 ≤ t) :
    ‖(jointP d X 0 j).comp
        ((actualUnitaryCoupledTwoTime X d j κ s t).comp (jointQ d X 0 j))‖ ≤ 25 := by
  calc
    _ ≤ ‖jointP d X 0 j‖ *
        ‖(actualUnitaryCoupledTwoTime X d j κ s t).comp (jointQ d X 0 j)‖ :=
      ContinuousLinearMap.opNorm_comp_le _ _
    _ ≤ ‖jointP d X 0 j‖ *
        (‖actualUnitaryCoupledTwoTime X d j κ s t‖ * ‖jointQ d X 0 j‖) :=
      mul_le_mul_of_nonneg_left (ContinuousLinearMap.opNorm_comp_le _ _)
        (norm_nonneg _)
    _ ≤ 1 * (25 * 1) := by
      gcongr
      · exact actualUnitary_jointP_opNorm_le_one X d j
      · exact actualUnitaryCoupled_opNorm_le_twentyfive X d j κ s t hs ht
      · exact actualUnitary_jointQ_opNorm_le_one X d j
    _ = 25 := by norm_num

/-- A zero interaction strength reduces EXACTLY to the previously source-
verified decoupled causal transport; no artificial coupling remains. -/
theorem actualUnitaryCoupled_zero_strength
    (j : ℕ) (s t : ℝ) :
    actualUnitaryCoupledTwoTime X d j 0 s t =
      exactLabelledJointEvolution d j s t := by
  have hp : actualInteractionCLM X d j 0 s t =
      ContinuousLinearMap.id ℂ (ActualJoint d j) := by
    simp [actualInteractionCLM, sourceUnitaryCLM,
      sourceUnitaryTwoTime, sourceUnitary]
  rw [actualUnitaryCoupled_factor]
  apply ContinuousLinearMap.ext
  intro z
  change exactLabelledJointEvolution d j 0 t
      (actualInteractionCLM X d j 0 s t
        (exactLabelledJointEvolution d j s 0 z)) =
      exactLabelledJointEvolution d j s t z
  rw [hp, ContinuousLinearMap.id_apply]
  have he := congrArg
    (fun T : ActualJoint d j →L[ℂ] ActualJoint d j => T z)
    (exactLabelledJointEvolution_comp d j s 0 t)
  simpa only [ContinuousLinearMap.comp_apply] using he

/-- Exact signed observation AFTER unitary interaction and source-labelled
causal transport. Original finite coherent sums are still SIGNED. -/
def actualUnitaryCoupledReadout (j : ℕ) (κ s t : ℝ)
    (z : ActualJoint d j) : ℂ :=
  originalReadout j
    ((actualUnitaryCoupledTwoTime X d j κ s t z).snd.snd)

/-- No invented preservation assertion: this is the COMPLETE difference
from the actual uncoupled Mobius signed readout. -/
def actualUnitaryReadoutDefect (j : ℕ) (κ s t : ℝ)
    (z : ActualJoint d j) : ℂ :=
  actualUnitaryCoupledReadout X d j κ s t z -
    originalReadout j ((exactLabelledJointEvolution d j s t z).snd.snd)

theorem actualUnitaryReadout_exact_return (j : ℕ) (κ s t : ℝ)
    (z : ActualJoint d j) :
    actualUnitaryCoupledReadout X d j κ s t z =
      originalReadout j ((exactLabelledJointEvolution d j s t z).snd.snd) +
      actualUnitaryReadoutDefect X d j κ s t z := by
  unfold actualUnitaryReadoutDefect
  abel

/-- On the original closed dyadic window, the complete coupled observed
real signal is the original wholePickup PLUS the retained signed residual. -/
theorem actualUnitary_sourceWholePickup_return (j : ℕ) (κ : ℝ)
    {t : ℝ} (ht0 : 0 ≤ t) (htT : t ≤ dyadicTime j) :
    actualUnitaryCoupledReadout X d j κ 0 t (originalJointPair d j 0) =
      (wholePickup t : ℂ) +
      actualUnitaryReadoutDefect X d j κ 0 t (originalJointPair d j 0) := by
  rw [actualUnitaryReadout_exact_return,
    uncoupled_original_readout d j t]
  have h := (wholePickup_eq_completeWave j d ht0 htT).trans
    (completeWave_eq_originalFixedWave j d t)
  rw [h]

/-- The real coherent square contains the signed interaction cross term.
The Hilbert norm of the output is NOT substituted for the pickup energy. -/
theorem actualUnitary_sourceWholePickup_square (j : ℕ) (κ : ℝ)
    {t : ℝ} (ht0 : 0 ≤ t) (htT : t ≤ dyadicTime j) :
    (actualUnitaryCoupledReadout X d j κ 0 t
      (originalJointPair d j 0)).re ^ 2 =
        wholePickup t ^ 2 +
        2 * wholePickup t *
          (actualUnitaryReadoutDefect X d j κ 0 t
            (originalJointPair d j 0)).re +
        (actualUnitaryReadoutDefect X d j κ 0 t
          (originalJointPair d j 0)).re ^ 2 := by
  rw [actualUnitary_sourceWholePickup_return X d j κ ht0 htT,
    Complex.add_re, Complex.ofReal_re]
  ring

/-- Carry the WHOLE signed source correction through the original physical
interval integral; no independent integrability claim is introduced. -/
theorem actualUnitary_sourceWholePickup_integrand_return (j : ℕ) (κ : ℝ) :
    (∫ t in (0 : ℝ)..dyadicTime j,
      (actualUnitaryCoupledReadout X d j κ 0 t
        (originalJointPair d j 0)).re ^ 2) =
    (∫ t in (0 : ℝ)..dyadicTime j,
      wholePickup t ^ 2 +
        2 * wholePickup t *
          (actualUnitaryReadoutDefect X d j κ 0 t
            (originalJointPair d j 0)).re +
        (actualUnitaryReadoutDefect X d j κ 0 t
          (originalJointPair d j 0)).re ^ 2) := by
  apply intervalIntegral.integral_congr
  intro t ht
  exact actualUnitary_sourceWholePickup_square X d j κ ht.1 ht.2

end GRWTSK.Analysis.HarmonicAnalysis.ResidueCircleWaveHilbert.CMActualUnitaryCausalInteraction
