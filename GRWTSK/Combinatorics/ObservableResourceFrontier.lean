import GRWTSK.Combinatorics.ExactResourceReplacement

/-!
# Finite resource frontiers for exact observables

Consumers: outcome-preserving execution replacement in Sofic and Noe, and
contraction planning indexed by an exact mathematical result.

Restrict the existing `ExecutionModel.valid` predicate to the claimed outcome.
Costs and deductive content retain their existing definitions. Dickson's lemma
then gives a finite exact frontier for the outcome. Inclusion of the upward
regions is precisely domination of every incumbent minimum by a replacement
minimum. For strict inclusion, shrink a replacement-only budget to a replacement
minimum. If any incumbent minimum lay below it, upward closure would put the
original budget in the incumbent region. Conversely, any replacement minimum
with no incumbent minimum below it belongs to the region difference.

For an execution model offering two results at costs 0 and 2, an optimization
that lowers the second cost to 1 preserves the aggregate upward region
generated by 0. It strictly enlarges the second result's upward region.

SOURCE_PROOF_CANDIDATE. Qualify checks against the exact source revision.
-/

set_option autoImplicit false

namespace GRWTSK.ResourceAttainability

universe u v w x

variable {State : Type u} {Claim : Type v} {Outcome : Type x}

/-- Fix an outcome by restricting validity, while retaining witness types,
costs and deductive content. -/
def restrictObservable (A : ExecutionModel.{u,v,w} State Claim)
    (observe : State → Mode → Claim → A.Witness → Outcome) (result : Outcome) :
    ExecutionModel.{u,v,w} State Claim where
  Witness := A.Witness
  derives := A.derives
  valid I mode p e := A.valid I mode p e ∧ observe I mode p e = result
  cost := A.cost
  sound I mode p e h := A.sound I mode p e h.1

theorem attainable_restrictObservable_iff (A : ExecutionModel.{u,v,w} State Claim)
    (observe : State → Mode → Claim → A.Witness → Outcome) (result : Outcome)
    (I : State) (mode : Mode) (p : Claim) (budget : ResourceVec) :
    Attainable (restrictObservable A observe result) I mode budget p ↔
      budget ∈ observableCostRegion A observe I mode p result := by
  constructor
  · rintro ⟨e, hValid, hCost⟩
    exact ⟨e, hValid.1, hValid.2, hCost⟩
  · rintro ⟨e, hValid, hSame, hCost⟩
    exact ⟨e, ⟨hValid, hSame⟩, hCost⟩

/-- The Pareto minima of budgets for a single exact result. -/
def observableFrontier (A : ExecutionModel.{u,v,w} State Claim)
    (observe : State → Mode → Claim → A.Witness → Outcome)
    (I : State) (mode : Mode) (p : Claim) (result : Outcome) : Set ResourceVec :=
  frontier (restrictObservable A observe result) I mode p

theorem observableFrontier_finite (A : ExecutionModel.{u,v,w} State Claim)
    (observe : State → Mode → Claim → A.Witness → Outcome)
    (I : State) (mode : Mode) (p : Claim) (result : Outcome) :
    (observableFrontier A observe I mode p result).Finite :=
  frontier_finite (restrictObservable A observe result) I mode p

/-- The feasible budget region is exactly the upward closure of its minima. -/
theorem observableFrontier_characterization (A : ExecutionModel.{u,v,w} State Claim)
    (observe : State → Mode → Claim → A.Witness → Outcome)
    (I : State) (mode : Mode) (p : Claim) (result : Outcome) (budget : ResourceVec) :
    budget ∈ observableCostRegion A observe I mode p result ↔
      ∃ m ∈ observableFrontier A observe I mode p result, m ≤ budget :=
  (attainable_restrictObservable_iff A observe result I mode p budget).symm.trans
    (frontier_characterization (restrictObservable A observe result) I mode p budget)

/-- Exact comparison of the two minimal frontiers for a fixed outcome. -/
theorem observableCostRegion_subset_iff_frontier_domination
    (A : ExecutionModel.{u,v,w} State Claim)
    (observe : State → Mode → Claim → A.Witness → Outcome)
    (I J : State) (mode : Mode) (p : Claim) (result : Outcome) :
    observableCostRegion A observe I mode p result ⊆
      observableCostRegion A observe J mode p result ↔
    ∀ m ∈ observableFrontier A observe I mode p result,
      ∃ n ∈ observableFrontier A observe J mode p result, n ≤ m := by
  constructor
  · intro h m hm
    have hOld := (observableFrontier_characterization A observe I mode p result m).2
      ⟨m, hm, le_rfl⟩
    exact (observableFrontier_characterization A observe J mode p result m).1 (h hOld)
  · intro h budget hBudget
    obtain ⟨m, hm, hmb⟩ :=
      (observableFrontier_characterization A observe I mode p result budget).1 hBudget
    obtain ⟨n, hn, hnm⟩ := h m hm
    exact (observableFrontier_characterization A observe J mode p result budget).2
      ⟨n, hn, le_trans hnm hmb⟩

/-- Strict improvement of a fixed outcome removes no old budget and gains a
new minimum with no incumbent minimum below it. -/
theorem observableCostRegion_ssubset_iff_frontier_gap
    (A : ExecutionModel.{u,v,w} State Claim)
    (observe : State → Mode → Claim → A.Witness → Outcome)
    (I J : State) (mode : Mode) (p : Claim) (result : Outcome) :
    observableCostRegion A observe I mode p result ⊂
      observableCostRegion A observe J mode p result ↔
    (∀ m ∈ observableFrontier A observe I mode p result,
      ∃ n ∈ observableFrontier A observe J mode p result, n ≤ m) ∧
    ∃ n ∈ observableFrontier A observe J mode p result,
      ¬ ∃ m ∈ observableFrontier A observe I mode p result, m ≤ n := by
  rw [Set.ssubset_iff_exists, observableCostRegion_subset_iff_frontier_domination]
  constructor
  · rintro ⟨hCover, budget, hNew, hOld⟩
    obtain ⟨n, hn, hnb⟩ :=
      (observableFrontier_characterization A observe J mode p result budget).1 hNew
    refine ⟨hCover, n, hn, ?_⟩
    rintro ⟨m, hm, hmn⟩
    exact hOld ((observableFrontier_characterization A observe I mode p result budget).2
      ⟨m, hm, le_trans hmn hnb⟩)
  · rintro ⟨hCover, n, hn, hGap⟩
    refine ⟨hCover, n, (observableFrontier_characterization A observe J mode p result n).2
      ⟨n, hn, le_rfl⟩, ?_⟩
    intro hOld
    exact hGap ((observableFrontier_characterization A observe I mode p result n).1 hOld)

end GRWTSK.ResourceAttainability
