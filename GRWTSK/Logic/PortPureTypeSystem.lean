import Mathlib
import GRWTSK.Logic.ExternalPTSBridge

namespace GRWTSK.Logic.PortPureTypeSystem

universe u

/-- Annotated pure-type-system expressions with de Bruijn variables. -/
inductive Expr («Sort» : Type u) : Type u
  | var : Nat → Expr «Sort»
  | sort : «Sort» → Expr «Sort»
  | app : Expr «Sort» → Expr «Sort» → Expr «Sort»
  | lam : Expr «Sort» → Expr «Sort» → Expr «Sort»
  | pi : Expr «Sort» → Expr «Sort» → Expr «Sort»
  deriving DecidableEq

namespace Expr

variable {S : Type u}

/-- Lift a renaming through one binder. -/
def liftRen (ρ : Nat → Nat) : Nat → Nat
  | 0 => 0
  | n + 1 => ρ n + 1

/-- Capture-avoiding renaming. -/
def rename (ρ : Nat → Nat) : Expr S → Expr S
  | .var n => .var (ρ n)
  | .sort s => .sort s
  | .app f a => .app (rename ρ f) (rename ρ a)
  | .lam A b => .lam (rename ρ A) (rename (liftRen ρ) b)
  | .pi A B => .pi (rename ρ A) (rename (liftRen ρ) B)

/-- Lift a substitution through one binder. -/
def liftSub (σ : Nat → Expr S) : Nat → Expr S
  | 0 => .var 0
  | n + 1 => rename Nat.succ (σ n)

/-- Capture-avoiding simultaneous substitution. -/
def subst (σ : Nat → Expr S) : Expr S → Expr S
  | .var n => σ n
  | .sort s => .sort s
  | .app f a => .app (subst σ f) (subst σ a)
  | .lam A b => .lam (subst σ A) (subst (liftSub σ) b)
  | .pi A B => .pi (subst σ A) (subst (liftSub σ) B)

/-- Single substitution for the newest de Bruijn variable. -/
def single (a : Expr S) : Nat → Expr S
  | 0 => a
  | n + 1 => .var n

/-- Instantiate one binder. -/
def instantiate (b a : Expr S) : Expr S :=
  subst (single a) b

@[simp]
theorem liftRen_id : liftRen id = id := by
  funext n
  cases n <;> rfl

@[simp]
theorem rename_id (M : Expr S) : rename id M = M := by
  induction M with
  | var n => rfl
  | sort s => rfl
  | app f a hf ha => simp [rename, hf, ha]
  | lam A b hA hb => simp [rename, hA, hb]
  | pi A B hA hB => simp [rename, hA, hB]

@[simp]
theorem liftSub_var : liftSub (Expr.var : Nat → Expr S) = Expr.var := by
  funext n
  cases n <;> rfl

@[simp]
theorem subst_var (M : Expr S) : subst Expr.var M = M := by
  induction M with
  | var n => rfl
  | sort s => rfl
  | app f a hf ha => simp [subst, hf, ha]
  | lam A b hA hb => simp [subst, hA, hb]
  | pi A B hA hB => simp [subst, hA, hB]

end Expr

/-- A pure type specification with no functionality assumption. -/
structure Specification («Sort» : Type u) where
  axioms : «Sort» → «Sort» → Prop
  rule : «Sort» → «Sort» → «Sort» → Prop

/-- Full beta reduction, including reduction in lambda and product annotations. -/
inductive Beta {«Sort» : Type u} : Expr «Sort» → Expr «Sort» → Prop
  | head (A b a) : Beta (.app (.lam A b) a) (b.instantiate a)
  | app_left {f f' a} : Beta f f' → Beta (.app f a) (.app f' a)
  | app_right {f a a'} : Beta a a' → Beta (.app f a) (.app f a')
  | lam_domain {A A' b} : Beta A A' → Beta (.lam A b) (.lam A' b)
  | lam_body {A b b'} : Beta b b' → Beta (.lam A b) (.lam A b')
  | pi_domain {A A' B} : Beta A A' → Beta (.pi A B) (.pi A' B)
  | pi_body {A B B'} : Beta B B' → Beta (.pi A B) (.pi A B')

/-- Conversion generated by beta reduction. -/
def Converts {«Sort» : Type u} : Expr «Sort» → Expr «Sort» → Prop :=
  Relation.EqvGen Beta

/-- Extrinsic typing for a pure type system. -/
inductive HasType {«Sort» : Type u} (P : Specification «Sort») :
    List (Expr «Sort») → Expr «Sort» → Expr «Sort» → Prop
  | ax {s t} : P.axioms s t → HasType P [] (.sort s) (.sort t)
  | var {Γ A s} : HasType P Γ A (.sort s) →
      HasType P (A :: Γ) (.var 0) (A.rename Nat.succ)
  | weaken {Γ M B A s} : HasType P Γ M B → HasType P Γ A (.sort s) →
      HasType P (A :: Γ) (M.rename Nat.succ) (B.rename Nat.succ)
  | product {Γ A B s₁ s₂ s₃} :
      HasType P Γ A (.sort s₁) →
      HasType P (A :: Γ) B (.sort s₂) →
      P.rule s₁ s₂ s₃ →
      HasType P Γ (.pi A B) (.sort s₃)
  | abstraction {Γ A b B s} :
      HasType P (A :: Γ) b B →
      HasType P Γ (.pi A B) (.sort s) →
      HasType P Γ (.lam A b) (.pi A B)
  | application {Γ f a A B} :
      HasType P Γ f (.pi A B) →
      HasType P Γ a A →
      HasType P Γ (.app f a) (B.instantiate a)
  | conversion {Γ M A B s} :
      HasType P Γ M A →
      HasType P Γ B (.sort s) →
      Converts A B →
      HasType P Γ M B

/-- Valid PTS contexts. -/
inductive ValidContext {«Sort» : Type u} (P : Specification «Sort») :
    List (Expr «Sort») → Prop
  | nil : ValidContext P []
  | cons {Γ A s} :
      ValidContext P Γ → HasType P Γ A (.sort s) → ValidContext P (A :: Γ)

/-- Legal expressions include both terms and types appearing in typing judgments. -/
def Legal {«Sort» : Type u} (P : Specification «Sort»)
    (Γ : List (Expr «Sort»)) (M : Expr «Sort») : Prop :=
  ∃ A, HasType P Γ M A ∨ HasType P Γ A M

/-- System-wide weak normalization at every legal expression. -/
def SystemWeaklyNormalizing {«Sort» : Type u} (P : Specification «Sort») : Prop :=
  ∀ Γ, ValidContext P Γ → ∀ M, Legal P Γ M →
    ExternalPTSBridge.WeaklyNormalizing Beta M

/-- System-wide strong normalization at every legal expression. -/
def SystemStronglyNormalizing {«Sort» : Type u} (P : Specification «Sort») : Prop :=
  ∀ Γ, ValidContext P Γ → ∀ M, Legal P Γ M →
    ExternalPTSBridge.StronglyNormalizing Beta M

/-- A source-bound proof of weak-to-strong normalization for this exact PTS core. -/
structure WeakToStrongAdmission {«Sort» : Type u} (P : Specification «Sort») where
  source : ExternalPTSBridge.TheoremSource
  «theorem» : SystemWeaklyNormalizing P → SystemStronglyNormalizing P

/-- Apply an admitted theorem without changing syntax, legality, or beta reduction. -/
theorem strong_of_admission {«Sort» : Type u} {P : Specification «Sort»}
    (A : WeakToStrongAdmission P) (h : SystemWeaklyNormalizing P) :
    SystemStronglyNormalizing P :=
  A.«theorem» h

/-- Sorts used by the framed port interface. Path parity, cochain degree, and K-grading remain
separate constructors or fields rather than implicit coercions. -/
inductive PortSort (Obj : Type u)
  | universe
  | fiber (A : Obj)
  | port (A B : Obj)
  | frame (A : Obj)
  | operator (A : Obj)
  | chainMap (A B : Obj)
  | kClass (A : Obj) (odd : Bool)
  | kCorr (A B : Obj) (odd : Bool)
  | support (A : Obj)
  | residual (A B : Obj)
  | witness
  deriving DecidableEq

namespace PortSort

variable {Obj : Type u}

/-- Minimal source-bound PTS specification for port-interface declarations.

Every interface sort is classified by `universe`, and all products remain in `universe`.
This is only the raw specification; weak normalization and the correspondence with the
intrinsically typed port calculus are separate theorems. -/
def specification : Specification (PortSort Obj) where
  axioms _ t := t = .universe
  rule _ _ t := t = .universe

/-- Type expression for a fiber. -/
def fiberType (A : Obj) : Expr (PortSort Obj) := .sort (.fiber A)

/-- Type expression for a directed port. -/
def portType (A B : Obj) : Expr (PortSort Obj) := .sort (.port A B)

/-- Type expression for an operator on one fiber. -/
def operatorType (A : Obj) : Expr (PortSort Obj) := .sort (.operator A)

/-- Type expression for a residual between exact endpoints. -/
def residualType (A B : Obj) : Expr (PortSort Obj) := .sort (.residual A B)

/-- Type expression for a bivariant class with explicit parity. -/
def kCorrType (A B : Obj) (odd : Bool) : Expr (PortSort Obj) :=
  .sort (.kCorr A B odd)

end PortSort

/-- Exact external source identity of the theorem intended to discharge the weak-to-strong step.
This is metadata only and does not construct a `WeakToStrongAdmission`. -/
def openAIWeakToStrongSource : ExternalPTSBridge.TheoremSource :=
  ExternalPTSBridge.openAIWeakToStrongSource

end GRWTSK.Logic.PortPureTypeSystem
