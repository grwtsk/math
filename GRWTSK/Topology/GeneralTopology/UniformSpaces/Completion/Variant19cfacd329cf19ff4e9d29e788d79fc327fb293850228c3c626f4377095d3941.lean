import DAF.Rhetorical.Hilbert.Quotient

/-!
# Completed rhetorical Hilbert space

The canonical space is the uniform completion of the explicit Hausdorff
kernel quotient.  This is an actual Mathlib completion, not a completeness
capability field or a finite-dimensional substitute.
-/

noncomputable section

namespace DAF.Rhetorical

universe u

variable {Index : Type u} (kernel : PositiveKernel Index)

/-- The completed Hilbert space generated by a positive kernel. -/
@[reducible] def RhetoricalSpace :=
  UniformSpace.Completion (PreRhetoricalSpace kernel)

/-- The canonical isometric inclusion of the pre-Hilbert quotient into its
completion. -/
def completePreRhetorical
    (f : PreRhetoricalSpace kernel) : RhetoricalSpace kernel :=
  (f : UniformSpace.Completion (PreRhetoricalSpace kernel))

/-- The construction supplies the full bundled Hilbert-space structure. -/
def rhetoricalSpace_hilbertStructure :
    HilbertSpace ℂ (RhetoricalSpace kernel) :=
  ⟨⟩

/-- Completeness follows from the actual completion construction. -/
theorem rhetoricalSpace_isHilbert :
    CompleteSpace (RhetoricalSpace kernel) :=
  inferInstance

/-- Completion preserves the quotient inner product on the dense image. -/
@[simp]
theorem inner_completePreRhetorical
    (f g : PreRhetoricalSpace kernel) :
    inner ℂ (completePreRhetorical kernel f)
        (completePreRhetorical kernel g) =
      preRhetoricalInner kernel f g := by
  exact UniformSpace.Completion.inner_coe f g

/-- The quotient image is dense in the completed space. -/
theorem completePreRhetorical_denseRange :
    DenseRange (completePreRhetorical kernel) :=
  UniformSpace.Completion.denseRange_coe

end DAF.Rhetorical
