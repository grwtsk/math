import Mathlib.Topology.Category.TopCat.Sphere
import Mathlib.Topology.Constructions
import Mathlib.Logic.Relation

/-!
# The genuine topological disk adjunction

Given a continuous boundary attaching function A : ∂D² → B, take the
quotient of B ⊕ D² generated by inl (A x) ~ inr (ι x).
The quotient has its actual coinduced quotient topology. Continuous
maps from this quotient are exactly continuous maps from B and D²
which agree on the full standard boundary, not merely at vertices.

The polygon specialization is deliberately absent pending accepted
perimeter-attachment replay.
-/

set_option autoImplicit false
noncomputable section

namespace GRWTSK.Topology.AlgebraicTopology.TopologicalDiskAdjunction

variable {B : Type*} [TopologicalSpace B]

abbrev Disk := TopCat.disk.{0} 2
abbrev DiskBoundary := TopCat.diskBoundary.{0} 2

/-- The real boundary inclusion supplied by Mathlib's Euclidean disk. -/
def boundaryInclusion : DiskBoundary → Disk :=
  TopCat.diskBoundaryInclusion 2

/-- Source for the adjunction: disjoint topological sum. -/
abbrev Source (B : Type*) := B ⊕ Disk

/-- Only the actual boundary attachment generates identifications. -/
inductive Step (A : DiskBoundary → B) : Source B → Source B → Prop
  | attach (x : DiskBoundary) :
      Step A (Sum.inl (A x)) (Sum.inr (boundaryInclusion x))

def Connected (A : DiskBoundary → B) : Source B → Source B → Prop :=
  Relation.EqvGen (Step A)

def adjunctionSetoid (A : DiskBoundary → B) : Setoid (Source B) where
  r := Connected A
  iseqv := Relation.EqvGen.is_equivalence _

/-- Genuine quotient, carrying Mathlib's quotient topology. -/
def AttachedDisk (A : DiskBoundary → B) : Type :=
  Quotient (adjunctionSetoid A)

def projection (A : DiskBoundary → B) : Source B → AttachedDisk A :=
  Quotient.mk (adjunctionSetoid A)

theorem projection_continuous (A : DiskBoundary → B) :
    Continuous (projection A) := by
  change Continuous (Quotient.mk' : Source B → AttachedDisk A)
  exact continuous_quotient_mk'

def baseMap (A : DiskBoundary → B) : B → AttachedDisk A :=
  fun b => projection A (Sum.inl b)

def diskMap (A : DiskBoundary → B) : Disk → AttachedDisk A :=
  fun d => projection A (Sum.inr d)

theorem baseMap_continuous (A : DiskBoundary → B) :
    Continuous (baseMap A) :=
  (projection_continuous A).comp continuous_inl

theorem diskMap_continuous (A : DiskBoundary → B) :
    Continuous (diskMap A) :=
  (projection_continuous A).comp continuous_inr

/-- Exact boundary square on *every* genuine Euclidean boundary point. -/
theorem attachment_commutes (A : DiskBoundary → B) (x : DiskBoundary) :
    baseMap A (A x) = diskMap A (boundaryInclusion x) :=
  Quotient.sound (Relation.EqvGen.rel _ _
    (Step.attach x))

/-- Relation preservation is proved from the one authentic gluing
generator, then through reflexivity, symmetry and transitivity. -/
theorem respects_connected {Y : Type*} (A : DiskBoundary → B)
    (f : B → Y) (g : Disk → Y)
    (h : ∀ x, f (A x) = g (boundaryInclusion x))
    {p q : Source B} (hpq : Connected A p q) :
    Sum.elim f g p = Sum.elim f g q := by
  induction hpq with
  | rel p q hpq =>
      cases hpq with
      | attach x => exact h x
  | refl p => rfl
  | symm p q _ ih => exact ih.symm
  | trans p q r _ _ ih1 ih2 => exact ih1.trans ih2

/-- The actual universal map out of the quotient, not an asserted
Pushout predicate. -/
def descend {Y : Type*} (A : DiskBoundary → B)
    (f : B → Y) (g : Disk → Y)
    (h : ∀ x, f (A x) = g (boundaryInclusion x)) :
    AttachedDisk A → Y :=
  Quotient.lift (Sum.elim f g)
    (fun _ _ hpq => respects_connected A f g h hpq)

@[simp] theorem descend_base {Y : Type*} (A : DiskBoundary → B)
    (f : B → Y) (g : Disk → Y)
    (h : ∀ x, f (A x) = g (boundaryInclusion x)) (b : B) :
    descend A f g h (baseMap A b) = f b := rfl

@[simp] theorem descend_disk {Y : Type*} (A : DiskBoundary → B)
    (f : B → Y) (g : Disk → Y)
    (h : ∀ x, f (A x) = g (boundaryInclusion x)) (d : Disk) :
    descend A f g h (diskMap A d) = g d := rfl

/-- Joint *topological* universal property: the descended map is
continuous when the two original maps are continuous. -/
theorem descend_continuous {Y : Type*} [TopologicalSpace Y]
    (A : DiskBoundary → B)
    (f : B → Y) (g : Disk → Y)
    (h : ∀ x, f (A x) = g (boundaryInclusion x))
    (hf : Continuous f) (hg : Continuous g) :
    Continuous (descend A f g h) := by
  apply Continuous.quotient_lift
    (hf.sumElim hg)
  intro p q hpq
  exact respects_connected A f g h hpq

/-- Any map agreeing on both original source summands must equal the
canonical quotient descent. -/
theorem descend_unique {Y : Type*} (A : DiskBoundary → B)
    (f : B → Y) (g : Disk → Y)
    (h : ∀ x, f (A x) = g (boundaryInclusion x))
    (u : AttachedDisk A → Y)
    (huB : ∀ b, u (baseMap A b) = f b)
    (huD : ∀ d, u (diskMap A d) = g d) :
    u = descend A f g h := by
  funext x
  refine Quotient.inductionOn x ?_
  intro s
  cases s with
  | inl b => exact (huB b).trans (descend_base A f g h b).symm
  | inr d => exact (huD d).trans (descend_disk A f g h d).symm

/-- Converse part of the universal property: every continuous map
out of the quotient gives continuous compatible maps on its summands. -/
theorem continuous_maps_compatible {Y : Type*} [TopologicalSpace Y]
    (A : DiskBoundary → B) (u : AttachedDisk A → Y)
    (hu : Continuous u) :
    Continuous (u ∘ baseMap A) ∧
      Continuous (u ∘ diskMap A) ∧
      (∀ x, (u ∘ baseMap A) (A x) =
        (u ∘ diskMap A) (boundaryInclusion x)) := by
  refine ⟨hu.comp (baseMap_continuous A),
    hu.comp (diskMap_continuous A), ?_⟩
  intro x
  exact congrArg u (attachment_commutes A x)

end GRWTSK.Topology.AlgebraicTopology.TopologicalDiskAdjunction
