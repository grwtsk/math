import GRWTSK.Topology.AlgebraicTopology.SurfacePolygonCornerGluing
import Mathlib.Topology.Constructions
import Mathlib.Topology.UnitInterval

/-!
# A genuine topological quotient of the polygon's directed boundary intervals

The parent #834 supplies a FINITE combinatorial quotient of polygon
corners. In this module each of the SAME original 4g oriented polygon
side IDs carries a REAL closed unit interval with its subspace topology.

The actual quotient identifies:
* opposite a-sides with reversed interval parameter t ↦ 1-t;
* opposite b-sides in the same way;
* the endpoint of each consecutive polygon edge with the beginning
  of the next, including the last-to-first handle seam.

The quotient relation is Mathlib Relation.EqvGen of ONLY those
continuous-side and endpoint identifications, NOT a universal
relation. The true Mathlib Quotient is equipped with the coinduced
topology, and the projection and each actual oriented edge
parameterization are proved continuous.

We transport all of the EXACT corner gluings from issue #834 into
equality of endpoint points in this new topological quotient, proving
there is ONE common vertex class for the original polygon corners.

A hostile noncollapse theorem proves an edge MIDPOINT does NOT become
identified with that vertex, by showing the endpoint/interior status
is invariant under the generating relation and its EqvGen closure.
Thus the topological quotient is provably nontrivial.

This is a topological quotient of the DISJOINT UNION OF BOUNDARY
INTERVALS, a candidate one-skeleton. It is NOT the quotient of a
closed 2-disk, an authenticated CW structure, a surface manifold or
a proved cellular-chain comparison; no van Kampen/Hurewicz,
hyperbolic metric, Selberg/Weil-Petersson, GUE, Chowla or RH result.
-/

set_option autoImplicit false
noncomputable section

namespace GRWTSK.Topology.AlgebraicTopology.SurfacePolygonBoundaryTopology

open GRWTSK.GroupTheory.Words.HigherGenusHeisenbergWitness
open GRWTSK.Topology.AlgebraicTopology.SurfacePolygonPresentationSeam
open GRWTSK.Topology.AlgebraicTopology.SurfacePolygonCornerGluing

/-- Each EXACT original signed side of the 4g-gon is now a copy of
the actual compact topological unit interval, not a single point. -/
abbrev BoundaryPoint (k : ℕ) : Type :=
  PolygonCorner k × unitInterval

/-- The finite side-ID set has the discrete topology. Combined with
the usual unit interval topology this is the disjoint-union topology
on the 4g closed interval copies. -/
local instance cornerDiscreteTopology (k : ℕ) :
    TopologicalSpace (PolygonCorner k) := ⊥

/-- The gluing GENERATORS are the actual reversed-parameter side
pairs plus the adjacency seam in the ordered polygon boundary.

Each handle has side order a,b,a⁻¹,b⁻¹. The last edge of one handle
ends at the first edge of the NEXT handle, with cyclic wraparound.
This list of generators does not identify arbitrary interior points. -/
inductive BoundaryGluingStep (k : ℕ) :
    BoundaryPoint k → BoundaryPoint k → Prop where
  | pairA (h : Handle k) (t : unitInterval) :
      BoundaryGluingStep k
        ((h, 0), t) ((h, 2), unitInterval.symm t)
  | pairB (h : Handle k) (t : unitInterval) :
      BoundaryGluingStep k
        ((h, 1), t) ((h, 3), unitInterval.symm t)
  | seam01 (h : Handle k) :
      BoundaryGluingStep k
        ((h, 0), 1) ((h, 1), 0)
  | seam12 (h : Handle k) :
      BoundaryGluingStep k
        ((h, 1), 1) ((h, 2), 0)
  | seam23 (h : Handle k) :
      BoundaryGluingStep k
        ((h, 2), 1) ((h, 3), 0)
  | seamNext (h : Handle k) :
      BoundaryGluingStep k
        ((h, 3), 1) ((nextHandle k h, 0), 0)

/-- The SMALLEST equivalence relation generated by the actual side
pairings and adjacent endpoints; not an arbitrary all-true relation. -/
def BoundaryConnected (k : ℕ) :
    BoundaryPoint k → BoundaryPoint k → Prop :=
  Relation.EqvGen (BoundaryGluingStep k)

/-- The exact relation as a Mathlib Setoid on the topological source
space consisting of 4g interval copies. -/
def boundarySetoid (k : ℕ) : Setoid (BoundaryPoint k) where
  r := BoundaryConnected k
  iseqv := Relation.EqvGen.is_equivalence _

/-- The REAL quotient type: unlike the parent's finite corner-ID
quotient, this is a quotient of a space containing interval INTERIORS. -/
def PolygonBoundaryOneSkeleton (k : ℕ) : Type :=
  Quotient (boundarySetoid k)

/-- Its TopologicalSpace is the genuine coinduced QUOTIENT topology
provided by Mathlib Topology.Constructions. -/
theorem quotientTopology_is_coinduced (k : ℕ) :
    (inferInstance : TopologicalSpace (PolygonBoundaryOneSkeleton k)) =
      TopologicalSpace.coinduced
        (Quotient.mk' : BoundaryPoint k → PolygonBoundaryOneSkeleton k)
        (inferInstance : TopologicalSpace (BoundaryPoint k)) :=
  rfl

/-- The genuine quotient projection of the source topological space,
not a map from finite IDs to PUnit. -/
def boundaryProjection (k : ℕ) :
    BoundaryPoint k → PolygonBoundaryOneSkeleton k :=
  Quotient.mk (boundarySetoid k)

/-- Mathlib's quotient topology makes the ACTUAL projection
continuous by its universal property. -/
theorem boundaryProjection_continuous (k : ℕ) :
    Continuous (boundaryProjection k) := by
  change Continuous
    (Quotient.mk' : BoundaryPoint k → PolygonBoundaryOneSkeleton k)
  exact continuous_quotient_mk'

/-- The projection is a true quotient map, hence its topology is
coinduced and not an arbitrary discrete/codiscrete topology. -/
theorem boundaryProjection_isQuotientMap (k : ℕ) :
    IsQuotientMap (boundaryProjection k) := by
  change IsQuotientMap
    (Quotient.mk' : BoundaryPoint k → PolygonBoundaryOneSkeleton k)
  exact isQuotientMap_quotient_mk'

/-- Each source-labelled oriented polygon side has a REAL interval
parameterization into the topological quotient. -/
def orientedEdgeMap (k : ℕ) (h : Handle k) (i : Fin 4) :
    unitInterval → PolygonBoundaryOneSkeleton k :=
  fun t => boundaryProjection k ((h, i), t)

/-- An authentic continuous characteristic map for every individual
directed edge interval, by composition with the quotient projection. -/
theorem orientedEdgeMap_continuous (k : ℕ) (h : Handle k)
    (i : Fin 4) :
    Continuous (orientedEdgeMap k h i) := by
  unfold orientedEdgeMap
  exact (boundaryProjection_continuous k).comp
    (continuous_const.prodMk continuous_id)

/-- Equality in the quotient from any single declared gluing
generator. This is source-bound: the quotient is not indiscrete. -/
theorem quotient_eq_of_step (k : ℕ) {p q : BoundaryPoint k}
    (h : BoundaryGluingStep k p q) :
    boundaryProjection k p = boundaryProjection k q :=
  Quotient.sound (Relation.EqvGen.rel _ _ h)

/-- Opposite a-sides have equal images under reverse parameterization
of the REAL closed interval, for every t in [0,1]. -/
theorem opposite_a_edge_maps_agree (k : ℕ) (h : Handle k)
    (t : unitInterval) :
    orientedEdgeMap k h 0 t =
      orientedEdgeMap k h 2 (unitInterval.symm t) :=
  quotient_eq_of_step k (BoundaryGluingStep.pairA h t)

/-- Opposite b-sides likewise agree after the SAME reversal of
the interval parameter. -/
theorem opposite_b_edge_maps_agree (k : ℕ) (h : Handle k)
    (t : unitInterval) :
    orientedEdgeMap k h 1 t =
      orientedEdgeMap k h 3 (unitInterval.symm t) :=
  quotient_eq_of_step k (BoundaryGluingStep.pairB h t)

/-- The endpoints of the four adjacent edges really glue in the
topological quotient, including each last-to-next-handle seam. -/
theorem adjacent_edge_maps_agree_01 (k : ℕ) (h : Handle k) :
    orientedEdgeMap k h 0 1 = orientedEdgeMap k h 1 0 :=
  quotient_eq_of_step k (BoundaryGluingStep.seam01 h)

theorem adjacent_edge_maps_agree_12 (k : ℕ) (h : Handle k) :
    orientedEdgeMap k h 1 1 = orientedEdgeMap k h 2 0 :=
  quotient_eq_of_step k (BoundaryGluingStep.seam12 h)

theorem adjacent_edge_maps_agree_23 (k : ℕ) (h : Handle k) :
    orientedEdgeMap k h 2 1 = orientedEdgeMap k h 3 0 :=
  quotient_eq_of_step k (BoundaryGluingStep.seam23 h)

theorem adjacent_edge_maps_agree_next (k : ℕ) (h : Handle k) :
    orientedEdgeMap k h 3 1 =
      orientedEdgeMap k (nextHandle k h) 0 0 :=
  quotient_eq_of_step k (BoundaryGluingStep.seamNext h)

/-- Embed an original finite polygon corner as the actual t=0
point of its corresponding directed interval, retaining its label. -/
def originalCornerPoint (k : ℕ) (c : PolygonCorner k) :
    BoundaryPoint k :=
  (c, 0)

/-- Each a-start CORNER gluing from #834 follows from real interval
a-side reversal at t=0 and the adjacent 2→3 endpoint seam. -/
theorem a_start_endpoint_connected (k : ℕ) (h : Handle k) :
    BoundaryConnected k
      (originalCornerPoint k (h, 0))
      (originalCornerPoint k (h, 3)) := by
  have p : BoundaryConnected k
      ((h, 0), (0 : unitInterval))
      ((h, 2), (1 : unitInterval)) := by
    simpa using (Relation.EqvGen.rel _ _
      (BoundaryGluingStep.pairA h (0 : unitInterval)))
  exact p.trans (Relation.EqvGen.rel _ _
    (BoundaryGluingStep.seam23 h))

/-- The a-end gluing from #834 is derived from the real 0→1 seam
and a-side reversal at t=1. -/
theorem a_end_endpoint_connected (k : ℕ) (h : Handle k) :
    BoundaryConnected k
      (originalCornerPoint k (h, 1))
      (originalCornerPoint k (h, 2)) := by
  have p : BoundaryConnected k
      ((h, 0), (1 : unitInterval))
      ((h, 2), (0 : unitInterval)) := by
    simpa using (Relation.EqvGen.rel _ _
      (BoundaryGluingStep.pairA h (1 : unitInterval)))
  exact (Relation.EqvGen.rel _ _
    (BoundaryGluingStep.seam01 h)).symm.trans p

/-- The b-end gluing comes from the adjacent 1→2 seam and actual
opposite b-side interval identification at t=1. -/
theorem b_end_endpoint_connected (k : ℕ) (h : Handle k) :
    BoundaryConnected k
      (originalCornerPoint k (h, 2))
      (originalCornerPoint k (h, 3)) := by
  have p : BoundaryConnected k
      ((h, 1), (1 : unitInterval))
      ((h, 3), (0 : unitInterval)) := by
    simpa using (Relation.EqvGen.rel _ _
      (BoundaryGluingStep.pairB h (1 : unitInterval)))
  exact (Relation.EqvGen.rel _ _
    (BoundaryGluingStep.seam12 h)).symm.trans p

/-- The cross-handle b-start gluing follows from b-side interval
reversal at t=0 and the actual cyclic last-to-next seam. -/
theorem b_start_endpoint_connected (k : ℕ) (h : Handle k) :
    BoundaryConnected k
      (originalCornerPoint k (h, 1))
      (originalCornerPoint k (nextHandle k h, 0)) := by
  have p : BoundaryConnected k
      ((h, 1), (0 : unitInterval))
      ((h, 3), (1 : unitInterval)) := by
    simpa using (Relation.EqvGen.rel _ _
      (BoundaryGluingStep.pairB h (0 : unitInterval)))
  exact p.trans (Relation.EqvGen.rel _ _
    (BoundaryGluingStep.seamNext h))

/-- Every ACTUAL finite direct corner-pairing from #834 is a
CONSEQUENCE of the more primitive topological interval pairings.
No corner identification is silently added as a new axiom. -/
theorem direct_corner_gluing_preserved (k : ℕ)
    {u v : PolygonCorner k} (h : DirectCornerGluing k u v) :
    BoundaryConnected k
      (originalCornerPoint k u)
      (originalCornerPoint k v) := by
  cases h with
  | a_start h => exact a_start_endpoint_connected k h
  | a_end h => exact a_end_endpoint_connected k h
  | b_end h => exact b_end_endpoint_connected k h
  | b_start h => exact b_start_endpoint_connected k h

/-- Lift the FULL Mathlib EqvGen of finite polygon corner gluings
to the real boundary-interval quotient by proof induction on the
generator/symmetry/transitivity constructors. -/
theorem corner_equivalence_preserved (k : ℕ)
    {u v : PolygonCorner k} (h : CornerConnected k u v) :
    BoundaryConnected k
      (originalCornerPoint k u)
      (originalCornerPoint k v) := by
  induction h with
  | rel u v huv =>
      exact direct_corner_gluing_preserved k huv
  | refl u =>
      exact Relation.EqvGen.refl _
  | symm u v _ ih =>
      exact ih.symm
  | trans u v w _ _ ih1 ih2 =>
      exact ih1.trans ih2

/-- All finite polygon corners from issue #834 map to the SAME vertex
point in the genuine topological quotient, consuming its nonvacuous
finite gluing proof and these interval identification lemmas. -/
theorem all_original_corners_same_topological_vertex (k : ℕ)
    (u v : PolygonCorner k) :
    boundaryProjection k (originalCornerPoint k u) =
      boundaryProjection k (originalCornerPoint k v) :=
  Quotient.sound
    (corner_equivalence_preserved k (all_corners_connected k u v))

/-- A point on a directed source interval is an endpoint exactly
when its parameter equals 0 or 1. -/
def IsEndpoint (t : unitInterval) : Prop :=
  t = 0 ∨ t = 1

/-- Reversing an interval preserves the ENDPOINT predicate and
exchanges 0/1 exactly as required by opposite side identification. -/
theorem isEndpoint_symm (t : unitInterval) :
    IsEndpoint t ↔ IsEndpoint (unitInterval.symm t) := by
  simp only [IsEndpoint, unitInterval.symm_eq_zero,
    unitInterval.symm_eq_one, or_comm]

/-- Every primitive side-pairing step preserves endpoint/interior
status. The generators identify an interior point ONLY with an
interior point, and endpoints ONLY with endpoints. -/
theorem step_preserves_endpoint (k : ℕ)
    {p q : BoundaryPoint k} (h : BoundaryGluingStep k p q) :
    IsEndpoint p.2 ↔ IsEndpoint q.2 := by
  cases h with
  | pairA h t => exact isEndpoint_symm t
  | pairB h t => exact isEndpoint_symm t
  | seam01 h => simp [IsEndpoint]
  | seam12 h => simp [IsEndpoint]
  | seam23 h => simp [IsEndpoint]
  | seamNext h => simp [IsEndpoint]

/-- The ACTUAL quotient equivalence cannot mix interior and vertex
points: endpoint status is invariant under its entire reflexive,
symmetric and transitive closure. -/
theorem boundary_connected_preserves_endpoint (k : ℕ)
    {p q : BoundaryPoint k} (h : BoundaryConnected k p q) :
    IsEndpoint p.2 ↔ IsEndpoint q.2 := by
  induction h with
  | rel p q hpq => exact step_preserves_endpoint k hpq
  | refl p => exact Iff.rfl
  | symm p q _ ih => exact ih.symm
  | trans p q r _ _ ih1 ih2 => exact ih1.trans ih2

/-- The concrete midpoint of [0,1] is a REAL interior point. -/
def midpoint : unitInterval :=
  ⟨(1 / 2 : ℝ), by constructor <;> norm_num⟩

theorem midpoint_not_endpoint : ¬ IsEndpoint midpoint := by
  intro h
  rcases h with h | h
  · have hv := congrArg (fun t : unitInterval => (t : ℝ)) h
    norm_num [midpoint] at hv
  · have hv := congrArg (fun t : unitInterval => (t : ℝ)) h
    norm_num [midpoint] at hv

/-- STRONG HOSTILE NONCOLLAPSE: no source edge midpoint becomes equal
to ANY original polygon vertex in the topological quotient. Thus the
quotient is not a disguised PUnit or universally related relation. -/
theorem edge_midpoint_ne_any_vertex (k : ℕ)
    (c d : PolygonCorner k) :
    boundaryProjection k (c, midpoint) ≠
      boundaryProjection k (originalCornerPoint k d) := by
  intro heq
  have hc : BoundaryConnected k
      (c, midpoint) (originalCornerPoint k d) :=
    Quotient.exact heq
  have hv : IsEndpoint midpoint :=
    (boundary_connected_preserves_endpoint k hc).mpr
      (by simp [IsEndpoint, originalCornerPoint])
  exact midpoint_not_endpoint hv

/-- The real quotient contains both a common source vertex and an
edge interior point which is PROVED different from that vertex. -/
theorem boundary_one_skeleton_nontrivial (k : ℕ) :
    Nontrivial (PolygonBoundaryOneSkeleton k) := by
  refine ⟨⟨boundaryProjection k ((firstHandle k, 0), midpoint),
      boundaryProjection k
        (originalCornerPoint k (firstHandle k, 0)), ?_⟩⟩
  exact edge_midpoint_ne_any_vertex k _ _

/-- Genus two keeps TWO original handles and a genuine nontrivial
topological boundary quotient, despite having one corner vertex. -/
theorem genusTwo_topological_boundary_nontrivial :
    Nontrivial (PolygonBoundaryOneSkeleton 0) :=
  boundary_one_skeleton_nontrivial 0

/-- Genus three retains a genuine extra handle and nontrivial
interior geometry of the directed interval quotient. -/
theorem genusThree_topological_boundary_nontrivial :
    Nontrivial (PolygonBoundaryOneSkeleton 1) :=
  boundary_one_skeleton_nontrivial 1

/-- The actual number of SOURCE-LABELLED undirected one-cells remains
2(k+2), and no finite corner quotient eliminates any edge source ID. -/
theorem unchanged_edge_generator_count (k : ℕ) :
    Fintype.card (GenusLetter k) = 2 * (k + 2) :=
  one_cell_source_count_unchanged k

end GRWTSK.Topology.AlgebraicTopology.SurfacePolygonBoundaryTopology
