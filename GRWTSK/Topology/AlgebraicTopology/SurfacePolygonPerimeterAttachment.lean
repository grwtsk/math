import GRWTSK.Topology.AlgebraicTopology.SurfacePolygonRadialFilling
import Mathlib.Topology.Constructions
import Mathlib.Topology.UnitInterval

/-!
# The unpaired cyclic polygon perimeter and its actual attaching-direction map

The signed polygon source in #745, #834, #845 and #859 has exactly
4(k+2) directed, real unit-interval sides for genus g=k+2.

The PREVIOUS topological boundary quotient B_k identifies both:
* consecutive source edge endpoints in the original cyclic order;
* opposite a/a⁻¹ and b/b⁻¹ sides with reversed parameters.

The source of a classical CW 2-cell attaching map is different: its
UNPAIRED cyclic perimeter must identify consecutive endpoints only.
Here we construct that exact quotient P_k with Mathlib's coinduced
topology and an honest continuous, surjective map P_k -> B_k.

This is not just an unverified map of named polygon boundary types.
Every one of the FOUR cyclic perimeter seam generators is consumed
from the old same-source BoundaryGluingStep family. Quotient.lift
then provides the actual attaching-DIRECTION map, whose equality on
each original signed source edge is recorded.

A strong hostile witness proves that this map is NOT injective:
an interior midpoint on the first a-edge and the corresponding
reversed midpoint on a⁻¹ remain DISTINCT in the unpaired perimeter
(because its only generating relations are between ENDPOINTS), but
have the SAME image in B_k under the genuine full-side pairing.
This detects the exact additional information lost during attachment.

Finally compose with the #859 continuous outer-boundary map to the
radial filling and construct fixed-radius continuous maps P_k -> F_k.
The r=0 slice collapses to the real apex and the r=1 slice agrees
with the genuine attaching-then-boundary-to-filling composite.

OPEN: proving P_k is HOMEOMORPHIC to the standard circle S¹;
constructing a standard closed disk and its globally continuous
attaching map from S¹; proving the cone-to-disk/pushout/CW manifold
theorems and a source-identical topological cellular chain complex.
A radial slice is not a proof of joint continuity P_k × I -> F_k.

No van Kampen, Hurewicz, hyperbolic geodesic lengths, Selberg,
Weil-Petersson, sofic/GUE, Chowla, zeta divisor or RH theorem.
-/

set_option autoImplicit false
noncomputable section

namespace GRWTSK.Topology.AlgebraicTopology.SurfacePolygonPerimeterAttachment

open _root_.Topology
open GRWTSK.GroupTheory.Words.HigherGenusHeisenbergWitness
open GRWTSK.Topology.AlgebraicTopology.SurfacePolygonCornerGluing
open GRWTSK.Topology.AlgebraicTopology.SurfacePolygonBoundaryTopology
open GRWTSK.Topology.AlgebraicTopology.SurfacePolygonRadialFilling

/-- Exactly the same finite side identifiers as the original oriented
polygon; the index alone has discrete topology, not the real intervals. -/
local instance cornerDiscreteTopology (k : ℕ) :
    TopologicalSpace (PolygonCorner k) := ⊥

/-- The ONLY primitive relations of the UNPAIRED polygon perimeter:
consecutive side endpoint identifications in the actual cyclic order.
There are no a/a⁻¹ or b/b⁻¹ interior pairings at this stage. -/
inductive PerimeterSeamStep (k : ℕ) :
    BoundaryPoint k → BoundaryPoint k → Prop where
  | seam01 (h : Handle k) :
      PerimeterSeamStep k ((h, 0), 1) ((h, 1), 0)
  | seam12 (h : Handle k) :
      PerimeterSeamStep k ((h, 1), 1) ((h, 2), 0)
  | seam23 (h : Handle k) :
      PerimeterSeamStep k ((h, 2), 1) ((h, 3), 0)
  | seamNext (h : Handle k) :
      PerimeterSeamStep k ((h, 3), 1) ((nextHandle k h, 0), 0)

/-- The smallest equivalence relation generated by the EXACT four
cyclic endpoint seam families, retaining interior points separately. -/
def PerimeterConnected (k : ℕ) :
    BoundaryPoint k → BoundaryPoint k → Prop :=
  Relation.EqvGen (PerimeterSeamStep k)

/-- The genuine source-generated setoid of the unpaired perimeter. -/
def perimeterSetoid (k : ℕ) : Setoid (BoundaryPoint k) where
  r := PerimeterConnected k
  iseqv := Relation.EqvGen.is_equivalence _

/-- True Mathlib Quotient of the original 4g real edge intervals
by ONLY cyclic endpoint seams, with its coinduced topological space.
A later circle homeomorphism still has to be proved. -/
abbrev UnpairedPerimeter (k : ℕ) : Type :=
  Quotient (perimeterSetoid k)

/-- The actual quotient topology, not a new discrete or trivial
topology picked independently of the source interval copies. -/
theorem perimeter_topology_coinduced (k : ℕ) :
    (inferInstance : TopologicalSpace (UnpairedPerimeter k)) =
      TopologicalSpace.coinduced
        (@Quotient.mk' _ (perimeterSetoid k) : BoundaryPoint k → UnpairedPerimeter k)
        (inferInstance : TopologicalSpace (BoundaryPoint k)) :=
  rfl

/-- The source quotient projection preserving every exact side ID. -/
def perimeterProjection (k : ℕ) :
    BoundaryPoint k → UnpairedPerimeter k :=
  Quotient.mk (perimeterSetoid k)

theorem perimeterProjection_continuous (k : ℕ) :
    Continuous (perimeterProjection k) := by
  change Continuous
    (@Quotient.mk' _ (perimeterSetoid k) : BoundaryPoint k → UnpairedPerimeter k)
  exact continuous_quotient_mk'

theorem perimeterProjection_isQuotientMap (k : ℕ) :
    IsQuotientMap (perimeterProjection k) := by
  change IsQuotientMap
    (@Quotient.mk' _ (perimeterSetoid k) : BoundaryPoint k → UnpairedPerimeter k)
  exact isQuotientMap_quotient_mk'

/-- Each original signed oriented polygon edge is continuously
parametrized in the UNPAIRED cyclic perimeter. -/
def perimeterEdgeMap (k : ℕ) (h : Handle k) (i : Fin 4) :
    unitInterval → UnpairedPerimeter k :=
  fun t => perimeterProjection k ((h, i), t)

theorem perimeterEdgeMap_continuous (k : ℕ)
    (h : Handle k) (i : Fin 4) :
    Continuous (perimeterEdgeMap k h i) := by
  unfold perimeterEdgeMap
  exact (perimeterProjection_continuous k).comp
    (continuous_const.prodMk continuous_id)

/-- Each consecutive boundary endpoint equality comes from a
precise generating seam, not from an all-true quotient relation. -/
theorem perimeter_seam_01 (k : ℕ) (h : Handle k) :
    perimeterEdgeMap k h 0 1 = perimeterEdgeMap k h 1 0 :=
  Quotient.sound (Relation.EqvGen.rel _ _
    (PerimeterSeamStep.seam01 h))

theorem perimeter_seam_12 (k : ℕ) (h : Handle k) :
    perimeterEdgeMap k h 1 1 = perimeterEdgeMap k h 2 0 :=
  Quotient.sound (Relation.EqvGen.rel _ _
    (PerimeterSeamStep.seam12 h))

theorem perimeter_seam_23 (k : ℕ) (h : Handle k) :
    perimeterEdgeMap k h 2 1 = perimeterEdgeMap k h 3 0 :=
  Quotient.sound (Relation.EqvGen.rel _ _
    (PerimeterSeamStep.seam23 h))

theorem perimeter_seam_next (k : ℕ) (h : Handle k) :
    perimeterEdgeMap k h 3 1 =
      perimeterEdgeMap k (nextHandle k h) 0 0 :=
  Quotient.sound (Relation.EqvGen.rel _ _
    (PerimeterSeamStep.seamNext h))

/-- Every UNPAIRED perimeter seam is an actual one of the FOUR
endpoint seams already present in #845's paired boundary.
This is the precise source comparison needed for quotient descent. -/
theorem seamStep_respected_by_pairedBoundary (k : ℕ)
    {p q : BoundaryPoint k}
    (h : PerimeterSeamStep k p q) :
    BoundaryConnected k p q := by
  cases h with
  | seam01 h =>
      exact Relation.EqvGen.rel _ _ (BoundaryGluingStep.seam01 h)
  | seam12 h =>
      exact Relation.EqvGen.rel _ _ (BoundaryGluingStep.seam12 h)
  | seam23 h =>
      exact Relation.EqvGen.rel _ _ (BoundaryGluingStep.seam23 h)
  | seamNext h =>
      exact Relation.EqvGen.rel _ _ (BoundaryGluingStep.seamNext h)

/-- All perimeter equivalences, including symmetry and transitive
gluing, are respected by the REAL paired boundary quotient. -/
theorem perimeterConnected_respected_by_pairedBoundary (k : ℕ)
    {p q : BoundaryPoint k}
    (h : PerimeterConnected k p q) :
    BoundaryConnected k p q := by
  induction h with
  | rel p q hpq => exact seamStep_respected_by_pairedBoundary k hpq
  | refl p => exact Relation.EqvGen.refl _
  | symm p q _ ih => exact ih.symm
  | trans p q r _ _ ih1 ih2 => exact Relation.EqvGen.trans _ _ _ ih1 ih2

/-- The TRUE attaching-DIRECTION map from the unpaired cyclic
perimeter to the already paired boundary one-skeleton. It is built
by Quotient.lift using the exact proved relation inclusion. -/
def perimeterAttach (k : ℕ) :
    UnpairedPerimeter k → PolygonBoundaryOneSkeleton k :=
  Quotient.lift (boundaryProjection k) (by
    intro p q h
    exact Quotient.sound
      (perimeterConnected_respected_by_pairedBoundary k h))

/-- The attaching-direction map is actually continuous between the
two genuine quotient topological spaces. -/
theorem perimeterAttach_continuous (k : ℕ) :
    Continuous (perimeterAttach k) := by
  apply Continuous.quotient_lift (boundaryProjection_continuous k)

/-- Exact source-square comparison for EVERY tangential point of
EVERY original oriented polygon side, not merely four sample edges. -/
@[simp] theorem perimeterAttach_projection (k : ℕ)
    (p : BoundaryPoint k) :
    perimeterAttach k (perimeterProjection k p) =
      boundaryProjection k p :=
  rfl

/-- The attaching-direction map is SURJECTIVE: each point of the
paired boundary quotient still has an original source interval point.
No boundary points are silently dropped by the two-stage quotient. -/
theorem perimeterAttach_surjective (k : ℕ) :
    Function.Surjective (perimeterAttach k) := by
  intro y
  refine Quotient.inductionOn y ?_
  intro p
  exact ⟨perimeterProjection k p, rfl⟩

/-- Its source-preserving quotient universal property: any competing
map with the same value on EVERY ORIGINAL signed edge point is equal
to the actual attached quotient map. -/
theorem perimeterAttach_unique (k : ℕ)
    (f : UnpairedPerimeter k → PolygonBoundaryOneSkeleton k)
    (hf : ∀ p : BoundaryPoint k,
      f (perimeterProjection k p) = boundaryProjection k p) :
    f = perimeterAttach k := by
  funext x
  refine Quotient.inductionOn x ?_
  intro p
  exact hf p

/-- Genuine opposite a and a⁻¹ points have the SAME image after
attachment into the paired boundary, by the parent's TRUE full
side-pairing relation (for all interval parameters t). -/
theorem attachingMap_pairs_a (k : ℕ) (h : Handle k)
    (t : unitInterval) :
    perimeterAttach k (perimeterProjection k ((h, 0), t)) =
      perimeterAttach k
        (perimeterProjection k ((h, 2), unitInterval.symm t)) := by
  simp only [perimeterAttach_projection]
  exact opposite_a_edge_maps_agree k h t

theorem attachingMap_pairs_b (k : ℕ) (h : Handle k)
    (t : unitInterval) :
    perimeterAttach k (perimeterProjection k ((h, 1), t)) =
      perimeterAttach k
        (perimeterProjection k ((h, 3), unitInterval.symm t)) := by
  simp only [perimeterAttach_projection]
  exact opposite_b_edge_maps_agree k h t

/-- The ONLY primitive perimeter relation generators glue endpoints
to endpoints. They do not move a strict interval interior point. -/
theorem seamStep_has_endpoints (k : ℕ) {p q : BoundaryPoint k}
    (h : PerimeterSeamStep k p q) :
    IsEndpoint p.2 ∧ IsEndpoint q.2 := by
  cases h <;> simp [IsEndpoint]

/-- The entire generated unpaired perimeter relation preserves
endpoint status. This is weaker than its interior-fixed property but
is useful in the symmetry branch of the latter proof. -/
theorem perimeterConnected_preserves_endpoint (k : ℕ)
    {p q : BoundaryPoint k}
    (h : PerimeterConnected k p q) :
    IsEndpoint p.2 ↔ IsEndpoint q.2 := by
  induction h with
  | rel p q hpq =>
      exact ⟨fun _ => (seamStep_has_endpoints k hpq).2,
        fun _ => (seamStep_has_endpoints k hpq).1⟩
  | refl p => exact Iff.rfl
  | symm p q _ ih => exact ih.symm
  | trans p q r _ _ ih1 ih2 => exact ih1.trans ih2

/-- STRONG NONCOLLAPSE LEMMA: in the unpaired perimeter, a point with
strictly interior tangential parameter cannot be equivalent to any
DIFFERENT source point. Seam generators involve endpoints only, and
the EqvGen induction proves this through all possible seam chains. -/
theorem perimeterConnected_interior_fixed (k : ℕ)
    {p q : BoundaryPoint k} (h : PerimeterConnected k p q) :
    ¬ IsEndpoint p.2 → p = q := by
  induction h with
  | rel p q hpq =>
      intro hi
      exact False.elim (hi (seamStep_has_endpoints k hpq).1)
  | refl p =>
      intro _
      rfl
  | symm p q hpq ih =>
      intro hq
      have hp : ¬ IsEndpoint p.2 := by
        intro hendpoint
        exact hq ((perimeterConnected_preserves_endpoint k hpq).mp hendpoint)
      exact (ih hp).symm
  | trans p q r hpq hqr ih1 ih2 =>
      intro hp
      have hpq_eq : p = q := ih1 hp
      have hq : ¬ IsEndpoint q.2 := by
        simpa [← hpq_eq] using hp
      exact hpq_eq.trans (ih2 hq)

/-- The first handle a-midpoint and its opposite a⁻¹-midpoint remain
DISTINCT in the UNPAIRED perimeter, although attachment pairs them.
The difference is a true source-ID difference, not a numerical guess. -/
theorem opposite_a_midpoints_distinct_in_perimeter (k : ℕ)
    (h : Handle k) :
    perimeterProjection k ((h, 0), midpoint) ≠
      perimeterProjection k ((h, 2), unitInterval.symm midpoint) := by
  intro heq
  have hrel : PerimeterConnected k
      ((h, 0), midpoint) ((h, 2), unitInterval.symm midpoint) :=
    Quotient.exact heq
  have hsource :=
    perimeterConnected_interior_fixed k hrel midpoint_not_endpoint
  have hindex : (0 : Fin 4) = 2 :=
    congrArg (fun p : BoundaryPoint k => p.1.2) hsource
  exact (by decide : (0 : Fin 4) ≠ 2) hindex

/-- The attaching-direction map is NOT injective, proved using
a specific distinct pair of interior points which the actual
opposite-side gluing in #845 identifies. -/
theorem perimeterAttach_not_injective (k : ℕ) :
    ¬ Function.Injective (perimeterAttach k) := by
  intro hInjective
  have hSame :=
    attachingMap_pairs_a k (firstHandle k) midpoint
  exact
    (opposite_a_midpoints_distinct_in_perimeter k (firstHandle k))
      (hInjective hSame)

/-- Exact composite from the genuine unpaired cyclic perimeter
through the paired one-skeleton into the parent's filled radial
topological quotient. This has the correct attaching-map orientation. -/
def perimeterToFilling (k : ℕ) :
    UnpairedPerimeter k → FilledPolygonQuotient k :=
  (boundaryInclusion k) ∘ (perimeterAttach k)

theorem perimeterToFilling_continuous (k : ℕ) :
    Continuous (perimeterToFilling k) :=
  (boundaryInclusion_continuous k).comp
    (perimeterAttach_continuous k)

/-- The boundary/filling triangle COMMUTES on every literal original
source interval point, with the filled target at radius ONE. -/
theorem perimeterToFilling_projection (k : ℕ)
    (p : BoundaryPoint k) :
    perimeterToFilling k (perimeterProjection k p) =
      radialProjection k (outerSource k p) := by
  change boundaryInclusion k (boundaryProjection k p) =
    radialProjection k (outerSource k p)
  exact boundaryInclusion_projection k p

/-- The four original perimeter seams also hold at ANY radius r in
the radial filling source from #859, not only at the outer boundary. -/
theorem perimeterSeam_respected_at_radius (k : ℕ)
    (r : unitInterval) {p q : BoundaryPoint k}
    (h : PerimeterSeamStep k p q) :
    RadialConnected k (p, r) (q, r) := by
  cases h with
  | seam01 h =>
      exact Relation.EqvGen.rel _ _ (RadialGluingStep.seam01 h r)
  | seam12 h =>
      exact Relation.EqvGen.rel _ _ (RadialGluingStep.seam12 h r)
  | seam23 h =>
      exact Relation.EqvGen.rel _ _ (RadialGluingStep.seam23 h r)
  | seamNext h =>
      exact Relation.EqvGen.rel _ _ (RadialGluingStep.seamNext h r)

/-- The full unpaired perimeter seam EqvGen is respected at ALL radii,
including the apex and each strict intermediate radial level. -/
theorem perimeterConnected_respected_at_radius (k : ℕ)
    (r : unitInterval) {p q : BoundaryPoint k}
    (h : PerimeterConnected k p q) :
    RadialConnected k (p, r) (q, r) := by
  induction h with
  | rel p q hpq => exact perimeterSeam_respected_at_radius k r hpq
  | refl p => exact Relation.EqvGen.refl _
  | symm p q _ ih => exact ih.symm
  | trans p q s _ _ ih1 ih2 => exact Relation.EqvGen.trans _ _ _ ih1 ih2

/-- Each FIXED radial level is a true continuous quotient-descended
map from the UNPAIRED polygon perimeter into the radial filling.
Joint continuity on P_k × I is a separate pending theorem. -/
def perimeterRadialSlice (k : ℕ) (r : unitInterval) :
    UnpairedPerimeter k → FilledPolygonQuotient k :=
  Quotient.lift (fun p : BoundaryPoint k => radialProjection k (p, r)) (by
    intro p q h
    exact Quotient.sound
      (perimeterConnected_respected_at_radius k r h))

theorem perimeterRadialSlice_continuous (k : ℕ) (r : unitInterval) :
    Continuous (perimeterRadialSlice k r) := by
  apply Continuous.quotient_lift
    ((radialProjection_continuous k).comp
      (continuous_id.prodMk continuous_const))

/-- Every original perimeter source point has the claimed fixed
radial parameter when descended to the filling. -/
theorem perimeterRadialSlice_projection (k : ℕ) (r : unitInterval)
    (p : BoundaryPoint k) :
    perimeterRadialSlice k r (perimeterProjection k p) =
      radialProjection k (p, r) :=
  rfl

/-- The entire unpaired perimeter collapses to the inherited apex
at radius ZERO through the actual radial source relation. -/
theorem perimeterRadialSlice_zero (k : ℕ) (x : UnpairedPerimeter k) :
    perimeterRadialSlice k 0 x = apexPoint k := by
  refine Quotient.inductionOn x ?_
  intro p
  exact radius_zero_is_apex k p

/-- The radius-ONE slice is EXACTLY the composite of the newly
constructed attaching-direction map and the parent's continuous
boundary-to-filling map, on every original source point. -/
theorem perimeterRadialSlice_one (k : ℕ) (x : UnpairedPerimeter k) :
    perimeterRadialSlice k 1 x = perimeterToFilling k x := by
  refine Quotient.inductionOn x ?_
  intro p
  rfl

/-- Each fixed radial slice has precisely the selected radial value
under the actual continuous radial invariant of parent #859. -/
theorem radialCoordinate_slice (k : ℕ) (r : unitInterval)
    (x : UnpairedPerimeter k) :
    radialCoordinate k (perimeterRadialSlice k r x) = r := by
  refine Quotient.inductionOn x ?_
  intro p
  rfl

/-- Exact original number of directed edge interval source IDs:
four edges on each of g=k+2 handles. The unpaired perimeter is not
defined by collapsing or omitting a source interval. -/
theorem directed_edge_source_count (k : ℕ) :
    Fintype.card (PolygonCorner k) = 4 * (k + 2) := by
  simp [PolygonCorner, Handle, Fintype.card_prod, Fintype.card_sum]
  omega

/-- Named genus-two noninjectivity test, preserving eight true
directed edge copies in the original unpaired perimeter. -/
theorem genusTwo_attaching_noninjective :
    ¬ Function.Injective (perimeterAttach 0) :=
  perimeterAttach_not_injective 0

/-- Named genus-three noninjectivity test, including the real extra
handle and twelve directed edge copies. -/
theorem genusThree_attaching_noninjective :
    ¬ Function.Injective (perimeterAttach 1) :=
  perimeterAttach_not_injective 1

end GRWTSK.Topology.AlgebraicTopology.SurfacePolygonPerimeterAttachment
