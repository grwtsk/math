    "url": "https://www.claymath.org/wp-content/uploads/2022/06/yangmills.pdf",
    "consulted_client_date": "2026-10-28",
    "scope": "Finite compact-group periodic lattice functional integral. The survey distinguishes this regulator from lattice-spacing/volume limits and a physical gap. No external binary hash, researcher participation or historical influence is claimed."
  },
  "actual_model": {
    "group": "Matrix.specialUnitaryGroup (Fin 2) Complex, with inherited matrix topology and explicitly constructed Borel measurable space",
    "vertices": "Fin4 -> ZMod L",
    "positive_links": "Vertex L x Fin4",
    "plaquettes": "Vertex L x {directions:Fin4 x Fin4 // mu<nu}",
    "configurations": "Link L -> actual SU2",
    "vertex_gauges": "Vertex L -> actual SU2",
    "size_hypotheses": "Group covariance works for every natural L; finite measure definitions require NeZero L. Terminal existence theorem assumes3<=L and supplies that instance by proof.",
    "coupling_hypotheses": "beta:Real>=0 for partition bounds and probability. Density gauge invariance is valid and proved for every real beta.",
    "gauge_action": "(h.U)(x,mu)=h(x)*U(x,mu)*inverse(h(x+e_mu))",
    "plaquette": "U(x,mu)*U(x+e_mu,nu)*inverse(U(x+e_nu,mu))*inverse(U(x,nu))",
    "penalty": "phi(g)=1-(1/2)*Re(Matrix.trace g)",
    "action": "S(U)=sum_{p:Plaquette L}phi(holonomy U p)",
    "reference_measure": "nu=Measure.pi(fun e:Link L=>haarProbability), each actual HaarProbability is normalized on compact univ",
    "partition": "Z=integral exp(-beta*S(U)) dnu",
    "weighted_measure": "nu.withDensity(fun U=>ENNReal.ofReal(exp(-beta*S(U))/Z))"
  },
  "exact_targets": [
    {
      "declaration": "GRWTSK.Geometry.GaugeTheory.FinitePeriodicLattice.plaquetteHolonomy_gauge",
      "statement": "For every actual vertex gauge and configuration, holonomy(h.U,x,mu,nu)=h(x)*holonomy(U,x,mu,nu)*h(x)^(-1), with both inverse links and torus far-corner identification."
    },
    {
      "declaration": "GRWTSK.Geometry.GaugeTheory.SU2Wilson.penalty_bounds",
      "statement": "For every actual determinant-one unitary two-by-two complex matrix g: 0 <= phi(g) <= 2, derived from actual unitarity."
    },
    {
      "declaration": "GRWTSK.Geometry.GaugeTheory.SU2Haar.haarProbability_univ",
      "statement": "Constructed normalized actual Haar measure has total mass 1. Compactness, topological group structure and right invariance are proved, not supplied as fields."
    },
    {
      "declaration": "GRWTSK.Geometry.GaugeTheory.FiniteSU2Wilson.wilsonPartition_bounds",
      "statement": "For natural L with NeZero L and beta >= 0: exp(-2*beta*card(Plaquette L)) <= Z <= 1."
    },
    {
      "declaration": "GRWTSK.Geometry.GaugeTheory.FiniteSU2Wilson.wilsonMeasure_univ",
      "statement": "The actual normalized withDensity Wilson measure has total mass 1 for beta >= 0."
    },
    {
      "declaration": "GRWTSK.Geometry.GaugeTheory.FiniteSU2Wilson.wilsonMeasure_map_gauge",
      "statement": "Mapping the actual constructed Wilson measure under each vertex gauge transformation preserves it, with no invariant-measure premise."
    },
    {
      "declaration": "GRWTSK.Geometry.GaugeTheory.FiniteSU2Wilson.finiteWilson_probability_exists",
      "statement": "For every L >= 3 and beta >= 0, supply the actual normalized density as a probability invariant under all vertex gauge transformations."
    }
  ],
  "proof_components": {
    "algebra": "Use commuting torus shifts and group cancellation, including both inverses, then cyclicity of actual matrix trace.",
    "penalty_range": "Actual star(g)*g=I gives each column norm-square sum equal to 1 and each entry norm at most 1. The two diagonal real parts bound real trace between -2 and 2.",
    "compact_SU2": "The special-unitary carrier is closed by the unitary equations and det=1. The actual entry bound puts it inside the compact product of closed complex unit disks. Inversion is continuous star, and multiplication is inherited from the matrix submonoid. Compactness is proved.",
    "actual_Haar": "Use maintained Measure.haarMeasure normalized on actual PositiveCompacts.univ, and prove its mass is 1. Right translation preserves left invariance and total mass; compact Haar uniqueness gives right invariance. SU2 is never assumed commutative.",
    "actual_link_product": "Measure.pi constructs the product of actual one-link Haar probabilities. Coordinatewise left and right multiplication preserve it; the actual gauge transformation has those fixed endpoint multipliers.",
    "normalization": "The action is continuous and lies in [0,2*card(P)]. The weight lies in [exp(-2*beta*card(P)),1], is integrable under the constructed probability, and has positive integral. Divide by that integral and use the ofReal integral identity to prove withDensity mass 1.",
    "density_gauge": "Actual product-Haar gauge preservation and literal action equality prove density map-invariance by measurable-set integration. The generic analytic supplier is directly consumed by the concrete Wilson definitions."
