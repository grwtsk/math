  "mathematical_result": {
    "operator_line": "H(q)=H+q I for every q in R on the unchanged maximal logarithmic domain",
    "form": "Q_q(x)=Q_0(x)+q||x||^2",
    "state_line": "Q_q(x+t y) is an exact real quadratic polynomial in t",
    "reconstruction": "values at t=+1 and t=-1 recover Q_q(y) and the polar pairing",
    "vacuum": "H(q)Omega=q Omega and Q_q(Omega)=q",
    "ground_bound": "for q>=0, q||x||^2<=Q_q(x), attained at the unit vacuum",
    "spectrum": "each point eigenvalue E is translated to E+q",
    "graph": "graph self-adjointness is preserved for every real q",
    "prime_pullback": "the existing residue Hamiltonian is q=log(p_r)",
    "decay": "c_q(t)=exp(-tq), q=-log(c_q(t))/t for t!=0, and c_log(p)(1)=1/p"
  },
