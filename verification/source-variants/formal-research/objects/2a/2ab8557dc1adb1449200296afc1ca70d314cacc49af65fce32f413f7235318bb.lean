import Mathematics.Discovery.OpenElement
import Mathematics.Projection.FiniteHammingSupport
import Mathematics.Projection.GeodesicCompletion
import Lean.Elab.Tactic.Omega

/-!
# Open element: coordinate-seed midpoint density

The exact Boolean midpoint operation already generates proposal points without
granting them mathematical identity.  This closed proposition asks whether
the zero code and all Hamming-weight-one codes generate every finite Boolean
code through finitely many balanced midpoint steps.

The statement is finite combinatorics at every width.  It does not assert that
the generated codes have certified mathematical realizations.
-/

namespace Mathematics.Projection

open Set
open Mathematics.Discovery

/-- Zero and every coordinate singleton in one finite Boolean cube. -/
def CoordinateSeed (width : Nat) :
    Set (FiniteIncidenceCode width) :=
  { code | (BitVec.cpop code.bits).toNat ≤ 1 }

/-- Exact all-width midpoint-generation target. -/
def CoordinateSeedMidpointDensityStatement : Prop :=
  ∀ (width : Nat) (code : FiniteIncidenceCode width),
    ∃ stage,
      MidpointGenerated (CoordinateSeed width) stage code

/-- Immutable proposal-only element for the closed midpoint-density target. -/
def coordinateSeedMidpointDensityOpenElement :
    OpenConjectureElement CoordinateSeedMidpointDensityStatement where
  elementId :=
    { id := { value := "open:projection:coordinate-seed-midpoint-density" } }
  elementId_valid := by
    simp [StableId.Valid]
  name := "Coordinate-seed midpoint density"
  name_nonempty := by
    decide
  leanDeclarationName :=
    "Mathematics.Projection.CoordinateSeedMidpointDensityStatement"
  leanDeclarationName_nonempty := by
    decide

/-- Persist one generated point through a specified number of local stages. -/
private theorem retainGeneratedBy
    {width stage : Nat}
    {seed : Set (FiniteIncidenceCode width)}
    {point : FiniteIncidenceCode width}
    (generated : MidpointGenerated seed stage point) :
    ∀ extra,
      MidpointGenerated seed (stage + extra) point := by
  intro extra
  induction extra with
  | zero =>
      simpa using generated
  | succ extra inductionHypothesis =>
      rw [Nat.add_succ]
      exact MidpointGenerated.retain inductionHypothesis

/--
Every finite support is generated by recursively bisecting it into two
disjoint supports whose cardinalities differ by at most one.
-/
private theorem generatedIncidenceOfSupport
    {width : Nat}
    (support : Finset (Fin width)) :
    ∃ stage,
      MidpointGenerated
        (CoordinateSeed width)
        stage
        (incidenceOfSupport support) := by
  refine Finset.strongInductionOn support ?_
  intro support generatedSmaller
  by_cases small : support.card ≤ 1
  · refine ⟨0, MidpointGenerated.seedPoint _ ?_⟩
    change (BitVec.cpop (incidenceOfSupport support).bits).toNat ≤ 1
    rw [cpop_eq_finiteSupport_card, finiteSupport_incidenceOfSupport]
    exact small
  · have large : 2 ≤ support.card := by
      omega
    have halfFits :
        (support.card + 1) / 2 ≤ support.card := by
      omega
    obtain ⟨left, leftSubset, leftCard⟩ :=
      Finset.exists_subset_card_eq halfFits
    let right := support \ left
    have rightSubset : right ⊆ support := by
      exact Finset.sdiff_subset
    have rightCard :
        right.card = support.card - left.card := by
      exact Finset.card_sdiff_of_subset leftSubset
    have leftCardLt : left.card < support.card := by
      rw [leftCard]
      omega
    have rightCardLt : right.card < support.card := by
      rw [rightCard, leftCard]
      omega
    have leftStrict : left ⊂ support :=
      _root_.ssubset_iff_subset_ne.2
        ⟨leftSubset, fun equal ↦ by
          have equalCard := congrArg Finset.card equal
          omega⟩
    have rightStrict : right ⊂ support :=
      _root_.ssubset_iff_subset_ne.2
        ⟨rightSubset, fun equal ↦ by
          have equalCard := congrArg Finset.card equal
          omega⟩
    obtain ⟨leftStage, leftGenerated⟩ :=
      generatedSmaller left leftStrict
    obtain ⟨rightStage, rightGenerated⟩ :=
      generatedSmaller right rightStrict
    have leftAtCommon :
        MidpointGenerated
          (CoordinateSeed width)
          (leftStage + rightStage)
          (incidenceOfSupport left) :=
      retainGeneratedBy leftGenerated rightStage
    have rightAtCommon :
        MidpointGenerated
          (CoordinateSeed width)
          (leftStage + rightStage)
          (incidenceOfSupport right) := by
      simpa [Nat.add_comm] using
        retainGeneratedBy rightGenerated leftStage
    have disjoint : Disjoint left right := by
      exact Finset.disjoint_sdiff
    have leftToTarget :
        finiteHamming
            (incidenceOfSupport left)
            (incidenceOfSupport support) =
          right.card := by
      simpa [right] using
        finiteHamming_incidenceOfSupport_of_subset leftSubset
    have targetToRight :
        finiteHamming
            (incidenceOfSupport support)
            (incidenceOfSupport right) =
          left.card := by
      rw [finiteHamming_comm]
      calc
        finiteHamming
            (incidenceOfSupport right)
            (incidenceOfSupport support) =
            (support \ right).card :=
          finiteHamming_incidenceOfSupport_of_subset rightSubset
        _ = left.card := by
          change (support \ (support \ left)).card = left.card
          rw [Finset.sdiff_sdiff_eq_self leftSubset]
    have leftToRight :
        finiteHamming
            (incidenceOfSupport left)
            (incidenceOfSupport right) =
          left.card + right.card :=
      finiteHamming_incidenceOfSupport_of_disjoint disjoint
    have geodesic :
        OnBooleanGeodesic
          (incidenceOfSupport left)
          (incidenceOfSupport right)
          (incidenceOfSupport support) := by
      unfold OnBooleanGeodesic
      rw [leftToTarget, targetToRight, leftToRight]
      omega
    have balanced :
        BalancedLegs
          (finiteHamming
            (incidenceOfSupport left)
            (incidenceOfSupport support))
          (finiteHamming
            (incidenceOfSupport support)
            (incidenceOfSupport right)) := by
      rw [leftToTarget, targetToRight]
      unfold BalancedLegs
      rw [rightCard, leftCard]
      omega
    refine
      ⟨leftStage + rightStage + 1,
        MidpointGenerated.midpoint
          leftAtCommon
          rightAtCommon
          {
            point := incidenceOfSupport support
            onGeodesic := geodesic
            balanced := balanced
          }⟩

/-- Coordinate seeds generate every finite Boolean code by exact midpoints. -/
theorem coordinateSeedMidpointDensity :
    CoordinateSeedMidpointDensityStatement := by
  intro width code
  obtain ⟨stage, generated⟩ :=
    generatedIncidenceOfSupport (finiteSupport code)
  exact ⟨stage, by simpa using generated⟩

/-- Distinct theorem element linked to the immutable proposal seed. -/
def coordinateSeedMidpointDensityTheoremElement :
    LeanTheoremElement coordinateSeedMidpointDensityOpenElement where
  theoremElementId := {
    id := {
      value := "theorem:projection:coordinate-seed-midpoint-density"
    }
  }
  theoremElementId_valid := by
    simp [StableId.Valid]
  sourceSeedId := coordinateSeedMidpointDensityOpenElement.elementId.id
  sourceSeed_bound := rfl
  proof := coordinateSeedMidpointDensity

end Mathematics.Projection
