      "name": "Degreewise transport map and arbitrary semantic proof contracts",
      "source_span": {
        "start": 477,
        "end": 953,
        "sha256": "c3750c181dd6c18151c691a9f56304f14ba06d9da89c203c4fd6add3622c94b6",
