  "conceptual_components": [
    {
      "name": "Two Chern property wrappers",
      "source_span": {
        "start": 499,
        "end": 987,
        "sha256": "47507af770ca5e924e42e6e1a0429d4c88d4a6920fc17f36e58c6429cc05ddb2",
        "line_start": 20,
        "line_end": 31
      },
      "interpretation": "Take supplied H/ch and forward proofs of ch.additive and ch.compatibleWithConnection, which are arbitrary Props independent of the stored class function in the provider."
    },
    {
      "name": "Ahat property wrapper",
      "source_span": {
        "start": 987,
        "end": 1210,
        "sha256": "05220dee305ef04c19bdbbfb6d9078304869f6626e557e06bb3080116b8ba3d6",
        "line_start": 32,
        "line_end": 37
      },
      "interpretation": "Takes supplied H/A and forwards A.multiplicative, an arbitrary Prop independent of the stored A.ahat function."
    },
    {
      "name": "Two Witten boundary wrappers",
      "source_span": {
        "start": 1210,
        "end": 1726,
        "sha256": "769ee104e171d0ba6d0bcd7f5ff7631b6e3e47b1f692d59ce4248b13d034cf6e",
        "line_start": 38,
        "line_end": 49
      },
      "interpretation": "Take supplied H/W and forward W.refinesAhat and W.stringOrientationRequired; the captured record defines neither as a refinement equation nor an actual orientation condition."
    },
    {
      "name": "Two characteristic-formula boundary wrappers",
      "source_span": {
        "start": 1726,
        "end": 2814,
        "sha256": "9a14073a3e7fb83ad1503b9e54399de12b69c410b83a4bf45e2038042581a4d8",
        "line_start": 50,
        "line_end": 71
      },
      "interpretation": "Retain all supplied C/F/nabla/D/H/I/Phi parameters and exact qualified proof calls. Phi.formula.compatible is distinct from its ClassEquality.equal degree equation; formulaIsAtiyahSingerStyle is another arbitrary supplied Prop."
    }
  ],
